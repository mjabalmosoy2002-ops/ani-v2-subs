1
00:00:10,490 --> 00:00:12,330
!شكرًا على الوجبة

2
00:00:13,790 --> 00:00:16,060
.لقد شبعتُ تمامًا

3
00:00:16,060 --> 00:00:19,630
!لكن لا مجال للمقارنة بين هذا وبين إيتشيراكو رامن

4
00:00:20,460 --> 00:00:21,500
ما كان ذلك؟

5
00:00:25,000 --> 00:00:26,510
!أنت من جديد

6
00:00:26,510 --> 00:00:28,010
ألا تستسلم أبدًا؟

7
00:00:28,550 --> 00:00:30,640
.أنتِ مجرّد مرافِقة لمن أسعى خلفها

8
00:00:30,640 --> 00:00:33,930
من أريد مقاتلتها هي الأميرة
!الواقفة إلى جانبكِ

9
00:00:34,230 --> 00:00:36,730
!مستحيل! لن أسمح بذلك

10
00:00:37,060 --> 00:00:40,170
لا حاجة لأن تلوِّثي يديكِ برجل مثله
!يا سيّدتي شيزوكا

11
00:00:40,170 --> 00:00:41,980
.هذا هو قدَري

12
00:00:41,980 --> 00:00:43,320
.تراجعي من فضلكِ

13
00:00:52,870 --> 00:00:55,540
!أنت جميلة كعادتك

14
00:00:55,540 --> 00:00:58,040
!أسرعي واغدي زوجة لي

15
00:01:05,510 --> 00:01:08,340
!أسلوب ناديشيكو: الرّكلة الدّائريّة القاسيّة

16
00:01:17,940 --> 00:01:21,270
!ماذا؟! ستدفعين ثمن هذا

17
00:01:26,490 --> 00:01:28,240
.كنتِ مذهلة يا سيّدتي شيزوكا

18
00:01:28,950 --> 00:01:30,870
.انتظريني في النُّزُل من فضلكِ

19
00:01:30,870 --> 00:01:33,740
.سأتحقّق من تدابير السّفر الخاصّة بالسّفينة

20
00:01:33,740 --> 00:01:34,790
.شكرًا لكِ

21
00:01:39,040 --> 00:01:42,290
.تلك الآنسة هي شينوبي مميّزة

22
00:01:42,290 --> 00:01:43,710
.لكن هذا ليس من شأني

23
00:01:44,170 --> 00:01:45,880
.مهلاً لحظة يا سيّدي

24
00:01:48,630 --> 00:01:51,510
واضح أنّك شينوبي من ورقة الشّجر
.حسب حامية جبهتك

25
00:01:51,890 --> 00:01:53,390
.صحيح، لقد أصبتِ

26
00:01:54,680 --> 00:01:55,770
هل لي أن أسألك عن شيء ما؟

27
00:01:56,640 --> 00:01:59,020
إنّه عن السّيّد جيرايا، أحد النّينجا
!الأسطوريّين الثّلاث

28
00:01:59,480 --> 00:02:02,400
كنت أريد أن أسألك هل تعرف أحد تلاميذه؟

29
00:03:38,620 --> 00:03:40,040
،من بين كل الأماكن

30
00:03:40,040 --> 00:03:42,750
لقد صُدمتُ لأنّي وجدت الشّخص
.الّذي نبحث عنه هنا

31
00:03:43,920 --> 00:03:48,250
لقد كنّا على وشك أن نستقلّ سفينة
.في اتّجاه ورقة الشّجر للبحث عنك

32
00:03:48,500 --> 00:03:51,090
لقد كان ذلك مفاجئًا تمامًا

33
00:03:51,090 --> 00:03:53,550
كسماعي لاسم النّاسك المنحرف
.بشكل مفاجئ

34
00:03:53,550 --> 00:03:55,890
لكن كيف تعرفين بشأني؟

35
00:03:56,300 --> 00:03:58,300
ألم يخبرك السّيّد جيرايا بأيّ شيء؟

36
00:03:58,300 --> 00:03:58,850
عمّاذا؟

37
00:04:01,890 --> 00:04:03,180
.سأخبرك أنا إذًا

38
00:04:03,730 --> 00:04:09,980
العلاقة الّتي تربط السّيّد جيرايا بقريتنا
.تعود لعقود عديدة سالفة

39
00:04:17,240 --> 00:04:18,450
!لا تفقدن أثره

40
00:04:18,450 --> 00:04:21,620
علينا أن نريه ما الّذي نفعله بمن
!يحاول التّسلّل إلى قريتنا

41
00:04:25,040 --> 00:04:29,590
سحقًا، لقد أتيتُ فقط للقيام ببعض
.الأبحاث من أجل كتابي الجديد

42
00:04:35,930 --> 00:04:38,680
.إنّهنّ جميلات، لكن خطيرات أيضًا

43
00:04:46,390 --> 00:04:47,850
.استسلم

44
00:04:48,610 --> 00:04:51,480
.آسف، لكنّي لا أستطيع فعل ذلك

45
00:04:54,030 --> 00:04:55,280
!سيّد غاماكين

46
00:04:55,280 --> 00:04:57,700
!تقنيّة أسلوب الهروب السّرّيّ

47
00:04:59,320 --> 00:05:01,660
...أنا لست رشيقًا جدًّا

48
00:05:04,040 --> 00:05:05,080
!لا تدعنه يهرب

49
00:05:05,080 --> 00:05:05,540
!أجل

50
00:05:22,350 --> 00:05:23,770
!إنّه بارد

51
00:05:26,310 --> 00:05:27,640
!هذا منعش

52
00:05:30,270 --> 00:05:33,230
!لم أتوقّع منكِ أن تتبعيني كلّ هذه المسافة

53
00:05:33,900 --> 00:05:37,200
.تقنيّتك الّتي نفّذتها بالأمس كانت رائعة

54
00:05:38,280 --> 00:05:41,490
أنتِ لم تأتي إلى هنا لتخبريني
بهذا فقط، صحيح؟

55
00:05:42,410 --> 00:05:45,080
.لقد أُعجبت بمهاراتك، لذلك لديّ طلب منك

56
00:05:46,290 --> 00:05:47,500
طلب؟

57
00:05:48,460 --> 00:05:50,540
.يا سّيّد جيرايا، جونين قرية ورقة الشّجر

58
00:05:50,540 --> 00:05:53,250
.قاتلني وستكون جائزة فوزك هي يدي للزّواج

59
00:05:53,250 --> 00:05:55,960
!توقّفي! إلى أين تحاولين الوصول بهذا؟

60
00:05:56,840 --> 00:05:59,300
.تتّبع قرية ناديشكو نظام النّسل الأُمُومِيّ

61
00:05:59,300 --> 00:06:01,470
ولأكون واضحة أكثر، كل مواليد
.سلالتنا عبارة عن بنات

62
00:06:02,300 --> 00:06:03,390
بنات فقط؟

63
00:06:03,640 --> 00:06:08,140
لذلك تغادر المرشحات للقيادةِ القريةَ
.بحثًا عن الرّجال الأقوياء ويتحدّونهم

64
00:06:08,140 --> 00:06:12,610
والرّجال الّذين يهزموننا، نأخذهم
.معنا للقرية ويصبحون أزواجًا لنا

65
00:06:12,610 --> 00:06:13,940
.هذا هو القانون

66
00:06:16,400 --> 00:06:20,070
النّزال الّذي دار بينهما كان غرضه هو شحذ
.مهارات النّينجيتسو لا غير

67
00:06:20,660 --> 00:06:23,580
.لكن في النّهاية، لم يتمّ تحديد الفائز

68
00:06:39,630 --> 00:06:43,850
،لذلك قاما بقطع وعد بينهما
.وتمّ تأجيل النّزال

69
00:06:45,350 --> 00:06:51,140
،وفي حال ما إذا كُتِبَ لنزالهما المؤجّل ألاّ يتمّ
.قرّرا أن يجعلا تلميذيهما يكملان ما بدآهُ

70
00:06:51,140 --> 00:06:52,560
...هذا يعني

71
00:06:54,440 --> 00:06:58,610
،أريدك أن تقاتل سيّدتي شيزوكا بشكل جادّ
.بينما سيكون الزّواج هو جائزتك

72
00:06:58,900 --> 00:06:59,990
ز-زواج؟

73
00:07:00,570 --> 00:07:02,990
!هذا مفاجئ للغاية

74
00:07:02,990 --> 00:07:04,410
.ليس مفاجئًا على الإطلاق

75
00:07:04,410 --> 00:07:06,410
.فقد تمّ تحديد هذا منذ زمن من طرف معلمك

76
00:07:06,410 --> 00:07:09,080
!لكنّي سمعتُ عنه للتّوّ

77
00:07:09,080 --> 00:07:10,960
.هذه مشكلتك أنت

78
00:07:10,960 --> 00:07:12,750
.وعلى أيّ حال، الوعد وعد

79
00:07:12,750 --> 00:07:15,040
!عليك أن توافق وإلاّ سوف نواجه بعض المشاكل

80
00:07:15,040 --> 00:07:17,550
!سأواجه المشاكل إن وافقت

81
00:07:17,550 --> 00:07:21,010
لذلك، لنتظاهر أنّنا لم نقم بهذه
!المحادثة من الأساس

82
00:07:21,260 --> 00:07:22,090
!مهلاً

83
00:07:24,890 --> 00:07:27,430
.يجب على هذا النّزال أن يتمّ، مهما كان الأمر

84
00:07:32,390 --> 00:07:35,560
!طلب زواج بهذه البساطة
!لديك شعبيّة كبيرة يا ناروتو

85
00:07:35,560 --> 00:07:36,610
!أنا أحسدك

86
00:07:36,940 --> 00:07:39,150
.الأمر ليس كما تعتقده على الإطلاق، صدّقني

87
00:07:39,150 --> 00:07:43,530
،إنّ قطع النّاسك المنحرف لوعدٍ دون اكتراث
!لا يعني أنّ عليّ أنا أن أدفع ثمن ذلك

88
00:07:44,410 --> 00:07:48,620
.نحن في مهمة سرّيّة للغاية

89
00:07:49,080 --> 00:07:51,790
لذلك لا يمكننا أن ندع أيّ شيء
.غبيّ أن يعرقل سيرنا

90
00:07:51,790 --> 00:07:53,750
هل علينا أن نعجّل من موعد إنطلاقنا؟

91
00:07:53,750 --> 00:07:55,290
.أجل، فكرة جيّدة

92
00:07:56,080 --> 00:07:59,000
.ولحسن الحظّ أنّنا جهّزنا كل مؤونتنا

93
00:07:59,000 --> 00:08:02,090
.لذا علينا أن ننام باكرًا لننطلق غدًا صباحًا

94
00:08:17,980 --> 00:08:20,360
.أظنّ أنّي شربت الكثير من الشّاي

95
00:08:29,330 --> 00:08:31,750
فلنأخذ استراحة، مفهوم؟
.فقط أمهليني دقيقة

96
00:08:38,130 --> 00:08:42,260
!لقد بالغتِ عندما لاحقتني إلى هنا

97
00:08:42,260 --> 00:08:43,920
.لا مهرب لديك منّي

98
00:08:43,920 --> 00:08:46,680
.فأنت مرشّح مهمّ لأن تكون زوجًا

99
00:08:46,680 --> 00:08:50,430
.اسمعي، لقد رفضتُ هذا سابقًا

100
00:08:51,060 --> 00:08:57,730
أنا لا أعرف ما هي تقاليد قريتكنّ، لكنّي
.لن أشارك في هذه الصّفقة الغريبة

101
00:08:57,730 --> 00:08:58,810
!لكن

102
00:08:59,060 --> 00:09:03,400
إذا كنتِ تريدين القتال، فاذهبي
...واختاري شخصًا هناك و

103
00:09:03,400 --> 00:09:05,200
!لا تقل أشياء كهذه من فضلك

104
00:09:08,070 --> 00:09:11,830
.فسيّدتي شيزوكا غير راضية عن هذا أيضًا

105
00:09:12,120 --> 00:09:15,290
.إنّها في الواقع شخص طيّب القلب

106
00:09:17,170 --> 00:09:18,710
...ومع ذلك

107
00:09:30,180 --> 00:09:32,010
.أودّ البقاء هكذا للأبد

108
00:09:33,260 --> 00:09:34,680
.إذًا لنجعل هذا واقعًا

109
00:09:35,100 --> 00:09:35,640
...لكن

110
00:09:37,230 --> 00:09:38,980
.أنا أعرف من تكونين

111
00:09:38,980 --> 00:09:43,070
لكنّ فكرة الحصول على زوج
.عن طريق القتال فكرة سخيفة

112
00:09:43,070 --> 00:09:44,280
.ساغيري

113
00:09:46,190 --> 00:09:49,530
.أنا تاجر قد سُمح له بالدّخول إلى القرية

114
00:09:49,530 --> 00:09:54,200
.وأنا لست قويًّا، لكنّي أحبّكِ أكثر من أيّ شيء

115
00:09:54,740 --> 00:09:57,080
.أريدكِ أن تكوني سعيدة

116
00:09:57,960 --> 00:10:03,550
لذلك أنا جاهز للقيام بأيّ شيء لتغيير
.قانون القرية، أقسم لكِ بهذا

117
00:10:16,850 --> 00:10:18,560
،لا أستطيع تأكيد الأمر

118
00:10:18,560 --> 00:10:23,730
لكن هناك من يعتقد أنّها كانت مؤامرة
.من بعض القلقين على مستقبل القرية

119
00:10:24,730 --> 00:10:26,780
.لقد هوجِم وقضى نحبه في ذلك الهجوم

120
00:10:26,780 --> 00:10:29,950
.فكما يبدو، لم يكن شخصًا مناسبًا لقرية ناديشكو

121
00:10:30,780 --> 00:10:31,740
...هذا

122
00:10:32,240 --> 00:10:36,080
منذ ذلك اليوم، قرّرت سيّدتي شيزوكا
.أن تغلق قلبها

123
00:10:38,870 --> 00:10:44,750
توقّفت عن الحبّ، وذلك لكي لا تضطرّ
.لخسارة شخص تحبّه

124
00:10:45,210 --> 00:10:50,680
،وكلّ ما أصبحت تفكّر به هو القيام بواجبها
.وهو البحث عن رجال أقوياء وتحدّيهم

125
00:10:51,380 --> 00:10:55,560
.وكأنّها تعاقب نفسها

126
00:10:58,770 --> 00:11:01,060
هل تريدين منّي أن أقاتلها؟

127
00:11:02,230 --> 00:11:06,650
أنت تلميذ السّيّد جيرايا المرعب الّذي أجبر
.قائدتنا السّابقة على أن تقبل بالتّعادل

128
00:11:07,940 --> 00:11:11,110
قد تكون قادرًا على وضع حدٍّ لرغبة
.القتال الّتي لا تنتهي لديها

129
00:11:13,280 --> 00:11:15,200
!أنا مدركة تمامًا أن هذا طلب أنانيّ

130
00:11:15,740 --> 00:11:19,620
لكن من فضلك، هل توافق على
أن تقاتل سيّدتي شيزوكا؟

131
00:11:40,640 --> 00:11:42,890
.لا أعتقد أنّ أحدًا يراقبنا

132
00:11:42,890 --> 00:11:45,440
.علينا أن نكون بخير بمجرّد تركنا للميناء

133
00:11:46,560 --> 00:11:49,150
.إذًا يا ناروتو، لقد أضعت فرصةً لتصبح زوجًا

134
00:11:52,860 --> 00:11:55,120
.سأتمكّن من توفير بعض الوقت بهذه الطّريقة

135
00:11:55,570 --> 00:11:59,660
أنا شاكرة لك يا سيّد ناروتو لأنّك
.وافقت على المشاركة في النّزال

136
00:11:59,660 --> 00:12:03,000
.آسف، لكنّني لم آتِ إلى هنا لأقاتل

137
00:12:03,210 --> 00:12:04,460
.بل لأتحدّث

138
00:12:04,670 --> 00:12:05,420
ماذا؟

139
00:12:06,420 --> 00:12:08,130
.لقد سمعت بشأن حالتك

140
00:12:08,380 --> 00:12:10,880
.لكن هناك شيء غريب حيالها

141
00:12:13,550 --> 00:12:15,760
.أنا هنا لأقاتلك

142
00:12:16,800 --> 00:12:18,810
.لأعرف مدى قوّتك

143
00:12:27,320 --> 00:12:28,660
.هذا سيساعد

144
00:12:30,820 --> 00:12:32,740
!أسلوب الأرض: سجن القبضة الحديديّة

145
00:12:51,300 --> 00:12:53,180
.لن أشارك في هذا

146
00:12:53,810 --> 00:12:55,720
.هذا قدري

147
00:12:55,720 --> 00:12:57,560
.دعني أبدأ من فضلك

148
00:12:59,770 --> 00:13:01,980
!أسلوب ناديشكو: قبضة الهواء القاسيّة

149
00:13:10,450 --> 00:13:12,530
!أسلوب ناديشكو: الرقصة الدائريّة

150
00:13:15,450 --> 00:13:16,450
!تتوافد الواحدة تلو الآخرى

151
00:13:20,370 --> 00:13:22,380
.أنت قويّ بالفعل يا ناروتو

152
00:13:23,500 --> 00:13:25,250
.لكنّك لن تتفاداها للأبد

153
00:13:28,510 --> 00:13:30,220
!الرّقصة الدّائريّة: الخطوة الثّانية

154
00:13:39,230 --> 00:13:40,810
!لا نهاية لهذا

155
00:13:45,900 --> 00:13:47,190
!الرّياح العاصفة

156
00:14:02,960 --> 00:14:04,460
.أعتقد أن الأمر انتهى

157
00:14:04,710 --> 00:14:06,250
.صحيح، أعتقد ذلك

158
00:14:14,010 --> 00:14:14,930
.انتهى الأمر

159
00:14:18,720 --> 00:14:20,310
.مناورة من المستوى الثّاني

160
00:14:21,100 --> 00:14:23,850
.لم ينل مني أيّ أحد من الخلف سابقًا

161
00:14:26,520 --> 00:14:28,530
.هيّا نفّذ الضّربة القاضية

162
00:14:28,820 --> 00:14:31,740
.لقد سبق وأخبرتكِ، أنا لست هنا للقتال

163
00:14:32,200 --> 00:14:34,070
.فأنا لست مهتمًا به

164
00:14:34,490 --> 00:14:36,990
.إذًا سآخذ أنا الفتاة

165
00:14:46,750 --> 00:14:48,040
!أمسكتكِ

166
00:14:48,670 --> 00:14:50,010
!يا لها من خطوة جبانة

167
00:14:50,760 --> 00:14:53,050
!هذه خدعة واهية

168
00:15:04,690 --> 00:15:06,650
!قيود الدّمى المائة للرّوح

169
00:15:06,650 --> 00:15:13,610
تقوم تقنيّتي بزرع مسامير في هدفي
.خلال كلّ مرّة تُهزم فيها دمايَ المائة

170
00:15:14,320 --> 00:15:17,120
.لقد أصبحتِ دمية لي الآن

171
00:15:19,080 --> 00:15:22,540
لا تقل لي أنّ كل تلك الدّمى السّابقة
كان الهدف منها هو هذا؟

172
00:15:26,000 --> 00:15:27,000
!جبان

173
00:15:27,250 --> 00:15:28,540
!لقد نجحت

174
00:15:28,540 --> 00:15:31,760
!والآن كلّ مِن شيزوكا وناديشكو قد أصبحا ملكي

175
00:15:32,090 --> 00:15:33,220
.أطلق سراحها

176
00:15:34,300 --> 00:15:36,760
.لم أُنهِ كلامي معها بعد، لذلك أطلق سراحها

177
00:15:37,010 --> 00:15:40,060
!اخرس! هذا ليس من شأنك، لذلك أغرب عن وجهي

178
00:15:40,060 --> 00:15:42,220
...سوف أستفيد منها في

179
00:15:51,730 --> 00:15:53,070
!راسنغان

180
00:16:05,460 --> 00:16:06,750
لماذا أنقذتني؟

181
00:16:07,250 --> 00:16:10,630
!لقد نلت كفايتي من الجميع

182
00:16:10,630 --> 00:16:11,880
!لم أقصد ذلك

183
00:16:12,130 --> 00:16:14,340
!لقد سنحت لك الفرصة لهزيمتي

184
00:16:14,670 --> 00:16:16,720
وهل كنتِ لترضي إن هزمتك؟

185
00:16:19,550 --> 00:16:25,390
فقط لأنّه قدركِ، فلا يعني ذلك أن
.تغلقي قلبكِ بهدف البحث عن زوج

186
00:16:25,600 --> 00:16:26,640
أليس هذا سخيفًا؟

187
00:16:27,270 --> 00:16:31,190
أعني، أنا لا أعرف أيّ شيء
،عن الزّواج وما إلى ذلك

188
00:16:31,190 --> 00:16:36,700
لكن أليس من المهمّ أوّلاً أن تحبّي
شخصًا وتهتمّا لأمر بعضكما؟

189
00:16:36,990 --> 00:16:38,240
...هذا

190
00:16:39,780 --> 00:16:42,950
.هناك فتاة أحبّها تدعى ساكورا

191
00:16:48,330 --> 00:16:51,540
.في الواقع، إنّه حبّ من طرف واحد

192
00:16:55,630 --> 00:16:59,550
.فساكورا تحب شخصًا يدعى ساسكي

193
00:16:59,550 --> 00:17:04,220
.لقد حاولت كثيرًا أن تفوز بقلبه

194
00:17:09,600 --> 00:17:13,820
وعندما تكون معه، فإن ابتسامتها
.هي أروع شيء قد أراه

195
00:17:14,980 --> 00:17:16,280
.ولا أعرف ما سبب ذلك

196
00:17:16,280 --> 00:17:18,990
.وسرعان ما وجدتُ نفسي واقعًا في حبّها

197
00:17:19,450 --> 00:17:25,080
.ولم أرغمها أبدًا على أن تحبّني

198
00:17:25,790 --> 00:17:28,460
فلن أختلف حينها عن الشّخص
.الّذي هاجمكِ للتّوّ

199
00:17:30,670 --> 00:17:32,420
.لذلك اتّخذت قراري

200
00:17:32,420 --> 00:17:36,130
،فكما تحاول ساكورا أن تفوز بقلب ساسكي

201
00:17:36,130 --> 00:17:39,930
.سأقوم أنا أيضًا بكلّ ما بوسعي للفوز بقلبها

202
00:17:41,340 --> 00:17:43,930
...لكنّ قدري

203
00:17:44,220 --> 00:17:46,430
!هذا ليس قدرًا

204
00:17:46,430 --> 00:17:49,430
.إنّها مجرّد قاعدة قد أحدثتها القرية

205
00:17:50,560 --> 00:17:51,850
...نعم، لكن

206
00:17:53,610 --> 00:17:56,820
.استعملي قدراتكِ لتضعي حدًّا لهذا

207
00:18:00,860 --> 00:18:05,830
،لا أدري إن وصلتك فكرتي بوضوح
.لكن هذا ما أردتُ التّحدّث معكِ بشأنه

208
00:18:06,910 --> 00:18:08,250
!ناروتو

209
00:18:09,540 --> 00:18:10,250
!إنّه القائد ياماتو

210
00:18:11,080 --> 00:18:13,710
!لقد تصرّفت على هواك ثانيةً

211
00:18:15,170 --> 00:18:18,000
هذه هي المرّة الثّانية الّتي تخدعني
.فيها مستعملاً نسخة ظلّ

212
00:18:18,000 --> 00:18:20,630
.آمل أن تكون مستعدّ لعواقب فعلتك

213
00:18:22,380 --> 00:18:24,640
!لا

214
00:18:33,650 --> 00:18:35,110
.سنبحر قريبًا

215
00:18:35,650 --> 00:18:37,270
.سآتي على الفور

216
00:18:38,190 --> 00:18:39,860
.اعتني بنفسكِ

217
00:18:40,280 --> 00:18:42,320
...عندما تنتهي مهمّتك

218
00:18:44,280 --> 00:18:48,540
وعندما تعود لقريتك، فهل ستخبرها أنّك تحبّها؟

219
00:18:50,080 --> 00:18:53,620
.لا، لا أملك الشّجاعة الكافية لفعل ذلك بعد

220
00:18:55,420 --> 00:18:59,210
.حتّى ذلك الوقت، سأستمرّ في الوقوف إلى جانبها

221
00:18:59,500 --> 00:19:01,260
وهل أنت راضٍ بهذا فقط؟

222
00:19:07,010 --> 00:19:11,100
أكيد، فلا شيء قد يجعلني أسعد
.إذا ما اختارتني يومًا ما

223
00:19:11,100 --> 00:19:12,850
.لكن لا بأس

224
00:19:13,480 --> 00:19:17,650
.فما دامت ساكورا سعيدة، فذلك هو الأهمّ

225
00:19:20,940 --> 00:19:23,150
.أريدكِ أن تكوني سعيدة

226
00:19:28,200 --> 00:19:30,700
.آسف لكن هذا النّزال سينتهي هنا

227
00:19:33,910 --> 00:19:38,210
.فلسوء الحظّ، لقد وهبت قلبي لامرأة بالفعل

228
00:19:39,460 --> 00:19:42,130
.بالرّغم من أنّه حبّ من طرف واحد

229
00:19:42,630 --> 00:19:45,260
حب من طرف واحد؟ أنت بالذّات؟

230
00:19:45,590 --> 00:19:48,640
.لقد خَسِرتْ أشخاصًا كانت تحبّهم واحدًا تلو الآخر

231
00:19:48,970 --> 00:19:53,230
.لذلك فهي الآن ترفض فكرة الحبّ

232
00:20:04,030 --> 00:20:07,820
وقد أقسمت بأن أظلّ إلى جانبها
.وأن أحمل ثقل مستقبلها على عاتقي

233
00:20:08,570 --> 00:20:11,080
حتّى وإن لم تحصل على أيّ شيء مقابل هذا؟

234
00:20:13,290 --> 00:20:15,870
!وكأنّني آبه لهذه الأشياء الصّغيرة

235
00:20:16,160 --> 00:20:21,590
!سأحيطها بحبّي وأدعو لها بالسعادة مدى الحياة

236
00:20:22,090 --> 00:20:23,460
.أنا أفهمك

237
00:20:23,460 --> 00:20:26,590
.لنعتبر أنّنا متعادلان في هذا النّزال

238
00:20:28,550 --> 00:20:32,260
.إذًا سيكون عليّ تحدّي تلميذ هذا الرّجل

239
00:20:34,100 --> 00:20:35,230
...شيزوكا

240
00:20:36,140 --> 00:20:39,480
.ستحملين عبء قدرك بلا شكّ

241
00:20:39,940 --> 00:20:41,020
،لذا تذكّري

242
00:20:43,440 --> 00:20:46,440
.لا حاجة لأن تغلقي قلبكِ على الإطلاق

243
00:20:49,030 --> 00:20:50,070
...سيّدتي شيزوكا

244
00:20:50,070 --> 00:20:51,830
.لنذهب يا توكيوا

245
00:20:51,830 --> 00:20:52,450
.حاضرة

246
00:20:53,370 --> 00:20:55,750
.سوف أصبح أقوى

247
00:20:55,750 --> 00:20:57,330
...ويومًا ما

248
00:20:58,750 --> 00:20:59,750
!أجل