1
00:01:31,200 --> 00:01:35,950
تحرير التّقنيّة المحرّمة

2
00:01:41,530 --> 00:01:46,330
لا عجب أنّ البحث عن التّقنيّة
.المحرّمة كان بلا فائدة

3
00:01:46,330 --> 00:01:51,380
سيطرة

4
00:01:47,980 --> 00:01:52,600
.لقد استعمل حفيدته لإخفائها

5
00:01:56,840 --> 00:01:58,270
...يا لإن نو غيوجا ذاك

6
00:01:58,980 --> 00:02:01,270
.يا له من فعل شنيع

7
00:02:01,800 --> 00:02:05,580
،إن أُزيلت التّقنيّة المحرّمة من حاويها البشري

8
00:02:05,580 --> 00:02:07,790
.فسوف تُفقد إلى الأبد

9
00:02:08,110 --> 00:02:13,720
وإذا لم يكن البشريّ الّذي يستضيفها
،موهوبًا بما يكفي للتّحكّم بها

10
00:02:13,720 --> 00:02:16,700
.فإنّ التّقنيّة المحرّمة لا يمكن أن تُفعّل

11
00:02:18,420 --> 00:02:22,310
لذلك حتّى إن أتى أحد ما سعيًا
،خلف التّقنيّة المحرّمة

12
00:02:22,310 --> 00:02:24,510
.فلا يمكنه لمسها

13
00:02:25,350 --> 00:02:29,890
.لقد حمتها طيبة إن نو غيوجا

14
00:02:30,120 --> 00:02:33,390
.ولكنّ الكنز سيُفقد إن ظلّ هكذا

15
00:02:34,710 --> 00:02:41,160
والآن، ما أنت إلاّ مخزنًا
.يستجمع طاقة الطّبيعة

16
00:02:41,460 --> 00:02:43,660
سوف تحملين التّقنيّة الضّروريّة لتفعليها

17
00:02:43,660 --> 00:02:47,510
.وإطلاق طاقة الطّبيعة المستجمعة تلك

18
00:02:47,810 --> 00:02:50,390
...ثمّ سيحين دوري

19
00:02:50,390 --> 00:02:55,360
النّاجي الوحيد من عشيرة تسوتشيغومو
.الّذي أتقن تلك التّقنيّة

20
00:02:56,540 --> 00:02:58,580
يا له من تحوّل للأحداث
ناجم عن حسن حظّ، أليس كذلك يا هوتارو؟

21
00:02:58,580 --> 00:03:01,810
هذه التّقنيّة الّتي ستعيد العشيرة لمجدها

22
00:03:01,810 --> 00:03:04,490
.توشك أن ترى النّور

23
00:03:04,850 --> 00:03:10,140
.لنستعملها لإخافة هؤلاء الّذين استنكروا عشيرتنا

24
00:03:12,310 --> 00:03:15,470
ما الأمر يا هوتارو؟ ألستِ سعيدة؟

25
00:03:18,250 --> 00:03:22,330
.اضحكي إذًا. هيّا

26
00:03:27,240 --> 00:03:28,200
.فهمت

27
00:03:28,680 --> 00:03:31,700
.أنت سعيدة أيضًا. يجب عليك ذلك

28
00:03:31,870 --> 00:03:33,540
.يجب عليك ذلك

29
00:03:44,090 --> 00:03:46,450
!أسلوب تسوتشيغومو: تحرير التّقنيّة المحرّمة

30
00:03:47,510 --> 00:03:48,700
!الانفجار الكبير

31
00:04:25,900 --> 00:04:27,570
...ها هي، ها هي

32
00:04:27,890 --> 00:04:30,240
.والآن، الورقة الرّابحة لإعادة إحياء عشيرتنا

33
00:04:30,240 --> 00:04:31,370
.هذه هي لحظتنا

34
00:04:31,370 --> 00:04:34,590
ستستيقظ التّقنيّة المحرّمة بعد
!أن خُتمت لعقد من الزّمن

35
00:04:37,490 --> 00:04:39,480
!اجمعي التشاكرا

36
00:04:40,080 --> 00:04:42,930
،تدفّقي في جسد هوتارو
!الّذي يقوم مقام الحاوي لك

37
00:04:42,930 --> 00:04:46,020
!وأظهري لنا قوّتك المرعبة

38
00:05:03,040 --> 00:05:05,020
!أوتاكاتا! ما الّذي تفعله؟

39
00:05:06,760 --> 00:05:08,480
...التشاكرا تتدفّق

40
00:05:09,030 --> 00:05:10,000
تشاكرا؟

41
00:05:13,350 --> 00:05:15,310
.لا أرى أيّ شيء

42
00:05:15,940 --> 00:05:19,230
على الأرجح أنّها تشاكرا توجد
.داخل هذا الجوّ والتضاريس

43
00:05:29,340 --> 00:05:30,400
ما هذا؟

44
00:05:31,050 --> 00:05:31,900
...إنّها التشاكرا

45
00:05:33,070 --> 00:05:35,960
.إنّها تتدفّق مع تيّار التشاكرا نحو مكان معيّن

46
00:05:36,610 --> 00:05:37,880
...ولا بدّ أنّ هوتارو

47
00:05:38,650 --> 00:05:39,730
!هل هي هناك؟

48
00:05:40,320 --> 00:05:41,310
!لننطلق

49
00:05:43,810 --> 00:05:44,450
!حسنًا

50
00:05:49,720 --> 00:05:52,290
لماذا تتجمّع التشاكرا هناك؟

51
00:05:54,610 --> 00:05:57,250
أخبرني، هل أنت واثق أنّ هوتارو ستكون هناك؟

52
00:05:57,960 --> 00:06:00,710
!لنتحرّك إن كان لديك وقت للحديث

53
00:06:10,170 --> 00:06:11,060
...هوتارو

54
00:06:13,890 --> 00:06:14,540
!هناك

55
00:06:15,230 --> 00:06:16,500
!حسنًا

56
00:06:28,090 --> 00:06:29,540
!هوتارو

57
00:06:33,340 --> 00:06:34,410
...لقد تأخّرنا

58
00:06:35,990 --> 00:06:37,870
.لا فائدة منهم

59
00:06:37,870 --> 00:06:41,140
ألم يكن بمقدورهم تأخيركما لوقت أطول؟

60
00:06:44,460 --> 00:06:47,810
.حسنًا، لا أمانع وجود بعض المتفرّجين

61
00:06:49,040 --> 00:06:50,140
!أيّها الوغد

62
00:06:50,600 --> 00:06:52,410
!ما الذي فعلته لهوتارو؟

63
00:06:53,510 --> 00:06:54,800
...سيّد أوتاكاتا

64
00:06:55,390 --> 00:07:00,930
.هذا حلم هوتارو وأنا أساعدها في تحقيقه

65
00:07:01,330 --> 00:07:03,720
.إحياء عشيرة تسوتشيغومو

66
00:07:04,010 --> 00:07:05,970
ومفتاح القيام بذلك

67
00:07:05,970 --> 00:07:09,570
.هو تفعيل التّقنيّة المحرّمة بقدراتي

68
00:07:10,500 --> 00:07:13,950
قدراتك؟ ما الّذي تعنيه؟

69
00:07:14,420 --> 00:07:18,470
.إنّها لا تملك الموهبة لتفعيل التّقنيّة المحرّمة بعد

70
00:07:18,470 --> 00:07:21,890
.إنّها قادرة فقط على تجميع تشاكرا الطّبيعة

71
00:07:22,940 --> 00:07:28,180
.لذلك سأقوم بتفعيلها من أجلها من الخارج

72
00:07:28,580 --> 00:07:32,640
بهدف إعادة شرف عشيرة
.تسوتشيغومو الّذي مُرِّغَ بالتّراب

73
00:07:32,690 --> 00:07:36,420
أيّ شرف هو هذا؟! كلّ ما تحاول
فعله هو سلب مشاعر هوتارو

74
00:07:36,420 --> 00:07:39,560
.الّتي تكنّها لجدّها وتونبي وعشيرتها

75
00:07:39,560 --> 00:07:42,330
!كلّ ما تعتبره عزيزًا على قلبها

76
00:07:45,300 --> 00:07:48,260
من يحتاج لأشياء رخيصة كالمشاعر؟

77
00:07:48,440 --> 00:07:50,500
.سأسلب العالم بأسره

78
00:07:50,820 --> 00:07:51,960
!ماذا؟

79
00:07:52,360 --> 00:07:56,170
ما دمتُ أملك هذا، فسواء كانوا
...الكاغي الخمسة أو الحكّام

80
00:07:56,170 --> 00:07:59,200
.فلن يكون أحد قادرًا على تجاهلي

81
00:07:59,200 --> 00:08:00,640
...قرية جديدة

82
00:08:00,640 --> 00:08:06,020
كلاّ، يمكنني الحصول حتّى على أراضٍ أعلى
.قدرًا من الأمم الخمس العظيمة

83
00:08:06,510 --> 00:08:07,910
!هل فقدتَ عقلك؟

84
00:08:08,440 --> 00:08:10,430
.لم أكن جادًّا أكثر من هذا من قبل

85
00:08:10,430 --> 00:08:13,960
،بما أنّي وصلتُ إلى هذه المرحلة
.أستطيع مجابهة الأمم الخمس العظيمة

86
00:08:14,370 --> 00:08:15,630
،بهذه التّقنيّة المحرّمة

87
00:08:15,630 --> 00:08:18,140
!لم تصبح السّيطرة على العالم مجرّد حلم

88
00:08:18,570 --> 00:08:20,530
!عرفتُ هذا

89
00:08:20,750 --> 00:08:25,650
!أنت لا تهتمّ بشأن أفراد عشيرة تسوتشيغومو

90
00:08:26,050 --> 00:08:28,220
.نعم، ذلك أمر مسلّم به

91
00:08:28,430 --> 00:08:31,820
!وهوتارو... ماذا عن مشاعر هوتارو؟

92
00:08:31,820 --> 00:08:33,790
.وكأنّي أهتمّ لشيء كهذا

93
00:08:33,790 --> 00:08:35,580
...لقد وثِقتْ بك

94
00:08:36,190 --> 00:08:39,350
زُرع ختم منقوش بذلك الحجم في جسدها

95
00:08:39,350 --> 00:08:42,020
وقد حمت التّقنيّة المحرّمة بكلّ قوّتها

96
00:08:42,020 --> 00:08:44,120
.من أجل قريتها

97
00:08:44,840 --> 00:08:46,690
.لقد عهدت لك بذلك

98
00:08:51,980 --> 00:08:58,720
.صحيح أنّي قتلتُ والدي بغرض إشباع جشعي

99
00:08:59,200 --> 00:09:03,680
.لكن لا يحقّ لك الكلام. أعرف كلّ شيء عنك

100
00:09:04,330 --> 00:09:07,500
أنت مدرج في كتاب البينغو، صحيح؟

101
00:09:08,260 --> 00:09:10,920
أنت نينجا فارّ من قرية الضّباب، صحيح؟

102
00:09:11,640 --> 00:09:14,470
.لقد أدرت ظهرك لقرية الضّباب

103
00:09:14,650 --> 00:09:17,120
...لا أحتاج لأن أتلقّى درسًا

104
00:09:17,590 --> 00:09:20,140
!من شخص لا يأبه حتّى لقريته

105
00:09:24,620 --> 00:09:30,960
.واضح أنّنا متشابهان. لا يوجد اختلاف بيننا

106
00:09:37,570 --> 00:09:41,410
.لم أخدعك. ما أخبرتك في السّابق كان الحقيقة

107
00:09:41,410 --> 00:09:43,390
رغم أنّه عليّ أن أضيف أنّ والدي

108
00:09:43,390 --> 00:09:47,140
،الّذي مات وهو يحمي التّقنيّة المحرّمة
!مات لأنّي أنا من قتلتُه

109
00:09:47,930 --> 00:09:52,410
أوتاكاتا هو مجرم شنيع قتل
.معلّمه وفرّ من القرية

110
00:09:53,120 --> 00:09:57,560
!كلاّ... السّيّد أوتاكاتا لا يشبه ذلك الرّجل أبدًا

111
00:09:57,950 --> 00:10:00,380
...ومع ذلك، ومع ذلك أنا

112
00:10:21,870 --> 00:10:22,940
!ماذا؟

113
00:10:25,790 --> 00:10:30,960
...هـ-هذه... القوّة

114
00:10:32,050 --> 00:10:35,300
!مهلاً! توقّف! توقّف

115
00:10:42,410 --> 00:10:43,920
هل ضربتُ على وتر حسّاس؟

116
00:10:47,160 --> 00:10:49,440
.حسنًا، لا يهمّ ذلك

117
00:10:49,760 --> 00:10:53,610
،لكن بما أنّ هوتارو متشبّثة كثيرًا بقومها

118
00:10:54,240 --> 00:10:57,920
أنا مستعدّ لأسمّي دولتي الجديدة
.تيمّنًا بتسوتشيغومو

119
00:10:59,400 --> 00:11:01,350
.لستُ قاطع طريق قبل كلّ شيء

120
00:11:01,350 --> 00:11:03,510
،بالتّفكير في البلاد الّذي وُلدتُ فيها

121
00:11:03,510 --> 00:11:05,090
.فأنا أساعد في إعادة مجدها

122
00:11:05,760 --> 00:11:07,960
!يمكنني القول أنّني شخص جيّد للغاية

123
00:11:07,960 --> 00:11:08,770
!كفاك عبثًا

124
00:11:09,170 --> 00:11:15,320
.أنت على حقّ. ربّما أنا لا أهتمّ بشأن قريتي

125
00:11:15,740 --> 00:11:16,570
...أوتاكاتا

126
00:11:16,570 --> 00:11:18,290
لكن ما الّذي سيحدث لهوتارو؟

127
00:11:19,920 --> 00:11:24,650
سوف تعيش وستكون السّلاح الأقوى
.للتّقنيّة المحرّمة

128
00:11:24,860 --> 00:11:27,270
...سوف أتحكّم في هذه التّقنيّة العظيمة

129
00:11:28,520 --> 00:11:30,290
.وستكون أداة لي

130
00:11:30,770 --> 00:11:34,690
أداة... هل قلتَ "أداة"؟

131
00:11:35,130 --> 00:11:36,540
.نعم

132
00:11:37,220 --> 00:11:38,660
!أداتي أنا

133
00:11:40,230 --> 00:11:41,210
!اخرس

134
00:11:49,630 --> 00:11:51,440
سيطرة

135
00:11:59,730 --> 00:12:04,140
.هذا مؤسف. لا يمكنك معارضتي بعد الآن

136
00:12:04,440 --> 00:12:05,880
.تمامًا مثل هوتارو

137
00:12:13,050 --> 00:12:15,130
.جيّد، أريد المزيد

138
00:12:15,130 --> 00:12:18,140
!دعي جسدك يتدفّق بالتشاكرا

139
00:12:28,440 --> 00:12:32,320
والآن، ما الّذي سأجبرك على فعله؟

140
00:12:33,530 --> 00:12:38,800
ماذا عن دفع زميلين لقتال بعضهما؟

141
00:12:43,510 --> 00:12:44,590
.لا يمكنني الحركة

142
00:12:45,230 --> 00:12:47,610
أو سأجعلك حارسًا لي؟

143
00:12:48,610 --> 00:12:51,070
.يمكنك حراسة أداتي

144
00:12:51,440 --> 00:12:52,490
...أيّها

145
00:12:55,630 --> 00:12:57,960
سيطرة

146
00:12:59,710 --> 00:13:03,470
.لا تعتقد أنّه يمكنك الاقتراب من أداتي بسهولة

147
00:13:04,760 --> 00:13:08,020
!كفّ عن مناداتها بأداتك

148
00:13:09,480 --> 00:13:11,940
!هوتارو ليست أداة

149
00:13:12,400 --> 00:13:14,900
.أنت مزعج. لا تتكلّم

150
00:13:22,210 --> 00:13:23,800
.انسَ الأمر

151
00:13:23,800 --> 00:13:26,690
.لا يحقّ لك المعارضة

152
00:13:26,690 --> 00:13:32,820
.هوتارو اختارتني. اختارت أن تكون الحاوي

153
00:14:00,040 --> 00:14:04,670
سأعمل على إعادة إحياة عشيرة
.تسوتشيغومو مع السّيّد شيرانامي

154
00:14:05,930 --> 00:14:07,980
.شكرًا على كلّ ما فعلته لي

155
00:14:11,980 --> 00:14:16,450
.وداعًا. من تلميذتك هوتارو

156
00:14:23,960 --> 00:14:28,100
.لا تريد هوتارو أن يتمّ إنقاذها

157
00:14:28,390 --> 00:14:32,850
لذلك قفا هنا وشاهدا قرية تسوتشيغومو
.وهي تختفي في رمشة عين

158
00:14:33,730 --> 00:14:36,780
.سيّد أوتاكاتا. أنا آسفة

159
00:14:37,160 --> 00:14:39,870
.كلّ هذا بسبب حماقتي

160
00:14:47,510 --> 00:14:51,310
.ما زالت لديك الإرادة لتقاومي

161
00:14:55,320 --> 00:14:56,780
.سيّد أوتاكاتا

162
00:14:57,950 --> 00:14:59,080
!سُحقًا

163
00:15:03,830 --> 00:15:07,640
.قليلاً بعد وسيصبح حاوي هوتارو ممتلئًا بالتشاكرا

164
00:15:08,300 --> 00:15:12,520
.ستكونان شاهدَيّ على إعادة إحياء التّقنيّة المحرّمة

165
00:15:29,890 --> 00:15:33,390
من المستحيل أن نستطيع قتال
.هؤلاء الأربعة هكذا

166
00:15:33,390 --> 00:15:36,820
.علينا أوّلاً إيقاف القرويّين

167
00:15:36,820 --> 00:15:37,950
لكن كيف؟

168
00:15:38,280 --> 00:15:40,780
.لن نُلام إن استعملنا بعض القوّة معهم

169
00:15:41,160 --> 00:15:43,040
.سوف نقوم بعزلهم في مكان واحد جميعًا

170
00:15:47,760 --> 00:15:49,010
!أنا آسفة

171
00:15:49,010 --> 00:15:50,720
.يجب أن أستعمل بعض القوّة

172
00:15:51,180 --> 00:15:53,220
!خذوا هذه

173
00:16:03,660 --> 00:16:05,120
!لفيفة الوحش الخارق

174
00:16:23,740 --> 00:16:26,130
!عنصر الخشب: تقنيّة منزل الأعمدة الأربعة

175
00:16:29,300 --> 00:16:31,760
.سوف نتركهم هناك بعض الوقت

176
00:16:33,090 --> 00:16:35,560
.يا لها من طريقة لإفساد متعتنا

177
00:16:35,770 --> 00:16:38,980
.لا يمكننا أن نسمح لكم بالقيام بما يحلو لكم

178
00:16:39,570 --> 00:16:41,450
.هذا ما يجب علينا نحن أن نقوله

179
00:16:41,780 --> 00:16:43,360
.أتساءل بشأن ذلك

180
00:16:54,590 --> 00:16:57,940
.لن يكون الأمر ممتعًا بلا مشاهدين

181
00:17:03,070 --> 00:17:06,250
يا إلهي، أليس هنالك نهاية لهذا؟

182
00:17:10,880 --> 00:17:11,670
...سُحقًا

183
00:17:17,060 --> 00:17:19,360
.تبلين حسنًا يا هوتارو

184
00:17:19,610 --> 00:17:22,610
.لا بدّ أن ضيفينا قد بدآ يشعران بالقلق

185
00:17:29,500 --> 00:17:32,460
!والآن، سلّمي جسدك وروحك لي

186
00:17:32,880 --> 00:17:35,890
!أطلقي التشاكرا الّتي جمعتها دفعة واحدة

187
00:17:36,060 --> 00:17:40,020
!لنحوّل هذا المكان الّذي رفضك إلى رماد

188
00:17:45,030 --> 00:17:45,960
...فنّ النّينجا

189
00:17:46,330 --> 00:17:47,080
!ماذا؟

190
00:17:47,080 --> 00:17:47,960
!قنبلة الفقاعة

191
00:17:52,960 --> 00:17:54,170
!أيّها الأبله

192
00:17:54,840 --> 00:17:56,810
متى جهّزت لذلك؟

193
00:17:56,930 --> 00:18:01,110
.كنتَ لتعيش أكثر لو أحسنتَ التّصرّف

194
00:18:18,850 --> 00:18:21,600
لماذا لم تنجح تقنيّة الكلمة المقيّدة؟

195
00:18:21,810 --> 00:18:23,060
...هذان

196
00:18:23,060 --> 00:18:25,410
...كمّيّة التشاكرا هذه غير طبيعيّة

197
00:18:25,830 --> 00:18:29,960
!وكأنّنا سنسمح له بالسّيطرة علينا بسهولة

198
00:18:33,000 --> 00:18:34,630
!لن أسمح لكما

199
00:18:37,890 --> 00:18:39,600
!تقنيّة نسخ الظّلّ المتعدّدة

200
00:18:41,640 --> 00:18:42,770
!تقنيّة الكلمة المقيّدة

201
00:18:42,770 --> 00:18:46,280
!حجر

202
00:18:55,470 --> 00:18:56,890
!أيّها الوغد

203
00:19:04,060 --> 00:19:05,060
...هوتارو

204
00:19:05,870 --> 00:19:07,530
!هل أنت بخير يا هوتارو؟

205
00:19:15,220 --> 00:19:16,140
!هوتارو

206
00:19:18,930 --> 00:19:20,470
ما العمل؟

207
00:19:22,350 --> 00:19:24,810
أيّها الوغد... أما زلت تريد القتال؟

208
00:19:24,810 --> 00:19:25,990
!مهلاً

209
00:19:26,570 --> 00:19:30,660
هل نسيتما أنّ تقنيّة الكلمة
المقيّدة تتحكّم بهوتارو؟

210
00:19:35,550 --> 00:19:36,510
!تراجعا

211
00:19:37,260 --> 00:19:38,300
!سُحقًا

212
00:19:38,680 --> 00:19:42,510
إنّها لم تُشحن بالكامل بعد بتشاكرا
...الطّبيعة، ولكن

213
00:19:46,530 --> 00:19:48,910
.والآن ياهوتارو... لنريهما

214
00:19:50,280 --> 00:19:52,910
!لنريهما كم أنّ التّقنيّة المحرّمة مريعة

215
00:20:05,650 --> 00:20:08,240
.لنبدأ الآن

216
00:20:09,200 --> 00:20:09,990
.كلاّ

217
00:20:12,490 --> 00:20:14,450
!لنرِ العالم ما لدينا

218
00:20:15,120 --> 00:20:16,710
...ما لدينا

219
00:20:16,710 --> 00:20:20,180
.بل ما لديّ من قوّة

220
00:20:20,180 --> 00:20:22,850
!كلاّ... كلاّ

221
00:20:23,390 --> 00:20:24,720
!موتا

222
00:20:24,970 --> 00:20:26,360
!تقنيّة الغضب

223
00:20:27,820 --> 00:20:30,740
!كلاّ