1
00:00:36,520 --> 00:00:38,490
.ذلك المقعد محجوزٌ لي

2
00:00:40,520 --> 00:00:42,030
!السّيّد أوتاكاتا

3
00:00:42,960 --> 00:00:45,060
.يبحث تونبي عنكِ

4
00:00:52,170 --> 00:00:53,460
.أعتمد عليك

5
00:01:05,350 --> 00:01:06,420
.ليس ثانية

6
00:01:08,440 --> 00:01:14,960
مؤكّدٌ أنّهم واجهوا وقتًا عصيبًا لنصب هذا العدد
.الكبير من الفخاخ في حقل مفتوح كهذا

7
00:01:16,390 --> 00:01:20,230
.يخترق أحدهم فخاخنا ويقترب من حصننا

8
00:01:20,900 --> 00:01:23,520
،تحسّبًا فقط، بموجب تعليمات السّيّد الرّاحل

9
00:01:23,520 --> 00:01:27,100
.أرسلتُ إنذارًا لقرية الورق المخفيّة

10
00:01:28,800 --> 00:01:32,980
.لا يمكن لأيّ شخص عاديّ أن يقترب من حصننا

11
00:01:33,710 --> 00:01:36,670
لكن إذا تمكّن العدوّ من الوصول
...إلى هنا بنجاح

12
00:01:36,980 --> 00:01:40,510
،نحن الثّلاثة، بمن فينا السّيّد أوتاكاتا
!يجب علينا أن نقاتل سويّة

13
00:01:40,510 --> 00:01:41,860
!سنقلب الموازين لصالحنا

14
00:01:42,720 --> 00:01:47,020
لماذا يستهدفوننا؟ ما هدفهم؟

15
00:01:47,660 --> 00:01:49,360
...على الأرجح

16
00:01:49,360 --> 00:01:53,100
.التّقنيّة المحرّمة الّتي تناقلتها عشيرتنا من جيل لآخر

17
00:01:54,970 --> 00:01:59,200
يزداد عدد الفخاخ كلّما اقتربتم
.من الحصن، ثمّ هنالك وادٍ عميق

18
00:01:59,770 --> 00:02:02,350
.وفوق هذا يوجد حاجز ذلك

19
00:02:02,930 --> 00:02:05,600
.إنّهم يَقِظون بشكل مفرط

20
00:02:06,140 --> 00:02:09,240
ألا تعتقد ذلك يا نانغو؟

21
00:02:12,220 --> 00:02:13,150
...أجل

22
00:02:14,090 --> 00:02:17,590
أنت رجل قليل الكلام، ألست كذلك؟

23
00:02:18,020 --> 00:02:21,010
.كفاك ثرثرة يا تشوشين

24
00:02:22,260 --> 00:02:25,960
.اللّسان السّائب هو دلالة على عقل فارغ

25
00:02:26,430 --> 00:02:30,270
بل يمكنني القول أنّك أنت من يبدو
.سيّئًا كلّما فتحت فاهك

26
00:02:30,810 --> 00:02:32,010
...يا بنتِن

27
00:02:34,170 --> 00:02:39,250
بذل كلّ هذه الجهود لحماية شيء
!هو برهان على قيمته

28
00:02:40,470 --> 00:02:41,850
.تمركزوا في مواقعكم

29
00:02:54,130 --> 00:02:55,630
...لا بدّ وأن ذلك

30
00:03:04,600 --> 00:03:07,670
.ماذا؟! لقد كُسر الحاجز

31
00:03:08,440 --> 00:03:11,210
.هؤلاء... ليسوا أشخاصًا عاديّين

32
00:03:12,380 --> 00:03:13,320
!بنتن

33
00:03:13,320 --> 00:03:14,680
!دعهم لي

34
00:03:29,260 --> 00:03:31,370
.والآن سنتسلّق الجبل

35
00:03:32,730 --> 00:03:35,490
.سيّدتي هوتارو، خذي هذه

36
00:03:36,170 --> 00:03:39,620
،لحماية التّقنيّة المحرّمة الّتي أورثها جدّكِ

37
00:03:39,620 --> 00:03:44,510
يجب عليكِ وعلى السّيّد أوتاكاتا
.الهرب إلى قريتنا المخفيّة

38
00:03:45,040 --> 00:03:46,180
ماذا عنك؟

39
00:03:47,080 --> 00:03:50,610
.سأتبعكما فورًا، يجب أن تسرعا الآن

40
00:03:50,950 --> 00:03:53,650
.لا! إذا هربنا، فسوف نهرب نحن الثّلاثة معًا

41
00:03:53,850 --> 00:03:56,590
.اقترب العدوّ كثيرًا

42
00:03:56,790 --> 00:03:59,690
.الوقت غير مناسب لكون متساهلين

43
00:04:03,930 --> 00:04:05,090
ألن تأتين؟

44
00:04:08,180 --> 00:04:10,360
.اذهبي يا سيّدتي هوتارو

45
00:04:16,040 --> 00:04:17,200
!سيّد أوتاكاتا

46
00:04:20,170 --> 00:04:24,880
.أرجوك... اعتن بسيّدتي هوتارو

47
00:04:26,320 --> 00:04:27,820
.سأسدّد الدّين الّذي أدين لك به

48
00:04:40,120 --> 00:04:41,540
.كان ذلك وشيكًا

49
00:04:41,970 --> 00:04:45,470
.لن يكون هذا تسلّقًا عاديًّا يا أكوبوشي

50
00:04:46,270 --> 00:04:50,940
.أنا متحمّس لأرى ما الّذي ينتظرنا في القمّة

51
00:04:52,020 --> 00:04:53,350
...سيّدتي هوتارو

52
00:04:53,380 --> 00:04:55,860
.توخّي الحذر الشّديد أثناء التّرحال

53
00:04:56,380 --> 00:05:00,320
.يجب ألاّ تبتعدي عن السيّد أوتاكاتا

54
00:05:00,860 --> 00:05:04,840
!تونبي، يجب أن تتبعنا لاحقًا. عدني بذلك

55
00:05:05,090 --> 00:05:08,550
سيّدتي هوتارو، لا تفكّري سوى
!بسلامتكِ لا بشيء آخر

56
00:05:15,670 --> 00:05:21,010
سيّدي إن نو غيوجا... أعدك أن أكسب
.أكبر قدر ممكن من الوقت

57
00:05:24,210 --> 00:05:27,050
!كي أتمكّن من حماية السّيّدة هوتارو

58
00:06:59,980 --> 00:07:04,490
المتجوّل

59
00:07:04,220 --> 00:07:06,700
.سيّدة تسونادي، تلقّينا هذه

60
00:07:14,130 --> 00:07:15,070
!ماذا؟

61
00:07:40,460 --> 00:07:41,560
!السّيدة كاتسويو

62
00:07:42,760 --> 00:07:43,880
...كاكاشي

63
00:07:44,260 --> 00:07:47,740
ماذا؟ قطعت السّيّدة كاتسويو كلّ هذه
المسافة لتلقي التّحية علينا فقط؟

64
00:07:48,200 --> 00:07:49,840
.لا، لم تفعل

65
00:07:52,040 --> 00:07:54,570
.لا بدّ أنّ مشكلة قد وقعت

66
00:07:56,620 --> 00:07:57,750
...والسّبب

67
00:07:59,180 --> 00:08:04,460
لا تستخدم السّيّدةُ تسونادي السّيّدةَ كاتسويو
.إلاّ في الحالات الطّارئة

68
00:08:04,650 --> 00:08:07,720
.فهمت! هنالك حالة طارئة إذًا

69
00:08:08,360 --> 00:08:10,690
...أعرف شعورك يا شينو

70
00:08:10,690 --> 00:08:13,690
.عندما لم يُسمح لك بإكمال ما أردت قوله

71
00:08:13,960 --> 00:08:16,060
معاهدة سرّية؟

72
00:08:16,830 --> 00:08:19,370
،أثناء حرب النّينجا العظيمة الثّالثة

73
00:08:19,370 --> 00:08:26,030
أبادت تقنيّة ما موروثة بواسطة إن نو غيوجا
.قائد عشيرة تسوتشيغومو قرية كاملة

74
00:08:44,390 --> 00:08:50,430
طلب الهوكاغي الثّالث أن يتمّ تصنيف مثل
.هذه التّقنيّة الخطيرة كتقنيّة محرّمة

75
00:08:51,300 --> 00:08:56,190
وبالمقابل، تمّ الاتّفاق على أن توفّر
قرية الورق المخفيّة المساعدة

76
00:08:56,190 --> 00:08:59,040
.لعشيرة تسوتشيغومو عند تعرّضها لخطر

77
00:09:00,770 --> 00:09:05,040
كاكاشي، عليك إبلاغ القرية بتفاصيل
.مهمّتك السّابقة

78
00:09:05,570 --> 00:09:06,970
.عُلم

79
00:09:07,980 --> 00:09:09,480
.الوقت يداهمنا

80
00:09:09,780 --> 00:09:14,190
سيذهب الفريق السّابع مع القائد ياماتو
.ويتوجّه إلى جبل كاتسوراغي فورًا

81
00:09:14,190 --> 00:09:14,770
!عُلم

82
00:09:15,180 --> 00:09:17,830
لماذا لن تأتي يا كاكاشي سينسي؟

83
00:09:18,660 --> 00:09:20,490
ألا يكفي وجودي أنا؟

84
00:09:20,790 --> 00:09:23,190
...ليس هذا ما قصدت

85
00:09:24,790 --> 00:09:29,340
توفّي إن نو غيوجا منذ عام
والحصن في جبل كاتسوراغي

86
00:09:29,350 --> 00:09:33,170
.تسكنه حفيدته هوتارو وخادمها

87
00:09:34,470 --> 00:09:39,160
من يهاجم الحصن هو بلا شكّ يستهدف
.تقنيّة إن نو غيوجا المحرّمة

88
00:09:39,710 --> 00:09:44,010
يجب أن نمنع سرقة التّقنيّة المحرّمة
.مهما كلّف الأمر

89
00:09:44,780 --> 00:09:46,660
لماذا أرسلتِ ناروتو أيضًا؟

90
00:09:47,220 --> 00:09:51,560
.إنّه إجراء مضادّ للأكاتسكي

91
00:09:53,020 --> 00:09:55,600
!الوميض البرقيّ

92
00:10:11,840 --> 00:10:17,240
هل أراد هذا العجوز حماية الحصن بمفرده؟

93
00:10:17,250 --> 00:10:19,850
.مع ذلك استغرق هذا فترة أطول من المخطّط

94
00:10:20,360 --> 00:10:21,790
.لنسرع ونبدأ بالبحث

95
00:10:27,660 --> 00:10:30,830
!أهذا هو حصن عشيرة تسوتشيغومو؟

96
00:10:33,400 --> 00:10:34,560
!أيّها القائد ياماتو

97
00:10:41,540 --> 00:10:43,570
ماذا حدث هنا؟

98
00:10:43,570 --> 00:10:45,570
.لا يبدو أنّ هذا حدث جرّاء معركة

99
00:10:45,810 --> 00:10:47,170
ساي، ماذا عنك؟

100
00:10:47,550 --> 00:10:51,150
.هنالك آثار أقدام حديثة العهد ممتدّة نحو الحصن

101
00:10:51,950 --> 00:10:53,390
.العدوّ مؤلّف من أربعة أشخاص

102
00:10:53,980 --> 00:10:56,380
.هنالك بعض الفخاخ المحيطة بالحصن

103
00:10:56,960 --> 00:10:59,190
.يبدو أنّ العدوّ قد تجنّبها

104
00:10:59,190 --> 00:11:01,900
معنى هذا أنّ هناك المزيد في المنطقة؟

105
00:11:01,900 --> 00:11:05,570
كلّ ما علينا هو تتبّع أثر علامات الفخاخ

106
00:11:05,590 --> 00:11:06,710
!فهمت

107
00:11:06,710 --> 00:11:10,090
بهذا الشكل سنصل إلى الحصن
.دون مواجهة أيّ فخّ حديث

108
00:11:11,340 --> 00:11:14,270
!أين تقنيّة إن نو غيوجا المحرّمة؟

109
00:11:20,610 --> 00:11:23,910
.لقد خسرت، لذا تكلّم

110
00:11:24,910 --> 00:11:25,860
.لا أعرف شيئًا

111
00:11:26,420 --> 00:11:28,690
!لا فائدة من ادّعاء الحماقة

112
00:11:29,290 --> 00:11:30,750
.الحفيدة

113
00:11:32,190 --> 00:11:36,340
.هذا صحيح، لدى إن نو غيوجا حفيدة

114
00:11:38,980 --> 00:11:40,730
هل تركتها تهرب؟

115
00:11:40,730 --> 00:11:42,650
التّقنيّة المحرّمة بحوزتها؟

116
00:11:43,200 --> 00:11:44,970
!هل ما يقوله صحيح؟ أنت

117
00:11:45,240 --> 00:11:48,210
.يكفي، أعرف أين أجدها

118
00:11:50,080 --> 00:11:55,280
.نفد وقتنا. يبدو أنّ لدينا دخلاء

119
00:12:02,430 --> 00:12:04,760
.نهاية مسدودة يا حضرة القائد ياماتو

120
00:12:04,760 --> 00:12:07,480
.سننصب جسرًا عبرها فحسب

121
00:12:08,280 --> 00:12:09,530
!تقنية عنصر الخشب

122
00:12:14,070 --> 00:12:16,230
!أنت شخص يُعتمد عليه أيّها القائد ياماتو

123
00:12:16,920 --> 00:12:19,550
ألست مسرورًا بوجودي هنا؟

124
00:12:21,560 --> 00:12:24,060
.لا تزد الطّين بلّة

125
00:12:33,360 --> 00:12:35,240
!تماسك أيّها العجوز

126
00:12:36,140 --> 00:12:39,050
.ما زال يملك نبضًا رغم أنّه ضعيف

127
00:12:39,460 --> 00:12:41,210
...تأخّرنا قليلاً

128
00:12:41,800 --> 00:12:45,720
.ساي، تفقّد المنطقة لترى ما إن كان هناك غيره

129
00:12:45,720 --> 00:12:46,730
.حاضر

130
00:12:53,320 --> 00:12:54,860
...استفقت

131
00:12:55,740 --> 00:12:59,880
نحن من قرية ورق الشّجر المخفيّة
.وقد تمّ إرسالنا لتوفير الدّعم

132
00:13:00,550 --> 00:13:04,170
أنت خادم السّيّدة هوتارو على ما أعتقد؟

133
00:13:06,130 --> 00:13:09,480
...أنا... تونبي

134
00:13:27,930 --> 00:13:34,430
السّيّدة هوتارو متوجّهة إلى قرية
.عشيرة تسوتشيغومو المخفيّة

135
00:13:35,320 --> 00:13:39,790
.هنالك طريق للهرب ذو مدخل منهار خلف القصر

136
00:13:40,960 --> 00:13:44,010
...دخلت السّيّدة هوتارو من هناك

137
00:13:44,460 --> 00:13:47,180
.فهمت، سوف نتبعها

138
00:13:47,680 --> 00:13:51,020
.ساكورا، ابقي هنا وداوي جراح السّيّد تونبي

139
00:13:51,600 --> 00:13:52,520
.حاضرة

140
00:13:52,520 --> 00:13:55,610
.ناروتو، ساي، هيّا بنا

141
00:14:27,640 --> 00:14:32,520
...سيّد أوتاكاتا، أودّ أن أسألك سؤالاً

142
00:14:35,020 --> 00:14:39,700
هل ستعلّمني التّقنيّات حتّى بعد
وصولنا إلى القرية المخفيّة؟

143
00:14:41,750 --> 00:14:45,500
.لا أتذكّر أنّني أعلّمكِ شيئًا

144
00:14:45,790 --> 00:14:49,680
.لكن في الحصن، درّبتني كثيرًا

145
00:14:50,310 --> 00:14:53,040
.فعلتِ ذلك بمفردك

146
00:14:54,390 --> 00:14:57,910
،وأيضًا عندما نصل إلى القرية
.لن تكون لي أيّ فائدة بعدها

147
00:14:58,490 --> 00:15:01,820
!لا يوجد أقوى منك في القرية

148
00:15:01,830 --> 00:15:04,960
.وأنا أريدك أن تعلّمني

149
00:15:05,330 --> 00:15:08,550
...في تلك المرّة عندما أنقذتني

150
00:15:18,610 --> 00:15:20,160
...يا لهم من عنيدين

151
00:15:41,030 --> 00:15:44,760
!ما تلك... التّقنيّة؟ إنّها مذهلة

152
00:15:52,180 --> 00:15:55,430
في الوقت الرّاهن، يجب أن أبقى
.بعيدًا عن الأنظار أثناء تنقّلي

153
00:15:55,430 --> 00:15:56,690
!هل أنت بخير؟

154
00:15:58,610 --> 00:15:59,820
...هذا الجرح

155
00:16:00,530 --> 00:16:04,830
.اسمح لي أن أعالجه في حصننا

156
00:16:05,410 --> 00:16:08,170
هذا أقلّ ما يمكنني فعله مقابل
.مجيئك لمساعدتي

157
00:16:09,470 --> 00:16:10,670
حصن؟

158
00:16:18,070 --> 00:16:19,610
!اصمد أرجوك

159
00:16:20,200 --> 00:16:21,740
.سأطلب المساعدة

160
00:16:23,360 --> 00:16:27,170
تبًّا! استهلكتُ كثيرًا من التشاكرا

161
00:16:24,030 --> 00:16:25,870
...سأعود في الحال

162
00:16:31,420 --> 00:16:35,480
في ذلك الوقت، أردت أن أصبح
!مثلك يا سيّد أوتاكاتا

163
00:16:38,190 --> 00:16:41,150
.لم أنقذك في ذلك الوقت

164
00:16:42,110 --> 00:16:42,820
...لكن

165
00:16:42,820 --> 00:16:47,080
كان الشّينوبي الّذين هاجموك
.يستهدفونني أنا لا أنتِ

166
00:16:48,210 --> 00:16:51,170
.قاتلتُ فقط لحماية نفسي

167
00:16:51,920 --> 00:16:56,770
،ومع هذا، بعد مشاهدتي لك
.أردتُ أن أصبح قويّة مثلك

168
00:16:56,770 --> 00:16:59,340
.كلاّ، بل يجبُ عليّ ذلك

169
00:16:59,730 --> 00:17:02,110
...لهذا أتمنّى تعلّم تقنيّاتك

170
00:17:02,110 --> 00:17:03,810
هل القوّة كافية لكِ؟

171
00:17:07,000 --> 00:17:13,880
قد تصلي لمرحلة في النّهاية تندمين فيها
.على تعلّمكِ من رجل مطلوب

172
00:17:14,260 --> 00:17:16,850
.أنا أثق بك يا سيّد أوتاكاتا

173
00:17:16,850 --> 00:17:20,790
.مهما حدث، سأعتبرك دومًا معلّمي

174
00:17:21,320 --> 00:17:23,480
!لا تناديني بمعلّمكِ

175
00:17:25,400 --> 00:17:25,900
!تبًّا

176
00:17:26,290 --> 00:17:28,100
!ابتعد عن الفتاة

177
00:17:40,810 --> 00:17:41,690
نسخة ظلّ؟

178
00:17:43,440 --> 00:17:44,860
...يا للإزعاج

179
00:17:58,470 --> 00:18:00,230
—استسلم ودعني أقبض عليك

180
00:18:00,230 --> 00:18:00,690
!لا

181
00:18:01,230 --> 00:18:03,360
!إنّه ليس عدوًّا

182
00:18:04,770 --> 00:18:05,820
!ناروتو

183
00:18:11,920 --> 00:18:14,250
.سامحاه على التّسرّع في الاستنتاج

184
00:18:15,040 --> 00:18:18,850
.لم يحدّثنا السّيّد تونبي إلاّ عن السّيّدة هوتارو

185
00:18:19,310 --> 00:18:21,420
هل تونبي بخير؟

186
00:18:21,770 --> 00:18:25,520
.أجل، إنّه تحت رعاية مسعفتنا

187
00:18:26,950 --> 00:18:28,290
...هذا جيّد

188
00:18:28,580 --> 00:18:31,630
.من الآن فصاعدًا، سنحميكِ أيضًا

189
00:18:34,880 --> 00:18:37,220
.أنا حقًّا آسف

190
00:18:38,970 --> 00:18:41,810
.أستطيع ترك الباقي لكم إذًا

191
00:18:42,980 --> 00:18:46,010
...بالتّأكيد! فأنا أنجز مهامي دومًا

192
00:18:47,410 --> 00:18:49,580
.شكرًا... بالتّوفيق

193
00:18:50,290 --> 00:18:51,520
!سيّد أوتاكاتا

194
00:18:53,210 --> 00:18:55,380
إلى أين أنت ذاهب؟

195
00:18:58,180 --> 00:19:01,560
ألا يمكنك البقاء معي على الأقلّ
حتّى نصل إلى القرية المخفيّة؟

196
00:19:02,640 --> 00:19:06,400
.هؤلاء النّاس أقوياء ويمكنكِ الاعتماد عليهم

197
00:19:06,820 --> 00:19:11,080
!لستُ بحاجة لحرّاس
!أحتاج لشخص يعلّمني التّقنيّات

198
00:19:12,080 --> 00:19:14,540
...تعال معي أرجوك

199
00:19:22,430 --> 00:19:25,600
!سأكون جادّة أكثر من أيّ وقت سبق في تدريبي

200
00:19:25,600 --> 00:19:29,240
!سأتحمّل كلّ شيء وأعدك ألاّ أبكي

201
00:19:29,240 --> 00:19:30,360
...وأيضًا

202
00:19:30,390 --> 00:19:36,530
...ولن أناديك بمعلّمي... مجدّدًا... أبدًا

203
00:19:38,550 --> 00:19:41,600
!المعلّم الغبيّ أوتاكاتا

204
00:19:42,720 --> 00:19:45,060
...قلتُ لكِ ألاّ تناديني بذلك

205
00:19:47,030 --> 00:19:50,700
.لستُ أحمقًا بما يكفي لتناديني معلّمًا