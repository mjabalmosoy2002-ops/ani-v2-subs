1
00:00:02,240 --> 00:00:03,040
!لا يمكن

2
00:00:10,240 --> 00:00:11,280
.لا فائدة

3
00:00:38,680 --> 00:00:40,040
...هـ-هذا

4
00:00:42,540 --> 00:00:43,710
إيتاتشي؟

5
00:02:37,030 --> 00:02:38,060
...فلتمت

6
00:02:41,060 --> 00:02:41,930
!أماتيراسو

7
00:02:52,230 --> 00:02:55,460
.أحيّيك على وضعي تحت تأثير الغينجيتسو

8
00:03:00,260 --> 00:03:00,990
...لكن

9
00:03:11,930 --> 00:03:13,730
!ساسكي! هذه فرصتك

10
00:03:13,760 --> 00:03:14,830
لمَ توقّفت؟

11
00:03:28,990 --> 00:03:31,790
كنت مدركًا بالغينجيتسو
.الخاص بك منذ وقت طويل

12
00:03:32,230 --> 00:03:34,760
إنّه بعيد كلّ البعد عن تسوكيومي إيتاتشي المحكمة

13
00:03:34,790 --> 00:03:37,490
.حيث يتلاعب بالوقت بكلّ حرّيّة

14
00:03:41,130 --> 00:03:43,190
.علامة اللعنة التي تشلّ الجسد

15
00:03:44,430 --> 00:03:46,190
.لا بدّ أنّه وضعها حينها

16
00:03:54,430 --> 00:03:56,990
ساسكي... ألا يمكنه الحركة؟

17
00:04:14,190 --> 00:04:16,990
.لست بحاجة لاستعمال التقنيات عليها

18
00:04:19,130 --> 00:04:20,630
تايجيتسو؟

19
00:04:21,590 --> 00:04:24,790
.يبدو أنّه يريد ادّخار التشاكرا خاصته

20
00:04:32,530 --> 00:04:33,230
!إطلاق

21
00:04:35,860 --> 00:04:38,560
.لقد تغيّر تدفّق التشاكرا الخاص بدانزو

22
00:04:38,830 --> 00:04:40,060
ما الذي ينوي فعله؟

23
00:04:43,990 --> 00:04:46,160
،إن كان ساسكي يعلم حقيقة إيتاتشي

24
00:04:46,190 --> 00:04:47,930
.فلا بدّ أنّ الأكاتسكي يعلمون أيضًا

25
00:04:48,930 --> 00:04:51,830
محاولة إخفاء تلك المعلومات
.لوقت أطول أمر مستحيل

26
00:05:00,090 --> 00:05:01,030
لماذا؟

27
00:05:02,460 --> 00:05:07,760
لماذا كان من الضّروري إنقاذ
حياة حثالة مثله يا إيتاتشي؟

28
00:05:11,090 --> 00:05:12,130
!ساسكي

29
00:05:18,390 --> 00:05:20,490
...انظر يا إيتاتشي

30
00:05:20,860 --> 00:05:22,760
.إلى وضعه المؤسف

31
00:05:26,060 --> 00:05:30,890
.إنّه خطؤك المطلق

32
00:05:45,430 --> 00:05:48,460
.لكنّه لم يستطِع قتل أخيه الصّغير

33
00:05:50,390 --> 00:05:52,030
ذرف دموعًا من الدّم

34
00:05:52,060 --> 00:05:54,130
،وقتل أيّ شعور كان بداخله

35
00:05:54,690 --> 00:05:57,930
.ثمّ قتل إخوانه من أجل القرية

36
00:05:59,190 --> 00:06:01,590
.لكنّه لم يتمكّن من قتلك ببساطة

37
00:06:02,260 --> 00:06:04,330
هل تفهم معنى ذلك؟

38
00:06:30,330 --> 00:06:31,960
،بالنّسبة له

39
00:06:34,060 --> 00:06:35,990
...كانت لحياتك قيمة أكبر

40
00:06:36,930 --> 00:06:38,830
.من القرية

41
00:06:59,190 --> 00:07:00,930
.لقد تحرّر من علامة اللعنة

42
00:07:00,960 --> 00:07:02,530
أتلك سوسانو؟

43
00:07:02,960 --> 00:07:05,260
!إنّها مختلفة تمامًا عن ذي قبل

44
00:07:08,560 --> 00:07:09,960
هل هذا ساسكي؟

45
00:07:10,230 --> 00:07:11,190
...هذه التشاكرا

46
00:07:11,290 --> 00:07:13,790
.لم يعد ساسكي الذي أعرفه

47
00:07:14,660 --> 00:07:15,560
.حسنًا

48
00:07:16,230 --> 00:07:19,290
.لقد نضجت كراهيته وزادت قوّته

49
00:07:19,930 --> 00:07:22,160
.وجسده يستجيب لذلك

50
00:07:22,510 --> 00:07:23,670
.الأمر يسير بشكلٍ جيّد

51
00:07:24,370 --> 00:07:27,270
.لا يحتاج لمساعدتي على الإطلاق

52
00:07:45,710 --> 00:07:47,570
.إنّه يستهدف لحظة نزولي

53
00:07:47,870 --> 00:07:49,210
!لا يمكنني القيام بالإشارات في الوقت المناسب

54
00:07:49,240 --> 00:07:50,270
!ما باليد حيلة

55
00:08:09,710 --> 00:08:12,140
.تمكّنت من تغيير مكانه

56
00:08:13,910 --> 00:08:17,110
لقد انخفض مستوى التشاكرا
!الخاص بدانزو بسبب تلك التقنية

57
00:08:17,810 --> 00:08:21,740
لمَ وصل به الحدّ لذلك فقط كي
يتفادى هجوم السوسانو؟

58
00:08:23,170 --> 00:08:26,870
يُفتَرض بالتقنية الذي يستعملها
.هذا الرّجل أن تجعله خالدًا

59
00:08:31,440 --> 00:08:34,740
.التقنية التي أطلقها للتو تقنيته إذًا

60
00:08:36,410 --> 00:08:37,740
.إنّه أسلوب الخشب

61
00:08:38,370 --> 00:08:40,140
...فهمت. لهذا السبب

62
00:08:40,740 --> 00:08:43,010
،بذلك العدد من الشارينغان

63
00:08:43,270 --> 00:08:45,040
عرفت أنّ لا بدّ من وجود سرّ

64
00:08:45,070 --> 00:08:48,510
.لقدرة شخصٍ لا ينتمي للأوتشيها على استعمالها

65
00:08:53,040 --> 00:08:54,510
...أوروتشيمارو اللّعين

66
00:08:55,010 --> 00:08:57,810
.يبدو أنّ دانزو كان على اتّصال به

67
00:09:03,410 --> 00:09:05,370
قام بزرع خلايا الهوكاغي الأوّل هاشيراما

68
00:09:05,670 --> 00:09:08,270
.بداخله ليعزّز طاقته الجسدية

69
00:09:08,410 --> 00:09:11,570
.وبذلك تمكّن من التحكّم بالعديد من الشارينغان

70
00:09:15,540 --> 00:09:16,970
!لا، يمكنه أن يموت

71
00:09:17,570 --> 00:09:19,770
.كان ليموت لو لم يوقف ذلك الهجوم قبل قليل

72
00:09:20,370 --> 00:09:22,710
!لهذا السبّب استنزف ذلك الكمّ من التّشاكرا

73
00:09:24,610 --> 00:09:25,510
!ساسكي

74
00:09:26,070 --> 00:09:27,740
!إنّه دانزو الحقيقي

75
00:09:28,140 --> 00:09:31,140
!لقد تمّ كسر التقنية التي تجعله لا يُقهر الآن

76
00:09:31,540 --> 00:09:32,710
!يمكنك النّيل منه الآن

77
00:09:33,570 --> 00:09:36,170
!تلك المرأة نينجا من النوع المستشعر إذًا

78
00:09:36,440 --> 00:09:38,640
.اكتشفت أمري

79
00:09:38,870 --> 00:09:40,070
.لكنّ الأوان قد فات

80
00:09:57,840 --> 00:09:58,710
!نعم

81
00:10:02,740 --> 00:10:03,670
...لا

82
00:10:04,770 --> 00:10:06,840
،في اللّحظة التي شكّل فيها إشارة

83
00:10:06,870 --> 00:10:09,540
.تغيّر شيء ما بالتشاكرا الخاصة به

84
00:10:09,910 --> 00:10:11,670
!لقد شغّل التقنية

85
00:10:12,110 --> 00:10:14,970
.على الأرجح أنا الوحيدة التي تستطيع رؤية ذلك

86
00:10:15,670 --> 00:10:19,170
.ربّما تأخّر هجوم سوسانو حينها

87
00:10:20,340 --> 00:10:21,240
!تبًّا

88
00:10:36,440 --> 00:10:38,340
،أعاد إلقاء التّقنية مجدّدًا

89
00:10:38,440 --> 00:10:40,710
.لكن لا تزال الأعين الثلاثة مغلقة

90
00:10:41,670 --> 00:10:44,710
،على حدّ علمي، لديه عشرة من الشارينغان في ذراعه

91
00:10:45,070 --> 00:10:47,170
.إضافة إلى خلايا الهوكاغي الأوّل

92
00:10:49,440 --> 00:10:51,640
.قوّة الأوتشيها وهاشيراما

93
00:10:52,410 --> 00:10:55,840
.يبدو أنّه ينوي التحكّم بالكيوبي

94
00:11:00,040 --> 00:11:02,070
.إنّه يستهدف ناروتو أيضًا

95
00:11:07,640 --> 00:11:09,570
.انخفض مستوى التشاكرا الخاص بدانزو أكثر فأكثر

96
00:11:10,140 --> 00:11:13,510
.تحمل هذه التقنية مجازفة كبيرة بالفعل

97
00:11:14,440 --> 00:11:17,410
.لهذا السبب احتاج لإلغاء التقنية من قبل

98
00:11:18,010 --> 00:11:18,740
!إطلاق

99
00:11:19,840 --> 00:11:21,740
!للحفاظ على التشاكرا خاصته

100
00:11:22,610 --> 00:11:23,770
.وشيء آخر

101
00:11:24,210 --> 00:11:28,670
الشارينغان التي في ذراعه اليمنى
.وتقنيته مرتبطة بالتّأكيد

102
00:11:29,970 --> 00:11:32,570
!السرّ في الأعين التي تُغلَق

103
00:11:33,610 --> 00:11:34,840
.لا شكّ في الأمر

104
00:11:37,340 --> 00:11:40,810
.إنّها التقنية البصرية التي حُرِّمت بين الأوتشيها حتّى

105
00:11:40,840 --> 00:11:42,040
...إيزاناغي

106
00:11:43,340 --> 00:11:46,340
.لم أتوقع رؤيتها هنا من بين جميع الأماكن

107
00:12:03,020 --> 00:12:04,150
!ساسكي

108
00:12:11,750 --> 00:12:12,920
!اهدئي

109
00:12:13,180 --> 00:12:17,920
الشيء الوحيد الذي يمكنني فعله
!الآن هو تحليل تقنية دانزو

110
00:12:29,580 --> 00:12:30,450
...إيزاناغي

111
00:12:38,520 --> 00:12:40,680
،حيث في وقت قصير

112
00:12:40,980 --> 00:12:43,480
،أيّ شيء سلبي بالنسبة لمستخدم التقنية

113
00:12:43,520 --> 00:12:47,220
.كالضرر أو الموت، يمكن إعادة كتابته كالحلم

114
00:13:06,580 --> 00:13:07,650
...وأيضًا

115
00:13:07,920 --> 00:13:10,650
،أيّ شيء إيجابي، كهجمات المستخدم

116
00:13:10,780 --> 00:13:12,450
.تبقى جزءًا من الواقع

117
00:13:13,520 --> 00:13:16,780
القدرة على التّحكّم في الحيّز
.الذي يفصل الخيال والحقيقة

118
00:13:17,750 --> 00:13:20,850
الغينجيتسو المطلق الذي يمكن
.لأحد استعماله على نفسه

119
00:13:23,580 --> 00:13:27,650
،وأيضًا العين التي تستعمل إيزاناغي تفقد نورها

120
00:13:28,020 --> 00:13:29,850
.ولن تُفتَح مجدّدًا

121
00:13:37,020 --> 00:13:37,750
...لكن

122
00:13:38,150 --> 00:13:39,980
...عدد الأعين التي يملكها

123
00:13:40,650 --> 00:13:44,380
.مدّة إيزاناغي تختلف من مستخدم لآخر

124
00:13:45,850 --> 00:13:48,350
.أراد تمديد المدة بأيّ وسيلة ممكنة

125
00:13:48,380 --> 00:13:50,880
.لذا وافق على أن يصبح فأر تجارب لأوروتشيمارو

126
00:14:01,420 --> 00:14:02,550
...تبًّا لمادارا ذاك

127
00:14:03,050 --> 00:14:05,650
،لا يبدو أنّه يخطّط للانضمام إلى المعركة

128
00:14:05,680 --> 00:14:07,450
.لكنّي لا أستطيع المجازفة

129
00:14:08,380 --> 00:14:11,650
.عليّ ادّخار ما يكفي من القوة لمواجهته

130
00:14:12,350 --> 00:14:13,780
سيستغرق الأمر وقتًا

131
00:14:13,820 --> 00:14:16,650
.لعيني اليمنى التي استعملتها في اجتماع القمّة لتشفى

132
00:14:20,450 --> 00:14:24,680
.لكنّ هذه السوسانو يصعب التعامل معها

133
00:14:26,350 --> 00:14:29,820
.هجوم السّهم ذاك يصعب تفاديه

134
00:14:30,550 --> 00:14:33,180
.ولا أستطيع إلغاء إيزاناغي بعد

135
00:14:39,720 --> 00:14:41,850
.سيتوجّب عليّ المراهنة على الدقيقة الموالية

136
00:14:43,480 --> 00:14:45,120
!تقنية الاستدعاء

137
00:15:23,480 --> 00:15:24,750
...هذا الاستدعاء

138
00:15:24,780 --> 00:15:27,950
.إنّه الباكو. وحشٌ يلتهم الكوابيس

139
00:15:28,320 --> 00:15:30,380
.إنّه أضخم مما كنت أتصوّر

140
00:15:33,780 --> 00:15:35,320
!لن أبعد نظري عن دانزو

141
00:15:35,950 --> 00:15:37,380
مهما حدث

142
00:15:57,850 --> 00:16:00,250
.لن تتمكّن سوسانو من التّحرك بهذا

143
00:16:01,120 --> 00:16:03,480
سأستغلّ قوة امتصاص باكو

144
00:16:03,520 --> 00:16:04,820
.لزيادة القوة

145
00:16:05,380 --> 00:16:07,320
!أسلوب الرياح: سلسلة موجات الفراغ

146
00:16:19,480 --> 00:16:21,120
...نقطة ضعف سوسانو

147
00:16:21,480 --> 00:16:22,550
!هنا

148
00:16:24,850 --> 00:16:25,880
...أسلوب النار

149
00:16:26,150 --> 00:16:27,820
!تقنية كرة النار

150
00:16:49,320 --> 00:16:51,120
...استعمال أسلوب النار في هذا الوضع

151
00:16:51,820 --> 00:16:55,480
.قمت باستغلال الرياح التي كانت تُمتص بذكاء

152
00:17:25,320 --> 00:17:27,780
...55...54...53

153
00:17:27,850 --> 00:17:32,780
.60...59...58...57...56

154
00:17:36,580 --> 00:17:37,820
...تلك الأعين

155
00:17:37,880 --> 00:17:40,580
.تغمض واحدة منها كلّ 60 ثانية تقريبًا

156
00:17:41,280 --> 00:17:45,220
وخلال ذلك الوقت، تواصل التشاكرا
.خاصته الانخفاض بشكل كبير

157
00:17:46,020 --> 00:17:46,920
...ما يعني

158
00:17:47,320 --> 00:17:53,250
أنّ الذراع اليمنى تظهر كم بقي
.لتلك التقنية الغريبة من وقت

159
00:17:55,650 --> 00:17:56,620
!بقيت أربع

160
00:17:58,550 --> 00:18:00,550
،أو 240 ثانية تقريبًا

161
00:18:00,580 --> 00:18:03,080
!أربع دقائق تقريبًا هو الوقت المتبقي لتلك التقنية

162
00:18:03,480 --> 00:18:05,350
،بينما تقنيته مشغلة

163
00:18:05,380 --> 00:18:07,850
تصبح هجمات ساسكي من دون فائدة

164
00:18:07,950 --> 00:18:11,120
.بينما تكون هجمات دانزو ناجحة

165
00:18:12,650 --> 00:18:14,550
...طريقة عمل هذه التقنية

166
00:18:15,980 --> 00:18:20,720
.ينوي دانزو هزيمة ساسكي وتقنيته لا تزال مشغلة

167
00:18:21,280 --> 00:18:23,880
!حتى وإن تمّ توجيه ضربة مشتركة، سيفوز دانزو

168
00:18:24,880 --> 00:18:28,280
!ساسكي! اكتشفت القليل عن تقنية ذلك الرجل

169
00:18:28,720 --> 00:18:30,420
اسمع! اتفقنا؟

170
00:18:30,950 --> 00:18:34,050
،عندما تغمض جميع الأعين العشرة على ذراعك اليمنى

171
00:18:34,420 --> 00:18:36,520
ستنتهي تقنيتك، أليس كذلك؟

172
00:18:37,020 --> 00:18:39,950
أكنت تعلم بشأن إيزاناغي؟

173
00:18:40,520 --> 00:18:41,750
!كما توقعت

174
00:18:43,250 --> 00:18:44,680
هل خدعتني؟

175
00:18:44,780 --> 00:18:46,220
.يا لك من شقي ماكر

176
00:18:46,720 --> 00:18:49,050
أ-أيّها الأحمق! لم تهاجمه؟

177
00:19:10,150 --> 00:19:12,950
!ساسكي! ابتعد عنه الآن

178
00:19:13,250 --> 00:19:14,620
!أطِل المعركة

179
00:19:16,120 --> 00:19:18,650
.لكن ذلك لن يكون منطقيًّا

180
00:19:19,050 --> 00:19:21,880
.سيلغي دانزو إيزاناغي بكلّ بساطة في تلك الحالة

181
00:19:22,550 --> 00:19:26,220
وإن حدث ذلك، سيكون ساسكي الذي استعمل

182
00:19:26,250 --> 00:19:28,450
.الكثير من القوة في وضع حرج

183
00:19:48,680 --> 00:19:51,150
ساسكي يضغط على دانزو

184
00:19:51,380 --> 00:19:54,080
بالسوسانو السريعة جدًّا والمقوّاة

185
00:19:54,120 --> 00:19:57,850
.ليرغمه على متابعة استعمال إيزاناغي واستنفادها

186
00:19:58,520 --> 00:20:00,680
.اكتشف ساسكي هذا في البداية

187
00:20:01,520 --> 00:20:03,650
والآن، من الذي سيُرهَق أوّلًا؟

188
00:20:22,320 --> 00:20:25,220
.إنّه يضع ما بقي لديه من قوة في سيف تشاكرا

189
00:20:26,150 --> 00:20:27,620
.هذه لحظة حاسمة

190
00:20:28,480 --> 00:20:32,920
!كم قتلت من الأوتشيها لتحصل على تلك الذراع

191
