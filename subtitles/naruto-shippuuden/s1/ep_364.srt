1
00:01:31,200 --> 00:01:36,200
الأواصر الرّابِطة

2
00:01:33,670 --> 00:01:35,920
!هذه تقنيّة قوّات حلف الشّينوبي

3
00:01:37,620 --> 00:01:38,750
مثيرون للشفقة

4
00:01:40,000 --> 00:01:40,870
أجل

5
00:01:42,000 --> 00:01:45,210
الأمل الذي يتشبّثون به غير موجود

6
00:01:45,920 --> 00:01:49,830
مثل أرواحهم في هذه اللّحظة تماماً

7
00:01:52,330 --> 00:01:54,330
يبدو أنّ الجيوبي جاهز

8
00:01:54,920 --> 00:01:57,080
!بوّابة الحدود! افتحي

9
00:01:58,790 --> 00:02:02,960
هذه المرّة يستهدفاننا نحن
لا الجيوبي إذاً

10
00:02:03,500 --> 00:02:04,500
...بالطبع

11
00:02:04,540 --> 00:02:07,080
فاستهداف رأس العدوّ هو استراتيجيّة جوهريّة

12
00:02:07,920 --> 00:02:09,290
...سأتبع الاستراتيجيّة و

13
00:02:09,330 --> 00:02:12,500
وأهزم ذلكما الاثنين باعتبارهما
عقل الجيوبي

14
00:02:13,040 --> 00:02:14,790
...وكي ينجحوا

15
00:02:15,460 --> 00:02:17,920
يتوجّب عليهم إيقاف الجيوبي أوّلاً

16
00:02:24,500 --> 00:02:27,750
!ماذا؟! ظننتُ أنّنا شللنا حركة الجيوبي

17
00:02:28,540 --> 00:02:30,170
...هل أنتم بخير؟! تبّاً

18
00:02:50,000 --> 00:02:51,750
...خُلِعَ كتفي

19
00:02:52,000 --> 00:02:54,040
...انظروا إلى حقل الماء الحسّي

20
00:02:54,580 --> 00:02:56,870
إنّه أشبه بكوكب صغير عمليّاً

21
00:02:57,210 --> 00:02:59,210
!لكن هذا... مستحيل

22
00:03:00,000 --> 00:03:01,830
لم نستطع شلّ حركة الجيوبي إذاً

23
00:03:02,040 --> 00:03:03,830
هل توقّف عن الحركة من تلقاءِ نفسه فحسب

24
00:03:03,870 --> 00:03:06,120
ليستجمع القوّة ويخضع للتحوّل؟

25
00:03:06,500 --> 00:03:08,250
كيف سنتمكّن من إيقافه؟

26
00:03:08,670 --> 00:03:10,080
!والآن لا نستطيع استهداف ذلكما الاثنين أيضاً

27
00:03:10,870 --> 00:03:15,790
لكن يجب علينا إيقاف ذلك الشّيء وإلّا
قُضي علينا

28
00:03:18,000 --> 00:03:19,290
...أنا على وشك أن أتبوّل على نفسي

29
00:03:20,500 --> 00:03:23,080
!بدلاً من الخوف، أنشئوا التشاكرا خاصّتكم

30
00:03:23,500 --> 00:03:27,000
استعدّوا للتحرّك حالما نتلقّى الخطّة من المقرّ

31
00:03:27,330 --> 00:03:29,920
...يجب أن نشلّ حركة الجيوبي

32
00:03:30,290 --> 00:03:34,460
وإلّا فلن نستطيع استهداف العقل
...الذي يتحكّم به

33
00:03:34,870 --> 00:03:36,750
لكن كيف؟

34
00:03:36,870 --> 00:03:39,920
حتّى بتقنيّة عشيرتي المختصّة في شلّ الحركة

35
00:03:39,960 --> 00:03:43,750
سيكون التأثير ضئيلاً مقارنة بمقدار
التشاكرا المُستهلَكة

36
00:03:45,790 --> 00:03:46,500
!إينويتشي

37
00:03:46,620 --> 00:03:47,830
!صِليني بكاكاشي

38
00:03:47,960 --> 00:03:48,870
!عُلِم

39
00:03:49,420 --> 00:03:50,830
!كاكاشي، هذا أنا

40
00:03:52,120 --> 00:03:54,040
ثمّة شيء أودّ أن أتأكّد منه

41
00:03:54,080 --> 00:03:56,000
بخصوص المعلومات من تسلسل المعركة السّابقة

42
00:04:00,460 --> 00:04:03,750
سيزداد التحكّم بالجيوبي صعوبة عمّا قريب

43
00:04:03,960 --> 00:04:07,250
عزّز رابطك به باستخدام خلايا هاشيراما

44
00:04:08,080 --> 00:04:13,000
ألا تريد تفحّص قوّة الجيوبي
بوضعه الرّاهن؟

45
00:04:13,830 --> 00:04:14,920
...أوّلاً، دعنا

46
00:04:15,000 --> 00:04:18,620
...أجل، لنريهم

47
00:04:20,420 --> 00:04:21,830
!اليأس...

48
00:04:28,960 --> 00:04:30,960
!شيكاكو، سأفلتُك الآن

49
00:04:31,000 --> 00:04:32,210
!ما الأمر؟

50
00:04:32,250 --> 00:04:33,250
...هذا

51
00:04:33,460 --> 00:04:34,670
!مستحيل

52
00:04:36,830 --> 00:04:38,290
!سيّد شيكاكو! سيّد إينويتشي

53
00:04:39,170 --> 00:04:41,750
!لن تُصيب الكاموي خاصّتي في الوقت المناسب

54
00:04:42,420 --> 00:04:43,960
أزحه باتّجاه الأعلى بواسطة تقنيّة أسلوب أرض

55
00:04:44,000 --> 00:04:44,960
!حاضر

56
00:04:58,460 --> 00:04:59,790
كلّ هذه المسافة؟

57
00:05:00,460 --> 00:05:02,790
إنّه أعظم بكثير من كافّة البيجو السّابقين

58
00:05:03,330 --> 00:05:04,540
!يا لها من قوّة

59
00:05:06,000 --> 00:05:08,710
...إنّه يتقلّب من تلك الهجمة المرتدّة البسيطة

60
00:05:08,750 --> 00:05:10,290
لم يكتمل التحكّم به بعد

61
00:05:10,330 --> 00:05:11,080
!التّالية

62
00:05:30,540 --> 00:05:34,040
!غير معقول! مدينة بعيدة دُمّرت بطرفة عين

63
00:05:39,830 --> 00:05:42,870
إنّه يتصرّف بغرابة منذ مدّة، يبدو
أنّه يصوّب بعيداً

64
00:05:43,500 --> 00:05:46,960
إذاً كافّة المدن والنّاس موجودون ضمن
مجاله النّاري؟

65
00:05:46,960 --> 00:05:48,920
إذاً هذا يعني أنّ الحكّام الإقطاعيين
الذين تمّ إخلاؤهم

66
00:05:48,960 --> 00:05:50,460
...وكلّ من يحمي القرى

67
00:05:50,670 --> 00:05:53,290
ومواطني كافّة الدّول ليسوا بأمان؟

68
00:05:53,830 --> 00:05:58,170
رجالنا الشّينوبي الذين في ساحة المعركة
...يُقاتلون لحماية الجميع

69
00:05:59,670 --> 00:06:02,620
يحاول ذلكما الاثنان التخلّص من سببِنا
لخوض هذه الحرب

70
00:06:10,870 --> 00:06:12,330
!--هذه تتّجه نحو

71
00:06:15,460 --> 00:06:16,250
...هـ-هذا

72
00:06:16,790 --> 00:06:17,960
!ما الأمر يا سيّد أو؟

73
00:06:20,500 --> 00:06:21,870
اسمعني بهدوء من فضلك

74
00:06:28,620 --> 00:06:29,710
هنا؟

75
00:06:31,330 --> 00:06:32,960
حسناً يا شيكاكو... ماذا نفعل؟

76
00:06:33,460 --> 00:06:35,790
استمرّوا في فعل ما يجب علينا فعله فحسب

77
00:06:36,920 --> 00:06:37,960
سيكون تحرّكنا الأخير

78
00:06:38,000 --> 00:06:39,960
صِلني بكُل من في ساحة المعركة

79
00:06:40,670 --> 00:06:42,790
!لديّ خطّة لإيقاف الجيوبي

80
00:07:22,830 --> 00:07:24,580
نلتُ منهم أخيراً

81
00:07:25,040 --> 00:07:27,830
حطّمنا الآن عقل قوّات الحلف

82
00:07:28,170 --> 00:07:29,870
كما أسلفت، إنّها استراتيجيّة جوهريّة

83
00:07:33,460 --> 00:07:34,460
...شيكامارو

84
00:07:34,920 --> 00:07:36,620
نحن في وسط حرب

85
00:07:37,080 --> 00:07:38,670
لا تهدر أي كلمة عليّ

86
00:07:40,210 --> 00:07:41,080
أو على إينو

87
00:07:44,500 --> 00:07:47,960
كما قال أبي، علينا أن نفعل ما يجب فعله فحسب

88
00:07:58,510 --> 00:08:01,340
!لحظة... ما الذي حدث الآن بالضبط؟

89
00:08:02,430 --> 00:08:04,470
أنت مفتاح خطّتنا

90
00:08:04,630 --> 00:08:05,420
!لا أسأل عن هذا

91
00:08:06,080 --> 00:08:09,040
!أسأل ما الذي حلّ بشيكاكو وإينويتشي؟

92
00:08:14,880 --> 00:08:16,670
!نيجي! دُر مع عقارب السّاعة

93
00:08:16,750 --> 00:08:17,630
!عُلِم

94
00:08:17,670 --> 00:08:19,330
!دوران كفّ الهاكي -
!دوران كفّ الهاكي -

95
00:08:19,960 --> 00:08:21,210
...مـ-مذهل

96
00:08:23,880 --> 00:08:25,290
!لا تقف مكانك شارداً فحسب يا ناروتو

97
00:08:25,780 --> 00:08:27,820
هذه ساحة معركة ونحن نخوض حرباً

98
00:08:29,200 --> 00:08:30,070
!سيموت النّاس

99
00:08:31,200 --> 00:08:33,740
...لكن إن انهزمنا وخسرنا هذه الحرب

100
00:08:33,860 --> 00:08:35,860
!سيموت الجميع

101
00:08:36,820 --> 00:08:38,740
!أعلم ذلك بالطبع

102
00:08:39,570 --> 00:08:43,110
كان والد شيكامارو وإينو ليقولا على الأرجح
أنّ بصفتهما شينوبي

103
00:08:43,280 --> 00:08:45,400
سعيدان بموتهما قبل أطفالهما

104
00:08:45,860 --> 00:08:47,780
كما فعل أبي

105
00:08:50,950 --> 00:08:54,280
ناروتو، قوّتك ضروريّة للخطّة

106
00:08:54,820 --> 00:08:56,860
...لذا ما لم ننفّذها

107
00:08:56,990 --> 00:08:58,700
!يجب علينا حمايتك يا ناروتو

108
00:08:59,280 --> 00:09:00,030
!هيناتا

109
00:09:01,400 --> 00:09:02,360
!فلتعلم هذا

110
00:09:02,820 --> 00:09:04,900
!الهيوغا هم الأقوى في قريةِ الورق

111
00:09:05,530 --> 00:09:08,610
ها هو ذا... كنتُ آمل أن أقضي عليهم

112
00:09:08,650 --> 00:09:10,650
...قبل أن يبدأوا بالكلام، لكن

113
00:09:11,070 --> 00:09:13,650
من الصّعب التحكّم بالجيوبي جيّداً

114
00:09:14,900 --> 00:09:18,070
...سيَفي هذا بالغرض إلى أن يحين التحوّل التالي، لكن

115
00:09:18,780 --> 00:09:20,320
...بعد ذلك

116
00:09:20,360 --> 00:09:24,200
أشكّ في أنّه سيتمكّن أحد غير الجينتشوريكي التحكّم به

117
00:09:25,650 --> 00:09:28,360
...لكن كي أصبح جينتشوريكي للجيوبي

118
00:09:28,740 --> 00:09:31,740
يجب أن أكون على قيد الحياة
بشكل كامل

119
00:09:32,030 --> 00:09:35,450
...لا ساكِناً في جثّة كشخص مُحيا

120
00:09:35,820 --> 00:09:38,700
شخص مُحيا مثلك مثاليّ لشنّ
هجمات انتحاريّة واسعة النطاق

121
00:09:38,990 --> 00:09:40,780
لكن سبب عدم إطلاقك

122
00:09:40,820 --> 00:09:44,450
قنبلة وحش جيوبي الذيول
عليهم لتفجّر نفسك كذلك

123
00:09:44,700 --> 00:09:47,950
هو لأنّها ستطالني أيضاً وأموت

124
00:09:48,990 --> 00:09:51,780
وهذه معضلة حقيقيّة لأنّك

125
00:09:52,360 --> 00:09:54,700
كي يتمّ استرجاعك إلى الحياة

126
00:09:54,740 --> 00:09:56,530
...وتصبح جينتشوريكي

127
00:09:56,820 --> 00:09:58,780
فإنّك تحتاجني لأضحّي بنفسي

128
00:09:58,820 --> 00:10:02,070
وأطبّق عليك فنّ غيدو - انبعاث رينّي

129
00:10:03,030 --> 00:10:05,900
باختصار، أنت في وضع حرج الآن

130
00:10:05,950 --> 00:10:08,990
كونك تحت رحمتي كلّياً

131
00:10:09,450 --> 00:10:10,900
لا تنسَ ذلك

132
00:10:11,530 --> 00:10:15,110
تحوّلت من طفل غرّ إلى ثعلب ماكر

133
00:10:15,990 --> 00:10:18,990
لم أعتبرك صديقاً يوماً

134
00:10:20,900 --> 00:10:22,030
حسناً

135
00:10:22,900 --> 00:10:25,900
قرّر أنت خطوتنا التالية إذاً

136
00:10:26,700 --> 00:10:27,610
سنستمرّ

137
00:10:28,360 --> 00:10:32,610
سيعرفون اليأس... خير معرفة

138
00:10:37,030 --> 00:10:37,900
!أسلوب الخشب

139
00:10:37,950 --> 00:10:39,320
!الأغصان القاطعة

140
00:10:40,030 --> 00:10:40,950
!هناك الكثير منها

141
00:10:40,990 --> 00:10:42,030
حاولوا تفاديها فحسب

142
00:10:42,070 --> 00:10:44,240
تقنيّتي الجبليّة ينبغي أن تبطئ
حركته على الأقلّ

143
00:10:44,280 --> 00:10:46,900
ريثما تعود قوّة الكيوبي

144
00:10:47,360 --> 00:10:49,360
فيما عدا أنّي بحاجة لبعض الوقت
!لجمع ما يكفي من تشاكرا

145
00:10:49,530 --> 00:10:50,530
!اصمدوا جميعاً

146
00:10:51,490 --> 00:10:53,200
!تشا

147
00:10:55,200 --> 00:10:56,320
!عددها كبير جدّاً

148
00:10:56,740 --> 00:10:58,240
!لا يستطيع دوراني المتابعة

149
00:11:02,860 --> 00:11:03,900
!شكراً يا نيجي

150
00:11:03,950 --> 00:11:05,990
!أستطيع تفعيل نمط الحكيم الآن

151
00:11:05,990 --> 00:11:08,320
لا يجوز أن أستمرّ في الاعتماد
عليكم أيّها العباقرة

152
00:11:08,450 --> 00:11:09,820
!حان دوري الآن

153
00:11:10,450 --> 00:11:11,950
!راسين شوريكين

154
00:11:17,450 --> 00:11:18,900
!إليك المزيد

155
00:11:30,950 --> 00:11:33,740
!هاكّي: كفّ جدار الهواء

156
00:11:37,030 --> 00:11:38,780
!تبّاً! هجمة مُركّزة

157
00:11:38,990 --> 00:11:40,030
!عددها كبير

158
00:11:40,150 --> 00:11:41,860
...لن يكون كفّ هواء هيناتا ونيجي كافياً

159
00:11:41,900 --> 00:11:42,990
!بياكوغان

160
00:11:55,740 --> 00:11:58,030
!أسلوب الأرض! تقنيّة الجبل

161
00:12:01,320 --> 00:12:02,490
!الفريق الطبّي

162
00:12:02,860 --> 00:12:04,820
أين أنت؟! لدينا إصابة خطيرة هنا

163
00:12:04,990 --> 00:12:06,200
!بسرعة

164
00:12:08,570 --> 00:12:09,610
...لا

165
00:12:10,570 --> 00:12:12,490
...لم أعد

166
00:12:14,070 --> 00:12:14,990
...نيجي

167
00:12:15,700 --> 00:12:16,450
...أخي

168
00:12:20,900 --> 00:12:22,200
...ناروتو

169
00:12:24,530 --> 00:12:26,990
...هيناتا-ساما

170
00:12:27,030 --> 00:12:30,030
مستعدّة للموت لأجلك

171
00:12:32,400 --> 00:12:36,150
...لذا... بين يديك

172
00:12:36,990 --> 00:12:40,030
...أكثر من... حياة واحدة

173
00:12:43,820 --> 00:12:49,860
...ويبدو أنّ... حياتي أيضاً... كانت

174
00:12:50,990 --> 00:12:52,860
...من بينها

175
00:12:54,990 --> 00:12:58,320
لماذا؟ لماذا فعلت هذا هنا؟

176
00:13:00,070 --> 00:13:01,950
!كنتَ ستغيّر الهيوغا

177
00:13:04,150 --> 00:13:11,450
منذ زمن بعيد، كلماتك تلك قد حرّرتني
من قيود المصير

178
00:13:15,240 --> 00:13:18,030
لماذا تبالغ إلى هذا الحدّ لأجلي؟

179
00:13:18,900 --> 00:13:21,740
...وتضحّي بحياتك حتّى

180
00:13:23,240 --> 00:13:28,610
...لأنّك... ناديتني بالعبقريّ

181
00:13:31,400 --> 00:13:35,200
!بخلافي أنا، لستَ فاشلاً

182
00:13:37,320 --> 00:13:38,490
...أبي

183
00:13:38,530 --> 00:13:43,150
...أخيراً فهمت... الحرّية التي شعرتَ بها

184
00:13:43,990 --> 00:13:47,030
حرّية اختيار الموت لحماية رفاقك

185
00:13:55,900 --> 00:13:58,450
ألم تقل أنّك لن تدع أصدقاءك يموتون؟

186
00:13:59,320 --> 00:14:00,360
!يا ناروتو

187
00:14:07,820 --> 00:14:10,900
!لن أدع رفاقي يموتون أبداً

188
00:14:21,280 --> 00:14:26,610
"تلك الكلمات... "لن أدع رفاقي يموتون أبداً

189
00:14:27,860 --> 00:14:32,490
!والآن انظر حولك... وكرّر ذلك الكلام ثانية

190
00:14:45,610 --> 00:14:48,450
!قلتُ لك كرّره ثانية

191
00:14:50,820 --> 00:14:53,280
...بينما تبرد جثث رفاقك بين يديك

192
00:14:53,320 --> 00:14:55,740
!تقبّل موتهم

193
00:14:58,700 --> 00:15:01,490
!نيجي... مات؟

194
00:15:05,280 --> 00:15:07,030
...هيزاشي، سامحني

195
00:15:07,860 --> 00:15:08,820
!--تركتُ نيجي

196
00:15:09,820 --> 00:15:12,030
...سيستمرّ هذا

197
00:15:12,650 --> 00:15:16,450
وثرثرتك وعقائدك ستغدو مجرّد أكاذيب

198
00:15:17,610 --> 00:15:20,360
هذه هي نتيجة الأمل والمثاليّات النّهائية

199
00:15:20,860 --> 00:15:22,610
!هذا هو الواقع

200
00:15:23,820 --> 00:15:24,820
...ناروتو

201
00:15:25,450 --> 00:15:27,450
ما الذي جنيتَه من هذا الواقع؟

202
00:15:27,990 --> 00:15:30,860
أمّك وأبوك رحلا وكذلك سيّدك جيرايا

203
00:15:30,900 --> 00:15:33,530
،وإن استمررت في اعتراضنا

204
00:15:33,820 --> 00:15:37,110
ستظلّ تخسر أصدقاءك واحداً تلو الآخر

205
00:15:38,740 --> 00:15:40,200
سيصبح هذا عالماً

206
00:15:40,240 --> 00:15:42,780
لن يبقى فيه أحد يعترف بوجودك

207
00:15:44,990 --> 00:15:45,990
...أوبيتو

208
00:15:47,280 --> 00:15:49,490
...الشيء الوحيد الذي ينتظرك

209
00:15:49,950 --> 00:15:53,860
هو كابوسك الأسوأ والذي تعرفه جيّداً

210
00:15:57,950 --> 00:15:58,860
!العزلة

211
00:16:07,200 --> 00:16:10,820
لقد أصبحتَ مثلي تماماً كما كنتُ في السّابق يا أوبيتو

212
00:16:11,610 --> 00:16:13,700
...سيستسلم ناروتو قريباً

213
00:16:13,860 --> 00:16:16,650
الأمر الذي سيحطّم إرادة قوّات الحلف

214
00:16:16,860 --> 00:16:19,110
لِمَ تتشبّث بالواقع؟

215
00:16:20,570 --> 00:16:22,990
!كفّ عن هذا... وتعال وانضمّ إلينا يا ناروتو

216
00:16:37,990 --> 00:16:39,990
،قال أخي نيجي للتو

217
00:16:40,490 --> 00:16:43,900
أنّ بين يديك أكثر من حياة واحدة

218
00:16:43,950 --> 00:16:46,150
هل تعلم ما قصده؟

219
00:16:50,200 --> 00:16:51,820
"لن أدع رفاقي يموتون أبداً"

220
00:16:53,110 --> 00:16:57,110
لا تلك الكلمات ولا الإيمان خلفها أكاذيب

221
00:16:58,530 --> 00:17:00,650
،لأنّه كان قادراً على تخزينها في قلبه بنجاح

222
00:17:00,700 --> 00:17:02,360
!والعيش على أساسها حتّى الرّمق الأخير

223
00:17:02,780 --> 00:17:03,990
!هذا ما فعله أخي نيجي

224
00:17:08,070 --> 00:17:09,900
...لست أنت فحسب يا ناروتو

225
00:17:10,070 --> 00:17:14,860
كلّنا نحتوي هذه الكلمات والمشاعر في قلوبنا

226
00:17:14,990 --> 00:17:17,650
...إنّها هي التي تربط أرواحنا معاً

227
00:17:19,200 --> 00:17:20,950
وتجعلنا رفاقاً

228
00:17:23,200 --> 00:17:27,740
إن استسلمنا جميعاً وتخلّينا
عن تلك الكلمات والأحاسيس

229
00:17:28,530 --> 00:17:31,030
فإنّ تضحية نيجي الأخيرة
ستذهب هباء

230
00:17:32,070 --> 00:17:35,990
!وحينئذ... سيموت رفاقك فعلاً

231
00:17:36,860 --> 00:17:38,570
ولن يبقى لك أي رفيق بعدها

232
00:17:39,900 --> 00:17:41,150
هذا... ما أحسّ به

233
00:17:45,700 --> 00:17:50,360
لذا قف معي يا ناروتو

234
00:17:51,820 --> 00:17:54,780
...لأنّ عدم التراجع عن كلمتي

235
00:17:55,030 --> 00:17:57,820
!هو طريقتي في النينجا أيضاً

236
00:18:00,530 --> 00:18:02,070
...ناروتو

237
00:18:02,110 --> 00:18:06,780
هيناتا-ساما... مستعدّة للموت لأجلك

238
00:18:07,700 --> 00:18:10,780
...لذا... بين يديك

239
00:18:10,950 --> 00:18:12,820
...أكثر من... حياة واحدة

240
00:18:13,110 --> 00:18:15,490
!لا تنسني

241
00:18:15,530 --> 00:18:16,650
أعلم

242
00:18:16,820 --> 00:18:18,320
!أتّخذ روابطي على محمل الجدّ

243
00:18:18,360 --> 00:18:20,860
!لا أتخلّى عن رفاقي أبداً

244
00:18:21,240 --> 00:18:23,990
...لكن في الواقع، نيجي قد

245
00:18:24,150 --> 00:18:26,400
!كفّ عن الثرثرة

246
00:18:26,900 --> 00:18:30,570
سأوسعك ضرباً وأستولي على جسدك
للأبد هذه المرّة

247
00:18:30,990 --> 00:18:32,900
وهل نسيت أيضاً؟

248
00:18:33,030 --> 00:18:36,700
أمّك وأبوك فعلا الشيء ذاته
الذي فعله نيجي

249
00:18:36,740 --> 00:18:37,860
بُعيد ولادتك

250
00:18:38,110 --> 00:18:40,990
ختماني أنا، عدوّهما اللّدود، داخلك

251
00:18:41,030 --> 00:18:42,950
وائتمناك على المستقبل وماتا

252
00:18:45,320 --> 00:18:50,360
حياتك كانت مرتبطة بشخصين آخرين
منذ ولادتك أصلاً

253
00:18:52,900 --> 00:18:55,860
هل سيقف مكتوف الأيدي ويراقب
كيف يستجيب ناروتو...؟

254
00:18:57,740 --> 00:18:59,700
يبدو أنّ ناروتو يُقلقه

255
00:19:01,700 --> 00:19:02,610
!يكفي

256
00:19:05,570 --> 00:19:06,820
!لا تستعجل

257
00:19:06,990 --> 00:19:09,360
!ستضرّ نفسك والجيوبي كذلك

258
00:19:09,400 --> 00:19:10,530
!لا يهمّني

259
00:19:10,990 --> 00:19:12,490
!جلد الجيوبي قاس

260
00:19:15,990 --> 00:19:16,990
!سيضربوننا

261
00:19:18,200 --> 00:19:19,860
!تمّت عمليّة الشّحن

262
00:19:20,320 --> 00:19:21,650
!احذر يا بي-ساما

263
00:19:21,860 --> 00:19:22,990
!هيّا

264
00:19:28,700 --> 00:19:30,030
!خذ هذه

265
00:19:46,030 --> 00:19:46,950
!بي-ساما

266
00:19:46,990 --> 00:19:48,530
!لا تضغط على نفسك كثيراً

267
00:19:49,030 --> 00:19:50,780
...لا حاجة للقلق

268
00:19:50,820 --> 00:19:53,360
!فاختصاصي هو حماية الحلف من الغرق

269
00:20:04,490 --> 00:20:05,990
هذا صحيح

270
00:20:06,030 --> 00:20:08,150
لم تكن أمّي وأبي فحسب

271
00:20:09,360 --> 00:20:10,820
...أجل

272
00:20:10,860 --> 00:20:13,820
...لم تكن حياتي فحسب

273
00:20:14,450 --> 00:20:15,860
حتّى هذه اللّحظة

274
00:20:25,950 --> 00:20:28,530
!شكراً يا هيناتا

275
00:20:29,610 --> 00:20:32,320
يعزو كلّ الفضل لوقوفك بجانبي

276
00:20:35,070 --> 00:20:36,280
...ونيجي

277
00:20:37,360 --> 00:20:39,110
شكراً لك

278
00:20:46,650 --> 00:20:50,070
...يد ناروتو كبيرة جدّاً

279
00:20:50,110 --> 00:20:52,900
...وقويّة، لكن الأهمّ من كل ذلك

280
00:20:56,200 --> 00:20:57,900
!لنفعل هذا يا هيناتا

281
00:20:58,900 --> 00:20:59,860
!نعم

282
00:21:02,030 --> 00:21:03,900
!مُريحة