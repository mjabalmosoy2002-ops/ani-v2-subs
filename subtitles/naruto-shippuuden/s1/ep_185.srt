1
00:00:06,340 --> 00:00:11,450
آنذاك عندما كنتُ أصغر قليلاً
،وأكثر حيويّة

2
00:00:11,480 --> 00:00:16,050
كان منافسي الأعظم فتى يُدعى ناروتو

3
00:00:16,110 --> 00:00:17,810
ناروتو؟ ناروتو؟ -
ناروتو؟ ناروتو؟ -

4
00:00:17,880 --> 00:00:21,360
طفل فظيع هدّدَ حرّيتي

5
00:00:22,890 --> 00:00:26,160
وكانَ الوقتُ يمضي من أمامه وهو يقِفُ يائساً

6
00:00:26,190 --> 00:00:29,800
لا بدّ وأنَّها كانت إحدى أسوأ فترات حياته

7
00:00:30,600 --> 00:00:32,830
كان ساسكي قد غادرَ القرية

8
00:00:32,870 --> 00:00:35,270
وكان يُشكِّكُ بقوّتِه

9
00:00:35,300 --> 00:00:38,570
هذا صحيح! أصبحت تسونادي هوكاغي-ساما

10
00:00:38,600 --> 00:00:40,910
حدثَ ذلك قبل أن يشدَّ الرِّحال مع جيرايا

11
00:00:46,240 --> 00:00:47,680
!ابقوا هادئين

12
00:00:48,010 --> 00:00:50,350
!اسمعوا قصّتي أنا وناروتو

13
00:00:52,850 --> 00:00:55,390
ماذا؟! تبحثين عن حيوان أليف؟

14
00:00:56,150 --> 00:01:00,100
!هذه مهمّة مبتدئين! لا أريدها

15
00:01:00,500 --> 00:01:03,700
هنالك سببٌ وجيهٌ وراء إرسالك

16
00:01:08,600 --> 00:01:10,210
...هذا

17
00:01:14,570 --> 00:01:16,940
هرب مجدّداً؟

18
00:01:17,410 --> 00:01:20,250
بالإضافة إلى أنّ هذا النّعام قد درّبَ نفسه

19
00:01:20,280 --> 00:01:23,220
ليصبح نعاماً نينجا

20
00:01:23,580 --> 00:01:26,120
لحظة، ماذا؟ نعام نينجا؟

21
00:01:26,180 --> 00:01:28,180
مخطئ تماماً لو ظننتَ

22
00:01:28,220 --> 00:01:30,430
!أنّ هذه المهمّة هي ببساطة البحث عن حيوان

23
00:01:32,790 --> 00:01:34,930
المعذرة يا هوكاغي-ساما

24
00:01:36,330 --> 00:01:38,460
ما طبيعة العمل البسيط الذي ستكلّفينني به
هذه المرّة؟

25
00:01:38,830 --> 00:01:40,340
سأعيّنُك قائداً للفريق

26
00:01:40,870 --> 00:01:43,100
!قائد فريق؟! هل قلتِ قائد فريق؟

27
00:01:44,000 --> 00:01:44,800
!أنا؟

28
00:01:45,370 --> 00:01:46,600
كوتيتسو هاغاني

29
00:01:46,640 --> 00:01:50,050
ستقودُ فريقاً مُشكَّلاً خصّيصاً للقبضِ على نعام

30
00:01:50,180 --> 00:01:51,150
!حاضر

31
00:01:51,350 --> 00:01:53,310
ماذا؟ نعام؟

32
00:01:53,410 --> 00:01:57,210
هربَ النّعام إلى ساحات تدريب قرية الورق

33
00:01:57,650 --> 00:02:01,020
ساحات تدريب؟ تقصدين حيثُ أقيمَ امتحان التشونين؟

34
00:02:01,060 --> 00:02:03,020
حيثُ رأينا مئويّات الأقدام العملاقة تلك؟

35
00:02:03,460 --> 00:02:07,120
استخدمنا ساحة التدريب 44 لامتحانِ التشونين

36
00:02:07,160 --> 00:02:09,870
ستذهبون أنتم إلى ساحة التدريب صفر

37
00:02:10,370 --> 00:02:12,370
هنالك ساحة صفر؟

38
00:02:12,870 --> 00:02:18,270
أجل. لكن لم تعُد تُستخدَم للتمارين بعد الآن

39
00:02:19,740 --> 00:02:22,010
في الواقع، أصبحَتْ لحفظ

40
00:02:22,040 --> 00:02:25,280
الحيوانات الشّرِسة والغريبة وإبعادها عن العالم

41
00:02:25,310 --> 00:02:28,110
والدخول إليها محظور

42
00:02:29,350 --> 00:02:31,550
حدث ذلك عندما كنتُ طفلة

43
00:02:31,590 --> 00:02:35,520
لِهذا لا أعرِفُ كيفَ تطوّرت البيئة هناك

44
00:02:36,290 --> 00:02:38,290
"تُدعى أيضاً بـ"المنطقة الخالية من الصّيد

45
00:02:38,590 --> 00:02:41,600
مغلق

46
00:02:42,330 --> 00:02:44,660
هذه هي ساحة التّدريب صفر إذاً

47
00:02:45,230 --> 00:02:47,060
...يا لذلك النّعام

48
00:02:47,160 --> 00:02:49,570
لماذا هرب إلى هنا تحديداً؟

49
00:02:49,740 --> 00:02:52,840
...حسب معلوماتي، أتى إلى هذا المكان لأنّ

50
00:02:52,870 --> 00:02:54,170
!ذراعايّ تتوقان للقتال

51
00:02:54,270 --> 00:02:55,740
!وكذلك ساقايّ

52
00:02:56,270 --> 00:02:59,320
!كائناً من كان خصمنا، سأهزمه

53
00:03:00,120 --> 00:03:03,680
بالمناسبة، هل سبقَ وكنتم في نفس الفريق؟

54
00:03:04,420 --> 00:03:07,150
...حسبما أذكر

55
00:03:08,750 --> 00:03:09,430
...في الواقع

56
00:03:09,590 --> 00:03:11,690
...لا، هذا لأنّني

57
00:03:11,730 --> 00:03:14,160
حسناً، جيّد! هيّا بنا

58
00:03:17,960 --> 00:03:20,000
اللّعنة عليكِ يا هوكاغي-ساما

59
00:03:20,170 --> 00:03:24,040
إنَّها تُعيِّنُ أيّ نينجا برتبةِ جينين تجده في طريقِها

60
00:03:24,840 --> 00:03:25,640
!ماذا؟

61
00:03:26,200 --> 00:03:27,600
!كوتيتسو هو قائد فريق؟

62
00:03:27,900 --> 00:03:29,610
ما الأمر يا إيزومو؟

63
00:03:29,950 --> 00:03:31,650
أرسلتِه بمفرده في مهمّة؟

64
00:03:32,150 --> 00:03:36,050
لا تحسب أنّني وجدتُ فرقاً بين قدرتك وقدرته

65
00:03:36,550 --> 00:03:39,320
كلّ ما في الأمر أنّ كوتيتسو كان متوفّراً

66
00:03:39,960 --> 00:03:42,460
لذا لا تدع الأمر يزعجك كثيراً يا إيزومو

67
00:03:42,760 --> 00:03:46,020
!لماذا لم تدعيني أذهب مع كوتيتسو؟

68
00:03:46,690 --> 00:03:49,500
!كفّ عن الأنين أيّها الطفل البكّاء

69
00:05:25,990 --> 00:05:29,670
سنتقدّمُ بتشكيل أحادي الخطّ

70
00:05:30,200 --> 00:05:31,670
ناروتو، أنت أوّلاً

71
00:05:31,830 --> 00:05:32,500
!حسناً

72
00:05:32,830 --> 00:05:33,970
وأنا بعدك

73
00:05:34,300 --> 00:05:35,600
،إذا أصيبَ الأوّل في الطابور بمكروه

74
00:05:35,630 --> 00:05:37,300
سأسانده أنا

75
00:05:37,630 --> 00:05:40,780
ثمّ شينو. ابقَ يقظاً لطرفيك الأيمن والأيسر

76
00:05:41,140 --> 00:05:43,180
وأخيراً، لي. حذارِ من الخلف

77
00:05:43,440 --> 00:05:44,380
عُلِم

78
00:05:44,940 --> 00:05:47,080
ينبغي أن أكون أنا في الحراسةِ الخلفيّة

79
00:05:47,110 --> 00:05:48,080
!ماذا؟

80
00:05:48,180 --> 00:05:50,720
لأنَّ الشخصَ الّذي لديه عينان خلفَ رأسِه

81
00:05:50,750 --> 00:05:52,320
هو الأنسب ليكونَ حارساً خلفياً

82
00:05:52,450 --> 00:05:56,720
أعترف أنّني لا أملك عينين خلف رأسي، لكن
هل تملك أنت؟

83
00:05:57,320 --> 00:05:59,700
ليس حرفيّاً

84
00:06:00,660 --> 00:06:03,900
لكن بصري مُشابه لما تراه العيون المُركَّبة

85
00:06:04,360 --> 00:06:06,960
!ادخل صلبَ الموضوع فحسب يا شينو

86
00:06:07,130 --> 00:06:12,070
!تريدُ القول أنّ حشراتك ستراقب ما هو خلفنا، صحيح؟

87
00:06:12,170 --> 00:06:13,370
لا تتسرّع في الاستنتاج

88
00:06:14,210 --> 00:06:17,270
،هذا لأنّه ما لم يُوافق القائد

89
00:06:17,310 --> 00:06:18,510
لا يمكننا تغيير مواقعنا

90
00:06:18,540 --> 00:06:20,020
عليك بالخلف يا شينو

91
00:06:20,420 --> 00:06:21,450
وستكون نائبي أيضاً

92
00:06:21,520 --> 00:06:25,320
!ماذا؟! إن كان هناك نائباً فأنا من ينبغي أن يكون

93
00:06:25,350 --> 00:06:27,620
!أنا الشّخصُ الوحيدُ الذي يألفُ النّعام

94
00:06:28,020 --> 00:06:29,930
لهذا عيّنتُك في المقدِّمة

95
00:06:29,990 --> 00:06:31,890
هيّا، ابدأ بالمشي

96
00:06:34,390 --> 00:06:35,700
بالمناسبة يا قائد

97
00:06:35,770 --> 00:06:38,100
أين يُفترَض أن يكون النّعام؟

98
00:06:38,130 --> 00:06:40,670
ماذا؟ ظننتُك تعلم

99
00:06:40,870 --> 00:06:42,770
هذا ما قالَتْه هوكاغي-ساما

100
00:06:43,130 --> 00:06:45,340
أعرف شكلَه فقط

101
00:06:45,380 --> 00:06:47,710
لا أعرف مكانه

102
00:06:51,080 --> 00:06:52,510
!هوكاغي-ساما

103
00:06:52,680 --> 00:06:56,850
!لماذا لم تعيّني نينجا ذا قدراتٍ حسّية في هذه المهمّة؟

104
00:06:57,490 --> 00:06:59,590
...مثل نينجا من هيوغا أو إينوزوكا

105
00:06:59,990 --> 00:07:02,420
ذهبوا جميعاً

106
00:07:03,320 --> 00:07:05,230
...هوكاغي-ساما

107
00:07:05,530 --> 00:07:07,730
حسناً... ماذا نفعل؟

108
00:07:08,100 --> 00:07:09,060
سأجدُه أنا

109
00:07:09,760 --> 00:07:10,560
شينو؟

110
00:07:15,140 --> 00:07:17,110
أنتَ من عشيرةِ أبورامي إذاً

111
00:07:17,210 --> 00:07:18,210
!أعتمدُ عليك

112
00:07:28,850 --> 00:07:30,750
.إنّها منطِقة واسعة. اهدأ

113
00:07:31,380 --> 00:07:34,750
هذه أشبه بغابةٍ استوائيّة

114
00:07:37,860 --> 00:07:39,030
!لا تضحك

115
00:07:39,160 --> 00:07:41,790
!أنتَ السّبب في تكليفي بهذه المهمّة السّخيفة

116
00:07:43,060 --> 00:07:44,290
لا جدوى من الكلام معه

117
00:07:44,590 --> 00:07:47,900
لا... استمرّ في صرفِ انتباهه

118
00:07:48,140 --> 00:07:49,670
ما-ما الأمر؟

119
00:07:49,940 --> 00:07:51,840
سأحيطُ به

120
00:08:01,350 --> 00:08:02,910
!هيّا يا شينو

121
00:08:03,150 --> 00:08:05,460
بالطبع. سأفعلُ دون شكّ

122
00:08:06,020 --> 00:08:09,360
!حسناً! في هذه الحالة فاتركه لي

123
00:08:09,390 --> 00:08:11,890
!سرّة بطن والدك بارزة

124
00:08:13,890 --> 00:08:15,700
!لِمَ الضحك؟

125
00:08:15,830 --> 00:08:17,630
ولِمَ لا ينبغي أن يضحك؟

126
00:08:17,730 --> 00:08:19,370
فهو يراك أحمق

127
00:08:19,470 --> 00:08:20,800
!ما-ماذا؟

128
00:08:20,970 --> 00:08:23,330
لديه أبٌ بِلا أدنى شكّ

129
00:08:23,900 --> 00:08:27,510
لكن لا يجوز أن تقول أنّ الأب له سرّة بارزة

130
00:08:28,110 --> 00:08:29,610
!يا لك من مزعج

131
00:08:29,640 --> 00:08:31,280
!ادخل صلبَ الموضوع يا شينو

132
00:08:31,410 --> 00:08:34,240
هذا لأنّ النّعام يأتي من البيض

133
00:08:34,540 --> 00:08:35,450
!ليسَتْ لديهم سرّة بطن

134
00:08:37,220 --> 00:08:39,650
!تبّاً! يسخر منّي

135
00:08:39,690 --> 00:08:42,550
يكفي! حسناً يا شينو، هل انتهيت؟

136
00:08:43,020 --> 00:08:44,020
...غريب

137
00:08:44,150 --> 00:08:44,890
ما الأمر؟

138
00:08:45,530 --> 00:08:47,230
حشراتي لا تستجيب

139
00:08:50,200 --> 00:08:52,060
...هل يُعقَل... أنّ هذه

140
00:08:52,830 --> 00:08:54,330
نباتات آكلة للحشرات؟

141
00:08:54,830 --> 00:08:56,610
...كوفورا، كوبوشي، كوموري

142
00:08:56,640 --> 00:09:00,240
...كونونوكا، كوميروا، كونومو، كوغوري، كوكوكو، كويوكو

143
00:09:00,270 --> 00:09:01,670
!اهدأ

144
00:09:02,240 --> 00:09:04,640
حشراتي... أُكِلَتْ نصفها

145
00:09:07,020 --> 00:09:07,780
لن تفلت

146
00:09:07,980 --> 00:09:08,780
!مهلاً

147
00:09:08,850 --> 00:09:10,180
هيّا بنا يا شينو

148
00:09:10,580 --> 00:09:12,580
لا أستطيع المتابعة أكثر

149
00:09:12,850 --> 00:09:16,530
هذا لأنّني أخاطر بخسارة المزيد من الحشرات

150
00:09:16,990 --> 00:09:19,030
!اسلك طريقاً آخر إذاً والتقِ بنا

151
00:09:26,500 --> 00:09:28,040
!انتظر

152
00:09:29,970 --> 00:09:32,200
إنّه سريع! بالطبع فهو نعام

153
00:09:32,640 --> 00:09:34,070
دعْه لي

154
00:09:34,240 --> 00:09:37,610
!قوّة ساقي مُصدَّقة بمُوافقة غاي سينسي

155
00:09:37,810 --> 00:09:39,350
!انطلق فحسب

156
00:09:39,550 --> 00:09:40,250
!حاضر

157
00:09:43,080 --> 00:09:45,660
!حواجب سريع جدّاً

158
00:09:52,360 --> 00:09:53,360
!استعدّ

159
00:10:00,870 --> 00:10:01,600
!ها هو ذا

160
00:10:05,710 --> 00:10:06,380
!ماذا؟

161
00:10:10,410 --> 00:10:13,340
!هذه التايجيتسو الغريبة، ملاكمة

162
00:10:19,150 --> 00:10:19,820
ماذا؟

163
00:10:19,850 --> 00:10:21,590
ماذا حلَّ بحواجب؟

164
00:10:23,320 --> 00:10:24,950
!ها أنا قادم يا ناروتو

165
00:10:25,060 --> 00:10:25,900
!تعال إليّ

166
00:10:26,100 --> 00:10:27,730
!هل نطقَ للتو؟

167
00:10:32,330 --> 00:10:34,160
،توقّعتُ أنّه سيطاردني شخصٌ ما

168
00:10:34,200 --> 00:10:37,440
لكن لم أتوقّعك أنت. لا بدَّ وأنّه القدر

169
00:10:40,370 --> 00:10:43,010
لكن ينتهي القدرُ عندَ هذا الحدّ يا ناروتو

170
00:10:43,040 --> 00:10:47,220
!سأهزمُك وأتحرّر تماماً

171
00:10:47,480 --> 00:10:50,750
!أيّها النعام، لا تتحمّس كثيراً فقط من هزيمةِ ناروتو

172
00:10:51,350 --> 00:10:53,480
!فأنا، القائد، ما زلتُ هنا

173
00:10:53,920 --> 00:10:55,060
قائد؟

174
00:10:55,230 --> 00:10:57,130
فلتسقط أولاً إذاً

175
00:10:58,260 --> 00:11:00,330
!لا تستهن بالبشر

176
00:11:14,450 --> 00:11:16,450
!ركلة النّعامة الهوائيّة

177
00:11:17,960 --> 00:11:19,330
...مـ-مستحيل

178
00:11:19,360 --> 00:11:20,330
!قائد

179
00:11:26,630 --> 00:11:28,940
آسف... لكن أنا جادٌّ هذه المرّة

180
00:11:31,200 --> 00:11:32,970
!إعصار النّعامة

181
00:11:35,900 --> 00:11:37,100
ما الأمر يا كوتيتسو؟

182
00:11:38,750 --> 00:11:40,450
!ما-ماذا كان ذلك؟

183
00:11:42,210 --> 00:11:44,410
!ركلة تنّين النّعامة الصّاعد

184
00:11:46,250 --> 00:11:48,920
نشكّلُ فريقاً ممتازاً

185
00:11:50,760 --> 00:11:51,920
...لا يمكن أن يكون هذا

186
00:11:54,660 --> 00:11:57,620
!ركلة النّعامة المتألِّقة

187
00:12:00,170 --> 00:12:02,300
لنصبح جونين يوماً ما أيضاً

188
00:12:04,930 --> 00:12:06,700
إنّها ذكرى قديمة

189
00:12:06,770 --> 00:12:09,280
رؤية تراها قبل الموت

190
00:12:13,640 --> 00:12:15,880
هل سأموت هنا؟

191
00:12:17,080 --> 00:12:18,720
أمام نعامة؟

192
00:12:23,720 --> 00:12:25,520
!لا تتحمّس كثيراً

193
00:12:25,620 --> 00:12:27,290
!لأنّني خصمك الآن

194
00:12:27,450 --> 00:12:28,830
!انتظر يا ناروتو

195
00:12:29,130 --> 00:12:30,360
لننسحب حالياً

196
00:12:33,160 --> 00:12:36,200
توجّهُ وابلاً من اللّكماتِ السريعة إذاً

197
00:12:36,830 --> 00:12:39,240
لكن لا يمكنُك الفوز باللّكماتِ وحدها

198
00:12:39,640 --> 00:12:43,310
أستخدمُ ساقَيّ والرّميات الجسديّة وكذلك تقنيّات التّثبيت

199
00:12:44,840 --> 00:12:47,270
تلك اللّكمة مكشوفة وقديمة

200
00:12:47,850 --> 00:12:49,250
!أنت مجرّد حيوان في نهاية المطاف

201
00:12:51,080 --> 00:12:52,280
!ماذا كان ذلك؟

202
00:12:54,750 --> 00:12:55,580
!ذيل؟

203
00:13:04,560 --> 00:13:07,690
واحد، اثنان، ثلاثة. كان ذلك الذيل مفاجئاً

204
00:13:07,730 --> 00:13:09,470
لكن هذه سلسلة هجمات مكرّرة

205
00:13:10,200 --> 00:13:12,140
...واحد، اثنان، ثلاثة

206
00:13:12,240 --> 00:13:13,570
!يكفيك إلى هنا

207
00:13:16,840 --> 00:13:19,250
!من أين أتت تلك الضربة؟

208
00:13:24,580 --> 00:13:26,010
!لنتراجع حالياً

209
00:13:31,090 --> 00:13:32,890
استخففنا بهم كثيراً

210
00:13:32,920 --> 00:13:36,120
أجل. اعتقدناهم مجرّد حيوانات

211
00:13:36,460 --> 00:13:38,270
لكنّهم ليسوا كذلك

212
00:13:38,630 --> 00:13:41,570
لديهم الذكاء الكافي لاستدراجِنا وتفريقِنا

213
00:13:41,770 --> 00:13:44,000
ويمكنهم النّطق والقتال بمهارة

214
00:13:44,270 --> 00:13:46,530
لن نتساهل معهم

215
00:13:46,930 --> 00:13:48,840
مهمّتنا هي القبض عليه

216
00:13:48,880 --> 00:13:50,440
لكن سأتجاهلُ مُبالغتكم في الأمرِ قليلاً

217
00:13:50,610 --> 00:13:52,480
!نعم يا قائد

218
00:13:52,510 --> 00:13:54,280
طمأنتَني بهذا الكلام

219
00:13:54,580 --> 00:13:57,580
هذا أفضل من أن ننهزم على يدِ نعام أو كنغر

220
00:14:06,890 --> 00:14:08,800
!اسمعوا يا بشر

221
00:14:09,100 --> 00:14:11,060
!اخرجوا من هنا حالاً

222
00:14:11,260 --> 00:14:14,730
!هذه الجزيرة لنا نحن الحيوانات

223
00:14:15,360 --> 00:14:17,060
،إذا روّضَنا البشر

224
00:14:17,100 --> 00:14:19,310
!فسنخسرُ أنيابنا ومخالبنا

225
00:14:19,570 --> 00:14:21,870
!ليست لديك أنياب

226
00:14:21,910 --> 00:14:25,440
!اصمت! لن تتمكّنوا من القبضِ عليّ أبداً

227
00:14:25,970 --> 00:14:28,950
!فلقبي هو الكَندور

228
00:14:29,180 --> 00:14:31,950
لا تسمّي نفسك "كندوراً" وأنتَ لستَ سوى نعاماً

229
00:14:32,320 --> 00:14:33,450
!لا يهمّني

230
00:14:33,480 --> 00:14:36,750
!لن نرحم أي شخص ينتزعُ منّا حرّيتنا

231
00:14:37,400 --> 00:14:40,850
سنريكم قوّةَ المحاربين الحيوانات النينجا الأربعة

232
00:14:40,950 --> 00:14:43,410
المحاربون الحيوانات النينجا الأربعة؟ مُضحك

233
00:14:43,510 --> 00:14:45,410
!لا تجيد حتّى العدّ

234
00:14:45,710 --> 00:14:46,780
!لنهاجم

235
00:14:46,950 --> 00:14:48,250
أنا أفعل هذا

236
00:15:01,230 --> 00:15:02,200
!ما-ماذا؟

237
00:15:03,270 --> 00:15:04,370
!آكل نمل؟

238
00:15:04,570 --> 00:15:07,230
!إنّه آكل حشرات

239
00:15:07,700 --> 00:15:08,500
...حشراتي

240
00:15:08,530 --> 00:15:09,880
!هيّا بنا يا حواجب -
!حسناً -

241
00:15:13,110 --> 00:15:14,340
أنت مجدّداً؟

242
00:15:14,980 --> 00:15:17,410
لن يسير الأمر كما سارَ في المرّة السّابقة

243
00:15:24,020 --> 00:15:25,490
!لن تفلت

244
00:15:25,550 --> 00:15:27,420
!تقنيّة النسخ الظلّية

245
00:15:34,400 --> 00:15:35,860
!تقنيّة النسخ

246
00:15:38,930 --> 00:15:41,440
!نعام يؤدّي تقنيّة نسخ؟

247
00:15:41,770 --> 00:15:44,570
!إنّها مجرّد نسخ! هنالك حقيقيّ واحد فقط

248
00:15:50,120 --> 00:15:51,980
نعام يستطيعُ إخراج نسخ ظلّية

249
00:15:53,850 --> 00:15:58,450
!فهمتُ يا قائد! كلّها نعام حقيقيّ

250
00:15:58,780 --> 00:16:00,490
وحتّى أنّه طلبَ منهم التحضير لنصبِ كمين؟

251
00:16:07,130 --> 00:16:08,530
!تبّاً لك

252
00:16:20,610 --> 00:16:22,050
أنا جادٌّ هذه المرّة

253
00:16:22,310 --> 00:16:24,250
!إعصار ورق الشجر

254
00:16:25,080 --> 00:16:28,050
ماذا؟! المحاربون الحيوانات النينجا الأربعة... الآن قد فهمت

255
00:16:29,250 --> 00:16:30,160
!لي

256
00:16:33,060 --> 00:16:35,690
إمّا النصر أو الموت

257
00:16:36,190 --> 00:16:37,090
!تعال إليّ

258
00:16:42,000 --> 00:16:43,100
!ها أنا قادم

259
00:16:45,170 --> 00:16:46,530
!سأنال منك

260
00:16:48,700 --> 00:16:49,710
!تقنيّة البديل؟

261
00:16:50,640 --> 00:16:51,840
!قائد! خلفك

262
00:16:52,210 --> 00:16:53,710
!ماذا؟

263
00:16:59,080 --> 00:17:00,650
ما الأمر يا كوتيتسو؟

264
00:17:01,290 --> 00:17:02,520
...ليس ثانية

265
00:17:02,790 --> 00:17:05,850
نشكّلُ فريقاً ممتازاً

266
00:17:07,550 --> 00:17:09,290
...كـ-كان ذلك فعلاً

267
00:17:09,860 --> 00:17:13,930
لنصبح جونين يوماً ما أيضاً. أنت وأنا

268
00:17:17,860 --> 00:17:19,910
ذ-ذكرى قديمة

269
00:17:22,570 --> 00:17:25,040
سوف أموت فعلاً إذاً

270
00:17:25,570 --> 00:17:26,810
!آسف يا إيزومو

271
00:17:26,840 --> 00:17:28,940
لا أستطيع الوفاء بوعدي

272
00:17:29,270 --> 00:17:30,780
!كوتيتسو، راوغ

273
00:17:31,580 --> 00:17:33,850
وحتّى أنّني بدأتُ أسمع صوته

274
00:17:36,180 --> 00:17:37,950
!لا تستسلم! انهض

275
00:17:38,950 --> 00:17:41,830
!انفجار نيزك النّعام

276
00:17:48,690 --> 00:17:49,840
تعزيزات؟

277
00:17:50,440 --> 00:17:52,040
!إيزومو! أنت

278
00:17:52,400 --> 00:17:53,300
!سنستخدم تلك الهجمة

279
00:17:53,740 --> 00:17:55,400
!نـ-نعم! أعتمد عليك

280
00:18:08,480 --> 00:18:10,490
!أسلوب الماء: فخّ الشراب

281
00:18:16,360 --> 00:18:18,020
!سأنال منك

282
00:18:18,590 --> 00:18:20,000
!ا-انتظر

283
00:18:20,030 --> 00:18:21,000
!لن أفعل

284
00:18:28,430 --> 00:18:30,080
!هيّا بنا

285
00:18:36,610 --> 00:18:37,580
...تحطّمت

286
00:18:39,010 --> 00:18:40,820
انتهى الأمرُ أخيراً

287
00:18:42,090 --> 00:18:43,020
وأنا انتهيتُ أيضاً

288
00:18:47,820 --> 00:18:49,290
نجحتُ بشقّ الأنفس

289
00:18:53,830 --> 00:18:57,060
إيزومو... شكراً لمجيئك. أنقذتني

290
00:18:57,430 --> 00:18:59,870
...لولا مجيئك، لكنتُ قد

291
00:19:00,740 --> 00:19:02,140
لكن هنالك مشكلة واحدة

292
00:19:02,170 --> 00:19:05,340
أتيتُ دون إنجاز عمل كلّفَتْني به هوكاغي-ساما

293
00:19:06,640 --> 00:19:08,810
عندما نعود، سيحينُ دوري لمُساعدتك

294
00:19:09,880 --> 00:19:11,020
...أنت

295
00:19:11,250 --> 00:19:12,220
!اللّعنة

296
00:19:12,820 --> 00:19:14,950
لا تحاول الهرب ثانية

297
00:19:15,380 --> 00:19:17,420
...أنا متأكّدٌ أنّك ستفهمني، لكن

298
00:19:17,680 --> 00:19:18,750
ما الأمر؟

299
00:19:18,780 --> 00:19:19,790
!أيّها الوقح

300
00:19:20,390 --> 00:19:22,030
!هذا دبِق

301
00:19:22,190 --> 00:19:24,890
!إيّاك والظنّ أنّني سأستسلم

302
00:19:32,470 --> 00:19:34,800
هذا هو المصير الذي يشاركني به ناروتو

303
00:19:35,570 --> 00:19:39,000
يظلُّ يفسِدُ حرّيتي

304
00:19:39,040 --> 00:19:40,380
!أيّها الكندور

305
00:19:41,080 --> 00:19:43,480
!هل هربتَ مجدّداً؟

306
00:19:44,680 --> 00:19:46,750
...سنتابع هذا

307
00:19:48,010 --> 00:19:49,720
!في المرّة المقبلة

308
00:19:49,990 --> 00:19:51,390
!انتظر

309
00:19:53,260 --> 00:19:55,390
!غبيّ، غبيّ، غبيّ

310
00:19:55,460 --> 00:19:56,720
!أيّها الكندور

311
00:19:58,260 --> 00:20:01,230
!غبيّ! غبيّ