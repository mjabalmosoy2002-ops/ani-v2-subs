1
00:00:09,220 --> 00:00:10,260
ألن تأكل؟

2
00:00:12,390 --> 00:00:13,390
...في الواقع

3
00:00:15,600 --> 00:00:18,010
يذكّرني هذا بذكريات مريرة

4
00:00:34,680 --> 00:00:35,510
هل أنت بخير؟

5
00:00:35,680 --> 00:00:37,470
إنّه مستخدم تايجيتسو قويّ

6
00:00:38,300 --> 00:00:40,390
حسناً، لقد وصلت، لذا اطمئنّ

7
00:00:41,510 --> 00:00:43,350
أنا هنا

8
00:00:43,350 --> 00:00:44,260
مرحباً

9
00:00:47,390 --> 00:00:48,720
!أنت المعلّم العجوز تشين

10
00:00:49,140 --> 00:00:52,390
!ماذا؟! والمعروف بمستخدم التايجيتسو الأقوى؟

11
00:00:52,800 --> 00:00:54,300
إنّه بطل كونوها

12
00:00:54,350 --> 00:00:56,140
!الذي مات أثناء حرب النينجا العظيمة الثّالثة

13
00:00:56,470 --> 00:00:58,850
هل أنا مشهور إذاً؟

14
00:01:00,430 --> 00:01:03,010
آنذاك، كنتُ أستطيع مراقبتك من بعيد فحسب

15
00:01:03,760 --> 00:01:05,760
،كمُستخدِم تايجيتسو

16
00:01:05,800 --> 00:01:08,050
إنّه لشرف عظيم أن أكون قادراً
على مُقاتلتك

17
00:01:08,300 --> 00:01:10,220
...هناك من يتحكّم بي

18
00:01:10,550 --> 00:01:12,220
لن أتمكّن من إظهار الرّحمة

19
00:01:12,220 --> 00:01:13,760
!هذا ما أتمنّاه بالضبط

20
00:01:16,430 --> 00:01:21,050
!إعصار كونوها العظيم

21
00:01:23,220 --> 00:01:24,800
!نفحة كونوها

22
00:01:33,140 --> 00:01:34,600
إ-إنّه قويّ

23
00:01:46,010 --> 00:01:47,970
!غاي... ينهزم

24
00:01:52,640 --> 00:01:53,220
!لي؟

25
00:01:54,300 --> 00:01:55,800
!أنا آسف، سأعود في الحال

26
00:01:56,140 --> 00:01:58,260
!ابقَ هنا وارتح من فضلك يا ساي

27
00:02:05,850 --> 00:02:06,680
...يجب

28
00:02:07,890 --> 00:02:09,260
أن تراوغ هذه

29
00:02:10,140 --> 00:02:11,800
!أليست التقنيّة الأسطوريّة؟

30
00:02:14,640 --> 00:02:15,350
!غاي سينسي

31
00:02:17,180 --> 00:02:18,640
!سأساعدك

32
00:02:19,220 --> 00:02:19,720
!لي؟

33
00:02:22,260 --> 00:02:23,100
!المعلّم العجوز تشين

34
00:02:25,220 --> 00:02:27,800
أظنّني مشهوراً حقّاً

35
00:02:28,430 --> 00:02:30,600
شرف لي أن أراك مجدّداً

36
00:02:32,390 --> 00:02:34,600
ماتَ قبل أن تُولَد حتّى

37
00:02:35,140 --> 00:02:36,680
كيف التقيتَ به؟

38
00:02:37,220 --> 00:02:39,350
لم يكن المعلّم العجوز ميّتاً

39
00:02:39,800 --> 00:02:40,390
!ماذا؟

40
00:02:41,430 --> 00:02:42,260
...في ذلك الوقت

41
00:02:43,640 --> 00:02:46,890
!إن كنتَ المعلّم الحقيقيّ تشين، لديّ طلب

42
00:02:50,390 --> 00:02:53,550
!علّمني إله تنّين كونوها أرجوك

43
00:02:57,510 --> 00:02:59,050
أنت ذلك الفتى؟

44
00:02:59,470 --> 00:03:02,220
...لن أنساك أبداً

45
00:03:03,180 --> 00:03:04,350
أو أنسى عين التنّين

46
00:04:34,960 --> 00:04:39,760
المعلّم العجوز وعين التنّين

47
00:04:45,540 --> 00:04:48,170
ما زلتَ شينوبي

48
00:04:49,580 --> 00:04:51,790
يجب على المرء ألّا يتخلّى عن أحلامه

49
00:04:52,290 --> 00:04:54,830
ماذا تعني؟ ما الذي يجري؟

50
00:04:55,870 --> 00:04:57,210
أنت إذاً...؟

51
00:04:58,120 --> 00:05:01,290
أجل، لم أخبرك بهذا أبداً يا غاي سينسي

52
00:05:03,830 --> 00:05:05,080
...حسبما أذكر

53
00:05:06,620 --> 00:05:09,750
حدثَ هذا بعد أن تعافيتُ من جروحي
الخطيرة بفترةٍ قصيرة

54
00:05:10,120 --> 00:05:11,580
تقنيّات تايجيتسو سرّية
!انظرا

55
00:05:12,170 --> 00:05:14,580
وجدتُها في المكتبة

56
00:05:18,920 --> 00:05:20,540
!إله تنّين كونوها؟

57
00:05:20,580 --> 00:05:22,080
تبدو تقنيّة سرّية ابتكرها شخص

58
00:05:22,120 --> 00:05:23,250
يُعرَف بالمعلّم العجوز تشين

59
00:05:24,830 --> 00:05:27,500
!كلمات "تقنيّة سرّية" حمّسَتْني

60
00:05:27,620 --> 00:05:30,710
!لنبحث عن المعلّم تشين ونطلب منه تعليمنا

61
00:05:31,080 --> 00:05:33,420
لكن ورد هنا أنّ هذا الرجل كان بطل كونوها

62
00:05:33,460 --> 00:05:36,210
توفّي في حربِ النينجا العظيمة الثّالثة

63
00:05:36,500 --> 00:05:38,790
!إنّه ميّت؟

64
00:05:39,080 --> 00:05:40,210
!لا بأس

65
00:05:40,790 --> 00:05:44,170
أنا متأكّد أنّ كلّ ما يتعلّق بإله
تنّين كونوها مكتوب هنا

66
00:05:46,920 --> 00:05:47,870
!...لا

67
00:05:48,790 --> 00:05:50,420
،أردتُ إتقان هذا

68
00:05:50,460 --> 00:05:53,210
لأصبح أقوى في ظلِّ غياب غاي سينسي

69
00:05:54,120 --> 00:05:55,040
...حواجب

70
00:05:55,750 --> 00:05:57,790
يمكنك أن تتدرّب معي فحسب

71
00:05:58,120 --> 00:05:58,670
ماذا؟

72
00:05:58,830 --> 00:06:03,120
عليّ أن أصبح أقوى أيضاً وذلك
كي أتمكّن من إعادةِ ساسكي

73
00:06:03,370 --> 00:06:04,210
...ناروتو

74
00:06:04,920 --> 00:06:07,920
يبدو أنّ قبر هذا الرجل قريب من القرية

75
00:06:08,210 --> 00:06:09,210
حقّاً؟

76
00:06:10,330 --> 00:06:13,040
لنذهب ونقدّم تعازينا عند
،قبر البطل إذاً

77
00:06:13,080 --> 00:06:14,580
!ونُلهم أنفسنا ونتدرّب بجدّ

78
00:06:25,080 --> 00:06:27,080
هل تحضرين كرات الأرزّ إلى هنا
كلّ يوم يا أزامي؟

79
00:06:27,710 --> 00:06:29,330
أجل، لأنّه قبر جدّي

80
00:06:29,920 --> 00:06:32,210
إنّها حفيدة المعلّم العجوز إذاً؟

81
00:06:33,370 --> 00:06:34,960
!هل تعرفين كيفيّة أداء إله تنّين كونوها؟

82
00:06:35,540 --> 00:06:37,170
!بالطبع لا

83
00:06:38,040 --> 00:06:39,790
جدّي على قيدِ الحياة

84
00:06:40,250 --> 00:06:40,830
!ماذا؟

85
00:06:41,920 --> 00:06:43,920
يأتي ويأكل كرات الأرزّ

86
00:06:45,080 --> 00:06:46,250
هذا سخيف

87
00:06:47,170 --> 00:06:49,210
ماذا تعني بأنّه على قيدِ الحياة؟

88
00:06:55,040 --> 00:06:57,580
هذا لذيذٌ جدّاً

89
00:06:58,120 --> 00:06:59,080
!مـ-من أنت؟

90
00:06:59,250 --> 00:07:00,870
!إنّه المعلّم العجوز تشين؟

91
00:07:00,920 --> 00:07:02,290
!هذا مستحيل

92
00:07:02,540 --> 00:07:05,040
!إنّه يخدع أزامي كي تحضر له كرات أرزّ

93
00:07:06,250 --> 00:07:07,370
!لن أغفر له

94
00:07:09,870 --> 00:07:12,170
لن أشاطركم شيئاً

95
00:07:13,500 --> 00:07:15,120
!لا تأكلها

96
00:07:24,620 --> 00:07:27,750
!أفسدتَ متعتي الوحيدة في الحياة

97
00:07:29,250 --> 00:07:31,170
!إله تنّين كونوها

98
00:07:32,250 --> 00:07:33,500
!ماذا؟ -
!ماذا؟ -

99
00:07:43,920 --> 00:07:45,620
...إله تنّين كونوها

100
00:07:46,250 --> 00:07:47,210
...مذهل

101
00:07:49,290 --> 00:07:51,210
مذهل. كان على قيدِ الحياة فعلاً

102
00:07:52,170 --> 00:07:52,830
...وبالتالي

103
00:07:53,330 --> 00:07:55,960
وجدتُها فرصة لتعلّم التقنيّة السرّية

104
00:07:56,000 --> 00:07:57,620
ورحتُ إلى قبره ثانية

105
00:07:59,040 --> 00:08:02,170
!إن كنتَ المعلّم العجوز تشين فعلاً فلديّ طلب

106
00:08:05,870 --> 00:08:10,790
علّمني تلك التقنيّة أرجوك... إله تنّين كونوها

107
00:08:16,250 --> 00:08:18,870
!لا أستطيع استخدام النينجيتسو

108
00:08:20,420 --> 00:08:22,670
!لهذا أريد إصقال مهاراتي في التايجيتسو

109
00:08:23,580 --> 00:08:25,750
لا يمكنك استخدام النينجيتسو؟

110
00:08:26,330 --> 00:08:29,370
لا، لا يمكنني! لكنّني أفعل ما بوسعي لأثبت

111
00:08:29,420 --> 00:08:32,500
أنّني أستطيع أن أكون شينوبي
عظيماً بالتايجيتسو وحدها

112
00:08:33,330 --> 00:08:36,080
تفعل ما بوسعك رغم ذلك...؟

113
00:08:40,210 --> 00:08:43,710
الشينوبي العاجز عن استخدامِ نينجيتسو
!لا يمكنه أن يصبح شينوبي

114
00:08:44,790 --> 00:08:47,080
سأدقّ ذلك في جسدِك كي تفهم

115
00:08:47,120 --> 00:08:49,460
أنّك غير مؤهّل لتكون شينوبي

116
00:09:05,620 --> 00:09:06,620
!حواجب -
!لي -

117
00:09:09,250 --> 00:09:11,370
ماذا حدث... للتو؟

118
00:09:11,790 --> 00:09:13,080
!أنت ضعيف

119
00:09:14,120 --> 00:09:16,170
!انسَ مسألة الشينوبي

120
00:09:16,580 --> 00:09:18,170
...هـ-هذا

121
00:09:21,580 --> 00:09:24,120
!كيف تقول كلاماً قاسياً كهذا لـ(لي)؟

122
00:09:25,370 --> 00:09:28,790
أنت تحديداً ينبغي أن يعرف

123
00:09:30,420 --> 00:09:33,000
من السّخافة أن يخاطر بحياته

124
00:09:33,040 --> 00:09:35,210
!ليصبح شينوبي

125
00:09:35,210 --> 00:09:36,460
كيف عرفت هذا؟

126
00:09:37,040 --> 00:09:39,170
أخبرَني بنفسه

127
00:09:47,500 --> 00:09:48,870
سترى ذلك العجوز؟

128
00:09:49,000 --> 00:09:50,500
سنُرافقك

129
00:09:51,500 --> 00:09:52,500
...أنتما

130
00:09:54,210 --> 00:09:57,290
شكراً لكما، لكن اتركاني بمفردي رجاء

131
00:09:57,420 --> 00:09:58,080
ماذا؟ -
ماذا؟ -

132
00:09:58,420 --> 00:10:00,540
قال أنّني لستُ مؤهّلاً

133
00:10:00,580 --> 00:10:03,170
أريده أن يعترف بمهاراتي

134
00:10:03,960 --> 00:10:04,870
...لي -
...حواجب -

135
00:10:06,620 --> 00:10:08,960
!ولهذا... سأذهب بمفردي

136
00:10:09,500 --> 00:10:11,420
عرفتُ أنّك ستقول ذلك

137
00:10:11,540 --> 00:10:12,040
ماذا؟

138
00:10:12,370 --> 00:10:15,080
تفضّل... خذ هذه

139
00:10:18,580 --> 00:10:20,790
طلب منّي أزامي أن أعطيك إيّاها

140
00:10:22,120 --> 00:10:23,040
...شكراً لكِ

141
00:10:36,040 --> 00:10:38,670
تشين

142
00:11:02,000 --> 00:11:04,080
!أنت فتى عنيد

143
00:11:04,170 --> 00:11:07,120
لن أطلب منك تعليمي تلك التقنيّة

144
00:11:08,460 --> 00:11:10,170
لكن أرجوك هاجمني

145
00:11:10,210 --> 00:11:13,120
بإله تنّين كونوها مرّة أخرى

146
00:11:15,120 --> 00:11:18,080
قلتَ أنّني غير مؤهّل لأكون شينوبي

147
00:11:18,830 --> 00:11:22,250
لا أستطيع قبول هذا

148
00:11:24,000 --> 00:11:26,210
...إذا استطعتُ هزيمة تلك التقنيّة

149
00:11:27,170 --> 00:11:31,170
!فقُل أنّك تعترف بي كشينوبي أرجوك

150
00:11:31,210 --> 00:11:32,210
!أتوسّل إليك

151
00:11:32,830 --> 00:11:35,420
!استخدِم إله تنّين كونوها مرّة أخرى أرجوك

152
00:11:42,170 --> 00:11:44,580
انتصرَ عليّ إصرارك

153
00:11:44,670 --> 00:11:46,370
سأحترم طلبك

154
00:11:47,920 --> 00:11:50,210
رغم أنّني أشكّ في أنّك ستتمكّن

155
00:11:50,250 --> 00:11:52,080
من رؤية عين التنّين

156
00:11:52,250 --> 00:11:53,790
عين... التنّين؟

157
00:11:55,210 --> 00:11:57,620
والآن ستدرك كم أنّك غير مؤهّل

158
00:11:57,670 --> 00:11:59,120
!لتكون شينوبي

159
00:12:01,040 --> 00:12:03,040
!سأدعك تعترف بي حتماً

160
00:12:04,210 --> 00:12:06,170
!إله تنّين كونوها

161
00:12:26,540 --> 00:12:28,660
!الدّخول الفعّال

162
00:13:12,870 --> 00:13:14,580
كُل ومن ثمّ اذهب إلى المنزل

163
00:13:14,620 --> 00:13:16,540
وانسَ مسألة الشينوبي

164
00:13:17,080 --> 00:13:20,700
افعلها أرجوك... مرّة أخرى

165
00:13:22,120 --> 00:13:24,660
عين التنّين... والزوبعة

166
00:13:27,330 --> 00:13:30,200
أشعر وكأنّني اقتربت

167
00:13:32,790 --> 00:13:36,620
لماذا لا تستسلم بعد أن هُزِمت
هزيمة نكراء؟

168
00:13:37,250 --> 00:13:39,080
أنت مثله تماماً

169
00:13:41,790 --> 00:13:44,250
على أي حال، انسَ مسألة الشينوبي

170
00:13:45,540 --> 00:13:50,700
أنا... لا أتخلّى أبداً عن حلمي
في أن أصبح

171
00:13:50,750 --> 00:13:52,540
شينوبي

172
00:13:54,580 --> 00:13:58,790
ثمّة شخص يراهن بحياته على أن أصبح شينوبي

173
00:13:58,830 --> 00:14:01,870
قطعتُ وعداً على غاي سينسي

174
00:14:04,540 --> 00:14:08,870
وأنت تنكر ذلك، لهذا لن أخسر أمامك

175
00:14:08,950 --> 00:14:12,540
لذا أرجوك، مرّة أخرى فقط

176
00:14:12,950 --> 00:14:15,250
انسَ حلمك

177
00:14:16,080 --> 00:14:18,080
أقول لك هذا لأجلك

178
00:14:18,160 --> 00:14:19,540
!انتظر أرجوك

179
00:14:24,410 --> 00:14:27,250
وبعد ذلك، لم أعد أراه

180
00:14:28,540 --> 00:14:31,500
انسَ حلمك" قلتَ هذا لأجلِ لي"

181
00:14:32,870 --> 00:14:34,870
الشينوبي العاجز عن استخدامِ النينجيتسو

182
00:14:34,870 --> 00:14:37,910
في عالم الشينوبي الخطير هو شخصٌ ضعيف

183
00:14:37,910 --> 00:14:38,620
ماذا؟

184
00:14:38,950 --> 00:14:42,080
ربّما لا ينبغي لمثله حتّى أن يطمح ليُصبح شينوبي

185
00:14:45,580 --> 00:14:48,000
أيّها المعلّم العجوز، لم تكن مخطئاً

186
00:14:48,040 --> 00:14:50,700
في محاولةِ إقناع لي بالتخلِّي عن فكرة الشينوبي

187
00:14:51,160 --> 00:14:52,620
غاي سينسي؟

188
00:14:54,000 --> 00:14:55,000
...لكن

189
00:14:56,000 --> 00:14:58,000
!لن أقبل بهذا أبداً

190
00:14:59,330 --> 00:15:01,830
!ما فعلتَه كان خاطئاً

191
00:15:05,250 --> 00:15:06,330
...غاي سينسي

192
00:15:08,830 --> 00:15:12,120
ظننتُ أنّك أنت تحديداً سوف تفهمني

193
00:15:12,700 --> 00:15:15,750
...لكن سأثبت لكما بصفتكما معلّم وتلميذه

194
00:15:15,790 --> 00:15:16,910
أنّكما مخطئان

195
00:15:16,950 --> 00:15:18,750
!لسنا مخطئين

196
00:15:18,870 --> 00:15:21,540
!لي! ينبغي أن تثبت له

197
00:15:21,870 --> 00:15:22,700
!حاضر

198
00:15:26,410 --> 00:15:29,080
لم أتوقّع أبداً أن تحين هذه اللّحظة

199
00:15:41,000 --> 00:15:42,370
!زهرة اللّوتس الأوّليّة

200
00:15:53,500 --> 00:15:55,700
شكل إله تنّين كونوها الحقيقيّ هو زوبعة

201
00:15:56,080 --> 00:15:57,580
...إذاً عين التنّين هو

202
00:15:59,950 --> 00:16:03,330
!لا أستطيع اختبارها الآن حتّى لو أردتُ ذلك

203
00:16:06,620 --> 00:16:09,870
!إله تنّين كونوها

204
00:16:24,700 --> 00:16:25,750
ما الأمر؟

205
00:16:25,950 --> 00:16:27,160
هل استسلمت؟

206
00:16:27,790 --> 00:16:28,950
!أظنّني سبقَ وأخبرتُك

207
00:16:29,120 --> 00:16:30,540
!أنا لا أستسلم

208
00:16:34,080 --> 00:16:36,000
أتعتبر هذه مراوغة؟

209
00:16:45,910 --> 00:16:49,040
!عين التنّين... هي عين الزوبعة

210
00:16:49,290 --> 00:16:50,580
!هذه هي نقطة ضعفها

211
00:16:51,870 --> 00:16:54,080
...انتهى أمر إله تنّين كونوها

212
00:16:55,080 --> 00:16:56,750
!زهرة اللّوتس الأوّليّة الفرديّة

213
00:17:03,870 --> 00:17:05,040
!ما-ماذا؟

214
00:17:25,410 --> 00:17:29,950
!إ-إله تنّين كونوها خاصّتي

215
00:17:31,040 --> 00:17:33,160
لماذا؟ هل هذا معقول؟

216
00:17:33,870 --> 00:17:37,540
لِمَ لا تستسلم بعد كلّ هذا؟

217
00:17:40,000 --> 00:17:41,830
تكبّدتُ جروحاً خطيرة سابقاً

218
00:17:41,870 --> 00:17:43,870
وكنتُ على وشك أن أتخلّى عن أحلامي

219
00:17:45,950 --> 00:17:49,000
...لكن قال لي غاي سينسي هذا في ذلك الوقت

220
00:17:49,910 --> 00:17:51,000
...لي

221
00:17:51,040 --> 00:17:54,950
إن أردت أن تتحرّر من معاناتك
فحكِّم عقلك

222
00:17:57,370 --> 00:18:01,160
هل تعني أن أتخلّى عن حلمي؟

223
00:18:01,790 --> 00:18:06,290
إذا تخلّيتَ عن حلمك فستعاني أكثر

224
00:18:06,790 --> 00:18:08,950
أنت من الحمقى الذين لا يستطيعون
متابعة الحياة

225
00:18:09,000 --> 00:18:11,160
إن فقدوا طريقهم في النينجا

226
00:18:11,700 --> 00:18:13,450
...أنا وأنت هكذا

227
00:18:15,750 --> 00:18:17,160
أجرِ العمليّةَ الجراحيّةَ يا لي

228
00:18:22,200 --> 00:18:24,000
ستنجح عمليّتك الجراحيّة

229
00:18:24,040 --> 00:18:25,750
لأنّك عملتَ عملاً جبّاراً للوصول إلى هنا

230
00:18:26,040 --> 00:18:28,870
لديك القوّة الكافية لبناءِ مستقبلك المجيد

231
00:18:29,040 --> 00:18:32,080
وإن أصابك مكروه في احتمال واحد من مليون

232
00:18:32,120 --> 00:18:34,200
!سأموت معك

233
00:18:36,080 --> 00:18:37,370
،منذُ التقيتُك

234
00:18:37,410 --> 00:18:41,540
كان طريقي في النينجا أن أرعاك
وأجعلك نينجا قويّاً

235
00:18:42,700 --> 00:18:43,660
!هذا وعد

236
00:18:48,790 --> 00:18:50,750
!غاي سينسي

237
00:19:01,000 --> 00:19:01,910
...هكذا إذاً

238
00:19:02,080 --> 00:19:06,540
وجدتَ لنفسِك معلّماً جيّداً

239
00:19:07,370 --> 00:19:08,160
!المعلّم العجوز -
!المعلّم العجوز -

240
00:19:12,500 --> 00:19:15,950
أنا أيضاً كان لديّ تلميذ منذ زمن بعيد

241
00:19:17,700 --> 00:19:22,200
ومثلك تماماً، لم يستطع استخدام النينجيتسو

242
00:19:25,370 --> 00:19:28,200
لكنّه قال أنّه سيصبح شينوبي بالتايجيتسو وحدها فقط

243
00:19:28,250 --> 00:19:31,080
ومن خلال التّدريب الشاقّ، تحقّقَ حلمه

244
00:19:32,000 --> 00:19:36,700
وكان في طريقه لتعلّم إله
...تنّين كونوها، لكن

245
00:19:36,870 --> 00:19:39,790
اندلعت حربُ النينجا العظيمة الثّالثة

246
00:19:39,910 --> 00:19:43,330
وذهبَ تلميذي إلى ساحةِ المعركةِ أيضاً

247
00:19:44,040 --> 00:19:47,540
لكن بالنسبة له، عجزه عن استخدام
النينجيتسو والغينجيتسو

248
00:19:47,580 --> 00:19:49,160
كان نقطة ضعفه

249
00:19:50,830 --> 00:19:54,200
ومع بالغي حزني وحسرتي، قُتِل

250
00:19:54,950 --> 00:19:58,000
سمحتُ لتلميذي أن يصبح شينوبي

251
00:19:58,040 --> 00:19:59,950
دون حتّى أن أفكّر بالعواقب

252
00:20:00,080 --> 00:20:01,750
لستُ مؤهّلاً لأكون معلّماً

253
00:20:02,450 --> 00:20:05,290
كنتُ عاجزاً عن مُسامحةِ نفسي لهذا
،تخلّيتُ عن حياتي كشينوبي

254
00:20:05,330 --> 00:20:08,910
وزيّفتُ موتي ونصبتُ قبراً

255
00:20:09,540 --> 00:20:11,950
فهمت... هذا ما حدث إذاً

256
00:20:13,080 --> 00:20:14,620
سامحني

257
00:20:15,200 --> 00:20:19,000
،ظننتُك ستسلك نفس طريق تلميذي

258
00:20:19,040 --> 00:20:20,120
...لهذا السّبب

259
00:20:24,450 --> 00:20:27,870
!لكن ستبليان أنتما الاثنان حسناً

260
00:20:29,000 --> 00:20:30,500
...المعلّم العجوز تشين

261
00:20:30,950 --> 00:20:35,700
لقد حان الوقت للاستفادةِ من ذلك القبر فعليّاً

262
00:20:56,870 --> 00:20:58,080
...المعلّم العجوز تشين

263
00:20:58,700 --> 00:21:02,040
سأحضر لك كُرات أرزّ كهِبة