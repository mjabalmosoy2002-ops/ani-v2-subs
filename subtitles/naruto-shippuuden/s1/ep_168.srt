1
00:00:04,260 --> 00:00:06,060
هيّأتُ تعويذة الختم بحيث

2
00:00:06,100 --> 00:00:08,230
،أظهرُ في داخل عقلك

3
00:00:08,260 --> 00:00:12,570
في حال قد كُسِرَ الختم إلى الدرجة
التي يظهر فيها الذيل الثّامن

4
00:00:13,970 --> 00:00:17,040
...أردتُ تجنّب ذلك حقّاً

5
00:00:18,570 --> 00:00:21,920
لأنّني لم أكن أرغب برؤيتك مجدّداً... أيّها الكيوبي

6
00:00:25,180 --> 00:00:25,920
...ومن ناحية أخرى

7
00:00:29,650 --> 00:00:33,860
تطلّعتُ قُدماً لرؤية ابني شابّاً

8
00:00:34,560 --> 00:00:35,990
لذا فالنتيجة متكافئة

9
00:00:36,460 --> 00:00:39,490
!الهوكاغي الرّابع

10
00:00:40,260 --> 00:00:43,240
!تعالَ إلى هنا! سأمزّقك إرباً

11
00:00:43,700 --> 00:00:46,570
في تلك الحالة فسأبقى بعيداً

12
00:00:47,600 --> 00:00:49,100
أليس كذلك يا ناروتو؟

13
00:00:50,070 --> 00:00:52,710
...ناروتو... اسمي

14
00:00:56,250 --> 00:01:00,250
كيف يعرف الهوكاغي الرّابع اسمي؟

15
00:01:02,120 --> 00:01:05,320
في الواقع... أنا من سمّيتُك

16
00:01:05,820 --> 00:01:06,990
فأنتَ ابني

17
00:01:07,790 --> 00:01:11,330
...ابنك؟ إذاً... أنا

18
00:01:12,130 --> 00:01:12,970
أجل

19
00:01:14,500 --> 00:01:17,300
كما سمِعت. أنتَ ابني

20
00:01:31,120 --> 00:01:33,620
!الهوكاغي الرّابع

21
00:01:33,890 --> 00:01:35,790
إنّه مزعج، أليس كذلك؟

22
00:01:36,390 --> 00:01:37,990
لنذهب إلى مكانٍ هادئ

23
00:01:47,130 --> 00:01:50,100
لم يخبرك الهوكاغي الثّالث بالكثير، أليس كذلك؟

24
00:01:50,560 --> 00:01:54,310
أظنّه أراد أن يكتم أكبر قدر
مُمكن من المعلومات عن الكيوبي

25
00:01:55,240 --> 00:01:56,870
،فلو اكتشف النّاس أنّك كنتَ ابني

26
00:01:56,910 --> 00:01:58,870
لتعرّضتَ لخطر

27
00:02:00,210 --> 00:02:00,980
...أبي

28
00:02:06,750 --> 00:02:10,480
!لماذا ختمتَ الكيوبي داخل ابنك؟

29
00:02:10,580 --> 00:02:13,660
!هل تعلم ما الذي عانيتُ منه بسبب ذلك؟

30
00:02:13,890 --> 00:02:17,130
...كلّ البالغين قد نظروا إليّ باحتقار

31
00:02:17,190 --> 00:02:19,230
ولم أستطع كسب أيّ صديق

32
00:02:19,360 --> 00:02:23,000
،أردتُ أن يتقبّلني النّاس

33
00:02:23,040 --> 00:02:25,240
لهذا تدرّبتُ بشقاء لأصبح قويّاً

34
00:02:25,440 --> 00:02:29,170
ثمّ التقيتُ بإيروكا سينسي وكاكاشي سينسي
...والناسك المنحرف

35
00:02:29,200 --> 00:02:31,550
!وكنتُ سعيداً لأنّهم ساعدوني على أن أصبح أقوى

36
00:02:31,580 --> 00:02:35,310
لكن بسبب ذلك، استهدفَتْني
مجموعة تُدعى بالأكاتسكي

37
00:02:35,350 --> 00:02:38,280
لهذا كان عليّ أن أتدرّب أكثر

38
00:02:38,650 --> 00:02:42,720
تمكّنتُ من أن أصبح أقوى لكن مع ذلك
قتلَ الأكاتسكي أصدقائي

39
00:02:42,760 --> 00:02:45,520
لكن...؟ ما الذي أقوله؟

40
00:02:45,560 --> 00:02:48,060
!تبّاً، هل يُفترَض بي أن أكون سعيداً أم غاضباً؟

41
00:02:48,090 --> 00:02:49,820
!لم أعد أدري

42
00:02:53,500 --> 00:02:56,000
ناروتو... كم عمرك الآن؟

43
00:02:59,000 --> 00:03:00,230
ستّة عشر

44
00:03:00,880 --> 00:03:03,580
رائع... صار عمرك ستّة عشر إذاً؟

45
00:03:04,210 --> 00:03:06,710
...لا بدّ وأنّك عشتَ حياةً صعبة

46
00:03:06,740 --> 00:03:09,040
أنا آسفٌ يا ناروتو

47
00:03:10,380 --> 00:03:14,450
...أظنّني بعد تعريض ابني لمُعاناة كبيرة

48
00:03:14,750 --> 00:03:17,820
لا يحقّ لي أن أتصرّف كأب وأعتذر

49
00:03:19,590 --> 00:03:21,360
لا بأس

50
00:03:22,100 --> 00:03:26,960
فأنا ابن... الهوكاغي الرّابع... لذا أستطيع تدبّر الأمر

51
00:03:30,000 --> 00:03:33,740
،ختمتُ نصف تشاكرا الكيوبي داخلك

52
00:03:33,910 --> 00:03:36,510
لكن آمنتُ بقدرتك على التحكُّم بقوّته

53
00:03:38,740 --> 00:03:40,340
لأنّك ابني

54
00:03:44,180 --> 00:03:47,680
وهنالك سببٌ آخر وراء قيامي بهذا

55
00:03:49,750 --> 00:03:53,160
،عندما هاجمَ الكيوبي القريةَ منذُ 16 عاماً

56
00:03:53,190 --> 00:03:54,630
اكتشفتُ شيئاً

57
00:03:55,160 --> 00:03:56,130
ماذا؟

58
00:03:56,730 --> 00:03:59,390
كان هُناك عقل مُدبّر تحكّمَ بالكيوبي

59
00:03:59,430 --> 00:04:00,770
لمُهاجمة القرية

60
00:04:01,240 --> 00:04:02,100
عقل مُدبّر؟

61
00:04:02,170 --> 00:04:04,440
وهو نينجا قويّ

62
00:04:05,000 --> 00:04:08,240
يتطلّبُ مُواجهة خصم كهذا قوّةً من نوعٍ خاصّ

63
00:04:09,500 --> 00:04:12,010
أظنّه سيُهاجم قريتنا مجدّداً

64
00:04:17,280 --> 00:04:21,020
لقد دُمِّرَتْ قرية الورق

65
00:04:21,990 --> 00:04:25,720
نعم... راقبتُ من داخلك

66
00:04:26,590 --> 00:04:28,820
!راقبت؟

67
00:04:29,290 --> 00:04:31,430
أعرفُ ما حلّ بجيرايا سينسي أيضاً

68
00:04:34,290 --> 00:04:38,500
هل كان باين من استخدم الكيوبي لمُهاجمة
القرية سابقاً إذاً؟

69
00:04:38,740 --> 00:04:41,200
لا... لم يكن هو

70
00:04:41,370 --> 00:04:42,540
!من كان إذاً؟

71
00:04:43,700 --> 00:04:45,170
أحدُ الأكاتسكي

72
00:04:45,300 --> 00:04:47,070
الشخص المُقنَّع

73
00:04:51,850 --> 00:04:55,580
آنذاك... استقرأ كلّ حركة قمتُ بها

74
00:04:56,310 --> 00:04:57,650
إنّه ليس نينجا عاديّاً

75
00:04:59,460 --> 00:05:02,560
ربّما هذا الرجل يستغلُّ باين فحسب

76
00:05:02,760 --> 00:05:06,220
!لا! باين لديه ضغينة تجاه قرية الورق

77
00:05:06,420 --> 00:05:09,470
قال أنّ قريته قد أُبيدَتْ منذ زمن بعيد كقريتنا

78
00:05:09,900 --> 00:05:11,330
هذا صحيح

79
00:05:11,800 --> 00:05:13,630
ويتمّ استغلاله بسبب هذا الحقد

80
00:05:14,300 --> 00:05:17,400
!استغلاله؟! استغلال شخص بقوّته؟

81
00:05:18,380 --> 00:05:21,280
وماذا عن هذا النينجا المُقنَّع والعقل المدبّر؟

82
00:05:21,310 --> 00:05:24,110
لمَ يهاجم الجميع قرية الورق؟

83
00:05:25,280 --> 00:05:28,180
،ربّما ما دام نظام النّينجا قائماً في هذا العالم

84
00:05:28,210 --> 00:05:30,490
فلن يكون هناك سلاماً

85
00:05:31,690 --> 00:05:34,220
...سألك باين عن السّلام

86
00:05:34,720 --> 00:05:36,720
لكن من الصّعب العثور على الإجابة

87
00:05:39,030 --> 00:05:43,230
كيف ستُواجه هذه الكراهيّة لتصنع السّلام؟

88
00:05:48,810 --> 00:05:53,170
لإنقاذ شيء عزيز... تُشَنُّ الحروب

89
00:05:57,110 --> 00:06:01,250
ما دام هناك حبّاً، سيكون هناك كرهاً

90
00:06:01,620 --> 00:06:03,880
وأحدٌ ما سيستغلُّ ذلك الكره

91
00:06:04,780 --> 00:06:08,490
لن يموت هذا الوحش المعروف بالكره طالما
أنّ هناك نِظام نينجا

92
00:06:08,590 --> 00:06:11,230
سيولّد مزيداً من الآلام

93
00:06:12,630 --> 00:06:15,460
،كان باين من قتلَ جيرايا سينسي

94
00:06:16,190 --> 00:06:19,800
لكن عند التفكير بالأمرِ مليّاً، يمكن القول

95
00:06:19,840 --> 00:06:23,970
أنّ عالم النينجا الفوضويّ والذي أنشأ باين
هو مذنبٌ أيضاً

96
00:06:24,670 --> 00:06:27,470
أن تكون نينجا يعني أن تواجه الكراهيّة

97
00:06:29,450 --> 00:06:32,880
كلّ واحد منّا يُصارع الكراهيّة

98
00:06:33,680 --> 00:06:39,190
ائتمنَ جيرايا سينسي بك لتبحث عن طريقة
لإنهاء هذه الكراهيّة

99
00:06:40,390 --> 00:06:43,120
!مع ذلك، لا أستطيع مُسامحة باين

100
00:06:44,820 --> 00:06:47,060
مُحال أن أسامحه

101
00:06:47,420 --> 00:06:48,530
...أعلم

102
00:06:49,270 --> 00:06:51,200
!أيّها الهوكاغي الرابع... أخبرني

103
00:06:53,400 --> 00:06:55,400
!ماذا ينبغي أن أفعل؟

104
00:06:59,880 --> 00:07:01,710
الهوكاغي الرّابع
يجبُ أن تبحث عن الإجابة بنفسك

105
00:07:02,610 --> 00:07:05,040
أنا لا أمتلك الإجابة

106
00:07:05,680 --> 00:07:10,290
إن لم تكن أنت ولا الناسك المنحرف تعرفان
الإجابة فكيف لي أن أعرف؟

107
00:07:10,720 --> 00:07:12,890
!الجميع يتأمّلون منّي الكثير

108
00:07:13,290 --> 00:07:15,390
!لستُ ذكيّاً

109
00:07:15,550 --> 00:07:17,520
!ولستُ نينجا عظيماً

110
00:07:18,150 --> 00:07:19,630
...و

111
00:07:21,300 --> 00:07:23,930
أنا متأكّدٌ أنّك ستجد الإجابة

112
00:07:27,760 --> 00:07:29,670
فأنا مؤمن بك

113
00:07:39,220 --> 00:07:40,020
حقّاً؟

114
00:07:40,420 --> 00:07:42,350
أتؤمن حقّاً أنّني أستطيع فعلها؟

115
00:07:43,280 --> 00:07:47,380
أن تكون أباً يعني أن تكون
مؤمناً بابنك إيماناً مُطلقاً

116
00:07:50,160 --> 00:07:53,560
حسناً إذاً... حان الوقتُ لأذهب

117
00:07:54,730 --> 00:07:56,490
فالتشاكرا خاصّتي تتلاشى

118
00:07:56,890 --> 00:07:57,660
!ماذا؟

119
00:07:58,230 --> 00:07:59,370
...لا، انتظر

120
00:08:03,270 --> 00:08:04,940
سأعيدُ بناء الختم

121
00:08:06,040 --> 00:08:07,970
لكن ستكونُ هذه هي المرّة الأخيرة

122
00:08:12,010 --> 00:08:13,550
يمكنُ إعادة إعمار قرية الورق

123
00:08:14,750 --> 00:08:16,980
!أعتمد عليك... يا ناروتو

124
00:08:26,920 --> 00:08:29,430
!شكراً... يا أبي

125
00:10:11,530 --> 00:10:14,770
إنّه يحبو إلى خارج الدّمار الكوكبيّ

126
00:10:15,930 --> 00:10:17,400
يا لها من قوّة مذهلة

127
00:10:18,540 --> 00:10:20,740
...يجبُ أن أعزّز الحجم

128
00:10:26,440 --> 00:10:28,820
!الكيوبي... اختفى؟

129
00:10:43,060 --> 00:10:44,860
...شكّه قد زال

130
00:10:45,700 --> 00:10:47,000
ماذا حدث؟

131
00:10:47,470 --> 00:10:50,780
هل أصبح يتحكّم الآن بالكيوبي؟

132
00:10:56,280 --> 00:10:57,180
!ناغاتو

133
00:11:28,150 --> 00:11:31,390
التحوّل إلى الكيوبي قد أفسدَ التشاكرا خاصّتي

134
00:11:32,350 --> 00:11:35,690
جعلَني أخسر نسخة الظل خاصتي

135
00:11:36,920 --> 00:11:41,260
لا أستطيع سوى استخدام تشاكرا تقنيّة الناسك
المتبقّية في داخلي

136
00:12:02,350 --> 00:12:04,950
إنّه في نمط الناسك مُسبَقاً

137
00:12:05,620 --> 00:12:06,920
إنّه قويّ

138
00:12:07,580 --> 00:12:11,260
،كان عليّ التأكّد من حجم قوّة الكيوبي

139
00:12:11,730 --> 00:12:14,090
لكن لم أتصوّر أبداً أن يتمكّن من التصدّي
للدمار الكوكبيّ

140
00:12:16,790 --> 00:12:18,300
!ظننتُ نفسي من الهالكين

141
00:12:20,240 --> 00:12:21,400
ماذا...؟

142
00:12:23,840 --> 00:12:25,370
...القرية هناك

143
00:12:26,600 --> 00:12:27,640
ماذا حدث؟

144
00:12:29,880 --> 00:12:32,050
أنتَ من فعلَ هذا يا ناروتو عندما كنتَ
بحالة الكيوبي

145
00:12:37,680 --> 00:12:41,260
!قتلتُ هيناتا وسكّان قرية الورق؟

146
00:12:44,490 --> 00:12:45,220
...إنّها حيّة

147
00:12:45,990 --> 00:12:47,890
أحسُّ بتشاكرا هيناتا

148
00:12:48,870 --> 00:12:50,030
،كنتُ قلقة

149
00:12:50,700 --> 00:12:53,330
لكن لم تسقط أي ضحية جرّاء هجومك

150
00:12:53,470 --> 00:12:55,830
بحالة الكيوبي

151
00:12:56,770 --> 00:12:58,000
حالفنا الحظّ

152
00:12:58,780 --> 00:13:01,510
هكذا إذاً

153
00:13:02,640 --> 00:13:05,340
حمداً لله. هذا مُطمئن

154
00:13:10,750 --> 00:13:11,850
...ناروتو

155
00:13:14,950 --> 00:13:15,990
!هيناتا-ساما

156
00:13:17,450 --> 00:13:20,900
جروحها ليست قاتلة، لكنّها بحاجة لعلاجٍ فوريّ

157
00:13:22,900 --> 00:13:25,230
سأبحث عن نينجا طبيب حالاً

158
00:13:29,770 --> 00:13:32,640
!تتعرّض قرية الورق لهجوم بواسطةِ الأكاتسكي

159
00:13:33,240 --> 00:13:36,710
!لم أعُد أقوى على الحركة! اذهبوا بسرعة

160
00:13:38,150 --> 00:13:39,550
لم أكن أعلم أنّ الأمور بهذا السّوء

161
00:13:42,920 --> 00:13:45,750
ثمّة ضفدع جريح هنا أيضاً

162
00:13:58,540 --> 00:14:00,700
حان وقتُ حسم المسألة

163
00:14:10,680 --> 00:14:13,480
هل بدأتَ تفهم قليلاً من معنى الألم؟

164
00:14:13,680 --> 00:14:18,520
ما لم تتجرّع من نفس كأس
الألم، فلن تعرف مذاق ألم آخر

165
00:14:19,020 --> 00:14:22,720
وحتّى لو تذوّقتَ آلاماً أخرى
فلن تفهم شيئاً

166
00:14:25,390 --> 00:14:27,320
هذه هي الحقيقة

167
00:14:28,930 --> 00:14:32,270
تماماً كعدمِ جدوى مُطاردتك لساسكي

168
00:14:37,600 --> 00:14:40,480
!خذني إلى باين الحقيقيّ

169
00:14:42,510 --> 00:14:44,910
أريدُ أن أتكلّم معك وجهاً لوجه

170
00:14:51,020 --> 00:14:53,750
!خذني إلى باين الحقيقيّ

171
00:14:54,450 --> 00:14:56,580
أريدُ أن أتكلّم معك وجهاً لوجه

172
00:15:00,560 --> 00:15:04,160
هل اكتشفتَ ذلك إذاً؟

173
00:15:04,990 --> 00:15:07,190
...جيرايا سينسي والآن أنت

174
00:15:07,260 --> 00:15:09,670
نينجا قرية الورق مدهشون جدّاً

175
00:15:10,400 --> 00:15:13,000
لكن نقاشنا قد انتهى

176
00:15:13,300 --> 00:15:16,470
لن يغيّر النقاش معك شيئاً

177
00:15:17,370 --> 00:15:19,380
!دعني أتكلّم معه

178
00:15:19,980 --> 00:15:21,580
...نمط الناسك

179
00:15:22,750 --> 00:15:27,110
يبدو أنّك تستطيع رمي واحدة أو اثنتين
من شوريكين التشاكرا البغيضة تلك

180
00:15:27,150 --> 00:15:28,460
أليس كذلك؟

181
00:15:28,920 --> 00:15:32,760
ثمّ سيُلغى تفعيل نمط الناسك

182
00:15:33,390 --> 00:15:35,860
!أظنُّني لا أملك خياراً سوى مُقاتلتك

183
00:15:36,590 --> 00:15:40,800
إذا أخفقَت كلتا الشوريكين لديك، ستخسر

184
00:15:41,930 --> 00:15:43,830
لن أمنحك مزيداً من الفرص

185
00:15:44,130 --> 00:15:47,710
كلّ ما بقي هو مُراوغة هجمتك ومن ثمّ
أخذ جسدك المُحتضِر معي

186
00:15:48,580 --> 00:15:50,140
...مع الأسف الشديد

187
00:15:50,810 --> 00:15:52,740
!سأضطرُّ للبحث عن باين الحقيقي بنفسي

188
00:15:54,240 --> 00:15:55,580
لكن كيف؟

189
00:15:55,910 --> 00:15:56,910
لديّ فكرة

190
00:16:33,280 --> 00:16:36,650
تعقّبَني تعقُّباً عكسيّاً باستخدام نمط الناسك

191
00:16:37,860 --> 00:16:38,790
!وجدتُك

192
00:16:44,030 --> 00:16:45,190
!أيّها الحقير

193
00:16:49,040 --> 00:16:50,270
!تقنيّة نسخة الظل

194
00:16:55,500 --> 00:16:57,070
!والآن! قنابل الدُّخان

195
00:16:57,580 --> 00:16:58,550
!حاضر

196
00:17:02,250 --> 00:17:03,880
ها هي الشوريكين الأولى

197
00:17:07,280 --> 00:17:08,820
!الدّفع الجبّار

198
00:17:10,090 --> 00:17:13,320
ماذا؟! أطلقَ الثّانية باستخدام تقنيّة
!شوريكين الظلّية؟

199
00:17:14,520 --> 00:17:16,090
!الفاصلُ الزمنيّ بين تقنيّاته هو 5 ثوانٍ

200
00:17:16,290 --> 00:17:17,630
!أستطيعُ فعلها

201
00:17:37,540 --> 00:17:39,120
!بقي أربع ثوان

202
00:17:41,090 --> 00:17:44,150
كان متأهّباً بنسخةٍ ظلّية آنذاك

203
00:17:45,790 --> 00:17:49,400
ثلاث ثوانٍ حتّى أصبح قادراً على استخدام
التقنيّة التالية

204
00:17:50,560 --> 00:17:53,960
...لكنّه أخفقَ في كلتا الطلقتَين

205
00:17:55,100 --> 00:17:56,460
انتهى الأمر

206
00:18:01,640 --> 00:18:02,710
!ماذا؟

207
00:18:03,070 --> 00:18:06,770
!!ما زال أمامنا ثانيتين! هيّا

208
00:18:10,680 --> 00:18:14,320
كان قد جعلَ كلّ هذه النسخ الظلّية الكثيرة
!تتحوّل إلى أنقاض؟

209
00:18:18,530 --> 00:18:19,760
!بقي ثانية واحدة

210
00:18:25,690 --> 00:18:26,530
!صفر

211
00:18:45,610 --> 00:18:47,550
!إنّه يستخدم النسخ الظلّية كدعم له الآن

212
00:18:50,090 --> 00:18:52,590
...شخص مثلك لا يمتلك إجابة

213
00:18:52,620 --> 00:18:53,720
!ينبغي أن يستسلم فحسب

214
00:18:56,220 --> 00:18:58,930
لكنّني مُؤمن بأنّه سيأتي

215
00:18:58,970 --> 00:19:03,130
الوقت الذي يستطيعُ فيه النّاس
أن يفهموا بعضهم الآخر

216
00:19:03,430 --> 00:19:09,110
وإن كنتُ لا أستطيع العثور على الإجابة
فقد أأتَمِنُك بالبحثِ عنها

217
00:19:09,710 --> 00:19:12,240
أنا متأكّدٌ أنّك ستجد الإجابة

218
00:19:12,410 --> 00:19:14,110
فأنا مؤمن بك

219
00:19:16,040 --> 00:19:20,650
أنت الوحيد القادر على تخطّي الهوكاغي الرّابع

220
00:19:20,850 --> 00:19:22,450
أؤمنُ بذلك حقّاً

221
00:19:28,800 --> 00:19:31,260
!قاومَها... مُستحيل

222
00:19:41,770 --> 00:19:44,110
لا يمكن إطلاق تلك التقنيّة

223
00:19:44,270 --> 00:19:45,440
لديّ خمس ثوانٍ

224
00:19:45,910 --> 00:19:47,820
هذه المسافة ستفي بالغرض بالنسبة إليّ

225
00:19:48,250 --> 00:19:51,180
...تنازل

226
00:19:55,180 --> 00:19:56,920
!عن فكرة استسلامي

227
00:19:57,150 --> 00:19:58,560
!راسينغان