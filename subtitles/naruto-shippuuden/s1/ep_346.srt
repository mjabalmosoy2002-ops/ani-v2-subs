1
00:01:29,820 --> 00:01:35,070
عالم الأحلام

2
00:01:44,180 --> 00:01:46,180
...كلّما عشتَ فترة أطول

3
00:01:46,810 --> 00:01:52,850
أدركتَ أكثر أنّه لا يوجد سوى الألم
والمُعاناة والخيبة في هذا العالم

4
00:01:53,720 --> 00:01:54,470
...اسمعني

5
00:01:55,140 --> 00:01:56,930
،في هذا العالم

6
00:01:56,970 --> 00:02:00,850
حيث يوجد نور، توجد ظلال دوماً

7
00:02:01,310 --> 00:02:03,220
،هذه كلّها روابط

8
00:02:03,260 --> 00:02:05,680
وعلاقات عفويّة لا يمكن عزلها عن بعضها

9
00:02:06,140 --> 00:02:07,180
.بحكمِ العادة

10
00:02:15,350 --> 00:02:18,350
يتحدّث عن نبذ كافّة الأشياء السيّئة
في العالم الحقيقيّ

11
00:02:18,390 --> 00:02:22,220
والهرب إلى داخل حلم مليء بالأمور الجيّدة

12
00:02:44,760 --> 00:02:48,430
بما أنّه حلم فهو يحتوي على كل ما تريده

13
00:02:51,180 --> 00:02:54,180
!حتّى أولئك الموتى يمكنهم أن يعودوا أحياء مجدداً

14
00:02:58,010 --> 00:03:02,100
...عالم لا يحوي إلّا المنتصرين
...عالم السّلام وحده

15
00:03:02,390 --> 00:03:04,100
عالم الحبّ وحده

16
00:03:04,890 --> 00:03:07,680
سأبني عالماً كهذا

17
00:03:10,640 --> 00:03:13,180
...من جديد، رين

18
00:03:14,560 --> 00:03:17,680
سأبني عالماً نستطيع فيه أن نعيش
معاً مجدّداً

19
00:03:33,310 --> 00:03:37,010
...سأقطع روابط

20
00:03:39,640 --> 00:03:40,970
...هذا العالم

21
00:03:45,350 --> 00:03:47,010
لهذا عُدت

22
00:03:54,720 --> 00:03:57,180
آمل ألّا يكون قد رآك أحد

23
00:03:58,350 --> 00:04:00,470
أنا الشّخص الوحيد الذي رأيتُه

24
00:04:01,260 --> 00:04:06,220
ذبح أوبيتو الجميع، لهذا نحن بأمان

25
00:04:07,010 --> 00:04:10,310
لكن يبدو أنّه لم يرغب في قتل كاكاشي

26
00:04:11,180 --> 00:04:13,810
لكن لم يرَ كاكاشي شيئاً

27
00:04:14,560 --> 00:04:16,930
،عندما وصلت التّعزيزات من قرية الورق المخفيّة

28
00:04:16,970 --> 00:04:19,720
"!كان يصرخ قائلاً "من قتل العدوّ؟

29
00:04:21,350 --> 00:04:24,430
ما زلت تكنّ الولاء لزميلك السابق
في الفريق إذاً؟

30
00:04:25,260 --> 00:04:28,390
لا، لم يعد يهمّني

31
00:04:28,720 --> 00:04:33,760
فيما إذا كان حيّاً أو ميّتاً في هذا العالم

32
00:04:35,010 --> 00:04:37,720
سيتواجد كاكاشي في العالم
الذي سنبنيه. ورين أيضاً

33
00:04:39,180 --> 00:04:39,680
...ورين أيضاً

34
00:04:41,010 --> 00:04:45,180
مادارا، علّمني كيف أبني عالم الأحلام هذا

35
00:04:47,890 --> 00:04:49,310
لستُ بحاجة لشكرك بعد الآن

36
00:04:50,010 --> 00:04:51,260
تعال إلى هنا

37
00:04:52,390 --> 00:04:54,640
ابتداءً من اليوم، ستكون المنقذ

38
00:04:55,470 --> 00:04:57,140
انظر في عيني

39
00:05:00,760 --> 00:05:03,140
أنت داخل الغينجيتسو خاصّتي

40
00:05:04,350 --> 00:05:05,810
،ما زالت لوحة رسم فارغة

41
00:05:05,850 --> 00:05:09,180
لكن أستطيع إسقاط إرادتي عليها
لبناء ما أشاء

42
00:05:10,180 --> 00:05:12,220
بل وحتّى التحكّم بما أسقطتُه

43
00:05:13,390 --> 00:05:14,970
،أي شيء ممكن

44
00:05:15,010 --> 00:05:18,720
ما دمتُ متّصلاً بتمثالِ غيدو وأستعير
القوّة منه

45
00:05:20,310 --> 00:05:21,390
مثل هذا، هل ترى؟

46
00:05:23,970 --> 00:05:27,180
سنستخدم هذه الغينجيتسو لبناء العالم المثاليّ

47
00:05:28,310 --> 00:05:30,720
ومن ثمّ سنستخدم الغينجيتسو على الجميع

48
00:05:30,760 --> 00:05:32,640
ونجلبهم إلى هنا

49
00:05:34,390 --> 00:05:36,680
تمّ تحقيق مقياس هذه التقنيّة

50
00:05:36,720 --> 00:05:39,180
باستخدام القمر بديلاً لعيوننا

51
00:05:39,180 --> 00:05:41,060
كي يتمّ بناء عالم كامل من الأحلام

52
00:05:42,390 --> 00:05:45,850
أنت تبسّط الأمر، لكن ما زلتُ لا أفهمه تماماً

53
00:05:47,350 --> 00:05:48,930
،دعني أشرح

54
00:05:49,260 --> 00:05:51,720
ابتداء بالريكودو سينين والجيوبي

55
00:05:52,260 --> 00:05:55,390
أليس الجيوبي مجرّد أسطورة؟

56
00:05:56,600 --> 00:05:59,350
الأساطير مستمدّة دوماً من شيء حقيقيّ

57
00:06:00,510 --> 00:06:02,930
...البيجو الذين يتجوّلون في العالم

58
00:06:02,970 --> 00:06:05,350
نشأوا عندما قسّم الرّيكودو سينين

59
00:06:05,390 --> 00:06:06,810
.قوّة الجيوبي

60
00:06:08,220 --> 00:06:11,640
!هل لديك دليل على صحّة هذه الرّواية؟

61
00:06:12,140 --> 00:06:12,720
أجل

62
00:06:14,390 --> 00:06:17,100
،بعد أن حصلتُ على خلايا هاشيراما سينجو

63
00:06:17,760 --> 00:06:20,390
زرعتُها في جرحي

64
00:06:20,680 --> 00:06:22,390
...في ذلك الوقت، لم يحدث شيء

65
00:06:23,810 --> 00:06:26,260
...لكن عندما بدأتُ أحتضر للموت بسببِ الشّيخوخة

66
00:06:27,390 --> 00:06:29,350
استيقظت الرينّيغان خاصّتي

67
00:06:30,810 --> 00:06:34,510
وأدّى ذلك في ذات الوقت
إلى إلغاء ختم معيّن

68
00:06:36,260 --> 00:06:38,640
كنتُ قادراً آنذاك على استدعاء وانتزاع

69
00:06:38,680 --> 00:06:41,220
قشرة الجيوبي من حجر ختم

70
00:06:41,680 --> 00:06:43,140
قشرة الجيوبي؟

71
00:06:44,180 --> 00:06:46,430
أسمّيه تمثال غيدو

72
00:06:47,060 --> 00:06:50,180
وحجر الختم هو ما نعرفه بالقمر

73
00:06:53,350 --> 00:06:57,140
وسرعان ما استخدمتُ جسد التمثال كحافز

74
00:06:57,180 --> 00:07:00,180
لزراعة خلايا هاشيراما لتصبح ما تراه أمامك

75
00:07:01,720 --> 00:07:05,760
يمكن للمرء أن يقول أنّ هذه الكائنات
.الاصطناعيّة هي مستنسخة عن هاشيراما

76
00:07:06,350 --> 00:07:08,310
.رغم أنّها منقوصة الجودة

77
00:07:09,930 --> 00:07:12,220
يتعذّر إيقاظ الرينّيغان

78
00:07:12,260 --> 00:07:15,390
.من دون الاستحواذ على قوى أوتشيها وسينجو معاً

79
00:07:15,720 --> 00:07:18,220
ولا يمكن التحكّم بالتمثال بسهولة

80
00:07:20,310 --> 00:07:23,510
خلايا سينجو مرفقة بالنصف الأيمن منك

81
00:07:24,350 --> 00:07:26,260
،حتّى لو لم توقظ الرينّيغان أبداً

82
00:07:26,310 --> 00:07:29,260
ينبغي أن تكون قادراً في نهاية المطاف
على التحكّم بالتمثال

83
00:07:36,010 --> 00:07:39,600
هل رأيتهما؟ عينَي ذي الشّعر الأحمر؟

84
00:07:42,180 --> 00:07:43,760
إنّها رينّيغان مادارا إذاً

85
00:07:45,220 --> 00:07:47,350
إنّها عينا مادارا الفعليّتان

86
00:07:48,010 --> 00:07:49,970
...عندما كان ذلك الطفل أصغر سنّاً

87
00:07:50,010 --> 00:07:53,140
!زرعها سرّاً دون أن يلاحظ أحد

88
00:07:54,180 --> 00:07:57,350
ناغاتو هو من نسل سينجو

89
00:07:57,640 --> 00:08:01,760
والشّخص الآخر الوحيد غير مادارا

90
00:08:01,810 --> 00:08:04,890
.القادر على استدعاءِ تمثال غيدو

91
00:08:05,720 --> 00:08:11,640
...كما قال مادارا، في البداية نكسبه لصفّنا و

92
00:08:12,260 --> 00:08:14,810
ماذا؟! ماذا ستفعل؟

93
00:08:15,430 --> 00:08:17,350
أنا ذاهب إليه مباشرة

94
00:08:17,970 --> 00:08:21,100
مـ-مهلاً، ألا ينبغي أن ترسم خطّة أولاً؟

95
00:08:21,350 --> 00:08:22,810
لستُ بحاجة لفعل ذلك

96
00:08:23,600 --> 00:08:24,390
...أوبيتو

97
00:08:25,560 --> 00:08:27,310
سأعلّمك تقنيّة أوتشيها المحرّمة

98
00:08:27,350 --> 00:08:28,390
تقنيّة الرّيكودو

99
00:08:29,260 --> 00:08:32,930
وتقنيّة أسلوب الظلّ والنور

100
00:08:39,350 --> 00:08:41,470
...لقد زرعتُ إرادتي داخل هذا

101
00:08:41,930 --> 00:08:43,600
اعتبره نصفي

102
00:08:44,680 --> 00:08:46,680
لكنّه سينحسر أيضاً

103
00:08:47,510 --> 00:08:49,310
يمكنك استخدام هذه الكائنات التي صنعتُها

104
00:08:49,350 --> 00:08:51,720
باستخدام تقنيّة أسلوب الظلّ والنّور جنوداً لك

105
00:08:57,310 --> 00:09:01,390
ذلك القضيب الأسود قد صُنِع ليكون تجلّياً
ملموساً لإرادتي

106
00:09:02,140 --> 00:09:05,310
استخدمها عندما تنفّذ تقنيّة الرّيكودو

107
00:09:29,470 --> 00:09:31,720
...والآن، انطلق

108
00:09:31,890 --> 00:09:35,850
...ريثما يحين وقت عودتي إلى الحياة

109
00:09:37,310 --> 00:09:38,470
...ستكون

110
00:09:42,310 --> 00:09:42,970
من أنت؟

111
00:09:44,390 --> 00:09:45,890
أنا مادارا أوتشيها

112
00:09:48,010 --> 00:09:49,010
مادارا؟

113
00:09:54,560 --> 00:09:58,640
إمّا أن تكون مجرماً أو مغفّلاً حقيقيّاً

114
00:09:58,680 --> 00:10:00,310
لادّعائك اسم أوتشيها مادارا

115
00:10:01,390 --> 00:10:04,100
لماذا تتقرّب منّا؟

116
00:10:04,930 --> 00:10:05,930
...الرينّيغان

117
00:10:08,060 --> 00:10:10,260
إرشاد أولئك الذين أيقظوها هو مهمّة

118
00:10:10,310 --> 00:10:14,390
منظّمتنا التي ائتمنت عليها منذ عصور مضت

119
00:10:15,970 --> 00:10:17,760
أتعلم بشأن عينيّ؟

120
00:10:19,180 --> 00:10:21,600
،أنت تقمّص للرّيكودو سينين

121
00:10:21,640 --> 00:10:25,180
.الذي حلم بسلام واستقرار العالم

122
00:10:26,560 --> 00:10:29,100
الدّول الكبرى هي الوحيدة المنعمة بالنّور

123
00:10:29,220 --> 00:10:34,180
تاركة قرية بلدكم الصّغير تحتضر في الظلال

124
00:10:34,510 --> 00:10:37,810
لهذا استيقظت عينك هنا

125
00:10:39,560 --> 00:10:42,510
حيثما يوجد نور، توجد ظلال دوماً

126
00:10:42,930 --> 00:10:45,220
...ما دام مفهوم المنتصرين قائماً

127
00:10:45,260 --> 00:10:47,890
سيتواجد المقهور أيضاً بالمقابل

128
00:10:48,720 --> 00:10:52,850
نيّة الرّغبة الأنانيّة لحفظ السّلام
تشعل فتيل الحروب

129
00:10:52,890 --> 00:10:55,890
وتتولّد الكراهيّة لحماية الحبّ

130
00:10:56,680 --> 00:10:58,510
،هذه كلّها روابط

131
00:10:58,560 --> 00:11:00,680
وعلاقات عفويّة لا يمكن عزلها عن بعضها

132
00:11:01,310 --> 00:11:02,890
.بحكم العادة

133
00:11:03,470 --> 00:11:08,930
...لكن عالم لا تجد فيه سوى المنتصرين والسّلام والحبّ

134
00:11:09,350 --> 00:11:12,140
هو عالم يمكن بناؤه أيضاً

135
00:11:12,890 --> 00:11:16,850
إذا سمحتَ لنا بالتعاون فيمكنك أن تتعلّم أيضاً

136
00:11:18,140 --> 00:11:21,640
...ما دمت تمتلك القوّة الحقيقيّة للرينّيغان

137
00:11:21,680 --> 00:11:24,970
عالمك الخاصّ يمكن تحقيقه فوراً

138
00:11:25,930 --> 00:11:27,390
...الآن

139
00:11:28,260 --> 00:11:30,140
لا أسمح بذلك

140
00:11:31,180 --> 00:11:33,350
أنت تحاول استغلالنا فحسب

141
00:11:34,140 --> 00:11:36,810
يبدو عرضك ملائماً إلى حدّ مريب

142
00:11:39,390 --> 00:11:41,430
لا يستطيع المرء بلوغ العالم الحقيقيّ

143
00:11:41,470 --> 00:11:46,220
إلّا بعد معرفة آلام الآخرين وذرف
الدموع إلى جانبهم

144
00:11:47,310 --> 00:11:49,390
ذرف الدموع إلى جانبهم؟

145
00:11:49,680 --> 00:11:51,220
تعني في الانتقام؟

146
00:11:52,180 --> 00:11:54,470
لا، ليس هذا ما قصدت

147
00:11:54,890 --> 00:11:56,890
قصدتُ في الفهم المتبادل

148
00:11:57,350 --> 00:12:00,310
كفّ عن كلام المثاليّات هذا

149
00:12:00,600 --> 00:12:02,850
لا يوجد شيء كهذا في هذا العالم

150
00:12:04,010 --> 00:12:05,680
هيّا بنا يا كونان... وناغاتو

151
00:12:06,350 --> 00:12:08,010
!لا يمكننا الوثوق بهؤلاء

152
00:12:10,350 --> 00:12:12,390
!إيّاكم والاقتراب منّا مجدّداً

153
00:12:18,260 --> 00:12:21,310
سأنتظر هنا في نفس الوقت كلّ يوم

154
00:12:21,390 --> 00:12:25,060
ستدرك ذلك في نهاية المطاف أيضاً

155
00:12:50,740 --> 00:12:51,660
!من أنتم بالضبط؟

156
00:12:53,620 --> 00:12:55,330
حرّاس هذه القرية

157
00:12:57,240 --> 00:12:58,540
هذا تحذير

158
00:12:58,580 --> 00:13:00,080
!غادروا القرية حالاً

159
00:13:01,290 --> 00:13:02,580
!اللّعنة عليهم... لنقتلهم

160
00:13:07,740 --> 00:13:09,450
!أسلوب الماء: الأمواج الهائجة

161
00:13:15,290 --> 00:13:17,410
!أسلوب الرّياح: كفّ العاصفة

162
00:13:22,120 --> 00:13:23,830
!تبّاً! لا يمكننا الاقتراب منهم

163
00:13:24,620 --> 00:13:25,830
!موتي

164
00:13:29,580 --> 00:13:31,490
!تقدّم خطوة واحدة وسأثقبك

165
00:13:34,490 --> 00:13:37,240
!لن ندعكم تتقدّمون خطوة نحو هذه القرية

166
00:13:37,990 --> 00:13:39,370
!استسلموا حالاً

167
00:13:43,990 --> 00:13:44,830
!هل السّبب هو المطر؟

168
00:13:44,870 --> 00:13:45,580
!الآن هي فرصتي

169
00:13:53,290 --> 00:13:55,120
!آسف! هل أنتِ بخير؟

170
00:13:58,540 --> 00:14:00,330
!تبّاً! لن ننتهي هكذا

171
00:14:00,790 --> 00:14:02,910
...لم أكن أريد استخدام هذا، لكن

172
00:14:15,580 --> 00:14:17,870
!هل تنتمون لعصابة هانزو؟

173
00:14:18,410 --> 00:14:21,580
نرتدي نفس عصابة الرأس لكنّنا لسنا أتباعه

174
00:14:22,240 --> 00:14:23,620
،لكن يوماً ما

175
00:14:23,660 --> 00:14:27,740
نريد نشر السّلام في العالم مثل هانزو تماماً

176
00:14:28,910 --> 00:14:31,580
بعبارة أخرى، أنتم نسخة طبق الأصل عنه

177
00:14:31,950 --> 00:14:33,160
!لسنا نسخة طبق الأصل

178
00:14:33,620 --> 00:14:35,950
!سنحافظ على السّلام في هذه القرية

179
00:14:36,370 --> 00:14:38,540
ليس بالعنف، إنّما بالتفاوض

180
00:14:39,240 --> 00:14:40,450
هل أنت مجنون؟

181
00:14:40,910 --> 00:14:43,240
!تقع هذه القرية بين دولتين عُظمتين

182
00:14:43,580 --> 00:14:46,120
،ما دامتا تتحاربان

183
00:14:46,160 --> 00:14:47,950
!لن ينتهي القتال

184
00:14:48,370 --> 00:14:51,370
!سيأخذ القويّ كلّ شيء من الضعيف

185
00:14:51,410 --> 00:14:53,040
!هكذا يسير العالم

186
00:14:54,040 --> 00:14:57,200
!نحن نقاتل لتغيير طريقة التفكير هذه

187
00:14:57,740 --> 00:15:01,290
!لا بدّ وأنّ كل واحد منكم يتمنّى السلام ضمنيّاً

188
00:15:03,200 --> 00:15:06,370
...اسمعوا. قشّة واحدة ستكون ضعيفة

189
00:15:06,450 --> 00:15:09,490
...لكن عند ضمّ ثلاثة معاً، تصبح

190
00:15:10,620 --> 00:15:13,160
،تبّاً! أحاول أن أقول فقط

191
00:15:13,160 --> 00:15:15,330
كلّما كان عددكم أكبر، كنتم أقوى

192
00:15:16,120 --> 00:15:16,950
...ياهيكو

193
00:15:17,200 --> 00:15:18,950
...أنت سيّئ جداً في إلقاء الخطابات

194
00:15:20,040 --> 00:15:21,200
!أيّاً يكن

195
00:15:21,200 --> 00:15:23,200
اسمعوا، لن نقتلكم

196
00:15:24,160 --> 00:15:25,370
!اخرجوا من هنا فحسب

197
00:15:26,700 --> 00:15:29,330
!لا أضمن عدم مهاجمتنا لكم ثانية

198
00:15:30,540 --> 00:15:34,410
لا بأس. سنكرّر هذا عشرات المرّات
إلى أن تستسلموا

199
00:15:35,040 --> 00:15:36,160
بل مئة مرّة حتّى

200
00:15:36,580 --> 00:15:40,950
لكن تذكّروا أنّ هذا سيكون أكثر إيلاماً
في المرّة المقبلة

201
00:15:42,040 --> 00:15:43,240
!انسحاب

202
00:15:45,700 --> 00:15:49,120
قبل قليل، عندما حاولتَ مهاجمتي
حميتَ الطفل

203
00:15:49,160 --> 00:15:50,120
شكراً لك

204
00:15:50,990 --> 00:15:52,790
نحن يتامى حرب أيضاً

205
00:16:00,290 --> 00:16:02,410
...يا لكم من أطفال غريبي الأطوار

206
00:16:02,950 --> 00:16:07,040
تظهرون فجأة وتطلبون حماية هذه القرية

207
00:16:08,160 --> 00:16:09,870
نفعل هذا لتغيير هذه البلاد

208
00:16:11,200 --> 00:16:14,240
لن تتوقّف الحرب في هذه البلاد

209
00:16:14,620 --> 00:16:16,540
لن يتغيّر شيء

210
00:16:17,240 --> 00:16:18,370
...ياهيكو

211
00:16:20,450 --> 00:16:22,990
يبدو أنّ الأمور تتغيّر شيئاً فشيئاً

212
00:16:28,240 --> 00:16:30,160
نحن نينجا غادرنا القرية

213
00:16:30,160 --> 00:16:34,330
لأنّنا لم نفكّر كثيراً بطريقة هانزو

214
00:16:34,990 --> 00:16:38,950
لكنّنا ضقنا ذرعاً من أسلوب الحياة هذا أيضاً

215
00:16:39,660 --> 00:16:41,540
نظرتُ في عيونكم

216
00:16:41,580 --> 00:16:45,040
...وبدأتُ أشعر برغبة في البدء من جديد

217
00:16:45,990 --> 00:16:49,040
لكن لا أشعر برغبة في العودة إلى هانزو

218
00:16:49,700 --> 00:16:52,330
!لذا اقبلونا خدماً لكم

219
00:16:52,370 --> 00:16:53,370
!لا

220
00:16:53,490 --> 00:16:55,240
!...ماذا؟! لكن قبل قليل كنتُم

221
00:16:55,540 --> 00:16:58,370
ليس خدماً، بل رفاقاً

222
00:17:01,240 --> 00:17:04,370
أنا ياهيكو، وهذان ناغاتو وكونان

223
00:17:05,910 --> 00:17:07,950
أنا كيوسكي السّريع

224
00:17:08,290 --> 00:17:12,120
إن احتجتم لجمع معلومات، يمكنكم الاعتماد
على هاتين السّاقين السريعتين

225
00:17:12,660 --> 00:17:17,080
إذاً اذهب وابحث لي عن قرى أخرى
تعاني كهذه القرية

226
00:17:23,700 --> 00:17:24,540
...ياهيكو

227
00:17:24,950 --> 00:17:25,700
ماذا؟

228
00:17:26,160 --> 00:17:28,290
ينبغي أن تمنح مجموعتنا اسماً

229
00:17:30,160 --> 00:17:33,290
هنالك آخرون غيرنا الآن، سيكون
الأمر ملحّاً عمّا قريب

230
00:17:35,620 --> 00:17:36,950
...اسم

231
00:17:42,240 --> 00:17:44,200
ما رأيكم بـ... أكاتسكي

232
00:17:45,040 --> 00:17:48,160
تنوح هذه الأمّة من معاناة الحروب

233
00:17:49,370 --> 00:17:52,240
...لهذا سنغيّر هذه الأمّة

234
00:17:52,290 --> 00:17:55,450
!لا بل هذا العالم ونرحّب بفجر جديد

235
00:17:56,240 --> 00:17:57,200
...أكاتسكي

236
00:17:58,200 --> 00:17:59,330
هذا اسم عظيم

237
00:18:00,160 --> 00:18:02,660
!أكاتسكي! حُسم الأمر

238
00:18:03,120 --> 00:18:04,080
!أجل -
!أجل -

239
00:18:17,740 --> 00:18:21,370
وكأنّ... الأكاتسكي قد نمت فجأة

240
00:18:22,450 --> 00:18:24,700
اقتنعوا جميعاً بحلمك

241
00:18:25,700 --> 00:18:28,790
في الحقيقة، سئموا من الحروب

242
00:18:29,790 --> 00:18:32,910
أنا متأكّد أننا نستطيع تحقيق
السّلام إذا توحّد الجميع

243
00:18:34,990 --> 00:18:36,370
صحيح، أين كونان؟

244
00:18:36,830 --> 00:18:38,660
خرجت منذ مدّة

245
00:18:39,160 --> 00:18:40,160
لماذا؟

246
00:18:40,290 --> 00:18:41,200
...لا أدري

247
00:18:44,660 --> 00:18:45,450
...هذه

248
00:18:46,200 --> 00:18:47,200
...لكونان

249
00:18:50,240 --> 00:18:51,990
"...عزيزتي كونان"

250
00:18:53,160 --> 00:18:55,740
"...منذ اللحظة التي رأيتكِ فيها"

251
00:18:56,080 --> 00:18:56,950
!هل هذه...؟

252
00:18:57,290 --> 00:18:58,330
إنّها رسالة حبّ

253
00:18:59,290 --> 00:19:02,080
"أردتُ أن أسألكِ عن إحساسكِ تجاهي

254
00:19:02,120 --> 00:19:06,580
"سأنتظر بقلق في الشرفة الخلفيّة... كيوسكي"

255
00:19:07,580 --> 00:19:10,160
!هل يُعقل... أنّ كونان ذهبت إلى هناك؟

256
00:19:10,330 --> 00:19:11,160
...لا أدري

257
00:19:18,200 --> 00:19:20,990
ياهيكو، ألم يكن هناك ما أردتَ فعله؟

258
00:19:21,040 --> 00:19:22,160
!ماذا؟

259
00:19:22,200 --> 00:19:25,120
أجل، أجل! نسيت. عليّ الذهاب
!لقضاء حاجتي

260
00:19:25,660 --> 00:19:27,410
!سأبلّل نفسي

261
00:19:35,910 --> 00:19:36,870
!ذلك الرّجل

262
00:19:37,620 --> 00:19:40,410
!الرّكض ليس الشيء الوحيد الذي يفلح فيه

263
00:19:41,080 --> 00:19:43,160
...المزيد من الأصدقاء يعني أيضاً

264
00:19:43,200 --> 00:19:45,620
!المزيد من المنافسة في الحبّ

265
00:19:46,120 --> 00:19:47,290
الأمر خطير

266
00:19:48,200 --> 00:19:49,200
!ناغاتو

267
00:19:50,080 --> 00:19:51,870
هل تحبّ كونان يا ياهيكو؟

268
00:19:53,620 --> 00:19:55,870
!غبيّ! لا شيء من هذا القبيل

269
00:19:57,200 --> 00:19:59,410
أعتقد أنّ كونان تحبّك

270
00:19:59,870 --> 00:20:00,620
!ماذا؟

271
00:20:03,910 --> 00:20:05,120
إنّها عائدة

272
00:20:06,490 --> 00:20:07,830
...أعلم أنّكما هناك

273
00:20:08,330 --> 00:20:10,490
يا ياهيكو وناغاتو

274
00:20:11,660 --> 00:20:12,790
...كونان

275
00:20:12,990 --> 00:20:14,160
ماذا قلتِ له؟

276
00:20:15,240 --> 00:20:17,830
قلتُ له أنني لا أملك الوقت لعلاقة

277
00:20:17,870 --> 00:20:20,290
ما لم نحقّق حلم الأكاتسكي

278
00:20:20,950 --> 00:20:21,910
أليس كذلك؟

279
00:20:23,240 --> 00:20:24,040
...كونان

280
00:20:25,080 --> 00:20:25,870
!ياهيكو

281
00:20:26,620 --> 00:20:28,540
هل يمكنك أن تساعدني في بعض التدريب؟

282
00:20:31,290 --> 00:20:33,200
...هذه التقنيّة... لن تنجح

283
00:20:33,240 --> 00:20:34,620
!تحت المطر

284
00:20:45,330 --> 00:20:46,660
...ورق مزيّت

285
00:20:47,370 --> 00:20:48,290
فكرة عظيمة

286
00:20:48,990 --> 00:20:50,330
لقد طبّقتُ تجربة

287
00:20:51,240 --> 00:20:53,330
!إن تردّدتَ فسوف أتركك وأمضي

288
00:20:54,290 --> 00:20:55,790
!لن أدعك