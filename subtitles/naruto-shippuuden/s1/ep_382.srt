1
00:00:16,010 --> 00:00:17,800
ما هذا؟

2
00:00:25,210 --> 00:00:25,830
كاتسويو

3
00:00:26,330 --> 00:00:26,960
نعم سيّدتي

4
00:00:27,630 --> 00:00:28,990
سأشرحُ كلّ شيء

5
00:00:52,930 --> 00:00:54,510
هل أنتِ بخير يا ساكورا؟

6
00:00:55,140 --> 00:00:55,720
...نعم

7
00:00:55,970 --> 00:00:57,640
سيصِلُ الكاغي الخمسة إلى هُنا قريباً

8
00:00:57,720 --> 00:00:59,960
شيكامارو

9
00:01:14,870 --> 00:01:17,160
حالتُه حرِجة جداً

10
00:01:19,900 --> 00:01:20,690
كاتسويا-ساما

11
00:01:20,980 --> 00:01:22,690
لنبدأ بالشِّفاءِ عن بُعد فوراً

12
00:01:23,270 --> 00:01:24,110
هذا غيرُ مُمكِن

13
00:01:25,400 --> 00:01:26,270
!لماذا؟

14
00:01:27,400 --> 00:01:31,510
...حتَّى شظايايّ الصّغيرة المُلتصِقة بالجميعِ قد جفَّتْ

15
00:01:31,720 --> 00:01:34,100
لقد استنزفت التشاكرا خاصّتها وماتت

16
00:01:35,010 --> 00:01:35,890
...هذا

17
00:01:36,720 --> 00:01:37,470
...بعبارةٍ أُخرى

18
00:01:37,850 --> 00:01:40,300
الجميعُ بنفسِ حالة شظايايّ تماماً

19
00:01:44,420 --> 00:01:47,170
...آسِف يا أبي

20
00:01:47,920 --> 00:01:51,330
...يبدو أنّني سأحذو حذوّك

21
00:01:51,660 --> 00:01:52,540
شيكامارو

22
00:01:53,580 --> 00:01:55,620
آسِف .. يا أمِّي

23
00:01:56,330 --> 00:01:56,910
شيكامارو

24
00:01:56,990 --> 00:01:57,740
ساكورا

25
00:02:00,480 --> 00:02:01,860
،إذا كنَّا سنموتُ بأي حال

26
00:02:02,820 --> 00:02:07,230
فسنقاتل ونبذل قصارى جهودنا وقدراتنا

27
00:02:07,820 --> 00:02:09,890
ولكن ...في هذه الحالة

28
00:02:18,670 --> 00:02:20,670
سنموتُ قبلَ حتَّى أن نُقاتل

29
00:03:52,420 --> 00:03:57,680
حلم شينوبي

30
00:04:02,550 --> 00:04:04,080
قُضي على النِّينجا

31
00:04:05,210 --> 00:04:06,670
لا داعي للمُتابَعة

32
00:04:08,330 --> 00:04:10,540
إن لم تُقاوموا فلن أقتلَكم

33
00:04:19,070 --> 00:04:21,570
،إن استمررتم في مقاومتنا

34
00:04:21,660 --> 00:04:25,270
فستظلّون تخسرون زملاءكم واحداً تلو الآخر

35
00:04:25,730 --> 00:04:27,610
...سيُصبحُ هذا عالماً

36
00:04:27,690 --> 00:04:29,690
خالياً من أيّ شخصٍ يعترِف بوجودك

37
00:04:32,770 --> 00:04:34,680
،ما لم تريدوا أن تتحسّروا

38
00:04:34,760 --> 00:04:36,600
توقّفوا ولا تفعلوا شيئاً من الآن فصاعِداً

39
00:04:39,640 --> 00:04:42,970
إن لم نفعل شيئاً، سننجو ...؟

40
00:04:43,380 --> 00:04:44,130
...نعم

41
00:04:44,630 --> 00:04:47,250
لم تعودوا بحاجةٍ للخوفِ من الموت أو التحمُّل بعد الآن

42
00:04:47,420 --> 00:04:49,000
ستدخلون حلماً

43
00:04:57,830 --> 00:04:59,030
!لا تستسلِموا

44
00:05:00,120 --> 00:05:03,070
إن استسلمتُم لغينجيتسو، فأنتم كالأموات

45
00:05:07,400 --> 00:05:11,230
...هذه الشجرةُ العُملاقة مُتّصِلة بأوبيتو بشكل وثيق

46
00:05:11,520 --> 00:05:14,100
إنَّها أشبه بأطراف تمتصُّ التشاكرا

47
00:05:14,180 --> 00:05:16,390
لا ينبغي أن نقتربَ بتهوُّر

48
00:05:16,640 --> 00:05:18,560
يا لها من كلِمات ضعف

49
00:05:19,390 --> 00:05:20,970
هذا ليسَ من طِباعك

50
00:05:22,600 --> 00:05:24,340
...ساروتوبي سينسي

51
00:05:25,050 --> 00:05:26,130
.. أوروتشيمارو

52
00:05:26,800 --> 00:05:28,590
تأخَّرتُم

53
00:05:28,670 --> 00:05:30,380
ماذا عن الكاغيين الخمسة؟

54
00:05:30,710 --> 00:05:32,500
لقد شفيتُهم

55
00:05:32,800 --> 00:05:36,040
لِذا ينبغي أن يصِلوا قريباً إلَّا إن كانوا خائفين

56
00:05:37,240 --> 00:05:39,620
طبعُك متهكّم كعادتك

57
00:05:41,540 --> 00:05:43,610
آسِف لتأخُّري، جوغو، ساسكي

58
00:05:44,480 --> 00:05:45,360
...أراك هُنا

59
00:05:51,070 --> 00:05:54,850
هذه الشجرةُ عُملاقةٌ حقاً عن كثب

60
00:05:55,310 --> 00:05:58,600
!كم ستستغرق لنقطّعها؟

61
00:05:58,680 --> 00:06:00,930
من يهتمّ بذلك الآن!؟

62
00:06:01,180 --> 00:06:02,600
...المهمُّ الآن

63
00:06:03,170 --> 00:06:08,010
هو الذهابُ إلى ساسكي وحضنه ولعقه

64
00:06:08,420 --> 00:06:10,210
شِفاء قوَّات حلف الشينوبي، صحيح؟

65
00:06:11,710 --> 00:06:15,540
نعم، أعلمُ ذلك، تباً

66
00:06:25,530 --> 00:06:27,400
يبدو بمزاجٍ سيّئ

67
00:06:30,030 --> 00:06:31,070
ما الذي يجري؟

68
00:06:32,440 --> 00:06:36,730
عندما تتفتّحُ تِلك البُرعمة، ستكتمل التسوكويومي اللّامحدودة

69
00:06:36,810 --> 00:06:38,270
هذا ما قالَه مادارا

70
00:06:38,480 --> 00:06:42,430
ومع ذلك، بعدَ استنزاف التشاكرا من هذا العدد الكبير من النِّينجا

71
00:06:42,810 --> 00:06:44,840
لا تُوحي تِلك البرعمة بأنَّها ستتفتَّح

72
00:06:50,920 --> 00:06:52,800
متى ستتفتّحُ إذاً؟

73
00:06:55,580 --> 00:06:58,910
الهاتشيبي والكيوبي ما زالا على قيد الحياة

74
00:06:59,210 --> 00:07:00,160
هل فهمت؟

75
00:07:02,860 --> 00:07:07,490
إذاً تشاكرا الكيوبي والهاتشيبي جوهريّة

76
00:07:07,570 --> 00:07:10,360
لاستكمالِ التقنيّة

77
00:07:15,520 --> 00:07:18,980
،ولكن، إذا احتوَتْ حتّى على مقدارٍ ضئيل من التشاكرا من كِليهما

78
00:07:19,060 --> 00:07:20,140
فلا مُشكِلة

79
00:07:21,230 --> 00:07:24,930
بعبارة أُخرى، ليسَتْ لأنَّها عاجِزة عن التفتُّح

80
00:07:27,050 --> 00:07:28,050
...إنَّما كلّ ما يتأثَّر

81
00:07:28,130 --> 00:07:30,180
هو ما يستغرِق لتفتّحها

82
00:07:30,720 --> 00:07:33,670
بقي هُناك حوالي 15 دقيقة

83
00:07:34,620 --> 00:07:37,250
خلالَ تِلك الفترة، سأُوقِفُ أوبيتو ونتبادل المكان

84
00:07:37,540 --> 00:07:40,750
باستخدامِ قوّتِك، قوّة الناسك

85
00:07:43,850 --> 00:07:44,980
هذا سيّئ

86
00:07:45,650 --> 00:07:50,020
يجبُ أن أنقلَ كلّ ما سمِعه الأصليّ منّي إلى قوّات الحلف

87
00:07:51,940 --> 00:07:54,140
هل ينتمي أحدٌ هُنا إلى عشيرةِ ياماناكا!؟

88
00:07:55,340 --> 00:07:55,890
أنا

89
00:07:56,390 --> 00:07:58,220
هل يمكنُكِ أداء تقنيّة التّراسُل الذهنيّ؟

90
00:07:58,590 --> 00:08:00,050
نعم، أستطيع سيّدي

91
00:08:00,510 --> 00:08:02,750
جيّد! صِليني إذاً بجميعِ الحاضرين هُنا

92
00:08:03,630 --> 00:08:05,670
ثمّة أمور أودُّ شرحها عن تِلك الشجرةِ العُملاقة

93
00:08:05,750 --> 00:08:07,290
وتسوكويومي اللّامحدودة

94
00:08:11,710 --> 00:08:12,490
...هذا الإحساس

95
00:08:15,620 --> 00:08:16,490
جدِّي

96
00:08:17,200 --> 00:08:18,570
أهذه أنتِ يا تسونا؟

97
00:08:19,700 --> 00:08:23,110
هذا صوتُ هاشيراما-ساما بلا شكّ

98
00:08:24,860 --> 00:08:27,230
هذا يعني بأنَّ الكاغيين الخمسة قريبين بما يكفي

99
00:08:27,310 --> 00:08:29,770
ليكونوا ضمن نِطاق تقنيّتي

100
00:08:30,730 --> 00:08:33,550
أجِّلوا التذكُّر والكلام لوقتٍ لاحق

101
00:08:33,680 --> 00:08:37,350
في جُعبتي كلام يجبُ أن أنقلَه إليكم أنتُم الخمسة وللجميع

102
00:08:38,010 --> 00:08:39,470
اسمعوني جيِّداً

103
00:08:43,790 --> 00:08:46,540
سأستردُّ مزيداً من التشاكرا

104
00:08:47,210 --> 00:08:49,590
إنَّها تستغرقُ وقتاً طويلاً كي تتفتَّح

105
00:08:51,540 --> 00:08:55,030
إذاً نحنُ مجرَّد غِذاء لتِلك الشجرة؟

106
00:08:56,450 --> 00:08:58,830
!أهذه هي حقيقة الشينوبي؟

107
00:08:59,580 --> 00:09:01,620
إذاً .. كيفَ يُفترَضُ بِنا أن نُقاتلَها؟

108
00:09:01,660 --> 00:09:05,190
بقي 15 دقيقة فقط، هذا جنون

109
00:09:05,570 --> 00:09:07,020
لا يمكنُنا حتَّى الاقتراب منها

110
00:09:08,320 --> 00:09:10,900
ومع ذلك، عدمُ القيام بشيء سيؤدِّي إلى نفس النَّتيجة

111
00:09:11,970 --> 00:09:14,220
يجبُ علينا إمَّا قطع تِلك الشجرة

112
00:09:14,310 --> 00:09:15,890
أو هزيمة المُستخدِم ضمن الوقت المُتبقِّي

113
00:09:16,810 --> 00:09:17,720
...ولكن

114
00:09:19,140 --> 00:09:21,390
قلتُ لكم ألَّا تفقدوا الأمل

115
00:09:40,240 --> 00:09:41,290
...تقولُ ذلك

116
00:09:41,410 --> 00:09:43,570
لكنّك شخص خاضع للإيدو تينسين في الماضي

117
00:09:43,780 --> 00:09:45,940
جُلِبَ للحياة

118
00:09:46,320 --> 00:09:47,730
ما زلنا على قيدِ الحياة

119
00:09:53,140 --> 00:09:54,270
انتهى... كلّ شيء

120
00:09:54,970 --> 00:09:56,140
لو كنَّا نعلمُ أنَّه سينتهي هكذا

121
00:09:56,220 --> 00:09:57,600
لما فعلنا شيئاً من الأساس

122
00:10:02,510 --> 00:10:05,090
هذا صحيح. ابقوا هكذا فحسب

123
00:10:05,510 --> 00:10:08,380
سآخذُكم إلى عالم خالٍ من الحسرة

124
00:10:25,360 --> 00:10:28,030
ناروتو، هل انتهيت؟

125
00:10:28,650 --> 00:10:29,530
لأنَّني لم أستسلم

126
00:10:37,390 --> 00:10:38,560
هيّا بنا يا جوغو

127
00:10:38,770 --> 00:10:39,390
...نعم

128
00:10:47,470 --> 00:10:48,420
...هذه

129
00:10:48,800 --> 00:10:52,460
...إنِّي أحسُّ بها، هذه مشاعرُ ناروتو

130
00:10:52,750 --> 00:10:54,460
تفيض عبر تقنيّتي

131
00:11:08,740 --> 00:11:09,650
...وقتذاك

132
00:11:11,360 --> 00:11:14,480
عرفتُ أنَّه كانَ ينبغي عليّ أن أصيحَ له

133
00:11:15,310 --> 00:11:17,520
فكّرتُ في الأمرِ مراراً وتكراراً بعدَ ذلك

134
00:11:22,380 --> 00:11:24,090
أفكارُه تتدفَّق

135
00:11:26,430 --> 00:11:27,510
...لِهذا السّبب

136
00:11:34,750 --> 00:11:35,420
...هذا

137
00:11:42,610 --> 00:11:43,740
...من ذلك اليوم

138
00:12:15,290 --> 00:12:16,420
...أنا

139
00:12:44,050 --> 00:12:45,010
...أنا

140
00:12:52,000 --> 00:12:54,210
لا أريد أن أندمَ على شيء

141
00:12:58,250 --> 00:13:00,630
"...لا أريد أبداً أن أقول "كان ينبغي لي أن

142
00:13:01,710 --> 00:13:02,490
...ناروتو

143
00:13:14,440 --> 00:13:16,360
...و

144
00:13:16,570 --> 00:13:19,110
...لا أريدُ أن أجعلَ كلّ شيء فعلناه

145
00:13:23,220 --> 00:13:25,890
حتَّى هذه اللَّحظة يذهبُ سُدى

146
00:13:29,880 --> 00:13:30,970
ساسكي

147
00:13:30,970 --> 00:13:32,330
أنا قادِمٌ أيضاً

148
00:13:39,750 --> 00:13:41,000
...ناروتو أوزوماكي

149
00:13:41,820 --> 00:13:43,490
...مراراً وتكراراً

150
00:13:56,390 --> 00:13:59,890
آسِف لاضطراري استعارة المَزيد من التشاكرا

151
00:13:59,940 --> 00:14:01,310
لا تقلق

152
00:14:02,220 --> 00:14:03,510
ناروتو، نعتمدُ عليك

153
00:14:07,720 --> 00:14:08,630
...ساسكي

154
00:14:09,010 --> 00:14:12,580
تدركُ أنَّه لا يؤثِّر به إلَّا تقنيّة الناسك، صحيح؟

155
00:14:13,250 --> 00:14:15,870
لا تُقارني بك

156
00:14:28,320 --> 00:14:29,160
...انظري يا كارين

157
00:14:29,990 --> 00:14:32,310
أليسَتْ هذه ...علامة لعنة ساسكي؟

158
00:14:32,940 --> 00:14:34,980
...ينبغي أن تكونَ العلامة قد فقدَتْ قوّتَها

159
00:14:35,810 --> 00:14:39,270
قوّةُ الناسك هي مصدرُ علامة لعنة جوغو

160
00:14:39,770 --> 00:14:41,060
ومع ساسكي

161
00:14:41,150 --> 00:14:44,890
في ذلك الوقت عندما طبّقتُ تجربةَ حقنه بتشاكرا جوغو

162
00:14:44,970 --> 00:14:47,970
قامَ بتحريرِ علامة اللّعنة فوراً

163
00:14:48,680 --> 00:14:51,590
لذا ليس من الغريب أن يتكيّف سوسانو الخاص بساسكي

164
00:14:51,670 --> 00:14:55,500
مع تشاكرا جوغو بنفس الطّريقة

165
00:14:56,130 --> 00:14:59,790
بعبارة أُخرى، يمكنُ أن نطلقَ عليها بتقنيّة سوسانو الناسك

166
00:15:00,710 --> 00:15:02,160
ساسكي أوتشيها؟

167
00:15:02,870 --> 00:15:05,410
...يُبرِزُ نفس الإمكانيات الّتي كانَ يتمتّعُ بها مادارا

168
00:15:05,820 --> 00:15:07,280
...يا لها من عشيرة

169
00:15:07,950 --> 00:15:09,740
.. أودُّ الذهاب إلى هُناك أيضاً

170
00:15:10,070 --> 00:15:11,450
ستُعرقلينه فقط

171
00:15:11,530 --> 00:15:12,610
ستُطعَنين مجدداً

172
00:15:12,690 --> 00:15:13,230
وغد

173
00:15:15,110 --> 00:15:16,940
...وساسكي

174
00:15:17,110 --> 00:15:20,440
...بخلافِ هذين الاثنين اللّذين في الخلف، قوّتك

175
00:15:20,900 --> 00:15:24,220
...بالأحرى، بخلافِ أي تجربة من تجاربي

176
00:15:24,300 --> 00:15:26,890
...قوّتُك ليسَتْ كقوّتهم

177
00:15:26,890 --> 00:15:28,800
...هذا واضِح

178
00:15:29,140 --> 00:15:33,380
...من خِلال أبحاثي الطّويلة والبيانات الّتي جمعتُها

179
00:15:33,460 --> 00:15:35,630
...تقولُ لي فطرتي

180
00:15:36,540 --> 00:15:41,040
بأنَّك ستُصبِحُ شينوبي يتفوّقُ على مادارا يوماً ما

181
00:15:42,370 --> 00:15:44,280
...ناروتو أوزوماكي

182
00:15:44,870 --> 00:15:46,410
...تذكّرُني كثيراً بأخي الكبير

183
00:15:46,490 --> 00:15:47,370
عندما كانَ شابّاً

184
00:15:48,410 --> 00:15:51,900
إنّه طفلٌ أحمق يتبجّح بالمثاليّات بأعلى صوته

185
00:15:52,520 --> 00:15:56,610
ومع ذلك، يحبُّك الجميع ويعتمدون عليك في كلّ شيء

186
00:15:58,440 --> 00:15:59,020
صوِّب

187
00:15:59,110 --> 00:15:59,940
حسناً

188
00:16:00,020 --> 00:16:01,680
سيكونُ الأوانُ قد فاتَ على النَّدم

189
00:16:01,760 --> 00:16:04,470
لن يكونَ هُناك أيّ مُستقبل لكليكما

190
00:16:08,430 --> 00:16:11,060
!هل انطلقا لمُقاتلته حقّاً؟

191
00:16:11,140 --> 00:16:12,710
نعم .. ماذا ينبغي أن نفعلَ نحن إذاً؟

192
00:16:13,210 --> 00:16:15,630
يمكننا أن نسأل... عندما يصلُ الكاغي الخمسة إلى هنا

193
00:16:15,880 --> 00:16:17,340
هل هذا يكفي؟

194
00:16:21,830 --> 00:16:23,910
...أتطلّعُ قُدماً للمعاركِ الّتي سنخوضُها

195
00:16:25,120 --> 00:16:27,240
إلى أن يأتي الوقت الّذي أحقِّقُ فيه حلمي الحقيقيّ

196
00:16:27,740 --> 00:16:29,580
ما هو حلمك الحقيقيّ؟

197
00:16:29,740 --> 00:16:32,820
ظننتُ أنَّ كلّ ما نطمحُ إليه موجودٌ هُنا في هذه القرية

198
00:16:33,820 --> 00:16:35,530
أنتَ لا تراهُ فحسب

199
00:16:36,530 --> 00:16:39,780
ما يقَع في مسافاتٍ أبعد... أحلام المستقبل البعيد

200
00:16:41,230 --> 00:16:43,970
حدّثْني عن أحلامِ مُستقبلك البعيد إذاً

201
00:16:44,720 --> 00:16:47,390
أهذه هي ذكرياتُ الأوّل؟

202
00:16:47,520 --> 00:16:48,680
نار

203
00:16:48,770 --> 00:16:50,350
أحلام المُستقبل
نار برق

204
00:16:50,600 --> 00:16:52,550
نار برق رياح

205
00:16:52,630 --> 00:16:53,760
نار برق رياح أرض

206
00:16:53,840 --> 00:16:59,050
نار برق رياح أرض ماء

207
00:16:59,760 --> 00:17:03,250
...مجرّد استطاعتنا بعقدِ قمّة للكاغي الخمسة

208
00:17:03,330 --> 00:17:05,620
بحضورِ الكاغي الأوَّل لكلّ دولة من الدُّول الخمسة

209
00:17:05,620 --> 00:17:07,200
...تغمرني

210
00:17:12,820 --> 00:17:14,030
امتناناً

211
00:17:17,280 --> 00:17:18,110
أخي الكبير

212
00:17:18,190 --> 00:17:20,650
أنتَ الهوكاغي والّذي يُمثِّلُ كونوها بلاد النار

213
00:17:20,650 --> 00:17:23,640
لا ينبغي لشخص مثلك أن ينحني لكاغي آخر

214
00:17:25,270 --> 00:17:26,770
ولكن .. أنا سعيدٌ جدّاً

215
00:17:31,590 --> 00:17:35,260
...هذا لا يصدُر عن قائد قرية

216
00:17:36,090 --> 00:17:42,330
أتيتُ إلى هُنا لأدعم فكرة ميثاق الهوكاغي-ساما

217
00:17:42,660 --> 00:17:44,750
لكنّني لن أُوقِّعَ شيئاً بالمجَّان

218
00:17:45,750 --> 00:17:50,210
إذا تصرَّفتَ بتواضُعٍ كبير، فستجعلُنا نرتابُ في الأمر

219
00:17:51,290 --> 00:17:54,320
...توزيع البيجو التي جمعها الهوكاغي-ساما

220
00:17:54,400 --> 00:17:55,610
على القُرى الأخرى

221
00:17:55,700 --> 00:17:58,070
هو شرطُ توقيع المُعاهدة

222
00:17:58,860 --> 00:18:02,310
هذه صفَقة، ليسَتْ يدعو للتعاطف

223
00:18:03,140 --> 00:18:06,690
تماماً، سنُخصِّصُ البيجو استناداً إلى القوّة

224
00:18:06,770 --> 00:18:08,600
ولكن ستحصلون عليها مُقابِل ثمن

225
00:18:09,640 --> 00:18:10,520
ليسَ مجّاناً؟

226
00:18:10,690 --> 00:18:11,760
اصمُت

227
00:18:16,630 --> 00:18:18,300
كان هذا أوّل اجتماع قمّة

228
00:18:18,760 --> 00:18:23,040
نعم، وقد أدَّى ذلك الاجتماع لإنهاءِ الصِّراعات الصّغيرة

229
00:18:33,860 --> 00:18:35,820
في قريتِنا، عدد من أتباع معبَد معيَّن

230
00:18:35,910 --> 00:18:39,570
ساهموا في الختمِ على بيجو

231
00:18:39,780 --> 00:18:43,310
بما أنَّنا لدينا بيجو، فلا نحتاجُ لآخر

232
00:18:44,770 --> 00:18:47,850
بل نريدُ تعويضاً بديلاً عن ذلك

233
00:18:47,940 --> 00:18:49,940
لإثباتِ تعاوننا في هذا الميثاق

234
00:18:50,020 --> 00:18:51,470
هل تُوافِقون؟

235
00:18:52,590 --> 00:18:53,720
ما هي رغبتُك؟

236
00:18:54,430 --> 00:18:56,640
تغطِّي الرِّمالُ دولتَنا بالكامل

237
00:18:57,390 --> 00:18:59,430
وبالتّالي نطلبُ من كونوها المُجاورة

238
00:18:59,510 --> 00:19:02,630
أن تشاطرَنا أرضاً صالِحة للزِراعة بدلاً من بيجو

239
00:19:03,080 --> 00:19:05,080
...وأن تسلِّمَنا الدُّول الأخرى أكثر من ثلاثين بالمئة

240
00:19:05,170 --> 00:19:08,130
من ثمنِ البيجو خاصّتكم كذلك

241
00:19:08,580 --> 00:19:10,130
لا تعبثْ معنا أيُّها الكازيكاغي

242
00:19:10,210 --> 00:19:10,790
!ماذا؟

243
00:19:11,330 --> 00:19:12,820
أنتَ تتعدَّى حدودك، كازيكاغي-ساما

244
00:19:13,450 --> 00:19:17,870
لن أوقِّعَ ما لم تقبلوا جميعاً بهذه الشُّروط

245
00:19:18,570 --> 00:19:21,480
أرضي صحراءٌ مُقفرة خصوبتُها معدومة

246
00:19:21,480 --> 00:19:25,520
من الطبيعيّ جداً أن أستخدمَ البيجو الخاصّ بنا أحسن استخدام

247
00:19:25,520 --> 00:19:28,520
في التَّعامُلِ مع الدُّول العظيمة الأربع الأخرى

248
00:19:28,610 --> 00:19:30,560
...بمقدورِنا نحنُ الدُّول الأربع أن نتحالف

249
00:19:30,650 --> 00:19:33,390
ونهزم بلاد الرّياح

250
00:19:49,840 --> 00:19:53,450
...صحيحٌ أنَّنا لم تكُن علاقتنا جيّدة في الماضي

251
00:19:54,200 --> 00:19:58,620
ولكن كلّ منّا قد فعلَ ما فعلَه لحمايةِ إخوتنا وعشائرنا

252
00:19:59,330 --> 00:20:01,610
وربَّما اصطدَمنا بأوقاتٍ لم يكُن فيها أمامنا أيّ خيار

253
00:20:02,730 --> 00:20:06,320
...واليوم، حتَّى رُغمَ توقيع مُعاهدة الدُّول الخمس

254
00:20:06,570 --> 00:20:08,690
...لا أعرِف كم من الوقتِ ستدوم

255
00:20:08,770 --> 00:20:11,560
أو حتَّى فيما إن كنّا قادرين على إتمامِها

256
00:20:13,100 --> 00:20:15,510
ولكن حلُمي هو

257
00:20:15,600 --> 00:20:18,100
...أن يأتي وقتٌ ما في المُستقبل

258
00:20:18,180 --> 00:20:21,300
أن يأتي يوم يتعاونُ فيه الشينوبي جميعهم

259
00:20:21,380 --> 00:20:24,300
ويُساعدون بعضَهم الآخر وبقلبٍ واحد بصرفِ النَّظر عن انتماءاتهم

260
00:20:25,550 --> 00:20:27,550
...هذا

261
00:20:27,550 --> 00:20:29,340
حلمي في المستقبل

262
00:20:34,370 --> 00:20:38,080
أطلبُ منكم أن تتّخذوا الخطوةَ الأولى تجاه ذلك الحلم اليوم

263
00:20:38,870 --> 00:20:43,820
...لِذا أرجوكم، أرجوكم، أرجوكم

264
00:20:44,230 --> 00:20:45,400
أتوسَّلُ إليكم

265
00:20:45,480 --> 00:20:48,400
يا أبنائي الأحبّاء

266
00:20:49,650 --> 00:20:51,600
حانَ الوقتُ لتحمُّل كلّ الآلام

267
00:20:51,680 --> 00:20:55,970
...والمُعاناة والإحباط الّذي تحمّلَناهُ نحنُ الشينوبي

268
00:20:56,350 --> 00:20:58,060
...وننسجُ من تِلك الآلام

269
00:20:58,390 --> 00:21:00,310
حلمَنا الحقيقيّ

270
00:22:38,980 --> 00:22:42,220
ماضيك يتجلَّى لي من خلال الآخرين

271
00:22:42,810 --> 00:22:47,180
ناروتو أوزوماكي، ها أنتَ توحِّدُ الجميعَ الآن

272
00:22:47,600 --> 00:22:51,550
حياتُك المضطربة صنعَتْ منك ما أنتَ عليه الآن

273
00:22:51,840 --> 00:22:55,840
ومنهجُ حياتِك قد دسَّ الأملَ في قلوب الجميع

274
00:22:56,710 --> 00:23:00,670
:الحلقة القادمة من ناروتو شيبودن
"السّعي وراء الأمل"

275
00:23:01,090 --> 00:23:03,790
هيّا بنا، لنقطع تِلك الشجرة