1
00:00:13,230 --> 00:00:14,230
حسناً

2
00:00:14,300 --> 00:00:17,100
ابتداء من الآن، مهمّتنا الرئيسيّة هي إيجاد إيتاتشي

3
00:00:17,130 --> 00:00:19,130
والعمل على اعتقاله

4
00:00:19,400 --> 00:00:20,300
!نعم -
!نعم -

5
00:00:21,030 --> 00:00:23,270
هدفُ الأكاتسكي هو جمع البيجو

6
00:00:23,430 --> 00:00:25,800
يُعتقَد أنّهم قبضوا على السانبي بالفعل

7
00:00:26,700 --> 00:00:28,630
،وفقاً للبيانات التي حصل عليها جيرايا

8
00:00:28,670 --> 00:00:33,200
من المُحتمَل أن يكونوا قد اخترقوا
بلاد النّار وسيستهدفون ناروتو

9
00:00:34,930 --> 00:00:37,530
إيتاتشي، بالتّحديد، هو من قرية
الورق المخفيّة أصلاً

10
00:00:38,000 --> 00:00:40,030
منذُ ثلاث سنوات، عاد إلى القرية

11
00:00:40,070 --> 00:00:41,930
وحاول أخذ ناروتو

12
00:00:42,330 --> 00:00:46,200
هل هو متوجّه إلى قرية الورق مجدّداً إذاً؟

13
00:00:46,800 --> 00:00:49,900
!وكذلك ساسكي الذي يستهدفُ إيتاتشي أوتشيها هذا

14
00:00:50,400 --> 00:00:51,400
!حسناً

15
00:00:51,700 --> 00:00:54,530
سألتقي بساسكي مهما كلّف الأمر

16
00:00:55,970 --> 00:00:59,430
حسناً، دعونا نخطو خطوة بخطوة

17
00:01:01,000 --> 00:01:02,530
إليكم خطّة البحث

18
00:01:03,470 --> 00:01:05,970
،باستخدام هذه كنقطة مركزيّة

19
00:01:06,000 --> 00:01:08,170
سنبحث في الاتّجاهات الأربعة لمسافة 5 كيلومتر

20
00:01:09,200 --> 00:01:10,470
،إن لم نعثر على شيء

21
00:01:10,500 --> 00:01:14,500
سننقلُ النقطة المركزيّة وننتشر
خمسة كيلومترات أخرى من هناك

22
00:01:15,300 --> 00:01:17,600
وسنكرّر هذه الاستراتيجيّة

23
00:01:17,930 --> 00:01:22,600
!خمسة كيلومتر... أجهزتنا اللّاسلكيّة لن تغطّي هذا النّطاق

24
00:01:22,800 --> 00:01:26,230
!إذا افترقنا فسيغدو الأمر خطيراً

25
00:01:26,430 --> 00:01:29,700
وتنصُّ القواعد على أنّ كافّة الدوريّات
مؤلّفة من فريق قوامه شخصان

26
00:01:29,870 --> 00:01:31,670
...إذا التقينا بالعدو -
...ساكورا -

27
00:01:31,800 --> 00:01:32,930
لا تقلقي كثيراً

28
00:01:33,600 --> 00:01:35,130
...راقبي فحسب

29
00:01:45,000 --> 00:01:48,470
أصواتنا التي تنتقلُ لمسافةٍ أبعد
حتّى ممّا تبلغه الأجهزة اللاسلكيّة

30
00:01:48,900 --> 00:01:52,100
وأنوفنا التي سُرعان ما تشتمّ الخطر، ستحميكم

31
00:01:52,500 --> 00:01:53,330
!باكّون

32
00:01:54,130 --> 00:01:57,300
حسناً، دعوني أشرح تشكيل فريق الدوريّة

33
00:01:58,230 --> 00:02:01,600
هذه المرّة، سيُرافِق كلّ عضو كلبا صيد نينجا

34
00:02:01,970 --> 00:02:04,230
...كلبان...؟ لكن

35
00:02:05,130 --> 00:02:07,500
انسجموا معاً جميعاً

36
00:02:08,730 --> 00:02:10,500
مرحباً يا ساكورا

37
00:02:10,830 --> 00:02:13,670
فتاة سريعة الانفعال كعادتكِ

38
00:02:15,870 --> 00:02:17,970
سأرافق شينو

39
00:02:18,300 --> 00:02:20,700
رائحتك رائحة حشرات كريهة

40
00:02:21,800 --> 00:02:22,770
رائحتك رائحة كلب

41
00:02:23,600 --> 00:02:24,500
مرحباً

42
00:02:24,900 --> 00:02:27,130
...لنتعاون معاً

43
00:02:27,370 --> 00:02:30,230
...بسلام وتناغُم

44
00:02:31,170 --> 00:02:33,930
أتساءل ما إن كان بمقدوري... أن أصبح صديقاً للكلاب

45
00:02:34,530 --> 00:02:35,870
ماذا عنّي؟

46
00:02:36,470 --> 00:02:38,530
ناروتو، أنت الجينتشوريكي الذي يستهدفونه

47
00:02:39,170 --> 00:02:41,270
،في حال تعرّضتَ لهجوم

48
00:02:41,300 --> 00:02:44,300
ستكونُ مع ياماتو والكشّافة الحسّية هيناتا

49
00:02:44,730 --> 00:02:46,970
والبُلدُغ النبَّاح الكبير

50
00:02:49,200 --> 00:02:51,630
لـ-لنتعاون معاً يا ناروتو

51
00:02:52,070 --> 00:02:52,870
!نعم

52
00:02:53,530 --> 00:02:57,000
وباعتبارنا مُستخدما كِلاب نينجا
سيرافقُني أنا وكيبا كلبٌ واحدٌ لكلّ منّا

53
00:02:57,570 --> 00:02:59,630
!كلّنا جاهزون إذاً

54
00:03:00,500 --> 00:03:01,430
اسمعوا يا رفاق

55
00:03:01,830 --> 00:03:05,330
قبل كلّ شيء، ستتعقّبون رائحة إيتاتشي وساسكي

56
00:03:05,670 --> 00:03:08,370
،إن عثرتُم على أي منهما

57
00:03:12,430 --> 00:03:14,800
خاصّة أنت يا ناروتو، لا تسبقنا وتبتعد عنّا

58
00:03:15,530 --> 00:03:16,970
عُلِم

59
00:03:17,800 --> 00:03:19,730
حسناً إذاً، لننطلق

60
00:03:22,300 --> 00:03:23,100
!تفرّقوا

61
00:04:55,400 --> 00:04:59,950
الصّيد

62
00:05:01,870 --> 00:05:03,530
سأذهب

63
00:05:04,200 --> 00:05:07,300
إيتاتشي أوتشيها؟ آمل أن نستطيع إيجاده

64
00:05:10,670 --> 00:05:11,630
!حسناً

65
00:05:12,000 --> 00:05:13,770
!سا-س-كي

66
00:05:14,070 --> 00:05:16,930
!سأبقى معك

67
00:05:17,000 --> 00:05:18,630
أنتِ أيضاً، تحرّكي

68
00:05:21,700 --> 00:05:22,470
!تبّاً

69
00:05:45,300 --> 00:05:47,070
...شُفيَتْ تماماً

70
00:05:47,270 --> 00:05:48,000
نعم

71
00:05:48,070 --> 00:05:50,370
والآن؟ من سنستهدف؟

72
00:05:50,430 --> 00:05:51,800
ساسكي أم الكيوبي؟

73
00:05:52,600 --> 00:05:55,630
لنرَ، من منهما...؟

74
00:05:57,330 --> 00:06:01,000
!ا-ا-انتظر، د-ديدارا سينباي

75
00:06:01,170 --> 00:06:03,200
!انتظر

76
00:06:07,330 --> 00:06:11,200
مكتب رهونات

77
00:06:14,700 --> 00:06:16,130
!من أنت؟

78
00:06:21,100 --> 00:06:23,200
أظنُّ أنّ الأتباع غير مهمّين

79
00:06:32,500 --> 00:06:33,630
اذهب وتفقّد

80
00:06:33,830 --> 00:06:34,730
حاضر

81
00:06:40,600 --> 00:06:42,530
!من أنت؟

82
00:06:51,700 --> 00:06:55,730
أنت ذلك الأكاتسكي... ما اسمه؟

83
00:06:56,170 --> 00:06:59,970
...كاكو... كاكوتا... كاكوسا... كاكوشي

84
00:07:00,070 --> 00:07:01,670
...كـ-كاكوزو

85
00:07:01,830 --> 00:07:03,500
نعم، أنت هو

86
00:07:03,670 --> 00:07:07,770
أنتَ رجلُ كاكوزو ومسؤول حساباته، صحيح؟

87
00:07:09,270 --> 00:07:11,330
سأخبرك بأي شيء تريد معرفته

88
00:07:11,670 --> 00:07:13,400
...المهمّ ألّا تقتلني

89
00:07:14,570 --> 00:07:16,770
هكذا أريدك، تابع كلامك

90
00:07:29,400 --> 00:07:30,570
...أودّ أن أسألكم

91
00:07:39,730 --> 00:07:42,700
!أكامارو! لا تخسر أمام كلاب النّينجا الآخرين

92
00:07:43,170 --> 00:07:46,830
!ستكون أوّل من يكشف رائحة ساسكي وإيتاتشي

93
00:07:49,900 --> 00:07:51,230
!أنتَ بطيء جدّاً يا شينو

94
00:07:51,330 --> 00:07:52,970
!لا تتراخَ

95
00:07:53,800 --> 00:07:55,270
...لا أحبّهما

96
00:07:56,900 --> 00:07:58,770
هيّا بنا يا بّوتشي وتاما

97
00:07:59,100 --> 00:08:00,100
بّوتشي...؟

98
00:08:00,470 --> 00:08:01,730
!تاما؟

99
00:08:02,500 --> 00:08:05,000
لا تلقّبني بألقاب سخيفة

100
00:08:27,100 --> 00:08:28,300
...ساسكي

101
00:08:39,370 --> 00:08:41,970
،إن لم تمسحي تِلك النّظرة الصّارمة عن وجهك

102
00:08:42,000 --> 00:08:43,930
ستُخيفين الفتيان

103
00:08:44,130 --> 00:08:45,170
ماذا؟

104
00:08:45,470 --> 00:08:47,900
كلّما لحقتِ بهم، هربوا وابتعدوا أكثر

105
00:08:48,130 --> 00:08:50,630
أنتِ تضغطين على الطرف الآخر دوماً، أليس كذلك؟

106
00:08:50,930 --> 00:08:52,800
لِمَ لا تُحاولين التّراجع كنوع من التّغيير؟

107
00:08:53,070 --> 00:08:54,770
!ما هذا الكلام؟

108
00:08:57,270 --> 00:08:59,230
...ساسكي وأنا

109
00:09:00,000 --> 00:09:01,430
...لسنا كذلك

110
00:09:01,800 --> 00:09:04,570
كفاك وقاحة

111
00:09:06,300 --> 00:09:09,330
...كلّ ما في الأمر أنّني أريدُ أن يعلم ساسكي

112
00:09:09,630 --> 00:09:12,900
بشعوري... بشعور الجميع

113
00:09:13,470 --> 00:09:16,800
الجميع ينتظرون عودة ساسكي إلى الدّيار

114
00:09:17,930 --> 00:09:19,430
...هذا كلّ شيء

115
00:09:20,670 --> 00:09:24,770
جيّد. حسناً، إذا كان التّراجع لا ينفع
لِمَ لا أحاول الاشتمام؟

116
00:09:27,970 --> 00:09:28,870
!ما الأمر؟

117
00:09:30,100 --> 00:09:32,900
...اشتممتُ نفحةً من رائحة ساسكي أوتشيها

118
00:09:33,430 --> 00:09:34,370
!ماذا؟

119
00:09:44,470 --> 00:09:45,230
حسناً؟

120
00:09:45,300 --> 00:09:49,430
الرّائحة ضعيفة، لكنّها تقترب تدريجيّاً

121
00:10:15,270 --> 00:10:19,130
ماذا تفعلين؟! سيجدُنا قبل أن نجده نحن

122
00:10:20,030 --> 00:10:21,130
!علينا أن نتوخّى الحذر

123
00:10:31,830 --> 00:10:32,870
إنّه قريب

124
00:10:36,370 --> 00:10:39,570
ساكورا، هل ترين ساسكي حولنا؟

125
00:11:02,200 --> 00:11:05,230
هذا سيّئ، الرّائحة تبتعد

126
00:11:17,300 --> 00:11:21,270
لقد ألقيتُ نظرة سريعة، لكن لا أحسّ
بأي تشاكرا

127
00:11:22,870 --> 00:11:25,670
قد أعود إلى ساسكي

128
00:11:25,800 --> 00:11:28,400
لم يعُد الآخران على الأرجح بعد

129
00:11:43,970 --> 00:11:45,430
!وجدتُه يا توبي

130
00:11:45,600 --> 00:11:46,300
!نعم

131
00:11:46,600 --> 00:11:48,530
!معقول؟! كان ذلك سريعاً

132
00:11:48,600 --> 00:11:51,630
والآن؟ أيّهما؟ الكيوبي أم ساسكي؟

133
00:11:52,500 --> 00:11:56,030
يا لها من فرصة. سنذهب سوية يا توبي

134
00:11:56,400 --> 00:11:57,830
حسناً... أيّهما؟

135
00:11:59,270 --> 00:12:00,330
!اتبعني فحسب

136
00:12:00,500 --> 00:12:01,270
حاضر

137
00:12:25,530 --> 00:12:29,100
ناروتو... هيناتا... فهمتُما، صحيح؟

138
00:12:29,600 --> 00:12:30,330
نعم

139
00:12:30,470 --> 00:12:31,230
...نعم

140
00:12:37,100 --> 00:12:38,170
...أنت

141
00:12:45,300 --> 00:12:47,800
اكشف عن نفسك... من أنت؟

142
00:12:55,300 --> 00:12:57,300
...وجدتَني إذاً

143
00:12:57,730 --> 00:12:59,000
...كابوتو ياكوشي

144
00:12:59,500 --> 00:13:02,430
تتحلّى بجرأة كافية للتقرّب منّا بمفردك

145
00:13:03,230 --> 00:13:06,000
أردتُ الدردشة مع ناروتو

146
00:13:06,170 --> 00:13:09,030
لن تفلت هذه المرّة، سنعتقلك

147
00:13:09,600 --> 00:13:13,800
!كابوتو! لا بدّ وأنّك تعلم! أين ساسكي؟

148
00:13:15,330 --> 00:13:17,570
أما زلت عاجزاً عن نسيان ساسكي؟

149
00:13:18,270 --> 00:13:21,670
!هل صحيح أنّ ساسكي قتل أوروتشيمارو؟

150
00:13:22,830 --> 00:13:25,230
نعم... صحيح

151
00:13:27,530 --> 00:13:32,500
الأهمّ من هذا، أحضرتُ لك هديّة اليوم

152
00:13:36,970 --> 00:13:39,830
...هذا الزيّ... أنت

153
00:13:40,230 --> 00:13:44,670
!أنت ساسكي إذاً... أنت تشبه إيتاتشي حقّاً

154
00:13:45,770 --> 00:13:46,870
!م-مخيف

155
00:13:53,270 --> 00:13:54,000
!كاتسو -
!كاتسو -

156
00:14:03,430 --> 00:14:04,530
ما هذه؟

157
00:14:05,330 --> 00:14:10,200
معلومات جمعتها منظّمتنا فيما يتعلّق بالأكاتسكي

158
00:14:10,700 --> 00:14:11,900
ما شأنها؟

159
00:14:12,730 --> 00:14:14,930
إنّها لكم، يمكنُكم الحصول عليها

160
00:14:16,730 --> 00:14:18,500
...الآن بعدما توفّي أوروتشيمارو

161
00:14:18,900 --> 00:14:21,530
تحاولُ التّفاوض معنا؟

162
00:14:22,000 --> 00:14:26,470
...لا... لا أعتقد أنّ الأمر بسهولة التّفاوض بشيء كهذا

163
00:14:26,500 --> 00:14:27,930
خاصّة مع قرية الورق المخفيّة

164
00:14:28,130 --> 00:14:29,270
لماذا إذاً؟

165
00:14:30,070 --> 00:14:34,270
الأكاتسكي لا تستهدفك بخلافِ أوروتشيمارو

166
00:14:35,130 --> 00:14:39,370
إنّها هديّة بسيطة لناروتو، رعبون امتناني

167
00:14:39,770 --> 00:14:41,870
بالإضافة إلى أنّ الأكاتسكي تطاردكم

168
00:14:42,500 --> 00:14:43,470
امتنان...؟

169
00:14:44,030 --> 00:14:47,200
،بعد وفاة أوروتشيمارو-ساما

170
00:14:47,830 --> 00:14:50,770
فقدتُ الإحساس بنفسي

171
00:14:51,430 --> 00:14:54,270
لم أعرف أبوَيّ أو وطني قطّ

172
00:14:54,530 --> 00:14:57,630
،عثرَ عليّ العدوّ ومُذ كنتُ صغيراً

173
00:14:57,670 --> 00:15:00,900
تنقّلتُ من بلد إلى أخرى ومن قرية إلى أخرى كجاسوس

174
00:15:01,270 --> 00:15:05,170
لم تكن الأراضي والقرى تعني لي الكثير

175
00:15:05,600 --> 00:15:08,130
...إلى أن بدأتُ أخدم أوروتشيمارو-ساما

176
00:15:08,830 --> 00:15:11,570
لكنّه رحلَ الآن أيضاً

177
00:15:15,000 --> 00:15:19,930
...من أنا بالضبط؟ مُعاناة عدم امتلاك هويّة

178
00:15:19,970 --> 00:15:22,870
أنت تفهمني، أليس كذلك يا ناروتو؟

179
00:15:23,370 --> 00:15:25,470
!مُحال أن أفهم شيئاً من كلامك

180
00:15:26,570 --> 00:15:28,730
أتساءلُ حيال ذلك

181
00:15:29,700 --> 00:15:33,930
هل أنت ناروتو أوزوماكي؟ أم أنّك الكيوبي؟

182
00:15:34,270 --> 00:15:37,330
في الماضي، كان الجميعُ يتحاشاك

183
00:15:37,370 --> 00:15:40,700
لا بدّ وأنّك سألتَ نفسك عن هويّتك الحقيقيّة

184
00:15:42,470 --> 00:15:46,000
لكن، كنتَ تؤمن بقوّتك

185
00:15:46,030 --> 00:15:48,670
...وأقنعتَ نفسك أنّك ناروتو أوزوماكي

186
00:15:48,770 --> 00:15:52,130
وتغلّبتَ بجرأة على وجهاتِ نظرهم عن الكيوبي

187
00:15:54,070 --> 00:15:57,100
ماذا ينوي... أن يفعل مع ناروتو؟

188
00:15:57,400 --> 00:15:59,070
...لا أستطيع معرفة نواياه

189
00:15:59,530 --> 00:16:04,330
ولهذا السّبب أنت متأكّد من هويّتك

190
00:16:04,630 --> 00:16:07,270
وعثرت على أصدقاء يتقبّلونك

191
00:16:07,830 --> 00:16:12,000
،بالمقابل، بدلاً من تغلُّبي على أوروتشيمارو-ساما

192
00:16:12,030 --> 00:16:14,830
تشبّثتُ بقوّته باستماتة

193
00:16:15,370 --> 00:16:18,470
أنا قادرٌ حقّاً على فهم مشاعرك الآن

194
00:16:19,100 --> 00:16:24,770
جعلتَني أدرك... أنّني أريدُ أن أصبح مثلك

195
00:16:25,930 --> 00:16:27,430
...لِذا الآن

196
00:16:33,230 --> 00:16:36,600
،سوف أتفوّق على أوروتشيمارو-ساما الذي امتصصتُه

197
00:16:36,630 --> 00:16:39,030
وأكتشف ذاتاً جديدة أقوى

198
00:16:45,900 --> 00:16:48,130
...سأبحثُ عن ذاتي الجديدة

199
00:16:48,800 --> 00:16:50,670
.وقد منحتَني لمحة لإيجادها

200
00:16:50,930 --> 00:16:53,730
لهذا أنا مُمتنّ... يا ناروتو

201
00:16:55,300 --> 00:16:57,970
أوروتشيمارو-ساما هو رمز التقمُّص

202
00:16:58,270 --> 00:17:02,100
يظلُّ يعيش في داخلي ككائن يجبُ
عليّ أن أتغلّب عليه

203
00:17:02,830 --> 00:17:04,070
دخل... جسدك؟

204
00:17:04,300 --> 00:17:05,330
...حسناً

205
00:17:05,870 --> 00:17:08,430
كانَ جزءاً يسيراً من جثّة أوروتشيمارو-ساما

206
00:17:08,470 --> 00:17:09,930
...بعدما قتلَه ساسكي

207
00:17:09,970 --> 00:17:13,330
زرعتُ ذلك الجزء في جسدي

208
00:17:15,470 --> 00:17:18,970
لكن قوّته الرّوحية مذهلة

209
00:17:19,830 --> 00:17:24,600
يحاول هذا الشّيء الاستحواذ على جسدي بثبات

210
00:17:25,700 --> 00:17:27,000
...هذا هُراء

211
00:17:28,130 --> 00:17:29,930
ما هذا؟

212
00:17:30,830 --> 00:17:31,500
!بياكوغان

213
00:17:33,170 --> 00:17:35,900
لقد تمّ الاستحواذ على ثُلُث جسده

214
00:17:37,430 --> 00:17:41,470
!لكن كنتُ أقاوم هذا الاستحواذ بشراسة

215
00:17:42,500 --> 00:17:46,930
أستطيعُ الشُّعور بهذا الجزء منّي والذي يُحاول
التغلُّب على أوروتشيمارو-ساما

216
00:17:52,270 --> 00:17:54,370
أهذا كُل ما تريد قوله؟

217
00:17:59,630 --> 00:18:01,900
!حسناً، ابذل قصارى جهدك

218
00:18:01,930 --> 00:18:03,730
!في زنزانة السّجن في قرية الورق

219
00:18:10,270 --> 00:18:11,200
!عنصر الخشب

220
00:18:12,330 --> 00:18:13,970
!حسناً! نلنا منك

221
00:18:14,170 --> 00:18:15,000
!خلفك

222
00:18:19,370 --> 00:18:20,530
...اللّعنة

223
00:18:22,330 --> 00:18:27,300
عندما أتمكّن من السّيطرة الكاملة على قوّة أوروتشيمارو-ساما

224
00:18:27,930 --> 00:18:30,270
سأقاتلك مجدّداً يا ناروتو

225
00:18:31,530 --> 00:18:33,200
لكن لستَ الأولويّة

226
00:18:33,430 --> 00:18:37,000
الأولويّة هي لساسكي الذي أسقطَ أوروتشيمارو-ساما

227
00:18:37,230 --> 00:18:39,270
!ماذا ستفعلُ لساسكي؟

228
00:18:40,730 --> 00:18:41,800
إلى أن نلتقي مجدّداً

229
00:19:00,870 --> 00:19:03,600
نجحنا! أسقطنا ساسكي

230
00:19:04,600 --> 00:19:06,030
...كما هو متوقّع، سينباي

231
00:19:18,770 --> 00:19:19,800
كما هو متوقّع، سينباي

232
00:19:19,830 --> 00:19:20,470
!اصمت

233
00:19:23,100 --> 00:19:26,030
لكن يبدو هذا الفتى... قويّاً بعض الشيء

234
00:19:27,270 --> 00:19:30,330
تصوّر أن يُقتَل أوروتشيمارو على يدِ طفل مثله

235
00:19:30,730 --> 00:19:32,430
...ما زلتُ لا أصدّق هذا

236
00:19:37,270 --> 00:19:40,600
!توبي، انظر كيف يحدّق بنا

237
00:19:41,030 --> 00:19:43,200
أتتوقُ للذهاب يا سينباي؟

238
00:19:43,930 --> 00:19:46,000
ستضطرُّ للاعتذار من إيتاتشي لاحقاً