1
00:00:02,740 --> 00:00:04,780
هلَّا ضربتَ على قبضتي؟

2
00:00:05,780 --> 00:00:06,790
نعم

3
00:00:24,800 --> 00:00:26,440
نعم، لنجرِّب ذلك

4
00:00:26,940 --> 00:00:28,980
...لا يوجدُ شيء لا نستطيعُ فعله إذا استعرنا قوّةَ الكيوبي

5
00:00:29,060 --> 00:00:31,100
أعني، قوّة كوراما

6
00:00:31,190 --> 00:00:32,150
حسناً

7
00:00:32,230 --> 00:00:34,770
إذاً لنتحالف نحنُ الأربعة

8
00:00:35,100 --> 00:00:36,610
نحن الأربعة

9
00:00:36,820 --> 00:00:38,990
تعاملُنا كبشر أيضاً

10
00:00:39,070 --> 00:00:41,450
أيّ نوعٍ من تربيةِ الأطفال هو هذا؟

11
00:00:45,610 --> 00:00:46,370
...ناروتو

12
00:00:48,000 --> 00:00:51,960
...ليتَ كانَ هُناك المزيد من الوقت
...للتكلُّمِ معك وأنتَ بهذا النّضج

13
00:00:52,040 --> 00:00:54,710
الرِّجالُ ليسوا بحاجةٍ للكلام

14
00:00:54,920 --> 00:00:56,430
أعلم

15
00:01:01,970 --> 00:01:05,720
فلقد ...التقيتُ بتشاكرا أمِّي

16
00:01:06,980 --> 00:01:10,640
ما تريد أن تقوله هو نفس كلام أمِّي المُزعِجة، صحيح!؟

17
00:01:11,020 --> 00:01:12,640
أعرفُها جيِّداً

18
00:01:31,370 --> 00:01:35,150
...هذا الشّعورُ مألوفٌ جداً

19
00:01:36,640 --> 00:01:38,970
رغمَ أنَّ خياراتنا محدودة

20
00:01:39,060 --> 00:01:41,770
.. أشعرُ وكأنّنا نستطيعُ أن نُنجِزَ أيّ شيء

21
00:01:43,020 --> 00:01:49,570
هذا صحيح! كذلك الأمر عندما كنتُ مع كوشينا

22
00:01:58,830 --> 00:02:00,950
أشعرُ بقوّةٍ تتدفّقُ داخلي

23
00:02:01,290 --> 00:02:02,740
هيّا بنا

24
00:02:04,370 --> 00:02:06,380
حصلَ ناروتو على هذا القدْر من التشاكرا؟

25
00:02:07,090 --> 00:02:09,750
ناروتو! الصُّراخ والتّباهي

26
00:02:09,840 --> 00:02:11,710
هو أمرٌ جيِّد

27
00:02:11,880 --> 00:02:13,840
ولكن لا تقلْ لي أنَّك نسيت

28
00:02:14,300 --> 00:02:17,930
أنّه لا ينفع ضدّه سِوى تقنيات الناسك؟

29
00:02:18,310 --> 00:02:19,890
أعلمُ أنَّك لستَ غبياً

30
00:02:29,920 --> 00:02:32,290
هذا صحيح

31
00:02:32,380 --> 00:02:35,290
أنتَ أغبى من أخي الكبير

32
00:02:36,040 --> 00:02:39,430
...كلّ تِلك التشاكرا وهدرها عليه

33
00:02:39,550 --> 00:02:42,800
...أو رُبَّما هذا ليسَ نفس الإحساس

34
00:02:46,680 --> 00:02:52,110
يبدو وكأنَّك تفوّقتَ على كلّ الهوكاغيّين السابقين بالغباء

35
00:02:52,230 --> 00:02:55,980
اصمُت يا كوراما الغبيّ

36
00:02:57,150 --> 00:02:59,700
الحمقى يحبُّهم ويثِقُ بهم الآخرون بسهولة

37
00:03:00,530 --> 00:03:04,320
سيكونُ كلّ شيء على ما يُرام. لا تقلق

38
00:03:05,410 --> 00:03:08,120
أنا لستُ قلِقاً لأنّني غبيّ

39
00:03:08,670 --> 00:03:10,130
أنا لا أتحدّثُ عن ذلك

40
00:03:11,080 --> 00:03:14,460
أقصدُ أنَّك قد تكون قادِراً على الانتقالِ لنمطِ الناسك

41
00:03:14,540 --> 00:03:16,540
وأنتَ بهذه الحالة

42
00:03:18,130 --> 00:03:22,550
،اسمع .. ربَّما تكونُ قد نسيت

43
00:03:22,640 --> 00:03:26,890
ولكن خلال معركتِك الأخيرة مع باين، ناغاتو

44
00:03:30,270 --> 00:03:34,650
غضبتُ كثيراً ممّا قالَه وهو أنَّ طاقتي التشاكرا تسرّبَتْ

45
00:03:34,730 --> 00:03:38,480
رغمَ أنَّك كنتَ في نمطِ النّاسك آنذاك

46
00:03:38,560 --> 00:03:45,490
قوّتي وقوّة النّاسك الخاصّة بك تمكَّنَتا من المُزامَنة

47
00:03:49,120 --> 00:03:51,210
هل حدثَ شيء كهذا وقتذاك ..؟

48
00:04:03,760 --> 00:04:07,550
ولكن عندما كنتُ أتدرّبُ على فنِّ النّاسك

49
00:04:07,630 --> 00:04:10,600
عرقلتَ تقنيّةَ النّاسك العجوز، أتذكُر؟

50
00:04:10,600 --> 00:04:14,730
هذا لأنّني لم أكُن مُهتمّاً في مشاطرةِ المكان ذاته مع ضفادع

51
00:04:15,560 --> 00:04:22,490
بالإضافةِ إلى ذلك، اعتمادُك على تقنيّةِ النّاسك
ولديك التشاكرا خاصّتي أمر يستفزّني

52
00:04:25,070 --> 00:04:27,240
أيُّها الحقير العنيد

53
00:04:27,490 --> 00:04:29,620
أنتَ العنيد

54
00:04:30,120 --> 00:04:31,710
على أيّ حال، ما أُحاول قوله هو

55
00:04:31,790 --> 00:04:34,500
أنّني لن أدعَك تستخدِم

56
00:04:34,580 --> 00:04:36,830
كلّاً من قوَّتي وقوّة النّاسك الآن

57
00:04:37,040 --> 00:04:39,760
!أين العِنادُ في ذلك؟

58
00:04:40,970 --> 00:04:43,630
لا يمكنُك أن تكونَ صريحاً في التعبيرِ عن مشاعرِك، صحيح؟

59
00:04:43,720 --> 00:04:47,300
أيُّها الوغد! أنتَ تسخرُ منِّي كثيراً مؤخراً

60
00:04:50,810 --> 00:04:54,230
...لا أعني ذلك... الأمر غير مألوف

61
00:04:58,060 --> 00:05:00,820
...استخدام حالة البيجو مع تقنيّة النّاسك في ذاتِ الوقت

62
00:05:01,780 --> 00:05:04,190
في داخلك مثلي مثلما في داخل ابنك

63
00:05:04,440 --> 00:05:07,610
ينبغي أن تكونَ قادراً على مُساندتِه بقوّة

64
00:05:07,940 --> 00:05:08,910
نعم

65
00:05:10,790 --> 00:05:12,700
أعي ذلك

66
00:05:21,420 --> 00:05:23,170
سأحضِّرُ تقنيةً ما أيضاً

67
00:05:25,710 --> 00:05:29,140
أمتصُّ طاقةَ الطّبيعة بشكلٍ أسرَع وأنا في هذه الحالة

68
00:05:40,730 --> 00:05:41,400
حسناً

69
00:07:28,180 --> 00:07:32,850
الشّجرة القدسيّة

70
00:07:39,150 --> 00:07:41,990
ناروتو، أضِف تقنيّةَ النّاسك إلى الراسينغان

71
00:07:42,070 --> 00:07:43,200
حسناً

72
00:07:44,120 --> 00:07:45,450
العجوز الثَّاني

73
00:07:47,030 --> 00:07:48,120
لنفعلها

74
00:07:50,830 --> 00:07:52,080
!إلى الأمام فحسب

75
00:07:52,790 --> 00:07:56,080
سنتصدَّى لهجماتِه بالتشاكرا

76
00:08:08,050 --> 00:08:09,560
راسينغان –
راسينغان –

77
00:08:46,180 --> 00:08:48,430
ذلك الشّيء الأسودُ صلبٌ حقاً

78
00:08:49,130 --> 00:08:50,230
تبّاً

79
00:08:50,350 --> 00:08:52,230
تصدّى لنا هذه المرّة

80
00:08:53,060 --> 00:08:54,850
...تنبَّأ بهجومنا

81
00:08:55,230 --> 00:08:58,060
استخدامُ رايجين الطَّائر فقط في استراتيجيّتِنا غير كافٍ

82
00:08:58,270 --> 00:09:01,150
خيارُنا الوحيدُ هو تدميرُ ذلك الشّيء الأسود

83
00:09:01,860 --> 00:09:02,740
ولكن كيف؟

84
00:09:03,400 --> 00:09:05,820
...حسناً، التَّالي

85
00:09:06,070 --> 00:09:10,160
لنُحاول إضافة تقنيّة النّاسك إلى قنبلةِ بيجو

86
00:09:11,160 --> 00:09:12,540
حسناً، فكرة مُمتازة

87
00:09:14,000 --> 00:09:18,040
...قد تتفوّق على أخي الكبير كهوكاغي

88
00:09:23,050 --> 00:09:25,050
كوراما الآخر! ساعدْنا أيضاً

89
00:09:25,380 --> 00:09:27,170
يعجِبُني هذا

90
00:09:28,130 --> 00:09:29,260
توقّعتُ ذلك

91
00:09:31,560 --> 00:09:33,180
هذا إحساسٌ مألوفٌ إذاً

92
00:09:44,690 --> 00:09:46,860
أهذا ما يستطيع ناروتو فعله الآن؟

93
00:09:47,820 --> 00:09:50,290
إنّه قادِر على التحكُّمِ بهذا الكمّ من التشاكرا بإتقان

94
00:09:52,080 --> 00:09:54,500
...كم من مسافة سوف

95
00:10:06,590 --> 00:10:09,640
لا ضير من اتّخاذ إجراءات مُبكّرة

96
00:10:17,310 --> 00:10:19,310
ما هذا!؟

97
00:10:25,320 --> 00:10:28,820
!أيبدأ بتسوكيومي اللّامحدودة من الآن؟

98
00:10:50,830 --> 00:10:52,880
بصقَ الجيوبي؟

99
00:10:52,960 --> 00:10:55,550
كن حذِراً. ينتابُني إحساسٌ سيّء حيالَ هذا الأمر

100
00:11:32,840 --> 00:11:35,000
سأعلِّقُ الحاجزَ حالياً

101
00:11:42,510 --> 00:11:43,760
الحاجِزُ يختفي

102
00:11:44,640 --> 00:11:47,260
والآن يمكنُنا أن نقاتلَ إلى جانبِ ناروتو والآخرين

103
00:12:12,420 --> 00:12:13,830
...هذا

104
00:12:24,180 --> 00:12:25,300
!ماذا؟

105
00:12:32,230 --> 00:12:36,100
اهربوا! سيمتصُّ التشاكرا خاصّتكم دُفعة واحدة

106
00:12:42,360 --> 00:12:43,950
إنّه قادِمٌ إلينا واحداً تلو الآخر

107
00:12:44,030 --> 00:12:45,820
!ولكن لماذا...؟

108
00:12:49,660 --> 00:12:55,000
لماذا...؟! لماذا ينقضُّ عليّ الكثير؟

109
00:12:55,080 --> 00:12:57,040
أيها الأحمق... الأخرق

110
00:12:57,540 --> 00:13:00,790
هذه شجرة الإله. تُدعى بالشجرة القدسيّة

111
00:13:01,170 --> 00:13:03,050
إنّه الشكلُ الأخير من الجيوبي

112
00:13:03,550 --> 00:13:07,970
إنّها تعلمُ أنَّك لديك تشاكرا أكثر من أيّ شخصٍ آخر

113
00:13:08,340 --> 00:13:12,890
في هذه الحالة، التشاكرا الّتي منحَها ناروتو للجميعِ لا معنى لها

114
00:13:16,890 --> 00:13:19,440
!ما هذا؟

115
00:13:20,770 --> 00:13:22,650
...نشأتِ التشاكرا أساساً

116
00:13:22,990 --> 00:13:24,530
مع هذه الشّجرة القدسيّة

117
00:13:24,990 --> 00:13:26,860
...كلّ التشاكرا التي هُنا

118
00:13:27,900 --> 00:13:30,820
وحتّى الكميّات الهائلة من التشاكرا الّتي تمتلِكُها

119
00:13:30,860 --> 00:13:32,040
ماذا؟

120
00:13:32,370 --> 00:13:35,500
سرقَ البشرُ التشاكرا من الشجرةِ القدسيّةِ منذُ زمنٍ بعيد

121
00:13:35,960 --> 00:13:39,080
إنَّها تحاولُ فقط أن تستردَّ ما يَنتمي إليها

122
00:13:39,870 --> 00:13:40,870
!عمّاذا تتكلّم؟

123
00:13:41,750 --> 00:13:46,550
مضيُّ زمنٍ طويل جدّاً قد ألقى بضبابِه على الحقيقة

124
00:13:47,800 --> 00:13:51,810
هل تعرفُ كيفَ ظهرَ النِّينجا يا هاشيراما؟

125
00:13:53,980 --> 00:13:59,140
منذُ زمنٍ بعيد، عندما لم يكُن النّاسُ يعرفون شيئاً عن التشاكرا

126
00:14:00,890 --> 00:14:05,610
حتّى في ذلك الحين، كانَ النّاس يتصارعون

127
00:14:08,110 --> 00:14:10,860
لم تُشارك الشّجرةُ القدسيّةُ في معاركهم أبداً

128
00:14:10,860 --> 00:14:15,950
وكانوا يعبدونها كعمودٍ مُقدَّس

129
00:14:17,410 --> 00:14:18,700
...ولكن ذات يوم

130
00:14:21,370 --> 00:14:23,760
حملَتِ الشجرةُ القدسيّة فاكهةً قيلَ بأنَّها لا تظهر

131
00:14:23,840 --> 00:14:25,300
إلَّا مرّة في كلّ ألفيّة

132
00:14:25,380 --> 00:14:29,630
لا أعرِف إلامَ ترمُز تِلك الفاكِهة، ولكن وردَ في الأسطورة

133
00:14:29,710 --> 00:14:32,430
بأنّه لم يلمسْها أحدٌ قطّ

134
00:14:35,890 --> 00:14:38,930
ولكن أميرة واحِدة، وطمعاً

135
00:14:39,020 --> 00:14:42,980
،بحصدِ قوّة الشجرةِ القدسيّة وتحقيق نصرٍ في حرب

136
00:14:43,070 --> 00:14:45,320
أخذَتِ الفاكهةَ المُحرَّمة وأكلَتْها

137
00:14:47,650 --> 00:14:49,610
بعدَ ذلك، اكتسبَتْ قوّة إله

138
00:14:49,690 --> 00:14:52,740
وقد قيلَ بأنَّها قمعت الحرب بمفردِها

139
00:14:53,910 --> 00:14:58,160
كانَ اسمُها كاغويا أوتسوتسكي

140
00:14:59,870 --> 00:15:00,990
هذا ما حدثَ إذاً

141
00:15:02,670 --> 00:15:05,170
كانَتْ أوَّل بشريّة تمتلِكُ تشاكرا

142
00:15:07,420 --> 00:15:09,750
في نهايةِ المطاف، كانت كاغويا ستلد طفلاً

143
00:15:09,840 --> 00:15:13,510
يمتلِكُ التشاكرا فطريّاً

144
00:15:15,140 --> 00:15:18,180
...على أيّ حال، عاشتِ الشجرةُ القدسيّة

145
00:15:18,260 --> 00:15:21,310
وهاجَتْ كي تستعيدَ التشاكرا المسروقة خاصّتها

146
00:15:22,110 --> 00:15:23,900
وهي الجيوبي

147
00:15:25,400 --> 00:15:29,150
ومن أوقفَها كانَ طفلُ كاغويا

148
00:15:29,520 --> 00:15:32,330
كانَ اسمه هاغورومو أوتسوتسكي

149
00:15:33,670 --> 00:15:36,380
كانَ الشّخص الّذي درَّسَ تعاليمَ التشاكرا

150
00:15:36,460 --> 00:15:38,430
وكانَ مُؤسِّس نينشو

151
00:15:38,890 --> 00:15:40,390
...كان السّلف الأكبر للنينجا

152
00:15:40,470 --> 00:15:42,430
الرّجُل الّذي يُعرَفُ باسم الرّيكودو سينين

153
00:15:43,810 --> 00:15:46,610
وما أدراكَ بكلّ هذا!؟

154
00:15:47,770 --> 00:15:50,690
نُقِشَ ذلك في لوحٍ أوتشيها الحجري

155
00:15:54,150 --> 00:15:56,780
هل عليّ أن أشرحَ ما حدث

156
00:15:56,870 --> 00:15:59,830
لأولئك الّذين تذوّقوا الفاكهةَ المُحرَّمة

157
00:15:59,910 --> 00:16:02,160
بغية إنهاء كلّ الصِّراعات؟

158
00:16:07,750 --> 00:16:10,880
هذا صحيح... لم يُغيّر ذلك شيئاً

159
00:16:11,250 --> 00:16:14,540
بل في الواقِع، أصبحتِ الحروبُ التّالية أكثر رُعباً

160
00:16:15,750 --> 00:16:18,930
عندما علِمتُ بذلك، غرقتُ في اليأس

161
00:16:20,010 --> 00:16:23,970
لا توجد أحلام حقيقيّة في هذا العالم يا هاشيراما

162
00:16:25,180 --> 00:16:29,110
منذُ أن تناولَ النّاسُ من تِلك الفاكِهة والبشر ملعونون

163
00:16:29,190 --> 00:16:32,150
ومُقدَّر لهم أن يكرهوا بعضَهم بعضاً أكثر فأكثر

164
00:16:34,480 --> 00:16:36,780
...ووجودُنا نحنُ النِّينجا بحدِّ ذاته

165
00:16:36,870 --> 00:16:39,950
هو ما يرمز إلى تِلك الحماقة، ألا تعتقِد ذلك؟

166
00:16:41,070 --> 00:16:42,700
...في هذه الحالة أفضِّلُ

167
00:16:43,410 --> 00:16:45,870
الاعتِماد على قوّةِ الشَّجرة القدسيّة مُجدّداً

168
00:16:45,950 --> 00:16:47,630
...باستخدامِ غينجيتسو عظيمة

169
00:16:49,170 --> 00:16:51,250
.. إنَّك فقط لا ترى

170
00:16:51,830 --> 00:16:53,750
...ما وراء هذا

171
00:16:53,750 --> 00:16:55,540
أحلامَ المُستقبل البعيد

172
00:17:01,510 --> 00:17:04,800
أهذا ما قصدتَه بـ"أحلام المُستقبل البعيد"!؟

173
00:17:07,020 --> 00:17:07,900
...نعم

174
00:17:08,560 --> 00:17:11,560
ولكن سيكونُ الأمرُ مُختلِفاً قليلاً

175
00:17:15,980 --> 00:17:17,200
ناروتو

176
00:17:19,200 --> 00:17:21,610
عنصر الماء: الموجةُ القاطِعة

177
00:17:27,830 --> 00:17:29,620
تبّاً! هنالِك الكثيرُ منهم

178
00:17:30,210 --> 00:17:32,670
قد أكون قادراً على الشُّعورِ بناروتو، ولكن لا جدوى

179
00:17:33,290 --> 00:17:36,250
الرّابِع! هل يمكنُك الانتقال آنيّاً إلى ناروتو!؟

180
00:17:37,050 --> 00:17:41,970
لا أستطيع! رايجين الطّائر الأخير وهذه الكروم قد التشاكرا خاصّتي

181
00:17:42,930 --> 00:17:44,260
...في هذه الحالة

182
00:17:49,850 --> 00:17:52,810
...اتر .. كني

183
00:18:01,360 --> 00:18:02,490
...العجوز

184
00:18:05,820 --> 00:18:08,040
آسِف لتأخُّري

185
00:18:09,660 --> 00:18:10,410
سارو

186
00:18:13,210 --> 00:18:13,910
حسناً

187
00:18:14,000 --> 00:18:15,500
سننتقلُ آنياً من هُنا

188
00:18:23,510 --> 00:18:25,050
هل هدأتِ الأمورُ أخيراً؟

189
00:19:19,070 --> 00:19:22,610
أهذا ما قصدتَه بـ"أحلام المُستقبل البعيد"؟

190
00:19:23,190 --> 00:19:24,110
...نعم

191
00:19:24,860 --> 00:19:26,910
ولكن سيكونُ الأمرُ مُختلِفاً قليلاً

192
00:19:28,120 --> 00:19:29,160
مُختلِف قليلاً؟

193
00:19:29,990 --> 00:19:30,990
...انظر

194
00:19:43,050 --> 00:19:45,670
...عندما تتفتّحُ برعمةُ الشجرة القدسيّة أخيراً

195
00:19:46,810 --> 00:19:50,010
سيعكسُ القمرُ العينَ في مركزِ الزهرة، الّتي في الأعلى

196
00:19:50,970 --> 00:19:53,640
لتتفعّل التسوكويومي اللّامحدودة بشكلٍ كامل

197
00:19:53,930 --> 00:19:58,940
وسيكونُ أنا ...من يُحقِّق ذلك

198
00:19:59,690 --> 00:20:01,690
لقد هلكنا

199
00:20:02,230 --> 00:20:03,730
هذا جنون

200
00:20:05,150 --> 00:20:06,320
آنسة ساكورا

201
00:20:06,400 --> 00:20:08,490
هل أنتِ بخير آنِسة ساكورا؟

202
00:20:14,200 --> 00:20:17,790
كادَ ذلك وشيكاً أيها الأحمق الأخرق

203
00:20:18,960 --> 00:20:20,210
كادَ ذلك وشيكاً جدّاً

204
00:20:23,710 --> 00:20:25,460
هل انتهى الأمر؟

205
00:20:43,520 --> 00:20:47,780
...لا تتحرَّكوا

206
00:20:52,120 --> 00:20:54,120
...فجميعكم

207
00:20:56,880 --> 00:20:59,130
قد تحمّلتُم ما يكفي

208
00:22:38,380 --> 00:22:39,930
قُضيَ على النِّينجا

209
00:22:40,010 --> 00:22:41,850
لا داعي للمُتابَعة

210
00:22:42,220 --> 00:22:44,430
إن لم تُقاوِموا، لن أقتلَكم

211
00:22:45,180 --> 00:22:46,550
،ما لم تريدوا أن تتحسّروا

212
00:22:46,640 --> 00:22:48,470
توقّفوا ولا تفعلوا شيئاً من الآن فصاعِداً

213
00:22:48,890 --> 00:22:51,860
لم يعُد هُناك داعٍ للخوفِ من الموت أو تحمُّل المُعاناة بعد الآن

214
00:22:51,940 --> 00:22:53,810
ستدخلون حلماً

215
00:22:54,980 --> 00:22:58,190
:الحلقة القادمة من ناروتو شيبودن
"حلم شينوبي"

216
00:22:59,740 --> 00:23:03,410
هذا هو حلمُنا الحقيقيّ كنينجا