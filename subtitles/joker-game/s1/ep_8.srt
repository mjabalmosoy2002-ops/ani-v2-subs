1
00:00:02,980 --> 00:00:05,150
هل تعرف هذا الرّجل؟

2
00:00:07,940 --> 00:00:09,730
!شيراهاتا كييْتشيرو

3
00:00:10,860 --> 00:00:14,280
إنّه ديبلوماسيّ كان يعمل مع السّفارة
.البريطانيّة في الماضي

4
00:00:14,280 --> 00:00:17,990
.أعتقد أنّه محجوز حاليًّا في منزله في إيزو

5
00:00:18,990 --> 00:00:23,830
إنّنا نشكّ أنّ شيراهاتا قد أمسى على علم
.بمحتويات "الخطّة الكبرى" للقيادة العليا

6
00:00:24,080 --> 00:00:25,920
!ما-ماذا؟

7
00:00:26,500 --> 00:00:29,380
!شخص كشيراهاتا يعرف بأمرها؟

8
00:00:29,800 --> 00:00:35,010
.لقد كان يعارض تحالفنا مع ألمانيا بشكل كبير

9
00:00:35,380 --> 00:00:39,970
كما أنّه متعاطف مع الغرب وسمعتُ أنّ لديه
.العديد من الأصدقاء المقرّبين في بريطانيا

10
00:00:40,810 --> 00:00:45,270
،ويعرف القنصل العامّ البريطانيّ إرنيست غراهام
.على وجه الخصوص، منذ سنين

11
00:00:45,940 --> 00:00:48,520
،لم يتمّ الإفصاح عن الأمر للعموم بعد

12
00:00:48,520 --> 00:00:52,820
لكنّ غراهام يخطّط فجأة للعودة
.لبريطانيا في المستقبل القريب

13
00:00:53,280 --> 00:00:54,950
...لا تقل لي أنّ شيراهاتا

14
00:00:55,240 --> 00:00:56,820
،"لا يجب أن نسمح لـ"الخطّة الكبرى

15
00:00:56,820 --> 00:00:59,320
الّتي هي من أكثر المعلومات
،القيّمة والسّرّيّة لبلادنا

16
00:00:59,320 --> 00:01:00,990
!أن تقع بين أيدي بريطانيا

17
00:01:01,660 --> 00:01:04,200
ألا يمكننا اعتقال شيراهاتا وغراهام؟

18
00:01:07,210 --> 00:01:10,090
.نحتاج لدليل دامغ قبل أن نبدأ التّحقيق

19
00:01:10,880 --> 00:01:13,760
،وإن أمكننا معرفة مكان تسليم المعلومة

20
00:01:13,760 --> 00:01:16,510
.ستكون لدينا اليد العليا في مفاوضاتنا مع بريطانيا

21
00:01:16,970 --> 00:01:21,220
هذا دون أن نذكر حاجتنا لعُذر لإسكات
.المتعاطفين الموالين للغرب

22
00:01:22,260 --> 00:01:24,310
.يتطلّب هذا الوضع إجراءً فوريًّا

23
00:01:25,730 --> 00:01:27,190
.استعملهم

24
00:01:29,610 --> 00:01:34,150
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

25
00:01:34,900 --> 00:01:40,070
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

26
00:01:40,660 --> 00:01:43,120
يتمّ التّعامل مع ماضي وأسماء

27
00:01:43,120 --> 00:01:46,620
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

28
00:01:46,620 --> 00:01:50,420
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

29
00:01:50,790 --> 00:01:53,880
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

30
00:01:54,340 --> 00:01:56,380
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

31
00:01:56,670 --> 00:01:59,760
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

32
00:02:00,140 --> 00:02:02,510
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

33
00:02:03,390 --> 00:02:07,060
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

34
00:02:07,480 --> 00:02:09,770
."اسمها هو "الوكالة دي

35
00:03:59,300 --> 00:04:00,210
.كشّ

36
00:04:08,060 --> 00:04:09,720
...لم أكن جاهزًا لهذا

37
00:04:11,770 --> 00:04:15,650
،فزتُ 15 مرّة وخسرتُ 17 مرّة
.إضافة لسِتّ حالات ردب

38
00:04:16,060 --> 00:04:19,900
،أعلم أنّك مشغول أيّها القنصل
.لذلك لنكتفي لهذا اليوم

39
00:04:19,900 --> 00:04:21,440
.على مهلك

40
00:04:21,440 --> 00:04:23,700
.ما زال هنالك وقت للعبة أخرى

41
00:04:23,700 --> 00:04:24,660
...يا عزيزي

42
00:04:26,240 --> 00:04:27,660
...المعذرة

43
00:04:28,030 --> 00:04:29,580
هل أستطيع مقاطعتكما؟

44
00:04:29,580 --> 00:04:30,620
ما الخطب؟

45
00:04:35,040 --> 00:04:38,710
.كان ذلك الرّجل عند البوّابة الخلفيّة البارحة أيضًا

46
00:04:39,420 --> 00:04:40,500
مَن؟

47
00:04:43,840 --> 00:04:47,090
...أخبر الخادمة أنّه يعمل في محطّة المياه

48
00:04:47,680 --> 00:04:49,720
.لكن هنالك شيء حياله يجعلني أتوتّر

49
00:04:50,970 --> 00:04:52,520
ما رأيك؟

50
00:04:52,810 --> 00:04:54,890
.إنّه ربّما من الشّرطة العسكريّة

51
00:04:56,560 --> 00:04:57,560
كيف ذلك؟

52
00:04:58,730 --> 00:05:01,570
.لديه وجه مُسمرّ كثيرًا

53
00:05:02,070 --> 00:05:05,030
.لكنّ جبهته تبدو فاتحة اللّون بشكل غريب

54
00:05:05,030 --> 00:05:09,280
بالتّالي، مهنته الحقيقيّة لا تتطلّب منه
،التّجوال في الخارج طوال اليوم فحسب

55
00:05:09,280 --> 00:05:11,910
.بل وتتطلّب أيضًا أن يرتدي قبّعة وهو يؤدّي عمله

56
00:05:11,910 --> 00:05:13,790
،إن كان لا يرتدي قبّعته الآن

57
00:05:13,790 --> 00:05:17,620
.فالسّبب هو أنّ ذلك شيكشف مهنته الحقيقيّة

58
00:05:17,920 --> 00:05:19,880
المهنة الوحيدة الّتي تخطر على بالي

59
00:05:19,880 --> 00:05:22,750
والّتي تتطلّب قبّعة معيّنة والتزام السّرّيّة بشأنها

60
00:05:22,750 --> 00:05:25,010
.هي أنّه شرطيّ العسكريّ

61
00:05:26,430 --> 00:05:28,510
.أجل، أو شيء مشابه لذلك

62
00:05:29,300 --> 00:05:30,760
هذا مفاجئ، صحيح؟

63
00:05:31,050 --> 00:05:33,390
،بالنّسبة لشابّ في سنّه

64
00:05:33,390 --> 00:05:36,440
.إضافة إلى أنّه يابانيّ أيضًا، فهو ذكيّ

65
00:05:36,810 --> 00:05:38,150
،سيّد غامو

66
00:05:38,440 --> 00:05:42,020
.تسلك اليابان الطّريق الخطأ وتتعمّق فيه أكثر

67
00:05:42,020 --> 00:05:44,400
،أفعالها في الصّين

68
00:05:44,400 --> 00:05:46,740
،وحتّى إرسالها لجواسيس إلى وطننا

69
00:05:47,110 --> 00:05:48,240
.إنّه لأمر مخزٍ

70
00:05:48,240 --> 00:05:50,820
.لا! توقّفي يا جاين

71
00:05:51,450 --> 00:05:55,450
"يعمل السّيّد غامو مع "تايلور تيراشيما
.وهو صديق مقرّب لي

72
00:05:55,950 --> 00:05:58,580
.لا علاقة له بالحكومة أو الجيش

73
00:05:59,290 --> 00:06:01,040
.نعم... معك حقّ

74
00:06:01,500 --> 00:06:04,170
.أنا أعتذر يا سيّد غامو

75
00:06:04,460 --> 00:06:06,920
.لا بأس، لا داعي للاعتذار

76
00:06:06,920 --> 00:06:10,220
اخرجي واستنشقي بعض الهواء
.النّقيّ وحاولي الاسترخاء

77
00:06:10,220 --> 00:06:10,840
.حاضرة

78
00:06:11,510 --> 00:06:13,890
.وخذي المظلّة الّتي اشتريتُها لكِ

79
00:06:14,310 --> 00:06:17,020
لا أريد أن يُمسيَ وجهك كوجه
.ذلك الشّرطيّ العسكريّ

80
00:06:17,890 --> 00:06:19,440
.آسف بشأن ذلك

81
00:06:19,440 --> 00:06:21,150
،إنّها ليست معتادة على الجوّ هنا

82
00:06:21,150 --> 00:06:23,690
.لذلك تعاني من مشاكل في النّوم ليلاً

83
00:06:24,320 --> 00:06:26,990
والآن، هل نكمل منافستنا؟

84
00:06:27,280 --> 00:06:29,360
.أخشى أنّ عليّ الرّفض

85
00:06:29,700 --> 00:06:34,530
.لديّ بعض الأعمال مع زبون آخر هذا اليوم

86
00:06:36,370 --> 00:06:39,000
.أفترض أنّ علينا الانتظار في هذا الحالة

87
00:06:39,000 --> 00:06:41,330
.سنكمل ما بدأناه لاحقًا

88
00:06:41,630 --> 00:06:43,090
.اهتمّ بنفسك

89
00:06:49,760 --> 00:06:50,680
.شكرًا لك

90
00:07:09,360 --> 00:07:10,240
.أبله

91
00:07:10,860 --> 00:07:13,030
.التّجسّس هي مهمّة رجل محترم

92
00:07:13,320 --> 00:07:16,700
.ما كان لشخص وضيع من أمثاله أن ينجح كجاسوس

93
00:08:08,090 --> 00:08:09,000
.تشو-سان

94
00:08:20,020 --> 00:08:21,270
ما الّذي يحدث؟

95
00:08:21,930 --> 00:08:24,190
.أرى أنّك كنتَ تتبعني

96
00:08:24,600 --> 00:08:26,690
.إنّها أوامر غراهام

97
00:08:29,730 --> 00:08:30,570
لماذا؟

98
00:08:31,490 --> 00:08:33,240
،أنا لا أعرف السّبب بشكل محدّد

99
00:08:33,530 --> 00:08:37,240
.لكنّه يتصرّف بحذر شديد في الأسبوع الماضي

100
00:08:37,820 --> 00:08:41,450
الأمر لا يعنيك أنت فقط. إنّه يأمر أن أتبع
.معظم زوّاره بعد مغادرتهم

101
00:08:43,710 --> 00:08:47,460
كنتُ خائفًا أن يعرف أنّك من عرّفني
.على هذا المكان

102
00:08:48,040 --> 00:08:50,840
.كلاّ، أظنّ الأمر متعلّق بالعمل

103
00:08:50,840 --> 00:08:54,090
إنّه متحمّس بشأن النّتيجة إذا
...ما سارت الأمور جيّدًا

104
00:08:54,760 --> 00:08:56,840
هل تغيّر أيّ شيء آخر؟

105
00:09:06,480 --> 00:09:09,730
.سوف يغادر غراهام-سان اليابان قريبًا

106
00:09:10,190 --> 00:09:12,860
.لقد استلم أوامر سرّيّة من بلاده

107
00:09:13,610 --> 00:09:14,490
لأيّ سبب؟

108
00:09:15,570 --> 00:09:20,240
.لم يُطلع الخدم على أيّ تفاصيل بعد

109
00:09:21,200 --> 00:09:22,540
.هكذا إذًا

110
00:09:23,200 --> 00:09:26,290
...حسنًا، لنستمتع بوقتنا اللّيلة ثانية

111
00:09:27,210 --> 00:09:28,790
...أو ذلك ما أرغب بقوله

112
00:09:29,290 --> 00:09:33,210
لكنّك لا زلت لم تدفع لي المال
.الّذي أقرضتُك إيّاه في ذلك اليوم

113
00:09:34,130 --> 00:09:37,050
أرجوك، أيمكنك أن تنتظر لأسبوع آخر فقط؟

114
00:09:37,380 --> 00:09:41,180
.لقد أقرضتُك ما مجموعه 15 ألف ينّ

115
00:09:41,810 --> 00:09:44,680
.إنّه ما يعادل أجرك طوال خمس سنوات

116
00:09:45,020 --> 00:09:48,400
.لن تحصل على ذلك المال في أسبوع واحد

117
00:09:49,730 --> 00:09:51,980
.لم يعد هنالك شيء ليُقال

118
00:09:58,320 --> 00:09:59,740
.ا-انتظر لحظة

119
00:10:00,030 --> 00:10:02,700
!ثلاثة أيّام! أقسم أن أحضر لك المال بعد ثلاثة أيّام

120
00:10:03,080 --> 00:10:05,120
...على هذا المعدّل، سوف

121
00:10:05,410 --> 00:10:08,500
!أتوسّل إليك. سأقوم بأيّ شيء

122
00:10:25,520 --> 00:10:26,810
.أتمنّى لكما يومًا هانئًا

123
00:10:37,070 --> 00:10:39,780
الشّطرنج لعبة بسيطة، لكنّ تلك البساطة بحدّ ذاتها

124
00:10:40,110 --> 00:10:42,620
.في ما تدفع شخصيّات اللاّعبين على الظّهور

125
00:10:44,030 --> 00:10:46,490
ما تعلّمته عن شخصيّة غراهام
...وأنا ألاعبه الشّطرنج هو

126
00:10:47,500 --> 00:10:48,460
.أنّه بسيط

127
00:10:50,420 --> 00:10:52,710
.ومع ذلك، هو حريص على إتمام خططه

128
00:10:57,510 --> 00:11:00,050
.إنّه حذر مرّتين أكثر من الشّخص العاديّ

129
00:11:02,470 --> 00:11:04,930
.متبجّح وطموح

130
00:11:05,560 --> 00:11:09,890
،"وباستعمال المعلومات في "الخطّة الكبرى

131
00:11:09,890 --> 00:11:12,150
.قد يستطيع بلوغ منصب بارز في بريطانيا

132
00:11:12,150 --> 00:11:14,730
.لا بدّ أنّه يرغب به بشدّة

133
00:11:15,150 --> 00:11:17,190
."ينبئني حدسي أنّه "أسود

134
00:11:17,940 --> 00:11:23,620
وهذا واضح من الطّريقة الّتي يجعل بها
.تشو يلاحق ضيوفه طوال أسبوع

135
00:11:30,040 --> 00:11:35,880
لكنّي لم أرَ أيّ أثرٍ لأيّ محاولة
.من غراهام للاتّصال بأيّ أحد

136
00:11:37,380 --> 00:11:40,090
."لذلك توضّح الظّروف أنّه "أبيض

137
00:11:42,760 --> 00:11:44,510
لقد كشفتني إذًا؟

138
00:11:45,220 --> 00:11:49,810
.لن أنخدع بأساليب تضليليّة بدائيّة كهذه

139
00:11:49,810 --> 00:11:52,560
أنت تسبقني بخطوة يا غراهام-سان

140
00:11:52,560 --> 00:11:54,810
.في مسألتَيْ الخداع والإدراك

141
00:11:55,610 --> 00:11:57,770
أتحاول دفعي لأرخي دفاعاتي؟

142
00:12:05,490 --> 00:12:08,030
.أعتقد أنّ عليّ التّأكّد من الأمور بنفسي

143
00:12:13,920 --> 00:12:17,790
.دع حارس البوّابة يشرب هذا المخدّر

144
00:12:17,790 --> 00:12:19,340
.إنّه بلا رائحة أو طعم

145
00:12:19,670 --> 00:12:22,380
.سيكون غير قابل للكشف إذا خُلط مع مشروب ما

146
00:12:24,380 --> 00:12:26,340
.لا داعي للقلق

147
00:12:26,340 --> 00:12:28,260
،إنّه مجرّد مخدّر لإفقاده وعيه

148
00:12:28,260 --> 00:12:30,180
.كما أنّي سآخذ المال فحسب

149
00:12:30,470 --> 00:12:33,350
.لن يتأذّي أيّ أحد إن لم يتسبّب أحد بالمشاكل

150
00:12:33,690 --> 00:12:35,020
،أكره أن أبدوَ عازمًا

151
00:12:35,020 --> 00:12:37,810
لكنّ المال داخل الخزنة، صحيح؟

152
00:12:38,150 --> 00:12:38,860
.نعم

153
00:12:39,320 --> 00:12:43,240
.سوف نتقاسمه بيننا بالتّساوي
.عشرون ألفًا لكلّ واحد

154
00:12:44,530 --> 00:12:50,410
كما أنّ ذلك المال مصدره هو بيع الإنجليز
.للأفيون في كلّ أنحاء الصّين

155
00:12:50,740 --> 00:12:52,750
.لا داعي لتشعر بالذّنب حياله

156
00:12:53,960 --> 00:12:55,370
،كما طلبتَ منّي

157
00:12:55,370 --> 00:12:58,210
.فقد أعددتُ نسخة عن مفتاح الخزنة

158
00:12:58,670 --> 00:13:01,130
عليّ أن أترك الباب مفتوحًا فحسب، صحيح؟

159
00:13:48,380 --> 00:13:49,300
.لا شيء

160
00:13:49,970 --> 00:13:52,600
،لقد راجعتُ كلّ شيء داخل الخزنة

161
00:13:52,600 --> 00:13:57,480
لكن لا شيء هنا يدلّ على حصوله
.على "الخطّة الكبرى" من شيراهاتا

162
00:13:57,890 --> 00:14:00,480
...كلّ ما بقي هي مذكّراته

163
00:14:01,770 --> 00:14:03,900
أعتقد أنّ غراهام "أبيض" في نهاية المطاف؟

164
00:14:06,320 --> 00:14:09,280
كانت هذه هديّة لزوجته؟

165
00:14:09,950 --> 00:14:13,200
اخرجي واستنشقي بعض الهواء
.النّقيّ وحاولي الاسترخاء

166
00:14:13,200 --> 00:14:13,790
.حاضرة

167
00:14:14,240 --> 00:14:16,700
.وخذي المظلّة الّتي اشتريتُها لكِ

168
00:14:17,540 --> 00:14:20,250
لا أريد أن يُمسيَ وجهك كوجه
.ذلك الشّرطيّ العسكريّ

169
00:14:29,430 --> 00:14:30,680
هل من أحد هنا؟

170
00:14:37,680 --> 00:14:39,980
.لا بأس. لنعد للنّوم

171
00:14:53,320 --> 00:14:54,700
هل من خطب ما؟

172
00:14:55,030 --> 00:14:57,080
.لا، لا شيء

173
00:15:18,180 --> 00:15:19,480
،بعد التّحرّيّات

174
00:15:20,100 --> 00:15:22,190
."استطيع أن أؤكّد أنّ غراهام "أسود

175
00:15:23,650 --> 00:15:25,270
عثرتُ على رسالة تدينه

176
00:15:25,270 --> 00:15:28,860
.في مقبض المظلّة الأجوف الّتي أهداها لزوجته

177
00:15:30,450 --> 00:15:32,200
،استعمل زوجته كرسول

178
00:15:32,200 --> 00:15:34,780
.لكنّها لم تكن مدركة لِما يحدث

179
00:15:37,830 --> 00:15:41,040
لقد وضعتُ علامة عليها بالحبر
.الخاصّ الّذي أعطيتنيه وتبعتُها

180
00:15:41,870 --> 00:15:45,290
،كان الحبر على رئيس النوادل في مطعم قريب

181
00:15:46,000 --> 00:15:48,880
،وفي غرفة إيداع المعاطف في مبنى دخلته

182
00:15:49,590 --> 00:15:53,550
.وعلى نادل في أحد المقاهي

183
00:15:55,010 --> 00:15:56,470
،وطبعًا

184
00:15:58,600 --> 00:16:00,980
.كان على بصمات إيرنيست غراهام

185
00:16:04,310 --> 00:16:05,560
تقتضي خطّة شيراهاتا

186
00:16:05,560 --> 00:16:09,230
بتسليم المعلومات في منزله في إيزو خلال أسبوع

187
00:16:09,400 --> 00:16:13,030
.وأن يعود غراهام في الحال إلى إنجلترا بعد ذلك

188
00:16:25,790 --> 00:16:27,040
ما الّذي يجري؟

189
00:16:27,340 --> 00:16:29,750
!لم يتمّ سرقة أيّ مال من الخزنة

190
00:16:30,380 --> 00:16:33,380
.أعلم. تغيّرت الخطّة

191
00:16:33,630 --> 00:16:35,260
!ماذا عن مالي؟

192
00:16:35,260 --> 00:16:36,720
—قمتُ بكلّ ما طلبتَه

193
00:16:36,720 --> 00:16:38,430
.استرح وحسب

194
00:16:41,810 --> 00:16:43,140
...ذلك المال

195
00:16:44,140 --> 00:16:45,810
...ما الّذي

196
00:16:59,700 --> 00:17:01,080
.عشرون ألفًا

197
00:17:01,080 --> 00:17:04,250
.كما أنّي سأصفح عمّا تدين لي به أيضًا

198
00:17:33,230 --> 00:17:35,190
،قتلتُ معاوني تشو

199
00:17:35,190 --> 00:17:37,990
.وجعلتُ الأمر يبدو وكأنّه حاول سرقتي

200
00:17:38,950 --> 00:17:42,200
.لا يوجد أيّ دليل يربطني بموته

201
00:17:43,580 --> 00:17:45,910
.وهذه هي نهاية تقريري

202
00:17:47,500 --> 00:17:49,170
".اقتلوا دون تردّد"

203
00:17:49,500 --> 00:17:50,960
".موتوا بشرف"

204
00:17:51,590 --> 00:17:54,960
."أصبحتَ الآن عضوًا رسميًّا في "وكالة الرّيح

205
00:18:11,860 --> 00:18:14,150
من دواعي سروري أن أراك ثانية
.يا صاحب السّعادة أكتسو

206
00:18:14,940 --> 00:18:16,190
.استرح

207
00:18:16,490 --> 00:18:19,160
.رسميًّا، هذه الزّيارة لم تحدث

208
00:18:19,450 --> 00:18:22,950
.أنا وأنت لم نتقابل اليوم أبدًا

209
00:18:23,700 --> 00:18:24,370
.أجل

210
00:18:27,790 --> 00:18:30,630
.تلقّيتُ تقريرك ذلك اليوم

211
00:18:30,630 --> 00:18:34,460
.لخّص الوضع لي أيّها المقدّم كازاتو أكيماسا

212
00:18:34,920 --> 00:18:35,550
.حاضر

213
00:18:37,260 --> 00:18:41,260
.أمست المعلومات ضروريّة أكثر فأكثر في الصّراع الحاليّ

214
00:18:41,890 --> 00:18:43,930
الأمر واضح وضوح الشّمس

215
00:18:43,930 --> 00:18:46,350
أنّ هنالك جواسيس من كلّ أنحاء العالم

216
00:18:46,350 --> 00:18:48,390
.يعملون في العاصمة الإمبراطوريّة اليوم

217
00:18:48,940 --> 00:18:50,600
وبغرض الدّفاع عن أسرارنا

218
00:18:50,600 --> 00:18:53,190
،من جواسيس القوى العالميّة

219
00:18:54,360 --> 00:18:56,230
فأنا أؤمن أنّه من واجبنا

220
00:18:56,570 --> 00:19:00,150
إنشاء مدارس استخبارات ووكالات
.تجسّس في أقرب وقت ممكن

221
00:19:04,830 --> 00:19:07,450
،منذ نشأة الإمبراطوريّة في فترة ميجي

222
00:19:07,450 --> 00:19:11,370
.قاتلنا معاركنا دون الحاجة للجواسيس الجبناء

223
00:19:11,710 --> 00:19:13,540
يفتخر الجيش الإمبراطوريّ بنفسه

224
00:19:13,540 --> 00:19:15,840
.عن طريق القتال بعدل وإنصاف

225
00:19:15,840 --> 00:19:17,880
والعمل بالاستراتيجيّات الماكرة

226
00:19:18,170 --> 00:19:21,260
!هو إهانة لشرف الجيش

227
00:19:22,970 --> 00:19:23,680
...والآن

228
00:19:24,220 --> 00:19:26,640
،تلك ليست حقيقة شعوري

229
00:19:26,930 --> 00:19:29,020
.بل هو مجرّد رأي الأغلبيّة في الجيش

230
00:19:30,180 --> 00:19:35,730
في الحقيقة، هنالك سلفًا وكالة
.تجسّس سرّيّة في صفوف الجيش

231
00:19:36,900 --> 00:19:40,280
دعني أحزر، أنت لم تسمع بوكالة كهذه من قبل؟

232
00:19:40,780 --> 00:19:43,910
.تمّ إنشاؤها قبل سنة

233
00:19:44,200 --> 00:19:45,950
."يُسمّونها "الوكالة دي

234
00:19:46,410 --> 00:19:49,700
.المؤسّسُ مقدّمٌ في الجيش أيضًا وهو من بدأها

235
00:19:50,330 --> 00:19:53,710
ولكنّ "الوكالة دي" مختلفة تمامًا

236
00:19:53,710 --> 00:19:55,460
.بالمقارنة مع ما اقترحتَه أنت

237
00:19:56,210 --> 00:19:58,090
".لا تموتوا. لا تقتلوا"

238
00:19:58,920 --> 00:20:01,840
،رغم أنّها جزء من الجيش الإمبراطوريّ

239
00:20:02,340 --> 00:20:05,800
.إلاّ أنّهم يستعملون مدنيّين لإنجاز خططهم

240
00:20:07,100 --> 00:20:07,970
.هذا مستحيل

241
00:20:09,270 --> 00:20:10,980
لماذا تستعمل وكالة جواسيس

242
00:20:10,980 --> 00:20:14,270
!مدنيّين على وجه التّحديد؟

243
00:20:14,940 --> 00:20:16,860
".لا يمكننا استعمال خرّيجين من الكلّيّة الحربيّة"

244
00:20:17,570 --> 00:20:19,320
ما الّذي قلتَه؟

245
00:20:19,320 --> 00:20:22,150
."هذه كلمات يوكي، مؤسّس "الوكالة دي

246
00:20:22,860 --> 00:20:25,030
".لا أستطيع استعمال رجال عسكريّين"

247
00:20:25,660 --> 00:20:29,830
لن أسمح لأيّ أحد من الكلّيّة العسكريّة"
".أن يخطو عتبة بابي ولو عن طريق الصّدفة

248
00:20:30,160 --> 00:20:31,000
.هذه كلماته

249
00:20:32,620 --> 00:20:34,170
...يوكي

250
00:20:39,670 --> 00:20:43,130
".اقتلوا دون تردّد. موتوا بشرف"

251
00:20:46,220 --> 00:20:48,930
،أثناء فترة دراستكم

252
00:20:48,930 --> 00:20:50,810
هذا هو نوع المنهجيّة المنطقيّة

253
00:20:51,060 --> 00:20:52,640
الّذي ستعتمدون عليه

254
00:20:52,640 --> 00:20:55,390
كأعضاء من وكالة التّجسّس
.التّابعة للجيش الإمبراطوريّ

255
00:21:02,820 --> 00:21:06,240
.بلغني أنّك تمكّنت من الرّبط بين شيراهاتا وغراهام

256
00:21:06,610 --> 00:21:09,120
أتستطيع اكتشاف مكان التّبادل؟

257
00:21:09,120 --> 00:21:13,700
.نعم. لقد سبق ووضعتُ عميلاً داخل منزل شيراهاتا

258
00:21:15,460 --> 00:21:17,670
.إذًا فالاستعدادات جاهزة

259
00:21:18,170 --> 00:21:20,880
،بمجرّد أن تُنهي هذه العمليّة بنجاح

260
00:21:20,880 --> 00:21:22,380
فإنّ "وكالة الرّيح" الّتي أسّستَها

261
00:21:22,380 --> 00:21:26,380
سيتمّ الاعتراف بها كوكالة التّجسّس
.الرّسميّة التّابعة للجيش الإمبراطوريّ

262
00:21:27,430 --> 00:21:29,100
.أتوقّع منك أمورًا عظيمة

263
00:21:32,770 --> 00:21:36,310
.تمّ إعلام "الوكالة دي" بوضع شيراهاتا أيضًا

264
00:21:37,440 --> 00:21:39,980
.لا نيّة لي بالمشاركة في لعبة جوكر مضاعف

265
00:21:40,610 --> 00:21:43,440
.سيتمّ اعتبار الوكالة الّتي ستفشل وكالة إضافيّة

266
00:23:22,920 --> 00:23:24,130
ما الخطب؟

267
00:23:24,420 --> 00:23:28,340
.عليك أن تدمّر رباطة جأش خصمك للفوز

268
00:23:28,960 --> 00:23:31,300
.لا يتعلّق الشّطرنج بالفوز أو الخسارة

269
00:23:33,260 --> 00:23:34,930
.بل بالحياة والموت