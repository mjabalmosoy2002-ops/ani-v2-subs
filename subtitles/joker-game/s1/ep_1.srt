1
00:00:06,520 --> 00:00:08,570
!لم أقم بأيّ عمل سيّئ

2
00:00:09,690 --> 00:00:12,070
!كيف لكم أن تقوموا بعمل سخيف كهذا؟

3
00:00:12,700 --> 00:00:14,530
!لن أغفر لكم فظاظتكم هذه

4
00:00:14,530 --> 00:00:17,240
...سأتّصل ببلادي في الحال

5
00:00:20,450 --> 00:00:24,370
...سيؤدّي الملازم الهارا-كيري هنا
.إن لم نعثر على شيء

6
00:00:28,210 --> 00:00:30,750
!يا لها من عزيمة مثيرة للإعجاب

7
00:00:30,750 --> 00:00:33,800
لا يتراجع المحاربون اليابانيّون
عن كلمة قالوها، صحيح؟

8
00:00:36,430 --> 00:00:37,180
.انطلقوا

9
00:02:30,580 --> 00:02:37,630
!لقد رسا الجيش على شواطئ تشينغداو

10
00:02:45,680 --> 00:02:47,930
.الملازم ساكوما جاهز لأداء واجبه

11
00:02:52,690 --> 00:02:54,150
هل أنت غبيّ؟

12
00:03:08,250 --> 00:03:11,000
من هذا الّذي ينحني وهو يرتدي بذلة عمل؟

13
00:03:17,090 --> 00:03:18,130
.لنتابع

14
00:03:18,710 --> 00:03:22,680
أنت هو الجاسوس الّذي أرسله مقرّ الأركان العامّة؟

15
00:03:23,300 --> 00:03:24,340
.كلاّ

16
00:03:24,760 --> 00:03:27,810
.أنا لا أقوم بتصرّفات جبانة على عكس الجواسيس

17
00:03:29,140 --> 00:03:32,020
إذًا فأنت تظنّ أنّ الجواسيس جبناء؟

18
00:03:34,310 --> 00:03:36,020
.في خريف عام 1937

19
00:03:36,770 --> 00:03:38,110
،قام الجيش الإمبراطوري

20
00:03:38,110 --> 00:03:41,700
،نزولاً عند طلب المقدّم يوكي

21
00:03:41,700 --> 00:03:45,030
.بإنشاء وكالة تدريب جواسيس سرّيّة

22
00:03:46,870 --> 00:03:50,580
تاريخ وأسماء وحتّى أعمار جميع العملاء المستقبليّين

23
00:03:50,950 --> 00:03:54,750
.تمّ التعامل معها كمعلومات بالغة السّرّيّة

24
00:03:55,540 --> 00:03:58,130
،لقد تعلّموا لغات أجنبيّة عديدة

25
00:03:58,630 --> 00:04:00,920
،إضافة للطّب وعلم الصّيدلة

26
00:04:00,920 --> 00:04:03,880
...وكذا الفيزياء والاتّصالات

27
00:04:04,260 --> 00:04:08,100
.لقّنهم لصوص محترفون ومخترقو خزائن تقنيّاتهم

28
00:04:08,850 --> 00:04:11,350
.حتّى أنّهم تعلّموا فنّ إغواء النّساء من الجيغولو

29
00:04:11,680 --> 00:04:13,980
.تمّ امتحانهم في مجالات واسعة

30
00:04:16,360 --> 00:04:19,190
،لكنّ ما لا يُصدّق

31
00:04:19,900 --> 00:04:23,900
هو أنّه لم يتخرّج ولا واحد منهم من أكاديميّة
.الجيش الإمبراطوريّ اليابانيّ

32
00:04:24,700 --> 00:04:27,660
.كانوا جميعًا من جامعات إمبراطوريّة أو عاديّة

33
00:04:27,660 --> 00:04:30,740
بعبارات أخرى، كانت تلك المجموعة
.مكوّنة من أوناسٍ عاديّين

34
00:04:31,700 --> 00:04:35,540
لقد أكملوا بسهولة تمارين تدريب دفعتهم

35
00:04:35,920 --> 00:04:37,880
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

36
00:04:38,750 --> 00:04:39,710
...حتّى في النّهاية

37
00:04:40,170 --> 00:04:42,920
.لم يتبقّى إلاّ ثمانية أشخاص

38
00:04:45,340 --> 00:04:46,130
...أو بالأحرى

39
00:04:49,680 --> 00:04:51,680
.ثمانية وحوش

40
00:05:05,490 --> 00:05:08,450
.سوف نخرج إلى المدينة
هل ستأتي معنا يا ساكوما-سان؟

41
00:05:09,950 --> 00:05:12,620
.لا، سأبقى هنا

42
00:05:17,960 --> 00:05:21,380
لا يوجد أيّ حظر تجوّل هنا
.في المسكن، وهذا قد فاجأني

43
00:05:21,380 --> 00:05:23,670
.كلّهم أحرار في الخروج ليلاً كما يرغبون

44
00:05:24,760 --> 00:05:27,800
كلّ شيء هنا متختلف تمامًا

45
00:05:27,800 --> 00:05:29,890
.عن أكاديميّة الجيش الّتي تخرّجتُ منها

46
00:05:31,810 --> 00:05:34,770
كان كلّ زملائي رفاقًا حقيقيّين أقسموا

47
00:05:34,770 --> 00:05:37,310
.أن يضحّوا بحياتهم من أجل بلادهم إن دعت الضّرورة

48
00:05:38,270 --> 00:05:42,270
.سأضحّي بحياتي لإنقاذ حياتهم بكلّ سرور

49
00:05:45,820 --> 00:05:48,780
...لكنّ هؤلاء الطّلبة

50
00:05:52,910 --> 00:05:53,830
.ميوشي

51
00:05:55,000 --> 00:05:56,000
.كاميناغا

52
00:05:56,830 --> 00:05:57,750
.أوداغيري

53
00:05:58,790 --> 00:05:59,540
.أماري

54
00:06:00,710 --> 00:06:01,460
.هاتانو

55
00:06:02,790 --> 00:06:03,670
.جيتسويْ

56
00:06:04,590 --> 00:06:05,550
.فوكوموتو

57
00:06:06,630 --> 00:06:07,550
.تازاكي

58
00:06:08,930 --> 00:06:11,430
.كلّها أسماء مزيّفة

59
00:06:12,050 --> 00:06:15,350
،إنّهم يستعملون أسماء بعضهم بعضًا المزيّفة
...ويتجاوبون إلى قصص حياة مزيّفة

60
00:06:16,430 --> 00:06:18,770
،لقد خضعوا لتدريبٍ قاسٍ معًا

61
00:06:19,060 --> 00:06:21,860
.لكنّهم لا يعرفون حتّى أسماء بعضهم بعضًا الحقيقيّة

62
00:06:24,480 --> 00:06:27,150
أنّى لهم أن يعيشوا هكذا؟

63
00:06:57,810 --> 00:06:59,680
.أراهن بالمثل. زوجان

64
00:07:00,730 --> 00:07:01,690
.زوج واحد

65
00:07:02,060 --> 00:07:03,520
.زوج واحد أيضًا

66
00:07:04,360 --> 00:07:05,520
.نلتم منّي

67
00:07:08,070 --> 00:07:09,610
.أنا أنسحب من اللّعبة

68
00:07:12,110 --> 00:07:13,530
أرى أنّكم قد عدتم؟

69
00:07:14,990 --> 00:07:15,910
ما الّذي تفعلونه؟

70
00:07:16,990 --> 00:07:18,870
أتريدن الانضمام لنا يا ساكوما-سان؟

71
00:07:19,700 --> 00:07:20,960
تلعبون البوكر إذًا؟

72
00:07:21,870 --> 00:07:24,420
.أكيد، سألعب قليلاً

73
00:07:30,170 --> 00:07:30,970
.ها هو رهاني

74
00:07:33,140 --> 00:07:33,930
.سأراهن بالمثل

75
00:07:34,640 --> 00:07:36,890
.أنسحب من هذا الرّهان

76
00:07:38,010 --> 00:07:38,890
.سأراهن بالمثل

77
00:08:07,840 --> 00:08:08,630
.أنسحب من هذا الرّهان

78
00:08:10,460 --> 00:08:11,380
.سأراهن بالمثل

79
00:08:12,800 --> 00:08:13,930
!لعبة كاملة

80
00:08:16,550 --> 00:08:17,640
.أربع أوراق متماثلة

81
00:08:20,140 --> 00:08:22,140
.لقد بدأتُ للتّوّ

82
00:08:46,000 --> 00:08:49,340
.ما باليد حيلة. هكذا تجري الأمور أحيانًا

83
00:08:50,000 --> 00:08:51,760
.لنلعب في وقت آخر

84
00:08:56,760 --> 00:09:00,010
.ساكوما-سان، أنت لم تخسر في لعبة البوكر

85
00:09:02,350 --> 00:09:03,640
ما الّذي تقصده؟

86
00:09:03,640 --> 00:09:08,480
كنتُ أختلس النّظر إلى أوراقك
.وأرسل إشارات للآخرين

87
00:09:08,770 --> 00:09:09,940
!ماذا؟

88
00:09:12,110 --> 00:09:15,700
ما الممتع في الفوز عن طريق الغشّ؟

89
00:09:16,280 --> 00:09:17,610
...نحن

90
00:09:18,070 --> 00:09:21,080
.لم نكن نلعب البوكر على الإطلاق

91
00:09:21,080 --> 00:09:24,080
ماذا؟ ما الّذي كنتم تفعلونه إذًا؟

92
00:09:26,040 --> 00:09:29,670
.إنّنا نسمّيها لعبة الجوكر

93
00:09:31,460 --> 00:09:33,760
لعبة الجوكر؟

94
00:09:35,170 --> 00:09:36,510
...بعبارات أخرى

95
00:09:38,180 --> 00:09:40,850
،هنالك لعبة أوراق تجري على الطّاولة

96
00:09:40,850 --> 00:09:42,970
.لكنّها مجرّد تمثيليّة

97
00:09:43,770 --> 00:09:46,180
،الهدف هنا هو جعل الآخرين يقفون في صفّك

98
00:09:47,140 --> 00:09:49,650
وجعلهم يختلسون النّظر
.إلى يد الخصوم وإرسال إشارات لك

99
00:09:50,520 --> 00:09:54,530
.ولكن من المستحيل أن تعرف من يقف إلى جانبك

100
00:09:55,440 --> 00:09:57,650
،قد تكون الإشارات مزيّفة

101
00:09:58,030 --> 00:10:00,700
.وقد تكتشف إشارات الخصم وتغيّر الأوراق الّتي في يدك

102
00:10:02,030 --> 00:10:03,910
.أعطني سيجارة

103
00:10:05,160 --> 00:10:05,910
.خذ

104
00:10:06,660 --> 00:10:09,420
وحسب ذلك، قد تستطيع إقناع جاسوس العدوّ

105
00:10:09,870 --> 00:10:11,710
.بخيانة الجانب الّذي هو فيه والانضمام لك

106
00:10:12,590 --> 00:10:15,550
ما الممتع في خداع الآخرين هكذا؟

107
00:10:16,050 --> 00:10:17,670
!ما الفائدة؟

108
00:10:18,050 --> 00:10:19,220
من يدري؟

109
00:10:19,220 --> 00:10:22,300
.إنّها أشبه بالسّياسة العالميّة إلى حدّ قريب

110
00:10:22,850 --> 00:10:24,970
السّياسة العالميّة؟

111
00:10:24,970 --> 00:10:26,180
ما الّذي يحدث؟

112
00:10:27,600 --> 00:10:29,390
.إنّها لعبتنا المعتادة فحسب

113
00:10:29,390 --> 00:10:32,610
.لم يحبّها ساكوما-سان، هذا كلّ شيء

114
00:10:33,320 --> 00:10:35,980
.أنا لا أشتكي ممّن خسر وممّن ربح

115
00:10:36,360 --> 00:10:39,240
.مقصدي هنا هي أنّ هذه الطّريقة جبانة

116
00:10:40,410 --> 00:10:44,280
تعتقد أنّه يجب اللّعب في كلّ المنافسات بعدل وإنصاف؟

117
00:10:44,700 --> 00:10:48,540
،إن لم يخبروك بسرّ اللّعبة

118
00:10:48,830 --> 00:10:52,330
هل كنت ستقول هذه الأشياء الّتي تقولها الآن؟

119
00:10:53,170 --> 00:10:56,550
.هذا هو وضع اليابان الحاليّ

120
00:10:57,670 --> 00:10:59,300
ما الّذي تعنيه بذلك؟

121
00:11:02,390 --> 00:11:03,800
.واشنطون

122
00:11:04,890 --> 00:11:08,600
.تخيّل أنّ تلك الطّاولة هي مسرح لاجتماع سياسيّ عالميّ

123
00:11:09,390 --> 00:11:12,850
.إن تمّ تسريب معلوماتك، فلا أمل لك بالفوز

124
00:11:13,810 --> 00:11:17,610
حدث نفس الشّيء لليابان السّنة الماضية

125
00:11:17,610 --> 00:11:19,490
.في قمّة نزع السّلاح في واشنطون

126
00:11:20,610 --> 00:11:24,570
فمنذ البداية، كان اللاّعبون على تلك
،الطّاولة من الدّول الأخرى

127
00:11:25,080 --> 00:11:29,080
على علمّ تامّ بمدى التّنازلات

128
00:11:29,080 --> 00:11:30,910
.الّتي كانت اليابان عازمة على تقديمها

129
00:11:32,080 --> 00:11:34,750
.كانت اليابان مشغولة بقوانين التّمثيليّة الّتي أمامها

130
00:11:35,250 --> 00:11:39,260
.لم نلاحظ أبدًا الطّبيعة الحقيقيّة للّعبة الّتي كانت تُلعب

131
00:11:41,050 --> 00:11:44,840
.تذكّر، هذه منشأة لتدريب الجواسيس

132
00:11:45,510 --> 00:11:47,010
،عندما يغادر هؤلاء الرّجال هذا المكان

133
00:11:47,010 --> 00:11:49,890
سوف ينتشرون في أرجاء العالم

134
00:11:49,890 --> 00:11:53,400
.حيث سيتوجّب عليهم أن يختفون عن الأنظار

135
00:11:54,310 --> 00:11:57,900
.إمّا لعشرة سنوات أو عشرين سنة أو ربّما أكثر

136
00:11:58,440 --> 00:12:00,940
،ستكون مهمّتهم الانتقال لبلد أجنبيّ

137
00:12:00,940 --> 00:12:06,870
ثمّ استيعابه وإخفاء أنفسهم فيه
بغرض جمع المعلومات

138
00:12:06,870 --> 00:12:09,830
.عن ذلك البلد وإرسال تقارير لليابان

139
00:12:10,250 --> 00:12:14,080
هل يمكنك حتّى أن تتخيّل كيف ستكون حياتهم؟

140
00:12:15,960 --> 00:12:18,090
...الشّيء الوحيد الّذي ينتظركم جميعًا

141
00:12:19,500 --> 00:12:21,340
.هو وحدة سوداء وجوفاء

142
00:12:23,760 --> 00:12:26,090
،إن كنتَ جاسوسًا

143
00:12:26,760 --> 00:12:29,890
واكتشف العدوّ سرّك، فما الّذي ستفعله؟

144
00:12:30,600 --> 00:12:33,180
،لن يكون لي خيار آخر عدا قتل العدوّ

145
00:12:33,180 --> 00:12:35,480
.وإن لم يكن ذلك ممكنًا، سأقتل نفسي

146
00:12:37,650 --> 00:12:40,230
...تقتل أو تنتحر

147
00:12:40,730 --> 00:12:43,360
.أسوأ خيارين محتملين يمكن لجاسوس أن يتّخذهما

148
00:12:44,450 --> 00:12:47,160
.أنا لا أفهم ما الّذي ترمي إليه

149
00:12:47,530 --> 00:12:49,200
،عندما يموت أحد ما في فترة سلام

150
00:12:49,910 --> 00:12:52,500
.يتمّ إشراك شرطة بلادهم في التّحقيق بشكل حتميّ

151
00:12:53,370 --> 00:12:56,580
،يجب أن يكون الأمر واضحًا بالنّسبة لجاسوس

152
00:12:57,000 --> 00:13:00,250
،أنّ كلاًّ من القتل أو الانتحار عديما الفائدة

153
00:13:00,250 --> 00:13:02,300
.وأنّهما تصرّف غبيّ

154
00:13:02,840 --> 00:13:06,090
.هذه هي طريقة تفكير الجبناء الّذين يهابون الموت

155
00:13:07,050 --> 00:13:11,060
أنا آسف، لكن كلّ ما أراه في الجواسيس
!هو أنّهم جبناء يفتقرون للشّجاعة

156
00:13:12,850 --> 00:13:14,680
دعني أطرح عليك هذا السّؤال إذًا؛

157
00:13:14,680 --> 00:13:18,270
ما الّذي سيحدث إن انتحرت؟

158
00:13:18,520 --> 00:13:19,440
...إن متّ

159
00:13:20,690 --> 00:13:22,980
.سأنضمّ إلى رفاقي في الحياة الأخرى بكلّ فخر

160
00:13:23,280 --> 00:13:29,320
هكذا إذًا. ستموت لتتمكّن من التّفاخر
.أمام رفاقك في الحياة الأخرى

161
00:13:29,870 --> 00:13:32,740
وماذا إن لم تقابلهم هناك؟

162
00:13:33,200 --> 00:13:34,910
!من المستحيل أن يحدث ذلك

163
00:13:35,370 --> 00:13:36,540
.فهمت

164
00:13:37,620 --> 00:13:39,630
ميوشي. ما رأيك؟

165
00:13:40,170 --> 00:13:43,760
."هذا إسهاب. "يمكن للإيمان أن يحرّك الجبال

166
00:13:44,050 --> 00:13:45,920
،إنّه إيمان ذو أسس ثابتة

167
00:13:46,670 --> 00:13:48,840
.لكنّه لا يختلف عن أيّ دين جديد

168
00:13:48,840 --> 00:13:53,060
تُمسي الفكرةُ فكرةً عابرة بمجرّد
.مغادرة حدود مجموعة منعزلة

169
00:13:53,930 --> 00:13:55,060
كاميناغا؟

170
00:13:55,430 --> 00:13:57,230
.أوافق رأي ميوشي

171
00:13:57,850 --> 00:14:00,650
،على سبيل المثال، إن هُزمت اليابان في الحرب

172
00:14:00,650 --> 00:14:03,530
سيتعلّم النّاس سريعًا أن يأخذوا كلّ إيمانهم

173
00:14:04,190 --> 00:14:07,530
.ويضعونه في الجهة المعارضة لمعتقداتهم الأصليّة

174
00:14:09,320 --> 00:14:11,830
!إن هُزمت اليابان؟

175
00:14:12,740 --> 00:14:16,620
...المال والشّرف وروح المواطنة

176
00:14:17,290 --> 00:14:20,120
.وحتّى الموت مجرّد خيال

177
00:14:21,330 --> 00:14:24,710
الشّيء الوحيد الموجود في مستقبلكم
.هو تلك الوحدة الجوفاء

178
00:14:25,960 --> 00:14:29,340
والشّيء الوحيد الّذي عليه أن يدعمكم
في ذلك الفراغ المظلم

179
00:14:30,720 --> 00:14:34,260
،هو قدرتكم على التّأقلم مع أيّ وضع في الحال

180
00:14:35,350 --> 00:14:38,270
.والتّقرير في تلك اللّحظة أفضل ما يجب القيام به

181
00:14:43,650 --> 00:14:47,400
إذًا فهم لن يصبحوا جواسيس

182
00:14:47,780 --> 00:14:50,280
.حتّى بدافع الشّرف وروح المواطنة

183
00:14:51,610 --> 00:14:55,030
إنّه مجرّد كمّ بذيء من الثّقة في النّفس تخبرهم

184
00:14:55,660 --> 00:14:58,120
.أنّه يجب أن يكونوا قادرين على القيام بهذا

185
00:15:04,130 --> 00:15:05,920
وحدهم الجاحدون من النّاس

186
00:15:07,210 --> 00:15:08,720
.من يستطيعون العيش هكذا

187
00:15:28,740 --> 00:15:31,280
.أعطنا الأمر بالدّخول والحصول على دليل

188
00:15:31,700 --> 00:15:34,030
.لا يوجد شكّ أنّ هذا الرّجل جاسوس

189
00:15:34,950 --> 00:15:38,700
...أحضر دليلاً دامغًا معك

190
00:15:39,500 --> 00:15:40,750
مفهوم؟

191
00:15:41,460 --> 00:15:42,710
.جون غوردون

192
00:15:43,170 --> 00:15:46,920
.دعته شركة تجاريّة كبيرة إلى اليابان قبل ثلاثة سنوات

193
00:15:47,420 --> 00:15:49,670
إنّه يدير عملاً هنا

194
00:15:49,670 --> 00:15:52,090
.يُعاير آليّات دقيقة مستورة

195
00:15:53,010 --> 00:15:55,600
،إنّه يؤجّر منزلاً يابانيًّا في كاندا حاليًّا

196
00:15:55,600 --> 00:15:57,600
،يأكل الأرزّ من زُبديّة بعيدان الأكل

197
00:15:57,600 --> 00:16:01,310
ويضمّ يديه لبعضهما أمام صورة الإمبراطور
.ليلاً ونهارًا، ويعيش كمحبّ لليابان

198
00:16:02,440 --> 00:16:05,770
.يُشتبه بغوردون أنّه جاسوس

199
00:16:06,770 --> 00:16:11,360
أتى رجل آخر اعتُقل في قضيّة أخرى
.على ذكر اسمه

200
00:16:12,860 --> 00:16:19,700
يتوقّع العقيد موتو أن تقدّم هذه المدرسة
.دليلاً دامغًا يثبت تورّط الهدف

201
00:16:21,160 --> 00:16:24,710
دليل؟ لماذا قد تزعج نفسك بالبحث عن دليل؟

202
00:16:25,380 --> 00:16:27,380
...ماذا؟ ما الّذي

203
00:16:28,210 --> 00:16:31,670
،حتّى إن لم تذهب للبحث عن دليل

204
00:16:31,670 --> 00:16:34,090
.فسيختفي إن تركته وشأنه

205
00:16:35,130 --> 00:16:38,510
يُشتبه بغوردون أنّه يلتقط صورًا خفيّة

206
00:16:38,510 --> 00:16:43,180
.لرموز شيفرات الجيش الإمبراطوريّ اليابانيّ

207
00:16:45,230 --> 00:16:47,900
بمجرّد أن يتمّ الاشتباه بشخص
.أنّه جاسوس، ينتهي أمره

208
00:16:48,860 --> 00:16:50,570
الأمر بلا فائدة

209
00:16:50,570 --> 00:16:52,940
.بقدر عدم فائدة عدوّ محارب أسير مُقعد

210
00:16:55,860 --> 00:16:59,450
بدأ مركز الأركان العامّة يعطي أوامر مسموعة

211
00:16:59,450 --> 00:17:02,080
.أكثر الآن لتقديم نتائج لهذه المدرسة

212
00:17:02,580 --> 00:17:07,380
.بعبارات أخرى، هذه مهمّة رسميّة للوكالة دي

213
00:17:07,710 --> 00:17:09,250
.مهمّة عقيمة

214
00:17:10,290 --> 00:17:12,920
.ورغم ذلك، تبقى الأوامرُ أوامرًا

215
00:17:17,510 --> 00:17:21,260
حسنًا. كلّ ما نحتاجه هو دليل ما، صحيح؟

216
00:17:25,060 --> 00:17:27,600
كيف سنتعامل مع الأمر؟

217
00:17:28,400 --> 00:17:30,690
.سوف تتنكّرون كوحدة شرطة عسكريّة

218
00:17:31,230 --> 00:17:34,530
.ميوشي، ستتولّى القيادة في مكان الحدث

219
00:17:35,490 --> 00:17:38,950
.غادروا المكان في الحال بمجرّد الحصول على الدّليل

220
00:17:39,700 --> 00:17:42,330
سيكون أمامكم حوالي أربعين دقيقة

221
00:17:42,700 --> 00:17:44,700
.قبل أن تبدأ الشّرطة العسكريّة الحقيقيّة بإزعاجنا

222
00:17:45,370 --> 00:17:46,580
هل أنت أهل لهذا؟

223
00:17:46,580 --> 00:17:49,380
.ستكفينا ثلاثون دقيقة فقط

224
00:17:49,790 --> 00:17:52,050
،حسنًا يا ساكوما-سان

225
00:17:52,050 --> 00:17:54,840
هل أستطيع أن أطلب منك أن تؤدّي
دور قائد في الشّرطة العسكريّة؟

226
00:17:55,210 --> 00:17:56,090
أنا؟

227
00:17:56,550 --> 00:17:59,050
.سأكون مترجمك

228
00:17:59,720 --> 00:18:02,640
سيثير الأمر الشّبهات إن ذهبت
الشّرطة العسكريّة لتفتيش مكان

229
00:18:02,640 --> 00:18:05,850
.يعيش فيه أجنبيّ دون وجود مترجم هناك

230
00:18:06,310 --> 00:18:08,900
أنا أشكّ أنّ هنالك أيّ أحد منهم

231
00:18:08,900 --> 00:18:11,310
.يتحدّث لغة أجنبيّة

232
00:18:11,310 --> 00:18:15,320
.سنتحرّك في الثّامنة صباحًا

233
00:18:15,740 --> 00:18:17,780
.سأعلم الآخرين

234
00:18:18,360 --> 00:18:21,740
ما الّذي ستفعله إن لم نعثر على أيّ شيء خلال التّفتيش؟

235
00:18:23,950 --> 00:18:26,540
سيكون الدّليل هناك، صحيح؟

236
00:18:32,670 --> 00:18:34,590
!لم أقم بأيّ عمل سيّئ

237
00:18:35,550 --> 00:18:37,920
!كيف لكم أن تقوموا بعمل سخيف كهذا؟

238
00:18:38,550 --> 00:18:40,590
!لن أغفر لكم فظاظتكم هذه

239
00:18:40,590 --> 00:18:43,010
...سأتّصل ببلادي في الحال

240
00:18:43,300 --> 00:18:47,140
...سيؤدّي الملازم الهارا-كيري هنا
.إن لم نعثر على شيء

241
00:18:51,480 --> 00:18:53,980
!يا لها من عزيمة مثيرة للإعجاب

242
00:18:54,320 --> 00:18:57,240
لا يتراجع المحاربون اليابانيّون
عن كلمة قالوها، صحيح؟

243
00:18:57,240 --> 00:19:00,280
ماذا؟ ما الّذي أخبرتَه؟

244
00:19:02,620 --> 00:19:06,080
،قلتُ أنّنا إذا فتّشنا منزله ولم نعثر على أيّ شيء

245
00:19:06,080 --> 00:19:08,870
.فسوف تشقّ بطنك أمامه هنا أيّها الملازم

246
00:19:08,870 --> 00:19:10,290
ماذا؟

247
00:19:10,580 --> 00:19:13,540
!أنا أحبّ الثّقافة اليابانيّة

248
00:19:14,130 --> 00:19:17,340
.شاهدتُ فتيات الغيشا وجبل فوجياما

249
00:19:17,340 --> 00:19:19,550
.وما لم أره بعد هو الهارا-كيري

250
00:19:20,130 --> 00:19:21,680
.لا أطيق الانتظار

251
00:19:25,810 --> 00:19:26,510
.انطلقوا

252
00:19:28,600 --> 00:19:31,890
!مهلاً، اخلعوا أحذيتكم
!هل أنتم يابانيّون من الأساس؟

253
00:19:32,230 --> 00:19:33,230
!أيّها الملازم

254
00:19:33,230 --> 00:19:35,650
!مُرهم أن يخلعوا أحذيتهم

255
00:19:43,450 --> 00:19:45,200
لماذا هو واثق من نفسه هكذا؟

256
00:19:51,120 --> 00:19:52,420
!توقّفوا! توقّفوا

257
00:19:52,420 --> 00:19:53,750
!عمّاذا تبحثون؟

258
00:19:53,750 --> 00:19:55,790
!أتحاولون تحطيم منزلي؟

259
00:19:56,750 --> 00:19:58,960
!كفى! مهلاً، هذا كنزي

260
00:19:58,960 --> 00:20:00,550
!إيّاك أن تلمسه

261
00:20:01,170 --> 00:20:02,220
!أنتم، هل تستمعون لي؟

262
00:20:04,800 --> 00:20:07,310
.نلتُ كفايتي منكم يا هؤلاء

263
00:20:07,810 --> 00:20:09,770
،قيامكم بهذا مرّة واحدة كان كافيًا

264
00:20:09,770 --> 00:20:11,770
!لكنّ القيام به مرّتين لا يُغتفر

265
00:20:12,940 --> 00:20:14,730
ما الّذي قلتَه؟ مرّتين؟

266
00:20:15,480 --> 00:20:16,440
!ما الّذي تعنيه؟

267
00:20:16,440 --> 00:20:18,400
ألا تدري؟

268
00:20:18,690 --> 00:20:22,700
كانت الشّرطة العسكريّة هنا تبحث
.عن شيء ما قبل بضعة أيّام

269
00:20:23,110 --> 00:20:26,450
.ولم يعثروا على أيّ شيء بالطّبع

270
00:20:27,120 --> 00:20:28,910
ما... ماذا؟

271
00:20:29,490 --> 00:20:32,830
.إذًا من المستحيل أن نعثر على أيٍّ من رموز الشّيفرات

272
00:20:33,290 --> 00:20:35,120
...كان العقيد يعلم، ومع ذلك

273
00:20:36,670 --> 00:20:38,920
.لا بأس حتّى بغلطة صغيرة

274
00:20:38,920 --> 00:20:42,010
.إن ساءت الأمور بأيّ حال من الأحوال، فسينتهي أمرهم

275
00:20:42,590 --> 00:20:45,510
...لكن، إن لم يحدث أيّ شيء

276
00:20:47,350 --> 00:20:51,310
...فعل العقيد هذا عن قصد ليخدع الوكالة دي

277
00:20:52,480 --> 00:20:55,980
ما الخطب؟ أستستمرّون في البحث؟

278
00:20:57,810 --> 00:20:59,270
.المطبخ خالٍ

279
00:20:59,270 --> 00:21:00,610
.الحديقة خالية

280
00:21:00,900 --> 00:21:02,490
.الأدراج خالية

281
00:21:02,900 --> 00:21:04,650
.السّقف خالٍ

282
00:21:08,280 --> 00:21:13,120
لم يكن هنا أيّ شيء ينتظرنا
!أن نعثر عليه من الأساس

283
00:21:14,580 --> 00:21:17,040
ما الأمر أيّها القائد-سان؟

284
00:21:17,040 --> 00:21:19,340
ألم يحن وقت العرض بعد؟

285
00:21:29,010 --> 00:21:30,100
...مستحيل

286
00:21:38,560 --> 00:21:42,070
أنا هو من انتهى به المطاف

287
00:21:43,820 --> 00:21:46,570
!ساحبًا لورقة الجوكر؟

288
00:23:19,960 --> 00:23:23,170
في الحلقة القادمة

289
00:23:23,380 --> 00:23:24,790
ما نبحث عنه

290
00:23:25,290 --> 00:23:27,840
.قد يكون أقرب ممّا نعتقد

291
00:23:28,460 --> 00:23:29,550
ما الّذي تعنيه؟

292
00:23:29,590 --> 00:23:34,930
(الحلقة 2   [لعبة الجوكر] (الجزء الثّاني