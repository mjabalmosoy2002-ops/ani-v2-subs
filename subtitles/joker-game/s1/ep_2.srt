1
00:00:08,610 --> 00:00:11,360
.إنّ واجب الجيش هو حماية البلد والحفاظ عليه

2
00:00:11,610 --> 00:00:15,200
،تواجد القوّة العسكريّة أو غيابها

3
00:00:15,200 --> 00:00:17,570
وازدهار وتدهور ذلك الجيش

4
00:00:17,570 --> 00:00:20,830
.مرتبطون على نحو معقّد بثروات البلد

5
00:00:20,830 --> 00:00:24,460
لا تعيروا النّقاشات السّياسيّة
.أو الجوّ السّياسيّ أيّ انتباه

6
00:00:24,460 --> 00:00:28,460
.نفّذوا مهمّاتكم بكلّ بساطة وبولاء ثابت لا يتزعزع

7
00:00:28,460 --> 00:00:30,840
،ليكن شرفكم أثقل من الجبال

8
00:00:30,840 --> 00:00:34,220
.وخطر الموت أخفّ من الرّيشة

9
00:00:34,470 --> 00:00:36,840
.إنّ واجب الجيش هو حماية البلد والحفاظ عليه

10
00:00:36,840 --> 00:00:40,350
،تواجد القوّة العسكريّة أو غيابها

11
00:00:40,350 --> 00:00:42,600
وازدهار وتدهور ذلك الجيش

12
00:00:42,600 --> 00:00:45,230
.مرتبطون على نحو معقّد بثروات البلد

13
00:00:45,230 --> 00:00:48,190
لا تعيروا النّقاشات السّياسيّة
.أو الجوّ السّياسيّ أيّ انتباه

14
00:00:48,520 --> 00:00:52,400
.نفّذوا مهمّاتكم بكلّ بساطة وبولاء ثابت لا يتزعزع

15
00:00:52,900 --> 00:00:55,200
،ليكن شرفكم أثقل من الجبال

16
00:00:55,200 --> 00:00:58,820
.وخطر الموت أخفّ من الرّيشة

17
00:01:02,080 --> 00:01:04,410
.خريف عام 1937

18
00:01:04,750 --> 00:01:06,580
.بدأ الدّخّان يتصاعد من جمرِ حربٍ عالميّة

19
00:01:07,250 --> 00:01:12,210
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

20
00:01:12,960 --> 00:01:15,300
يتمّ التّعامل مع ماضي وأسماء

21
00:01:15,630 --> 00:01:19,010
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

22
00:01:19,010 --> 00:01:22,510
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

23
00:01:22,970 --> 00:01:26,270
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

24
00:01:26,270 --> 00:01:28,650
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

25
00:01:28,980 --> 00:01:31,480
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

26
00:01:31,820 --> 00:01:33,860
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

27
00:01:34,820 --> 00:01:38,360
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

28
00:01:38,950 --> 00:01:41,280
.اسمها هو الوكالة دي

29
00:03:16,090 --> 00:03:17,750
!هل أنتم يابانيّون من الأساس؟

30
00:03:17,750 --> 00:03:18,800
!أيّها الملازم

31
00:03:18,800 --> 00:03:21,180
!مُرهم أن يخلعوا أحذيتهم

32
00:03:21,970 --> 00:03:23,300
!توقّفوا! توقّفوا

33
00:03:23,300 --> 00:03:24,640
!عمّاذا تبحثون؟

34
00:03:24,640 --> 00:03:26,810
!أتحاولون تحطيم منزلي؟

35
00:03:27,680 --> 00:03:29,930
!كفى! مهلاً، هذا كنزي

36
00:03:29,930 --> 00:03:31,520
!إيّاك أن تلمسه

37
00:03:32,270 --> 00:03:33,480
!أنتم، هل تستمعون لي؟

38
00:03:34,860 --> 00:03:37,320
.نلتُ كفايتي منكم يا هؤلاء

39
00:03:37,690 --> 00:03:39,230
،قيامكم بهذا مرّة واحدة كان كافيًا

40
00:03:39,570 --> 00:03:41,570
!لكنّ القيام به مرّتين لا يُغتفر

41
00:03:42,780 --> 00:03:44,620
ما الّذي قلتَه؟ مرّتين؟

42
00:03:45,410 --> 00:03:46,200
!ما الّذي تعنيه؟

43
00:03:47,700 --> 00:03:49,040
.المطبخ خالٍ

44
00:03:49,370 --> 00:03:50,540
.الحديقة خالية

45
00:03:50,870 --> 00:03:52,370
.الأدراج خالية

46
00:03:52,660 --> 00:03:54,460
.السّقف خالٍ

47
00:03:58,380 --> 00:04:03,430
لم يكن هنا أيّ شيء ينتظرنا
!أن نعثر عليه من الأساس

48
00:04:04,130 --> 00:04:06,600
ما الأمر أيّها القائد-سان؟

49
00:04:06,600 --> 00:04:08,890
ألم يحن وقت العرض بعد؟

50
00:04:18,440 --> 00:04:19,440
...مستحيل

51
00:04:21,740 --> 00:04:25,280
أنا هو من انتهى به المطاف

52
00:04:27,070 --> 00:04:29,790
!ساحبًا لورقة الجوكر؟

53
00:04:59,650 --> 00:05:02,280
...تقتل أو تنتحر

54
00:05:02,280 --> 00:05:04,530
.أسوأ خيارين محتملين يمكن لجاسوس أن يتّخذهما

55
00:05:07,160 --> 00:05:10,240
إذًا فأنت تظنّ أنّ الجواسيس جبناء؟

56
00:05:11,790 --> 00:05:16,160
.نحن لم نكن نلعب البوكر على الإطلاق

57
00:05:17,540 --> 00:05:20,340
.كانت اليابان مشغولة بقوانين التّمثيليّة الّتي أمامها

58
00:05:20,790 --> 00:05:24,800
لم نلاحظ أبدًا الطّبيعة الحقيقيّة
.للّعبة الّتي كانت تُلعب

59
00:05:26,220 --> 00:05:27,430
.هذا إسهاب

60
00:05:27,880 --> 00:05:29,720
".يمكن للإيمان أن يحرّك الجبال"

61
00:05:30,050 --> 00:05:32,010
...إنّه إيمان ذو أسس ثابتة

62
00:05:33,220 --> 00:05:34,600
،عندما يغادر هؤلاء الرّجال هذا المكان

63
00:05:34,890 --> 00:05:37,600
،سوف ينتشرون في أرجاء العالم

64
00:05:38,100 --> 00:05:41,150
.حيث سيتوجّب عليهم أن يختفوا عن الأنظار

65
00:05:43,730 --> 00:05:47,570
...أشخاصٌ خفايا... أماكن خفيّة

66
00:05:49,110 --> 00:05:50,660
!أماكن خفيّة؟

67
00:06:03,710 --> 00:06:06,130
.هيّا، لا يمكنك أن تتراجع الآن

68
00:06:07,800 --> 00:06:10,930
.خلف صورة الإمبراطور

69
00:06:16,270 --> 00:06:16,930
!حاضر

70
00:06:19,350 --> 00:06:21,730
.هذا صحيح

71
00:06:22,150 --> 00:06:25,280
هنالك مكان واحد فقط في منزل غوردون

72
00:06:25,280 --> 00:06:27,780
.لا تجرؤ الشّرطة العسكريّة أن تلمسه

73
00:06:28,360 --> 00:06:31,490
.إنّه أمام أعيُننا وخفيّ في نفس الوقت

74
00:06:32,530 --> 00:06:35,040
،أمّا شرطيّ عسكريّ مزيّف

75
00:06:35,410 --> 00:06:37,950
...شخص ما من الوكالة دي

76
00:06:38,120 --> 00:06:40,250
!توقّف! توقّف

77
00:06:40,250 --> 00:06:42,670
،المقدّم يوكي، الرّجل الّذي نظّمهم

78
00:06:42,670 --> 00:06:44,380
...حتّى إن لم يرها بأمّ عينيه

79
00:06:44,630 --> 00:06:47,010
!أنت! إيّاك أن تلمس ذلك

80
00:06:47,670 --> 00:06:51,680
.فهو مدرك أنّ شيئًا ما كان هناك

81
00:06:58,850 --> 00:07:01,350
.لديّ سؤال واحد

82
00:07:02,060 --> 00:07:04,360
هل كنتَ تعلم أنّ الشّرطة العسكريّة الحقيقيّة

83
00:07:04,360 --> 00:07:08,360
سبق وأن داهمت منزل غوردون؟

84
00:07:09,950 --> 00:07:11,700
ما الّذي دفعك لتعتقد هذا؟

85
00:07:12,490 --> 00:07:17,290
.أنت تقول دائمًا أنّ الجواسيس خفايا

86
00:07:17,290 --> 00:07:19,750
السّبب الّذي جعلك تُلبس الجميع
،زيّ شرطة عسكريّة

87
00:07:19,750 --> 00:07:22,170
وإرسالهم في وضح النّهار

88
00:07:22,170 --> 00:07:24,500
لدفع غوردون ليُرخي من دفاعاته

89
00:07:25,090 --> 00:07:28,170
وذلك لتحظى الشّرطة العسكريّة
.بمشاكل أقلّ في المستقبل

90
00:07:33,890 --> 00:07:34,930
.أستأذن

91
00:07:42,770 --> 00:07:43,940
...ميوشي

92
00:07:45,860 --> 00:07:48,230
أعائد إلى مكتب الأركان العامّة؟

93
00:07:48,230 --> 00:07:50,650
أنا واثق أنّ العقيد سيكون مصدومًا

94
00:07:50,650 --> 00:07:52,530
.عند سماعه لتقريرك

95
00:07:55,660 --> 00:07:57,280
هل أتيتَ إلى هنا لتسخر منّي؟

96
00:07:59,450 --> 00:08:02,370
.كلاّ. لقد غيّرتُ رأيي عنك قليلاً

97
00:08:03,460 --> 00:08:05,750
لا أظنّ أنّ ساكوما-سان الجنديّ

98
00:08:05,750 --> 00:08:08,250
.كان ليكتشف ذلك

99
00:08:09,380 --> 00:08:10,210
،الأهم الآن

100
00:08:12,130 --> 00:08:15,220
.سوف نخرج للمدينة

101
00:08:15,220 --> 00:08:17,220
أتريد الانضمام لنا؟

102
00:08:17,640 --> 00:08:20,060
ربّما ترغب بالتّصرّف بفخامة
والذّهاب لمطعم راقٍ؟

103
00:08:20,060 --> 00:08:22,100
...حينها، لماذا

104
00:08:24,060 --> 00:08:26,150
.كلاّ، انسَ الأمر

105
00:08:26,810 --> 00:08:30,480
.أخشى أنّي سأرفض عرضك
.ربّما في المرّة القادمة

106
00:08:30,820 --> 00:08:32,110
.هكذا إذًا

107
00:08:44,120 --> 00:08:48,080
لا دليل لديّ يثبت أنّ العقيد موتو
أمر الشّرطة العسكريّة

108
00:08:48,420 --> 00:08:50,960
.بالبحث في منزل غوردون مسبقًا

109
00:08:52,510 --> 00:08:54,340
،لكن إن لم يأمر بذلك

110
00:08:54,800 --> 00:08:58,800
لا بدّ أنّه كان مصدومًا من حقيقة أنّهم
.لا يعثروا على أيّ شيء

111
00:09:01,100 --> 00:09:04,140
،إذا ما عرف الجميع بأمر فشله
،لتلطّخ سجلّه المهني بسبب ذلك

112
00:09:04,680 --> 00:09:08,400
.ولأَفسد كلّ فرصة له في أيّ ترقيات مستقبليّة

113
00:09:09,360 --> 00:09:12,320
لا بدّ أنّه قد خطرت في باله فكرة؛

114
00:09:18,030 --> 00:09:19,910
يستطيع التّستّر على فشله

115
00:09:20,660 --> 00:09:23,200
عن طريق جعل شخص آخر

116
00:09:23,580 --> 00:09:26,750
.يقترف نفس الخطأ الّذي اقترفه

117
00:09:27,460 --> 00:09:31,550
...إن فشل شخص آخر في نفس المهمّة

118
00:09:33,130 --> 00:09:34,420
،فالسّؤال الّذي يطرح نفسه

119
00:09:35,050 --> 00:09:37,680
هل كان المقدّم يوكي يعلم

120
00:09:37,680 --> 00:09:40,510
أنّ العقيد موتو سبق وداهم منزل غوردون؟

121
00:09:41,560 --> 00:09:45,480
.كان العقيد ليحتفظ بأمر فشله سرًّا

122
00:09:46,270 --> 00:09:49,310
ولاستطاع المقدّم يوكي أن يعرف ما حدث

123
00:09:49,900 --> 00:09:52,480
.فقط في اللّيلة الّتي حدثت فيها المداهمة

124
00:09:57,240 --> 00:09:58,530
،بالتّفكير بالأمر

125
00:09:59,070 --> 00:10:01,070
في اليوم الّذي ذهبتُ فيه إلى مكتب الأركان العامّة

126
00:10:01,070 --> 00:10:03,910
،وتلقّيتُ أمر تفتيش منزل غوردون

127
00:10:04,620 --> 00:10:07,330
.كان العقيد موتو يعاني أثار الشّرب

128
00:10:15,260 --> 00:10:18,470
ربّما ترغب بالتّصرّف بفخامة
والذّهاب لمطعم راقٍ؟

129
00:10:27,310 --> 00:10:30,560
عثرتم على... دليل؟

130
00:10:30,940 --> 00:10:34,270
...مستحيل... هذا غير ممكن

131
00:10:34,270 --> 00:10:36,480
.لم يتمّ إخباري أنّ هذه ثاني عملية تفتيش

132
00:10:37,280 --> 00:10:41,070
ماذا؟ ما الّذي قلتَه للتّوّ؟

133
00:10:41,780 --> 00:10:44,240
...حسنًا، بالأمس

134
00:10:44,530 --> 00:10:47,120
أمرتني أن أستخدم الوكالة دي

135
00:10:47,120 --> 00:10:51,250
.لتفتيش منزل الجاسوس الأمريكيّ جون غوردون

136
00:10:51,250 --> 00:10:53,880
ولكن، لم يتمّ إعلامي

137
00:10:53,880 --> 00:10:57,090
أنّ الشّرطة العسكريّة قد سبق
.وفتّشت منزل غوردون من قبل

138
00:10:57,710 --> 00:10:59,220
!بالطّبع لا

139
00:10:59,510 --> 00:11:04,720
.اسمع. أنت لا شيء سوى وسيط بيننا وبين أولئك

140
00:11:04,720 --> 00:11:07,430
أتعتقد أنّي بحاجة بأشرح كلّ شيء لك؟

141
00:11:07,770 --> 00:11:09,810
!لا تغترّ بنفسك كثيرًا

142
00:11:10,390 --> 00:11:12,440
.لا شيء من هذا يهمّ الآن

143
00:11:13,230 --> 00:11:15,320
.أخبرني أين عثرتم على الدّليل

144
00:11:15,320 --> 00:11:17,150
...حاضر. اسمح لي

145
00:11:20,240 --> 00:11:22,320
.خلف صورة الإمبراطور

146
00:11:24,070 --> 00:11:25,160
!مستحيل

147
00:11:25,160 --> 00:11:27,450
...لا تخبرني أنّك أقدمتَ على

148
00:11:27,450 --> 00:11:30,210
.كلاّ. لم ألمس الصّورة أبدًا

149
00:11:33,880 --> 00:11:37,800
حسنًا، أين هو الشّريط المصغّر الّذي عثرتم عليه؟

150
00:11:38,250 --> 00:11:40,050
.لم نأخذ الدّليل

151
00:11:40,050 --> 00:11:40,970
!ماذا؟

152
00:11:41,340 --> 00:11:45,350
.تأكّدنا من تواجده فحسب
.لم نقم بأخذه معنا

153
00:11:45,680 --> 00:11:48,560
!أيّها الأبله، هل أنت غبيّ أم ماذا؟

154
00:11:49,930 --> 00:11:52,230
.مهلاً... هكذا إذًا

155
00:11:52,230 --> 00:11:54,810
الشّريط المصغّر الّذي عثرتم عليه

156
00:11:54,810 --> 00:11:58,360
.لم يكن يحتوي صورًا عن رموز شيفرات الجيش

157
00:11:58,360 --> 00:12:00,780
.بلى، ذلك بالضّبط ما كان يحتويه

158
00:12:04,910 --> 00:12:06,410
أيّ نوع من الأغبياء

159
00:12:06,410 --> 00:12:09,540
!يسمح لجاسوس عدوّ بالإفلات من شيء كهذا؟

160
00:12:10,200 --> 00:12:13,750
،بما أنّنا تأكّدنا أنّ الرّموز قد أُخذت

161
00:12:13,750 --> 00:12:15,880
.لن يكون هنالك ضرر من الأمر إن غيّرنا تشفيرنا

162
00:12:16,420 --> 00:12:20,130
بالأحرى، فسيعود ذلك بالنّفع على
اتّصالاتنا بحيث سندفع العدوّ

163
00:12:20,130 --> 00:12:22,720
.لإضاعة وقته بفكّ شيفرة لا معنى لها

164
00:12:24,720 --> 00:12:26,890
.ربّما هذا وارد

165
00:12:26,890 --> 00:12:29,260
ماذا عن ذلك الجاسوس اللّعين؟

166
00:12:29,260 --> 00:12:32,730
لا تخبرني أنّكم ستدعونه يعود إلى بلاده؟

167
00:12:33,270 --> 00:12:36,350
.يتولّى المقدّم يوكي أمر غوردون

168
00:12:36,650 --> 00:12:38,980
.إنّه ينوي جعله يعمل لصالحنا

169
00:12:38,980 --> 00:12:40,480
!يعمل لصالحكم؟

170
00:12:40,480 --> 00:12:45,280
.نعم. لقد قال أنّه سيُحوّله إلى عميل مزدوج

171
00:12:48,030 --> 00:12:50,580
!سُحقًا! أيّها الوغد يوكي

172
00:12:50,580 --> 00:12:52,750
،الرّجل في قبضته

173
00:12:52,750 --> 00:12:55,370
!إضافة للدّليل وكلّ المجد

174
00:12:55,370 --> 00:12:57,290
!يعمل لصالحهم؟! تبًّا

175
00:12:57,290 --> 00:12:59,500
!من يظنّ نفسه؟

176
00:12:59,500 --> 00:13:01,710
!النّاس ليسوا ألعابًا

177
00:13:07,510 --> 00:13:10,350
.لديّ شيء يعود لك أيّها العقيد موتو

178
00:13:10,350 --> 00:13:13,520
شيء يعود لي؟

179
00:13:19,400 --> 00:13:21,610
.نعم، هذه لي بالفعل

180
00:13:21,980 --> 00:13:23,440
أين عثرتَ عليها؟

181
00:13:23,440 --> 00:13:26,150
.يبدو أنّها كانت على أرضيّة الرّدهة في هانابيشي

182
00:13:26,860 --> 00:13:28,910
!ها-هانابيشي؟

183
00:13:38,040 --> 00:13:41,380
.مرحبًا

184
00:13:46,590 --> 00:13:47,050
!ماذا؟

185
00:13:48,430 --> 00:13:51,680
أهذا هو ساكوما-سان... الّذي شرّفنا؟

186
00:13:52,970 --> 00:13:55,310
.أنا هنا من أجل تحقيق سرّيّ

187
00:13:55,600 --> 00:13:57,520
.لديّ بعض الأسئلة لأوجّهها لكِ

188
00:14:01,190 --> 00:14:04,980
.نعم، كان موتو-سان هنا ذلك اليوم

189
00:14:04,980 --> 00:14:08,030
كيف بدى لك في ذلك الوقت؟

190
00:14:08,360 --> 00:14:11,120
.بدى أنّه في مزاج سيّئ

191
00:14:12,620 --> 00:14:15,660
.كان هنا يشرب حتّى وقت متأخّر من اللّيل

192
00:14:16,000 --> 00:14:20,000
،إن كان هنالك زبائن آخرون حاضرون
فهل بإمكانك إخباري عنهم؟

193
00:14:20,380 --> 00:14:27,010
صحيح، كان هنالك شخص في الغرفة
.المجاورة شرب الكثير وغلبه النّعاس

194
00:14:27,840 --> 00:14:29,630
أتستطيعين وصفه لي؟

195
00:14:29,930 --> 00:14:32,550
إنّه رئيس شركة تجاريّة صغيرة

196
00:14:32,890 --> 00:14:36,310
.يأتي إلى هنا بين الفينة والأخرى

197
00:14:37,270 --> 00:14:38,730
إنّه رجل اجتماعيّ للغاية

198
00:14:39,060 --> 00:14:41,770
.قادر دائمًا على إضحاك فتيات الغيشا اليافعات عندنا

199
00:14:45,610 --> 00:14:48,780
.واضح أنّه ليس شخصًا مثيرًا للشّبهات

200
00:14:50,950 --> 00:14:55,080
هل كان يملك... أيّ صفات مميّزة؟

201
00:14:55,870 --> 00:14:56,620
،على سبيل المثال

202
00:14:57,200 --> 00:15:00,080
أيمشي مستعينًا بعكّاز بسبب ساق يسرى ضعيفة؟

203
00:15:00,080 --> 00:15:04,670
أو يرتدي فقّازًا جلديًّا أبيضًا في يده اليمنى؟

204
00:15:10,090 --> 00:15:11,470
...فهمت

205
00:15:14,850 --> 00:15:16,470
.سأغادر إذًا

206
00:15:16,760 --> 00:15:18,810
.أعتذر على إزعاجك وأنت تعملين

207
00:15:19,140 --> 00:15:20,730
!لا بأس بذلك

208
00:15:20,730 --> 00:15:22,650
،بما أنّك ذكرتَ الأمر

209
00:15:22,650 --> 00:15:26,940
قام ذلك الرّجل بمنحي شيئًا أوقعه
.موتو-سان في تلك اللّيلة

210
00:15:27,610 --> 00:15:29,740
.علبة سجائر

211
00:15:29,740 --> 00:15:33,620
.كانت فارغة، لذلك احتفظتُ بها

212
00:15:34,370 --> 00:15:37,120
،إذا كنتَ عائدًا إلى مقرّ عملك

213
00:15:37,120 --> 00:15:39,620
فهل بإمكانك إعطاؤه إيّاها؟

214
00:15:44,630 --> 00:15:46,710
إنّ إخبار أيّ أحد بتفاصيل مداهمة

215
00:15:47,500 --> 00:15:51,800
قامت بها الشّرطة العسكريّة لمنزل جاسوس
...مشتبه فيه تعتبر مخالفة للقانون

216
00:15:51,800 --> 00:15:54,140
.وإن كانت فتاة غيشا تزورها بشكل منتظم

217
00:15:59,310 --> 00:16:01,430
إضافة لذلك، قال المقدّم يوكي

218
00:16:01,430 --> 00:16:04,980
!أنّ هذه المسألة لا يجب يُعلن عنها للعموم

219
00:16:05,360 --> 00:16:07,900
.بهذا يكون تقريري قد انتهى

220
00:16:09,190 --> 00:16:10,690
...أيّها الوغد

221
00:16:11,440 --> 00:16:14,700
متى أصبحتَ تقف إلى جانبهم؟

222
00:16:17,160 --> 00:16:19,660
أنا أتّبع الأوامر فحسب

223
00:16:19,660 --> 00:16:22,870
.وأقوم بدوري كوسيط

224
00:16:23,410 --> 00:16:24,870
.اخرج

225
00:16:24,870 --> 00:16:25,460
ماذا؟

226
00:16:26,040 --> 00:16:27,960
!قلتُ لك اغرب عن وجهي

227
00:16:28,800 --> 00:16:30,630
!حاضر! عن إذنك

228
00:17:17,840 --> 00:17:20,050
.لقد أثرتَ  إعجاب ميوشي

229
00:17:22,350 --> 00:17:27,020
أنت... كنتَ ستقوم بالفعل بشقّ
بطنك حينها، أليس كذلك؟

230
00:17:28,520 --> 00:17:31,230
.أتساءل إن كنتُ بالفعل قد أثرت إعجاب ميوشي

231
00:17:31,860 --> 00:17:32,530
...رغم ذلك

232
00:17:33,440 --> 00:17:36,450
لقد أدركوا النّصف الثّاني من الوضع
.جيّدًا بشكل مسبق

233
00:17:37,360 --> 00:17:40,620
ما كنتُ أبدًا لأعتقد أنّ العقيد موتو

234
00:17:40,620 --> 00:17:44,540
.كان ليخطّط لكمين كهذا من البداية ليغطّي على خطئه

235
00:17:45,830 --> 00:17:49,000
حتّى في النهاية، لم أتمكّن حتّى من الانضمام

236
00:17:50,000 --> 00:17:51,460
...للعبة الجوكر

237
00:17:53,800 --> 00:17:56,420
هل ذلك العكّاز عبارة عن تمويه؟

238
00:17:59,510 --> 00:18:02,010
.أرى أنّك كنتَ تطرح الأسئلة

239
00:18:06,480 --> 00:18:07,390
،على سبيل المثال

240
00:18:07,890 --> 00:18:10,610
أيمشي مستعينًا بعكّاز بسبب ساق يسرى ضعيفة؟

241
00:18:10,610 --> 00:18:15,780
أو... يرتدي فقّازًا جلديًّا أبيضًا في يده اليمنى؟

242
00:18:19,280 --> 00:18:21,740
.تستطيع المشي بشكل مثاليّ دون عكّاز

243
00:18:22,530 --> 00:18:25,790
.وترتدي قفّازًا جلديًّا أبيضًا عندما تتمشّى بالعكّاز

244
00:18:26,790 --> 00:18:30,250
إنّ امتلاك مظهر سهل التّذكّر وجليٌّ للعيان كهذا

245
00:18:30,250 --> 00:18:32,040
.يُسهّل من مسألة تمويه نفسك

246
00:18:32,920 --> 00:18:34,500
،ونتيحة لذلك

247
00:18:35,050 --> 00:18:39,430
لا يتمّ منح أيّ اعتبار ليدك اليسرى
.لأنّها لا تجذب ما يكفي من الانتباه

248
00:18:40,930 --> 00:18:43,970
يدك اليسرى عبارة عن طرف اصطناعيّ، صحيح؟

249
00:18:47,930 --> 00:18:51,400
طلبتُ من خبير جنائيّ في الجامعة
.الإمبراطوريّة أن يقوم بفحصٍ من أجلي

250
00:18:51,810 --> 00:18:56,320
.لم تكن هنالك بصمات على علبة السّجائر

251
00:18:57,690 --> 00:19:00,490
،ولأكون أكثر دقّة، كانت هنالك بصمات العقيد موتو

252
00:19:00,950 --> 00:19:02,450
،وبصمات مالكة هانابيشي

253
00:19:03,660 --> 00:19:07,870
،وبصماتي أنا هي الوحيدة الّتي تمّ العثور عليها

254
00:19:09,960 --> 00:19:10,830
،بعبارات أخرى

255
00:19:11,420 --> 00:19:15,420
البصمات الوحيدة النّاقصة هنا هي بصمات
.الزّبون الّذي عثر على العلبة

256
00:19:17,460 --> 00:19:20,380
إنّ ارتداء قفّاز في يدك اليمنى يجعل المرء يعتقد

257
00:19:20,380 --> 00:19:23,300
.أنّ تلك اليد هي الّتي تعرّضت للإصابة

258
00:19:23,510 --> 00:19:26,930
لكن في الواقع، إنّها يدك اليسرى

259
00:19:26,930 --> 00:19:28,770
.الّتي خسرتها خلال مهمّة سابقة

260
00:19:33,690 --> 00:19:35,480
...ذلك الوغد موتو

261
00:19:36,860 --> 00:19:40,820
حتّى أنا لم أتوقّعه أن يكون غبيًّا كفاية ليثمل

262
00:19:41,450 --> 00:19:44,620
،ويبدأ بالثّرثرة بأسرار دولة لفتاة غيشا

263
00:19:45,070 --> 00:19:47,370
بل وأنهى الأمر بإسقاط شيء
.يخصّه في ردهة ذلك المكان

264
00:19:48,790 --> 00:19:51,160
،بعدما غادر موتو في الحال

265
00:19:51,540 --> 00:19:54,500
.ذهبتُ إلى الرّدهة ورأيتُ علبة سجائره

266
00:19:55,710 --> 00:19:58,590
.كنتُ ممسكًا بفتاة الغيشا بيدي اليمنى

267
00:19:59,130 --> 00:20:00,420
،وحسب ذلك الوضع

268
00:20:00,840 --> 00:20:03,840
لكان من غير الطّبيعيّ ألاّ ألتقط
.العلبة بيدي اليسرى

269
00:20:05,180 --> 00:20:08,220
،أعطيتها لمالكة المكان وغادرتُ في تلك اللّيلة

270
00:20:08,510 --> 00:20:11,180
.لكنّي لم أتوقّع أن تقوم بفحصها

271
00:20:15,310 --> 00:20:16,900
،بما أنّنا أسدينا له خدمة الآن

272
00:20:16,900 --> 00:20:20,110
.لا يملك موتو أيّ خيار سوى التّعاون مع الوكالة دي

273
00:20:20,570 --> 00:20:24,490
.فنحن مجموعة فقيرة بميزانيّة ضئيلة قبل كلّ شيء

274
00:20:27,280 --> 00:20:31,040
كان المقدّم يوكي يتبع العقيد موتو

275
00:20:31,540 --> 00:20:34,620
!للحصول على تمويل أكثر من مكتب الأركان العامّة

276
00:20:43,220 --> 00:20:44,260
...أخبرني

277
00:20:45,760 --> 00:20:48,220
هل لديك أيّ نيّة باجتياز تدريبنا؟

278
00:20:54,640 --> 00:20:57,690
.أنا جنديّ بكلّ جوارحي

279
00:20:58,360 --> 00:21:01,900
.أنا جاهز للتّضحية بنفسي في لحظتها ودون تحذير

280
00:21:03,610 --> 00:21:04,360
...ولكن

281
00:21:31,720 --> 00:21:32,600
،ولكن

282
00:21:36,850 --> 00:21:40,820
.أرفض أن أكون بيدقًا يتمّ استغلاله ثمّ يُلقى جانبًا

283
00:23:19,960 --> 00:23:23,830
في الحلقة القادمة

284
00:23:21,710 --> 00:23:23,750
أتتذكّر تلك الحادثة؟

285
00:23:24,540 --> 00:23:25,380
...كلاّ

286
00:23:25,880 --> 00:23:27,130
.لا تقلق بشأن ذلك

287
00:23:27,590 --> 00:23:29,550
.الذّكريات غير مهمّة

288
00:23:32,510 --> 00:23:34,140
.كان ذلك القرار الأصح