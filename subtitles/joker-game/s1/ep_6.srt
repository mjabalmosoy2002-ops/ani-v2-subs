1
00:01:51,250 --> 00:01:52,920
...أشعر بالملل

2
00:01:53,380 --> 00:01:55,510
.اسمع، لنفعل شيئًا ما

3
00:01:55,710 --> 00:01:57,170
مثل ماذا؟

4
00:01:57,470 --> 00:01:58,380
!أخي

5
00:01:59,720 --> 00:02:01,140
ما الّذي تقرأه؟

6
00:02:01,140 --> 00:02:02,680
.رحلات تاكاراجيما الاستكشافيّة

7
00:02:04,060 --> 00:02:05,520
!لنذهب لاكتشاف القطار

8
00:02:05,930 --> 00:02:07,140
...أرغب ذلك، لكن

9
00:02:07,600 --> 00:02:09,390
.ليس مسموحًا لكما بالتّجوال

10
00:02:09,390 --> 00:02:11,110
.صحيح

11
00:02:11,110 --> 00:02:13,440
.كانت العقدة على ذلك الكيمونو رائعة

12
00:02:13,440 --> 00:02:14,530
.معك حقّ

13
00:02:13,690 --> 00:02:16,280
أخبريني، هل يمكننا اكتشاف القطار؟

14
00:02:16,280 --> 00:02:18,030
.اجلس مكانك وابق صامتًا

15
00:02:18,030 --> 00:02:20,110
!إنّنا نشعر بالملل

16
00:02:20,110 --> 00:02:21,620
!اسمع. ابق صامتًا

17
00:03:43,910 --> 00:03:48,410
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

18
00:03:49,240 --> 00:03:53,920
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

19
00:03:55,420 --> 00:03:57,790
يتمّ التّعامل مع ماضي وأسماء

20
00:03:57,790 --> 00:04:00,960
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

21
00:04:00,960 --> 00:04:04,090
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

22
00:04:04,840 --> 00:04:07,850
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

23
00:04:07,850 --> 00:04:09,810
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

24
00:04:10,270 --> 00:04:12,730
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

25
00:04:13,230 --> 00:04:15,810
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

26
00:04:16,770 --> 00:04:20,480
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

27
00:04:21,240 --> 00:04:23,950
."اسمها هو "الوكالة دي

28
00:05:56,960 --> 00:05:58,330
.أنطون موروزوف

29
00:05:59,370 --> 00:06:03,050
أمين من الرّتبة الثّانية يعمل لدى
.قنصليّة الاتّحاد السّوفياتيّ في مانشوريا

30
00:06:05,550 --> 00:06:06,880
،قبل نصف سنة

31
00:06:07,220 --> 00:06:11,600
حرقنا" ماضيه الزّاخر بسرف المال"
.على فتاة في نادي هاربين اللّيليّ

32
00:06:14,060 --> 00:06:18,230
قبل ثلاثة أيّام، أرسل موروزوف إرساليّة عاجلة

33
00:06:18,230 --> 00:06:20,020
.عبر جريدة إعلانات مبوّبة

34
00:06:20,810 --> 00:06:22,900
،بالنّظر إلى مبلغ المال الكبير الّذي طلبه

35
00:06:23,150 --> 00:06:26,150
.اعتقدنا أنّه يملك معلومات بالغة السّرّيّة

36
00:06:27,820 --> 00:06:29,610
سيتمّ طباعة المعلومات

37
00:06:29,910 --> 00:06:31,780
.على الجريدة الّتي ستكون بحوزته

38
00:06:32,910 --> 00:06:34,950
تنصّ الخطّة أن يتمّ التّبادل بعد اللّقاء في غرفة الغسل

39
00:06:35,290 --> 00:06:37,750
...والتّأكّد من هويّة بعضهما بعضًا

40
00:06:50,260 --> 00:06:51,430
...منظّمة سميرش

41
00:06:51,760 --> 00:06:53,390
الموت للجواسيس؟

42
00:06:54,260 --> 00:06:55,720
...الرّجل المعلّق

43
00:06:56,010 --> 00:06:59,310
.يهوذا، الرّجل الّذي خان المسيح عيسى

44
00:06:59,980 --> 00:07:03,560
المنظّمة السّرّيّة الّتي تقتل الخونة

45
00:07:03,560 --> 00:07:05,190
.بلا رحمة في الاتّحاد السّوفياتيّ

46
00:07:05,730 --> 00:07:09,150
من وجهة نظرهم، فإمّا أن تكرّس حياتك للثّورة

47
00:07:09,570 --> 00:07:11,820
.أو تلقى حتفك

48
00:07:13,530 --> 00:07:16,080
وهو نفس المنهج الّذي يتّبعه بعض المتعصّبون في الجيش

49
00:07:16,080 --> 00:07:17,870
."المهووسون بـ"القانون العسكريّ

50
00:07:26,090 --> 00:07:29,420
بما أنّ القاتل يملك الآن الجريدة
،الّتي تضمّ الرّسالة المشفّرة

51
00:07:29,710 --> 00:07:31,510
.فربّما سينزل في المحطّة التّالية في موكدين

52
00:07:32,260 --> 00:07:33,340
...سوف نصل بعد

53
00:07:34,010 --> 00:07:36,180
.أكثر من ساعة

54
00:07:42,690 --> 00:07:44,310
،إذا رأينا الأمر من وجهة نظر التّوقيت

55
00:07:44,310 --> 00:07:47,360
.فعلى الأرجح أنّه سيقابل موروزوف في غرفة الغسل

56
00:07:48,070 --> 00:07:48,690
،ولكن

57
00:07:49,530 --> 00:07:52,650
،كان موروزوف على علم تامّ أنّه خائن

58
00:07:52,990 --> 00:07:55,160
.ويخشى أن يتمّ قتله

59
00:07:57,330 --> 00:07:59,490
إن كان ذلك الشّخص المشبوه

60
00:07:59,490 --> 00:08:01,620
،قاتلاً من منظّمة سميرش بالفعل

61
00:08:02,120 --> 00:08:05,000
فمن المستحيل أن يكون موروزوف قد أدار
.ظهره وترك نفسه بلا حماية

62
00:08:07,840 --> 00:08:11,420
هل فعل شيئًا ما ليدفع موروزوف على إرخاء دفاعاته؟

63
00:08:15,930 --> 00:08:17,140
...أم أنّه

64
00:08:21,020 --> 00:08:23,480
أخبرنا يا سيّدي، هل أنت ساحر؟

65
00:08:23,770 --> 00:08:26,100
.كلاّ، هذه مجرّد هواية صغيرة أقوم بها

66
00:08:27,560 --> 00:08:29,520
أيمكنك أن ترينا خدعة أخرى؟

67
00:08:29,520 --> 00:08:30,530
.لا أستطيع

68
00:08:30,780 --> 00:08:32,110
...هكذا إذًا

69
00:08:33,400 --> 00:08:34,950
...كان الشّاي لذيذًا

70
00:08:35,160 --> 00:08:38,410
.أتعلم يا سيّدي؟ أخي رائع أيضًا

71
00:08:38,410 --> 00:08:41,330
.إنّه يعرف كلّ شيء عن قطار آسيا

72
00:08:41,330 --> 00:08:44,330
.ليس عليك إخباره بذلك، فهو لا يهتمّ

73
00:08:44,960 --> 00:08:47,880
،يعمل والدنا في شركة سكك مانشوريا الجنوبيّة الحديديّة

74
00:08:47,880 --> 00:08:51,090
.لذلك أنا أعرف أشياء أكثر من باقي الأطفال

75
00:08:51,090 --> 00:08:52,300
فعلاً؟

76
00:08:52,760 --> 00:08:54,130
.أخبرني بعضها رجاءً

77
00:08:55,550 --> 00:08:56,640
...حسنًا، كبداية

78
00:08:57,510 --> 00:09:00,390
،سرعة قطار آسيا القصوى في 110 كيلومترات

79
00:09:00,390 --> 00:09:03,930
لذلك يستطيع قطع مسافة 704.1 كيلومتر بين شينجين

80
00:09:03,930 --> 00:09:06,440
.وداليان في ثمانِ ساعات وعشرين دقيقة

81
00:09:07,350 --> 00:09:08,480
شيء كهذا؟

82
00:09:08,810 --> 00:09:11,480
!كان محقًّا. أنت تعرف الكثير

83
00:09:11,480 --> 00:09:12,530
أرأيت؟

84
00:09:14,400 --> 00:09:18,200
كان قطارَ السّكّة الحديديّة المميّز قبل
،قطارِ آسيا يسمّى قطار الحمامة

85
00:09:18,570 --> 00:09:20,490
،لكنّه كان أبطأ قليلاً من قطار السّنونو

86
00:09:20,490 --> 00:09:23,410
وهو القطار الخاصّ الّذي يربط بين طوكيو وكوبي

87
00:09:23,410 --> 00:09:25,290
.على خطّ توكايدو الرّئيسيّ

88
00:09:25,580 --> 00:09:29,420
بالنّسبة للطّيور الحقيقيّة، فإنّ طائر
.السّنونو أسرع بكثير من الحمام

89
00:09:30,040 --> 00:09:33,420
لذلك بنت شركة سكك مانشوريا
الجنوبيّة الحديديّة هذا القطار

90
00:09:33,420 --> 00:09:34,760
.المسمّى آسيا ليهزم قطار السّنونو

91
00:09:35,050 --> 00:09:37,630
!إنّه أسرع لأنّه يمتلك خطًّا أكثر انسيابيّة

92
00:09:38,800 --> 00:09:42,350
.معدّل سرعة قطار آسيا هو 88.2 كيلومترًا في السّاعة

93
00:09:42,350 --> 00:09:44,520
!إنّه القطار الأسرع في الشّرق

94
00:09:44,810 --> 00:09:45,810
.مذهل

95
00:09:46,390 --> 00:09:48,020
.أنت تعرف الكثير عنه بالفعل

96
00:09:48,310 --> 00:09:50,400
أين ستنزلون أيّها الفتية؟

97
00:09:50,400 --> 00:09:51,820
.في داليان

98
00:09:51,820 --> 00:09:54,480
.أمامنا... ستّة ساعات قبل أن ننزل

99
00:09:54,900 --> 00:09:58,740
.شعرنا بالملل، لذلك قرّرنا أن نكتشف القطار

100
00:09:59,530 --> 00:10:01,910
.بقيت خمسة وأربعون دقيقة قبل أن نبلغ موكدين

101
00:10:03,620 --> 00:10:07,330
.حسنًا أيّها الفتية، لديّ أحجية لكم

102
00:10:09,040 --> 00:10:12,420
،إذا نزلتُ في محطّة موكدين التّالية
كيف أستطيع أن أبعث رسالة

103
00:10:12,420 --> 00:10:16,210
،إلى الوجهة الأخيرة للقطار في داليان

104
00:10:16,210 --> 00:10:17,840
أسرع من قطار آسيا؟

105
00:10:17,840 --> 00:10:20,300
ألم تكن تستمع لي يا سيّدي؟

106
00:10:20,300 --> 00:10:23,310
!قطار آسيا هو القطار الأسرع في الشّرق

107
00:10:23,310 --> 00:10:25,850
.لا يوجد ما قد يصل إلى هناك قبل قطار آسيا

108
00:10:25,850 --> 00:10:28,440
.أيّها الغبيّ، فكّر في الأمر قليلاً

109
00:10:28,440 --> 00:10:29,690
ماذا؟

110
00:10:30,020 --> 00:10:32,110
!عرفت، عبر طائرة

111
00:10:32,110 --> 00:10:34,400
وأين ستجد طائرة؟

112
00:10:34,400 --> 00:10:36,570
.لن تستطيع الذّهاب إلى مطارٍ في الوقت المناسب

113
00:10:36,570 --> 00:10:37,990
...صحيح

114
00:10:40,240 --> 00:10:42,490
أستسلم. ما هو الجواب؟

115
00:10:45,660 --> 00:10:48,660
.لديّ مهمّة استكشافيّة لكم

116
00:10:49,210 --> 00:10:50,370
مهمّة؟

117
00:10:50,620 --> 00:10:52,960
.اليوم هو الخامس والعشرون من يوليوز

118
00:10:53,340 --> 00:10:56,670
مهمّتكم هي العثور على شخص يقرأ جريدة

119
00:10:56,960 --> 00:11:00,300
...صدرت في الرّابع والعشرين أو الثّالث والعشرين
،جريدة ذات تاريخ قديم

120
00:11:00,760 --> 00:11:01,800
ثمّ ألقوا بشكل سرّيّ

121
00:11:02,680 --> 00:11:05,760
.ورقة التاروت هذه بين قدميه

122
00:11:06,310 --> 00:11:09,680
.تعالوا إليّ مباشرة بمجرّد أن تلقوا الورقة

123
00:11:10,100 --> 00:11:11,020
مفهوم؟

124
00:11:12,690 --> 00:11:16,650
إنّه في مقطورة الدّرجة الثّالثة
.الّتي أمام هذه المقطورة

125
00:11:16,980 --> 00:11:20,700
.أخبروني ما الملابس الّتي يرتديها عندما تعودون

126
00:11:21,400 --> 00:11:23,990
،بمجرّد أن تنهوا مهمّتكم بنجاح

127
00:11:24,370 --> 00:11:26,660
.سأخبركم بالإجابة

128
00:11:26,950 --> 00:11:29,830
...ليس من المفترض أن نتجوّل في الأرجاء

129
00:11:31,250 --> 00:11:34,630
.لا تقلق، سنقول أنّنا ذاهبون للحمّام فحسب

130
00:11:38,670 --> 00:11:39,880
تحتوي الجريدة

131
00:11:40,550 --> 00:11:43,260
على معلومات مشفّرة

132
00:11:43,260 --> 00:11:45,680
.تمّ الإشارة لها باستعمال حبر سرّيّ خاصّ

133
00:11:47,470 --> 00:11:49,220
إنّها مهمّة صعبة بالنّسبة لمبتدئ مثل موروزوف

134
00:11:49,220 --> 00:11:53,230
.ليستطيع إنجازها مستعملاً جريدة اليوم

135
00:11:55,360 --> 00:11:58,940
.على الأرجح أنّه استعمل جريدة قديمة

136
00:12:33,480 --> 00:12:35,560
!أخي، انتظر

137
00:13:01,420 --> 00:13:02,510
!وجدناه

138
00:13:04,840 --> 00:13:07,260
.كان في المقطورة الرّابعة لمسافري الدّرجة الثّالثة

139
00:13:07,260 --> 00:13:08,890
.لقد ألقينا الورقة أيضًا

140
00:13:08,890 --> 00:13:09,930
.أحسنتم عملاً

141
00:13:09,930 --> 00:13:11,470
هل تتذكّرون ما كان يرتديه؟

142
00:13:11,680 --> 00:13:12,350
...سترة بيضاء

143
00:13:12,350 --> 00:13:14,520
!سترة بيضاء وسروالاً أسودًا

144
00:13:15,310 --> 00:13:17,940
.كانت بطانة سترته سوداء أيضًا

145
00:13:18,480 --> 00:13:19,440
.شكرًا لكم

146
00:13:19,900 --> 00:13:21,440
.أنتم كشّافة رائعون يا فتيان

147
00:13:21,860 --> 00:13:23,400
هل أستطيع أن أدعوكم على بعض العصير؟

148
00:13:23,650 --> 00:13:24,690
فعلاً؟

149
00:13:27,110 --> 00:13:28,620
...حسنًا

150
00:13:28,990 --> 00:13:30,660
.أريد عصير ليمون

151
00:13:35,540 --> 00:13:36,830
!ما الّذي تفعلونه؟

152
00:13:38,120 --> 00:13:39,880
.أنا في غاية الأسف

153
00:13:39,880 --> 00:13:42,090
.لا، لا، لا داعي للاعتذار

154
00:13:42,670 --> 00:13:46,550
.شعرتُ بالملل أنا أيضًا، لذلك كنا نتحدّث أنا والفتية

155
00:13:46,840 --> 00:13:48,970
.هيّا، عودوا إلى مقاعدكم

156
00:13:48,970 --> 00:13:53,260
ماذا؟ لكنّه كان على وشك أن يخبرنا
!بجواب الأحجية

157
00:13:53,770 --> 00:13:56,180
.أعد أن أخبركم لاحقًا

158
00:13:56,730 --> 00:13:58,900
.أمّا الآن، من الأفضل أن تستمعوا لوالدتكنّ

159
00:13:59,560 --> 00:14:00,940
...حاضر

160
00:14:08,570 --> 00:14:10,110
.بقيت عشرون دقيقة

161
00:14:22,340 --> 00:14:25,300
.سنصل إلى موكدين قريبًا

162
00:14:25,590 --> 00:14:29,590
،أيّها المسافرون المغادرون
.احرصوا ألاّ تنسوا أيّ شيء خلفكم

163
00:14:32,720 --> 00:14:35,430
،سيّداتي وسادتي، من أجل سلامتكم

164
00:14:35,430 --> 00:14:38,810
.الزموا أماكنكم حتّى يتوقّف القطار بشكل كامل

165
00:14:42,810 --> 00:14:45,690
.سوف نصل إلى موكدين قريبًا

166
00:14:45,690 --> 00:14:50,110
،أيّها المسافرون المغادرون
.احرصوا ألاّ تنسوا أيّ شيء خلفكم

167
00:14:53,740 --> 00:14:57,540
.المعذرة، سوف نصل إلى موكدين قريبًا

168
00:15:01,580 --> 00:15:03,080
.لا تخرجي. استمعي فحسب

169
00:15:03,330 --> 00:15:06,090
.العدوّ على علم بهويّتنا

170
00:15:06,380 --> 00:15:08,880
—لكنّه لا يشكّ بعد في قاطع التّذاكر، أنا

171
00:15:30,280 --> 00:15:33,320
...كيف... قمتَ

172
00:15:34,280 --> 00:15:37,120
،كان موروزوف يخشى أن يتمّ قتله
لذلك كان يجب أن يكون أحدًا

173
00:15:37,120 --> 00:15:39,540
.يستطيع التّسلّل دون إثارة الشّبهات

174
00:15:40,200 --> 00:15:42,750
.شخص ما كقاطع التّذاكر

175
00:15:43,630 --> 00:15:46,670
.اهدأ. أنا لستُ قاتلاً مثلك أنت

176
00:15:47,170 --> 00:15:48,550
.أحلامًا سعيدة

177
00:15:50,090 --> 00:15:52,590
...سُحقًا لك

178
00:16:02,100 --> 00:16:03,390
،انتهى الأمر

179
00:16:03,900 --> 00:16:05,100
.يا آنسة إلينا

180
00:16:11,280 --> 00:16:14,160
.لم يكن أنطون موروزوف وحده

181
00:16:14,910 --> 00:16:17,580
كنتِ ستهربين من البلاد برفقته، أليس كذلك؟

182
00:16:20,950 --> 00:16:23,250
.كلّ شيء جاهز. لا مشاكل

183
00:16:23,580 --> 00:16:25,630
.تساوي المعلومات الكثير من المال

184
00:16:26,080 --> 00:16:29,920
.سنهرب إلى اليابان، ثمّ إلى أمريكا

185
00:16:32,760 --> 00:16:34,760
.هيّا، لنعد إلى غرفتنا

186
00:16:38,010 --> 00:16:39,100
.المعذرة

187
00:16:41,180 --> 00:16:43,850
،القاتل الّذي أدرك أنّي على متن القطار

188
00:16:44,190 --> 00:16:46,560
احتاج للوقت لقتل موروزوف

189
00:16:46,560 --> 00:16:48,310
.والتّخلّص من الدّليل

190
00:16:51,150 --> 00:16:54,780
،لقد وقفتِ أمام غرفتك عن قصد
بغرض سدّ الطّريق

191
00:16:54,780 --> 00:16:58,700
بين مقطورة الدّرجة الأولى والرّدهة
.لتوفير الوقت الّذي يحتاجه

192
00:17:10,090 --> 00:17:11,550
،بعبارات أخرى

193
00:17:11,840 --> 00:17:14,550
.كنتِ متعاونة مع القاتل

194
00:17:17,260 --> 00:17:19,550
...لقد هدّدوني

195
00:17:20,180 --> 00:17:23,930
.كلاّ، اخترتِ أن تخونيه بملء إرادتك

196
00:17:24,560 --> 00:17:28,100
.لم تكن لديك أيّ نيّة بالذّهاب إلى أمريكا

197
00:17:34,490 --> 00:17:35,740
.لا تقلقي

198
00:17:36,400 --> 00:17:38,950
.لا أنوي تسليمكما إلى منظّمة سميرش

199
00:17:43,240 --> 00:17:43,950
...لكن

200
00:17:46,160 --> 00:17:49,420
.لكنّي أتوقّع أنّك ستذهبين للعمل من أجل اليابان

201
00:18:30,210 --> 00:18:33,250
.الشّيء الوحيد الأسرع من قطار آسيا هو الحمامة

202
00:18:33,630 --> 00:18:34,590
!ماذا؟

203
00:18:34,590 --> 00:18:36,760
!هذه ليست الإجابة

204
00:18:36,760 --> 00:18:39,720
!حتّى قطار السّنونو أسرع من قطار الحمامة

205
00:18:40,220 --> 00:18:44,010
وسرعة قطار آسيا الّتي تبلغ 80 كيلومترًا
!في السّاعة تفوق قطار السّنونو

206
00:18:44,470 --> 00:18:46,720
.هنالك أنواع مختلفة من الحمام

207
00:18:46,720 --> 00:18:47,730
...حسنًا

208
00:18:48,600 --> 00:18:49,440
.ألقوا نظرة

209
00:18:59,280 --> 00:19:01,450
.مانشوريا بلد ماكر

210
00:19:01,860 --> 00:19:04,330
.يتمّ مراقبة كلّ الاتّصالات عبر التّيليغرام

211
00:19:04,620 --> 00:19:07,910
.يجب على المرء أن يفترض أنّ رسالته سيتمّ اعتراضها

212
00:19:09,580 --> 00:19:12,710
،ولضمان سلامتنا نحن الاثنين
كنتُ أحتاج لطريقة لأتواصل

213
00:19:12,710 --> 00:19:15,210
مع عميل "الوكالة دي" الّذي ينتظر
في نهاية الخطّ في داليان

214
00:19:15,500 --> 00:19:19,470
.وكان ذلك أسرع حتّى من قطار آسيا

215
00:19:20,630 --> 00:19:21,880
،ومع الرّياح الخلفيّة

216
00:19:22,180 --> 00:19:24,930
تستطيع سرعة الحمام الزّاجل أن تصل
.إلى 100 كيلومتر في السّاعة

217
00:19:25,560 --> 00:19:27,600
،ومع الرّياح الّتي تهبّ في مثل هذا الوقت من السّنة

218
00:19:27,890 --> 00:19:31,690
حسَبتُ أنّ حمامة زاجلة ستستطيع
.الوصول إلى داليان بشكل أسرع

219
00:19:33,560 --> 00:19:37,530
عرفنا تفاصيل تحرّكات الاتّحاد
.السّوفياتيّ من معلومات موروزوف

220
00:19:37,530 --> 00:19:39,650
.اتّضح أنّها كانت ذات قيمة كبيرة

221
00:19:40,110 --> 00:19:43,870
لكنّ المشكلة الحقيقيّة تبدأ الآن بما
.أنّ "الوكالة دي" تملك تلك المعلومات

222
00:19:45,870 --> 00:19:49,120
في الآونة الآخيرة، أشعر أنّ المعلومات
الّتي نعمل بجدّ للحصول عليها

223
00:19:49,120 --> 00:19:51,290
.لا يتمّ استعمالها بشكل فعّال

224
00:19:52,920 --> 00:19:56,170
.استعمال المعلومة أصعب من الحصول عليها

225
00:19:56,960 --> 00:19:59,670
ففي مواجهة كبار الضّبّاط العنيدين
،في الجيش الإمبراطوريّ

226
00:19:59,960 --> 00:20:02,630
،فمهما قاتل المقدّم يوكي

227
00:20:02,880 --> 00:20:05,550
.فلا نستطيع تحقيق الكثير

228
00:20:06,430 --> 00:20:09,640
.الجواسيس مفيدون في أوقات السِّلم فقط

229
00:20:10,180 --> 00:20:12,310
،بمجرّد أن تندلع الحرب

230
00:20:12,600 --> 00:20:15,020
.يختفي معنى تواجدنا

231
00:20:20,150 --> 00:20:21,650
.حسنًا، ما باليد يحلة

232
00:20:22,570 --> 00:20:24,610
.كلّ ما أستطيع فعله هو ما أستطيع فعله

233
00:22:18,770 --> 00:22:22,400
بشأن الجاسوس السوفياتيّ
...الّذي احتُجز في مانشوريا

234
00:22:22,400 --> 00:22:25,070
."لقد وقعت المعلومة بين يدي "الوكالة دي

235
00:22:25,570 --> 00:22:27,990
.وتركوه ينجو بحياته

236
00:22:28,490 --> 00:22:32,030
لا تموتوا، لا تقتلوا"... إنّهم هم ثانية؟"

237
00:22:32,660 --> 00:22:35,040
!إنّهم كالتّفّاحة الفاسدة

238
00:22:35,330 --> 00:22:37,620
إنّ لديهم تأثيرًا سلبيًّا بكلّ تأكيد

239
00:22:37,620 --> 00:22:40,620
.على جيش اليابان الإمبراطوريّ العظيم

240
00:22:40,880 --> 00:22:42,000
،ولكن

241
00:22:42,340 --> 00:22:46,510
ليس بالأمر الجلل امتلاكُ وكالة استخباراتيّة

242
00:22:46,510 --> 00:22:48,720
.تخدم قانون الجيش الإمبراطوريّ

243
00:22:49,010 --> 00:22:51,890
هل تمّ منحهم الموافقة؟

244
00:22:52,720 --> 00:22:53,600
...نعم

245
00:22:54,510 --> 00:22:58,520
.آن الأوان ليقوم فتية "الوكالة دي" بالمغادرة

246
00:23:20,750 --> 00:23:23,330
ألم يكن هنالك فنّان قارن الحياة برحلة بحريّة؟

247
00:23:23,630 --> 00:23:27,590
تبدأ بالتّجذيف من جدول صغير
،وتستمتع بالمنظر السّاكن

248
00:23:27,590 --> 00:23:29,760
...تتحمّل الرّياح وتنجو من العواصف

249
00:23:29,760 --> 00:23:31,720
.وتسكب في المحيط

250
00:23:31,840 --> 00:23:34,680
.ما ينتظرنا خلفه هو حرّيّة بلا قيود