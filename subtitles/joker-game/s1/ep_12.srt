1
00:00:09,610 --> 00:00:12,950
أهكذا تتصرّف عندما تتلقّى أمرًا أيّها الغرّ؟

2
00:00:13,610 --> 00:00:15,160
.نقوم بهذا من أجل بلادنا

3
00:00:15,160 --> 00:00:18,030
.عليك أن تفرح إذا متّ
!لا تدع الموت يوقفك عند حدّك

4
00:00:18,030 --> 00:00:18,830
...حاضر

5
00:00:20,240 --> 00:00:23,370
اسمح لي يا سيّدي، لكن يبدو من الحماقة

6
00:00:23,370 --> 00:00:26,170
!أن نكون فرحين بالموت لمجرّد تمرين تدريبيّ

7
00:00:27,140 --> 00:00:28,090
...كما أنّي

8
00:00:28,460 --> 00:00:30,840
لا أعتقد أنّ هؤلاء الرّجال
.مناسبون ليكونوا كشّافة

9
00:00:32,340 --> 00:00:34,170
أقلت لمجرّد تمرين تدريبيّ؟

10
00:00:35,180 --> 00:00:36,300
!توبيساكي

11
00:00:36,300 --> 00:00:39,810
هل تحاول القول وأنت جنديّ
،أقسم بالولاء للجيش

12
00:00:39,810 --> 00:00:43,270
!أنّ أوامر ضابطك الأعلى "حمقاء"؟

13
00:00:43,680 --> 00:00:45,770
—كلاّ يا سيّدي! أنا فقط

14
00:00:45,770 --> 00:00:47,650
!لا تحاول التّبرير

15
00:00:47,860 --> 00:00:50,610
!كفّ عن الشّكوى وتحرّك

16
00:01:00,450 --> 00:01:02,200
!أمسكوه

17
00:01:03,000 --> 00:01:06,370
!العنف ضدّ ضابط أعلى
!رفض الامتثال للأوامر

18
00:01:29,020 --> 00:01:32,520
هل أنت هو من يدعونه بـ"الّذي لا يمكن تدريبه"؟

19
00:01:34,110 --> 00:01:37,400
هل لديك أيّ مخطّطات بعد تركك للجيش؟

20
00:01:38,990 --> 00:01:40,160
.سؤال وجيه

21
00:01:41,080 --> 00:01:42,530
ربّما سأنتقل إلى مانشوريا

22
00:01:42,950 --> 00:01:44,580
.وأصبح قاطع طريق متنقّل

23
00:01:48,210 --> 00:01:51,960
.إن أردت، يمكنك أن تأتي للخضوع لامتحاني

24
00:01:57,510 --> 00:02:02,100
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

25
00:02:02,970 --> 00:02:07,430
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

26
00:02:08,480 --> 00:02:10,770
يتمّ التّعامل مع ماضي وأسماء

27
00:02:11,060 --> 00:02:14,820
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

28
00:02:14,820 --> 00:02:18,240
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

29
00:02:19,530 --> 00:02:22,950
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

30
00:02:22,950 --> 00:02:24,870
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

31
00:02:25,330 --> 00:02:27,790
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

32
00:02:28,160 --> 00:02:30,250
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

33
00:02:31,080 --> 00:02:34,630
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

34
00:02:35,340 --> 00:02:37,970
."اسمها هو "الوكالة دي

35
00:04:15,060 --> 00:04:16,770
!ليتّصل أحدكم بالشّرطة

36
00:04:16,980 --> 00:04:18,440
!اتّصلوا بالشّرطة رجاءً

37
00:04:21,490 --> 00:04:22,900
ما الّذي يحدث؟

38
00:04:24,490 --> 00:04:25,740
أهو ميت؟

39
00:04:27,570 --> 00:04:28,870
هل قُتل؟

40
00:04:34,460 --> 00:04:36,750
.الهدف الّذي كنتُ أراقبه قد مات

41
00:04:37,920 --> 00:04:39,920
.كان فشلاً لا يُغتفر

42
00:04:45,680 --> 00:04:48,720
.المتوفّى رجل ألماني يُدعى كارل شنايدر

43
00:04:49,220 --> 00:04:52,930
،"للعلن، كان كاتبًا لجريدة "برلين العامّة

44
00:04:53,430 --> 00:04:56,650
إلاّ أنّه قد اشتُبه به كعميل مزدوج
.لألمانيا والاتّحاد السّوفياتيّ

45
00:04:57,560 --> 00:05:01,440
اشترى شنايدر أزهارًا من بائع
على الشّارع في يوم الحادثة

46
00:05:01,820 --> 00:05:05,570
واتّجه إلى شقّة حبيبته نوغامي يوريكو
.الّتي تعمل كممثّلة مسرحيّة

47
00:05:06,240 --> 00:05:07,910
لقد التقيا قبل سنة

48
00:05:07,910 --> 00:05:10,700
عن طريق أحد أصدقاء نوغامي
.وبدآ بمواعدة بعضهما

49
00:05:11,370 --> 00:05:15,370
قام شنايدر بتجهيز الشّقّة الّتي نحن
.بصددها من أجل يوريكو

50
00:05:16,670 --> 00:05:19,540
،كانت نوغامي في الخارج ذلك اليوم

51
00:05:20,000 --> 00:05:22,590
لكنّها عادت بعد الثّالثة عصرًا رفقة صديقة لها

52
00:05:22,590 --> 00:05:25,130
.تُدعى ياسوهارا ميوكو تعمل كممثّلة أيضًا

53
00:05:25,470 --> 00:05:26,840
،حسب التّقرير

54
00:05:26,840 --> 00:05:29,680
.كانتا قد اتّفقتا على تناول الكعك معًا

55
00:05:30,430 --> 00:05:33,720
،وبالنّسبة إلى موت شنايدر
اعتبرته الشّرطة انتحارًا

56
00:05:34,390 --> 00:05:37,140
.ولن تتحرّى في الأمر أكثر من ذلك

57
00:05:38,440 --> 00:05:41,400
هل من المرجّح أن يكون شنايدر
قد أدرك أنّك تراقبه

58
00:05:41,770 --> 00:05:45,110
وقرّر ألاّ فرصة أمامه للهرب وقتل نفسه؟

59
00:05:45,650 --> 00:05:48,780
.كان شنايدر جاسوسًا من النّخبة

60
00:05:49,870 --> 00:05:51,910
فكرة اختياره للموت

61
00:05:52,450 --> 00:05:54,620
.تبدو غير طبيعيّة لي

62
00:05:55,080 --> 00:05:57,080
.ومع ذلك، المشكلة هي رسالة الانتحار

63
00:05:57,710 --> 00:05:59,420
كيف تفسّرها؟

64
00:06:00,540 --> 00:06:03,300
.قال محلّل خطوط اليد أنّه هو من كتبها

65
00:06:03,750 --> 00:06:05,090
،باختصار يا أوداغيري

66
00:06:05,090 --> 00:06:08,380
،أنت تعتقد أنّ هنالك من قتل شنايدر

67
00:06:09,260 --> 00:06:11,970
وأنّ الرّسالة مزوّرة؟

68
00:06:12,550 --> 00:06:14,640
،بالنّظر إلى أنّه عميل مزدوج

69
00:06:14,970 --> 00:06:19,190
فلن يكون من الغريب سواء لألمانيا
.أو الاتّحاد السّوفياتيّ أن تسعيا خلفه

70
00:06:19,770 --> 00:06:23,690
كلّ ما أقوله هو أنّ علينا أن نضع هذه
.الاحتماليّة في حسباننا

71
00:06:24,020 --> 00:06:27,150
لكنّ مساهماتك قد منحتنا سلفًا

72
00:06:27,150 --> 00:06:29,610
.معلومات كافية لنرفض الفكرة

73
00:06:29,860 --> 00:06:34,580
سمعتَ الصّراخ قُبيل لحظة
.دخول المرأة وصديقتها للمنزل

74
00:06:35,200 --> 00:06:39,120
.لم يخرج أحد عبر ذلك الباب قبل ذلك

75
00:06:40,620 --> 00:06:42,580
ما كان سبب وفاة الهدف؟

76
00:06:43,590 --> 00:06:45,960
.الاختناق بسبب تسمّمٍ بالسّيانيد

77
00:06:46,380 --> 00:06:49,840
تمّ العثور على نفس المكوّن في كأس
.النّبيذ الّتي كان يشرب منها

78
00:06:51,510 --> 00:06:53,680
،تقول أنّه عندما مات شنايدر

79
00:06:54,140 --> 00:06:57,020
لم تلاحظ أيّ شيء على الإطلاق؟

80
00:07:09,110 --> 00:07:10,570
...إنّ شنايدر هذا

81
00:07:11,030 --> 00:07:13,780
كان يتحدّث الإنجليزيّة بطلاقة، صحيح؟

82
00:07:14,660 --> 00:07:16,700
أهذا لأنّه حاول أن يجرّب إن كان القلم يكتب؟

83
00:07:16,990 --> 00:07:18,250
.ربّما

84
00:07:18,790 --> 00:07:22,870
.لكنّ هذه تبدو كعلامتَيْ تقاطع إلى جانب بعضهما

85
00:07:23,460 --> 00:07:26,550
."في الإنجليزيّة عبارة "دابل كروس" تعني "خيانة

86
00:07:26,550 --> 00:07:29,210
...شخص ما خان شنايدر

87
00:07:29,630 --> 00:07:32,130
.أو هو من خانهم

88
00:07:33,090 --> 00:07:34,640
ما رأيك؟

89
00:07:36,640 --> 00:07:40,180
مهما كان الأمر، علينا أن نسيطر
.على شبكة الجواسيس هذه

90
00:07:40,770 --> 00:07:44,150
كاميناغا، تحرّى أمر كلّ من دخل
.إلى منزل شنايدر ثانية

91
00:07:44,150 --> 00:07:46,360
.هاتانو، أعد التّحقّق من رسالة الانتحار

92
00:07:46,650 --> 00:07:50,150
ميوشي، تحقّق من آخر التّطوّرات
.في السّفارتَيْن الألمانيّة والسّوفياتيّة

93
00:07:50,150 --> 00:07:52,200
أماري، تحرّى أمر كلّ مواطن

94
00:07:52,200 --> 00:07:54,610
.إنجليزيّ عاش على مقربة من شنايدر

95
00:07:54,610 --> 00:07:56,700
...تازاكي، تحرّى أمر قنوات استيراد النّبيذ

96
00:07:57,240 --> 00:07:58,540
...فوكوموتو

97
00:08:03,540 --> 00:08:06,040
ما الّذي تريدني أن أقوم به؟

98
00:08:09,000 --> 00:08:12,470
.تحرّى أمر المرأة الّتي كانت في ساحة الجريمة

99
00:08:12,720 --> 00:08:13,510
المرأة؟

100
00:08:14,220 --> 00:08:15,720
...لكنّها

101
00:08:18,720 --> 00:08:21,890
.كانت لنوغامي يوريكو حجّة غياب محكمة

102
00:08:22,980 --> 00:08:25,310
،في الوقت الّذي توقّعتُ فيه موت شنايدر

103
00:08:25,770 --> 00:08:29,070
كانت تقوم بتجربة الملابس رفقة
.شركة المسرح الّتي تمثّل فيه

104
00:08:29,980 --> 00:08:31,820
،وفق شهادات الشّهود

105
00:08:32,150 --> 00:08:36,070
.لم تغب عن المسرح لأكثر من خمسة دقائق

106
00:08:37,370 --> 00:08:39,700
.سأرحل غدًا

107
00:08:40,540 --> 00:08:42,950
.قد لا نلتقي ثانية

108
00:08:43,370 --> 00:08:46,000
هل ستنتظريني رغم معرفتك بهذا؟

109
00:08:49,960 --> 00:08:51,090
.سأنتظرك

110
00:08:51,960 --> 00:08:55,550
.سأكون هنا للأبد منتظرة عودتك

111
00:08:55,550 --> 00:08:57,930
...عد إليّ رجاءً

112
00:09:00,560 --> 00:09:03,640
.لقد أحببتُه من أعماق قلبي

113
00:09:03,640 --> 00:09:07,480
أحببته لدرجة أنّي أردتهما أن يعيشا
.الحياة الّتي أراداها بالفعل

114
00:09:07,940 --> 00:09:10,190
.سأختفي بكلّ سكون

115
00:09:10,690 --> 00:09:12,110
حتّى إن كان هنالك مستقبل

116
00:09:12,360 --> 00:09:15,570
.من الظّلمة والوحدة في انتظاري

117
00:09:16,280 --> 00:09:17,240
سيكون ذلك

118
00:09:17,990 --> 00:09:20,530
!دليلاً على أنّني عشت

119
00:09:32,300 --> 00:09:33,590
!عرض رائع

120
00:09:34,010 --> 00:09:36,300
!كان أداء اليوم مذهلاً

121
00:09:36,300 --> 00:09:39,300
.ميوكو-سان، أنت موهوبة بالفطرة للقيام بهذا

122
00:09:40,010 --> 00:09:41,260
.شكرًا لك

123
00:09:41,720 --> 00:09:44,600
.رغم أنّ يوريكو-سان هي من كانت النّجمة الحقيقيّة

124
00:09:46,600 --> 00:09:48,730
...رغم كلّ ما حدث

125
00:09:48,730 --> 00:09:50,400
.كانت مذهلة في أدائها

126
00:09:51,820 --> 00:09:54,150
...أتساءل إن كانت يوريكو-سان بخير

127
00:10:27,180 --> 00:10:28,980
المعذرة يا سيّدي؟

128
00:10:30,270 --> 00:10:31,520
هل من خطب ما؟

129
00:10:31,520 --> 00:10:33,060
.لا، لا شيء

130
00:10:33,860 --> 00:10:36,190
ياسوهارا-سان محبوبة للغاية، صحيح؟

131
00:10:36,530 --> 00:10:38,360
.انظر إلى كلّ الزّهور الّتي أُرسلت لها

132
00:10:38,780 --> 00:10:40,950
.أجل، شكرًا لك

133
00:10:41,780 --> 00:10:43,830
.ماذا بوسعي أن أقوله، إنّها موهوبة

134
00:10:43,830 --> 00:10:46,330
...أصبحت ميوكو-سان أفضل وأفضل في أدائها

135
00:10:46,330 --> 00:10:48,580
.إنّها ممثّلتنا الأولى هذه الأيّام

136
00:10:49,370 --> 00:10:52,540
هل هذه الأزهار من أجل ياسوهارا-سان أيضًا؟

137
00:10:54,290 --> 00:10:56,420
.يا لها من رائحة مهدّئة

138
00:10:56,760 --> 00:10:57,710
،نعم

139
00:10:57,710 --> 00:11:00,840
.إنّها أزهار ميوكو-سان المفضّلة

140
00:11:01,800 --> 00:11:04,300
،لأكون صريحًا، فبعد وقت وجيز

141
00:11:04,300 --> 00:11:07,770
.يأخذ بائع أزهار في الجوارِ أزهار ميوكو-سان منّا

142
00:11:08,310 --> 00:11:10,350
.آمُل ألاّ تشعر بالإهانة من هذا

143
00:11:10,350 --> 00:11:12,350
.لكنّها زهور جميلة ولا يجب أن تذهب هباءً

144
00:11:15,070 --> 00:11:16,020
.أنا أفهمك

145
00:11:26,410 --> 00:11:30,290
.لم يكن هنالك حبر خفيّ
.تمّ شراء الورق من مكتبة قريبة

146
00:11:37,420 --> 00:11:42,380
لم تكن هنالك أيّ نشاطات مشبوهة
.ممّن دخلوا إلى منزل شنايدر

147
00:11:43,010 --> 00:11:45,180
.بحثتُ في أمر الشّركات الّتي تستورد النّبيذ

148
00:11:45,510 --> 00:11:47,680
.لم أجد علاقة تربط أيّ واحدة منها بوكالة استخبارات

149
00:11:48,430 --> 00:11:50,980
،لا شيء غير عاديّ من السّفارتَيْن الألمانيّة والسّوفياتيّة

150
00:11:51,350 --> 00:11:55,360
لكن ربّما هنالك شخص جديد قد تولّى
.شبكة جواسيس شنايدر

151
00:11:57,320 --> 00:11:58,980
!لماذا تقدّمون تقاريركم إلي؟

152
00:11:59,690 --> 00:12:00,570
...لماذا

153
00:12:03,990 --> 00:12:06,620
.هذه قضيّتك أنت

154
00:12:12,870 --> 00:12:15,580
قضيّتي... أنا؟

155
00:12:31,470 --> 00:12:33,020
.أراك المرّة القادمة

156
00:12:33,640 --> 00:12:35,230
.شكرًا لك ثانية

157
00:12:56,620 --> 00:12:59,590
!يوريكو-سان! استعدّي

158
00:13:05,340 --> 00:13:07,680
.سأرحل غدًا

159
00:13:08,430 --> 00:13:10,430
هل ستنتظريني رغم معرفتك بهذا؟

160
00:13:14,640 --> 00:13:15,520
.سأنتظرك

161
00:13:16,440 --> 00:13:19,900
.سأكون هنا للأبد منتظرة عودتك

162
00:13:20,190 --> 00:13:22,320
...عد إليّ رجاءً

163
00:13:23,440 --> 00:13:26,530
.لقد أحببتُه من أعماق قلبي

164
00:13:26,530 --> 00:13:30,410
أحببته لدرجة أنّي أردتهما أن يعيشا
.الحياة الّتي أراداها بالفعل

165
00:13:30,830 --> 00:13:33,080
.سأختفي بكلّ سكون

166
00:13:33,620 --> 00:13:35,040
حتّى إن كان هنالك مستقبل

167
00:13:35,290 --> 00:13:38,370
.من الظّلمة والوحدة في انتظاري

168
00:13:38,750 --> 00:13:41,500
...سيكون ذلك دليلاً

169
00:13:55,600 --> 00:13:59,850
!سيكون ذلك دليلاً على أنّني عشت

170
00:14:09,110 --> 00:14:10,200
...يبدو أنّ

171
00:14:10,700 --> 00:14:14,950
.نوغامي يوريكو لم تكن القاتلة في قضيّة شنايدر

172
00:14:15,370 --> 00:14:16,040
.كلاّ

173
00:14:16,830 --> 00:14:20,750
لا يمكن لأيّ ممثّل أن يبكي دموعًا
.كتلك في عرض مسرحيّ

174
00:14:22,960 --> 00:14:26,130
ما الّذي عثرتَ عليه بشأن شركاء شنايدر؟

175
00:14:27,220 --> 00:14:29,090
.كما توقّعتَ تمامًا

176
00:14:30,090 --> 00:14:33,720
.لقد تبعتُ الرّجل الّذي يأخذ الزّهور من المسرح

177
00:14:34,680 --> 00:14:38,560
،توقّف أمام ما يشبه محلّ زهور عاديّ

178
00:14:39,020 --> 00:14:41,480
لكن اتّضح أنّ المكان عبارة عن مكتب سرّيّ

179
00:14:41,480 --> 00:14:43,860
.لتبادل المعلومات بين الجواسيس السّوفيات

180
00:14:44,440 --> 00:14:48,150
.إنّهم يتواصلون بشيفرة باستعمال زهرة معيّنة

181
00:14:48,400 --> 00:14:52,280
."بالرّوسيّة، تسمّى تلك الزّهرة "روماشكا

182
00:14:52,570 --> 00:14:55,910
.ونحن نطلق عليها في اليابان "كاموميل" أي بابونج

183
00:14:56,620 --> 00:14:59,910
.اتّصل جاسوسان سوفياتيّان بشنايدر

184
00:15:00,290 --> 00:15:02,880
.أحدهما هو بائع الزّهور الّذي يجمع الزّهور

185
00:15:03,790 --> 00:15:05,340
...والآخر

186
00:15:05,880 --> 00:15:07,760
،صديقة نوغامي يوريكو

187
00:15:08,130 --> 00:15:09,510
.ياسوهارا ميوكو

188
00:15:11,180 --> 00:15:12,680
كيف اكتشفتَ الأمر؟

189
00:15:13,300 --> 00:15:14,890
.كان الأمر بسيطًا

190
00:15:15,430 --> 00:15:18,350
الرّائحة المنبعثة من شقّة ناغومي
بعد حدوث الجريمة

191
00:15:18,640 --> 00:15:21,900
كانت مشابهة لرائحة الزّهور
.الّتي تصل إلى ياسوهارا ميوكو

192
00:15:22,270 --> 00:15:24,190
هذا يعني أنّه كانت هنالك صلة أخرى

193
00:15:24,190 --> 00:15:27,360
.تجمع بين شنايدر وياسوهارا غير نوغامي يوريكو

194
00:15:28,940 --> 00:15:33,030
ربّما كان شنايدر ينوي التّبليغ
عن حركات الألمان والسّوفيات

195
00:15:33,320 --> 00:15:35,910
.الّتي حصل عليها من اليابان إلى البريطانيّين

196
00:15:36,580 --> 00:15:39,290
،وبوجود فرصة تحوّله الآن إلى عميل لثلاث جهات

197
00:15:39,290 --> 00:15:41,830
.خطّط السّوفيات لاغتيال شنايدر

198
00:15:42,170 --> 00:15:46,130
لقد جهّزوا الأمور لتبدو الحادثة
،كانتحار في شقّة حبيبته

199
00:15:46,500 --> 00:15:50,170
لكن للقيام بذلك، احتاجت ياسوهارا ميوكو
.لبعض الوقت لتكون هناك بمفردها

200
00:15:50,800 --> 00:15:52,590
،بعد رؤية جثّة شنايدر

201
00:15:52,880 --> 00:15:56,100
هرعت نوغامي للخارج وهي فزِعة
إلى قسم الشّرطة

202
00:15:56,390 --> 00:16:00,390
بينما وضعت ميوكو رسالة الانتحار
.الجاهزة على الطّاولة

203
00:16:01,520 --> 00:16:04,060
الحرفان اللّذان يرمزان للخيانة في الإنجليزيّة

204
00:16:04,560 --> 00:16:08,570
.كانا موجّهين على الأرجح للجانب المتحدّث بتلك اللّغة

205
00:16:11,950 --> 00:16:14,360
لكن كيف حصلت على الرّسالة؟

206
00:16:14,360 --> 00:16:16,990
.من الواضح أنّها لم تجبره على كتابتها

207
00:16:17,330 --> 00:16:20,700
ربّما قالت أنّها تلميح للشّيفرة
التّالية الّتي سيستعملونها؟

208
00:16:24,170 --> 00:16:25,330
،عند حدوث ذلك

209
00:16:25,330 --> 00:16:28,630
،كانت ميوكو تعرف أنّ شنايدر سيكون في الشّقّة

210
00:16:28,630 --> 00:16:30,250
،لذلك اتّصلت به وقالت

211
00:16:31,010 --> 00:16:33,420
"،في تبادلنا التّالي"

212
00:16:34,010 --> 00:16:36,090
".سأقول أنّي خسرت كلّ شيء"

213
00:16:36,590 --> 00:16:38,810
"،وأنّنا سنموت معًا"

214
00:16:39,350 --> 00:16:41,520
".باستعمال الزّهرة الّتي تحمل ذلك المعنى"

215
00:16:43,350 --> 00:16:44,350
،وبعدها

216
00:16:44,890 --> 00:16:47,270
،بينما ينتظر يوريكو لتعود للمنزل

217
00:16:47,980 --> 00:16:51,400
.قرّر أن يشرب كأسًا من النّبيذ

218
00:17:05,040 --> 00:17:08,880
قيل لي أنّ ياسوهارا ميوكو
.قد اعترفت بقتلها لشنايدر

219
00:17:10,210 --> 00:17:13,720
.أرسلت الشّرطة شكرها من أجل المعلومة

220
00:17:14,380 --> 00:17:16,430
.هذا شيء نادر الحدوث

221
00:17:20,390 --> 00:17:22,560
...هل كانت نوغامي يوريكو تشبه

222
00:17:22,850 --> 00:17:24,480
نيشياما تشيزورو؟

223
00:17:29,440 --> 00:17:33,440
عندما قام المقدّم يوكي بأمري
،بمراقبة كارل شنايدر

224
00:17:33,690 --> 00:17:36,610
،ورأيتُ حينها نوغامي يوريكو لأوّل مرّة

225
00:17:36,610 --> 00:17:38,360
.لم أستطع تصديق عينيّ

226
00:17:42,370 --> 00:17:43,540
...تشيزو-ني

227
00:17:44,540 --> 00:17:46,710
.لم أعرف كيف يبدو والدَيّ

228
00:17:48,210 --> 00:17:51,380
،تمّ تركي في منزل والدَيْ أبي

229
00:17:52,210 --> 00:17:53,880
،لكنّهما كانا طاعنَيْن في السّنّ

230
00:17:54,170 --> 00:17:56,630
،لم يكونا قادرين على العناية بطفل صغير

231
00:17:57,550 --> 00:18:01,350
لذلك انتهى بي المطاف بين يدي
.ابنة مزارع قريب لتربّيني

232
00:18:02,850 --> 00:18:03,810
.هيرو-تشان

233
00:18:07,730 --> 00:18:09,020
إنّها الشّخص الوحيد

234
00:18:09,400 --> 00:18:13,020
.الّذي قبل بي في هذا العالم

235
00:18:15,780 --> 00:18:19,780
.نيشياما تشيزورو هي من ربّتك

236
00:18:19,780 --> 00:18:23,080
،لكنّها هربت في النّهاية مع شابّ تخلّى عنها

237
00:18:23,080 --> 00:18:26,750
ولم تعد أبدًا لبلدتها قبل
.أن تموت جرّاء مرض السّلّ

238
00:18:27,620 --> 00:18:29,330
،عندما مات الهدف

239
00:18:29,330 --> 00:18:31,960
.أبلغتَ أنّك لم تلاحظ شيئًا

240
00:18:32,540 --> 00:18:35,000
الشّيء الوحيد الّذي كان بمقدوره
،أن يشتّت انتباهك

241
00:18:35,000 --> 00:18:37,260
،"وأنت رجل تدرّب في "الوكالة دي

242
00:18:37,550 --> 00:18:40,340
.هو شبح نيشياما تشيزورو

243
00:18:40,800 --> 00:18:42,300
.كان استنتاجًا بسيطًا

244
00:18:43,510 --> 00:18:46,140
لأنّي كنتُ مركّزًا بشدّة

245
00:18:46,140 --> 00:18:48,350
،على نوغامي يوريكو حينها

246
00:18:48,850 --> 00:18:51,690
وفشلت في ملاحظة وجود مشاعر
.امرأة أخرى في المعادلة

247
00:18:54,320 --> 00:18:56,570
لن تعيد التّفكير بالأمر، صحيح؟

248
00:19:06,200 --> 00:19:10,920
هل تعرف لماذا تقبل "الوكالة دي" بالرّجال فقط؟

249
00:19:12,580 --> 00:19:15,170
.لأنّ النّساء يقتُلن حتّى لو لم يكن ذلك ضروريًّا

250
00:19:16,340 --> 00:19:18,670
ولأسباب حمقاء وتافهة

251
00:19:19,590 --> 00:19:21,880
.كالحبّ والكراهية

252
00:19:23,680 --> 00:19:25,260
...أن أكون غير مثقل بأيّ شيء

253
00:19:26,060 --> 00:19:30,350
...هو أمر يتطلّب ألاّ أؤمن بأيّ شيء آخر في العالم

254
00:19:31,810 --> 00:19:34,900
،وأتخلّى عن الأمور التّافهة كالحبّ والكراهية

255
00:19:35,570 --> 00:19:38,030
،وأخون ما في قلبي ويدعمني

256
00:19:38,650 --> 00:19:40,650
.وأخرجه من حياتي

257
00:19:42,410 --> 00:19:43,820
،مهما حاولت

258
00:19:44,370 --> 00:19:47,290
.لم أستطع التّخلّي عن ذكرى تشيزو-ني

259
00:19:48,040 --> 00:19:48,870
...كلاّ

260
00:19:49,750 --> 00:19:51,250
،إذا ما تخلّيتُ عنها

261
00:19:51,710 --> 00:19:53,960
فلن أعود واثقًا بعد الآن من السّبب
.الّذي يدفعني لأعيش

262
00:20:06,550 --> 00:20:08,060
،في النّهاية

263
00:20:09,470 --> 00:20:11,850
.لن أكون قادرًا أبدًا أن أصبح وحشًا مثلهم

264
00:20:28,530 --> 00:20:29,620
...المعذرة

265
00:20:30,080 --> 00:20:32,830
ألن تمثّل نوغامي يوريكو-سان هنا بعد الآن؟

266
00:20:33,620 --> 00:20:35,460
.أنا أتذكّرك

267
00:20:36,290 --> 00:20:40,760
.نعم، أخشى أنّ يوريكو-سان قد استقالت

268
00:20:40,760 --> 00:20:41,710
استقالت؟

269
00:20:42,840 --> 00:20:45,130
،لقد خسرت حبيبها في البداية

270
00:20:45,590 --> 00:20:49,060
...ومن ثمّ تمّ اعتقال ميوكو-سان

271
00:20:50,060 --> 00:20:52,430
.لا بدّ أنّ ذلك أثّر عليها كثيرًا

272
00:20:53,350 --> 00:20:54,730
...فهمت

273
00:20:55,390 --> 00:20:59,730
من المحزن أن أفكّر أنّي لن أرى
.يوريكو-سان تمثّل في اليابان ثانية

274
00:21:01,530 --> 00:21:02,780
إلى أين ستذهل؟

275
00:21:03,440 --> 00:21:07,410
قالت أنّها تريد أن تبدأ بدراسة
.التّمثيل في مكان جديد

276
00:21:07,410 --> 00:21:09,450
...أراد ستوديو أفلام أن يوقّع معها عقدًا أيضًا

277
00:21:10,120 --> 00:21:11,990
.لذلك فهي ذاهبة إلى مانشوريا

278
00:21:15,410 --> 00:21:17,080
.هذا هو إعفاؤك

279
00:21:18,670 --> 00:21:20,590
.تمّ تعينك في كوانتونغ

280
00:21:21,340 --> 00:21:24,090
.يبدو أنّك ستكون ملازمًا في وحدة مانشوريّة

281
00:21:28,010 --> 00:21:29,930
.أيّها الملازم توبيساكي هيرويوكي

282
00:21:33,430 --> 00:21:34,560
.لا تمت

283
00:21:40,730 --> 00:21:42,110
هل أنت غبيّ؟

284
00:21:46,030 --> 00:21:49,070
من هذا الّذي ينحني وهو يرتدي بذلة عمل؟