1
00:01:10,420 --> 00:01:14,510
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

2
00:01:15,130 --> 00:01:19,890
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

3
00:01:20,850 --> 00:01:23,430
يتمّ التّعامل مع ماضي وأسماء

4
00:01:23,430 --> 00:01:27,020
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

5
00:01:27,020 --> 00:01:30,480
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

6
00:01:31,730 --> 00:01:34,990
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

7
00:01:34,990 --> 00:01:37,110
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

8
00:01:37,530 --> 00:01:40,570
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

9
00:01:40,570 --> 00:01:42,700
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

10
00:01:44,240 --> 00:01:47,410
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

11
00:01:48,170 --> 00:01:50,830
."اسمها هو "الوكالة دي

12
00:03:46,450 --> 00:03:48,990
.المعذرة. لم أقصد جعلك تنتظر طويلاً أيّها الرّقيب هونما

13
00:03:49,330 --> 00:03:53,080
لا عليك، فيما تحتاجني أيّها النّقيب أويكاوا؟

14
00:03:53,870 --> 00:03:58,250
لقد استدعيتُك إلى هنا لأنّ لديّ
.مهمّة بالغة السّرّيّة من أجلك

15
00:03:59,050 --> 00:04:03,010
هنالك جاسوس للعدوّ ضمن صفوف
.شرطة شانغهاي العسكريّة

16
00:04:03,510 --> 00:04:05,470
.أريدك أن تحقّق في الأمر وتعثر عليه

17
00:04:05,970 --> 00:04:08,060
لماذا أنا يا سيّدي؟

18
00:04:08,470 --> 00:04:11,060
.لم يمضِ على تواجدي في شانغهاي إلاّ ثلاثة أشهر

19
00:04:11,770 --> 00:04:13,440
.هذا هو السّبب بالضّبط

20
00:04:14,390 --> 00:04:17,860
مضت أزيد من ثلاثة أشهر منذ
.أن بدأت التّسريبات

21
00:04:18,360 --> 00:04:21,820
.بعبارات أخرى، لا يمكن أن تكون الجاني

22
00:04:23,740 --> 00:04:26,990
كما أنّي سمعتُ أنّك خدمتَ في صفوف
.الشّرطة العُليا الخاصّة في اليابان

23
00:04:27,450 --> 00:04:30,870
لقد قُتل الرّجل الّذي عيّنتُه من أجل
.التّحقيق في الأمر البارحة

24
00:04:30,870 --> 00:04:33,080
.لقد كان العريف مياتا نوبوتيرو من الشّرطة العسكريّة

25
00:04:36,790 --> 00:04:39,420
.هذه هي تقارير العريف مياتا

26
00:04:39,840 --> 00:04:40,960
.المعذرة

27
00:04:47,970 --> 00:04:48,930
!أيّها الرّقيب هونما

28
00:04:48,930 --> 00:04:50,060
!ما الّذي تفعله؟

29
00:04:50,430 --> 00:04:51,930
!أنا آسف يا سيّدي

30
00:05:03,820 --> 00:05:05,200
.المنطقة الدّوليّة

31
00:05:07,610 --> 00:05:08,530
.سُحقًا

32
00:05:13,040 --> 00:05:16,000
.منزلي... موجود هناك

33
00:05:24,970 --> 00:05:26,090
...هذا فظيع

34
00:05:26,090 --> 00:05:28,510
.إنّها الخادمة الّتي تأتي لمنزلي بشكل يوميّ

35
00:05:28,510 --> 00:05:30,100
ماذا عن البقيّة؟

36
00:05:32,260 --> 00:05:34,890
هل تعرّفت على أيّ واحد من الضّحايا؟

37
00:05:34,890 --> 00:05:36,310
...المفتّش جيمس

38
00:05:36,940 --> 00:05:38,020
...لنرَ

39
00:05:38,810 --> 00:05:44,030
على الأرجح أنّ هذين الاثنين هما متسوّلان
.يجلسان في العادة أمام منزلي

40
00:05:44,030 --> 00:05:47,490
وهذا لسوء الحظّ هو فتى يعيش
.على مقربة من هنا

41
00:05:47,490 --> 00:05:49,870
.إنّه يلعب خلف المنزل في العادة

42
00:05:49,870 --> 00:05:52,280
.لا فكرة لي عمّن يكون آخر الضّحايا

43
00:05:56,620 --> 00:05:57,790
.فهمت

44
00:05:57,790 --> 00:06:00,710
.إذًا فهو من تدور حول الشّبهات أكثر من غيره

45
00:06:01,670 --> 00:06:03,300
المتسوّل؟

46
00:06:03,750 --> 00:06:06,380
تقول أنّه هو مفتعل هذا الانفجار الإرهابيّ؟

47
00:06:06,880 --> 00:06:10,050
ربّما أشعل نارًا في الخارج، صحيح؟

48
00:06:10,050 --> 00:06:14,350
لا بدّ أنّ ذلك دفع علبة الطّلاء
.الّتي كانت قريبة للانفجار

49
00:06:14,350 --> 00:06:15,350
!هذا سخيف

50
00:06:15,350 --> 00:06:18,520
!من الواضح أنّها كان محاولةَ إرهابيّ لاغتيال النّقيب

51
00:06:18,520 --> 00:06:19,980
—فبعد حادثة البارحة

52
00:06:19,980 --> 00:06:21,690
.كفى أيّها الرّقيب هونما

53
00:06:23,400 --> 00:06:28,490
لا فائدة. لم يكن لديهم أيّ نيّة للتّحقيق
.في أمر الحادثة من البداية

54
00:06:30,030 --> 00:06:33,330
.حسنًا، انتهى الأمر إذًا

55
00:06:33,330 --> 00:06:34,740
.مع السّلامة

56
00:06:37,540 --> 00:06:40,210
غادرتُ المنزل باكرًا اليوم

57
00:06:40,710 --> 00:06:42,250
.لأتمكّن من التّحدّث معك

58
00:06:43,380 --> 00:06:45,210
...لو أنّني غادرتُ المنزل في وقتي المعتاد

59
00:06:46,420 --> 00:06:48,720
.لا بدّ أنّ جدولي الزّمني قد تسرّب مسبقًا

60
00:06:49,170 --> 00:06:51,090
.سأترك ما تناقشنا بشأنه لك

61
00:06:51,760 --> 00:06:52,340
.حاضر

62
00:07:10,400 --> 00:07:12,240
ما الأمر أيّها الجنديّ يوشينو؟

63
00:07:14,530 --> 00:07:15,580
هل كنتَ تعرفه؟

64
00:07:15,780 --> 00:07:19,500
.كلاّ. أخشى أنّي لم أكن أعرفه

65
00:07:21,080 --> 00:07:22,120
.أستأذن

66
00:07:44,190 --> 00:07:46,520
!يا إلهي، لقد مرّ وقت طويل منذ أن تحدّثنا معًا

67
00:07:46,520 --> 00:07:49,150
.أنا مدين لك من أجل كلّ ما فعلتَه بالنّسبة لي

68
00:07:53,660 --> 00:07:55,950
...شيوزوكا هاجيمي

69
00:07:58,370 --> 00:08:02,250
مهلاً، ألم أحقّق معك بشأن تُهمٍ

70
00:08:02,250 --> 00:08:03,960
متعلّقة بإدارة مجلّة متطرّفة؟

71
00:08:03,960 --> 00:08:06,920
.نعم، كان هذا قبل ثلاث سنوات

72
00:08:06,920 --> 00:08:10,880
أتمنّى أن تكون قد بدأتَ صفحة جديدة
في حياتك وتقوم بعمل محترم؟

73
00:08:10,880 --> 00:08:13,510
.أكيد، عمل محترم بالكامل

74
00:08:13,510 --> 00:08:16,260
.أكثر احترامًا من أيّ شيء سبق وقمتُ به

75
00:08:16,260 --> 00:08:19,010
.اقرأ بنفسك إن كنتَ تعتقد أنّي أكذب

76
00:08:20,560 --> 00:08:23,190
لقد كتبتُ هذا، لكن فقط لأنّ هنالك جانب صغير

77
00:08:23,190 --> 00:08:25,310
—يجعل الجيش البايانيّ يظهر بصورة سلبيّة

78
00:08:25,310 --> 00:08:26,520
—حادثة البارحة

79
00:08:27,150 --> 00:08:28,770
.كان هذا رهيبًا

80
00:08:28,770 --> 00:08:33,700
تعرّض مبنى يضمّ تجارة يابانيّة للهجوم
.من طرف خمسة قذائف هاون ودُمّر كلّيًّا

81
00:08:34,320 --> 00:08:35,740
.أعرف بشأن هذا مسبقًا

82
00:08:35,990 --> 00:08:38,950
.حسنًا، أرى أنّي أُعلمك بما تعلمه مسبقًا

83
00:08:38,950 --> 00:08:42,290
إذا جمعنا هذا بالهجوم الّذي تعرّض
،له منزل النّقيب أويكاوا

84
00:08:42,290 --> 00:08:46,000
.فإن وضع الإرهاب المعادي لليابان هنا يزداد سوءًا

85
00:08:55,050 --> 00:08:57,510
.لا داعيَ لكلّ هذه الجدّيّة

86
00:08:57,510 --> 00:09:00,140
.قد يُحلّ كلّ هذا الأمر قبل أن تدرك حتّى

87
00:09:00,390 --> 00:09:01,850
ما الّذي تعنيه؟

88
00:09:02,640 --> 00:09:04,730
،في الواقع، بينما كنتُ أحقّق في هذا المقال

89
00:09:04,730 --> 00:09:07,150
.لمحتُ شخصًا لم أتوقّع وجوده

90
00:09:17,110 --> 00:09:18,320
كوساناغي؟

91
00:09:21,080 --> 00:09:23,500
ومن يكون كوساناغي هذا؟

92
00:09:23,500 --> 00:09:27,500
.رئيس تلك المجلّة المتطرّفة التّي تلقّيتُ اللّوم عليها

93
00:09:28,040 --> 00:09:30,170
.كنّا زملاء صفّ في الجامعة الإمبراطوريّة

94
00:09:30,170 --> 00:09:31,920
،عندما عدتُ لليابان الشّهر الماضي

95
00:09:31,920 --> 00:09:34,920
خرجتُ أنا وزميلُ صفٍّ سابقٍ آخر
.لنحتسي الشّراب

96
00:09:34,920 --> 00:09:38,680
.إنّه مع مكتب شؤون الشّرطة في وزارة الدّاخليّة

97
00:09:39,010 --> 00:09:40,350
كوساناغي؟

98
00:09:44,600 --> 00:09:47,890
.نعم. كوساناغي الّذي اعتدتَ أن تخرج معه

99
00:09:48,940 --> 00:09:50,650
،هذه مجرّد إشاعة

100
00:09:50,650 --> 00:09:55,650
لكنّي سمعتُ بأمر ناشطٍ يابانيّ انضمّ
.إلى منظّمة معادية لليابان خارج البلاد

101
00:09:56,360 --> 00:09:58,780
ويُفترض أنّ الرّجل الّذي نحن بصدده الآن

102
00:09:58,780 --> 00:10:00,620
.هو كوساناغي يوكيهيتو دون غيره

103
00:10:01,530 --> 00:10:03,540
.دعني أستوعب الأمر جيّدًا

104
00:10:04,290 --> 00:10:06,710
أنت تقول أنّ صديقك القديم من الجامعة

105
00:10:06,710 --> 00:10:10,630
تسلّل إلى شانغهاي للقيام
بنشاطات معادية لليابان؟

106
00:10:11,080 --> 00:10:14,590
ما رأيك؟ هذه معلومات مغرية، أليس كذلك؟

107
00:10:15,420 --> 00:10:20,680
وما الّذي يحاول كوساناغي هذا
أن يحقّقه هنا في شانغهاي؟

108
00:10:20,680 --> 00:10:23,850
.واضح أنّي لا أملك طريقة لمعرفة ذلك

109
00:10:23,850 --> 00:10:24,640
،ولكن

110
00:10:25,350 --> 00:10:29,890
.اتّصل كوساناغي بالعريف مياتا الرّاحل

111
00:10:29,890 --> 00:10:31,150
ماذا؟

112
00:10:32,360 --> 00:10:33,650
هل لديك صورة له؟

113
00:10:33,980 --> 00:10:35,480
.هذا ما أريد سماعه

114
00:10:36,610 --> 00:10:39,320
.لسوء الحظّ، كلّ ما لديّ هي صورة من أيّام الجامعة

115
00:10:41,160 --> 00:10:42,990
.هذا هو كوساناغي

116
00:10:43,330 --> 00:10:45,410
.سأترك هذه كمرجع لك

117
00:10:47,250 --> 00:10:49,580
.ولا حاجة لتشكرني

118
00:10:49,580 --> 00:10:51,420
.لكنّها مسألة أخذ وردّ

119
00:10:51,420 --> 00:10:53,590
.أعلمني إذا ما اكتشفتَ أيّة معلومات مهمّة

120
00:11:01,970 --> 00:11:03,510
...كوساناغي

121
00:11:13,980 --> 00:11:17,980
هنالك علاقة بين موت العريف مياتا

122
00:11:17,980 --> 00:11:21,700
ومحاولةُ اغتيال مفتعلِ التّفجير للنّقيب أويكاوا
والمعلومات المسرّبة من طرف الجاسوس؟

123
00:11:22,570 --> 00:11:23,910
،عليّ أن أعثر عليه بسرعة

124
00:11:24,320 --> 00:11:26,490
.وإلاّ فلا أمل لنا لوضع حدّ للإرهاب المعادي لليابان

125
00:11:26,490 --> 00:11:28,660
،لا يستطيع أحد في وحدتنا أن يثق بشخص آخر

126
00:11:28,950 --> 00:11:31,160
.وستنهار المجموعة بأكملها من الدّاخل

127
00:11:32,120 --> 00:11:35,880
لكن كيف لي أن أجد دليلاً ما؟

128
00:12:09,950 --> 00:12:11,040
...هذا

129
00:12:42,070 --> 00:12:43,570
قاعة رقص؟

130
00:13:13,480 --> 00:13:14,350
.لا

131
00:13:15,140 --> 00:13:17,730
لن أمرّ دون دفع رسم دخول إذًا؟

132
00:13:17,730 --> 00:13:18,940
.لا خيار آخر أمامي

133
00:13:23,440 --> 00:13:26,070
...ما هذه؟ متى

134
00:13:54,810 --> 00:13:55,930
.شكرًا لك

135
00:14:01,900 --> 00:14:03,860
!إنّه فتى

136
00:14:10,870 --> 00:14:13,160
مهلاً، هل تعرفه؟

137
00:14:14,160 --> 00:14:17,040
.نعم، إنّه زبون يتردّد كثيرًا إلى هنا

138
00:14:17,040 --> 00:14:20,290
.يكون دائمًا مركز الانتباه بينما يلعب
.أنا أحسده على ذلك

139
00:14:37,430 --> 00:14:39,350
.آسف لأني جعلتُك تنتظر

140
00:14:39,350 --> 00:14:43,360
لديك شيء ما لتُطلعني عليه بشأن
الحقيقة وراء الحادثة، صحيح؟

141
00:14:43,360 --> 00:14:45,730
.نعم. لديّ ما أقوله

142
00:14:47,150 --> 00:14:50,660
،الحادثة الّتي نحن بصددها يا سيّدي النّقيب أويكاوا

143
00:14:50,660 --> 00:14:53,370
.كانت عبارة عن غطاءِ تستّرٍ من تخطيطك أنت

144
00:14:53,990 --> 00:14:55,290
على أيّ أساس بنيتَ استنتاجك هذا؟

145
00:14:56,200 --> 00:14:57,750
،في اليوم الّذي سبق التّفجير

146
00:14:58,080 --> 00:15:02,380
وقع هجوم على مبنى يضمّ تجارة يابانيّة

147
00:15:02,380 --> 00:15:04,710
.بحيث دُمّر بعدّة قذائف هاون

148
00:15:05,250 --> 00:15:07,300
بالتّالي، كان من الطّبيعيّ

149
00:15:07,300 --> 00:15:09,800
.توقّع هجومٍ ثانٍ أو ثالث

150
00:15:10,470 --> 00:15:12,300
،لكنكّ أيّها النّقيب

151
00:15:12,300 --> 00:15:14,100
انتقلتَ إلى النّافذة مباشرة

152
00:15:14,100 --> 00:15:15,430
دون أيّ تردّد

153
00:15:15,430 --> 00:15:17,350
.في اللّحظة الّتي تلت الانفجار

154
00:15:17,720 --> 00:15:20,600
.لأنّك كنتَ تعلم أنّه لن يحدث تفجير ثانٍ

155
00:15:22,480 --> 00:15:25,520
لقد فجّرت منزلك

156
00:15:25,520 --> 00:15:28,900
مستغلاّ الأحداث الإرهابيّة المعادية
لليابان الّتي تحدث مرارًا

157
00:15:28,900 --> 00:15:30,900
.لتتستّر على جرائمك الخاصّة

158
00:15:31,240 --> 00:15:34,870
ونتيجة لذلك، فقد العديد من الأبرياء

159
00:15:34,870 --> 00:15:36,990
.حياتهم جرّاء ذلك أيضًا

160
00:15:38,040 --> 00:15:39,580
أقلتَ جرائم؟

161
00:15:41,120 --> 00:15:47,840
لا يُعقل أنّك تقصد بكلامك هذا المتسوّلين، صحيح؟

162
00:15:48,420 --> 00:15:51,760
أم أنّك تقصد الخادمة العجوز الّتي تأتي لمنزلي؟

163
00:15:51,760 --> 00:15:53,340
.أنت مخطئ إذًا

164
00:15:53,340 --> 00:15:58,140
إنّ تلك المرأة كانت تسرق أشياء
.صغيرة من منزلي باستمرار

165
00:15:58,470 --> 00:16:01,850
أين يمكنك أن تعثر على شخص بريء في هذه المدينة؟

166
00:16:01,850 --> 00:16:05,860
.لن يأبه أيّ أحد على الإطلاق إن ماتوا

167
00:16:05,860 --> 00:16:08,320
إذًا فأنت تعترف؟

168
00:16:08,320 --> 00:16:10,610
تعترف أنّك من فجّر منزلك؟

169
00:16:16,160 --> 00:16:17,620
وماذا إن كنتُ الفاعل؟

170
00:16:21,830 --> 00:16:25,380
.كانت هذه السّنوات الخمسة طويلة بالنّسبة لك

171
00:16:28,630 --> 00:16:32,590
.هنا في كوسِيْ، الحيّ الأكثر فوضويّة في شانغهاي

172
00:16:33,300 --> 00:16:36,550
،فبشخصيّتك الصّريحة والدّقيقة

173
00:16:36,890 --> 00:16:40,180
.كرّستَ كلّ كينونتك لإنجاز مهمّتك بشكل مثاليّ

174
00:16:42,060 --> 00:16:42,930
...إلى أن

175
00:16:44,600 --> 00:16:45,480
.فقدتَ رشدك

176
00:17:08,790 --> 00:17:10,000
.أويكاوا-سان

177
00:17:11,130 --> 00:17:14,550
.إنّنا شاكرون دائمًا لوفائك لنا

178
00:17:15,090 --> 00:17:17,590
.في الواقع، لديّ طلب لك

179
00:17:17,590 --> 00:17:21,140
هل تعتقد أنّ القليل من الأفيون الموجود
في خزنتكم بدون أيّ هدف

180
00:17:21,140 --> 00:17:24,270
قد يجد طريقه إلينا؟

181
00:17:25,180 --> 00:17:29,770
في تلك الحالة، أستطيع تقديمك لتسليةٍ
.من نوع آخر أكثر إمتاعًا

182
00:17:34,740 --> 00:17:37,740
لكن حينها، لاحظ أحدهم
أنّ كمّيّة الأفيون في الخزنة

183
00:17:37,740 --> 00:17:40,530
.لا تتناسب مع ما هو مدوّن في السّجلاّت

184
00:17:41,080 --> 00:17:45,580
لم يكن العريف مياتا يحاول كشف
.أمر جاسوس من الأساس

185
00:17:47,420 --> 00:17:50,710
.لقد كان يسعى خلف الأفيون النّاقص من الخزنة

186
00:17:55,470 --> 00:17:58,970
كان ذلك التّفجير مجرّد تمويه من تخطيطك أنت

187
00:17:58,970 --> 00:18:02,510
.بغرض التّستّر على جثّة ذلك الفتى الشّابّ

188
00:18:05,270 --> 00:18:08,270
إذًا، ما الّذي تريده؟

189
00:18:08,270 --> 00:18:11,520
.اعترف بالحقيقة وراء موت العريف مياتا لو سمحت

190
00:18:11,520 --> 00:18:15,740
وسيتضمّن ذلك بالطّبع ما حدث لذلك
.الفتى الّذي أطلق عليه النّار

191
00:18:16,650 --> 00:18:19,990
إن فعلتُ ذلك، سيتمّ إعفائي
،من الخدمة في أفضل الحالات

192
00:18:19,990 --> 00:18:23,490
.وفي أسوئها، سوف أمثُل أمام محكمة عسكريّة

193
00:18:23,990 --> 00:18:25,290
.لا خيار أمامك

194
00:18:27,500 --> 00:18:29,170
كيف أستطيع إقناعك بتصديقي؟

195
00:18:30,040 --> 00:18:31,290
...ما الّذي

196
00:18:31,290 --> 00:18:34,670
.قلتَ أنّي خطّطتُ لكلّ شيء

197
00:18:34,670 --> 00:18:37,510
.لكنّك لا تملك أيّ دليل

198
00:18:37,510 --> 00:18:40,010
.كلّ ما لديك هي كلمات

199
00:18:40,640 --> 00:18:42,640
،إن متَّ هنا

200
00:18:42,640 --> 00:18:45,640
.فتلك الكلمات لن ترى نور النّهار أبدًا

201
00:18:48,770 --> 00:18:54,360
إن متُّ هنا، سيتمّ إرسالة رسالة تتضمّن
!الحقيقة إلى وزارة الحرب

202
00:19:04,410 --> 00:19:05,620
.مفهوم

203
00:19:06,330 --> 00:19:09,710
.أستسلم. سأقوم بما تُمليه عليّ

204
00:19:09,710 --> 00:19:13,330
أنت لن تحاول اقتراف جرم
في حقّ نفسك، صحيح؟

205
00:19:13,630 --> 00:19:15,210
تقصد أن أنتحر؟

206
00:19:21,590 --> 00:19:22,800
!هذا غباء

207
00:19:22,800 --> 00:19:28,770
ماذا في رأيك هما الإعفاء من الخدمة
أو المثول أمام المحكمة العسكريّة؟

208
00:19:29,310 --> 00:19:33,730
اسمع. لو استطعتُ القول أنّ السّنوات الخمسة
،الّتي قضيتها في شنغهاي قد علّمتني شيئًا

209
00:19:33,730 --> 00:19:36,320
،فهو مهما كانت الجرائم الّتي يقترفها النّاس

210
00:19:36,320 --> 00:19:38,690
،ومهما كان نوع العار الّذي لحق بهم

211
00:19:38,690 --> 00:19:40,990
!فبإمكانهم النّجاة

212
00:19:41,530 --> 00:19:43,660
،لا آبه إن سلبتُ حياة شخص آخر

213
00:19:43,660 --> 00:19:45,780
،أو دمّرتُ وحدة الشّرطة العسكريّة هذه

214
00:19:45,780 --> 00:19:50,660
سأفعل أيّ شيء وكلّ شيء أستطيعه
!لأستمرّ في الشّرب من هذا الينبوع

215
00:19:50,660 --> 00:19:52,170
،وسوف أعيش

216
00:19:52,170 --> 00:19:54,630
،سأعيش، سأعيش، سأعيش

217
00:19:54,630 --> 00:19:57,250
!وسأستمتع بكلّ لحظة حتّى النّهاية

218
00:19:57,590 --> 00:20:00,050
...الخادمة العجوز والمتسوّلون وحتّى ذلك الفتى

219
00:20:00,050 --> 00:20:02,220
!لماذا عليّ أن آبه كم منهم سيموت؟

220
00:20:02,680 --> 00:20:03,760
،اعلم هذا

221
00:20:03,760 --> 00:20:05,760
إنّ أرخص عملة هنا في شانغهاي

222
00:20:05,760 --> 00:20:08,220
!هي أرواح البشر

223
00:20:14,100 --> 00:20:14,850
ماذا؟

224
00:20:16,020 --> 00:20:17,980
!توقّف أيّها الجنديّ يوشينو

225
00:20:22,200 --> 00:20:25,360
!لِمَ؟! لِمَ أطلقتَ النّار على النّقيب أويكاوا؟

226
00:20:28,120 --> 00:20:30,120
.انتقامًا لمحبوبي

227
00:20:30,120 --> 00:20:31,410
!محبوبك؟

228
00:20:31,870 --> 00:20:33,460
—من تقصد بكلامك

229
00:20:35,080 --> 00:20:35,790
...أنت لا تعني

230
00:20:42,300 --> 00:20:43,380
!إيّاك

231
00:21:00,650 --> 00:21:02,860
عرفتُ بعد عامين أنّ معلوماتٍ سرّيّة

232
00:21:02,860 --> 00:21:05,570
.كانت تتسرّب من الجيش اليابانيّ في شانغهاي

233
00:21:06,360 --> 00:21:12,660
قادتني تحرّياتي إلى ملهى يتردّد
.إليه نقيب الشّرطة العسكريّة أويكاوا

234
00:21:13,500 --> 00:21:17,580
وإضافة للأفيون، كان يبيع معلومات
.سرّيّة في السّوق السّوداء

235
00:21:18,960 --> 00:21:22,920
،كان ينوي اتّهام الرّقيب هونما
.زميله في الشّرطة العسكريّة

236
00:21:23,710 --> 00:21:26,880
والآن، ستتمكّن الشّرطة العسكريّة
.بالكاد من حفظ ماء وجهها

237
00:21:27,390 --> 00:21:32,350
نتيجة لذلك، أَجبر المقدّم يوكي الجيش
.بالاعتراف بما كان يحدث في شانغهاي

238
00:21:36,520 --> 00:21:39,860
ربّما سينتهي بي المضاف هنا
...لمزيدٍ من الوقت

239
00:21:42,650 --> 00:21:45,280
في مدينة الإغراءات هذه، حيث الخيانة والوحدة

240
00:21:45,650 --> 00:21:47,240
.يتشابكان

241
00:23:21,540 --> 00:23:22,880
.تبدو مُتعبًا

242
00:23:23,460 --> 00:23:26,210
.أشعر بالتّعب بالكامل مؤخّرًا

243
00:23:26,880 --> 00:23:28,920
.نم عندما تحتاج للنّوم

244
00:23:31,430 --> 00:23:34,930
ستستيقظ من تلقاء نفسك عندما
.يحين القوت المناسب