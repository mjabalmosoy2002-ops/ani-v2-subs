1
00:00:03,440 --> 00:00:04,980
.شيمانو ريوسكي

2
00:00:05,400 --> 00:00:07,150
.طالب تبادل أجنبيّ يابانيّ

3
00:00:08,980 --> 00:00:13,150
دخل البلاد في الخامس عشر
.من يونيو سنة 1939

4
00:00:13,780 --> 00:00:14,950
.مارسيليا

5
00:00:15,610 --> 00:00:18,160
.إقامة لمدّة سنة واحدة في فرنسا

6
00:00:22,040 --> 00:00:24,370
.لا تجبر نفسك على التّذكّر

7
00:00:26,250 --> 00:00:29,420
.أعتقد أنّك تعاني من فقدان ذاكرة مؤقّت

8
00:00:32,590 --> 00:00:34,840
ألا تتذكّر شيئًا على الإطلاق؟

9
00:00:35,550 --> 00:00:39,180
.لقد اتّخذت قرارًا طائشًا بتحدّيك لجندي ألماني

10
00:00:40,810 --> 00:00:44,390
ألا تتذكّر العناء الّذي تكبّدناه لإنقاذك؟

11
00:00:47,980 --> 00:00:50,150
.لا تُعطِ العدوّ أيّة معلومات

12
00:00:54,900 --> 00:00:56,030
.لا أدري

13
00:00:56,820 --> 00:00:58,200
.لا أستطيع تذكّر أيّ شيء

14
00:00:58,200 --> 00:00:59,950
ما كان ذلك؟

15
00:00:59,950 --> 00:01:02,200
.أخبروني ما حدث رجاءً

16
00:01:02,660 --> 00:01:04,200
هذه فرنسا، صحيح؟

17
00:01:04,500 --> 00:01:05,960
فلماذا يوجد جنود ألمان هنا؟

18
00:01:09,080 --> 00:01:11,920
،أتمنّى لو أستطيع نسيان هذا أيضًا

19
00:01:13,010 --> 00:01:14,970
،نسيان أن بلدي الأمّ فرنسا

20
00:01:15,300 --> 00:01:18,260
.تحت الاحتلال الألمانيّ الآن

21
00:01:19,760 --> 00:01:21,850
بينما الدّخّان يتصاعد من جمرِ حربٍ عالميّة

22
00:01:21,850 --> 00:01:23,850
،في خريف عام 1937

23
00:01:24,730 --> 00:01:29,480
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

24
00:01:30,400 --> 00:01:32,900
يتمّ التّعامل مع ماضي وأسماء

25
00:01:32,900 --> 00:01:36,650
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

26
00:01:36,650 --> 00:01:40,200
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

27
00:01:41,280 --> 00:01:44,700
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

28
00:01:44,700 --> 00:01:46,750
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

29
00:01:47,160 --> 00:01:49,540
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

30
00:01:50,040 --> 00:01:52,130
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

31
00:01:53,300 --> 00:01:56,880
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

32
00:01:57,420 --> 00:01:59,970
."اسمها هو "الوكالة دي

33
00:03:31,810 --> 00:03:35,480
.في الثّاني والعشرين من عام 1940

34
00:03:35,900 --> 00:03:37,980
،وبعد عدم وجود أيّ ردّ على تقدّم القوّات الألمانيّة

35
00:03:37,980 --> 00:03:40,150
،تمّ احتلال فرنسا

36
00:03:40,610 --> 00:03:42,610
.ووقّعت معاهدة هدنة

37
00:03:40,650 --> 00:03:46,950
هذا الأنمي عمل من نسج الخيال. أيّ تشابه في الشّخصيّات والمنظّمات والأماكن
.والأسماء وما إلى ذلك، الّتي تمّ ذكرها، لا علاقة لها بأحداث واقعيّة

38
00:03:43,450 --> 00:03:44,950
،ولمدّة طويلة

39
00:03:45,240 --> 00:03:48,370
.لم تكن هنالك أيّة مشاكل حتّى في بلدتنا

40
00:03:47,450 --> 00:03:49,950
!لا تثقوا في أنفسكم كثيرًا

41
00:03:49,120 --> 00:03:49,950
...إلى أن

42
00:03:49,950 --> 00:03:52,080
!يا حثالة النّازيّين البؤساء

43
00:03:50,200 --> 00:03:52,870
بدأ الأمر بإلقاء سيّدة عجوز بحجر

44
00:03:52,870 --> 00:03:56,500
.على فرقة جنود ألمانيّة وبدأت بالصّراخ بغضب عليها

45
00:03:57,380 --> 00:04:00,050
،تجاهلها الجنود في البداية

46
00:04:00,050 --> 00:04:02,970
،لكنّ حدّة الأمور قد ازدادت

47
00:04:02,970 --> 00:04:05,180
.وما كانوا سيسمحون باستمرار الأمر في النّهاية

48
00:04:06,090 --> 00:04:08,850
...وفي الوقت الّذي كانت ستُعدم فيه

49
00:04:13,140 --> 00:04:16,940
.ظهرتَ أنت وأنقذتَها

50
00:04:18,900 --> 00:04:24,400
...وحينها تقدّمنا نحن في عجلة نحو الألمان لحمايتك، لكن

51
00:04:24,740 --> 00:04:30,580
،كان جنديّ يلوّح ببندقيّته
.وقد أصابتك مباشرة في صدغك

52
00:04:31,330 --> 00:04:32,330
ماذا هنالك؟

53
00:04:32,700 --> 00:04:34,750
.تبدو منزعجًا نوعًا ما فجأة

54
00:04:35,710 --> 00:04:37,000
!على الإطلاق

55
00:04:37,630 --> 00:04:40,210
.في كلّ الأحوال، أشكركم على إنقاذي

56
00:04:40,210 --> 00:04:43,420
هل أنت يابانيّ بالفعل؟

57
00:04:43,420 --> 00:04:44,930
لماذا تسأل؟

58
00:04:46,840 --> 00:04:49,970
.إنّك تتحدّث الفرنسيّة الآن بلكنة باريسيّة

59
00:04:50,430 --> 00:04:52,310
،لكن عندما كنتَ فاقدًا للوعي

60
00:04:52,720 --> 00:04:55,480
.كنت تُتمتم بالرّوسيّة

61
00:04:55,810 --> 00:04:58,060
،ماذا؟ لسبب ما

62
00:04:58,060 --> 00:05:00,770
.أشعر أنّي قد أخفقتُ بالفعل

63
00:05:01,860 --> 00:05:03,490
.هذا ليس كلّ شيء

64
00:05:05,900 --> 00:05:08,910
.هذه نظّارات بغرض الزّينة فحسب

65
00:05:09,450 --> 00:05:12,620
.كما أنّه كان هنالك قطن داخل فمك

66
00:05:13,080 --> 00:05:16,250
،لقد أعاقنا ذلك عندما كنّا نحاول علاجك، وعند إزالته

67
00:05:16,250 --> 00:05:18,250
.مع النظّارة، تغيّر مظهرك

68
00:05:18,580 --> 00:05:21,590
.هنالك أمر اعتقدتُه غريبًا أنا الآخر

69
00:05:22,090 --> 00:05:24,510
،عندما كنّا نحمله إلى هنا

70
00:05:24,840 --> 00:05:26,550
.تمتم بأرقام ما

71
00:05:27,550 --> 00:05:31,430
.كانت تسعون إلى ثمانية إلى اثنان على ما أظنّ

72
00:05:31,640 --> 00:05:33,850
تسعون إلى ثمانية إلى اثنان؟

73
00:05:34,640 --> 00:05:36,600
ما الّذي تعنيه؟

74
00:05:37,890 --> 00:05:38,980
.لستُ أدري

75
00:05:39,270 --> 00:05:42,150
...لكن لا أعتقد أنه كان عليّ أن أخبر أحدًا

76
00:05:44,280 --> 00:05:46,860
،رجل من تلك الطّينة محبوب من أصدقائه”

77
00:05:47,450 --> 00:05:50,160
“.ولا تخشى بلاده أن تموت

78
00:05:50,870 --> 00:05:54,160
.هذه هي كلمات الشّاعر الرّومانيّ القديم هوراس

79
00:05:55,580 --> 00:05:57,830
،عندما استعدتَ الوعي في هذه الغرفة

80
00:05:58,210 --> 00:06:00,170
قرأتَ الكلمات الّتي انعكست على المرآة

81
00:06:00,460 --> 00:06:03,300
.بينما لا زلتَ دائخًا

82
00:06:05,130 --> 00:06:06,010
.شيمانو

83
00:06:06,970 --> 00:06:10,470
.أنت هو البطل الّذي أنقذ حياة عجوز فرنسيّة

84
00:06:11,140 --> 00:06:15,140
.لهذا السّبب عرّضنا أنفسنا للخطر لإنقاذك

85
00:06:15,720 --> 00:06:18,770
،لكنّ الأشياء الّتي تقوم بها أشبه بطبيعةٍ ثانيةٍ لك

86
00:06:19,230 --> 00:06:20,560
...إنّها

87
00:06:21,360 --> 00:06:24,020
.تجعلني أشكّ أنّك رجل يابانيّ عاديّ

88
00:06:24,570 --> 00:06:26,610
مَن أنت في الحقيقة؟

89
00:06:32,030 --> 00:06:32,620
...أنا

90
00:06:33,080 --> 00:06:33,870
.لا تتكلّم

91
00:06:36,240 --> 00:06:37,250
...توقّفوا

92
00:06:39,080 --> 00:06:40,080
.توقّفوا

93
00:06:41,580 --> 00:06:42,580
!توقّفوا

94
00:06:43,670 --> 00:06:44,920
!توقّفوا رجاءً

95
00:06:45,710 --> 00:06:46,630
...لا

96
00:06:49,970 --> 00:06:51,640
!لا تنظروا إليّ

97
00:06:59,980 --> 00:07:01,020
.الألمان

98
00:07:01,940 --> 00:07:03,060
كيف؟

99
00:07:03,770 --> 00:07:05,360
كيف عثروا علينا؟

100
00:07:06,230 --> 00:07:08,150
.لا بدّ أنّ هنالك من تبعنا

101
00:07:08,490 --> 00:07:12,110
!لهذا السّبب كنتُ معارضًا لفكرة إحضاره إلى هنا

102
00:07:12,410 --> 00:07:14,740
.كنّا حذرين للغاية لنتجنّب ألاّ يتبعنا أحد

103
00:07:14,740 --> 00:07:16,280
—من المستحيل أن يكون هنالك من تبعنا

104
00:07:16,700 --> 00:07:19,000
مهلاً يا شيمانو! إلى أين أنت ذاهب؟

105
00:07:20,870 --> 00:07:23,790
أتوا إلى هنا من أجلي، صحيح؟

106
00:07:24,330 --> 00:07:26,800
.لا أريد أن أتسبّب لكم بالمزيد من المشاكل

107
00:07:27,340 --> 00:07:28,920
.شكرًا لكم على مساعدتي

108
00:07:31,090 --> 00:07:32,380
.اخترقهم

109
00:07:34,890 --> 00:07:38,100
.الموت هو أسوأ احتمال. عِش

110
00:07:39,100 --> 00:07:40,060
!مهلاً

111
00:07:41,310 --> 00:07:42,600
.أنت على خطأ يا شيمانو

112
00:07:42,980 --> 00:07:46,440
.نحن من سيتعرّض لمشاكل أكبر إن غادرت

113
00:07:46,900 --> 00:07:47,820
ماذا تعني؟

114
00:07:48,780 --> 00:07:50,150
!توقّف يا ألان

115
00:07:50,150 --> 00:07:52,530
!تذكّر ما الّذي يفعله الجيش اليابانيّ في الوقت الحاليّ

116
00:07:52,860 --> 00:07:55,320
.لا علاقة لشيمانو بجيشهم

117
00:07:55,870 --> 00:07:59,620
.كما أنّ الأمر ليس وكأنّ فرنسا واليابان في حرب الآن

118
00:08:00,120 --> 00:08:02,210
ماري، ما هو رأيك؟

119
00:08:02,210 --> 00:08:05,750
.أنقذ شيمانو واحدًا من شعبنا

120
00:08:06,250 --> 00:08:09,000
.لا يبدو أنّ فقدانه للذّاكرة تمثيليّة ما

121
00:08:09,550 --> 00:08:11,670
علينا على الأقلّ أن نخبره بالوضع؟

122
00:08:14,630 --> 00:08:16,600
.أنا أوافق ألان

123
00:08:17,010 --> 00:08:18,640
.اثنان ضدّ واحد

124
00:08:20,810 --> 00:08:21,810
...نحن

125
00:08:22,930 --> 00:08:24,390
.مع المقاومة

126
00:08:29,650 --> 00:08:35,360
أنتم أعضاء من مجموعة معارضين سرّيّين
للاحتلال الألماني، أهذا ما تقصده؟

127
00:08:45,170 --> 00:08:47,750
.لنهرب خلسة من الخلف

128
00:08:47,750 --> 00:08:48,670
.كلاّ

129
00:08:48,960 --> 00:08:52,090
لا يوجد جنود بما فيه الكفاية في الخارج
.ليفسّروا وجود كلّ هذه السّيّارات

130
00:08:52,960 --> 00:08:56,430
.يجب أن يكون هنالك أربعة... بل خمسة آخرون

131
00:08:56,840 --> 00:08:59,850
هذا فخّ. الخطّة الحقيقيّة هي الإمساك

132
00:08:59,850 --> 00:09:02,430
.بأيّ شخص يهرب متسلّلاً من الخلف

133
00:09:02,640 --> 00:09:05,770
لماذا؟ لماذا أعرف شيئًا كهذا؟

134
00:09:06,350 --> 00:09:09,400
.فخّ؟ إذًا فلا مهرب أمامنا

135
00:09:10,980 --> 00:09:12,440
.بإمكاننا اختراقهم

136
00:09:12,820 --> 00:09:13,940
ما الّذي لديكم هنا؟

137
00:09:15,110 --> 00:09:18,160
هل هنالك أسلحة؟
أنتم مناضلون في المقاومة، صحيح؟

138
00:09:19,450 --> 00:09:22,910
.هدفنا ليس هو الاحتدام معهم في المعارك

139
00:09:23,370 --> 00:09:24,250
—نحن

140
00:09:24,250 --> 00:09:26,750
هل لديكم أيّة أسلحة أم لا؟

141
00:09:27,250 --> 00:09:28,500
.لدينا مسدّس

142
00:09:29,040 --> 00:09:31,340
.حصل عليه جان

143
00:09:32,420 --> 00:09:33,920
.أعطنيه، في الحال

144
00:09:37,010 --> 00:09:38,760
.أعتقد أنّه معطّل

145
00:09:39,260 --> 00:09:41,050
.الزّناد عالق

146
00:09:44,980 --> 00:09:46,020
...هذا

147
00:09:49,690 --> 00:09:53,690
.صحيح، هنالك شيء ما عالق هناك

148
00:09:54,860 --> 00:09:56,860
أهنالك شيء آخر يمكننا استعماله كسلاح؟

149
00:09:56,860 --> 00:09:59,110
.كلاّ، لا شيء

150
00:09:59,110 --> 00:10:01,070
.يمكن استعمال أواني المطبخ

151
00:10:01,660 --> 00:10:04,950
عندما يبدأ القتال، احرصوا
.على أن تدّخروا كلّ ما هو أبيض

152
00:10:05,410 --> 00:10:07,620
.هذه مقولة فرنسيّة قديمة

153
00:10:07,620 --> 00:10:11,080
...دقيق القمح والملح والسّكّر و

154
00:10:11,080 --> 00:10:12,210
منفاخ؟

155
00:10:12,210 --> 00:10:12,750
ماذا؟

156
00:10:12,750 --> 00:10:13,880
هل لديكم منفاخ؟

157
00:10:14,710 --> 00:10:17,720
.لدينا منفاخُ قدم قديم في المطبخ

158
00:10:17,720 --> 00:10:19,590
.أحضريه، وأحضري الدّقيق أيضًا

159
00:10:20,140 --> 00:10:20,930
!حسنًا

160
00:10:21,220 --> 00:10:24,930
ألان، راقب الوضع في الخارج
.من خلال الشّقّ في الباب

161
00:10:25,310 --> 00:10:27,640
.جان، أرخِ المصابيح

162
00:10:30,020 --> 00:10:31,150
!اخرجوا

163
00:10:31,150 --> 00:10:33,110
!نعلم أنّكم في الدّاخل

164
00:10:33,520 --> 00:10:35,030
!افتحوا الباب

165
00:10:35,030 --> 00:10:37,690
.اخرجوا بهدوء من أجل صالحكم

166
00:10:37,990 --> 00:10:39,200
!افتحوا

167
00:10:41,110 --> 00:10:42,030
.لقد أصلحتُه

168
00:10:42,950 --> 00:10:44,950
.بإمكانه الإطلاق في أيّ وقت

169
00:10:47,000 --> 00:10:48,080
...شكرًا لك

170
00:10:48,500 --> 00:10:50,080
ما كان عُطله؟

171
00:10:50,370 --> 00:10:51,040
.لا أدري

172
00:10:51,370 --> 00:10:54,420
،لقد فسختُ أجزاءه ثمّ جمعتها معًا ثانية
.وهكذا أصبح يعمل من جديد

173
00:10:54,920 --> 00:10:57,130
.ربّما لم يتمّ جمع أجزائه بشكل جيّد

174
00:10:57,510 --> 00:10:58,760
.إنّه مسدّس قديم

175
00:11:01,220 --> 00:11:02,550
من سيحمله؟

176
00:11:02,840 --> 00:11:03,890
.أنا

177
00:11:03,890 --> 00:11:07,520
.كلاّ. أنا من حصل عليه، لذلك أنا من سيحمله

178
00:11:10,020 --> 00:11:11,900
ماري، هل تستطيعين أخذه؟

179
00:11:11,900 --> 00:11:12,600
ماذا؟

180
00:11:12,980 --> 00:11:15,070
.إنّه ليس لقتل أيّ أحد بالطّبع

181
00:11:15,480 --> 00:11:16,860
.بل هو من أجل حمايتك

182
00:11:17,480 --> 00:11:18,190
أموافقان؟

183
00:11:18,570 --> 00:11:19,240
.نعم

184
00:11:20,240 --> 00:11:21,150
.بالتّأكيد

185
00:11:21,610 --> 00:11:23,570
.أنتِ مسؤولة عن حماية نفسك بنفسك

186
00:11:34,380 --> 00:11:35,750
ما هو هذا؟

187
00:11:35,750 --> 00:11:36,920
ما الّذي يحدث؟

188
00:11:38,090 --> 00:11:39,920
!سُحقًا، لا أستطيع رؤية شيء

189
00:11:40,260 --> 00:11:41,590
!ليُشعل أحدكم الأضواء

190
00:11:58,020 --> 00:11:59,360
...ما الّذي

191
00:12:01,440 --> 00:12:02,400
ما هذا؟

192
00:12:02,400 --> 00:12:03,660
!ماذا حدث؟

193
00:12:05,870 --> 00:12:07,120
!الآن، بسرعة

194
00:12:16,840 --> 00:12:17,630
.هيّا

195
00:12:41,570 --> 00:12:42,740
...شيمانو

196
00:12:42,740 --> 00:12:46,360
مَن... مَن تكون أنت؟

197
00:12:47,030 --> 00:12:50,910
لم يكن هنالك أيّ شيء في تلك
.الغرفة لتستعمله كقنبلة

198
00:12:50,910 --> 00:12:53,660
.لقد استعملتُ دقيق القمح الّذي خزّنتموه

199
00:12:55,290 --> 00:12:56,880
.انفجارُ غبار

200
00:12:57,540 --> 00:12:59,130
.إنّه ليس شيئًا مميّزًا في الحقيقة

201
00:12:59,840 --> 00:13:04,340
في الواقع، إنّه لا يختلف كثيرًا
عن انفجارات غبار الفحم

202
00:13:04,340 --> 00:13:05,970
.الّتي تحدث أحيانًا في المناجم

203
00:13:06,550 --> 00:13:08,640
يمكن لأيّ أحد أن يتسبّب في انفجار كهذا

204
00:13:08,640 --> 00:13:11,350
بموازنة الكمّيّة المناسبة من الغبار في الهواء

205
00:13:11,350 --> 00:13:12,770
.مع الكثافة المناسبة من الأوكسجين

206
00:13:16,850 --> 00:13:19,230
.جان، ماري، استمعا

207
00:13:19,730 --> 00:13:21,480
،قد نرغب في معرفة من يكون شيمانو

208
00:13:22,190 --> 00:13:26,700
لكن في الوقت الحاليّ، لدينا أمور أخرى
.أكثر أهمّيّة لمناقشتها

209
00:13:27,780 --> 00:13:31,990
لم ينقذ شيمانو حياة عجوز
،ريفيّة من أبناء وطننا فحسب

210
00:13:32,410 --> 00:13:37,290
لكنّه أنقذنا نحن أيضًا
.من وضع كنّا نواجه فيه الموت

211
00:13:37,580 --> 00:13:38,670
!أ-ألان

212
00:13:38,670 --> 00:13:40,670
—تمهّل، أنت لا تقصد

213
00:13:42,250 --> 00:13:44,210
.إليكما خطّتي

214
00:13:44,510 --> 00:13:46,720
،من الآن فصاعدًا، سنعتبر شيمانو حليفًا

215
00:13:47,010 --> 00:13:49,090
وسنطلب منه المساعدة بشكل رسميّ

216
00:13:49,090 --> 00:13:51,810
!في عمليّاتنا القادمة

217
00:13:54,140 --> 00:13:57,520
!ألان، هل فقدتَ عقلك؟

218
00:13:58,020 --> 00:13:59,980
ماري، ما رأيك؟

219
00:14:01,230 --> 00:14:05,110
.أنا أوافقك الرّأي

220
00:14:05,740 --> 00:14:09,200
.سُحقًا، أنتِ إلى جانبه دائمًا

221
00:14:11,320 --> 00:14:12,530
.حُلّ الأمر هكذا

222
00:14:13,200 --> 00:14:18,710
شيمانو، هل تستطيع تقديم
يد العون لنا ولبلادنا الأمّ؟

223
00:14:22,340 --> 00:14:26,050
.دعونا نهرب من هنا قبل أن أجيب على ذلك

224
00:14:26,710 --> 00:14:28,550
.لا يزال العدوّ قريبًا

225
00:14:30,840 --> 00:14:32,890
أين هو أقرب مخابئكم؟

226
00:14:32,890 --> 00:14:34,060
.إنّه في شاتيّون

227
00:14:34,350 --> 00:14:36,430
.سيأخذ الأمر منّا ساعة للوصول إلى هناك مشيًا

228
00:14:36,720 --> 00:14:37,560
.لنذهب

229
00:14:41,730 --> 00:14:42,860
.توقّفوا

230
00:14:46,860 --> 00:14:47,740
ماري؟

231
00:14:49,490 --> 00:14:50,490
ما الخطب؟

232
00:14:50,950 --> 00:14:52,570
لماذا تصوّبين المسدّس نحونا؟

233
00:14:53,160 --> 00:14:54,280
.أنا آسفة

234
00:14:54,700 --> 00:14:58,540
...ليته لم يظهر، ما كان أبدًا لهذا أن

235
00:14:59,250 --> 00:15:00,750
.توقّعتُ هذا

236
00:15:00,750 --> 00:15:04,210
،علمتُ أنّه احتمال وارد
.لكن اتّضح أنّ هنالك دسيس بيننا

237
00:15:05,210 --> 00:15:07,550
.كنتِ أنتِ من خرّب ذلك المسدّس

238
00:15:08,130 --> 00:15:10,340
كلاّ، أنتِ واحدة من معاونيهم؟

239
00:15:10,880 --> 00:15:14,140
جاسوسة للألمان تمّ دسّها في المقاومة؟

240
00:15:14,430 --> 00:15:15,510
أهذا صحيح؟

241
00:15:15,810 --> 00:15:17,680
لماذا يا ماري؟

242
00:15:17,930 --> 00:15:19,310
—لماذا قد تتعاونين مع

243
00:15:19,310 --> 00:15:20,810
!للنّجاة

244
00:15:22,980 --> 00:15:26,070
...لأتمكّن... وعائلتي أيضًا

245
00:15:37,910 --> 00:15:39,660
.حدث هذا منذ شهر مضى

246
00:15:40,790 --> 00:15:42,920
.كنتُ أقوم بكلّ ما بوسعي لتدبّر أمري

247
00:15:43,460 --> 00:15:47,380
.فعلتُ كلّ ما أقدر عليه لكي لا أعرّضكما للخطر

248
00:15:48,420 --> 00:15:49,090
...لكن

249
00:15:58,430 --> 00:16:01,350
...على هذا المعدّل، فعائلتي الآن

250
00:16:02,350 --> 00:16:03,810
.أنا جدُّ آسفة

251
00:16:04,480 --> 00:16:06,860
.لكنّي بحاجة لأسلّمكم إلى الألمان

252
00:16:07,190 --> 00:16:09,690
.أنتما وذلك الرّجل اليابانيّ أيضًا

253
00:16:14,780 --> 00:16:16,820
!ما— توقّف

254
00:16:17,330 --> 00:16:18,490
!سأطلق النّار

255
00:16:18,700 --> 00:16:20,540
!توقّف أرجوك

256
00:16:20,540 --> 00:16:22,580
...اقترب أكثر وسوف

257
00:16:24,330 --> 00:16:25,250
.أطلقي إذًا

258
00:16:26,170 --> 00:16:27,040
ما الخطب؟

259
00:16:29,880 --> 00:16:30,880
.لا تمُت

260
00:16:34,630 --> 00:16:35,590
...وأيضًا

261
00:16:36,180 --> 00:16:37,180
!لا تَقتُل

262
00:16:43,520 --> 00:16:45,940
جان، ألديك أيّ شيء لنربطها به؟

263
00:16:59,870 --> 00:17:02,120
هل أفقتَ؟

264
00:17:04,120 --> 00:17:05,160
...نعم

265
00:17:06,290 --> 00:17:08,960
،إذًا فقد فضّلتْ ماري عائلتها على بلادها

266
00:17:08,960 --> 00:17:12,710
.وفضّل جان حبّه على حياته

267
00:17:15,840 --> 00:17:18,390
،رجل من تلك الطّينة محبوب من أصدقائه”

268
00:17:18,390 --> 00:17:21,100
“.ولا تخشى بلاده أن تموت

269
00:17:23,020 --> 00:17:25,020
.القول أسهل من الفعل

270
00:17:26,940 --> 00:17:29,150
كيف عرفتَ أنّ ماري كانت جاسوسة؟

271
00:17:29,730 --> 00:17:31,650
.سألتني ما هو العُطل

272
00:17:33,230 --> 00:17:34,940
،بعد أن أصلحتُ المسدّس

273
00:17:35,360 --> 00:17:38,110
كانت الوحيدة الّتي سألتني
.عن العُطل الّذي كان يعانيه

274
00:17:39,160 --> 00:17:41,870
كانت تحاول أن تتبيّن إن كنتُ قد لاحظتُ

275
00:17:41,870 --> 00:17:43,370
.أنّه قد تمّ التّلاعب به

276
00:17:43,950 --> 00:17:47,210
،رغم أنّي لم أكن واثقًا مائة بالمائة

277
00:17:47,460 --> 00:17:49,880
.وهنا جاء دور الرّصاص الفارغ

278
00:17:54,510 --> 00:17:57,430
.ما لم أتوقّعه هو ما أقدم عليه جان

279
00:17:57,760 --> 00:17:59,640
،لكن بفضله هو

280
00:18:00,430 --> 00:18:02,430
،تذكّرتُ من أكون

281
00:18:02,850 --> 00:18:04,310
.وما عليّ أن أفعله

282
00:18:05,680 --> 00:18:06,730
هل ستغادر؟

283
00:18:07,020 --> 00:18:07,730
.نعم

284
00:18:08,730 --> 00:18:09,730
.فهمت

285
00:18:14,820 --> 00:18:16,280
.ألان ليرنيير

286
00:18:16,940 --> 00:18:18,110
.هذا هو اسمي

287
00:18:22,240 --> 00:18:23,740
.شيمانو ريوسكي

288
00:18:38,090 --> 00:18:39,550
.انتهى التّنظيف

289
00:18:40,260 --> 00:18:44,060
.لا شهود ولا أجهزة تنصّت

290
00:18:44,850 --> 00:18:48,140
.بروتوكول الاتّصال رقم ثلاثة

291
00:19:08,660 --> 00:19:09,580
.تقريرك

292
00:19:11,250 --> 00:19:13,330
لماذا المقدّم يوكي هنا؟

293
00:19:15,880 --> 00:19:18,010
.تسعون إلى ثمانية إلى اثنان

294
00:19:18,460 --> 00:19:22,180
هذا هو معدّل المتفرّجين

295
00:19:22,510 --> 00:19:25,470
،مقارنة بمعاوني الألمان

296
00:19:26,060 --> 00:19:27,930
.للمقاومة هنا في فرنسا

297
00:19:28,600 --> 00:19:32,600
.كان هدف مهمّتي هو مجموعة ألان منذ البداية

298
00:19:33,150 --> 00:19:36,820
كنّا نعلم بفضل معلومات سابقة أنّ ألان هو قائدٌ

299
00:19:36,820 --> 00:19:38,730
.في حركة المقاومة الفرنسيّة

300
00:19:39,740 --> 00:19:41,990
،وبغرض التّسلّل إلى مجموعتهم

301
00:19:41,990 --> 00:19:43,700
أعطيتُ السّيّدة العجوز اقتراحًا

302
00:19:43,700 --> 00:19:45,950
.وأرسلتها نحو الألمان

303
00:19:47,030 --> 00:19:50,330
مجيء ألان والآخرين لإنقاذي
.كان جزءًا من خطّتي أيضًا

304
00:19:51,330 --> 00:19:53,790
تعرّضي للضّربة على رأسي خلال
الاضطراب الّذي حدث

305
00:19:53,790 --> 00:19:56,090
،والإصابة بفقدان ذاكرة مؤقّت لم يكن في الحسبان

306
00:19:56,090 --> 00:19:58,000
،لكنّه في نفس الوقت

307
00:19:58,000 --> 00:20:00,720
،كان سوءَ تقديرٍ ضمن الاحتمالات الممكنة

308
00:20:00,720 --> 00:20:02,590
.وبالتّالي، أمسى شيئًا خطّطتُ له

309
00:20:02,970 --> 00:20:06,800
سيكون من السّهل لجاسوس أن يرى
،بشكل أبكر في الأوضاع المثاليّة

310
00:20:07,310 --> 00:20:10,140
.أنّ إمكانيّة حدوث اضطراب أو فقدان ذاكرة قد تزداد

311
00:20:11,060 --> 00:20:14,480
ولكن، بمجرّد أن تتقنوا فنّ نقشِ

312
00:20:14,480 --> 00:20:17,730
،هدف مهمّاتكم في عقلكم اللّا واعي

313
00:20:17,730 --> 00:20:19,030
.فلن يشكّل ذلك أيّة مشكلة

314
00:20:19,780 --> 00:20:23,530
في الوقت الحاليّ، المقاومة الفرنسيّة

315
00:20:23,530 --> 00:20:27,200
.تتكوّن في الأغلب من طلبة يتسبّبون في مشاكل عرضيّة

316
00:20:27,830 --> 00:20:33,040
لا أرى أيّ دليل عن وجود نظامٍ مُنظّم
.يزوّدهم بالأسلحة

317
00:20:34,080 --> 00:20:36,500
ماذا بعد هذا الآن؟

318
00:20:37,000 --> 00:20:38,750
هل عليّ أن أستمرّ قليلاً؟

319
00:20:39,460 --> 00:20:40,840
.عد إلى الوطن في الحال

320
00:20:41,710 --> 00:20:45,220
.رحلة سفينة هاكوسان مارو التّالية ستكون الأخيرة

321
00:20:46,760 --> 00:20:48,640
الأخيرة؟

322
00:20:49,350 --> 00:20:50,310
...هذا مستحيل

323
00:20:51,560 --> 00:20:55,390
ستتحالف اليابان مع ألمانيا؟

324
00:20:56,770 --> 00:21:00,730
لا أستطيع أن أتخيّل أنّ ألمانيا لديها
نظرة واضحة لكيفية السّيطرة

325
00:21:00,730 --> 00:21:04,740
.على البحار والسّماء بينما يقاتلون البريطانيّين

326
00:21:05,700 --> 00:21:08,320
.لقد أعلنوا الحرب عليهم البارحة فحسب

327
00:21:08,740 --> 00:21:10,620
...لماذا إذًا

328
00:21:13,120 --> 00:21:14,410
...كان هذا

329
00:21:14,410 --> 00:21:17,290
.أكبر سوء تقدير قمتُ به في هذه المهمّة

330
00:21:18,500 --> 00:21:19,880
.انتهت المهمّة

331
00:21:20,340 --> 00:21:25,510
لا أستطيع استعمال قناعِ طالبِ التّبادل
.الأجنبيّ اليابانيّ شيمانو ريوسكي بعد الآن

332
00:21:26,630 --> 00:21:30,140
.يؤكّد وجود المقدّم يوكي هنا ذلك الأمر

333
00:21:37,560 --> 00:21:39,020
.تستطيع البقاء

334
00:21:40,190 --> 00:21:41,650
.سأعود للوطن

335
00:21:42,440 --> 00:21:43,070
...لكن

336
00:21:44,610 --> 00:21:47,950
.في المرّة القادمة، أعطني مهمّة تتطلّب همّة أكثر بقليل

337
00:23:23,250 --> 00:23:26,500
أرى أنّك أصبحتَ منغمسًا
في المقامرة مؤخّرًا، صحيح؟

338
00:23:26,800 --> 00:23:27,670
.نعم

339
00:23:28,050 --> 00:23:28,880
لماذا؟

340
00:23:29,420 --> 00:23:31,340
،لأتذوّق إثارة النّصر

341
00:23:31,680 --> 00:23:34,260
.وعذاب الهزيمة