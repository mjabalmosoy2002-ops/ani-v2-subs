1
00:00:13,360 --> 00:00:14,990
!مع من تعمل؟

2
00:00:15,570 --> 00:00:17,780
.لقد خانتك بلادك

3
00:00:18,200 --> 00:00:21,750
.ما عادت هنالك حاجة بعد الآن لتحتفظ بولائك

4
00:00:22,450 --> 00:00:24,540
.سهّل الأمر على نفسك

5
00:00:24,830 --> 00:00:26,460
.أخبرنا بكلّ شيء تعرفه

6
00:00:28,210 --> 00:00:29,170
...أيّها

7
00:00:29,750 --> 00:00:30,920
!الوحش

8
00:00:38,550 --> 00:00:41,060
أهو جاسوس بالفعل؟

9
00:00:41,640 --> 00:00:43,140
.لا مجال للشّكّ

10
00:01:24,020 --> 00:01:27,020
!أين... أين هو؟

11
00:01:39,410 --> 00:01:43,910
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

12
00:01:44,540 --> 00:01:49,080
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

13
00:01:49,880 --> 00:01:52,340
يتمّ التّعامل مع ماضي وأسماء

14
00:01:52,340 --> 00:01:56,010
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

15
00:01:56,010 --> 00:01:59,430
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

16
00:02:00,260 --> 00:02:03,680
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

17
00:02:03,680 --> 00:02:05,890
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

18
00:02:06,230 --> 00:02:09,060
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

19
00:02:09,520 --> 00:02:11,900
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

20
00:02:12,560 --> 00:02:16,440
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

21
00:02:17,360 --> 00:02:20,070
."اسمها هو "الوكالة دي

22
00:04:16,480 --> 00:04:17,400
.لقد وصلت

23
00:04:21,320 --> 00:04:22,360
.أيّها العقيد وولف

24
00:04:23,450 --> 00:04:24,570
،هاتِ ما عنك

25
00:04:25,200 --> 00:04:26,490
.أيّها الملازم باور

26
00:04:27,280 --> 00:04:29,240
إنّ سبب تحطّم القطار

27
00:04:29,240 --> 00:04:32,000
راجع لخلل في أنوار الإشارات جرّاء
.عيوب في خطوط الكهرباء

28
00:04:32,370 --> 00:04:34,870
.من المستحيل أن يكون عملاً إرهابيًّا

29
00:04:35,330 --> 00:04:37,920
.ما هؤلاء الرّجال إلاّ مجموعةُ متجمهرينَ حول الحادثة

30
00:04:38,460 --> 00:04:42,260
.تحقّق من أمر الرّقم ثلاثة ثانية، وبشكل أدقّ

31
00:04:42,710 --> 00:04:45,050
...لكن يستحيل أن

32
00:04:45,590 --> 00:04:49,430
.أعر انتباهًا أكثر إلى أعواد الثّقاب الّتي كان يحملها

33
00:04:54,690 --> 00:04:59,230
لقد عثرنا على مادّة الكينين على
.علبة أعواد الثّقاب في محفظتك

34
00:05:00,020 --> 00:05:03,740
إن كُتبت رسالة بهذه وأخضعناها
،لمواد كيميائيّة معيّنة

35
00:05:04,030 --> 00:05:06,450
.فستصبح الكلمات مرئيّة

36
00:05:06,820 --> 00:05:08,530
...لا-لا فكرة لديّ

37
00:05:08,530 --> 00:05:09,780
...أعواد الثّقاب هذه

38
00:05:10,200 --> 00:05:11,990
.لقد التقطتُها من الأرض

39
00:05:11,990 --> 00:05:13,000
!أين؟

40
00:05:13,000 --> 00:05:15,660
.عـ-على مقربة من مكان التّحطّم

41
00:05:16,000 --> 00:05:18,080
رغم أنّك لا تدخّن؟

42
00:05:19,210 --> 00:05:23,170
.لم نجد غليونًا أو سجائر بحوزتك

43
00:05:24,970 --> 00:05:27,300
.ولا توجد آثار تبغ على أظافرك أيضًا

44
00:05:28,390 --> 00:05:31,600
.هذه محفظة أنيقة للغاية لتكون ملكك

45
00:05:32,310 --> 00:05:33,680
ممّن سرقتها؟

46
00:05:34,850 --> 00:05:38,310
.أقسم أنّي لم أسرقها من واحد منّا

47
00:05:38,310 --> 00:05:40,110
!كانت لرجل شرقيّ

48
00:05:40,520 --> 00:05:43,610
.كما أنّه كان ميتًا مسبقًا

49
00:05:43,610 --> 00:05:45,490
ما كان اسمه؟

50
00:05:45,780 --> 00:05:49,070
.لا بدّ أنّه كان يملك بطاقة في محفظته

51
00:05:50,700 --> 00:05:52,330
...لقد رميتُها

52
00:05:53,290 --> 00:05:57,210
...أعلم أنّ اسمه يبدأ... بحرف الميم

53
00:05:57,540 --> 00:06:01,000
...كان... ما... ماكو

54
00:06:01,670 --> 00:06:02,670
...ماكي

55
00:06:02,670 --> 00:06:04,170
!نعم، هذا هو

56
00:06:04,170 --> 00:06:05,460
!هذا هو اسمه

57
00:06:09,970 --> 00:06:12,680
.كاتسوهيكو ماكي. يابانيّ

58
00:06:13,640 --> 00:06:14,810
.لا بدّ أنّه هو هذا

59
00:06:19,230 --> 00:06:20,190
.لنذهب

60
00:06:22,900 --> 00:06:23,770
.أيّها العقيد

61
00:06:24,820 --> 00:06:26,320
ما الّذي نفعله به؟

62
00:06:27,940 --> 00:06:30,820
،لقد تمّت إراقة دماء رجال بلادنا مسبقًا

63
00:06:30,820 --> 00:06:35,370
وبلادنا العظيمة والمجيدة لا يمكن
.أن تكون مسؤولة عن ذلك

64
00:06:35,370 --> 00:06:37,160
.نحتاج إلى كبش محرقة

65
00:06:38,410 --> 00:06:40,250
.سلّمه للشّرطة السّرّيّة

66
00:06:47,090 --> 00:06:49,090
،فتّشوا منزل ماكي

67
00:06:49,090 --> 00:06:52,300
.لكن لا تدعوا الجيران يعرفون ما الّذي تسعون إليه

68
00:06:52,590 --> 00:06:57,060
طوّقوا المنطقة المحيطة واعتقلوا
.كلّ من تحوم حوله الشّبهات

69
00:06:57,060 --> 00:07:00,140
.سوف أحتاج للكثير من الرّجال من أجل ذلك

70
00:07:00,140 --> 00:07:01,270
.لا بأس بهذا

71
00:07:05,690 --> 00:07:08,280
،تحرّى عمل كاتسوهيكو ماكي في الماضي

72
00:07:08,570 --> 00:07:11,240
.وتحقّق أنّه ميت بالفعل بأمّ عينيك

73
00:07:11,240 --> 00:07:11,950
.حاضر

74
00:07:33,840 --> 00:07:34,680
ما الأخبار؟

75
00:07:36,430 --> 00:07:39,680
.لم نعثر على أيّ شيء يوحي أنّه جاسوس

76
00:07:39,680 --> 00:07:42,480
سيكون الاستمرار في البحث
.مضيعة للوقت ليس إلاّ

77
00:07:43,190 --> 00:07:46,820
أمسك العقيد وولف بالمئات
.من الجواسيس في مسيرته المهنيّة

78
00:07:46,820 --> 00:07:48,690
...لكن هذه المرّة

79
00:07:48,690 --> 00:07:50,240
!استمرّوا في البحث

80
00:07:59,160 --> 00:08:00,040
.أيّها العقيد

81
00:08:01,250 --> 00:08:02,540
.آسف على التّأخير

82
00:08:07,750 --> 00:08:10,010
،ماكي كاتسوهيكو، 28 سنة

83
00:08:10,010 --> 00:08:12,130
.أعزب ولا يملك زملاء سكن

84
00:08:12,420 --> 00:08:14,090
.تاجر قطع فنّيّة

85
00:08:14,090 --> 00:08:15,840
.لقد سجّل نفسه قبل حوالي العام

86
00:08:16,260 --> 00:08:20,930
إنّه سليل عائلة يابانيّة غنيّة
.وأتى إلى أوروبّا لدراسة الفنون

87
00:08:21,930 --> 00:08:24,100
،بعد المدرسة، ازداد اهتمامه بذلك المجال

88
00:08:24,100 --> 00:08:26,560
.وأنشأ عمله الفنّيّ الخاصّ به

89
00:08:26,900 --> 00:08:29,570
كانت الصّدمة هي سبب الوفاة

90
00:08:29,570 --> 00:08:31,780
إلى جانب النّزيف الحادّ بعد أن اخترقه

91
00:08:32,030 --> 00:08:33,780
.عمود فولاذيّ من حطام القطار

92
00:08:34,910 --> 00:08:38,240
.ربّما يبدو هادئًا لأنّه مات في حينها

93
00:08:39,620 --> 00:08:42,250
وأنت واثق أنّه ماكي؟

94
00:08:42,250 --> 00:08:45,080
.أريتُ صورته إلى جيرانه وأكّدوا لنا ذلك

95
00:08:45,620 --> 00:08:47,460
.هذا هو ماكي بكلّ تأكيد

96
00:08:47,880 --> 00:08:48,790
...ومع ذلك

97
00:08:49,210 --> 00:08:50,300
ماذا؟

98
00:08:51,130 --> 00:08:54,760
.لقد تفاجأت أنّه كان شابًّا وسيمًا

99
00:08:55,180 --> 00:08:59,140
.وقال عنه أحدهم أنّه بدى أكثر حيويّة وهو ميت

100
00:09:00,930 --> 00:09:04,430
توافَدَ أصدقاء وعائلات ضحايا الحادث

101
00:09:04,430 --> 00:09:06,140
،لزيارة المستشفى

102
00:09:06,520 --> 00:09:08,770
.لكن لم يحضر أحد لزيارة ماكي

103
00:09:11,530 --> 00:09:13,190
.اسمح لي أيّها العقيد

104
00:09:15,240 --> 00:09:17,280
،لقد تحقّقنا من كلّ أغراضه الشّخصيّة

105
00:09:17,780 --> 00:09:20,660
.لكنّنا لم نعثر على أيّ شيء يثير الشّبهات

106
00:09:20,660 --> 00:09:23,660
ربّما كان ماكي هذا

107
00:09:23,660 --> 00:09:27,120
مجرّد تاجر قطع نفّيّة فحسب؟

108
00:09:28,750 --> 00:09:31,590
.كاتسوهيكو ماكي جاسوسٌ يابانيّ

109
00:09:31,590 --> 00:09:33,170
.لا مجال للشّكّ في ذلك

110
00:09:33,170 --> 00:09:34,170
...لكن

111
00:09:44,020 --> 00:09:45,810
.أقراص أسبرين

112
00:09:46,100 --> 00:09:48,810
.عثرنا على بعضها أيضًا بين أغراضه

113
00:09:49,190 --> 00:09:52,070
.ربّما تركها هناك على الأرض عن قصد

114
00:09:52,440 --> 00:09:57,860
إنّه فخّ ليتحقّق أنّ لا أحد قد دخل
.منزله وهو في الخارج

115
00:10:03,620 --> 00:10:06,750
.فخّ آخر من نفس النّوع

116
00:10:08,620 --> 00:10:14,920
لكنّي سمعتُ أنّنا قد شكّلنا تحالفًا ثلاثيًّا
.سرّيًّا مع اليابان وإيطاليا

117
00:10:15,380 --> 00:10:17,670
،لماذا قد يكون هنالك جاسوس يابانيّ

118
00:10:17,670 --> 00:10:21,430
وهي بلاد صديقة لنا، موجود خلسة في بلادنا؟

119
00:10:22,010 --> 00:10:24,140
اليابان؟ صديقة؟

120
00:10:25,270 --> 00:10:28,690
.كانت اليابان عدوّتنا قبل اثنين وعشرين عامًا

121
00:10:29,640 --> 00:10:32,060
.لم تنتهي المطاردة بعد

122
00:10:32,060 --> 00:10:33,020
المطاردة؟

123
00:10:34,150 --> 00:10:36,990
...سأنال منه هذه المرّة

124
00:10:39,950 --> 00:10:44,200
هذه رسالة يابانيّة مشفّرة استطعنا
.أن نعترضها من بثّ إذاعيّ

125
00:10:45,330 --> 00:10:49,330
إذًا فتحرّكات غوّاصاتنا في البحر المتوسّط

126
00:10:49,330 --> 00:10:51,290
قد تسرّب لليابان؟

127
00:10:52,630 --> 00:10:56,550
الاسم الرّمزيّ لقائد الجواسيس
...المسؤول عن المخبرين هو

128
00:10:56,550 --> 00:10:57,630
.السّاحر

129
00:10:58,300 --> 00:11:03,010
علينا أن نفترض أنّ التّسريب صادر
.من أعلى المراتب في الحكومة

130
00:11:03,300 --> 00:11:05,930
من الضّروريّ أن نعرف هويّته
.الحقيقيّة بأسرع وقت ممكن

131
00:11:05,930 --> 00:11:07,310
.لا حاجة لذلك

132
00:11:07,600 --> 00:11:08,350
ماذا؟

133
00:11:08,680 --> 00:11:12,230
.لقد سقط السّاحر بين أيدينا سلفًا

134
00:11:18,780 --> 00:11:20,280
.أثرتَ إعجابي

135
00:11:21,110 --> 00:11:26,240
كنتَ تسرق معلومات ألمانيّة سرّيّة
.لحوالي ستّة أشهر

136
00:11:27,370 --> 00:11:29,290
عمّاذا تتحدّث؟

137
00:11:29,870 --> 00:11:31,460
...أنا لستُ جاسوسًا

138
00:11:31,790 --> 00:11:33,210
.كلّ هذا خطأ لا غير

139
00:11:33,630 --> 00:11:35,090
المعلومات الّتي لدينا قد تسرّبت

140
00:11:35,710 --> 00:11:39,170
.من مقرّ الأركان العامّة للجيش الإمبراطوريّ اليابانيّ

141
00:11:39,670 --> 00:11:40,590
،بعبارات أخرى

142
00:11:41,170 --> 00:11:43,300
.لقد خانتك بلادك

143
00:11:43,680 --> 00:11:47,180
...وفي الحقيقة، اسمك الحقيقيّ هو

144
00:11:59,400 --> 00:12:02,320
!أين... أين هو؟

145
00:12:20,000 --> 00:12:23,510
.كانت تلك آخر مرّة نراه فيها

146
00:12:26,890 --> 00:12:30,310
كان من المستحيل لرجل مصاب بجراح بليغة مثله

147
00:12:30,310 --> 00:12:34,230
.أن يختبئ في بلاد أجنبيّة لمدّة طويلة

148
00:12:35,350 --> 00:12:37,270
،بعد هروبه مباشرة

149
00:12:37,560 --> 00:12:40,440
.تمرّد بحّارو كيل

150
00:12:40,730 --> 00:12:44,900
وأدّى ذلك إلى نشوء ثورة انتشرت
،عبر البلاد بأكملها

151
00:12:44,900 --> 00:12:47,950
.وانتهت باستسلام ألمانيا للحلفاء

152
00:12:49,030 --> 00:12:51,750
أتقول أنّ كلّ هذا كان قدرًا محتومًا؟

153
00:12:52,870 --> 00:12:56,290
.لا أتصوّر وجود أيّ رجل قادر على هكذا شيء

154
00:12:56,920 --> 00:12:58,670
،قبل بضعة سنوات

155
00:12:58,670 --> 00:13:03,630
.أنشأ الجيش الإمبراطوريّ وكالة استخبارات جديدة

156
00:13:05,880 --> 00:13:07,180
."الوكالة دي"

157
00:13:07,550 --> 00:13:10,600
،يُفترض أنّها قد تأسّست على يد المقدّم يوكي

158
00:13:10,600 --> 00:13:13,140
.لكن كيفما نظرنا للأمر، تتملّص الحقيقة منّا

159
00:13:13,930 --> 00:13:16,100
.يوكي هو ذلك الرّجل

160
00:13:16,560 --> 00:13:19,770
.لقد عاد لبلاده حتّى بعد أن تنكّرت منه

161
00:13:20,940 --> 00:13:24,780
لم أسمع من قبل عن منظّمة
...في الجيش اليابانيّ

162
00:13:25,820 --> 00:13:26,610
.أيّها العقيد

163
00:13:28,240 --> 00:13:32,580
على الأرجح أنّ ماكي كان قائد
.جواسيس يدير شركاءه

164
00:13:32,580 --> 00:13:35,620
عاش في بلادنا متخفّيًا خلف هويّة
،تاجر القطع الفنّيّة

165
00:13:35,620 --> 00:13:37,370
.ويتواصل مع مخبريه

166
00:13:37,370 --> 00:13:39,580
،لقد جمع المعلومات وحلّلها

167
00:13:39,580 --> 00:13:41,750
.وأرسل تقاريره إلى بلاده

168
00:13:42,340 --> 00:13:45,800
،إن انتشر خبر وفاة ماكي

169
00:13:45,800 --> 00:13:48,430
،سيبدأ شركاؤه بالهلع

170
00:13:48,430 --> 00:13:51,350
.وستنكسر شبكة جاوسيسه في ألمانيا

171
00:13:51,640 --> 00:13:56,270
الوحيد الّذي يستطيع منع هذا هو ذلك
.الرّجل... الرّجل الّذي يعطي الأوامر لماكي

172
00:13:56,890 --> 00:14:01,820
لا يكشف قائد الجواسيس على أسماء
.أيّ واحد من مصادره حتّى لحلفائه

173
00:14:02,190 --> 00:14:06,150
.كان لماكي لائحة لشركائه مخفيّة في مكان ما

174
00:14:07,200 --> 00:14:09,200
...وذلك الرّجل

175
00:14:12,030 --> 00:14:15,250
!آتٍ ليأخذها

176
00:14:21,290 --> 00:14:22,500
،كما أمرت

177
00:14:22,500 --> 00:14:24,250
،لقد أخفينا خبر وفاة ماكي

178
00:14:24,250 --> 00:14:27,420
ووضعنا إعلانًا في الجريدة
،عن جثّة لم نتعرّف عليها

179
00:14:27,420 --> 00:14:29,550
.ووضعناه في مستشفى برلين

180
00:14:32,640 --> 00:14:34,350
،منزل ماكي تحت المراقبة

181
00:14:34,810 --> 00:14:37,230
.ونحن مستمرّون في تفتيشه

182
00:14:41,350 --> 00:14:43,770
الغرفة في مستشفى برلين حيث نحتفظ به

183
00:14:43,770 --> 00:14:46,280
.تحت المراقبة 24 ساعة وطوال أيّام الأسبوع

184
00:14:46,860 --> 00:14:49,400
كما أنّنا أعلمنا وزارة الطّيران أيضًا

185
00:14:49,400 --> 00:14:51,240
لترسل إلينا تقريرًا في الحال

186
00:14:51,240 --> 00:14:54,700
.إن اتّصل أيّ أحد بالمستشفى للاستعلام

187
00:14:57,580 --> 00:15:00,250
أعثرتم على شيء في منزل ماكي؟

188
00:15:00,250 --> 00:15:01,880
.لا شيء

189
00:15:02,290 --> 00:15:05,300
لقد تحرّينا أمر كلّ الأماكن
،الّتي كان يتردّد عليها أيضًا

190
00:15:05,670 --> 00:15:08,090
.لكن لم نعثر على شيء

191
00:15:09,090 --> 00:15:10,340
...هذا غريب

192
00:15:10,720 --> 00:15:12,840
.هنالك شيء يغيب عن أنظارنا

193
00:15:13,800 --> 00:15:14,600
.أيّها العقيد

194
00:15:16,430 --> 00:15:18,730
.أنت تفقد رباطة جأشك أيّها العقيد

195
00:15:19,520 --> 00:15:20,690
ماذا قلت؟

196
00:15:20,940 --> 00:15:23,400
لا يوجد أيّ دليل على الإطلاق

197
00:15:23,690 --> 00:15:25,900
يوحي أنّ "يوكي" هذا الّذي لا تنفكّ تتحدّث عنه

198
00:15:25,900 --> 00:15:28,230
.هو الرّجل الّذي هرب منك قبل اثنين وعشرين عامًا

199
00:15:28,610 --> 00:15:33,320
إضافة إلى ذلك، فعدى أعواد الثّقاب
،التّي قال اللّصّ أنّه سرقها

200
00:15:33,320 --> 00:15:36,080
.لا يوجد أيّ دليل يوحي أنّ ماكي جاسوس أيضًا

201
00:15:36,580 --> 00:15:38,950
إن كان هنالك جاسوس ناشط

202
00:15:39,250 --> 00:15:42,420
.فلا أعتقد أنّه استطاع إخفاء أثره بهذه الدّقّة

203
00:15:44,330 --> 00:15:47,920
.أنت تطارد شبحًا أيّها العقيد

204
00:15:54,840 --> 00:15:58,350
.لا تصدّقني إذًا؟ لكنّي واثق

205
00:15:58,640 --> 00:16:01,350
.لقد رأيتُ الوحش بأمّ عينيّ

206
00:16:01,640 --> 00:16:06,480
وتفوح من هذا الرّجل نفس رائحة الرّجل
.الّذي هرب منّي قبل اثنين وعشرين عامًا

207
00:16:07,400 --> 00:16:09,940
.موت ماكي مجرّد مصادفة

208
00:16:09,940 --> 00:16:12,450
،إن مات جاسوس بشكل غير متوقّع كهذا

209
00:16:12,780 --> 00:16:15,490
...فما كان ليبدو بذلك الهدوء

210
00:16:20,330 --> 00:16:22,620
!ما القطار الّذي كان يستقلّه ماكي؟

211
00:16:23,080 --> 00:16:23,710
ماذا؟

212
00:16:24,000 --> 00:16:25,710
،القطار الّذي كان متّجهًا إلى كرون

213
00:16:25,710 --> 00:16:28,500
!أم القطار العائد إلى برلين؟

214
00:16:29,300 --> 00:16:32,170
.كان القطار المتّجه إلى برلين

215
00:16:38,550 --> 00:16:40,520
ما الأمر يا سيّدي؟

216
00:16:43,350 --> 00:16:44,480
لقد حرص ماكي

217
00:16:44,850 --> 00:16:48,520
.ألاّ تقع لائحته في أيدي العدوّ

218
00:16:52,690 --> 00:16:53,440
،بعبارات أخرى

219
00:16:53,900 --> 00:16:58,410
كان في ذلك اليوم في طريق عودته
.بعد أن سلّم كلّ ما عرفه

220
00:17:20,260 --> 00:17:21,510
،ومِن ثمّ

221
00:17:21,850 --> 00:17:24,850
...الشّخص الّذي أعطاه ماكي كلّ معلوماته

222
00:17:33,900 --> 00:17:36,150
هل أتى أيّ أحد لزيارة رجلنا؟

223
00:17:36,450 --> 00:17:37,860
.لا أحد

224
00:17:46,330 --> 00:17:48,790
...ما-ما الّذي

225
00:17:48,790 --> 00:17:51,090
.لا يبدو أنّ هنالك شيء خارج المألوف

226
00:17:51,090 --> 00:17:53,960
!إلامَ تنظر إذًا؟

227
00:18:05,350 --> 00:18:06,680
.لا تكذب عليّ

228
00:18:07,140 --> 00:18:08,480
!أقسم أنّها الحقيقة

229
00:18:08,770 --> 00:18:11,360
لم يدخل أحد إلى هناك عدانا

230
00:18:11,360 --> 00:18:14,110
.منذ أن نقلوه إلى هنا

231
00:18:14,480 --> 00:18:16,940
منذ أن نقلوه؟

232
00:18:18,780 --> 00:18:23,620
،البارحة، عندما أتيتُ إلى هنا لاستلام صور ماكي

233
00:18:23,910 --> 00:18:27,460
.أمرتهم بنقله إلى هذه الغرفة لتسهل علينا مراقبته

234
00:18:27,460 --> 00:18:29,170
في أيّ غرفة كان من قبل؟

235
00:18:30,120 --> 00:18:32,880
.الغرفة رقم... 202

236
00:18:40,300 --> 00:18:40,800
.أنتِ

237
00:18:41,050 --> 00:18:43,140
نعم؟

238
00:18:43,810 --> 00:18:47,600
بعد حادثة البارحة، هل كانت الجثّة
الوحيدة في الغرفة 202

239
00:18:48,020 --> 00:18:50,900
هي للرّجل الّذي هو الآن في الغرفة 305؟

240
00:18:52,610 --> 00:18:57,150
كلاّ، لقد تشارك تلك الغرفة مع رجل
.عجوز مات أيضًا في الحادثة

241
00:18:57,150 --> 00:19:00,610
هل أتى أيّ أحد ليُطالب بجثّة الرّجل العجوز؟

242
00:19:02,030 --> 00:19:04,910
...لا أحد. يبدو أنّه لم يكن لديه أقارب

243
00:19:06,620 --> 00:19:09,330
قُبيل مجيء رجلك هذا إلى هنا

244
00:19:09,330 --> 00:19:12,630
.أتى رجل آخر للتّعرّف على الجثّة

245
00:19:13,330 --> 00:19:14,420
ماذا؟

246
00:19:15,420 --> 00:19:18,210
،كان معظم وجهه مغطّى بقبّعته

247
00:19:18,210 --> 00:19:21,010
،لذلك لم أستطع رؤيته بشكل واضح

248
00:19:22,300 --> 00:19:26,310
.لكنّي أعتقد أنّه كان رجلاً أجنبيًّا

249
00:19:45,740 --> 00:19:46,450
!لحظة

250
00:19:47,620 --> 00:19:50,120
أين تحتفظون بالرّجل المدعوّ ماكي؟

251
00:19:50,120 --> 00:19:52,420
.الرجل الشّرقيّ الّذي مات في حادثة تحطّم القطار

252
00:19:52,790 --> 00:19:54,580
...من أنتما

253
00:19:54,880 --> 00:19:57,250
صحيح، هل كان هو؟

254
00:19:58,340 --> 00:20:01,340
.كلاّ. لم يكن هو من أبحث عنه

255
00:20:02,720 --> 00:20:05,470
،كان لديه عكّاز

256
00:20:05,470 --> 00:20:07,390
.ويعرج في مشيته

257
00:20:11,060 --> 00:20:15,940
.وكان يرتدي قفّازًا أبيضًا في إحدى يديه

258
00:20:35,120 --> 00:20:40,050
عندما عرف ذلك الرّجل أنّ القطار
،الّذي استقلّه ماكي قد تحطّم

259
00:20:40,050 --> 00:20:43,260
.لا بدّ أنّه ركب سيّارة وأتى على عجل إلى برلين

260
00:20:43,760 --> 00:20:46,930
،كان ماكي يملك لائحة شركائه
أكثر الممتلكات أهمّيّة

261
00:20:46,930 --> 00:20:49,850
،في العالم بالنّسبة لقائد جواسيس
.بحوزته طوال الوقت

262
00:20:50,140 --> 00:20:53,350
شريط الصّور الفوتوغرافيّة المصغّر
مع نسخة من اللاّئحة

263
00:20:53,350 --> 00:20:56,650
.تمّت خياطتهما في ياقة قميصه

264
00:20:58,980 --> 00:21:01,440
،بعد أن غادر ذلك الرّجل المستشفى

265
00:21:01,440 --> 00:21:05,400
لا بدّ أنّه قام بالاتّصال بكلّ من في اللاّئحة

266
00:21:05,400 --> 00:21:08,490
.ومحى آثارًا لأيّ دليل

267
00:21:11,330 --> 00:21:12,580
أن تكون جاسوسًا

268
00:21:12,910 --> 00:21:15,620
،يعني أن تعيش وحيدًا في أرض غريبة

269
00:21:16,040 --> 00:21:18,960
وترسل المعلومات إلى موطنك

270
00:21:18,960 --> 00:21:22,090
.دون أن تسمح لأيّ أحد بأن يعرف حقيقتك

271
00:21:22,880 --> 00:21:24,590
،بالنّسبة لجاسوس

272
00:21:24,920 --> 00:21:27,390
.الموت هو نهاية كلّ شيء

273
00:21:31,930 --> 00:21:35,640
لكن رغم أنّ هذا الرّجل المدعوّ ماكي قد وُورِيَ الثّرى

274
00:21:35,640 --> 00:21:38,900
،دون أن يعرف أحد هويّته الحقيقيّة

275
00:21:38,900 --> 00:21:42,320
.يمكننا أن نقول أيضًا أنّه أدّى واجبه كجاسوس

276
00:21:43,320 --> 00:21:45,820
المعلومات الّتي تركها خلفه

277
00:21:46,700 --> 00:21:48,990
.ستستمرّ بالعيش

278
00:23:19,960 --> 00:23:24,000
الحلقة القادمة

279
00:23:21,460 --> 00:23:23,670
.يبدو أنّك قد انفصلت عن فتاتك ثانية

280
00:23:24,130 --> 00:23:24,920
.نعم

281
00:23:25,250 --> 00:23:28,590
.لا فائدة من البقاء معهنّ لفترة طويلة

282
00:23:29,800 --> 00:23:32,090
نكون جميعًا جميلين

283
00:23:32,090 --> 00:23:34,600
إذا ما مررنا فحسب، صحيح؟