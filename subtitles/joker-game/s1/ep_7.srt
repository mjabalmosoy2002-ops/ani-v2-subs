1
00:00:07,110 --> 00:00:09,070
.ازرعوا متفجّرات في مخزن السّفينة

2
00:00:09,070 --> 00:00:10,480
.وضاعفوا الكمّيّة المعتادة

3
00:00:11,740 --> 00:00:13,610
ماذا عن طاقم السّفينة؟

4
00:00:13,900 --> 00:00:15,450
أقلتَ الطّاقم؟

5
00:00:15,450 --> 00:00:16,240
!أنتم

6
00:00:17,240 --> 00:00:18,410
!أخرجونا

7
00:00:22,790 --> 00:00:25,250
.كانت لديهم تعليمات حسب معلوماتنا

8
00:00:25,710 --> 00:00:27,630
.لا تتركوا ولا دليلاً واحدًا

9
00:00:29,500 --> 00:00:31,710
!توقّفوا

10
00:00:35,880 --> 00:00:39,810
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

11
00:00:40,350 --> 00:00:45,390
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

12
00:00:46,560 --> 00:00:49,060
يتمّ التّعامل مع ماضي وأسماء

13
00:00:49,060 --> 00:00:52,570
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

14
00:00:52,990 --> 00:00:55,860
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

15
00:00:56,780 --> 00:00:59,580
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

16
00:00:59,580 --> 00:01:01,740
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

17
00:01:02,330 --> 00:01:05,250
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

18
00:01:05,620 --> 00:01:07,830
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

19
00:01:09,000 --> 00:01:12,710
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

20
00:01:13,420 --> 00:01:15,920
."اسمها هو "الوكالة دي

21
00:02:54,520 --> 00:02:55,480
!ها هي ذي

22
00:02:56,020 --> 00:02:57,280
!الجُزر

23
00:02:57,990 --> 00:02:58,860
.وأخيرًا

24
00:02:59,700 --> 00:03:01,360
.إنّها جُزر الهاواي

25
00:03:01,660 --> 00:03:05,910
.سوف نرسو في هونولولو بعد حوالي ثلاث ساعات

26
00:03:11,670 --> 00:03:13,250
ألن تستمتع بالمنظر؟

27
00:03:14,080 --> 00:03:17,130
.ذهب الجميع إلى ميمنة السّفينة

28
00:03:18,090 --> 00:03:20,630
.آسف، أنا مشغول حاليًّا

29
00:03:21,010 --> 00:03:23,590
كلمات متقاطعة؟

30
00:03:24,050 --> 00:03:25,510
.إله البحر

31
00:03:25,890 --> 00:03:26,760
ماذا؟

32
00:03:26,760 --> 00:03:29,140
.ثمانية أحرف، والحرف الثّالث هو السّين

33
00:03:29,140 --> 00:03:30,310
أتعرف الكلمة؟

34
00:03:32,270 --> 00:03:33,650
.بوسايدون

35
00:03:34,810 --> 00:03:37,520
لا يعرف البحر إلاّ رجل من البحر، صحيح؟

36
00:03:37,770 --> 00:03:39,530
ماذا عن هذه؟

37
00:03:41,240 --> 00:03:43,660
.اختلافات وفراغ، ستّة أحرف

38
00:03:43,660 --> 00:03:46,330
.أظنّ أنّ الحرف الأخير هو الألف

39
00:03:48,540 --> 00:03:51,160
...أعتذر، أخشى أنّي لا أعرف هذه

40
00:03:52,460 --> 00:03:56,250
.حسنًا، سأتخطّى هذه الكلمة العموديّة الآن

41
00:03:56,250 --> 00:03:57,040
...التّالية هي

42
00:03:57,040 --> 00:03:58,500
!لا! توقّف

43
00:03:59,130 --> 00:03:59,920
!مكانك

44
00:04:11,730 --> 00:04:12,980
هل من خطب ما؟

45
00:04:12,980 --> 00:04:15,850
.أتى كلب من حيث لا ندري وأخافها

46
00:04:16,480 --> 00:04:18,070
.تعالي معي

47
00:04:32,450 --> 00:04:34,500
أرأيتِ الدّلافين؟

48
00:04:34,870 --> 00:04:36,920
!ماما، إنّها دلافين

49
00:04:37,330 --> 00:04:39,800
.هيّا، سوف نذهب لرؤيتها

50
00:04:39,800 --> 00:04:40,670
!حسنًا

51
00:04:49,470 --> 00:04:50,850
ما اسمك؟

52
00:04:50,850 --> 00:04:51,810
!إمّا

53
00:04:52,520 --> 00:04:54,390
هل ستعودين إلى غرفتك؟

54
00:04:54,390 --> 00:04:57,850
.لا، سأكون على ما يرام بمجرّد أن أرتاح قليلاً

55
00:04:58,150 --> 00:05:00,820
،واحد، اثنان، ثلاثة، أربعة

56
00:05:00,820 --> 00:05:02,190
!خمسة

57
00:05:04,530 --> 00:05:06,150
...لقد رحلت

58
00:05:06,660 --> 00:05:08,070
إلى أين ذهبت؟

59
00:05:08,070 --> 00:05:10,240
ربّما عادت إلى منازلها؟

60
00:05:10,530 --> 00:05:13,370
حيث توجد منازل كلّ الدّلافين؟

61
00:05:15,960 --> 00:05:17,040
من يدري؟

62
00:05:18,250 --> 00:05:19,920
.شكرًا جزيلاً لك

63
00:05:20,790 --> 00:05:22,960
.أشعر بتحسّن أكثر الآن

64
00:05:22,960 --> 00:05:24,670
.تعالي يا إمّا

65
00:05:26,930 --> 00:05:27,970
ماذا نقول؟

66
00:05:27,970 --> 00:05:29,090
!شكرًا لك

67
00:05:29,510 --> 00:05:31,100
.على الرّحب

68
00:05:44,570 --> 00:05:46,070
هل أستطيع مساعدتك؟

69
00:05:46,700 --> 00:05:48,070
.اعذرني

70
00:05:48,070 --> 00:05:50,570
.كنت مارًّا من هنا فجذبتْ انتباهي

71
00:05:50,910 --> 00:05:52,450
...وقبل أن أدرك الأمر

72
00:05:53,910 --> 00:05:55,620
.جيفري مورغان

73
00:05:55,910 --> 00:05:59,670
.أنا أدير شركة تجارة صغيرة في سان فرانسيسكو

74
00:05:59,670 --> 00:06:02,380
.أوسامو أوتسومي. أنا مهندس يابانيّ

75
00:06:02,920 --> 00:06:07,550
ليس من طبيعتي أن أترك
.كلمات متقاطعة دون حلّ وأرحل

76
00:06:07,550 --> 00:06:09,090
.إنّها واحدة من عاداتي السّيّئة

77
00:06:09,090 --> 00:06:11,050
!هذا ممتاز

78
00:06:11,350 --> 00:06:13,260
هل أستطيع استعارة تلك المعرفة لدقيقة؟

79
00:06:13,260 --> 00:06:16,310
.أنا في حيرة من أمري في الوقت الحاليّ

80
00:06:18,020 --> 00:06:20,440
".منطقةٌ سبِخة على شواطئ بحر البلطيق"

81
00:06:20,770 --> 00:06:24,650
،آخر كلمة حللتُها كانت بوسايدون
.لذلك أعرف أنّ الحرف الأوّل هو الباء

82
00:06:25,190 --> 00:06:26,360
.بوميرانيا

83
00:06:26,650 --> 00:06:29,530
...هكذا إذًا! كانت بوميرانيا

84
00:06:31,070 --> 00:06:32,740
ماذا عن هذه؟

85
00:06:32,740 --> 00:06:35,330
.اختلافات وفراغ، ستّة أحرف

86
00:06:35,700 --> 00:06:38,120
.أظنّ أنّ الحرف الأخير هو الأف

87
00:06:40,420 --> 00:06:41,750
.إنيغما

88
00:06:43,670 --> 00:06:45,000
...إنيغما

89
00:06:45,670 --> 00:06:47,340
تقصد مقطوعة "اختلافات إنيغما"؟

90
00:06:47,630 --> 00:06:51,550
.إنّها واحدة من التّحف الفنّيّة للموسيقيّ الإنجليزيّ إلغار

91
00:06:51,800 --> 00:06:53,850
."أصل الاسم يونانيّ ويعني "لغز

92
00:06:53,850 --> 00:06:57,100
،أضاف إلغار العديد من الألغاز إلى المقطوعة

93
00:06:57,100 --> 00:07:00,190
.وبعضها لم يتمّ حلّه حتّى يومنا هذا

94
00:07:00,190 --> 00:07:02,850
.هذا مثير للاهتمام، لغز غير محلول

95
00:07:03,150 --> 00:07:04,560
.إنّها نفس الشّيء

96
00:07:05,270 --> 00:07:07,320
نفس الشّيء؟ ماذا تقصد؟

97
00:07:07,320 --> 00:07:12,200
الأمر ينطبق أيضًا على آلة إنيغما
.الّتي يستعملها الألمان

98
00:07:13,570 --> 00:07:15,780
.منيعة وحصينة

99
00:07:16,080 --> 00:07:18,500
.لغز لا يمكن أن يُحلّ أبدًا

100
00:07:20,500 --> 00:07:22,370
حصلت شركتي في لايبزيغ

101
00:07:22,370 --> 00:07:26,170
على واحدة كان يتمّ عرضها
،في مؤتمر الاتّحاد البريديّ

102
00:07:26,170 --> 00:07:29,800
.واستُعملت إلى أقصى إمكاناتها

103
00:07:30,170 --> 00:07:33,050
،وبعدها، اختفت هذه الآلات من الأسواق فجأة

104
00:07:33,050 --> 00:07:37,060
وعندما بحثتُ في الأمر، عرفتُ أنّه يتمّ
.استعمالها من طرف الألمان

105
00:07:37,430 --> 00:07:41,810
.سمعتُ أنا أيضًا بحالات مشابهة

106
00:07:42,060 --> 00:07:45,980
وبعد ذلك، يُفترض أنّ الألمان
قد عدّلوا آلة إنيغما

107
00:07:45,980 --> 00:07:50,860
لجعلها قادرة على استعمال ما يزيد
.عن مائتيْ تريليون تركيبة

108
00:07:51,780 --> 00:07:53,030
.هكذا إذًا

109
00:07:53,360 --> 00:07:56,740
إذًا فحركات سُفن اليوبوت الألمانيّة
الّتي كانت لديها أوامر مشفّرة بآلة إنيغما

110
00:07:56,740 --> 00:07:59,450
.ستكون غير قابلة للتّنبّؤ بالكامل

111
00:08:00,500 --> 00:08:02,460
.أتساءل بشأن ذلك

112
00:08:03,620 --> 00:08:07,460
،إذا تحدّثنا بشكل منطقيّ

113
00:08:07,460 --> 00:08:10,670
فأيّ شكل من أشكال الشّيفرات
.الّتي صنعها الإنسان يمكن أن تُفكّ

114
00:08:10,670 --> 00:08:14,180
.نحتاج فقط إلى تلميح صغير

115
00:08:14,470 --> 00:08:15,840
مثل ماذا؟

116
00:08:16,220 --> 00:08:18,510
،لنقل وبشكل نظريّ

117
00:08:18,510 --> 00:08:22,310
.أنّ لدينا رسالة نعرف محتواها مسبقًا

118
00:08:22,640 --> 00:08:27,020
،إذا كان لدينا نسخة لنفس الرّسالة مشفّرة بآلة إنيغما

119
00:08:27,020 --> 00:08:31,190
فستؤدّي بنا مقارنتهما إلى منحنا
.مفتاحًا لفكّ الشّيفرة

120
00:08:31,400 --> 00:08:32,820
.هكذا إذًا

121
00:08:33,360 --> 00:08:35,860
.أنت رجل ذكيّ بالفعل

122
00:08:35,860 --> 00:08:37,910
ما المضحك في الأمر؟

123
00:08:38,330 --> 00:08:39,490
.أنا أعتذر

124
00:08:39,490 --> 00:08:40,990
،فكما تعلم

125
00:08:41,410 --> 00:08:43,790
تقوم البحريّة اليابانيّة بتطوير آلات تشفير

126
00:08:43,790 --> 00:08:46,630
.مبنية على نفس التّكنولوجيا الّتي بُنيت بها إنيغما

127
00:08:48,170 --> 00:08:54,380
لا نستطيع أن نسمح لشخص مثلك أن يتسلّل
.إلى بلادنا متظاهرًا أنّه أمريكيّ

128
00:08:54,720 --> 00:08:56,800
ما-ماذا تقول؟

129
00:08:57,090 --> 00:08:58,800
.لا داعي للتّظاهر

130
00:08:58,800 --> 00:09:00,720
.أيّها السّيّد لويس ماكلاود

131
00:09:01,260 --> 00:09:02,220
...أو بالأحرى

132
00:09:02,850 --> 00:09:05,850
سأناديك باسمك الرّمزيّ
،في وكالة استخبارات بلادك

133
00:09:05,850 --> 00:09:08,730
الأستاذ"؟"

134
00:09:13,570 --> 00:09:16,150
...إذًا أنت هو كيربيروس

135
00:09:27,420 --> 00:09:30,590
.لا يحتاج الفرد منّا إلى سكّين لقطع الشّريان الوريديّ

136
00:09:30,590 --> 00:09:32,050
.ستفي الأظافر الحادّة بالغرض

137
00:09:49,650 --> 00:09:50,730
كيف؟

138
00:09:51,440 --> 00:09:53,480
كيف عرفتَ من أكون؟

139
00:09:53,820 --> 00:09:56,700
،أجريتُ عمليّات تجميل كثيرة

140
00:09:56,990 --> 00:10:01,740
حتّى أعزّ أصدقائي وأفراد عائلتي
.ما كانوا ليتعرّفوا عليّ

141
00:10:01,740 --> 00:10:06,450
.حصلتُ فقط على معلومات عشوائيّة قليلة عنك

142
00:10:06,450 --> 00:10:12,040
ولكن عند جمع ما لديّ عنك، أصبحت
.بعض الصّفات المميّزة لك ظاهرة

143
00:10:12,250 --> 00:10:16,920
فعلى سبيل المثال، عدم قدرتك
.على تجاهل الكلمات المتقاطعة

144
00:10:18,510 --> 00:10:22,050
.بالطّبع، كانت دلائلي مصمّة لك أيضًا

145
00:10:22,550 --> 00:10:23,810
...إنيغما

146
00:10:24,890 --> 00:10:29,390
كانت الكلمات المتقاطعة
.هي الاختبار الّذي أكّد لك هويّتي

147
00:10:31,270 --> 00:10:35,940
بصراحة، عرفتُ أنّك ضالتي
.منذ أن وقعت عليك عيناي

148
00:10:36,190 --> 00:10:39,400
تُطابِق العديد من صفات وجهك
.الصّورة الّتي لديّ لك

149
00:10:39,990 --> 00:10:44,120
فكما هو حال البصمات، هنالك بعض
.الملامح الخاصّة تميّز كلّ فرد

150
00:10:44,580 --> 00:10:45,740
ملامح؟

151
00:10:46,410 --> 00:10:47,040
—هذا

152
00:10:47,040 --> 00:10:47,830
!سفينة

153
00:10:47,830 --> 00:10:49,540
!هنالك سفينة تقترب

154
00:10:51,710 --> 00:10:53,250
أهي البحريّة اليابانيّة؟

155
00:10:53,250 --> 00:10:56,420
...لا، إنّها ليست يابانيّة

156
00:11:02,840 --> 00:11:04,600
!ماذا تكون؟

157
00:11:04,600 --> 00:11:05,430
...هذا

158
00:11:24,370 --> 00:11:28,330
!يا لحظّي، لا أصدّق أنّ البحريّة الملكيّة قد ظهرت هنا

159
00:11:29,290 --> 00:11:32,460
."هذا هو ما تعنيه عبارة "لا يمكن التّنبّؤ به

160
00:11:33,120 --> 00:11:35,670
.حسنًا، لم أشعر بالملل بفضلك أنت

161
00:11:35,960 --> 00:11:38,340
.حتّى أنّي حصلتُ على فرصة حلّ كلمات متقاطعة

162
00:11:40,550 --> 00:11:42,590
.أوتسومي، إنّها لحظة الوداع

163
00:11:43,930 --> 00:11:45,140
.نخبك

164
00:12:01,320 --> 00:12:02,400
...إذًا

165
00:12:02,400 --> 00:12:05,030
...أنت هو... كيربـ

166
00:12:25,590 --> 00:12:27,100
.لويس ماكلاود

167
00:12:27,550 --> 00:12:29,720
،خلال الحرب الأخيرة في أوروبّا

168
00:12:30,010 --> 00:12:32,060
عيّنته المخابرات السّرّيّة البريطانيّة

169
00:12:32,350 --> 00:12:34,810
.وعمِل على فكّ شيفرة الاتّصالات الألمانيّة

170
00:12:36,190 --> 00:12:37,730
لقد غيّر شكل وجهه الآن

171
00:12:37,730 --> 00:12:40,940
وينوي السّفر عبر المحيط الهادي
.من الولايات المتّحدة إلى اليابان

172
00:12:42,320 --> 00:12:44,280
.لا تسمح له أن يخطو خطوة على اليابان

173
00:12:49,990 --> 00:12:51,620
..."خطّة البستنة"

174
00:13:01,090 --> 00:13:02,300
.أوتسومي-ساما

175
00:13:03,050 --> 00:13:05,680
هل لديك أيّ معرفة

176
00:13:05,680 --> 00:13:09,550
بشأن الرّاكب المتوفّى السّيّد مورغان عدا اسمه؟

177
00:13:09,550 --> 00:13:11,890
.أخشى أنّي قابلتُه على السّفينة للتّوّ

178
00:13:11,890 --> 00:13:13,850
لا يوجد شيء غريب بشأن ذلك، صحيح؟

179
00:13:14,230 --> 00:13:15,890
هل يعرفون سبب الوفاة؟

180
00:13:17,060 --> 00:13:19,560
...كتب طبيب السّفينة في تقرير التّشريح

181
00:13:19,860 --> 00:13:21,070
...سبب الوفاة"

182
00:13:21,610 --> 00:13:24,150
".تسمّم بالسّيانيد

183
00:13:24,150 --> 00:13:25,990
!مات مسمومًا؟

184
00:13:25,990 --> 00:13:28,160
.لا، لم يتمّ الجزم بالأمر بعد

185
00:13:29,660 --> 00:13:30,580
...إذًا

186
00:13:30,870 --> 00:13:31,990
...أنت

187
00:13:32,740 --> 00:13:34,160
...كيربـ

188
00:13:38,420 --> 00:13:42,300
إذًا فقد كان ماكلاود، أحد الأعضاء المهمّين
،في فريق فكّ شيفرة إنيغما

189
00:13:43,050 --> 00:13:47,050
مستهدفًا من طرف شخص ما
،اسمه الرّمزيّ هو كيربيروس

190
00:13:47,300 --> 00:13:48,890
.اسم كلب الإله هايديس

191
00:13:51,010 --> 00:13:53,430
.أنا أعارض هذا بصفتي قبطان هذه السّفينة

192
00:13:53,430 --> 00:13:55,520
.أنتم تخرقون قوانين دوليّة

193
00:13:55,520 --> 00:13:57,890
!أطالب بتقديم تفسير لهذا الأمر

194
00:13:57,890 --> 00:14:00,520
،تمّ إعلامنا أنّ رجلاً إنجليزيًّا يُدعى جيفري مورغان

195
00:14:00,520 --> 00:14:03,730
.محجوز على سفينة بلا جنسيّة

196
00:14:03,730 --> 00:14:04,860
!رجل إنجليزيّ؟

197
00:14:05,570 --> 00:14:08,740
،لقد تشاورنا مع السّلطات الأمريكيّة

198
00:14:09,160 --> 00:14:12,080
ونقوم بالتّحرّي في أمر السّفن المثيرة
.للشّبهات الّتي لم يُعلن عنها

199
00:14:12,330 --> 00:14:16,080
لن تكون هنالك أيّ مشاكل بمجرّد
.أن نتأكّد من سلامته ويعود إلينا

200
00:14:16,080 --> 00:14:18,250
والآن، أين هو؟

201
00:14:20,000 --> 00:14:20,920
...إنّه

202
00:14:21,500 --> 00:14:22,540
ماذا؟

203
00:14:23,130 --> 00:14:25,420
.إن رفضتم تسليمه لنا، فلا بأس بذلك أيضًا

204
00:14:25,420 --> 00:14:28,170
هل أنت بخير يا سيّدة غراين؟

205
00:14:26,130 --> 00:14:27,720
.سنفتّش السّفينة بأنفسنا فحسب

206
00:14:28,170 --> 00:14:29,880
.نعم، والفضل لك

207
00:14:28,170 --> 00:14:30,180
!هذا سخيف! هذه سفينة مسافرين يابانيّة

208
00:14:30,340 --> 00:14:31,340
.سرّني سماع هذا

209
00:14:46,610 --> 00:14:47,860
ماذا؟

210
00:14:48,360 --> 00:14:49,700
!ميت؟

211
00:14:50,780 --> 00:14:52,660
—هذا مستحيل، ما الّذي

212
00:14:53,870 --> 00:14:55,370
!تعال يا فراتي

213
00:14:55,830 --> 00:14:56,700
!تعال إليّ

214
00:14:57,160 --> 00:14:59,040
!أوتسومي-ساما، ما الّذي تفعله؟

215
00:15:07,550 --> 00:15:09,800
،يمكنني أن أشرح كلّ شيء

216
00:15:10,090 --> 00:15:11,970
.بدءًا من موت السّيّد مورغان

217
00:15:12,300 --> 00:15:15,640
ولكن هل لي ببعض الوقت رجاءً؟

218
00:15:16,930 --> 00:15:18,310
هل لديك أيّ مانع؟

219
00:15:18,930 --> 00:15:22,400
.لا بأس ما دامت الإجابة سترضيني

220
00:15:33,030 --> 00:15:35,330
أنت هي كيربيروس، صحيح؟

221
00:15:39,000 --> 00:15:42,710
.فراتي هذا لا يختلف كثيراً عن كلب حراسة الإله هايديس

222
00:15:43,250 --> 00:15:45,840
أيمكنك شرح هذه؟

223
00:15:51,010 --> 00:15:53,180
كيف عرفتِ أنّه هو؟

224
00:15:54,050 --> 00:15:55,930
.عرفتُه في اللّحظة الّتي وقعت عينيّ عليه

225
00:15:56,180 --> 00:16:00,480
.أحدّق بشدّة في تلك الصّورة كلّ يوم

226
00:16:01,680 --> 00:16:04,600
.سمعتُ أنّ ماكلاود قام بعملية تجميل لوجهه

227
00:16:05,310 --> 00:16:08,650
لكن مهما كانت العمليّات الّتي خضع
،لها وجهه فلن تتغيّر أذناه

228
00:16:08,650 --> 00:16:10,530
.لذلك ركّزت عليها أكثر

229
00:16:11,400 --> 00:16:14,110
،أصيبت إمّا بالدّوار بعد أن صعدنا السّفينة

230
00:16:14,110 --> 00:16:15,740
،وعدما شعرت بتحسّن

231
00:16:15,740 --> 00:16:19,160
.بدأت أبحث عن الأذنين اللّتين في الصّورة

232
00:16:19,950 --> 00:16:21,160
،لكن في تلك اللّحظة

233
00:16:22,460 --> 00:16:25,000
،وعند عثوري على ماكلاود أخيرًا

234
00:16:25,000 --> 00:16:28,800
.رأيتُ فراتي قرب قدميه فذُعرت

235
00:16:29,340 --> 00:16:32,760
!لأنّ تلك الصّورة كانت مخبّأة في طوقه

236
00:16:33,010 --> 00:16:34,720
!لا! توقّف

237
00:16:35,010 --> 00:16:35,970
!مكانك

238
00:16:38,300 --> 00:16:41,720
.لهذا السّبب صرختِ عليه

239
00:16:41,720 --> 00:16:45,480
لكنّك حقّقتِ هدفكِ مسبقًا، صحيح؟

240
00:16:45,980 --> 00:16:48,520
،إن رميتِ تلك الصّورة في المحيط

241
00:16:48,520 --> 00:16:51,110
.لن يكون هنالك أيّ دليل مادّيّ يدينك

242
00:16:55,150 --> 00:16:59,580
.هذه الصّورة الوحيدة الّتي تُظهر مدى وسامة رايموند

243
00:17:01,120 --> 00:17:03,910
لا أستطيع رميها، مهما كانت بشاعة

244
00:17:03,910 --> 00:17:05,830
.القاتل الّذي يقف إلى جانبه

245
00:17:06,420 --> 00:17:09,790
.لقد كان زوجي، والد ابنتي

246
00:17:10,380 --> 00:17:14,470
.وهذا الرّجل كان جاسوسًا في الاستخبارات البريطانيّة

247
00:17:14,760 --> 00:17:17,340
،لقد سلبني زوجي

248
00:17:17,340 --> 00:17:19,720
.سلب منّا والد ابنتي

249
00:17:20,720 --> 00:17:24,430
.وها قد قتلتُه وانتقمتُ لزوجي

250
00:17:25,180 --> 00:17:26,560
.لستُ نادمة على أيّ شيء

251
00:17:28,400 --> 00:17:34,740
قبل سنة، أغرقت سفينة تجاريّة مسلّحة
.تابعة لألمانيا سفينة شحن إنجليزيّة

252
00:17:34,740 --> 00:17:38,530
كان نائب القبطان على تلك
.السّفينة هو رايموند غراين

253
00:17:46,160 --> 00:17:48,420
.تشجّعي يا سينثيا

254
00:17:48,420 --> 00:17:50,500
.أعلم. أنا بخير

255
00:17:50,500 --> 00:17:54,710
.لقد أدّى رايمون واجبه كبحّار إنجليزيّ

256
00:17:55,050 --> 00:17:56,380
.كان من خيرة الرّجال

257
00:17:57,300 --> 00:17:58,130
...شكرًا لك

258
00:17:59,340 --> 00:18:00,180
إمّا؟

259
00:18:01,430 --> 00:18:02,890
.المعذرة

260
00:18:07,140 --> 00:18:08,270
إمّا؟

261
00:18:08,270 --> 00:18:10,270
أين ذهبتِ يا إمّا؟

262
00:18:20,570 --> 00:18:21,570
...إمّا

263
00:18:28,580 --> 00:18:29,790
!هذا قاسٍ للغاية

264
00:18:29,790 --> 00:18:31,130
.مهلاً، صوتك مرتفع جدًّا

265
00:18:32,670 --> 00:18:34,590
.لن أقبل باستراتيجيّات كهذه

266
00:18:34,590 --> 00:18:37,170
...إنّ استعمال سفنٍ مدنيّة كطُعم

267
00:18:38,130 --> 00:18:42,300
استعملتَ عميلاً مزدوجًا لتسرّب
!تلك المعلومة عن قصد

268
00:18:43,510 --> 00:18:45,720
...وعرفتَ ما سيحدث

269
00:18:45,970 --> 00:18:50,520
عرفتَ أنّ الألمان سيقضون على السّفينة
!لتدمير كلّ الأدلّة

270
00:18:50,520 --> 00:18:52,940
،إن لم نستطع فكّ شيفرة إنيغما

271
00:18:52,940 --> 00:18:54,690
.لن تفوز إنجلترا بهذه الحرب أبدًا

272
00:18:55,190 --> 00:18:57,990
وهذه الخطّة الّتي أتيتُ بها

273
00:18:57,990 --> 00:19:01,160
.ستضمن لنا أن نحطّم إنيغما المنيعة

274
00:19:01,700 --> 00:19:04,080
.سوف أزرع البذرة وأحصدها بنفسي

275
00:19:04,490 --> 00:19:05,700
...أنا أسمّيها

276
00:19:07,080 --> 00:19:08,410
..."البستنة"

277
00:19:09,080 --> 00:19:13,580
.كان ذلك هو... اسم خطّة ماكلاود

278
00:19:16,090 --> 00:19:19,760
استعملت البحريّة الألمانيّة إنيغما لتشفير

279
00:19:19,760 --> 00:19:22,340
محتويات الأوامر المسروقة
.وأرسلت تيليغرافًا إلى قوّات صديقة

280
00:19:22,340 --> 00:19:24,220
،اعترض الإنجليز الإرسال

281
00:19:24,220 --> 00:19:26,760
وقارنوا الخطط الاستراتيجيّة الّتي فيه

282
00:19:26,760 --> 00:19:29,060
مع الملفّ المشفّر باستعمال إنيغما

283
00:19:29,390 --> 00:19:31,190
.للعثور على دليل لفكّ الشّيفرة

284
00:19:32,650 --> 00:19:37,610
،ولكن، بما أنّه نفّذ الخطّة بمفرده

285
00:19:38,150 --> 00:19:41,860
كنّت الاستخبارات البريطانية الكراهية
.لمكلاود وتبرّأوا منه

286
00:19:42,410 --> 00:19:44,820
لا بدّ أنّه غيّر وجهه وغادر إلى اليابان

287
00:19:44,820 --> 00:19:47,700
.للعثور على مكان جديد له

288
00:19:48,240 --> 00:19:49,370
...أنت

289
00:19:50,370 --> 00:19:51,330
من تكون؟

290
00:19:52,460 --> 00:19:56,090
تعيش حياةً يحيط بها الغموض أيضًا، صحيح؟

291
00:19:58,090 --> 00:19:59,090
...أصبحتُ

292
00:19:59,630 --> 00:20:02,340
.جاسوسة ألمانيّة بغرض تحقيق انتقامي

293
00:20:03,380 --> 00:20:05,050
.أنا جاهزة لتحمّل العواقب

294
00:20:06,260 --> 00:20:08,970
،لكن عندما أنظر إلى وجهها

295
00:20:08,970 --> 00:20:10,520
.أفقد عزيمتي

296
00:20:10,770 --> 00:20:12,810
ما الّذي عشتُ من أجله؟

297
00:20:14,150 --> 00:20:16,520
وما الذي عليّ أن أعيش من أجله؟

298
00:20:19,980 --> 00:20:20,990
ماما؟

299
00:20:20,990 --> 00:20:22,530
ما الخطب؟

300
00:20:26,160 --> 00:20:29,450
إمّا، أتريدين رؤية الدّلافين ثانية؟

301
00:20:32,580 --> 00:20:33,370
!نعم

302
00:20:50,770 --> 00:20:52,180
!تعال يا فراتي

303
00:21:02,360 --> 00:21:04,900
.وداعًا يا إمّا

304
00:21:19,130 --> 00:21:21,880
هل خلدت الدّلافين للنّوم؟

305
00:21:22,340 --> 00:21:23,970
.سوف نراها غدًا

306
00:21:23,970 --> 00:21:26,260
!نعم، سنراها مع ماما

307
00:21:27,130 --> 00:21:29,550
.لا تقلق، ستراها معنا أيضًا

308
00:21:33,980 --> 00:21:36,390
نحن الاثنان وكلب؟

309
00:21:37,940 --> 00:21:40,650
.حسنًا... سنتدبّر الأمر بطريقة ما

310
00:23:23,290 --> 00:23:25,840
حركة صعبة، صحيح؟

311
00:23:26,500 --> 00:23:28,460
.الشّطرنج عبارة عن رياضة

312
00:23:28,710 --> 00:23:30,670
.بل ورياضة عنيفة أيضًا

313
00:23:33,010 --> 00:23:34,930
أتريد أن تلعب؟