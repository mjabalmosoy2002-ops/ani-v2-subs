1
00:00:01,560 --> 00:00:03,140
!شيراهاتا كييْتشيرو

2
00:00:03,480 --> 00:00:06,900
إنّه ديبلوماسيّ كان يعمل مع السّفارة
.البريطانيّة في الماضي

3
00:00:07,150 --> 00:00:11,690
إنّنا نشكّ أنّ شيراهاتا قد أمسى على علم
.بمحتويات "الخطّة الكبرى" للقيادة العليا

4
00:00:12,360 --> 00:00:14,570
."ينبئني حدسي أنّه "أسود

5
00:00:15,320 --> 00:00:18,740
".اقتلوا دون تردّد. موتوا بشرف"

6
00:00:19,200 --> 00:00:22,580
."أصبحتَ الآن عضوًا رسميًّا في "وكالة الرّيح

7
00:00:23,540 --> 00:00:25,330
".لا يمكننا استعمال خرّيجين من الكلّيّة الحربيّة"

8
00:00:25,620 --> 00:00:28,290
."هذه كلمات يوكي، مؤسّس "الوكالة دي

9
00:00:29,090 --> 00:00:30,630
...يوكي

10
00:00:34,090 --> 00:00:37,760
.بلغني أنّك تمكّنت من الرّبط بين شيراهاتا وغراهام

11
00:00:38,140 --> 00:00:40,470
أتستطيع اكتشاف مكان التّبادل؟

12
00:00:40,760 --> 00:00:45,230
.نعم. لقد سبق ووضعتُ عميلاً داخل منزل شيراهاتا

13
00:00:46,560 --> 00:00:49,230
،بمجرّد أن تُنهي هذه العمليّة بنجاح

14
00:00:49,230 --> 00:00:50,980
فإنّ "وكالة الرّيح" الّتي أسّستَها

15
00:00:50,980 --> 00:00:54,860
سيتمّ الاعتراف بها كوكالة التّجسّس
.الرّسميّة التّابعة للجيش الإمبراطوريّ

16
00:00:58,450 --> 00:01:01,790
.تمّ إعلام "الوكالة دي" بوضع شيراهاتا أيضًا

17
00:01:03,200 --> 00:01:05,710
.لا نيّة لي بالمشاركة في لعبة جوكر مضاعف

18
00:01:06,330 --> 00:01:09,130
.سيتمّ اعتبار الوكالة الّتي ستفشل وكالة إضافيّة

19
00:01:17,380 --> 00:01:19,660
.ستقرّر هذه المهمّة كلّ شيء

20
00:01:20,510 --> 00:01:23,680
"سوف تقرّر ما إذا كانت تستطيع "وكالة الرّيح

21
00:01:23,680 --> 00:01:25,700
...أن تتغلّب على "الوكالة دي" أم لا

22
00:01:27,110 --> 00:01:28,410
...من سينجو في النّهاية

23
00:01:30,030 --> 00:01:31,270
!هم نحن

24
00:01:33,610 --> 00:01:38,030
بينما الدّخّان يتصاعد من جمرِ
،حربٍ عالميّة في خريف عام 1937

25
00:01:38,360 --> 00:01:43,200
أنشأ الجيش الإمبراطوريّ
.وكالة تدريب جواسيس سرّيّة

26
00:01:44,240 --> 00:01:48,000
يتمّ التّعامل مع ماضي وأسماء

27
00:01:48,250 --> 00:01:50,630
وحتّى أعمار نخبة الرّجال الّذين استطاعوا

28
00:01:50,630 --> 00:01:53,880
تجاوز عمليّة الاختيار القاسية
.والصّعبة بشكل بالغ السّرّيّة

29
00:01:55,090 --> 00:01:58,300
لقد أكملوا بسهولة تمارينَ تدريبٍ دفعتهم

30
00:01:58,300 --> 00:02:00,180
.ليصلوا إلى حدود قوّتهم الجسديّة والذّهنيّة

31
00:02:00,510 --> 00:02:03,600
،وتحت قيادة مؤسّس الوكالة المقدّم يوكي

32
00:02:03,890 --> 00:02:06,350
.فإنّهم يعملون في الخفاء في جميع أنحاء العالم

33
00:02:06,850 --> 00:02:10,650
.وهكذا، تمّ إنشاء وكالة استخبارات جديدة تمامًا

34
00:02:11,230 --> 00:02:13,860
."اسمها هو "الوكالة دي

35
00:03:44,450 --> 00:03:48,910
...عبرنا في الماضي قمّة الجبل ونحن نركب مِحفّة

36
00:03:49,490 --> 00:03:54,370
وتجدني الآن مستلقيًا مستغرقًا
...في أحلامي، أركب قطارات بخاريّة

37
00:03:52,330 --> 00:03:54,460
.خذي هذه إلى غرفة خشب البولفينية

38
00:03:54,370 --> 00:03:58,460
،أمسى النّفق حالك السّواد بسبب الدّخان

39
00:03:54,710 --> 00:03:55,580
.حاضرة

40
00:03:58,460 --> 00:04:01,260
...يا إلهي، أمسى حالك السّواد

41
00:04:05,720 --> 00:04:06,640
!ماذا؟

42
00:04:07,680 --> 00:04:10,600
غرفتكم هي الغرفة المجاورة
.في نهاية الممرّ يا سيّدي

43
00:04:10,600 --> 00:04:13,560
.حسنٌ... أنا جدّ آسف على المقاطعة

44
00:04:13,980 --> 00:04:16,520
.لا، لا، لا تقلق بشأن هذا

45
00:04:17,060 --> 00:04:23,530
هذا الأنمي عمل من نسج الخيال. أيّ تشابه في الشّخصيّات والمنظّمات والأماكن
.والأسماء وما إلى ذلك، الّتي تمّ ذكرها، لا علاقة لها بأحداث واقعيّة

46
00:04:22,070 --> 00:04:23,650
من كان ذلك؟

47
00:04:23,650 --> 00:04:26,200
.إنّه الرّجل الّذي في الغرفة المجاورة هناك

48
00:04:26,200 --> 00:04:29,280
سبق وذكر أنّه يعمل مع شركة في طوكيو
.وقد أتى هنا من أجل تدريبٍ ما

49
00:04:31,200 --> 00:04:33,000
على أيّ حال، ما رأيك؟

50
00:04:33,290 --> 00:04:34,000
رأيي في ماذا؟

51
00:04:34,000 --> 00:04:36,290
.لا زلت يافعًا كما ترين

52
00:04:36,290 --> 00:04:38,880
!على رسلك. كفّ عن هذا

53
00:04:57,770 --> 00:04:59,900
...ثمّ قلتُ

54
00:05:00,730 --> 00:05:01,730
فعلاً؟

55
00:05:01,730 --> 00:05:05,400
.هاكسلي-سان يرتاح في المنزل

56
00:05:06,070 --> 00:05:08,990
.تمّ إعلامي أنّ زهور الإيكيبانا قد وصلت

57
00:05:15,710 --> 00:05:16,920
أترغب بالمزيد؟

58
00:05:19,840 --> 00:05:20,880
.شكرًا. شكرًا

59
00:05:24,090 --> 00:05:27,220
.لقد غادر الزّبون للتّوّ

60
00:05:27,220 --> 00:05:27,970
.نعم

61
00:05:27,970 --> 00:05:29,640
.تسري الأمور على أكمل وجه حتّى الآن

62
00:05:30,720 --> 00:05:33,310
.المعذرة. أعتذر على مقاطعة وجبتكم

63
00:05:33,600 --> 00:05:36,100
.هنالك شخص آخر من مجموعتكم قد وصل

64
00:05:36,600 --> 00:05:37,770
...قال

65
00:05:38,190 --> 00:05:40,770
...أنّكم تعرفون من يكون دون أن يقول اسمه

66
00:05:41,320 --> 00:05:44,190
...وأنّه هنا لرؤية المدير

67
00:05:44,690 --> 00:05:45,780
.أدخليه

68
00:06:00,630 --> 00:06:02,420
.يمكنكِ أن تذهبي وترتاحي الآن

69
00:06:03,050 --> 00:06:05,420
.عليك أن تستيقظي في الصّباح الباكر

70
00:06:05,420 --> 00:06:07,170
.تحت أمرك يا سيّدي

71
00:06:07,170 --> 00:06:10,800
صحيح، هل اتّصلتِ بتشيرتشيل؟

72
00:06:10,800 --> 00:06:13,850
...نعم. بعد مغادرة موريشيما-سان بلحظات

73
00:06:13,850 --> 00:06:18,890
حسنًا، لا بدّ أنّه ذهب إلى النُّزل
.لرؤية تلك النّاذلة ثانية

74
00:06:18,890 --> 00:06:21,900
.أنا أحسدهما على علاقتهما الوطيدة

75
00:06:22,440 --> 00:06:24,020
.تصبح على خير

76
00:07:03,900 --> 00:07:05,770
ا-المعذرة... أين أنا؟

77
00:07:06,190 --> 00:07:08,190
ما الّذي تريده منّي؟

78
00:07:09,530 --> 00:07:11,240
.موريشيما كونيو

79
00:07:11,700 --> 00:07:15,530
تلميذ يعيش في منزل شيراهاتا منذ
.سنة ويعمل كخادم في المنزل

80
00:07:15,530 --> 00:07:18,200
.وُلدتَ في طوكيو سنة 1918

81
00:07:18,660 --> 00:07:20,410
.اسمك السّابق هو إيكيدا كونيو

82
00:07:21,870 --> 00:07:25,130
بعد زواج عائلة موريشيما، دفعا لطبيب في الجيش

83
00:07:25,130 --> 00:07:28,090
.وتمّ إرسالك للمنزل في الحال بعد فحصك الجسديّ

84
00:07:28,710 --> 00:07:31,550
.عقوبة التّلاعب وتزوير تقارير طبّيّة تصل إلى ثلاث سنوات

85
00:07:31,970 --> 00:07:32,550
...كلاّ

86
00:07:32,800 --> 00:07:35,430
،إن تمّ اختيارك وأُرسلتَ للجبهات الأماميّة

87
00:07:35,430 --> 00:07:37,010
.فمن المحتمل ألاّ تعيش أكثر من بضعة أشهر

88
00:07:37,430 --> 00:07:40,180
!أ-أرجوك! غضّ النّظر عن هذا

89
00:07:40,520 --> 00:07:42,730
!كلّ هذا من صنيع والدَيّ

90
00:07:45,810 --> 00:07:49,530
.إنّنا نشكّ أنّ شيراهاتا جاسوس

91
00:07:50,610 --> 00:07:51,650
أتفهم قصدي؟

92
00:07:52,030 --> 00:07:56,030
.هذه فرصتك لتثبت ولاءك لليابان

93
00:07:58,240 --> 00:08:01,330
والآن، هل حدث أيّ شيء غريب في المنزل؟

94
00:08:01,620 --> 00:08:03,620
،إنّه يترك الكلب يبيت في الخارج في الحديقة عادةً

95
00:08:04,080 --> 00:08:06,630
.لكنّه أراد اللّيلة أن يوضع في الكوخ

96
00:08:07,090 --> 00:08:10,800
.كما قال أيضًا أنّه ما من داعٍ لإعداد الفطور في الغد

97
00:08:12,590 --> 00:08:14,470
والمسألة الّتي ناقشناها؟

98
00:08:15,640 --> 00:08:17,300
.في مكتب حجرة الدّراسة

99
00:08:17,600 --> 00:08:18,930
!فهمت

100
00:08:21,220 --> 00:08:23,940
.قمتَ بعمل ممتاز

101
00:08:24,390 --> 00:08:26,810
...إذًا... هل ذلك الموضوع

102
00:08:27,310 --> 00:08:29,360
هل ستقوم بغضّ النّظر عنّي؟

103
00:08:29,610 --> 00:08:30,820
!بالطّبع

104
00:08:30,820 --> 00:08:33,990
.لقد ساعدتنا أكثر ممّا توقّعنا

105
00:08:33,990 --> 00:08:35,110
.أنا أشكرك

106
00:08:38,240 --> 00:08:39,160
.العفو

107
00:08:44,210 --> 00:08:45,710
.أنت هناك، اسمع

108
00:08:46,250 --> 00:08:48,250
.اتّصل بسيّارة لتوصله للمنزل

109
00:08:48,630 --> 00:08:49,540
.سأوصله أنا

110
00:08:49,960 --> 00:08:51,250
!لا داعي لتتعب نفسك

111
00:08:51,250 --> 00:08:52,670
.أستطيع الذّهاب للمنزل بمفردي

112
00:08:53,130 --> 00:08:54,720
.لا تقل هذا

113
00:08:55,050 --> 00:08:57,430
،لن أراك كثيرًا بعد هذا

114
00:08:57,430 --> 00:09:00,310
.وربّما أصبحوا قلقين عليك في المنزل

115
00:09:17,610 --> 00:09:19,700
.أحضروا لي كأس ساكي جديدًا

116
00:09:35,090 --> 00:09:36,800
".اقتلوا دون تردّد"

117
00:09:37,590 --> 00:09:39,180
".موتوا بشرف"

118
00:09:41,560 --> 00:09:43,180
ما-ماذا؟

119
00:09:44,100 --> 00:09:45,140
هل أنت بخير؟

120
00:09:45,390 --> 00:09:47,810
...نعم... أشعر ببعض الدّوار فقط

121
00:09:48,230 --> 00:09:49,900
.أنا لا أشرب في العادة

122
00:09:50,190 --> 00:09:51,860
هل من خطب ما؟

123
00:09:51,860 --> 00:09:53,570
.لا، لا

124
00:09:53,570 --> 00:09:55,860
.لقد شرب الكثير فحسب، هذا كلّ شيء

125
00:09:56,190 --> 00:09:57,950
.حسنًا، لنذهب

126
00:10:04,370 --> 00:10:05,950
.اسمعوا يا رجال

127
00:10:06,330 --> 00:10:08,790
.رحلتنا التّدريبيّة تنتهي اليوم

128
00:10:09,170 --> 00:10:10,790
.أبليتم حسنًا جميعًا

129
00:10:11,540 --> 00:10:13,460
،بقيت لنا مهمّة واحدة أخيرة

130
00:10:14,050 --> 00:10:15,550
.وبعدها سنكون قد انتهينا

131
00:10:16,300 --> 00:10:18,630
.أتوقّع أن يُؤتي تدريبك أكله

132
00:10:19,590 --> 00:10:22,930
.سيحدث التّبادل في الثّالثة فجرًا كما خطّطنا

133
00:10:23,720 --> 00:10:26,350
.سوف ننطلق في حال سبيلنا إذًا

134
00:10:26,350 --> 00:10:29,940
.احرصوا على عدم إزعاج هاكسلي-سان

135
00:10:32,360 --> 00:10:33,440
...يوكي

136
00:10:33,980 --> 00:10:36,740
.آمُل أن تأتي بنفسك إن أمكنك ذلك

137
00:10:37,650 --> 00:10:39,110
...وعندما ستأتي

138
00:11:40,630 --> 00:11:41,720
.ها هو زبوننا

139
00:11:41,720 --> 00:11:42,340
.حاضر

140
00:11:42,970 --> 00:11:43,890
ما الوضع؟

141
00:11:44,300 --> 00:11:45,180
.نحن جاهزون

142
00:11:47,640 --> 00:11:48,600
...يوكي

143
00:11:48,890 --> 00:11:51,770
لم يستطع اكتشاف المكان إذًا؟

144
00:11:52,060 --> 00:11:53,190
.أبله

145
00:11:56,690 --> 00:11:57,360
.هيّا

146
00:11:57,360 --> 00:11:57,980
.حاضر

147
00:12:27,100 --> 00:12:29,760
.سننتظر هنا حتّى الثّالثة فجرًا

148
00:12:29,760 --> 00:12:30,520
.حاضر

149
00:12:31,470 --> 00:12:33,390
.اعتقلوا كلّ من يظهر

150
00:12:33,690 --> 00:12:36,190
.واقتلوه إن أبدى أيّ مقاومة

151
00:12:50,120 --> 00:12:51,620
ما الّذي...؟

152
00:12:52,330 --> 00:12:53,750
لماذا لا يوجد أحد هنا؟

153
00:13:03,470 --> 00:13:04,380
.لقد تأخّرت

154
00:13:13,140 --> 00:13:14,770
!يوكي

155
00:13:19,110 --> 00:13:21,110
أيّها الوغد، كيف...؟

156
00:13:21,110 --> 00:13:22,440
كيف؟

157
00:13:23,400 --> 00:13:25,650
.أتيتُ بالسّيّارة ودخلتُ من الباب الأماميّ

158
00:13:26,570 --> 00:13:28,700
!لقد حذّرتَ غراهام وشيراهاتا

159
00:13:29,030 --> 00:13:31,870
...لا تقل لي أنّ "الخطّة الكبرى" قد

160
00:13:32,240 --> 00:13:33,950
الخطّة الكبرى"؟"

161
00:13:34,330 --> 00:13:38,290
.لم يكن هنالك شيء كهذا هنا من الأساس

162
00:13:40,040 --> 00:13:42,380
،لكن بعد قراءتي لها

163
00:13:42,880 --> 00:13:45,340
.لم تكن إلاّ هراءً سخيفًا

164
00:13:45,720 --> 00:13:47,260
هراء سخيف؟

165
00:13:48,510 --> 00:13:50,760
!إنّها أعظم أسرار الجيش الإمبراطوريّ

166
00:13:51,180 --> 00:13:55,020
!إنّها تحتوي أكثر استراتيجيّات القيادة العليا أهمّيّة

167
00:13:55,230 --> 00:13:56,680
،في النّهاية

168
00:13:57,270 --> 00:13:59,400
ما هي إلاّ نظريّات عامّة

169
00:13:59,400 --> 00:14:01,480
.ومبادئ متعلّقة بالتّنظيم القتاليّ والاستراتيجيّات

170
00:14:02,520 --> 00:14:05,320
ما فائدة التّعامل معها على أنّها وثائق أسطوريّة

171
00:14:05,610 --> 00:14:07,490
عن الفنون العسكريّة؟

172
00:14:08,610 --> 00:14:11,660
بعبارات أخرى، إنّها تظهر حدود

173
00:14:11,660 --> 00:14:13,160
.خرّيجي الكلّيّة الحربيّة

174
00:14:14,450 --> 00:14:17,410
...أنت مقدّم في الجيش أيضًا، ومع ذلك

175
00:14:32,050 --> 00:14:32,970
.يوكي

176
00:14:33,470 --> 00:14:37,850
أتعرف ما هو الفرق الأكبر
بين "الوكالة دي" و"وكالة الرّيح"؟

177
00:14:39,390 --> 00:14:43,060
".شعاركم هو "لا تموتوا. لا تقتلوا

178
00:14:43,060 --> 00:14:46,900
.لكنّنا نؤمن بالقتل إن دعت الضّرورة

179
00:14:47,740 --> 00:14:50,860
.صحيح أنّك قد سبقتنا بخطوة

180
00:14:51,820 --> 00:14:55,740
.لكنّ "الخطّة الكبرى" هنا بدون شكّ

181
00:14:56,910 --> 00:15:00,160
.وسنحصل عليها، حتّى إن عنى ذلك قتل شيراهاتا

182
00:15:01,120 --> 00:15:03,420
.هكذا تؤدّي "وكالة الرّيح" عملها

183
00:15:05,000 --> 00:15:07,550
.الفوز من نصيبي يا يوكي

184
00:15:20,020 --> 00:15:21,060
.يا إلهي

185
00:15:29,740 --> 00:15:30,900
...أيّها الوغد

186
00:15:32,410 --> 00:15:36,240
لقد ألقينا طُعمًا كبيرًا، وكلّ ما أمسكنا
.به هي أسماك صغيرة من أمثالكم

187
00:15:36,240 --> 00:15:38,750
!أيعقل أنّك... من "الوكالة دي"؟

188
00:15:39,040 --> 00:15:41,660
الماضي المزيّف والتّلاعب

189
00:15:41,660 --> 00:15:43,790
.كانت قصّة تضليل شبه خفيّة

190
00:15:44,040 --> 00:15:46,790
.إنّها أشبه بنظام تنبيه للأمان

191
00:15:47,170 --> 00:15:49,760
،إن حاولت وكالة تجسّس أخرى الوصول إلى شيراهاتا

192
00:15:50,170 --> 00:15:52,760
.فسيسعون خلف موريشيما بدون أدنى شكّ

193
00:15:53,050 --> 00:15:55,300
...لكنّك... كنتَ

194
00:15:55,640 --> 00:15:57,600
...خادم منزل شيراهاتا

195
00:15:57,600 --> 00:16:00,640
...لمدّة سنة كاملة

196
00:16:04,190 --> 00:16:05,310
...موريشيما

197
00:16:05,810 --> 00:16:07,900
مستحيل، كيف لك أن تقف على قدميك الآن؟

198
00:16:08,270 --> 00:16:09,980
.كانت لي نفس الأداة مثلك

199
00:16:09,980 --> 00:16:12,110
.استعملتها بشكل عكسيّ فحسب

200
00:16:18,200 --> 00:16:20,660
اعتقل كاميناغا وهاتانو

201
00:16:21,120 --> 00:16:24,170
.كلّ من كان مختبئًا حول المنزل

202
00:16:25,080 --> 00:16:27,460
إنّ غراهام الّذي تمّ إخباره بحركات
،الجيش بواسطة شيراهاتا

203
00:16:27,460 --> 00:16:29,840
،خشيَ أن يتمّ اعتقاله

204
00:16:30,210 --> 00:16:33,050
وغادر رفقة زوجته

205
00:16:33,050 --> 00:16:35,720
.ليستقلاّ سفينة في اتّجاه شانغهاي

206
00:16:35,970 --> 00:16:36,930
!ماذا؟

207
00:16:37,600 --> 00:16:38,850
لقد وضعنا أعيننا

208
00:16:39,310 --> 00:16:42,020
على شيراهاتا منذ مدّة

209
00:16:42,020 --> 00:16:44,190
.قبل حتّى أن تبدأ مجموعتكم تحرّكها

210
00:16:44,480 --> 00:16:45,440
...إنّه واحدٌ

211
00:16:45,940 --> 00:16:49,360
.من القنوات القليلة المتّصلة بإنجلترا المتبقّية لدينا

212
00:16:49,690 --> 00:16:51,780
،إن حافظنا عليه تحت مراقبة شديدة

213
00:16:52,110 --> 00:16:53,740
.فسنزال قادرين على الاستفادة منه

214
00:16:54,030 --> 00:16:57,950
.لا تحاول المساس بشيراهاتا بسبب أمر تافه كهذا

215
00:16:59,910 --> 00:17:01,950
،حتّى إن حاولتَ اعتقاله

216
00:17:01,950 --> 00:17:04,210
.فلا دليل لديك

217
00:17:06,290 --> 00:17:08,250
!لا دليل؟

218
00:17:10,290 --> 00:17:13,880
!هذا لأنّك تخلّصتَ منه بالكامل

219
00:17:14,590 --> 00:17:16,630
!يوكي

220
00:17:23,390 --> 00:17:26,980
.القتل هو أسوأ قرار قد يتّخذه جاسوس

221
00:17:27,690 --> 00:17:30,940
.كلّ ما قد يسبّبه هو جلب تحقيقات خارجيّة

222
00:17:30,940 --> 00:17:34,320
.إنّه تصرّف أحمق وبلا فائدة

223
00:17:34,690 --> 00:17:38,700
بعبارات أخرى، إنّه دليل على
.أنّك غير مؤهّل لتكون جاسوسًا

224
00:17:39,740 --> 00:17:41,740
.أسبابك لا تهمّ

225
00:17:42,240 --> 00:17:45,910
!هذا لا يغيّر حقيقة أنّك سرّبت خطّتنا لشيراهاتا

226
00:17:46,790 --> 00:17:49,130
!أتمنّى أن تكون جاهزًا لمحاكمة عسكريّة

227
00:17:49,130 --> 00:17:50,460
،لسوء الحظّ

228
00:17:50,750 --> 00:17:54,380
.لم نكن نحن من أخبر شيراهاتا

229
00:17:56,630 --> 00:18:01,300
هل تتذكّر النّادلة الّتي قامت
بخدمتكم في النُّزل اللّيلة؟

230
00:18:05,930 --> 00:18:07,940
كيف تعرف بشأنها؟

231
00:18:08,310 --> 00:18:11,150
هل كنتَ تقيم في نفس النُّزل معنا؟

232
00:18:11,150 --> 00:18:13,940
أولم تلاحظ؟

233
00:18:14,280 --> 00:18:15,940
.لقد سبق وتقابلنا هناك

234
00:18:27,040 --> 00:18:28,500
.المعذرة

235
00:18:29,000 --> 00:18:33,500
يبدو أنّ الزّبون الّذي يغادر الآن
.يشعر بدوار نوعًا ما

236
00:18:33,750 --> 00:18:38,170
نعم، إنّه طالب يجني قوت يومه بالعمل
.كخادم في منزل شيراهاتا-سان

237
00:18:38,670 --> 00:18:40,970
.يبدو أنّه غير معتاد على شرب الكحول

238
00:18:43,470 --> 00:18:44,970
...هذا مؤسف

239
00:18:45,470 --> 00:18:47,770
.تلك النّظرة الظّريفة الّتي علت وجهك

240
00:18:50,020 --> 00:18:55,650
لكن إن عاد إلى المنزل في تلك الحالة
.فقد يتمّ توبيخ ذلك المسكين

241
00:18:58,950 --> 00:19:02,950
.سـ-سأتّصل بمنزل شيراهاتا-سان

242
00:19:02,950 --> 00:19:05,540
.سأخبرهم أنّه أُجبر على شرب الكثير من السّاكي

243
00:19:05,830 --> 00:19:07,950
.حسنًا، فكرة جيّدة

244
00:19:12,670 --> 00:19:16,670
،اكتشف شيراهاتا الوضع من مكالمة النّادلة

245
00:19:16,670 --> 00:19:18,460
.ولاذ بالفرار مسرعًا

246
00:19:19,300 --> 00:19:20,590
.هذا كلّ شيء

247
00:19:24,050 --> 00:19:28,430
.إقحامي في محاكمة عسكريّة سيهينك أكثر لا غير

248
00:19:29,390 --> 00:19:31,230
.سأطلعك على أمر آخر أيضًا

249
00:19:31,640 --> 00:19:34,480
كلّ النّساء في ذلك النُّزل كنّ على علم تامّ

250
00:19:34,900 --> 00:19:37,280
.بهويّاتكم كرجال من الجيش

251
00:19:37,980 --> 00:19:39,190
!ماذا تقصد؟

252
00:19:39,860 --> 00:19:41,700
،إنّ نيران الحرب تستعر

253
00:19:42,200 --> 00:19:45,240
ويتمّ استدعاء الرّجال اليافعين
.باستمرار لساحات القتال

254
00:19:46,370 --> 00:19:50,580
كان هنالك تناقص كبير في مجموعات
.الرّجال اليافعين الّتي قد تقيم في نُزل

255
00:19:51,790 --> 00:19:53,500
،قد لا يثير الطّلبة شبوهات كثيرة

256
00:19:53,830 --> 00:19:58,800
على عكس مجموعة من سبعة
.أو ثمانية رجال أعمال يافعين

257
00:19:59,130 --> 00:20:00,670
.كان أيّ أحد ليلاحظ ذلك

258
00:20:03,800 --> 00:20:07,140
هل تعرف معنى شارة الكلّيّة الحربيّة؟

259
00:20:07,930 --> 00:20:10,220
،إنّه عملة حقبة إيدو

260
00:20:10,520 --> 00:20:11,890
.وهي تساوي ثمانية رين

261
00:20:12,480 --> 00:20:15,440
".إنّها كبيرة، ومع ذلك لا تساوي حتّى سين واحدًا"

262
00:20:15,440 --> 00:20:18,020
.يعني هذا في العالم الحقيقيّ، أنّها بلا قيمة

263
00:20:18,980 --> 00:20:20,570
،لكن لسبب ما

264
00:20:20,860 --> 00:20:25,030
فهي تحمل معنى معاكسًا لأولئك
.الّذين لهم علاقة بالجيش

265
00:20:25,320 --> 00:20:29,990
لهذا السّبب استطاعت حتّى نادلة متدنّية
.المستوى تعمل في نزل من اكتشافكم

266
00:20:31,450 --> 00:20:34,750
،إنّكم مجموعة تؤمن بشيء لا أساس له

267
00:20:35,080 --> 00:20:37,630
.وتعقدون أنّ بإمكانكم أن تكونوا جواسيسًا

268
00:23:19,960 --> 00:23:24,340
في الحلقة القادمة

269
00:23:21,210 --> 00:23:24,340
.غادرت بعثة إنجليزيّة إلى مصر

270
00:23:24,670 --> 00:23:28,630
عليك أن تكون جاهزًا للعواقب إن كنت
.ستذهب لاكتشاف القبور

271
00:23:30,130 --> 00:23:33,140
.ينتهي المطاف أحيانًا بصائد المومياوات كمومياء

272
00:23:32,510 --> 00:23:35,000
[الحلقة 10 [مطاردة