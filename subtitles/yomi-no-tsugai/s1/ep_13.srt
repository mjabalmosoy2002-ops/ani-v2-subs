1
00:00:07,060 --> 00:00:11,810
فتى وفتاة توأمان وُلِدا في يوم
يتساوى فيه اللّيلُ والنّهار

2
00:00:11,810 --> 00:00:14,600
سيقودان التسوغاي يوماً ما

3
00:00:15,770 --> 00:00:17,770
هذه هي أسطورة القرية في الشّرق

4
00:00:18,770 --> 00:00:23,350
،عندما يُولَد توأمان يقسمان اللّيلَ والنّهار
سينهار العالم

5
00:00:25,590 --> 00:00:30,600
قبل أربعمئة عام، قسّمت حربٌ عظيمة
الدّولةَ إلى نصفين

6
00:00:31,140 --> 00:00:34,540
مُستخدِمو التسوغاي كانوا العقل
المُدبِّر خلف الكواليس

7
00:00:35,300 --> 00:00:39,550
احتفظَ سُكّانُ قرية هيغاشي بالتّوأمين
داخل القرية

8
00:00:39,550 --> 00:00:42,310
وذلك كي يتمكّنوا من استخدام قوّتهما
في نهاية المطاف

9
00:00:43,580 --> 00:00:47,210
،بعد أن أدركا بأنّ ولديهما في خطر

10
00:00:47,730 --> 00:00:50,920
حاولا الهرب مع التّوأمين

11
00:00:50,920 --> 00:00:54,980
،لكن لم يستطيعا أن يأخذا سوى آسا
الأخت الصُّغرى، معهما

12
00:00:56,170 --> 00:00:59,210
:يمتلك التّوأمان قدرةَ كسب قِوى خاصّة

13
00:00:59,910 --> 00:01:02,080
"كسر" و "ختم"

14
00:01:03,110 --> 00:01:09,400
،كسر، قوّة الكشف عن أيّ شيء قسريّاً
...ونظيرها

15
00:01:09,400 --> 00:01:14,120
ختم، قوّة إغلاق أيّ شيء قسريّاً

16
00:01:15,580 --> 00:01:19,690
،لم أختر أن أكون توأماً مُختاراً

17
00:01:20,350 --> 00:01:23,190
لكن الآن، أنا أسلك الطّريقَ الّذي اخترتُه

18
00:01:24,370 --> 00:01:26,320
سألطّخ يدَي هاتين

19
00:01:27,880 --> 00:01:30,480
،بعد كسب قوّة ختم في العالم الخارجيّ

20
00:01:30,480 --> 00:01:33,600
آسا هاجمَتِ القريةَ لاستعادة أخيها

21
00:01:34,030 --> 00:01:35,860
!ابتعدي

22
00:01:37,840 --> 00:01:43,020
وسط الفوضى، أُوقِظنا للمرّة الأُولى منذ 400 عام

23
00:01:43,650 --> 00:01:46,750
سيّدنا الجديد لا يُحبّ التدخُّل

24
00:01:47,420 --> 00:01:50,810
يورو، هذان هما التسوغاي الخاصّان بك

25
00:01:53,170 --> 00:01:56,950
آسا لاجئة لدى... عشيرة كاغيموري، صحيح؟

26
00:01:57,280 --> 00:02:02,040
انفصلتْ عشيرتُهم عن قرية هيغاشي
نتيجة خِلافات غير قابلة للتّسوية

27
00:02:02,370 --> 00:02:04,880
،بدلاً من التّعاون مع عشيرتهم

28
00:02:04,880 --> 00:02:08,290
اختارَ يورو البحث عن والديه بمُفرده

29
00:02:08,290 --> 00:02:10,710
لن أهرب أو أختبئ

30
00:02:10,710 --> 00:02:13,180
لا أملك سبباً للتخفّي

31
00:02:13,180 --> 00:02:16,680
لا أُبالي إن كنتم من قرية هيغاشي
أو عشيرة كاغيموري

32
00:02:16,680 --> 00:02:20,310
إن أردتُم رأسي، فتعالوا وخذوه

33
00:02:20,310 --> 00:02:24,810
ويبدو أنّ عشيرة كاغيموري ليست مُتوحِّدة

34
00:02:25,330 --> 00:02:28,680
مُتُّ في السّابق

35
00:02:29,150 --> 00:02:31,950
نحن أفضل حالاً من دون كسر أو ختم

36
00:02:32,530 --> 00:02:34,400
تغيّر الزّمن

37
00:02:34,400 --> 00:02:39,660
نحن نُشاركهم دمَهم. مسؤوليّتنا
تأمين الرّاحة لهم

38
00:02:39,980 --> 00:02:43,910
أجل. القرية الّتي تُنتج قوى كسر
وختم يمكنها الاستمرار في البقاء

39
00:02:44,280 --> 00:02:46,710
لا ينبغي أن ننكر وجودهم ذاته

40
00:02:47,160 --> 00:02:51,020
يبدو أنّ قِوى أُخرى معنيّة كذلك

41
00:02:51,650 --> 00:02:53,630
يجب أن نتوخّى الحذر

42
00:04:31,650 --> 00:04:34,660
أجل، تبعتُه إلى مُنتصف الطّريق

43
00:04:34,660 --> 00:04:36,350
لم ألحق به إلى مسافة بعيدة

44
00:04:37,010 --> 00:04:40,600
ينبغي أن يكون الشّامانيّ في قرية
هيغاشي الآن

45
00:04:40,600 --> 00:04:43,100
أحسنت صنعاً

46
00:04:43,440 --> 00:04:45,870
أريد فقط أن أعرف بأنّه في القرية

47
00:04:45,870 --> 00:04:47,740
انتظر هناك

48
00:04:48,330 --> 00:04:49,930
إيفان

49
00:04:49,930 --> 00:04:50,860
اذهب وزرهم

50
00:04:52,860 --> 00:04:54,640
حسناً

51
00:04:55,150 --> 00:04:56,570
هيّا بنا يا شوكيو

52
00:04:56,920 --> 00:05:00,740
ماذا؟ تقصد، "من فضلك تعال
"معي يا شوكيو-ساما

53
00:05:01,330 --> 00:05:04,650
ذكّرني، مَن منّا هو السّيّد؟

54
00:05:04,650 --> 00:05:06,130
لا تتكلّم معي بوقاحة

55
00:05:06,130 --> 00:05:08,090
سأُقطّعك أيُّها القرد

56
00:05:08,090 --> 00:05:11,470
دايكيو، قُل شيئاً

57
00:05:12,810 --> 00:05:14,620
لا تتصرّف وكأنّك لا تستطيع رؤيتي

58
00:05:15,110 --> 00:05:18,020
أنتما لا تستطيعان التحرُّك حتّى من دون سيّد

59
00:05:18,020 --> 00:05:20,220
لماذا أنتما مُتغطرسان جدّاً؟

60
00:05:20,220 --> 00:05:24,820
اصمت! لا يمكنك فعل شيء
من دوننا أيُّها القرد

61
00:05:24,820 --> 00:05:27,110
من تعتقد بأنّه يُطعمك باستمرار؟

62
00:05:27,110 --> 00:05:29,970
أنا أيُّها الكسولان

63
00:05:29,970 --> 00:05:31,640
!تبّاً لك أيُّها القرد

64
00:05:30,860 --> 00:05:33,110
!يا إلهي، أنتم مُزعجون! غادروا فحسب

65
00:05:33,110 --> 00:05:36,280
!أنا أدفع لك مالاً طائلاً! اذهب واعمل

66
00:05:36,280 --> 00:05:37,630
حسناً، حسناً

67
00:05:46,520 --> 00:05:48,210
هيّا بنا

68
00:05:50,370 --> 00:05:52,590
سأعود بعد فترة قصيرة

69
00:06:01,200 --> 00:06:03,390
هذا مُخيف

70
00:06:15,620 --> 00:06:17,530
كيف يبدو هذا؟

71
00:06:17,530 --> 00:06:18,810
أجل، هذا جيّد

72
00:06:18,810 --> 00:06:22,100
!ماذا؟ أنتما تصنعان أسلحة ثانية

73
00:06:22,100 --> 00:06:23,340
لم نكن مشغولين

74
00:06:23,770 --> 00:06:27,080
حسناً. إذاً سأوفّر لكم شيئاً تفعلونه

75
00:06:27,390 --> 00:06:29,140
ما هذا اللّوح؟

76
00:06:29,140 --> 00:06:30,620
تلفزيون

77
00:06:30,620 --> 00:06:31,840
أشعر بإشعاع

78
00:06:33,340 --> 00:06:35,570
بانعدام احتمال هطول أمطار بعد الظّهر...

79
00:06:36,690 --> 00:06:39,090
سنشهد يوماً جافّاً آخر

80
00:06:39,940 --> 00:06:43,820
هناك مخاوف من أن تشهد اليابان الغربيّة
نقصاً في المياه هذا الصّيف

81
00:06:44,400 --> 00:06:46,900
فقرتنا التّالية، تنبُّؤات الطّقس
على مُستوى البلد

82
00:06:46,900 --> 00:06:50,370
...سماوات صافية مُتوقَّعة في أوكيناوا

83
00:06:50,370 --> 00:06:55,230
،لا أستطيع زيارة موطِن أمّي
لكن ماذا عنك؟

84
00:06:55,230 --> 00:06:56,760
من، أنا؟

85
00:06:56,760 --> 00:06:59,970
أُمُّك من... إتشيغو، صحيح؟

86
00:07:00,530 --> 00:07:03,500
إثيوبيا. إنّه بلدٌ أجنبيّ

87
00:07:03,990 --> 00:07:06,010
ألا تريد السّفر إلى هناك؟

88
00:07:06,460 --> 00:07:10,860
إنّه بعيدٌ في الواقع

89
00:07:10,860 --> 00:07:14,420
لا يمكنك العودة إلى موطنك، صحيح؟

90
00:07:15,320 --> 00:07:20,310
العودة إلى قرية هيغاشي ليست آمنة

91
00:07:23,790 --> 00:07:26,510
لكن تركتُ الكثير خلفي

92
00:07:27,130 --> 00:07:29,350
ليتني أستطيع العودة

93
00:07:31,540 --> 00:07:35,820
ما-ما هذا؟

94
00:07:36,560 --> 00:07:37,830
سيّد شامان

95
00:07:38,980 --> 00:07:41,860
انتظر هنا. سأعود في الحال

96
00:07:41,860 --> 00:07:42,880
أيُّها القرد

97
00:07:43,340 --> 00:07:46,740
في برج القلعة. أشعر بتسوغاي

98
00:07:47,690 --> 00:07:49,640
برج القلعة؟

99
00:07:49,640 --> 00:07:53,250
يُقال بأنّ الأغبياء وشيء ما
يُحبّون الأماكن العالية

100
00:07:53,250 --> 00:07:54,980
إنّهم الأغبياء والقِرَدة

101
00:07:54,980 --> 00:07:57,030
الأغبياء والدُّخان أيُّها الأحمق

102
00:07:57,030 --> 00:07:58,800
!!من تنعته بالأحمق؟

103
00:08:08,820 --> 00:08:10,680
يبدو هذا شاقّاً

104
00:08:10,680 --> 00:08:12,280
ألم أقل لك؟

105
00:08:16,440 --> 00:08:17,830
أنا لا أعرفه

106
00:08:17,830 --> 00:08:18,570
أجل

107
00:08:21,760 --> 00:08:22,820
من أنت؟

108
00:08:23,840 --> 00:08:25,310
—كيف دخلت

109
00:08:25,310 --> 00:08:26,250
—أنت

110
00:08:29,310 --> 00:08:30,450
ليس هُما

111
00:08:35,290 --> 00:08:36,850
!كم هذا مُزعج

112
00:08:52,380 --> 00:08:53,820
ليس هو أيضاً

113
00:08:59,110 --> 00:09:02,310
لا. لا. لا

114
00:09:02,860 --> 00:09:04,300
ليس هو

115
00:09:04,760 --> 00:09:06,030
ليس هو أيضاً

116
00:09:15,630 --> 00:09:17,140
كان ذلك وشيكاً

117
00:09:19,460 --> 00:09:23,520
من أنت؟ هل أنت مع أولئك الآخرين؟

118
00:09:23,960 --> 00:09:26,440
كان الجميع مُتأهّبين

119
00:09:26,440 --> 00:09:29,890
كيف دخلت دون كسر الحاجز؟

120
00:09:43,770 --> 00:09:45,340
...هذا الوجه

121
00:09:45,700 --> 00:09:48,800
أنتِ التسوغاي الّذي كان مُرتبطاً بالسّجن

122
00:09:48,800 --> 00:09:50,550
أنتِ آسا المُزيّفة، أليس كذلك؟

123
00:09:51,700 --> 00:09:55,600
،وإذا أتيتِ لإنقاذ هذه المرأة

124
00:09:56,200 --> 00:09:58,620
فلا بُدّ أنّها سيّدتكِ

125
00:10:06,430 --> 00:10:09,890
أنتِ جريئة بالنّسبة لشخص أُسِرَ
سيّده كرهينة

126
00:10:10,900 --> 00:10:15,180
إذا كانت تسوغاي، فلا بُدّ أنّ نصفها
الآخر موجود في مكانٍ ما هنا

127
00:10:17,120 --> 00:10:19,320
أين هو؟ من أين سيأتي؟

128
00:10:20,340 --> 00:10:22,000
!أيُّها القِرد، قدماك

129
00:10:34,640 --> 00:10:37,340
ألا تعتقد بأنّ ذلك كان مُبالغاً به
قليلاً يا شوكيو؟

130
00:10:37,740 --> 00:10:41,090
ماذا؟ إنقاذ حياتك كلّفَ ساقاً فقط

131
00:10:41,090 --> 00:10:44,600
ينبغي أن تركع وتشكرني

132
00:10:44,600 --> 00:10:47,310
لا أستطيع بهذه السّاق

133
00:10:48,660 --> 00:10:50,970
،تُشبهين آسا

134
00:10:50,970 --> 00:10:54,350
لكن جعلتِ نفسكِ تبدين أصغر
بكثير من الحقيقيّة

135
00:10:55,600 --> 00:11:01,170
لا عجب في أنّ أخاها لم يستطع ترك
هذه الأخت الصّغيرة الظّريفة خلفه

136
00:11:01,170 --> 00:11:03,050
كم هذا مُثير للاشمئزاز

137
00:11:03,760 --> 00:11:06,770
لا أحد من أهل القرية يستطيع رؤية التسوغاي

138
00:11:06,770 --> 00:11:12,240
هل تكتنز كُلّ القِوى الخاصّة
كي يُقدّسها سكّانُ القرية؟

139
00:11:12,750 --> 00:11:16,530
سيّدتُكِ ليست بغيضة فحسب، بل مُقرفة

140
00:11:16,980 --> 00:11:21,860
حسناً إذاً... إذا قتلتُ سيّدتكِ، سوف
تُصبحين تسوغاي ضالّة

141
00:11:21,860 --> 00:11:26,760
وجهكِ هو ما أُريده، لذا لا جدوى
من عودتكِ إلى شكلكِ الأصليّ

142
00:11:27,150 --> 00:11:29,790
،يمكنكِ إبرام عقد معي

143
00:11:29,790 --> 00:11:32,630
،لكن ماغاتسوهي، أو بالأحرى

144
00:11:33,050 --> 00:11:37,200
شوكيو غير مُتوافق مع التسوغاي الآخرين

145
00:11:37,200 --> 00:11:40,890
في أسوأ الحالات، قد ينتهي المطاف به
بقتل آسا المُزيّفة

146
00:11:41,210 --> 00:11:42,700
سأقتلها

147
00:11:43,060 --> 00:11:45,030
كما سمعتِ

148
00:11:45,420 --> 00:11:50,280
إن لم تُحدِثي جلبة، فلن أقتل سيّدتكِ

149
00:11:50,850 --> 00:11:53,030
تعالي معي يا آسا المُزيّفة

150
00:11:54,400 --> 00:11:55,790
إلى العالم الخارجيّ؟

151
00:11:56,030 --> 00:11:58,200
الحياة مُمتعة هناك

152
00:12:13,010 --> 00:12:14,370
حسناً

153
00:12:15,330 --> 00:12:16,280
سأذهب

154
00:12:28,820 --> 00:12:32,990
النّصفُ الآخر لهذه التسوغاي
لن يكشف عن نفسه أبداً

155
00:12:33,480 --> 00:12:34,810
لِمَ لا؟

156
00:12:34,810 --> 00:12:36,410
هل يُخطّطون لشيء ما؟

157
00:12:36,830 --> 00:12:40,090
أحتاج رهينةً بشريّة كتأمين أيضاً

158
00:12:48,280 --> 00:12:50,420
أرى طفلة مُطيعة

159
00:12:53,180 --> 00:12:57,180
!أُمّي! أُمّي

160
00:12:56,420 --> 00:12:57,670
من جديد؟

161
00:12:57,670 --> 00:12:58,920
!كم هذا فظيع

162
00:12:59,470 --> 00:13:02,320
قد ينتهي أمر هذه القرية

163
00:13:02,770 --> 00:13:04,260
!لنهرب يا أُمّي

164
00:13:04,260 --> 00:13:05,320
!ذلك الرّجل خطير

165
00:13:05,310 --> 00:13:09,910
دانجي، قلتَ بأنّك أردت زيارة العالم
الخارجيّ رفقة يورو، صحيح؟

166
00:13:09,910 --> 00:13:11,820
ماذا؟ أجل

167
00:13:12,130 --> 00:13:15,570
انزل الجبل. لوحدك

168
00:13:15,570 --> 00:13:19,240
لوحدي؟ ماذا عنكِ يا أُمّي؟

169
00:13:19,240 --> 00:13:21,120
سأبقى في القرية

170
00:13:21,120 --> 00:13:26,490
تخيّل كم سيكون حزيناً إذا لم يتواجد
أحدٌ هنا للتّرحيب بعودته

171
00:13:26,490 --> 00:13:27,610
...لكن

172
00:13:28,090 --> 00:13:31,160
هناك اتّجاهات لنزول الجبل

173
00:13:31,690 --> 00:13:33,300
لا تتُه

174
00:13:36,800 --> 00:13:40,600
انزل الجبل وساعد يورو

175
00:13:40,600 --> 00:13:44,200
،إذا أردت ميني-سان وناغيسا-سان
بلّغهما تحيّاتي

176
00:13:50,680 --> 00:13:56,450
من ذلك الرّجل؟ ما مُشكلته؟

177
00:14:02,710 --> 00:14:06,090
قلتُ بأنّني سأعود وطلبتُ منك الانتظار

178
00:14:21,150 --> 00:14:23,380
اذهبا أنتما أوّلاً

179
00:14:36,000 --> 00:14:38,530
أهلاً بكما في العالم الخارجيّ

180
00:14:46,850 --> 00:14:50,620
حسناً، كان ذلك طريق عودتي

181
00:14:53,360 --> 00:14:56,470
،لا أعرف كيفيّة المُغادرة

182
00:14:56,830 --> 00:15:00,980
لذا ستدلّني كيف أنزل الجبل يا سيّد شامان

183
00:15:38,430 --> 00:15:41,160
هل أنا خارج القرية؟

184
00:15:42,000 --> 00:15:42,790
يورو

185
00:15:43,700 --> 00:15:47,720
...عليّ البحث عن يورو

186
00:15:55,310 --> 00:15:56,490
أتريد توصيلة؟

187
00:16:00,960 --> 00:16:03,840
أ-أتعرفين يمين ويسار؟

188
00:16:03,840 --> 00:16:07,080
أجل. كنّا أصدقاء قُدامى جدّاً

189
00:16:07,080 --> 00:16:11,130
قبل أيّام، هربا مع الفتى التّوأم

190
00:16:11,130 --> 00:16:13,080
توأم؟ لا بُدّ أنّه كان يورو

191
00:16:13,080 --> 00:16:15,960
قالوا بأنّه خطّط للاختباء في بلدة
تعجّ بالسّكّان

192
00:16:15,960 --> 00:16:17,570
ركبوا سيّارة

193
00:16:17,570 --> 00:16:18,720
سيّارة؟

194
00:16:22,570 --> 00:16:24,350
إحدى تلك المركبات

195
00:16:25,930 --> 00:16:30,740
.إذاً وصل يورو بأمان إلى أسفل الجبل
هذا جيّد

196
00:16:30,740 --> 00:16:33,700
لكن لا أعرف إلى أين ذهب

197
00:16:33,700 --> 00:16:39,010
حسناً، كانت لوحة أرقام المركبة
مُسجَّلة في العاصمة

198
00:16:39,570 --> 00:16:42,440
هل نزور العاصمة؟

199
00:16:42,440 --> 00:16:43,260
ماذا؟

200
00:16:43,960 --> 00:16:46,120
لم أذهب إلى العاصمة من قبل

201
00:16:46,120 --> 00:16:50,020
أُفضّل إخبار سيّدتي إذا كنتُ
سأذهب إلى مكانٍ ما

202
00:16:50,450 --> 00:16:52,770
هل تُمانع أن نمرّ بالمنزل؟

203
00:16:52,770 --> 00:16:54,620
...عـ-عفويّة جدّاً

204
00:16:58,310 --> 00:16:59,490
هكذا إذاً

205
00:16:59,830 --> 00:17:02,890
إذاً ستُقابلين بعض الأصدقاء
الّذين ابتعدوا

206
00:17:02,890 --> 00:17:06,990
هذا صحيح. سأذهب مع صديق سيّد صديقَي

207
00:17:07,530 --> 00:17:08,760
مرحباً

208
00:17:11,220 --> 00:17:16,200
يا له من فتى جذّاب. ابن مَن يكون؟

209
00:17:19,370 --> 00:17:21,450
احذري من السّيّارات

210
00:17:21,850 --> 00:17:24,400
لا تُخيفي العامّة

211
00:17:24,400 --> 00:17:26,390
حسناً. ألقاكِ لاحقاً

212
00:17:26,740 --> 00:17:29,330
استمتعا في المدينة أثناء وجودكِ فيها

213
00:17:29,330 --> 00:17:32,030
!حقّاً؟ مرحى

214
00:17:33,250 --> 00:17:36,550
حسناً، لنسلك الطّريق السّريع

215
00:17:36,550 --> 00:17:39,530
ماذا؟ الطّريق... السّريع...؟

216
00:17:44,380 --> 00:17:46,110
!مرحى

217
00:17:48,310 --> 00:17:50,300
أتريد المرور بالاستراحة؟

218
00:18:09,780 --> 00:18:12,390
أجل، أجل. ما الأمر؟

219
00:18:14,520 --> 00:18:18,220
ديرا-سان، لديّ عمل أقوم به

220
00:18:18,220 --> 00:18:20,670
حسناً. ألقاكِ لاحقاً

221
00:18:20,670 --> 00:18:22,890
الشّامانيّ قد قُتِل

222
00:18:31,910 --> 00:18:35,200
،عندما وصلنا إلى محلّه

223
00:18:35,860 --> 00:18:37,260
كان ميّتاً بالفعل

224
00:18:37,620 --> 00:18:39,670
إنّه ضخم

225
00:18:39,670 --> 00:18:42,120
لن يكون دفنه سهلاً

226
00:18:42,510 --> 00:18:44,900
سيُكلّفك مبلغاً إضافيّاً

227
00:18:44,900 --> 00:18:48,870
بالمُناسبة. ألم يكن لدى الشّامانيّ تسوغاي؟

228
00:18:48,870 --> 00:18:50,630
هل هُما ضالّان الآن؟

229
00:18:51,030 --> 00:18:54,520
تقصدين ليدي وجينتلمان

230
00:18:58,500 --> 00:19:01,640
قُطِعا إلى نصفين مع الشّامانيّ

231
00:19:01,640 --> 00:19:03,340
هذا فظيع

232
00:19:03,770 --> 00:19:06,160
لم يكونا مُقاتلين حتّى

233
00:19:07,180 --> 00:19:08,840
هل لديك أي أثر لهم؟

234
00:19:08,840 --> 00:19:10,200
سأدفنهم معاً

235
00:19:10,940 --> 00:19:12,610
هل سيُكلّف هذا المزيد؟

236
00:19:13,320 --> 00:19:15,450
سأفعلها مجّاناً

237
00:19:17,240 --> 00:19:20,460
...حسناً، قبل أن تدفنيهم

238
00:19:28,510 --> 00:19:30,000
،عزيزي يورو"

239
00:19:30,000 --> 00:19:33,450
بحوزتي أختك المُزيّفة وطفلة من القرية

240
00:19:33,450 --> 00:19:36,440
عند اكتمال القمر التّالي
،في ساعة الدُّبّ

241
00:19:36,440 --> 00:19:39,230
"تعال إلى مخزن فوجيموراياما

242
00:19:39,580 --> 00:19:41,360
هل كانت عشيرة كاغيموري؟

243
00:19:41,360 --> 00:19:42,690
لا نعلم

244
00:19:42,690 --> 00:19:46,680
،قبل مُغادرة الشّامان إلى القرية

245
00:19:46,680 --> 00:19:50,610
قال بأنّ تاديرا أخذَ يورو وهربا
إلى الأسفل هنا

246
00:19:50,610 --> 00:19:53,970
سمعنا بأنّ الكاغيموري أبرموا عقداً معه أيضاً

247
00:19:53,970 --> 00:19:56,750
هل تعرفين مكانيهما؟

248
00:19:57,050 --> 00:19:59,930
لا أملك أدنى فكرة

249
00:19:59,930 --> 00:20:05,300
في الواقع، تركتُ ديرا-سان ويورو-كن
بالقرب من مخبأ ديرا-سان

250
00:20:05,300 --> 00:20:08,370
لكن لا أعلم إلى أين ذهبا عقب ذلك

251
00:20:08,370 --> 00:20:10,800
إنّه سرّيّ للغاية

252
00:20:11,140 --> 00:20:15,560
هكذا إذاً. أجل، هذا صحيح

253
00:20:15,560 --> 00:20:20,020
،حتّى لو رأيتِ تاديرا أو يورو
لا تُخبريهما بهذه الرّسالة

254
00:20:20,020 --> 00:20:22,800
سنذهب نحن "قُطّاع الطّرُق" إلى القرية

255
00:20:23,030 --> 00:20:26,560
لا تدعي مَن فعلَ هذا يجد يورو

256
00:20:31,840 --> 00:20:33,480
هذا مُزعج

257
00:20:33,480 --> 00:20:36,180
أصبح هذا العمل شاقّاً فحسب

258
00:20:38,260 --> 00:20:41,210
!أوشيراساما! أوشيراساما

259
00:20:41,210 --> 00:20:45,420
!أنزليني أرجوكِ

260
00:20:49,070 --> 00:20:51,530
ألا تُحبّ المُرتفعات يا دانجي-كن؟

261
00:20:51,530 --> 00:20:54,360
!إنّها مُخيفة! العاصمة مُخيفة

262
00:20:54,360 --> 00:20:58,440
تمالك نفسك، اتّفقنا؟ أحاول
إيجاد يمين ويسار

263
00:21:00,120 --> 00:21:03,220
لديهما حضور كهذا

264
00:21:03,220 --> 00:21:06,100
ينبغي أن أتمكّن من الشُّعور بهما فوراً

265
00:21:08,330 --> 00:21:10,660
...هناك الكثير في الرّيف

266
00:21:12,830 --> 00:21:16,930
لكن العاصِمة تعجُّ بالتسوغاي أيضاً

267
00:21:36,790 --> 00:21:41,110
،حتّى لو رأيتِ تاديرا أو يورو
لا تُخبريهما بهذه الرّسالة

268
00:21:41,810 --> 00:21:44,430
حسناً، حسناً. لن أُخبرهما

269
00:21:44,430 --> 00:21:47,080
أفضّل العيش بسلام، شكراً جزيلاً لك

270
00:21:49,330 --> 00:21:53,650
يُقال بأنّ الإنسان الحكيم يبقى
بمنأى عن الخطر، صحيح؟

271
00:23:28,010 --> 00:23:29,780
من قتلَه؟

272
00:23:30,250 --> 00:23:32,210
هناك تسوغاي قريبون

273
00:23:32,210 --> 00:23:34,140
سنقضي عليهم هنا

274
00:23:34,140 --> 00:23:37,030
كانت هناك كلمات محفورة في جسد الشّامانيّ