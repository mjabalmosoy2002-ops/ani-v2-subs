1
00:01:31,440 --> 00:01:37,180
لو كنتُ أعلم بأنّ أعزّ صديق لي وأختي اللّذين
وثقتُ بهما لسنوات كانا مُنتحلين

2
00:01:37,940 --> 00:01:42,570
لما تمكّنتُ غالباً من مُغادرة غرفتي لمدّة شهر

3
00:01:42,920 --> 00:01:47,270
أليس كذلك؟ قد لا يثِق بنا بعد الآن أيضاً

4
00:01:47,270 --> 00:01:50,970
!لكن لا أريد أن تسوء الأمور بيننا

5
00:01:50,970 --> 00:01:54,590
أنا لا أُبالي حقّاً إذا كان لا يثِق بنا

6
00:01:54,880 --> 00:01:56,420
لا أحبّ الأطفال

7
00:01:56,420 --> 00:01:59,450
هل تكرهني هانا-سان أيضاً؟

8
00:02:01,170 --> 00:02:03,600
هيّا. لنأكل

9
00:02:05,720 --> 00:02:09,520
بالمُناسبة.  ينبغي لهذا أن يُغطّي
تكاليف طعام هذا الشّهر

10
00:02:09,520 --> 00:02:13,280
شكراً. أقبل وبكلّ تواضُع

11
00:02:13,280 --> 00:02:16,170
هل أنتِ متأكّدة بأنّني لستُ بحاجة
لتسديد الإيجار؟

12
00:02:16,170 --> 00:02:19,530
لا تقلق بشأن ذلك. هذا لوحده يُساهم بشكل كبير

13
00:02:19,530 --> 00:02:21,370
ماذا عن المدرسة؟

14
00:02:21,370 --> 00:02:24,500
أنت في الثّالثة عشر، صحيح؟ أي أنت
في المدرسة الإعداديّة؟

15
00:02:25,010 --> 00:02:27,370
ستحتاج للانتقال إلى مدرسة مُختلفة، أليس كذلك؟

16
00:02:27,370 --> 00:02:30,210
...صحيح

17
00:02:34,230 --> 00:02:35,970
لا تريد الذّهاب إلى المدرسة؟

18
00:02:40,490 --> 00:02:43,100
هلّا علّمتني كيفيّة استخدام سلاح؟

19
00:02:43,730 --> 00:02:46,670
أريد... أريد أن أصبح أقوى

20
00:02:50,700 --> 00:02:54,220
،حسناً، إن كنت لا تريد الذّهاب
فلست مُضطرّاً لذلك

21
00:02:54,600 --> 00:02:55,700
ماذا؟

22
00:02:55,700 --> 00:03:00,530
أنا متأكّدة بأنّ هناك طريقة لتتعلّم
دون الحضور إلى المدرسة

23
00:03:00,780 --> 00:03:04,660
كثير من النّاس في هذا المجال من العمل
يعرفون مثل هذه الثّغرات

24
00:03:04,660 --> 00:03:07,030
ماذا؟ هل أنتِ متأكّدة من سلامة ذلك؟

25
00:03:07,330 --> 00:03:12,280
جميع المُرتبطين بقرية هيغاشي
يعيشون خارج المُجتمع الطّبيعيّ

26
00:03:12,530 --> 00:03:15,460
هيّا. إذا أردت أن تُصبح أقوى، فكُل

27
00:03:15,790 --> 00:03:18,210
مُعظم المعارك تُكسَب بواسطة الرّجل الأضخم

28
00:03:20,480 --> 00:03:22,960
ابدأ بالأكل والتّضخيم

29
00:03:23,640 --> 00:03:24,880
شكراً على الطّعام

30
00:03:25,680 --> 00:03:30,440
في الحقيقة يا هانا-سان، تبدين صغيرة الحجم
مُقارنة بالكمّية الّتي تأكلينها

31
00:03:30,440 --> 00:03:35,140
حقّاً؟! أتمنّى أن أصبح ضخماً

32
00:03:40,740 --> 00:03:41,390
—أخي

33
00:03:41,390 --> 00:03:44,530
!من تُنادينه بـ"أخي"؟

34
00:03:45,370 --> 00:03:48,820
!أنا الوحيدة الّتي يمكنها مُناداته بذلك

35
00:03:50,010 --> 00:03:53,280
نحن آسفان. إنّها لا تعرف بماذا تُناديه غير ذلك

36
00:03:53,280 --> 00:03:55,140
سامحيها أرجوكِ يا آسا-تشان

37
00:03:56,990 --> 00:03:59,880
يسرّني أنّكِ بخير يا شريكتي

38
00:03:59,880 --> 00:04:04,140
كنتُ قلقاً جدّاً عندما شعرتُ
بوجودكِ هنا في الأسفل

39
00:04:05,230 --> 00:04:07,550
آسفة على إثارة قلقك

40
00:04:12,620 --> 00:04:18,400
لطالما قالوا بأنّك بقيت هناك لحماية القرية

41
00:04:18,920 --> 00:04:22,640
افترضتُ بأنّ ذلك كان طبيعيّاً ويصبّ
في مصلحة القرية

42
00:04:23,190 --> 00:04:27,060
ظننتُ فحسب بأنّه هكذا كانت تسير
الأمور ولم تُساورني شكوك إطلاقاً

43
00:04:27,060 --> 00:04:31,830
،أنا آسف. بالتّفكير في الأمر الآن
لا يبدو هذا منطقيّاً

44
00:04:32,070 --> 00:04:36,140
من يحبس طفلة ظريفة في زنزانة مُظلِمة؟

45
00:04:36,140 --> 00:04:41,110
!أخي! إنّها ظريفةٌ بالطّبع! فهي تُقلّدني

46
00:04:41,110 --> 00:04:43,310
لا أعلم ما إن كان هنا بيت القصيد

47
00:04:43,310 --> 00:04:48,420
!لحظة، أجل! تعتقد بأنّني ظريفة
!قُلْها ثانية

48
00:04:48,420 --> 00:04:50,580
!اصمتي! ولن أقول شيئاً

49
00:04:50,580 --> 00:04:54,410
يمكنك أن تُعانقني إذا شعرتَ بأنّني ظريفة

50
00:04:54,410 --> 00:04:57,280
أنتِ مُزعجة للغاية

51
00:04:58,480 --> 00:05:01,530
—أنا آسفة يا أخي، لأنّني كذبت

52
00:05:01,530 --> 00:05:03,620
أخي؟

53
00:05:02,730 --> 00:05:05,030
أنا آسفة، أنا آسفة، أنا آسفة

54
00:05:05,030 --> 00:05:08,460
بماذا ينبغي أن أناديكِ؟

55
00:05:08,460 --> 00:05:10,460
يكفي أن تقولي يورو

56
00:05:12,230 --> 00:05:18,240
أنا آسفة لادّعائي بأنّني آسا-تشان وذلك
لا تتمكّن من مُغادرة القرية يا يورو

57
00:05:18,850 --> 00:05:22,970
كنتُ أعلم أنّه من الخطأ الاستمرار في فعل ذلك

58
00:05:23,720 --> 00:05:26,230
لكن كنتَ لطيفاً جدّاً معي

59
00:05:26,670 --> 00:05:28,780
كنتَ تأتي كُلّ يوم لرؤيتي

60
00:05:29,570 --> 00:05:33,560
استمتعتُ بمُحادثاتنا القصيرة السّخيفة

61
00:05:36,760 --> 00:05:39,640
،في مكانٍ ما في قلبي

62
00:05:40,290 --> 00:05:45,290
تمنّيتُ أن تدوم العلاقةُ بيننا للأبد

63
00:05:46,300 --> 00:05:51,740
أنا آسفة. أنا آسفة. أنا آسفة

64
00:05:55,990 --> 00:05:58,540
ليس عليكِ انتحال شخصيّتها بعد الآن، صحيح؟

65
00:05:59,780 --> 00:06:01,670
عودي إلى هيئتكِ الحقيقيّة

66
00:06:14,410 --> 00:06:15,540
...ظريفة

67
00:06:16,510 --> 00:06:18,020
أنتِ ضئيلة

68
00:06:18,330 --> 00:06:20,430
ما اسمكِ الحقيقيّ؟

69
00:06:20,430 --> 00:06:21,730
اسمي الحقيقيّ؟

70
00:06:21,730 --> 00:06:24,020
كيوكا-سان منحتكِ اسماً، صحيح؟

71
00:06:25,190 --> 00:06:26,260
كيري

72
00:06:27,520 --> 00:06:31,800
سُمّيتُ تيمُّناً بالزّهور الجميلة الّتي
تتفتّح في جبل قرية هيغاشي

73
00:06:32,710 --> 00:06:35,500
هكذا إذاً. إنّه اسم جميل

74
00:06:36,070 --> 00:06:38,650
اسمي يعني فتى صحّياً ورجوليّاً

75
00:06:39,430 --> 00:06:42,070
دانجي، اسم واضح وصريح

76
00:06:42,070 --> 00:06:43,100
شريكتي

77
00:06:43,100 --> 00:06:44,050
أجل

78
00:06:44,050 --> 00:06:48,050
سنخبركما بحقيقتنا

79
00:06:49,210 --> 00:06:54,790
منذ زمن بعيد، كانت قرية هيغاشي معقلاً
،يُحيط به عدد من القِلاع الأصغر حجماً

80
00:06:54,790 --> 00:06:57,440
ولكلّ قلعة قريتها الخاصّة

81
00:06:58,410 --> 00:07:04,000
كنّا زاشيكي-واراشي اللّذين يتلقّيان
احترام وتقدير إحدى تلك القُرى

82
00:07:04,380 --> 00:07:09,620
تغيّر سيّدُنا بضع مرّات، لكن كانوا
جميعهم لُطفاء وبُسطاء

83
00:07:10,280 --> 00:07:13,690
أحببنا تلك القرية

84
00:07:14,680 --> 00:07:17,800
يُقال بأنّ تسوغاي يُدعيان يمين
ويسار يقطنان في المعقل

85
00:07:17,800 --> 00:07:20,310
حقّاً؟ أتمنّى لقاءهما

86
00:07:22,040 --> 00:07:24,210
ستبدأ حربٌ عاتية

87
00:07:24,210 --> 00:07:27,130
حاكم قرية هيغاشي ذاهب لخوض الحرب

88
00:07:27,130 --> 00:07:28,780
من يُقاتل؟

89
00:07:28,780 --> 00:07:33,780
يردينا أن نُرسل عدداً من المُحاربين الصّغار الأقوياء

90
00:07:34,210 --> 00:07:39,230
سمِعنا أوّل مرّة عن الحرب قبل 400 عام

91
00:07:39,230 --> 00:07:41,100
!ابتهجا

92
00:07:41,100 --> 00:07:44,220
!سأذهب إلى الحرب مع الحاكم

93
00:07:44,680 --> 00:07:47,980
سأبلي حسناً وذلك كي أتمكّن من العودة
!بحمولة من المُكافآت

94
00:07:47,980 --> 00:07:49,890
!خذنا معك

95
00:07:49,890 --> 00:07:51,130
!سنُساعدك

96
00:07:51,130 --> 00:07:55,370
أشكركما على هذا العرض، لكن ساحة
المعركة خطيرة. لا يمكنكما المجيء

97
00:07:55,370 --> 00:07:56,360
ماذا؟

98
00:07:56,360 --> 00:07:58,240
لكن نريد الذّهاب معك

99
00:07:58,820 --> 00:08:03,170
إذا أصابني مكروه، فستُصبحان شاردين

100
00:08:03,170 --> 00:08:06,740
أريد فسخ عقدنا حاليّاً وذلك كي تتمكّنا
من العودة إلى آثار

101
00:08:07,190 --> 00:08:10,310
سنُجدّد عقدنا حالما أعود

102
00:08:10,780 --> 00:08:13,510
هل ستُصبحان التسوغاي الخاصّين بي ثانية؟

103
00:08:13,510 --> 00:08:15,080
!بالطّبع

104
00:08:15,080 --> 00:08:17,850
!نتطلّع بلهفة لسماع قصصك

105
00:08:19,960 --> 00:08:26,780
لذا عدنا إلى آثار وانتظرنا عودة سيّدنا

106
00:08:28,570 --> 00:08:33,080
في نهاية المطاف، علِمنا من خلال الإشاعات
كيف كانت نتيجة الحرب

107
00:08:35,060 --> 00:08:36,710
كان الشّرق قد انتصر

108
00:08:37,160 --> 00:08:43,090
،إذا كان الشّرق قد انتصر قبل 400 عام
فهل هذا يعني أنّها معركة سيكيغاهارا؟

109
00:08:43,930 --> 00:08:45,710
سيكيغاهارا؟

110
00:08:45,710 --> 00:08:47,840
أهذا ما تُطلقون عليها هنا في الأسفل؟

111
00:08:47,840 --> 00:08:51,760
أجل. كانت معركة حاسِمة وقعتْ
قبل 400 سنة

112
00:08:51,760 --> 00:08:53,470
ماذا؟ لم أكن أعلم

113
00:08:53,470 --> 00:08:58,090
بعد ذلك، حكمَتْ شوغونيّة توكوغاوا
لأكثر من 200 عام

114
00:08:58,090 --> 00:09:01,780
شاركَ حاكمُ قرية هيغاشي في تلك الحرب، صحيح؟

115
00:09:01,780 --> 00:09:07,780
إذا ساعدَ الطّرفَ الرّابح، فينبغي أن تكون
الحرب جزءاً أكبر من تاريخ القرية

116
00:09:08,200 --> 00:09:10,180
لم نسمع أيّ شيء عنها

117
00:09:10,180 --> 00:09:13,860
أجل، ولا حتّى تلقّيه لأيّ أراضٍ

118
00:09:14,680 --> 00:09:17,120
رُبّما لم يُنجز الكثير

119
00:09:18,110 --> 00:09:23,400
أو رُبّما ارتكب أخطاء فادحة ولم يستطع
إخبار أهل القرية

120
00:09:23,750 --> 00:09:28,130
لا بُدّ أنّ سيّدكما السّابق يعرف شيئاً
إذا كان قد ذهب إلى الحرب

121
00:09:28,650 --> 00:09:30,130
ألم يُخبركما بشيء؟

122
00:09:32,570 --> 00:09:35,880
لم يعُد سيّدنا أبداً

123
00:09:37,030 --> 00:09:41,030
...آمنّا بأنّه سيُجدّد عقدنا عندما يعود وانتظرنا

124
00:09:42,020 --> 00:09:46,570
لسنوات وسنوات وسنوات

125
00:09:47,510 --> 00:09:51,650
مع الوقت، أخذت الأصوات الّتي نسمعها تتناقص

126
00:09:52,450 --> 00:09:54,680
تمّ نسياننا

127
00:09:56,170 --> 00:10:00,100
هُجِرت القرية. والجميع قد رحل

128
00:10:00,890 --> 00:10:05,340
،ارتأينا بأنّنا سنذبل

129
00:10:05,340 --> 00:10:09,640
إذا لم نبرم عقداً مع أحد ثانية

130
00:10:10,660 --> 00:10:14,410
ها أنتما هنا. كانت الأسطورة صحيحة

131
00:10:14,850 --> 00:10:17,770
لا بُدّ أنّكما كنتُما تشعران بوحشة. لنذهب

132
00:10:18,990 --> 00:10:21,930
عثرَ علينا أحدٌ بتعقُّب

133
00:10:21,930 --> 00:10:26,290
أسطورة قديمة حولنا

134
00:10:26,990 --> 00:10:30,470
كان خادم قرية هيغاشي يُدعى روي

135
00:10:31,090 --> 00:10:33,770
!روي؟ هذا التّاديرا السّابق

136
00:10:33,770 --> 00:10:36,400
أجل، والد ديرا-سان

137
00:10:36,400 --> 00:10:37,540
والد ديرا-سان؟

138
00:10:38,120 --> 00:10:41,450
أخذَنا روي-سان إلى قرية هيغاشي

139
00:10:42,300 --> 00:10:47,370
هناك أبرمنا عقداً مع أمّنا وسيّدتنا، كيوكا

140
00:10:47,860 --> 00:10:52,750
كانت قد فقدتْ زوجَها وطفليها
بسبب انهيار أرضيّ

141
00:10:52,750 --> 00:10:55,220
وكانت مُكتئبة جدّاً لا تقوى على النّهوض
عن السّرير

142
00:10:55,500 --> 00:10:59,860
أراد روي-سان غالباً ملء الفجوة في قلبها

143
00:10:59,860 --> 00:11:04,460
جمعنا معاً وجعلَنا نبرم عقداً

144
00:11:15,280 --> 00:11:17,030
هل أنتِ سيّدتنا الجديدة؟

145
00:11:17,030 --> 00:11:19,360
!امنحينا اسماً جديداً

146
00:11:21,600 --> 00:11:25,900
هل هذان الصّغيران هما ما يطلقون
عليهم بالتسوغاي؟

147
00:11:25,900 --> 00:11:26,870
أجل

148
00:11:26,870 --> 00:11:29,240
...سمعتُ أساطيرَ عنهم، لكن

149
00:11:30,020 --> 00:11:31,580
لنلعب. ماذا تريدين أن تفعلي؟

150
00:11:31,580 --> 00:11:34,000
سنبقى معكِ للأبد

151
00:11:34,580 --> 00:11:35,940
يا سيّدتي

152
00:11:41,300 --> 00:11:42,530
شكراً لكما

153
00:11:43,080 --> 00:11:46,880
بدتْ حزينة وسعيدة في نفس الوقت

154
00:11:47,610 --> 00:11:50,350
ماذا؟ هذان تسوغاي

155
00:11:50,350 --> 00:11:54,610
زاشي-يواراشي؟ كم أنتِ محظوظة

156
00:11:54,610 --> 00:11:58,350
كيوكا، تعالي إلى برج القلعة حالما
تشعرين بتحسُّن

157
00:11:58,350 --> 00:12:01,360
تعالي واعملي لصالحي

158
00:12:01,840 --> 00:12:05,660
استطاعت تلك المرأة العجوز رؤيتنا؟

159
00:12:05,660 --> 00:12:07,650
هل هي مُستخدمة تسوغاي؟

160
00:12:08,530 --> 00:12:10,850
لا يستطيع العاديّون رؤيتهم؟

161
00:12:10,850 --> 00:12:12,440
،مُستخدمو التسوغاي فقط

162
00:12:12,440 --> 00:12:18,380
والأشخاص الّذين يختار التسوغاي إظهار نفسه
لهم، وبعض الأفراد المُتأقلمين على ذلك

163
00:12:18,380 --> 00:12:21,890
،لديّ تسوغاي في العالم الخارجيّ
لذا أستطيع رؤيتهما

164
00:12:22,250 --> 00:12:24,380
من كانت تلك المرأة العجوز؟

165
00:12:24,380 --> 00:12:27,630
الجدّة ياماها. إنّها زعيمتنا

166
00:12:29,190 --> 00:12:31,900
إنّها الشّخص الأكبر سنّاً في القرية

167
00:12:31,900 --> 00:12:35,500
حتّى هي لا تتذكّر كم عمرها

168
00:12:46,390 --> 00:12:48,990
دخلت ناغيسا-سان القرية بينما كانت هائمة

169
00:12:49,480 --> 00:12:53,670
بعد بفترة قصيرة من بدء أمّي بالعمل
في برج القلعة

170
00:12:58,930 --> 00:13:03,200
شعرنا بأنّ ملابسها بدت غريبة

171
00:13:03,200 --> 00:13:06,070
لا بُدّ أنّها كانت ملابس عصريّة من الأسفل هنا

172
00:13:08,290 --> 00:13:12,450
شعرتْ ناغيسا بالاكتئاب عندما عَلِمَتْ
بأنّها لا تستطيع المُغادرة

173
00:13:13,880 --> 00:13:18,010
شعرَ ميني-سان بالشّفقة عليها وأراد مُساعدتها

174
00:13:18,860 --> 00:13:20,120
ناغيسا-سان

175
00:13:21,830 --> 00:13:24,020
أتريدين يخنة خنزير برّيّ؟

176
00:13:26,100 --> 00:13:29,560
هذا مُقرف

177
00:13:29,560 --> 00:13:31,360
ماذا قلتِ؟

178
00:13:33,790 --> 00:13:36,340
لا شيء. شكراً لك

179
00:13:36,340 --> 00:13:38,170
أشعر بتحسُّن قليلاً

180
00:13:48,880 --> 00:13:52,030
...ثمّ وُلِد يورو وآسا-تشان

181
00:13:53,260 --> 00:13:56,770
وتغيّرت أنظار سكّان القرية

182
00:13:57,300 --> 00:14:01,860
بما أنّنا غُرباء، فنحن لا نعرف
تاريخ قرية هيغاشي القديم

183
00:14:02,370 --> 00:14:06,160
كُلّ ما نعرفه هو الأسطورة عن توأمَي
الكسر والختم

184
00:14:09,840 --> 00:14:13,680
دائماً ما يفقد النّاس صوابهم متى
وُجِدَتْ قوّة عظيمة

185
00:14:14,290 --> 00:14:20,280
،بدا وكأنّ أمّي لديها كلام في جُعبتها
لكنّها لم تتطرّق للتّفاصيل

186
00:14:25,270 --> 00:14:26,510
ختم

187
00:14:27,060 --> 00:14:28,560
وكسر

188
00:14:28,560 --> 00:14:30,210
...في أيّ لحظة الآن، قُطّاع الطّرق

189
00:14:30,210 --> 00:14:31,360
يستغرقون وقتاً طويلاً

190
00:14:31,360 --> 00:14:34,720
متى ستفرض قريةُ هيغاشي سيادتها أخيراً؟

191
00:14:34,720 --> 00:14:38,450
أمّي، عمّاذا تتحدّثون؟

192
00:14:38,450 --> 00:14:41,370
لا شيء يا أزامي، عودي إلى النّوم

193
00:14:46,980 --> 00:14:48,000
!يورو

194
00:14:48,660 --> 00:14:51,690
هل أنت ذاهب للصّيد؟ سأذهب معك

195
00:14:51,690 --> 00:14:53,910
من جديد؟ لا تُحاول اللّحاق بي

196
00:14:54,250 --> 00:14:57,040
من الخطير دخول الجبال وحيداً

197
00:14:57,040 --> 00:14:59,460
أنت لا تُريد العمل في الحقول فحسب

198
00:14:59,460 --> 00:15:00,640
كشفتَني

199
00:15:01,680 --> 00:15:04,240
تعرف بالفعل ما حدث تالياً

200
00:15:04,240 --> 00:15:09,260
الجدّة ياماها أمرتْ أمّي بجعل كيري تحبس آسا

201
00:15:10,060 --> 00:15:15,620
أخبرَتْني سرّاً أيضاً بمُراقبة يورو
دون علم الجدّة

202
00:15:18,750 --> 00:15:21,840
دانجي وكيري، هل يمكنكما المُغادرة أوّلاً

203
00:15:21,840 --> 00:15:24,130
أريد التكلُّم مع آسا على انفراد

204
00:15:24,130 --> 00:15:25,610
!نحن فقط؟

205
00:15:26,410 --> 00:15:29,110
!مُحادثة خاصّة مع أخي

206
00:15:29,110 --> 00:15:31,650
أخرجيهما فحسب

207
00:15:31,650 --> 00:15:36,120
ين-يانغ، أخرِجا زاشيكي-واراشي

208
00:15:36,120 --> 00:15:37,530
...يورو، المعذرة

209
00:15:37,530 --> 00:15:42,920
،آسا-تشان هاجمَتِ القريةَ في ذلك اليوم
لكنّها لم تقتل أيّ قرويّ

210
00:15:43,550 --> 00:15:46,050
،جُرِحَتْ أمّي بواسطة بعض الأنقاض

211
00:15:46,050 --> 00:15:49,260
لكن آسا-تشان لم تقتل أحداً من القرية

212
00:15:52,960 --> 00:15:55,170
لن أتظاهر بأنّني شخصٌ طيّب

213
00:15:55,810 --> 00:15:59,430
عدم قتلي أحداً في ذلك اليوم هو محض صدفة

214
00:16:00,100 --> 00:16:05,160
لا أرحم أيّ شخص يحاول قتل أولئك
الأعزّاء على قلبي

215
00:16:07,200 --> 00:16:12,620
لم تكذبي عليّ منذ لُمّ شملنا

216
00:16:13,170 --> 00:16:17,720
كنتِ صادقة حتّى بشأن الأشياء الّتي
كان من الصّعب قولها

217
00:16:18,420 --> 00:16:20,260
أنا آسفة يا أخي

218
00:16:20,870 --> 00:16:26,090
آسا المثاليّة والصّغيرة والظّريفة والبريئة
الّتي كنت تعرفها

219
00:16:26,770 --> 00:16:30,290
قد ولّت الآن

220
00:16:31,480 --> 00:16:34,270
إذاً سأخبركِ عن مشاعري فعليّاً أيضاً

221
00:16:35,210 --> 00:16:38,230
أثناء السّنوات العشرة عقب مُغادرة
،والدينا للقرية

222
00:16:38,230 --> 00:16:44,680
كان دانجي وكيري الدّاعم النّفسيّ
لي وسببي في الحياة

223
00:16:45,480 --> 00:16:50,680
أستطيع تحمُّل هجر والدَي لي
لأجل صديقي وأختي

224
00:16:51,050 --> 00:16:56,950
حتّى لو كانا مُنتحلين، لقد مدَّاني بقوّة المُتابعة

225
00:16:57,560 --> 00:17:01,150
لا أستطيع الاستمرار في لومهما

226
00:17:05,210 --> 00:17:08,450
!بئساً! هذا ليس مُنصِفاً

227
00:17:09,100 --> 00:17:14,460
قضيتُ معك ستّة سنوات فقط مُقارنة بعشرة
معهم. لا أستطيع التغلُّب على ذلك

228
00:17:14,460 --> 00:17:18,230
ليس هذا فقط، لكن إذا حسبت السّنوات
،الّتي كنتُ فيها واعية

229
00:17:18,230 --> 00:17:22,890
فلديّ أقلّ من ستّ سنوات من الذّكريات معك

230
00:17:26,550 --> 00:17:28,510
هذا ليس عدلاً

231
00:17:35,030 --> 00:17:39,170
هل من شيء تريدين فعله؟

232
00:17:39,170 --> 00:17:40,830
لِمَ هذا السّؤال فجأة؟

233
00:17:40,830 --> 00:17:42,900
هل لديكِ أي أحلام في  المُستقبل؟

234
00:17:43,240 --> 00:17:45,590
أجل. أرغب في زيارة ديزني لاند

235
00:17:45,590 --> 00:17:47,750
ديزني ماذا؟

236
00:17:47,750 --> 00:17:49,820
،أريد شراء الكثير من الأشياء الظّريفة

237
00:17:49,820 --> 00:17:53,630
وأستمتع بالمركبات وألتقط صورة في قلعة سندريلّا

238
00:17:52,950 --> 00:17:54,310
قلعة؟

239
00:17:53,630 --> 00:17:57,810
وأيضاً، أودّ مُشاهدة لعبة كُرة معاً

240
00:17:54,310 --> 00:17:57,260
إذاً هناك حاكم؟ ما حجم محصولهم؟

241
00:17:58,310 --> 00:18:01,260
أريد الخروج مع الجميع في أماكن كهذه

242
00:18:01,260 --> 00:18:04,750
وأرتاد المدرسة وأشتكي من الدّراسة
كأيّ طفلة عاديّة

243
00:18:04,750 --> 00:18:08,030
وأصرخ بشأن رغبتي في حبيب مُثير

244
00:18:08,030 --> 00:18:11,770
وأتذمّر من العمل في قطار يوميّ

245
00:18:11,770 --> 00:18:15,350
أريد عيش حياة طبيعيّة

246
00:18:16,280 --> 00:18:21,530
أمزح فحسب. هذا غير مُمكن الآن بعد أن عشتُ
عالماً مليئاً بالقتل

247
00:18:21,950 --> 00:18:27,650
هل أنا أو والدانا جزء من تلك
الحياة الطّبيعيّة؟

248
00:18:27,650 --> 00:18:28,870
!بالطّبع

249
00:18:28,870 --> 00:18:34,500
إذاً لنبنِها معاً على مدار عشر سنوات وأكثر

250
00:18:34,970 --> 00:18:39,270
سنهزم كافّة أعدائنا، ونعثر على والدينا

251
00:18:39,660 --> 00:18:42,680
ونعيش بسعادة وانفتاح معاً

252
00:18:43,010 --> 00:18:48,670
حينئذ يمكننا الذّهاب إلى قلعة ديز تلك
والاستمتاع مع بعضنا الآخر

253
00:18:49,030 --> 00:18:50,020
!أجل

254
00:18:50,290 --> 00:18:53,680
على أيّ حال، اكتشفتُ شيئاً
جديداً عن والدينا

255
00:18:54,130 --> 00:19:00,700
كان روي-سان من أخبر أمّي عن كيفيّة
الهرب من الحاجز قبل عشر سنوات

256
00:19:01,390 --> 00:19:03,250
والد ديرا-سان؟

257
00:19:03,250 --> 00:19:07,460
بجدّية؟ أمّي وأبي لم يذكرا ذلك أبداً

258
00:19:07,750 --> 00:19:12,580
روي-سان خانَ قرية هيغاشي للقيام بذلك

259
00:19:12,990 --> 00:19:17,460
غالباً لم يُخبرا أحداً لأنّهما شعرا
نفسيهما مَدينين له

260
00:19:18,150 --> 00:19:22,260
،روي-سان لديه ديرا-سان وابن آخر

261
00:19:22,260 --> 00:19:25,470
وكلاهما لا يملكان فكرة عن مكانه

262
00:19:26,460 --> 00:19:31,490
من المُمكن أن يتواصل والدانا مع روي-سان

263
00:19:32,410 --> 00:19:35,720
ديرا-سان وأنا سنجدهما، لذا اعتمدي علينا

264
00:19:35,720 --> 00:19:37,230
فهمت

265
00:19:38,040 --> 00:19:39,310
ثمّة أمر آخر

266
00:19:39,780 --> 00:19:45,620
السّيّاف الحامل لسلاحَي تسوغاي يعرف
ما حدث لهما بعد أن فُقِدا

267
00:19:46,990 --> 00:19:48,290
السّيّاف؟

268
00:19:50,200 --> 00:19:52,080
!يوسانو إيفان

269
00:19:52,080 --> 00:19:55,850
ماذا قال؟ أين والِدانا الآن؟

270
00:19:56,400 --> 00:19:59,290
حاولي أن تهدئي يا آسا

271
00:19:59,590 --> 00:20:03,730
قال بأنّه قتلَ أبي وأمّي

272
00:20:03,730 --> 00:20:07,180
ادّعى إيفان بأنّه قاتل والدَينا

273
00:20:07,580 --> 00:20:10,970
هربَ قبل أن نتمكّن من دفعه لإخبارنا بالمزيد

274
00:20:17,350 --> 00:20:18,330
!آسا

275
00:20:20,350 --> 00:20:21,480
!آسا

276
00:20:21,480 --> 00:20:23,530
مُستحيل. لماذا؟

277
00:20:23,530 --> 00:20:25,210
!اهدئي يا آسا

278
00:20:25,400 --> 00:20:28,700
...أبي، أمّي

279
00:20:29,340 --> 00:20:30,880
هذه غلطتي

280
00:20:31,600 --> 00:20:33,660
لأنّهم أخذوني

281
00:20:34,380 --> 00:20:36,620
تمّ إقحامهما في هذا الأمر لأنّهم أخذوني

282
00:20:36,620 --> 00:20:38,810
!آسا، اهدئي

283
00:20:38,810 --> 00:20:41,040
!هذا ما قاله فحسب

284
00:20:41,040 --> 00:20:42,720
!لا تُصدِّقيه

285
00:20:42,720 --> 00:20:45,660
هذا العالم مليء بالأشخاص الّذي
!لا يمكنكِ الوثوق بهم

286
00:20:45,660 --> 00:20:47,920
!لا تُصدِّقي شيئاً ما لم ترِه بعينيكِ

287
00:20:48,220 --> 00:20:51,850
!قلتِ بأنّ أبي وأُمّي حيّان يُرزقان

288
00:20:53,000 --> 00:20:53,770
هدّئي من روعكِ

289
00:20:54,790 --> 00:20:56,610
أطلقي تنهيدةً عميقة

290
00:21:00,300 --> 00:21:03,080
أجل. حسناً

291
00:21:03,080 --> 00:21:06,870
معك حقّ. إنّهما حيّان قطعاً

292
00:21:06,870 --> 00:21:11,120
،هذا صحيح. إذا كان هناك مَن يأسرهما
فسوف نُحرّرهما

293
00:21:11,720 --> 00:21:13,370
ثمّ نحن الأربعة

294
00:21:14,090 --> 00:21:18,510
سنعيش حياةً طبيعيّة وسعيدة معاً

295
00:21:20,970 --> 00:21:21,980
أجل

296
00:21:23,300 --> 00:21:29,220
"سيترتّب عليّ البدء باستخدام "كسر
لحلّ عقد السّيّاف

297
00:21:30,380 --> 00:21:35,770
،أخي، في المرّة المُقبلة الّتي تجده فيها
فاستدرجه إليّ

298
00:21:36,550 --> 00:21:38,840
،ما دمتُ أستطيع رؤيته

299
00:21:38,840 --> 00:21:42,200
سأقضي عليه، مهما كان بعيداً

300
00:21:42,510 --> 00:21:47,030
حسناً. يمين ويسار يعرفان رائحة دمه

301
00:21:47,510 --> 00:21:50,350
سنُطارده إلى ساحة صيدكِ

302
00:23:28,200 --> 00:23:30,710
مساء الخير يا سيّدة

303
00:23:30,710 --> 00:23:31,990
مكسور؟

304
00:23:31,990 --> 00:23:33,720
لم أفهم ألم الآخرين

305
00:23:34,150 --> 00:23:36,980
شعرتُ بعاطفة لم تُراودني من قبل