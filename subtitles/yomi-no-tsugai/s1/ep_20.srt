1
00:01:44,210 --> 00:01:45,370
...يمين

2
00:01:45,720 --> 00:01:46,660
!يسار

3
00:01:47,140 --> 00:01:48,710
هذا سيّئ

4
00:01:49,580 --> 00:01:51,160
!أنت تعترض طريقي يا يمين

5
00:01:51,160 --> 00:01:53,840
!أخبرتُك بأنّ يسار هي لي

6
00:02:11,020 --> 00:02:12,320
!هذا الوغد

7
00:02:13,320 --> 00:02:16,340
ماذا حدث لجرح ساقه؟ كيف
له أن يكون بهذه المرونة؟

8
00:02:22,730 --> 00:02:24,440
!ديرا-سان، أطلِق عليه

9
00:02:39,800 --> 00:02:40,810
!يورو

10
00:02:48,810 --> 00:02:49,810
!يورو

11
00:02:49,810 --> 00:02:52,160
إنّه مُجرّد خدش! ما زال بمقدوري
!تحريك يدي

12
00:02:52,160 --> 00:02:53,850
!لا تُحرّكها! اِثبت مكانك

13
00:02:53,850 --> 00:02:55,150
كدتُ أفعلها

14
00:02:57,240 --> 00:03:01,210
يستطيع إعادة توجيهها؟

15
00:03:02,310 --> 00:03:04,240
اللّعنة

16
00:03:04,240 --> 00:03:05,770
لقد أفلت

17
00:03:09,320 --> 00:03:13,970
أجل، هذا صحيح! هناك شلّالات دماء
!داخل المخزن

18
00:03:13,970 --> 00:03:15,750
رأيتُ خمسة أشخاص. لا، عشرة؟

19
00:03:15,750 --> 00:03:17,990
!لستُ متأكِّداً! لا أعلم

20
00:03:17,990 --> 00:03:19,840
!على أيّ حال، كانت هناك مجموعة منهم

21
00:03:19,840 --> 00:03:21,840
!أرسِلوا شخصاً ما حالاً

22
00:03:21,840 --> 00:03:23,060
ماذا؟

23
00:03:24,020 --> 00:03:27,300
لم تُزيلوا الجثثَ بعد؟

24
00:03:28,550 --> 00:03:29,720
من أنت؟

25
00:03:30,350 --> 00:03:33,100
!ا-انتظر يا صاح! لا يجوز أن تدخل إلى هناك

26
00:03:33,100 --> 00:03:35,390
!اتّصلتُ بالشّرطة للتو

27
00:03:35,390 --> 00:03:37,370
ماذا؟ ما عملك هنا بالضّبط؟

28
00:03:42,730 --> 00:03:47,200
ماذا؟ اختفى رجلٌ للتو

29
00:03:47,200 --> 00:03:51,570
!ماذا؟! سيّدي، هل أنت بخير؟ اهدأ

30
00:03:56,210 --> 00:03:58,030
!النّجدة

31
00:03:58,370 --> 00:04:00,760
التسوغاي الخاصّان بك يستطيعان
التحكُّم بالأشخاص؟

32
00:04:00,760 --> 00:04:03,040
هذا مُقلِق

33
00:04:03,390 --> 00:04:08,050
بما أنّك أتيتَ لأجل يورو، فهل أنت
أحد جنود قرية هيغاشي؟

34
00:04:10,990 --> 00:04:14,430
أبقياهما تحت السّيطرة يا فوجين-رايجين

35
00:04:14,430 --> 00:04:17,020
ستكون مُصيبة إذا اختطفا جسدي

36
00:04:17,450 --> 00:04:20,640
يتجمّع النّاسُ في الخارج يا خالي

37
00:04:21,810 --> 00:04:25,830
أتى جماعتنا غالباً للاطمئنان عليّ
بما أنّ هاتفي قد تعطَّل

38
00:04:25,830 --> 00:04:28,370
أحضر الكاغيموري آسا معهم

39
00:04:28,770 --> 00:04:30,850
ينبغي أن نهرب قبل أن يأخذوا
التسوغاي الخاصِّين بنا

40
00:04:31,800 --> 00:04:33,490
معك حقّ

41
00:04:34,020 --> 00:04:38,640
سيقتلني أبي إذا عَلِمَ بأنّني أتجسّس لصالحك

42
00:04:38,640 --> 00:04:42,090
لنقتل هذا الرّجل كي لا يبقى أي شهود

43
00:04:44,200 --> 00:04:45,470
أجل

44
00:04:47,760 --> 00:04:50,930
!لا! لا تفعلها

45
00:04:49,670 --> 00:04:53,240
!انتظر! لا تفعلها

46
00:04:54,080 --> 00:04:56,490
افعلها بطريقة نظيفة يا أسوما

47
00:04:56,490 --> 00:04:57,890
لا تُوسِّخ المكتب

48
00:04:57,890 --> 00:05:01,020
لحظة! ألن نعقد صفقة؟

49
00:05:01,020 --> 00:05:02,080
لا

50
00:05:02,080 --> 00:05:03,150
!بربِّك، أرجوك

51
00:05:03,500 --> 00:05:06,410
على ذكر الأمر، هل سبقَ وقتلتَ شخصاً؟

52
00:05:07,370 --> 00:05:08,990
لا

53
00:05:09,500 --> 00:05:11,650
لكن هناك شخص أريد قتله

54
00:05:16,760 --> 00:05:18,670
!لا تتحرّكا، فوجين-رايجين

55
00:05:19,110 --> 00:05:25,010
لم أستطع التصرُّف حتّى الآن لأنّكما
لم تبتعدا عن كتفَي خالي

56
00:05:25,330 --> 00:05:32,070
لكن الآن لديّ فُرصة أخيراً لقتلك
بنفسي يا خالي

57
00:05:32,070 --> 00:05:33,010
تقتلني؟

58
00:05:33,370 --> 00:05:37,360
فوجين-رايجين! ألم تشعرا بهذا الرّجل؟

59
00:05:37,680 --> 00:05:42,230
قدرة يوزاكورا على إخفاء وجودهما
وتعطّشهما للدّماء لا نظير لها

60
00:05:42,660 --> 00:05:46,220
غونزو، آسا، وفويوكي قريبون

61
00:05:46,220 --> 00:05:48,000
سيصلون قريباً

62
00:05:48,000 --> 00:05:49,690
!لقد نطَق

63
00:05:50,010 --> 00:05:54,620
سنقتلك بعد أن نستخرج كافّة المعلومات الّتي لديك

64
00:05:55,440 --> 00:05:58,230
!فوجين! اقذف يوزاكورا بعيداً

65
00:05:58,230 --> 00:06:01,840
سأكسر عنقَك قبل أن يحدث هذا

66
00:06:03,040 --> 00:06:06,580
إذا استخدمتَ برقاً، ستُصاب أيضاً

67
00:06:06,880 --> 00:06:10,570
،فوجين-رايجين، إن هاجمتُماني

68
00:06:10,570 --> 00:06:15,100
فيوزاكورا سوف يكسر عنقَ سيّدكما أيضاً

69
00:06:15,400 --> 00:06:17,470
هل يتشاجران؟

70
00:06:17,470 --> 00:06:19,020
لماذا يا أسوما؟

71
00:06:19,260 --> 00:06:22,590
كم حجم استثماراتي فيك برأيك؟

72
00:06:22,590 --> 00:06:25,240
استثمار؟ هكذا إذاً

73
00:06:25,240 --> 00:06:30,440
أولئك الّذين ينفقون المالَ للتحكُّم بالأشخاص لا ينفكّون
يتحدّثون عن ذلك حتّى آخر نفس

74
00:06:31,390 --> 00:06:37,070
خالي، بمن في ذلك خدَمهم، عشيرة
كاغيموري هي مجموعة من النّاس

75
00:06:37,070 --> 00:06:43,540
المرفوضين بواسطة العالم لكونهم عديمي الجدوى
أو مُختلفين أو غريبي أطوار

76
00:06:43,980 --> 00:06:48,620
بعد مُعاملتهم بشكل سيّئ بواسطة
،عائلة شينغو

77
00:06:48,620 --> 00:06:51,110
كانوا بمثابة جنّة في نظر أمّي

78
00:06:51,760 --> 00:06:53,380
كانوا خلاصها

79
00:06:53,920 --> 00:06:59,200
لا أستطيع مُسامحتك شخصيّاً على مُحاولتك
السّيطرة على الكاغيموري

80
00:06:59,200 --> 00:07:01,900
باستخدام قِوى التّوأمين

81
00:07:02,280 --> 00:07:08,570
ولستَ الشّخص الوحيد الّذي يستهدف
عشيرةَ كاغيموري، أليس كذلك؟

82
00:07:09,790 --> 00:07:16,300
تعلم بأنّه يتطلّب أكثر من أحمق ماكر
لسحق الكاغيموري

83
00:07:16,860 --> 00:07:20,720
ثمّة شخص يُغذّيك بالأفكار

84
00:07:22,610 --> 00:07:24,010
من هو؟

85
00:07:33,520 --> 00:07:34,590
ماذا؟

86
00:07:34,590 --> 00:07:38,010
!إيفان، في الوقت المُناسب
!اقتل هذا الرّجل

87
00:07:38,320 --> 00:07:40,680
فهمتُ ما يجري

88
00:07:40,680 --> 00:07:45,400
أخبرتُك ألّا تستهين بابن أختك يا شينغو-سان

89
00:07:45,400 --> 00:07:49,140
!اصمت! غونزو وآسا وفويوكي هنا

90
00:07:49,140 --> 00:07:50,740
!إذا قبضوا علينا، ينتهي أمرنا

91
00:07:51,830 --> 00:07:53,580
هذا صحيح

92
00:07:56,580 --> 00:07:57,860
!يوزاكورا

93
00:08:01,450 --> 00:08:06,080
،إذا أمسكَ بك التسوغاي الخاصّان بفويوكي
فسوف يستخرجان المعلومات منك

94
00:08:06,410 --> 00:08:08,300
لذا يجب أن تموت

95
00:08:16,060 --> 00:08:18,060
أسوما-سان

96
00:08:19,710 --> 00:08:22,350
هل أخبرك شينغو-سان بشيء؟

97
00:08:28,660 --> 00:08:31,780
!يا للهول! هذا ليس خدشاً

98
00:08:31,780 --> 00:08:33,440
!هذه حفرة

99
00:08:33,740 --> 00:08:38,260
الطّبيب العاديّ سيطرح أسئلة حول
جرح نتيجة طلق ناريّ

100
00:08:38,260 --> 00:08:40,220
لن تكون هانا-سان سعيدة بهذا

101
00:08:40,220 --> 00:08:41,220
!مؤلم

102
00:08:41,220 --> 00:08:46,450
آسف. لم أتوقّع أن يحرفَ رصاص
البندقيّة بسيفيه

103
00:08:46,450 --> 00:08:50,620
لم يكن باليد حيلة. هذه ليست غلطتك

104
00:08:51,180 --> 00:08:57,160
هل تلك قدرة للتسوغاي الخاصّين به
أم أنّها مهارته؟

105
00:08:57,820 --> 00:09:02,220
رُبّما مزيج بين الاثنين

106
00:09:02,450 --> 00:09:05,260
إنّهم مُتوافِقون بشكل بليغ إذاً

107
00:09:05,260 --> 00:09:07,460
في كلّ الأحوال، إنّه قويٌّ جدّاً

108
00:09:07,460 --> 00:09:10,700
استطاع مُواجهتكما في آن واحد

109
00:09:11,260 --> 00:09:12,980
...بالمُناسبة

110
00:09:13,980 --> 00:09:16,060
!دانجي

111
00:09:16,640 --> 00:09:18,040
!أنت

112
00:09:19,150 --> 00:09:21,090
ماذا؟ إلى أين ذهب؟

113
00:09:21,090 --> 00:09:22,460
لدق هرب

114
00:09:23,280 --> 00:09:25,500
هل يمكنك الإمساك بساقي؟

115
00:09:25,820 --> 00:09:27,880
تذكّرت. ساقك

116
00:09:27,880 --> 00:09:29,250
هل أنت بخير؟

117
00:09:29,790 --> 00:09:31,920
أجل، لا تقلق

118
00:09:32,350 --> 00:09:34,420
إنّها مثل ذِراع يسار

119
00:09:34,710 --> 00:09:39,260
اشترِ لنا شيئاً لإلصاقها وإعادتها
من مركز التّحسينات المنزليّة

120
00:09:39,510 --> 00:09:43,020
يسار، أنتِ بخير بعد طعنكِ في القلب؟

121
00:09:43,210 --> 00:09:47,160
بخلاف البشر، لا أملك قلباً

122
00:09:47,160 --> 00:09:51,770
ماذا؟ هل هذا يعني بأنّكِ ستنجين بعد
شقّ رأسكِ وفتحه؟

123
00:09:51,770 --> 00:09:53,020
غالباً

124
00:09:53,020 --> 00:09:55,630
ما الّذي يقتلكما بالضّبط؟

125
00:09:55,630 --> 00:09:57,000
يقتلنا؟

126
00:09:58,920 --> 00:10:01,610
لم نمت أبداً، لذا لا نعلم

127
00:10:01,610 --> 00:10:03,750
حسناً، هذا صحيح

128
00:10:03,750 --> 00:10:08,220
نحن لا نفهم الموت، لكن يُراودني شعور
بأنّ تلك الهجمة كانت فظيعة

129
00:10:08,670 --> 00:10:11,300
استنزفتْ طاقتي فوراً

130
00:10:11,560 --> 00:10:13,280
ماذا كان ذلك؟

131
00:10:13,280 --> 00:10:17,140
بما أنّها وجّهتْ ضربة قاضية ليسار
،وشغّلتْ مُحرِّك الرّجل المُنحرف

132
00:10:17,140 --> 00:10:19,330
فهل هذا نوع من نقل الطّاقة؟

133
00:10:19,590 --> 00:10:21,550
قاضية؟ شغّلتْ مُحرِّك؟

134
00:10:21,550 --> 00:10:22,850
كمصّاص دماء

135
00:10:23,930 --> 00:10:27,060
مُنحرف يحوم للحصول على طاقتنا

136
00:10:27,520 --> 00:10:30,440
على أيّ حال، لن أتمكّن من الحركة لبعض الوقت

137
00:10:30,740 --> 00:10:34,680
،البندقيّة عديمة الجدوى ضدّه
ويمين ويسار في حالة فوضى

138
00:10:34,680 --> 00:10:37,050
شُلَّتْ حركتنا تماماً

139
00:10:37,050 --> 00:10:38,950
لندعه للكاغيموري

140
00:10:39,630 --> 00:10:41,290
أنا آسفة يا يورو

141
00:10:41,290 --> 00:10:45,740
كان دليلكِ إلى والديكِ، فسمحنا له بالهرب

142
00:10:46,030 --> 00:10:48,290
لا، أنا من يعتذر

143
00:10:48,290 --> 00:10:51,540
قاتلتُما ببسالة فانتهى المطاف بكما هكذا

144
00:10:51,850 --> 00:10:57,080
أليس سيّدنا الحاليّ لطيفاً يا يسار؟

145
00:10:57,080 --> 00:11:01,130
كيف كان طبع سيّدكما السّابق بالضّبط؟

146
00:11:02,420 --> 00:11:04,890
حسناً، لقد أفلتَ هذه المرّة

147
00:11:05,260 --> 00:11:07,750
لكنّنا نعرف رائحة دمه الآن

148
00:11:07,750 --> 00:11:09,470
لن يفلت في المرّة المُقبلة

149
00:11:10,090 --> 00:11:12,640
ستبقيان معي؟

150
00:11:13,060 --> 00:11:14,280
بالطّبع

151
00:11:14,650 --> 00:11:18,940
مولايّ يورو، نحن معك دوماً

152
00:11:20,480 --> 00:11:22,650
كان ذلك تصرُّفاً فظيعاً منك

153
00:11:22,970 --> 00:11:26,070
أردتُ قتله

154
00:11:27,160 --> 00:11:31,640
المعذرة، لكن وفّرتُ عليك العناء، صحيح؟

155
00:11:31,640 --> 00:11:37,170
تجعل القتلَ يبدو سهلاً، لكن عمليّة
التّنظيف ليست كذلك

156
00:11:37,380 --> 00:11:41,810
أمثالك ينبغي أن يدعوا الأمر لمُحترفين أمثالي

157
00:11:42,300 --> 00:11:48,100
رغم ذلك، أُشكِّك في شخص يقتل
ربَّ عمله بهذه السّهولة

158
00:11:48,100 --> 00:11:53,210
.فعلتُ ذلك لأجل المال فقط
لا أُحبّ شينغو-سان

159
00:11:53,210 --> 00:11:56,430
وقد حصلتُ على أجري بالفعل

160
00:11:56,810 --> 00:11:58,280
أسكتَّه إذاً؟

161
00:11:59,690 --> 00:12:02,750
هل هذا يعني بأنّ شينغو-سان أخبرك بشيء؟

162
00:12:03,320 --> 00:12:06,430
،لا، لم يُخبرني بشيء

163
00:12:06,430 --> 00:12:11,340
لكن أعتقد بأنّ هناك شخصاً يُغذّيه بأفكار

164
00:12:11,770 --> 00:12:16,540
يبدو أنّه سيكون من الأسرع استجوابك بدلاً من ذلك

165
00:12:36,620 --> 00:12:37,730
قُضي عليّ

166
00:13:00,180 --> 00:13:04,100
طاقة يسار مُذهلة

167
00:13:04,820 --> 00:13:07,190
المفعول الرّجعيّ فتّاك

168
00:13:07,810 --> 00:13:08,810
...إيفان

169
00:13:09,810 --> 00:13:10,810
لقد أتوا

170
00:13:11,640 --> 00:13:13,900
الخطيرون

171
00:13:15,710 --> 00:13:17,510
من هو العجوز؟

172
00:13:18,100 --> 00:13:19,150
!إنّهم الكاغيموري

173
00:13:21,890 --> 00:13:25,210
أشعر بكثير من التسوغاي

174
00:13:25,210 --> 00:13:28,810
!لنأخذ طاقته ونبدأ بمعركة أُخرى

175
00:13:28,810 --> 00:13:31,190
لا، ساقي اليُمنى مُصابة

176
00:13:31,190 --> 00:13:32,780
من سهم الفتى؟

177
00:13:32,780 --> 00:13:35,440
أخبرتُك أن تُعالجها

178
00:13:35,440 --> 00:13:40,290
رماني قبل أن يُشفَى جرح طعنتك أيُّها الأحمق

179
00:13:40,740 --> 00:13:43,470
لديّ فكرة

180
00:13:43,470 --> 00:13:46,500
إذا طعنتُ ساقك اليُسرى، فسيتحقّق التّوازن
بين جانبك الأيمن والأيسر

181
00:13:46,500 --> 00:13:48,630
حينئذ يمكنك التحرُّك من جديد

182
00:13:49,800 --> 00:13:53,530
لن تفهم أبداً مدى ضعف البشر

183
00:13:54,300 --> 00:13:56,980
حالفَك الحظُّ هذه المرّة يا أسوما-سان

184
00:13:59,920 --> 00:14:03,700
لا أريد أن أموت، لذا سأُغادر الآن

185
00:14:04,100 --> 00:14:09,700
،وإذا قضيتُ مزيداً من الوقت معك
فقد يفعل يوزاكورا شيئاً

186
00:14:10,170 --> 00:14:11,340
إلى اللّقاء

187
00:14:36,750 --> 00:14:40,640
حسناً، ماذا حدث هنا بالتّحديد؟

188
00:14:40,940 --> 00:14:42,530
!أسوما-سان، ذِراعك

189
00:14:42,530 --> 00:14:44,150
هل تأذّيت؟

190
00:14:44,540 --> 00:14:49,660
سامحني يا أبي. فشلتُ في القبض عليه حيّاً

191
00:14:49,660 --> 00:14:51,410
...شينغو

192
00:14:51,740 --> 00:14:53,580
هل أنتَ من قتله؟

193
00:14:53,580 --> 00:14:58,660
لا. لقد تشاجرا، أو بالأحرى، تمَّ إسكاته

194
00:14:58,990 --> 00:15:01,450
يوسانو إيفان قد قتلَه

195
00:15:01,950 --> 00:15:03,530
يوسانو؟

196
00:15:03,530 --> 00:15:08,680
ذلك السّيّاف الحامل لسِلاحَي تسوغاي
الّذي استأجره شينغو مُؤخّراً؟

197
00:15:08,680 --> 00:15:09,980
سيّاف؟

198
00:15:09,980 --> 00:15:12,680
تقصد ذلك الرّجل الّذي هربَ للتو؟

199
00:15:13,050 --> 00:15:15,850
هل كان ينبغي أن أستخدم "كسر" للقبض عليه؟

200
00:15:16,340 --> 00:15:18,280
أنا آسف يا فويوكي

201
00:15:18,280 --> 00:15:21,440
فوجين-رايجين ومُخلّفاتهما قد دُمِّروا

202
00:15:21,440 --> 00:15:23,220
لذا لا نستطيع استخراج معلوماتهما

203
00:15:24,450 --> 00:15:28,800
،علمتُ بأنّ شخصاً كان يُحرِّض خالي

204
00:15:28,800 --> 00:15:31,370
لكنّه قُتِلَ قبل أن أعرِف من يكون

205
00:15:31,370 --> 00:15:32,690
أعتذر

206
00:15:33,160 --> 00:15:35,950
ينبغي أن تقلق على نفسك أوّلاً

207
00:15:36,440 --> 00:15:37,870
لنُوقِف نزيفك

208
00:15:39,570 --> 00:15:43,450
رجل قرية هيغاشي قد هربَ أيضاً

209
00:16:00,520 --> 00:16:03,810
مرحباً! ما الأمر يا إيفان-ساما؟

210
00:16:05,710 --> 00:16:08,260
مينياما، أين أنتِ؟

211
00:16:08,260 --> 00:16:09,810
في المخازن

212
00:16:10,190 --> 00:16:13,970
كانت الجثث لا تزال هناك. قومي بعملكِ بسرعة

213
00:16:13,970 --> 00:16:16,210
آسفة لأنّني استغرقتُ وقتاً طويلاً

214
00:16:16,210 --> 00:16:18,820
هذا المكان ضخم، لذا تهتُ

215
00:16:19,400 --> 00:16:22,550
أنا أُرتِّبهم الآن

216
00:16:22,550 --> 00:16:25,860
قلتُ بأنّني آسفة على التأخُّر

217
00:16:25,860 --> 00:16:29,320
لديّ درس ومدرسة حشو، مفهوم؟

218
00:16:29,320 --> 00:16:34,110
.قتلتَ الكثير من الأشخاص ثانية
يتطلّب التّنظيف جهداً كبيراً

219
00:16:34,110 --> 00:16:37,050
لكن فتياني مسرورون

220
00:16:39,260 --> 00:16:42,610
هل كلُّ هؤلاء هم من جماعة قرية هيغاشي؟

221
00:16:42,610 --> 00:16:45,270
لا أدري ما إن كان فتياني سيروقهم المذاق

222
00:16:45,600 --> 00:16:48,690
أين ينبغي أن نلتقي عندما أنتهي؟

223
00:17:01,980 --> 00:17:04,250
أحسنتم صنعاً يا فتياني

224
00:17:08,630 --> 00:17:13,500
يا سيّد، أنت تُهلوس لأنّك مُرهَق، صحيح؟

225
00:17:13,500 --> 00:17:14,920
عُد إلى المنزل ونَلْ قسطاً من الرّاحة

226
00:17:19,770 --> 00:17:23,390
كومة من الجثث وبرْكة من الدّماء في المخزن؟

227
00:17:25,250 --> 00:17:28,740
لا أرى أي جثّة، ولا حتّى قطرة دم

228
00:17:28,740 --> 00:17:30,000
معك حقّ

229
00:17:31,420 --> 00:17:33,290
يوجد فتحةٌ في السّقف

230
00:17:33,290 --> 00:17:34,630
ما هذا بالضّبط؟

231
00:17:39,810 --> 00:17:41,130
رأيتُ ذلك

232
00:17:41,130 --> 00:17:43,950
اهدأ يا سيّدي

233
00:17:43,950 --> 00:17:48,240
!رأيتُ ذلك! أنا متأكّدٌ بأنّني رأيت

234
00:17:48,240 --> 00:17:49,790
كانت هناك كومة من الجثث

235
00:17:49,790 --> 00:17:55,730
ظهرتْ فتاةٌ وكدّسَت الجثثَ على
شكل كُرة واختفتْ

236
00:17:58,460 --> 00:18:04,340
هـ-هل تعتقدون بأنّني فقدتُ صوابي؟

237
00:18:06,070 --> 00:18:10,850
!إيفان-ساما

238
00:18:11,900 --> 00:18:13,460
ها أنت هنا

239
00:18:13,810 --> 00:18:15,420
!إيفان-ساما

240
00:18:15,420 --> 00:18:17,670
لا تصرخي. رأسي يُؤلمني

241
00:18:17,670 --> 00:18:20,900
رؤيتك بهذا الوهن مُثيرة حقّاً

242
00:18:21,140 --> 00:18:22,920
إيفان، أتريد أن أقتلها؟

243
00:18:22,920 --> 00:18:25,810
هذه أوّل مرّة نتّفق فيها يا شوكيو

244
00:18:26,480 --> 00:18:28,870
هل استخدمتَ مهارة نقل الحياة خاصّتك؟

245
00:18:28,870 --> 00:18:31,980
أجل، على يسار

246
00:18:31,980 --> 00:18:35,920
إنّهما كإلَهين. هل كان ذلك مُريعاً؟

247
00:18:35,920 --> 00:18:41,420
أجل. وكأنّني كرعتُ دلواً مليئاً
بشراب الطّاقة

248
00:18:41,760 --> 00:18:45,850
هذا فظيع. الجهد على قلبي شديد

249
00:18:46,820 --> 00:18:48,940
لن أتمكّن من التحرُّك لبعض الوقت

250
00:18:48,940 --> 00:18:51,530
هل هذه هي فُرصتي؟

251
00:18:51,530 --> 00:18:54,530
إن توقّفَ قلبُك، فسأؤدّي الإنعاشَ الرّئويّ

252
00:18:55,820 --> 00:18:57,380
!لا تفعلي أيّتها المُنحرفة

253
00:18:58,830 --> 00:19:00,180
وبعد؟

254
00:19:00,180 --> 00:19:03,590
فشلتَ في هزيمة يسار أو قتل يورو؟

255
00:19:03,590 --> 00:19:06,110
لم تكسب شيئاً نتيجة جهودك؟

256
00:19:07,010 --> 00:19:10,820
لا تقلقي. سيأتي يورو لاستهدافي

257
00:19:11,190 --> 00:19:13,250
سأراه ثانية عمّا قريب

258
00:19:13,250 --> 00:19:16,160
يبدو أنّكما واقعان في حُبّ بعضكما الآخر

259
00:19:16,160 --> 00:19:18,510
أنت تُثير غيرتي

260
00:19:18,710 --> 00:19:20,460
بالتّوفيق لك في ذلك

261
00:19:20,460 --> 00:19:25,590
أفضِّل ألّا أُعيدك إلى قرية نيشينو
ككتلة من اللّحم

262
00:19:26,670 --> 00:19:27,830
...أخي

263
00:19:30,020 --> 00:19:31,570
!أنت جريح

264
00:19:31,570 --> 00:19:34,930
أجل. تلقّيتُ رصاصةً بواسطة ديرا-سان

265
00:19:35,380 --> 00:19:37,770
!ديرا-سان

266
00:19:36,820 --> 00:19:39,430
!يورو، كان بوسعك شرح الأمر بطريقة أفضل

267
00:19:39,430 --> 00:19:42,900
!قلتَ بأنّك ستحميه يا ديرا-سان

268
00:19:42,900 --> 00:19:45,360
!أنا آسف! أنا آسف حقّاً

269
00:19:45,360 --> 00:19:49,680
!وكذلك أنتما يا يمين ويسار

270
00:19:49,680 --> 00:19:50,780
...في الواقع

271
00:19:50,780 --> 00:19:51,860
آسفة

272
00:19:51,860 --> 00:19:55,180
!كان ينبغي للكاغيموري أن يتبنّوه

273
00:19:55,180 --> 00:19:57,370
!لا يمكن الوثوق بقرية هيغاشي

274
00:19:57,370 --> 00:20:01,640
لا أُصدِّق بأنّكم أنتم الثّلاثة
!سمحتُم بإصابته بجروح

275
00:20:01,640 --> 00:20:02,630
!وأنت

276
00:20:03,940 --> 00:20:05,470
أنا آسف

277
00:20:16,330 --> 00:20:18,940
سأُخرجكما حالما أنتهي من العمل

278
00:20:20,930 --> 00:20:23,270
كم مضى من وقت؟

279
00:20:27,590 --> 00:20:28,940
أزامي-تشان؟

280
00:20:30,230 --> 00:20:34,060
لحظة. هل ستُخرِجنا الآن؟

281
00:20:38,960 --> 00:20:41,630
...أخي

282
00:20:46,380 --> 00:20:47,360
من أنتم؟

283
00:20:48,040 --> 00:20:49,660
مرحباً يا أزامي

284
00:20:50,140 --> 00:20:51,860
يسرّني أنّكِ بخير

285
00:20:53,080 --> 00:20:57,020
د-ديرا-سان؟ أين لحيتك؟

286
00:20:57,940 --> 00:21:03,470
أين أنا؟ أنا مُشوَّشة! أريد
!العودة إلى المنزل

287
00:21:03,970 --> 00:21:06,080
اهدئي يا آنسة

288
00:21:06,520 --> 00:21:08,780
الرّجال المُخيفون قد رحلوا الآن

289
00:21:08,780 --> 00:21:12,980
!لا! تبدو ابتسامة هذا الرّجل مُصطنعة

290
00:21:15,490 --> 00:21:17,850
مهلاً، اهدئي

291
00:21:17,850 --> 00:21:20,390
لن يؤذيكِ أحد

292
00:21:22,790 --> 00:21:26,210
تذكّرت. لا يمكنكِ رؤيتنا

293
00:21:27,360 --> 00:21:30,900
هذا أنا. التقينا في قرية هيغاشي، أتتذكّرين؟

294
00:21:30,900 --> 00:21:31,900
ماذا؟

295
00:21:36,170 --> 00:21:39,640
!فقدت وعيها ثانية. هذا جارح للمشاعر

296
00:21:39,640 --> 00:21:43,180
...ماذا؟ إذا خرجتْ أزامي فقط، فهذا يعني

297
00:21:43,530 --> 00:21:50,060
يورو ودانجي وآسا الحقيقيّة وآسا
المُزيّفة فقط في الدّاخل؟

298
00:21:50,610 --> 00:21:52,420
يبدو هذا كشلّال دماء

299
00:23:27,890 --> 00:23:33,170
أنا آسفة. كنتُ أعلم بأنّه من الخطأ
الاستمرار في القيام بهذا

300
00:23:33,170 --> 00:23:36,890
يفقد النّاسُ عقولهم دوماً حيث
توجد قوّةٌ عظيمة