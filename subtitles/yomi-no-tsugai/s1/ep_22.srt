1
00:01:52,500 --> 00:01:54,050
كان ذلك تسوغاي

2
00:01:54,050 --> 00:01:56,020
كان كذلك بالتّأكيد

3
00:01:56,580 --> 00:01:59,170
أوقف السّيّارة. سألقي نظرة

4
00:01:59,170 --> 00:01:59,930
حاضر

5
00:02:07,110 --> 00:02:09,190
عمتِ مساء يا سيّدتي

6
00:02:09,560 --> 00:02:12,120
أرى بأنّ لديكِ شريك لطيف هناك

7
00:02:15,560 --> 00:02:17,440
يمكنك رؤيته؟

8
00:02:18,950 --> 00:02:22,680
جمجمة ذات قرنين، وريش أسود

9
00:02:23,190 --> 00:02:26,570
هذا تسوغاي وسيم. ما اسمه؟

10
00:02:34,460 --> 00:02:35,760
...أخيراً

11
00:02:36,180 --> 00:02:39,220
!أنت أوّل شخص ألتقي به يفهمني

12
00:02:44,360 --> 00:02:47,520
لستُ أفهم فحسب. أنا مثلكِ

13
00:03:01,470 --> 00:03:04,070
نحن كينو-غيوكتو

14
00:03:04,070 --> 00:03:07,060
اسم هذا هو يوزاكورا

15
00:03:07,060 --> 00:03:09,750
لا أرى نصفَه الآخر

16
00:03:09,750 --> 00:03:11,920
اسمه هو أساغيري

17
00:03:11,920 --> 00:03:14,400
إنّهما يختبئان. لا يحبّان اللّيل

18
00:03:16,160 --> 00:03:21,330
إذاً، ماذا كنتِ تفعلين في مثل هذه السّاعة؟

19
00:03:23,970 --> 00:03:27,720
كنتُ أفكِّر في القفز والانتحار

20
00:03:28,430 --> 00:03:31,500
لا يحتاجني أحد

21
00:03:31,940 --> 00:03:35,200
حالما تقفزين، سأُمسككِ

22
00:03:35,200 --> 00:03:37,310
يجب ألّا تموتي

23
00:03:37,310 --> 00:03:40,380
أنا آسفة. آسفة جدّاً

24
00:03:41,710 --> 00:03:45,260
المعذرة. التقينا للتو، لذا لا ينبغي
أن أقول هذا الكلام

25
00:03:45,260 --> 00:03:46,990
لا عليكِ

26
00:03:47,280 --> 00:03:49,880
لا بُدّ أنّ القدَر هو ما جعلَني أعبر من هنا

27
00:03:49,880 --> 00:03:52,750
إن لم تُمانعي، فكُلّي آذان صاغية

28
00:03:53,530 --> 00:03:56,110
اسمي كاغيموري غونزو

29
00:03:56,510 --> 00:03:59,110
وأنا شينغو إيوري

30
00:04:00,010 --> 00:04:02,630
ماذا قصدتِ عندما قلتِ بأنّه
لا أحد يحتاجكِ؟

31
00:04:03,450 --> 00:04:08,030
منذ كنتُ طفلة، لم أتمكّن من فعل
أيّ شيء بصورة صحيحة

32
00:04:08,660 --> 00:04:11,650
فشلتُ في الالتحاق بالمدرسة الّتي
أرادَني والدايّ دخولها

33
00:04:11,650 --> 00:04:13,680
أنا بليدة وغبيّة فيما يتعلّق بكُلِّ شء

34
00:04:14,310 --> 00:04:16,600
لم أستطع الارتقاء لتوقّعاتهما

35
00:04:16,600 --> 00:04:18,640
حتّى أخي الأكبر يسخر منّي

36
00:04:19,260 --> 00:04:22,610
عامَلوني وكأنّني غير موجودة أساساً

37
00:04:23,500 --> 00:04:28,500
أدركتُ بأنّ هذا العالم لا يحتاجني

38
00:04:30,980 --> 00:04:35,990
حاولتُ الموت مرّةً من قبل

39
00:04:39,890 --> 00:04:44,880
التقيتُ بهذين عندما دخلتُ الجبال
بحثاً عن مكانٍ للموت

40
00:04:45,410 --> 00:04:47,850
وجدتُ أثرَ كينو-غيوكوتو

41
00:04:50,690 --> 00:04:55,840
كان بلا رأس أو يدين، لكن بدا جميلاً بالنّسبة لي

42
00:04:57,090 --> 00:05:01,460
،أنا جاهلة فيما يتعلّق بالآلهة وبوذا

43
00:05:02,270 --> 00:05:07,790
لكن شعرتُ بأنّ هذا الشّخص يستطيع
أن يأخذني إلى الجنّة

44
00:05:08,770 --> 00:05:12,190
...عندما شققتُ مِعصَمي

45
00:05:12,760 --> 00:05:14,790
أتيا

46
00:05:14,790 --> 00:05:15,820
أجل

47
00:05:16,210 --> 00:05:21,510
كلاهما لطيفان جدّاً ويستمعان لي
بينما أتحدّث عن همومي

48
00:05:21,970 --> 00:05:25,580
،لكن عندما سَمِعَتْني عائلتي أتكلّم معهما

49
00:05:25,580 --> 00:05:29,340
ظنّوا بأنّني فقدتُ صوابي

50
00:05:29,930 --> 00:05:34,990
شرحتُ ماهيّة التسوغاي، لكن قالوا
بأنّني كنتُ أتكلّم مع فراغ

51
00:05:34,990 --> 00:05:38,340
وبأنّني كنتُ أُلهوس وأتخيّل سماع
أصوات. وبأنّني مريضة

52
00:05:38,780 --> 00:05:42,600
لذا كشفتُ لهم عن شكلهما

53
00:05:42,600 --> 00:05:45,570
حتّى بدؤوا بنعتهما بالشّياطين والأرواح الشّرّيرة

54
00:05:45,570 --> 00:05:51,100
قالوا بأنّني مُسِستُ بواسطة وحوش
وتحاشوني أكثر فأكثر

55
00:05:51,750 --> 00:05:55,200
أخي الوحيد الّذي بدا مُهتمّاً لسبب ما

56
00:05:55,200 --> 00:05:57,710
!لا يمكن الوثوق به

57
00:05:57,990 --> 00:06:03,050
حتّى لو كان يعلم بأمرنا، سوف يجعلنا نعمل
!كعبيد لتحقيق مآربه الشّخصيّة

58
00:06:03,050 --> 00:06:05,710
سيستغلّكِ ليس إلّا يا إيوري

59
00:06:05,710 --> 00:06:08,070
!يجب أن تقطعي علاقتكِ بشينغو

60
00:06:09,110 --> 00:06:13,800
لا مكان لأشخاص مثلي في هذا
العالم، أليس كذلك؟

61
00:06:17,210 --> 00:06:20,620
إيوري-سان، هل ترغبين في
المجيء إلى منزلي؟

62
00:06:21,430 --> 00:06:22,480
ماذا؟

63
00:06:22,480 --> 00:06:26,070
الكاغيموري عشيرة ضخمة جدّاً

64
00:06:26,070 --> 00:06:29,480
نحن نُوسّع أعمالنا ونبحث عن مُوظّفين

65
00:06:29,480 --> 00:06:33,410
...لكنّني... غريبةٌ تماماً

66
00:06:33,410 --> 00:06:37,820
لدينا كثير من العُمّال الّذين تعرّضوا
،لظروف شبيهة بظروفكِ

67
00:06:37,820 --> 00:06:40,330
والكثير منهم مُستخدمو تسوغاي

68
00:06:40,330 --> 00:06:43,370
يستطيع أيّ شخص العيش معنا بلا تحفُّظات

69
00:06:44,960 --> 00:06:48,190
وأيّ شخص يمتلك تسوغاي بالذّات مُرحَّب به

70
00:06:55,370 --> 00:06:58,830
أخي، هل كتفك بخير؟

71
00:06:59,830 --> 00:07:02,880
غالباً. أستطيع تحريك ذِراعي

72
00:07:02,880 --> 00:07:06,720
ألم تتلقّ رصاصة بقنّاص؟
!عليك مُعالجتها كما ينبغي

73
00:07:06,970 --> 00:07:09,810
إذا ذهبتَ لزيارة طبيب نظاميّ
،بجرح طلَق ناريّ

74
00:07:09,810 --> 00:07:13,300
فسوف يطرح مُختلَف الأسئلة الفضوليّة
ويستدعي الشّرطة

75
00:07:13,300 --> 00:07:13,870
!ماذا؟

76
00:07:14,160 --> 00:07:17,940
وأنت لا تحمل أي بطاقة تأمين، لذا
سيُكلِّف العِلاج الكثير

77
00:07:17,940 --> 00:07:19,290
!هذا سيّئ

78
00:07:19,630 --> 00:07:22,180
!سأُسبِّب حينئذ مُشكلة أكبر لهانا-سان

79
00:07:23,250 --> 00:07:25,170
...لذا، على أيّ حال

80
00:07:25,420 --> 00:07:27,080
!لنذهب إلى قصر كاغيموري

81
00:07:27,080 --> 00:07:28,210
لماذا؟

82
00:07:28,210 --> 00:07:31,210
ساكورازاوا-سينسي موجودة في
عيادة كاغيموري

83
00:07:31,210 --> 00:07:33,640
إنّها ليست طبيبة عاديّة، لذا لا تقلق

84
00:07:33,640 --> 00:07:36,520
ماذا؟ تلك الطّبيبة الّتي تمتصّ دم النّاس؟

85
00:07:36,520 --> 00:07:40,550
وطبيبة غير عاديّة لا تبدو آمنة

86
00:07:40,550 --> 00:07:46,170
أنا لا أثق حتّى بكاغيموري بصورة عامّة

87
00:07:42,280 --> 00:07:48,570
!مُؤلم، مُؤلم، مُؤلم

88
00:07:46,170 --> 00:07:48,570
لن أذهب معكِ

89
00:07:48,570 --> 00:07:51,030
!هذا ليس لطيفاً يا أخي

90
00:07:51,030 --> 00:07:54,640
هل أنتِ متأكّدة بأنّه يمكن الوثوق بهم؟

91
00:07:56,000 --> 00:07:57,510
لا تقلق

92
00:07:58,250 --> 00:08:02,620
أجل، إنّهم مُختلفون عن مُعظم
،النّاس هنا في الأسفل

93
00:08:03,070 --> 00:08:07,930
لكن الأشخاص العاديّين لا يصمدون
طويلاً في هذا العالم

94
00:08:09,030 --> 00:08:12,860
كما أخبرتُك، كان مولايّ وجين-سان

95
00:08:12,860 --> 00:08:15,180
مَن أنقذاني من الّذين يُطاردونني
من قرية هيغاشي

96
00:08:15,430 --> 00:08:16,820
جين إذاً؟

97
00:08:16,820 --> 00:08:19,450
،حتّى عندما وجّهتُ ساطوراً نحو عنقه

98
00:08:19,450 --> 00:08:24,070
اعترفَ بأنّه كان مسؤولاً عن الهجوم
على قرية هيغاشي

99
00:08:24,070 --> 00:08:27,940
تماماً. إنّه صادق بأغرب صورة مُمكنة

100
00:08:28,590 --> 00:08:31,880
،من بين الأخوة الثّلاثة

101
00:08:31,880 --> 00:08:36,330
زعمَ بأنّه الشّرّير لحماية عشيرة كاغيموري

102
00:08:36,880 --> 00:08:40,990
يبقى مُستقلّاً ويتجنّب التّعاطف
مع الخصوم أو الأتباع

103
00:08:40,990 --> 00:08:45,670
وكأنّه يقمع عواطفَه لأجل العمل

104
00:08:46,330 --> 00:08:48,140
ماذا عن الأخوين الآخرين؟

105
00:08:48,410 --> 00:08:54,130
هيغوري-سينسي يُعلّمني المهارات وذلك
كي أعيش حياةً طبيعيّة في المُستقبل

106
00:08:54,390 --> 00:08:57,960
يُعلّمني رسمَ المانغا. إنّها تُشبه الكِتابة
على الرّوسم الخشبيّ لكن بصورة حديثة

107
00:08:57,960 --> 00:09:00,380
يسمح لي بمُساعدته في عمله

108
00:09:00,720 --> 00:09:03,040
بهذا الشّكل، أستطيع على الأقلّ
كسب مال للإنفاق

109
00:09:03,040 --> 00:09:05,800
داخل الحاجز دون المُخاطرة للخروج

110
00:09:05,800 --> 00:09:07,840
هذا جيّد

111
00:09:08,150 --> 00:09:09,970
...بالنّسبة لأسوما-سان

112
00:09:10,590 --> 00:09:12,240
تبدو ابتسامته مُصطنعة حقّاً

113
00:09:12,240 --> 00:09:14,660
إنّه الأقلّ موثوقيّة من بين الجميع

114
00:09:14,860 --> 00:09:19,120
هل سألَك أسوما-سان ما إن
كنتَ تريد الموت؟

115
00:09:19,120 --> 00:09:20,400
أجل

116
00:09:20,400 --> 00:09:24,780
يرى أسوما-سان بأنّه إذا كان النّاس
،سيستمرّون في مُحاولة قتلك

117
00:09:24,780 --> 00:09:28,920
فيمكنك أن تموت مرّةً وتكتسب قوّة
كي تتمكّن من حماية نفسك

118
00:09:29,170 --> 00:09:33,840
بالإضافة إلى ذلك، ينبغي أن تتلقّى
دعماً تحت إدارة

119
00:09:33,840 --> 00:09:36,430
مجموعة قويّة مثل الكاغيموري

120
00:09:36,820 --> 00:09:42,150
يقول كلاماً مُقلِقاً، لكنّه لا يكذب علينا

121
00:09:44,170 --> 00:09:46,240
ماذا نفعل مع هذه الفتاة؟

122
00:09:46,240 --> 00:09:48,340
أنعيدها إلى قرية هيغاشي؟

123
00:09:48,590 --> 00:09:52,860
بالطّبع، فقد رأتْ وسمعتْ أشياء
كثيرة هنا في الأسفل

124
00:09:53,180 --> 00:09:56,480
إذا عادتْ، سيترتّب علينا الحرص
—على ألّا تقول

125
00:09:56,480 --> 00:09:58,520
هل كنتَ لتحبسها في زنزانة؟

126
00:10:01,960 --> 00:10:04,650
أما من طريقة لها كي تتحرّر؟

127
00:10:04,970 --> 00:10:08,140
أطفال قرية هيغاشي الحاليّون
لا يعرفون سرَّ التّوأمين

128
00:10:08,140 --> 00:10:11,670
لا يعلمون بأنّ آسا-تشان ويورو
يكتسبان القوّة بالموت

129
00:10:11,920 --> 00:10:14,750
لا يُسمَح لأهل القرية بمعرفة السّرّ

130
00:10:14,750 --> 00:10:17,390
إلّا حالما ينضجون ويُقبَلون كبالغين كاملين

131
00:10:17,390 --> 00:10:19,760
لا تعرف أزامي شيئاً بعد

132
00:10:20,210 --> 00:10:22,530
إنّهم يتشاركون السّرّ إذاً

133
00:10:22,530 --> 00:10:26,990
ومعرفة هذا يجعلك عضواً ناضجاً من أعضاء القرية

134
00:10:26,990 --> 00:10:31,270
يخلقون نوعاً من التّضامُن بجعل
النّاس يشعرون أنفسهم مُميّزين

135
00:10:32,680 --> 00:10:37,440
ماذا يحدث للشّخص الّذي يعلم
بالسّرّ ويُشكِّك في الأمر؟

136
00:10:37,700 --> 00:10:42,550
أيّ شخص يعترض على أساليب القرية
"يُرسَل إلى أسفل الجبل لـ"العمل

137
00:10:42,950 --> 00:10:48,050
يوفّرون قوت يومهم من خِلال إتمام بقايا
الأعمال الّتي يحصلون عليها من شُركاء القرية

138
00:10:48,050 --> 00:10:49,700
مهلاً لحظة

139
00:10:50,060 --> 00:10:54,200
سبب عدم عودة الأشخاص الّذين غادروا
...القرية بداعي العمل أبداً هو

140
00:10:54,200 --> 00:10:57,960
هو لأنّهم سيكشفون سرَّ القرية ليورو إن فعلوا

141
00:10:58,230 --> 00:11:03,590
...بعض النّاس ينزلون إلى هنا للعمل فعلاً

142
00:11:06,380 --> 00:11:09,200
لكن ينتهي المطاف بقتلِ
عشيرة كاغيموري لهم

143
00:11:09,920 --> 00:11:13,180
كلانا مُذنبان. جماعتنا كانت
تُقتَل بواسطتكم أيضاً

144
00:11:13,520 --> 00:11:17,170
لا سيّما التّاديرا. مرّات عديدة

145
00:11:32,780 --> 00:11:34,680
أهلاً بعودتكما

146
00:11:34,680 --> 00:11:35,680
شكراً

147
00:11:35,680 --> 00:11:38,130
انتهينا هنا. شكراً

148
00:11:41,050 --> 00:11:46,100
مولايّ، أرغب في أخذ أخي إلى القصر
لمُعالجة جرحه

149
00:11:46,100 --> 00:11:48,190
!لم أقل بأنّني أريد الذّهاب

150
00:11:48,190 --> 00:11:52,350
آسف يا آسا. عليّ التّعامُل مع آكيو
عندما أعود

151
00:11:52,350 --> 00:11:55,440
لا أريد أن يرى يورو-كن ذلك

152
00:11:55,440 --> 00:11:58,180
...بالمُناسبة. آكيو-سان

153
00:11:58,180 --> 00:12:01,940
آكيو؟ أذلك هو الرّجل الأقرع
الّذي أرادَني ميّتاً؟

154
00:12:01,940 --> 00:12:05,100
قبضنا على الخائن في القصر قبل مدّة

155
00:12:05,100 --> 00:12:06,920
كان آكيو في نهاية المطاف

156
00:12:06,920 --> 00:12:09,820
إذاً كان جين على حقّ

157
00:12:10,630 --> 00:12:17,380
لكن لم يذكر خالي أيّ ارتباط بآكيو

158
00:12:18,060 --> 00:12:20,390
،في اللّيلة الّتي أتى فيها يورو-كن إلى القصر

159
00:12:20,390 --> 00:12:24,900
كان خالي من أخبرَني بأنّ التّوأمين سيكونان هناك

160
00:12:25,340 --> 00:12:28,330
،قال بأنّ إيفان من نقلَ المعلومة له

161
00:12:28,330 --> 00:12:31,410
،وبأنّه كان يُرسل بعض المُرتزقة الّذين جمعَهم

162
00:12:31,410 --> 00:12:34,180
لذا يجدر بي أن أخون العشيرة
وأُساهم في القبض على التّوأمين

163
00:12:35,300 --> 00:12:39,190
تجاهلتُ رسالتَه وتظاهرتُ بأنّني نائم

164
00:12:39,190 --> 00:12:40,530
تركتَه بلا ردّ؟

165
00:12:40,950 --> 00:12:45,910
ما يعني بأنّ آكيو كان مُرتبطاً بإيفان؟

166
00:12:45,910 --> 00:12:47,240
إيفان

167
00:12:47,240 --> 00:12:51,310
يعلم بأمر والدَينا

168
00:12:51,660 --> 00:12:54,310
هذا يعني أنّ آكيو قد يعلم شيئاً أيضاً، صحيح؟

169
00:12:56,060 --> 00:12:57,240
مولايّ

170
00:12:58,780 --> 00:13:00,930
ينبغي أن نعود إلى القصر فوراً

171
00:13:00,930 --> 00:13:05,490
ونستخرج معلومات من آكيو وإله الجبل

172
00:13:21,490 --> 00:13:23,950
!الأستوديو الخاصّ بي

173
00:13:24,170 --> 00:13:26,820
!حاسوبي! بياناتي! مسودّاتي

174
00:13:26,820 --> 00:13:30,900
.آسفة يا سينسي-تشان
اشتبكنا في معركة

175
00:13:31,980 --> 00:13:35,710
أعلم بأنّنا حطّمنا الكثير، لكن
صانِعة القهوة خاصّتك قد نجتْ

176
00:13:37,310 --> 00:13:38,870
أتريد بعضاً؟

177
00:13:38,870 --> 00:13:43,970
آمل أن تتحوّل كُلّ القهوة الّتي تشربينها
!إلى حبر لبقيّة حياتكِ

178
00:13:44,230 --> 00:13:45,830
ماذا عن بياناتي؟

179
00:13:46,190 --> 00:13:47,640
إنّها آمنة. جيّد

180
00:13:48,250 --> 00:13:51,890
حتّى لو فقدتها، يمكنك استخدام أسود
وأبيض لرسمها ثانية بلمح البصر

181
00:13:52,750 --> 00:13:54,840
أنتِ لا تفهمين الامر

182
00:13:54,840 --> 00:13:58,000
عيوب الرّسم باليد هي ما يجعل الرّسوم جميلة

183
00:13:58,000 --> 00:14:00,000
أحقّاً ذلك؟

184
00:14:00,000 --> 00:14:02,770
أليس من الأجمل أن يكون كُلّ
شيء جميلاً وواضحاً؟

185
00:14:03,280 --> 00:14:05,640
قلوب النّاس سواسية

186
00:14:05,640 --> 00:14:09,110
إنّها إحدى الأشياء الّتي أعيرها اهتماماً
عند تصميم شخصيّات في أعمالي

187
00:14:09,540 --> 00:14:12,860
العيوب والنّقص هي ما يجعل
النّاسَ أكثر إنسانيّة

188
00:14:14,380 --> 00:14:17,080
!جين-سان! جين-سان، أرجوك

189
00:14:17,080 --> 00:14:19,620
ألا يمكنك إنقاذ آكيو؟

190
00:14:19,620 --> 00:14:23,790
لا. لن يغفر مولانا للخائن أبداً

191
00:14:23,790 --> 00:14:25,640
آكيو سيموت

192
00:14:25,640 --> 00:14:27,840
كنّا معاً منذ طفولتنا

193
00:14:27,840 --> 00:14:30,510
لسنا مُرتبطين بالدّم، لكنّنا أخوان

194
00:14:30,510 --> 00:14:33,360
لم يكن يصغي لي أبداً

195
00:14:33,360 --> 00:14:35,350
—لكنّك ابنه، يمكنك أن

196
00:14:35,350 --> 00:14:36,110
هارو

197
00:14:37,070 --> 00:14:42,030
الحِفاظ على عناصر شديدة الخطورة
حولنا يُعرّض أرواحنا لخطر

198
00:14:43,770 --> 00:14:46,310
لا يمكننا السّماح لآكيو بالبقاء حيّاً

199
00:14:50,530 --> 00:14:53,790
لا أستطيع تثبيت ذِراع مبتورة

200
00:14:54,440 --> 00:14:56,080
،أوقفتُ النّزيف

201
00:14:56,080 --> 00:14:58,790
لكن إذا أردتُم الحِفاظ عليها، فيجدر
بكم أن تنقلوه إلى مشفى

202
00:15:02,590 --> 00:15:06,170
لا أُصدِّق بأنّ أخي كان الخائن

203
00:15:08,070 --> 00:15:09,840
هذا سيّئ

204
00:15:10,640 --> 00:15:14,470
قد يكون هناك المزيد من الخوَنة في القصر

205
00:15:14,470 --> 00:15:19,590
الجميع سلّموا بالفعل معلوماتهم للقائمة
السّوداء الخاصّة بفويوكي

206
00:15:19,590 --> 00:15:22,400
،بما أنّ شكّنا بك قد ازداد

207
00:15:22,400 --> 00:15:27,290
تفقّدنا جميع مَن يعملون في القصر
بواسطة القائمة السّوداء

208
00:15:28,740 --> 00:15:32,370
آكيو، كنتَ المُتبقّي الوحيد

209
00:15:33,650 --> 00:15:36,070
ساكورازاوا-سينسي، هل تفقّدوكِ أيضاً؟

210
00:15:36,070 --> 00:15:38,500
أجل. ليس لديّ ما أُخفيه

211
00:15:41,430 --> 00:15:43,300
لماذا خنتَنا؟

212
00:15:43,950 --> 00:15:48,560
تعلم بأنّ مولانا لا يرحم الأعداء والخوَنة

213
00:15:48,560 --> 00:15:51,960
حالما يعود، سينتزع معلوماتك ويقتلك

214
00:15:52,270 --> 00:15:54,720
ولا حتّى أشقاءك يستطيعون حمايتك

215
00:15:54,720 --> 00:15:57,310
لم تكن سعيداً بالعمل لحساب الكاغيموري؟

216
00:15:57,310 --> 00:16:00,570
لا يروقني العمل الإجراميّ الّذي
نُمارسه هنا أيضاً

217
00:16:00,570 --> 00:16:03,230
في الواقع، ليتني أستطيع الاستقالة

218
00:16:03,560 --> 00:16:07,510
!لكن لا أكره شُركائي لدرجة الغدر بهم

219
00:16:11,610 --> 00:16:14,380
لماذا يا آكيو؟

220
00:16:19,890 --> 00:16:22,450
تعرفين طبيعة جسدي

221
00:16:22,830 --> 00:16:26,780
وُلِدتُ دون القدرة على الشُّعور بالألم

222
00:16:27,830 --> 00:16:30,920
بينما كنتُ طفلاً، جعلَني هذا لا أُقهَر

223
00:16:31,850 --> 00:16:36,840
لم تكن لديّ حدود جسديّة، لذا كنتُ
أربح في كُلّ معركة في النّهاية

224
00:16:37,190 --> 00:16:40,950
،مثلما لم أستطع الشُّعور بألمي
كذلك لم أكن أفهم آلامَ الآخرين

225
00:16:42,270 --> 00:16:46,880
أنا مُمتنّ للكاغيموري لرعاية واستئجار
شخص خطير مثلي

226
00:16:47,510 --> 00:16:53,360
،لو أُطلِقَ عناني في هذا العالم
لأعدمَني هذا البلد الآن

227
00:16:54,450 --> 00:16:58,500
كان من السّهل العيش مع الكاغيموري
لأنّ الجميع هنا مجانين

228
00:16:59,200 --> 00:17:02,420
،كافّة التسوغاي غريبو أطوار
لذا لم أشعر بملل أبداً

229
00:17:04,310 --> 00:17:08,660
وحتّى أنّني وجدتُ عائلتي في يتامى آخرين

230
00:17:09,670 --> 00:17:11,880
كان ذلك مُمتعاً على ما أعتقد

231
00:17:13,480 --> 00:17:16,210
لكن مع ذلك كانت هناك مُشكلة ما

232
00:17:17,380 --> 00:17:24,210
ثمّة شيء ينمو في أخمص قدمي يوماً بعد يوم

233
00:17:25,700 --> 00:17:28,970
في مرحلة ما، بدأتُ أبحث عن أشخاص
مثلي عبر الإنترنت

234
00:17:29,500 --> 00:17:34,590
وجدتُ جماعة من النّاس لا يشعرون بالألم أيضاً

235
00:17:36,400 --> 00:17:41,110
من بينهم، وجدتُ شخصاً قد يكون أحد والدَي

236
00:17:42,630 --> 00:17:45,620
شعرتُ بعاطِفة لم تُراودني من قبل

237
00:17:47,680 --> 00:17:50,290
هل تواصلت معه؟

238
00:17:52,270 --> 00:17:55,510
هل زرع أفكاراً في رأسك؟

239
00:17:56,800 --> 00:17:59,870
!آكيو، والداك قد تخلّيا عنك

240
00:17:59,870 --> 00:18:02,810
ما الجدوى من رؤيتهما الآن؟
ما الّذي ستفعله أصلاً؟

241
00:18:02,800 --> 00:18:05,260
!لعلّهما يُحاولان استغلالك

242
00:18:05,260 --> 00:18:07,720
ناتسكي-ني، لديّ طلب

243
00:18:08,630 --> 00:18:11,320
دعي إله الجبل يُغادران

244
00:18:11,320 --> 00:18:13,750
ماذا؟ لن نفعل هذا

245
00:18:13,750 --> 00:18:15,480
سينتزع فويوكي معلوماتهما

246
00:18:15,810 --> 00:18:20,910
من فضلكِ. إله الجبل سيتحطّمان. سيموتان

247
00:18:20,910 --> 00:18:23,490
يتحطّمان؟ بواسطة مَن؟

248
00:18:23,490 --> 00:18:25,910
العقد بينكما قد فُسِخ

249
00:18:25,910 --> 00:18:28,970
لن يؤذيهما أحدٌ في القصر

250
00:18:28,970 --> 00:18:31,250
عمّاذا تتكلّم يا آكيو؟

251
00:18:36,260 --> 00:18:37,510
!ها هما

252
00:18:41,010 --> 00:18:44,880
جيّد. إله الجبل سَليمان

253
00:18:46,440 --> 00:18:51,110
آسف، لكن سنُسلّمكما لفويوكي للاستجواب

254
00:18:51,850 --> 00:18:53,940
حسناً

255
00:19:06,830 --> 00:19:08,080
...إنّهما

256
00:19:48,940 --> 00:19:51,640
هذا مُؤلم. سوف أنهض

257
00:19:53,130 --> 00:19:54,970
هل أنتما بخير؟

258
00:19:56,620 --> 00:19:59,050
فهمت. هذا جيّد

259
00:19:59,510 --> 00:20:00,890
...مُؤلم

260
00:20:01,400 --> 00:20:04,120
إنّها مكسورة. لا أستطيع المشي

261
00:20:06,990 --> 00:20:09,870
ياماكازي مُحطَّم

262
00:20:12,790 --> 00:20:15,370
!تانيكازي قد اختفى

263
00:21:00,940 --> 00:21:03,740
شيء ما انفجر عند البوّابة الرّئيسيّة

264
00:21:03,740 --> 00:21:05,030
هل حدث شيء هناك؟

265
00:21:05,530 --> 00:21:07,280
ليس حاليّاً

266
00:21:07,680 --> 00:21:10,120
سنستمرّ في الانتظار في العيادة

267
00:21:10,670 --> 00:21:12,610
هل كان هجوم تسوغاي؟

268
00:21:12,610 --> 00:21:13,870
لا نعلم بعد

269
00:21:14,200 --> 00:21:17,130
هذا القصر غير مُلائم في أوقات كهذه

270
00:21:17,130 --> 00:21:22,230
هناك الكثير من التسوغاي، لا يمكننا أن نعرف
فور دخول غُرباء

271
00:21:27,510 --> 00:21:29,430
تانيكازي؟

272
00:21:29,920 --> 00:21:33,040
ماذا يفعل أثرهما هنا؟

273
00:21:47,270 --> 00:21:51,490
!رِفاق، انخفِضوا

274
00:23:27,910 --> 00:23:30,420
حميا سيّدهما

275
00:23:30,420 --> 00:23:33,890
.التسوغاي والبشر على مُتشابِهان"
"لا يمكن لطرف أن يعيش لوحده

276
00:23:33,890 --> 00:23:36,920
أن تتعرّض لخيانة بواسطة شخص
مُقرّب منك مُؤلم