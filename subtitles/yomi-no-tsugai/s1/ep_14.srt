1
00:01:32,470 --> 00:01:34,150
عُدت

2
00:01:34,520 --> 00:01:37,850
أهلاً بعودتكِ. هل انتهيتِ من العمل؟

3
00:01:37,850 --> 00:01:39,530
أنا جائعة

4
00:01:41,220 --> 00:01:42,530
أين يورو-كن؟

5
00:01:42,530 --> 00:01:46,300
غادر للبحث عن مكانٍ هادئ للتّمرين

6
00:01:46,300 --> 00:01:48,280
كين ويمين ويسار ذهبوا معه

7
00:01:48,280 --> 00:01:52,330
ماذا؟ ألا تعتقد بأنّه قُبِض عليه ثانية؟

8
00:01:52,330 --> 00:01:54,510
كوتيتسو معهم أيضاً

9
00:01:57,050 --> 00:01:58,260
هكذا إذاً

10
00:01:58,520 --> 00:02:00,660
كيف كان الشّامانيّ؟

11
00:02:00,660 --> 00:02:03,430
كان دفنه شاقّاً بما أنّه ضخم

12
00:02:03,430 --> 00:02:06,350
من قتله؟ الكاغيموري؟

13
00:02:06,350 --> 00:02:11,230
لا أعلم من قتله أو سبب قيامه بذلك

14
00:02:11,510 --> 00:02:13,850
من طلب منكِ دفنه؟

15
00:02:13,850 --> 00:02:15,350
"قُطّاع الطّرُق"

16
00:02:15,350 --> 00:02:16,620
وهل قالوا شيئاً؟

17
00:02:16,620 --> 00:02:21,200
لا شيء. كان ميّتاً بالفعل
عندما دخلوا محلَّه

18
00:02:21,200 --> 00:02:23,870
أتعتقدين بأنّ الأمر مُرتبط بيورو؟

19
00:02:23,870 --> 00:02:28,080
لستُ متأكّدة. آمل ألّا يُسبّب
هذا الأمر المتاعبَ فحسب

20
00:02:30,100 --> 00:02:35,060
هل هذه المُكوّنات الّتي حضّرتُها
للقِدر السّاخن اللّيلة الماضية؟

21
00:02:35,060 --> 00:02:36,250
لم تأكلها؟

22
00:02:36,250 --> 00:02:39,950
لا. ارتأينا أن نأكلها عند عودتكِ

23
00:02:39,950 --> 00:02:42,300
أكلنا بقايا بدلاً من ذلك

24
00:02:42,300 --> 00:02:45,510
لم تكونوا بحاجة لانتظاري

25
00:02:45,510 --> 00:02:51,140
قال يورو بأنّ القِدر السّاخن يُفترض
أن يؤكَل معاً كعائلة

26
00:02:56,730 --> 00:02:59,570
،الآن قد تذكّرت

27
00:02:59,570 --> 00:03:03,200
كانت هناك كلمات محفورة
في جسد الشّامانيّ

28
00:03:03,780 --> 00:03:06,340
في البدر المُقبل، في ساعة الخنزير البرّيّ"

29
00:03:06,340 --> 00:03:08,830
"تعال إلى مخزن فوجيموراياما

30
00:03:11,080 --> 00:03:14,590
"بحوزتي أختك المُزيّفة وطفلة من القرية

31
00:03:14,880 --> 00:03:17,130
كانت رسالة ليورو-كن

32
00:03:17,130 --> 00:03:22,070
أخبرني قُطّاع الطّرُق ألّا أخبرك أو أُخبر يورو-كن

33
00:03:24,920 --> 00:03:29,730
أتعتقد بأنّ من كتب تلك الرّسالة
يعلم بأمر والدَي يورو-كن؟

34
00:03:31,470 --> 00:03:35,690
لا أعلم. إذا كان لديه ميني-سان
،أو ناغيسا-سان

35
00:03:35,690 --> 00:03:38,990
فسيستخدمها كرهينة لاستدراج يورو

36
00:03:38,990 --> 00:03:40,140
...على الأقلّ

37
00:03:40,680 --> 00:03:44,420
لا أعتقد بأنّ والديه مُحتجزان
لدى كاتب تلك الّسالة

38
00:03:45,280 --> 00:03:49,630
لكن لعلّه يعلم شيئاً

39
00:03:50,950 --> 00:03:53,820
لا يمكنني إنكار ذلك

40
00:03:53,820 --> 00:03:56,220
حسناً، سئمتُ من التّفكير

41
00:03:56,220 --> 00:04:01,480
سأغسل يدَي من هذا، لذا
أترك الباقي عليك

42
00:04:03,770 --> 00:04:07,250
أمسى الأمر مُزعجاً للغاية

43
00:04:07,250 --> 00:04:08,710
ماذا سأفل؟

44
00:04:09,180 --> 00:04:12,030
متى تحين ساعة الخنزير البرّيّ
عند اكتمال القمر المُقبل؟

45
00:04:12,030 --> 00:04:14,850
حوالي العاشرة مساء في الرّابع
عشر من الشّهر الجاري

46
00:04:15,910 --> 00:04:20,350
،بالنّسبة لشخص لا يريد أن يتورّط
أجريتِ بحثكِ بالفعل

47
00:04:22,600 --> 00:04:26,650
لا أرى مكاناً نستطيع فيه
إطلاق السِّهام

48
00:04:26,650 --> 00:04:27,780
أجل

49
00:04:28,510 --> 00:04:30,920
هناك أشخاص في كلّ مكان

50
00:04:31,930 --> 00:04:36,040
ستكون كارثة إذا انحرفتْ طلقاتك

51
00:04:36,040 --> 00:04:38,990
هل ينبغي أن ندع تسوغاي
آسا يبتلعاننا ثانية؟

52
00:04:38,990 --> 00:04:40,160
لا

53
00:04:43,770 --> 00:04:46,130
انظر يا كين. تلك الأسماك ضخمة

54
00:04:46,430 --> 00:04:47,320
لنصطدها

55
00:04:47,320 --> 00:04:49,010
!لا يمكننا يا يورو-سان

56
00:04:49,370 --> 00:04:51,920
!انظر! صيد السّمك غير مسموح هنا

57
00:04:52,200 --> 00:04:54,850
يمكننا مُطاردتها إلى المياه
الضّحلة والإمساك بها

58
00:04:54,850 --> 00:04:56,520
!الأمر لا يتعلّق بالطّريقة

59
00:04:56,830 --> 00:05:00,000
أريد فقط أن أصطاد شيئاً لوضعه
في القِدر السّاخن لأجل هانا-سان

60
00:05:00,000 --> 00:05:02,190
!أسبابك غير مُهمّة

61
00:05:02,630 --> 00:05:06,690
هذا الشّخص لطيفٌ بصورة غريبة
بالنّسبة لهمجيّ

62
00:05:06,690 --> 00:05:11,280
لمَ لا يصطاد النّاسُ مصادرَ الطّعام هنا
وهي أمام أنظارهم؟

63
00:05:11,640 --> 00:05:14,400
انظر. من السّهل اصطيادهما

64
00:05:14,400 --> 00:05:17,450
لا يجوز لك أن تصطاد أيّ طائر
أو حيوان تُريد

65
00:05:17,450 --> 00:05:20,610
أعتقد بأنّ ديرا-سان ذكرَ شيئاً
عن رخصة الصّيد

66
00:05:20,610 --> 00:05:22,440
هذا هو القانون في هذا البلد

67
00:05:23,100 --> 00:05:26,910
لا أحد هنا في الأسفل يمشي
وبحوزته قوس أو ساطور

68
00:05:26,910 --> 00:05:29,860
كيف يُدافعون عن أنفسهم من الحيوانات والمُجرمين؟

69
00:05:29,860 --> 00:05:33,690
لدينا أأشخاص يُطلَق عليهم برجال
الشّرطة للدّفاع عن العامّة

70
00:05:34,480 --> 00:05:36,340
،أنا متأكّد بأنّك تعلم هذا
لكن هنا في الأسفل

71
00:05:36,720 --> 00:05:41,650
سيتمّ اعتقالك إذا قتلت شخصاً
سواء بسبب أو بدونه

72
00:05:41,970 --> 00:05:44,670
!ماذا؟

73
00:05:44,670 --> 00:05:45,830
معقول؟

74
00:05:46,150 --> 00:05:48,150
هل بدا ذلك واضحاً جدّاً؟

75
00:05:48,720 --> 00:05:52,880
ألم يُعلّم أحدٌ يورو-سان القواعد
الفطريّة الأساسيّة للحياة هنا؟

76
00:05:54,160 --> 00:05:57,690
لكن أيّ شخص يرتبط بقرية
هيغاشي فهو غير طبيعيّ

77
00:05:58,430 --> 00:06:01,340
يجب عليّ أن أصحّح مفاهيم يورو-سان

78
00:06:01,820 --> 00:06:03,960
!هذا غير منطقيّ

79
00:06:03,960 --> 00:06:07,630
يجدر بك أن تكون قادراً على الدّفاع
عن نفسك إذا حاول أحدٌ قتلك

80
00:06:08,660 --> 00:06:12,930
حتّى الدِّفاع عن النّفس جريمة
إذا بالغتَ في الأمر

81
00:06:15,590 --> 00:06:18,350
يورو، هناك تسوغاي قريبون

82
00:06:18,830 --> 00:06:19,650
هل هم عدائيّون؟

83
00:06:19,650 --> 00:06:20,680
لا أعلم

84
00:06:20,680 --> 00:06:25,100
،أسلحتي ليست جاهزة للقتال
لذا أحبّذ تجنُّب أي احتكاك غير ضروريّ

85
00:06:25,100 --> 00:06:26,740
ينبغي أن نُغادر

86
00:06:26,740 --> 00:06:28,520
حسناً

87
00:06:28,980 --> 00:06:31,160
قرار حكيم

88
00:06:51,340 --> 00:06:52,940
إنّهم يتبعوننا

89
00:06:53,480 --> 00:06:55,930
لاحظونا كذلك

90
00:06:57,560 --> 00:07:01,460
من هم؟ أصدقاء أم خصوم؟

91
00:07:05,370 --> 00:07:08,070
إنّهم مُتوجِّهون إلى منطقة معزولة

92
00:07:08,770 --> 00:07:10,400
هل لاحظونا؟

93
00:07:10,900 --> 00:07:12,510
وجدناهم أخيراً أيضاً

94
00:07:12,970 --> 00:07:14,690
لن يفلتوا

95
00:07:16,060 --> 00:07:19,600
من الواضح أنّهم يستهدفوننا

96
00:07:19,600 --> 00:07:21,240
هل يقصدون يورو-سان؟

97
00:07:23,140 --> 00:07:24,050
حسناً

98
00:07:28,040 --> 00:07:29,670
سنعترضهم هنا

99
00:07:29,670 --> 00:07:32,910
إن كانوا أعداء، فسيترتّب علينا
القِتال دون تمرين أوّلاً

100
00:07:32,910 --> 00:07:36,260
كين، قد لا أتمكّن من حمايتك

101
00:07:37,190 --> 00:07:39,060
سأبذل قصارى جهدي

102
00:07:39,060 --> 00:07:40,580
حسناً إذاً

103
00:07:40,580 --> 00:07:42,350
من هُم؟

104
00:07:51,220 --> 00:07:54,150
أنت سيّد والتسوغاي الخاصّان به، صحيح؟

105
00:07:57,010 --> 00:07:58,900
يرتديان الزيّ الأسود

106
00:07:59,280 --> 00:08:02,240
هل هُما من الكاغيموري؟
لا أشعر بأيّ تعطُّش للدماء

107
00:08:02,950 --> 00:08:04,090
...لا

108
00:08:04,090 --> 00:08:09,290
لكن ماذا لو غيّرتُ رأيي وحاولتُ قتلك؟

109
00:08:10,010 --> 00:08:11,350
ماذا تريدان؟

110
00:08:11,650 --> 00:08:14,090
اختارا كلماتكما بحرص

111
00:08:14,090 --> 00:08:15,370
لحظة، لحظة

112
00:08:15,370 --> 00:08:18,590
لا نقصد الأذى

113
00:08:18,590 --> 00:08:20,790
سنخلع لباسنا التنكُّريّ

114
00:08:21,290 --> 00:08:22,600
تنكُّريّ؟

115
00:08:22,600 --> 00:08:24,150
،عندما لا نُرافق سيّدنا

116
00:08:24,150 --> 00:08:28,030
فإنّه يتعرّض للتنمُّر أو يؤخذ
إلى مركز صحّي عامّ

117
00:08:28,380 --> 00:08:32,550
لذا تظاهرنا بأنّنا حيوان أليف ومالكاه

118
00:08:32,550 --> 00:08:37,320
نحن نسرق، أقصد، نستعير ملابسَ
وشعراً مُستعاراً للتّظاهر بأنّنا بشر

119
00:08:44,160 --> 00:08:46,900
هذا هو شكلنا الحقيقيّ

120
00:08:48,210 --> 00:08:51,940
أخافني ذلك. يبدوان مثل تيناغا-أشيناغا

121
00:08:51,940 --> 00:08:54,880
أو بالأحرى... إنّهما مخلوقان فضائيّان

122
00:08:54,880 --> 00:08:56,500
نحن تسوغاي

123
00:08:56,500 --> 00:09:00,320
الأشخاص الّذين يستطيعون رؤيتنا ينادوننا
دوماً بالمخلوقات الفضائيّة لسببٍ ما

124
00:09:00,320 --> 00:09:02,020
هذا وقحٌ جدّاً

125
00:09:02,020 --> 00:09:04,720
نحن تسوغاي قديمان بسيطان

126
00:09:04,720 --> 00:09:08,810
ماذا ينبغي أن نُناديكما؟

127
00:09:09,190 --> 00:09:11,560
...نحن

128
00:09:11,560 --> 00:09:12,680
!أنتما ماذا؟

129
00:09:12,680 --> 00:09:13,770
!لغة مخلوقات فضائيّة؟

130
00:09:13,770 --> 00:09:15,830
...ماذا

131
00:09:15,830 --> 00:09:18,620
هذا غير قابل للنّطق بواسطة البشر

132
00:09:18,620 --> 00:09:21,280
هكذا إذاً. فهمت الأمر

133
00:09:21,280 --> 00:09:24,450
!من الواضح أنّهما مخلوقان فضائيّان

134
00:09:26,400 --> 00:09:31,640
كنّا مُوقّرين بهدوء في نوتو
،منذ زمن بعيد

135
00:09:31,640 --> 00:09:34,460
لكن أصبحنا منسيّين في نهاية المطاف

136
00:09:34,460 --> 00:09:41,330
لم نعُد نتلقّى زُوّاراً واعتقدنا
،بأنّنا سوف نذبل

137
00:09:41,330 --> 00:09:44,100
حتّى صادفَنا كلبٌ ضالّ

138
00:09:45,020 --> 00:09:48,350
وأبرمنا عقداً

139
00:09:48,350 --> 00:09:51,860
ماذا؟ هذا الكلب هو سيّدكما؟

140
00:09:51,860 --> 00:09:52,880
أجل

141
00:09:52,880 --> 00:09:57,420
لذا نحن في مأزق لأنّنا لم نتلقّ
اسماً شخصيّاً بعد

142
00:09:57,420 --> 00:10:00,870
لا أُصدِّق بأنّ سيّدنا هو
كلبٌ من بين كلّ الأشياء

143
00:10:01,400 --> 00:10:06,030
هل أعرّفكما على شخص يستطيع
أن يفسخ عقدكما؟

144
00:10:06,030 --> 00:10:07,270
!لا

145
00:10:07,270 --> 00:10:09,250
!نُحبّ سيّدنا الحاليّ

146
00:10:09,250 --> 00:10:11,710
!لا بُدّ أنّكما تُحبّانه كثيراً

147
00:10:12,150 --> 00:10:16,590
يبدو أنّكما تسوغاي نستطيع التكلُّم معهما

148
00:10:16,930 --> 00:10:21,160
لا نعرف أي تسوغاي نستطيع
مُناقشة وضعنا معه

149
00:10:21,160 --> 00:10:24,350
هل ترغبان في أن تُصبحا صديقينا؟

150
00:10:24,350 --> 00:10:26,020
بالتّأكيد

151
00:10:26,020 --> 00:10:28,520
ما دمتُما لا تؤذيان سيّدنا

152
00:10:28,520 --> 00:10:29,930
!تسوغاي أصدقاء؟

153
00:10:29,930 --> 00:10:31,480
!بالطّبع لا

154
00:10:31,480 --> 00:10:34,850
عظيم! هلّا سألناكما عن اسميكما؟

155
00:10:34,850 --> 00:10:36,420
نحن يمين ويسار

156
00:10:36,960 --> 00:10:40,320
مُستحيل! أنتما يمين ويسار
من قرية هيغاشي؟

157
00:10:40,320 --> 00:10:42,330
!أنتما أسطورتان

158
00:10:42,780 --> 00:10:44,630
هل يمكننا مُصافحتكما؟

159
00:10:44,630 --> 00:10:46,370
!أنا مسرور جدّاً لأنّني حيّ

160
00:10:46,370 --> 00:10:48,680
!سيّدكما رائع أيضاً

161
00:10:49,060 --> 00:10:50,290
ما الّذي يجري هنا؟

162
00:10:51,710 --> 00:10:54,500
المعذرة، ما رأيكما أن ترتديا
ملابسكما من جديد؟

163
00:10:54,500 --> 00:10:56,160
تبدوان عاريين

164
00:10:56,160 --> 00:10:58,110
المعذرة

165
00:10:59,990 --> 00:11:04,630
على ذكر الأمر، تيناغا-أشيناغا
كانا يرتديان مِئزراً

166
00:11:05,030 --> 00:11:08,740
أعتقد كانا يعرفان أدنى مُستويات
آداب السّلوك

167
00:11:22,020 --> 00:11:25,440
أنباء سارّة. ها قد حصلنا
على مزيد من الأصدقاء

168
00:11:25,440 --> 00:11:26,290
ماذا؟

169
00:11:26,580 --> 00:11:31,240
!يمين ويسار

170
00:11:37,590 --> 00:11:38,890
أتيتُ إلى المدينة

171
00:11:39,330 --> 00:11:43,000
أوشيراساما. ماذا تفعلين هنا؟

172
00:11:43,000 --> 00:11:45,430
ظننتُ بأنّكِ كنتِ تنتظرين في الدّيار

173
00:11:45,730 --> 00:11:49,270
!أوشيراساما؟! أسطورة أُخرى

174
00:11:49,270 --> 00:11:51,360
!بريقها مُبهر

175
00:11:51,360 --> 00:11:52,060
دانجي؟

176
00:11:52,850 --> 00:11:57,170
...يورو؟ هذا مُطمئن

177
00:11:59,460 --> 00:12:00,600
...وجدتُك

178
00:12:01,370 --> 00:12:02,900
!دانجي

179
00:12:03,460 --> 00:12:05,090
ماذا تفعل هنا؟

180
00:12:05,540 --> 00:12:09,150
هوجمت القرية ثانية

181
00:12:09,470 --> 00:12:10,640
ثانية؟

182
00:12:11,670 --> 00:12:13,310
المكان في حالة فوضى

183
00:12:14,050 --> 00:12:15,540
ما الّذي يجري؟

184
00:12:15,880 --> 00:12:20,400
أنا هنا في الأسفل. لا حاجة
لمُهاجمة القرية بعد الآن

185
00:12:20,400 --> 00:12:23,370
لا أتصوّر بأنّ آسا فتحت
،الحاجزَ بالقوّة ثانية

186
00:12:24,440 --> 00:12:26,040
...ما يعني

187
00:12:27,250 --> 00:12:31,050
هوجِمتُم بواسطة شخص آخر هذه المرّة؟

188
00:12:31,050 --> 00:12:32,810
هذا ما أعتقده

189
00:12:33,240 --> 00:12:39,740
رأيتُه من بعيد فقط، لكن كان
رجلاً واحداً فقط يحمل سيفين

190
00:12:40,470 --> 00:12:42,680
قُتِلَ مجموعة من البالغين

191
00:12:43,270 --> 00:12:46,000
رُبّما قُضي على القرية

192
00:12:46,750 --> 00:12:50,700
طلبتْ منّي أُمّي أن أنزل الجبل وأحميك

193
00:12:51,230 --> 00:12:54,430
وجدَتْني أوشيراساما بعد أن غادرتُ القرية

194
00:12:55,500 --> 00:12:57,310
من طلبَ منك فعل ذلك؟

195
00:12:57,310 --> 00:12:58,380
ماذا؟

196
00:12:58,670 --> 00:13:00,620
أُمّي

197
00:13:00,620 --> 00:13:03,030
كنتُ قلقاً عليك أيضاً

198
00:13:02,430 --> 00:13:03,800
انتظر

199
00:13:03,800 --> 00:13:05,600
انتظر، انتظر، انتظر

200
00:13:05,600 --> 00:13:09,130
،قبل أن تقول أي كلمة إضافيّة
أحتاج للتحقُّق من شيء

201
00:13:11,360 --> 00:13:13,940
...دانجي، أنت

202
00:13:15,180 --> 00:13:16,480
أنت تسوغاي، أليس كذلك؟

203
00:13:19,900 --> 00:13:21,330
لست بشريّاً

204
00:13:29,970 --> 00:13:30,950
ماذا؟

205
00:13:35,550 --> 00:13:37,960
كيف عرفت؟

206
00:13:38,890 --> 00:13:40,960
لا ظلّ لديك

207
00:13:45,880 --> 00:13:52,370
يمين ويسار، كوتيتسو وجيرو، وكافّة
...التسوغاي الّذين التقيتُهم

208
00:13:52,370 --> 00:13:55,920
لا أحد منهم ينعكس ظلّه في الأرض

209
00:13:56,510 --> 00:14:00,480
الأشياء وسكّان هذا العالم
،ينعكس ظلُّهم

210
00:14:00,970 --> 00:14:05,270
بخلاف التسوغاي، أليس كذلك؟

211
00:14:08,860 --> 00:14:13,150
كنتَ تكذب عليّ أيضاً

212
00:14:18,660 --> 00:14:22,720
صدّقني. لدينا أظرف الفتيات

213
00:14:24,180 --> 00:14:27,130
جين-سان، هارو-سان

214
00:14:27,130 --> 00:14:28,680
تسرّني رؤيتكِ

215
00:14:28,680 --> 00:14:30,860
كيف حالكِ يا أوي-تشان؟

216
00:14:30,860 --> 00:14:33,180
شكراً على ذلك اليوم يا جين-سان

217
00:14:33,450 --> 00:14:36,590
توقّفَ ذلك المُلاحق عن الظُّهور

218
00:14:37,040 --> 00:14:38,350
يسرّني سماع ذلك

219
00:14:38,350 --> 00:14:41,590
كان مُصرّاً جدّاً أيضاً. ماذا فعلت له؟

220
00:14:41,590 --> 00:14:43,350
هل أبرحته ضرباً؟

221
00:14:43,860 --> 00:14:45,690
مُحال أن أفعل ذلك

222
00:14:45,690 --> 00:14:48,150
أطعمتُه سمكة فحسب

223
00:14:48,150 --> 00:14:51,650
بربّك يا جين-سان. هذا ليس طريفاً

224
00:14:51,650 --> 00:14:52,780
...على أيّ حال

225
00:14:52,780 --> 00:14:54,650
بالمُناسبة

226
00:14:54,650 --> 00:14:58,140
أتى رجلُ تاديرا ذاك، لذا رافقناه
كما طلبتَ فحسب

227
00:15:00,050 --> 00:15:02,370
بربّك يا رجل

228
00:15:02,640 --> 00:15:05,300
ما الّذي يجري هنا يا جين-سان؟

229
00:15:05,800 --> 00:15:11,290
لِمَ يتمّ اقتيادي إلى مكتب
بدلاً من حانة مع سيّدات؟

230
00:15:11,290 --> 00:15:13,380
ليس لدينا كحول نُقدّمها لك

231
00:15:14,640 --> 00:15:16,550
تفضّل بعض القهوة

232
00:15:18,370 --> 00:15:22,140
،لا يمكننا أن نُقدّم لك الكحول
لكن ينبغي أن نُقدّم لك اعتذاراً

233
00:15:22,550 --> 00:15:25,660
تعقّبَك بعضُ عُملائنا قبل أيّام

234
00:15:25,660 --> 00:15:28,650
صحيح. مجموعة المرأة العجوز والفراشة

235
00:15:29,210 --> 00:15:31,910
تمّ ذلك من دون مُوافقة عشيرة
كاغيموري الرّئيسيّة

236
00:15:31,910 --> 00:15:35,060
بالطّبع، لا تعلم آسا-سان بالأمر أيضاً

237
00:15:35,060 --> 00:15:37,430
نُفِّذَ ذلك بواسطة مجموعة من الأفراد

238
00:15:37,430 --> 00:15:38,900
أنا آسف

239
00:15:39,930 --> 00:15:42,240
أنت صادقٌ لأقصى الحدود

240
00:15:42,780 --> 00:15:48,060
لعلّنا ننتهك القانون، لكنّنا نعلم متى
نكون بحاجة كسب ثِقة شخص

241
00:15:48,560 --> 00:15:51,960
حسناً. أُصدِّقك

242
00:15:52,250 --> 00:15:55,470
أتيتَ اليوم لأنّ لديك معلومات
لمُشاركتها، أليس كذلك؟

243
00:15:55,470 --> 00:15:58,980
بخصوص ذلك. طرأتْ مُشكلةٌ ما

244
00:15:59,440 --> 00:16:00,890
وسوف تُساعدني

245
00:16:03,950 --> 00:16:05,730
ظلّي؟

246
00:16:05,730 --> 00:16:10,410
أستطيع إنشاء ظلّ إذا أردتُ ذلك

247
00:16:11,890 --> 00:16:15,820
أظنّني نسيتُ لأنّني كنتُ فرِحاً برؤيتك

248
00:16:16,160 --> 00:16:20,360
لعِبنا معاً منذ نعومة أظفارنا

249
00:16:20,360 --> 00:16:23,670
خدعتَني حقّاً

250
00:16:24,180 --> 00:16:27,950
خدعتَني لمدّة أطول ممّا فعلَتْ
آسا في زنزانتها

251
00:16:34,310 --> 00:16:38,030
إن كنتَ تسوغاي، فلا بُدّ أنّ لديك شريك

252
00:16:39,580 --> 00:16:42,690
شريكي هو شخصٌ تعرفه خير معرفة

253
00:16:44,680 --> 00:16:46,280
آسا المُزيّفة؟

254
00:16:47,810 --> 00:16:48,880
أجل

255
00:16:49,730 --> 00:16:53,790
آسا المُزيّفة وأنا تسوغاي فتى وفتاة

256
00:16:54,510 --> 00:16:56,910
أنا أبدو بهذا المظهر في الواقع

257
00:17:03,510 --> 00:17:06,890
اسمنا معاً زاشيكي-واراشي

258
00:17:10,750 --> 00:17:15,480
ماذا؟ جدّتي، أوشيراساما ليست هنا؟

259
00:17:15,480 --> 00:17:17,920
قالت بأنّها ذاهبة إلى طوكيو

260
00:17:17,920 --> 00:17:20,300
ماذا؟ كم هي محظوظة

261
00:17:20,690 --> 00:17:23,090
أخذتْ صديقاً معها

262
00:17:23,090 --> 00:17:26,630
كان ذلك الفتى زاشيكي-واراشي غالباً

263
00:17:26,630 --> 00:17:29,130
حقّاً؟ من أيّ منزل؟

264
00:17:29,550 --> 00:17:33,730
لا أدري. كان يعيش في كلّ أنحاء المكان

265
00:17:33,730 --> 00:17:38,650
إذا غادر زاشيكي-واراشي، هل
سينهار ذلك المنزل؟

266
00:17:38,650 --> 00:17:41,240
هذا ما قالوه

267
00:17:41,560 --> 00:17:46,750
لكن لا أعتقد بأنّ الأمور تسير هكذا

268
00:17:47,090 --> 00:17:49,420
أعتقد بأنّ أحد شريكَي زاشيكي-واراشي قد حزِنَ

269
00:17:49,420 --> 00:17:54,350
ووجد صعوبة في البقاء بعد أن
غرقت عائلةٌ في حالة فوضى

270
00:17:56,010 --> 00:17:59,510
ولم يُرِد سيّدهما غالباً أن يحزن أحدُهما

271
00:17:59,760 --> 00:18:06,610
في كلّ الأحوال فسخا عقدهما أو غادرا
منزلهما مع سيّدهما

272
00:18:07,820 --> 00:18:13,550
لا أريد لوم زاشيكي-واراشي على المُصيبة
الّتي نزلتْ على منزل

273
00:18:15,180 --> 00:18:17,270
أحقّاً يا يورو؟

274
00:18:17,600 --> 00:18:20,050
لاحظتَ بأنّه تسوغاي للتو؟

275
00:18:20,050 --> 00:18:21,580
للتو"؟"

276
00:18:21,580 --> 00:18:26,320
صحيح. كنتُما تُراقبانه من مدخل القرية

277
00:18:26,700 --> 00:18:29,780
كنتُما تعلمان بأنّه تسوغاي ولم تُخبراني؟

278
00:18:30,240 --> 00:18:31,750
كنتُما تكذبان عليّ أيضاً؟

279
00:18:31,750 --> 00:18:36,210
لكنّك كنتَ تتنزّه مع دانجي كُلّ يوم
دون مُبالاة لشيء

280
00:18:36,210 --> 00:18:40,830
افترضنا بأنّك تعلم

281
00:18:40,830 --> 00:18:46,110
لم نُدرك بأنّك لا تعلم بأنّ دانجي
كان تسوغاي

282
00:18:46,110 --> 00:18:47,370
آسفة

283
00:18:48,650 --> 00:18:52,600
لا، أنتما... مُحقّان

284
00:18:53,620 --> 00:18:55,140
آسف لأنّني شككتُ بكما

285
00:18:55,900 --> 00:18:57,500
هكذا إذاً

286
00:18:57,500 --> 00:19:03,200
لذا لم نرَ نصفك الآخر لأنّها
ظلّتْ مُحتجزة في تلك الزنزانة

287
00:19:03,470 --> 00:19:07,620
كنّا نعلم فقط بأنّها في القرية
لأنّنا شعرنا بها

288
00:19:10,770 --> 00:19:12,790
من هو سيّدكما؟

289
00:19:13,450 --> 00:19:19,790
من استخدمَ آسا المُزيّفة لإبقائي مُرتبطاً
بالقرية واستخدمك للتجسُّس عليّ؟

290
00:19:20,060 --> 00:19:24,130
التجسُّس عليك؟ الأمر ليس هكذا

291
00:19:24,860 --> 00:19:26,300
بالمُناسبة

292
00:19:26,850 --> 00:19:31,800
لطالما كنتَ تُخبرني بأن آخذك معي
عندما كنتُ أذهب إلى الجبال

293
00:19:32,600 --> 00:19:38,230
هل كنتَ تبحث عن فُرصة لقتلي
!كي تحصل على قوّة الختم؟

294
00:19:38,230 --> 00:19:39,150
!لا

295
00:19:39,420 --> 00:19:42,260
!هل أرسلتَ قُطّاع الطّرُق لاستهدافي أيضاً؟

296
00:19:42,260 --> 00:19:43,280
!لا

297
00:19:43,280 --> 00:19:46,980
!من هو سيّدك؟ من يعطيك الأوامر؟

298
00:19:47,490 --> 00:19:48,900
هل هي الجدّة ياماها؟

299
00:19:54,880 --> 00:19:56,000
لا

300
00:19:56,830 --> 00:20:01,090
سيّدي هو الشّخص الّذي أدعوه أُمّي

301
00:20:06,070 --> 00:20:07,610
كيوكا-سان؟

302
00:20:08,330 --> 00:20:13,530
أجل. طُلِبَ منّي مُناداتها بأمّي
بدلاً من سيّدتي

303
00:20:13,530 --> 00:20:16,940
لنبدو كأمٍّ وابنها

304
00:20:17,990 --> 00:20:21,570
أُمِرتُ بمُراقبتك

305
00:20:22,840 --> 00:20:27,740
شريكتي في الزّنزانة طُلِبَ منها
التّظاهر بأنّها آسا

306
00:20:28,310 --> 00:20:32,530
وحماية الجدّة ياماها إن لزمَ الأمر

307
00:20:34,200 --> 00:20:40,400
لطالما طُلِبَ منّي مُرافقتك
لحمايتك من قُطّاع الطّرُق

308
00:20:41,480 --> 00:20:46,270
قد لا تُصدّقني، لكنّها الحقيقة

309
00:20:48,190 --> 00:20:51,390
إذاً كانت كيوكا-سان تكذب عليّ أيضاً؟

310
00:20:52,280 --> 00:20:57,980
لم يعُد هناك من أستطيع الوثوق به في القرية

311
00:21:13,640 --> 00:21:15,790
...يمين ويسار، كين

312
00:21:16,460 --> 00:21:17,560
انتظروا هنا

313
00:21:18,120 --> 00:21:21,040
أريد أن أبقى لوحدي في الجبال
لبعض الوقت

314
00:21:21,560 --> 00:21:24,460
—إن هوجمتَ أثناء تواجدك بمُفردك

315
00:21:24,460 --> 00:21:28,050
يمين، دعني لوحدي لبعض الوقت

316
00:21:29,890 --> 00:21:32,780
حسنٌ إن كان هذا ما تُريده يا سيّدي

317
00:21:32,780 --> 00:21:37,230
سنفعل ما تطلبه، لكن حاول
ألّا تبتعد عن أنظارنا

318
00:23:27,900 --> 00:23:30,930
ما بين قُطّاع الطّرُق والوحوش
،والتّضاريس الغادرة

319
00:23:30,930 --> 00:23:34,230
،هناك مخاطر دائمة على حياتك في الجبال

320
00:23:34,230 --> 00:23:37,780
لذا تركيزي هو دوماً على البقاء