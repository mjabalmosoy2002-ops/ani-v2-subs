1
00:01:35,500 --> 00:01:38,780
أظنّني سأجرِّب هذا

2
00:01:41,440 --> 00:01:42,040
!انطلق

3
00:01:46,580 --> 00:01:48,920
!ماذا؟ يحتاج هذا بعض التّعديل

4
00:01:52,910 --> 00:01:56,340
غابي-تشان-سان، هل هناك
أي مُهاجمين عندكِ؟

5
00:01:56,340 --> 00:01:58,850
هاجمَني شيءٌ ما

6
00:01:59,280 --> 00:02:02,030
متى دخلتْ هذه الأشياء القصر؟

7
00:02:02,550 --> 00:02:04,850
يبدو أنّك تتعامل مع شيء ما أيضاً

8
00:02:04,860 --> 00:02:08,190
أجل. نُقاتل حاليّاً تسوغاي لم أرهما من قبل

9
00:02:08,610 --> 00:02:10,740
حسناً، تولّ أمرهما بسرعة

10
00:02:10,740 --> 00:02:13,070
أنا جريحٌ حاليّاً وحركتي مُقيّدة

11
00:02:13,070 --> 00:02:15,530
!ماذا؟! أنت عديم الجدوى

12
00:02:15,530 --> 00:02:18,610
!أليست آسا معك؟ من الأفضل أن تحميها

13
00:02:18,840 --> 00:02:21,860
يورو-سان والتسوغاي الخاصّان به يعتنون بنا

14
00:02:21,860 --> 00:02:23,790
أولئك الّذين أهانوني؟

15
00:02:23,790 --> 00:02:27,030
أولئك الأوغاد. ستكون بخير إذاً

16
00:02:27,440 --> 00:02:30,210
في هذه الحالة، يمكنني فعل ما يحلو لي، صحيح؟

17
00:02:30,520 --> 00:02:32,380
افعلي ما تشائين

18
00:02:32,380 --> 00:02:34,420
عُلِم

19
00:02:37,760 --> 00:02:38,540
ابتلِع

20
00:02:45,990 --> 00:02:47,420
أتعلم؟

21
00:02:47,890 --> 00:02:51,760
أشعر بتأنيب الضّمير إذا تركتُك بمفردك

22
00:02:52,620 --> 00:02:53,450
ابتلِع

23
00:03:10,460 --> 00:03:14,230
لحسن حظّك يا غابرييل. ستحصل على كثير
من الطّعام اللّيليّ الخفيفّ

24
00:03:15,060 --> 00:03:17,600
تبدو غابي-تشان-سان بخير

25
00:03:17,600 --> 00:03:20,620
جيّد. سأوقف هذين

26
00:03:21,250 --> 00:03:22,470
أيمكنكِ فعل ذلك؟

27
00:03:22,470 --> 00:03:24,220
إن فعلت، فهل يمكنني مُعانقتك؟

28
00:03:24,520 --> 00:03:26,470
لا. قد تكسرين أضلاعي

29
00:03:26,470 --> 00:03:29,740
آسفة إذا حطّمتُ القصر يا جين-سان

30
00:03:30,040 --> 00:03:33,240
سأتحمّل وُطْأة غضب السّيّد

31
00:03:33,240 --> 00:03:37,280
وأنا أيضاً آسف إذا حطّمتُ
القصر يا جين-سان

32
00:03:37,280 --> 00:03:39,360
يمكنك تحمُّل غضب السّيّد بنفسك

33
00:03:39,360 --> 00:03:41,710
!هذا تمييز واضح

34
00:03:44,330 --> 00:03:47,880
أخي، هلّا صرفت انتباه الأبيض؟

35
00:03:47,880 --> 00:03:48,940
لا تُملي عليّ ما يجب فعله

36
00:03:49,350 --> 00:03:50,410
لكن حسناً

37
00:04:01,130 --> 00:04:03,840
ماذا؟

38
00:04:08,820 --> 00:04:09,760
!آسا-سان؟

39
00:04:09,760 --> 00:04:10,890
!آسا-تشان؟

40
00:04:11,750 --> 00:04:13,160
اختفتْ

41
00:04:14,600 --> 00:04:17,040
أخوها أيضاً؟ ماذا فعل هذا الشّيء؟

42
00:04:18,280 --> 00:04:18,810
—إنّه يهرب

43
00:04:23,870 --> 00:04:28,380
لا أعرف ماذا حدث، لكن إذا كانا
،يستطيعان إخفاء النّاس

44
00:04:28,380 --> 00:04:32,250
فرُبّما يعرفان شيئاً عن والدَي آسا-تشان

45
00:04:36,500 --> 00:04:41,890
يمكنك الإضرار بالقصر، لكن لا تقتلهما
أو تقتل سيّدهما يا هارو

46
00:04:41,890 --> 00:04:43,470
حاضر

47
00:04:44,120 --> 00:04:47,220
هارو، نحن مُحاطون بتسوغاي العدوّ

48
00:04:48,380 --> 00:04:50,600
أريدك أن تتولّى أمرهم يا جين-سان

49
00:04:50,600 --> 00:04:51,670
!ماذا؟

50
00:04:51,670 --> 00:04:54,580
سأحمي هارو

51
00:04:54,580 --> 00:04:55,980
ماذا؟

52
00:04:57,960 --> 00:05:02,690
السّيّد، وناتسكي، وفويوكي لم يعودوا بعد

53
00:05:03,050 --> 00:05:04,590
أين هاغوري-سينسي؟

54
00:05:04,590 --> 00:05:06,680
نائم بعد إتمام عمل مُجهِد

55
00:05:06,680 --> 00:05:08,870
إذا أيقظته الآن، فسوف يقتلك

56
00:05:13,310 --> 00:05:15,320
لا إمدادات إذاً

57
00:05:16,750 --> 00:05:18,960
ما يعني بأنّنا يجب أن نبذل
قصارى جهدنا؟

58
00:05:19,460 --> 00:05:21,420
آي-تشان، ماكوتو-كن

59
00:05:23,410 --> 00:05:26,400
!أخي! أخي

60
00:05:26,400 --> 00:05:29,310
!جين-سان! هارو-سان

61
00:05:29,780 --> 00:05:31,680
!ساكورازاوا-سينسي

62
00:05:31,680 --> 00:05:34,300
!آي-تشان! ماكوتو-كن

63
00:05:34,710 --> 00:05:37,390
...سُلحفاة-تشان! أرنب-تشان

64
00:05:43,240 --> 00:05:44,600
...أنا وحيدة

65
00:05:56,910 --> 00:05:59,010
لستِ وحيدة

66
00:06:00,170 --> 00:06:01,670
التسوغاي الخاصّ بأخي؟

67
00:06:01,670 --> 00:06:04,380
أجل. أنا النّصف الأيمن

68
00:06:05,380 --> 00:06:07,600
الظّلام حالك على رؤية شيء

69
00:06:07,600 --> 00:06:11,500
،لا أستطيع رؤية شيء أيضاً
لكن أنا بجانبكِ

70
00:06:11,880 --> 00:06:14,850
على أيّ حال، هذا ظلامٌ دامس

71
00:06:14,850 --> 00:06:18,010
حتّى في قرية هيغاشي
لا يشتدّ الظّلامُ هكذا

72
00:06:18,460 --> 00:06:20,250
لا أستطيع حتّى رؤية ما هو أمامي

73
00:06:22,290 --> 00:06:24,840
أشتمّ رائحةَ عرق سيّئة

74
00:06:24,840 --> 00:06:26,770
هل تخشين الظّلام؟

75
00:06:33,120 --> 00:06:37,140
أكره الوحدة في الظّلام

76
00:06:38,610 --> 00:06:40,730
تبدين وكأنّكِ هنا

77
00:06:42,160 --> 00:06:44,810
لا تقلقي. أنا هنا بجانبكِ

78
00:06:44,810 --> 00:06:46,770
لستِ لوحدكِ

79
00:06:50,330 --> 00:06:52,050
!أخي

80
00:06:52,050 --> 00:06:55,640
أين أخي؟ هل هو في مكانٍ ما
داخل هذا الفضاء؟

81
00:06:56,190 --> 00:06:58,300
لا أشتمّ رائحته في الجوار

82
00:06:58,300 --> 00:07:02,890
ألست التسوغاي الخاصّ به؟
لماذا لا تُساعده؟

83
00:07:03,320 --> 00:07:07,610
يسار معه غالباً. سيتدبّران الأمر

84
00:07:08,050 --> 00:07:11,890
تبعتُكِ لأنّني أردتُ أن أتكلّم

85
00:07:11,890 --> 00:07:13,390
معي؟

86
00:07:14,070 --> 00:07:19,220
،عندما التقينا أوّل مرّة في القرية
هاجمتِني فجأة

87
00:07:19,880 --> 00:07:25,300
ولم تقولي أيّ كلمة لي
منذ وصلتُ إلى القصر

88
00:07:26,370 --> 00:07:30,240
تعلمين بأنّني عدوّكِ الطّبيعيّ، أليس كذلك؟

89
00:07:34,630 --> 00:07:40,710
عندما تصدّيتَ— لا، بل ألغيتَ...؟

90
00:07:40,710 --> 00:07:41,800
ألغيتُ؟

91
00:07:41,800 --> 00:07:45,110
آسفة. لا أعرف كيف أصِف الأمر

92
00:07:46,680 --> 00:07:47,870
أبطلتَ

93
00:07:48,250 --> 00:07:53,150
أجل، عندما أبطلتَ "كسر" خاصّتي، تذكّرت

94
00:07:53,150 --> 00:08:00,170
قال أبي بأنّ يسار ويمين يستطيعان إيقاف
كسر وختم من الخروج عن السّيطرة

95
00:08:00,170 --> 00:08:03,030
إذاً هذا يُسهّل الأمور

96
00:08:04,040 --> 00:08:06,550
أنا عدوّكِ الطّبيعيّ

97
00:08:06,550 --> 00:08:09,390
سررتُ بلقائكِ يا آسا

98
00:08:09,390 --> 00:08:15,130
ما يعني بأنّه إذا كان أخي
،يكتسب قوّةَ الختم

99
00:08:15,880 --> 00:08:19,010
فسوف تصبح هي عدوّته الطّبيعيّة

100
00:08:21,960 --> 00:08:23,660
أنتِ هنا يا يسار؟

101
00:08:24,210 --> 00:08:27,440
هذا الفضاء فارغٌ تماماً

102
00:08:27,770 --> 00:08:30,550
ما هذا المكان أصلاً؟

103
00:08:30,550 --> 00:08:31,760
لا أدري

104
00:08:31,760 --> 00:08:35,780
عشتُ فترة طويلة، لكن لم
أرَ شيئاً كهذا من قبل

105
00:08:36,740 --> 00:08:39,320
،يبدو أنّ هناك أرضيّة

106
00:08:39,320 --> 00:08:42,450
لكن هذا اللّون الأبيض البرّاق
يُفقدني الإحساسَ بالتّوازُن

107
00:08:42,450 --> 00:08:46,180
،أثناء التّحليق قبل قليل
اصطدمتُ بـ... سقف؟

108
00:08:46,180 --> 00:08:47,840
فوقنا

109
00:08:48,150 --> 00:08:54,320
يبدو وكأنّنا داخل حاجز كُرويّ
من صنع ذلكما التسوغاي

110
00:08:54,320 --> 00:08:56,540
هذا حاجز؟

111
00:08:59,290 --> 00:09:01,390
هل من أعداء حولنا؟

112
00:09:01,390 --> 00:09:04,750
لا أشعر أو أشمّ رائحة أحد بجانبنا

113
00:09:05,540 --> 00:09:09,420
حسناً. ساعديني في ضبط
تصويبي يا يسار

114
00:09:09,420 --> 00:09:10,800
الآن؟ هنا؟

115
00:09:11,190 --> 00:09:15,800
لا أعرف ما يجري، لكن لا أُريد
إضاعةَ الوقت

116
00:09:15,800 --> 00:09:20,470
أخبرني أبي أن أُبقي أدواتي
بأحسن حال دوماً

117
00:09:20,470 --> 00:09:22,410
وذلك كي أكون مُستعدّاً للقتال في أيّ وقت

118
00:09:22,410 --> 00:09:25,910
ألا يُخيفك هذا الوضع المُربِك؟

119
00:09:26,540 --> 00:09:28,210
يُخيفني؟

120
00:09:28,210 --> 00:09:32,380
لا شيء منطقيّ منذ هوجِمت القرية

121
00:09:33,140 --> 00:09:36,950
اعتدتُ على أن يُشوّشني كلُّ شيء

122
00:09:37,760 --> 00:09:38,850
فتى مسكين

123
00:09:46,430 --> 00:09:47,660
سيكون هدفي

124
00:09:48,070 --> 00:09:49,320
هكذا؟

125
00:09:49,320 --> 00:09:50,240
أجل

126
00:09:58,690 --> 00:10:00,600
!حاولي مُراوغته

127
00:10:00,600 --> 00:10:04,330
لكن حينئذ سأضطرّ للذّهاب
والاتقاط السِّهام

128
00:10:04,330 --> 00:10:05,940
...أجل، لكن مع ذلك

129
00:10:05,940 --> 00:10:09,960
كما قلت، أنا مُكوَّنة من حجر. لا تقلق

130
00:10:11,700 --> 00:10:13,020
!أنا آسف

131
00:10:13,330 --> 00:10:15,520
ثمّة أمر غير طبيعيّ

132
00:10:16,090 --> 00:10:18,680
ألا ينبغي أن تقلق على أختك؟

133
00:10:18,680 --> 00:10:20,500
ماذا؟ هي؟

134
00:10:20,500 --> 00:10:24,900
تمّ ابتلاعها بواسطة الحاجز الأسود
في نفس الوقت الّذي ابتُلِعنا فيه

135
00:10:24,900 --> 00:10:28,180
ألا تمتلك هي قوّةَ الكسر؟

136
00:10:28,670 --> 00:10:31,780
إن كانت هذه حواجز، فلا شيء
يدعو للقلق

137
00:10:38,920 --> 00:10:40,370
ما الأمر يا سُلحفاة-تشان؟

138
00:10:47,210 --> 00:10:48,910
!خرجنا

139
00:10:49,250 --> 00:10:52,250
كان ذلك حاجزهما إذاً

140
00:10:52,910 --> 00:10:54,920
أهلاً بعودتكِ يا آسا

141
00:10:55,240 --> 00:10:56,600
شكراً

142
00:10:57,490 --> 00:10:58,630
...والآن

143
00:10:58,980 --> 00:11:03,140
سأكسر عقدكما مع سيّدكما الحاليّ

144
00:11:12,370 --> 00:11:13,140
آسا

145
00:11:14,240 --> 00:11:17,900
تمسّكتِ بهذا بعد أن اشتكيتِ
بأنّها غير صحّيّة؟

146
00:11:18,680 --> 00:11:20,710
آسفة لكونه دماً قديماً

147
00:11:26,050 --> 00:11:27,750
ستحصلان على سيّدٍ جديد

148
00:11:32,750 --> 00:11:35,410
والآن، سأكون أنا سيّدتكما

149
00:11:37,640 --> 00:11:40,980
إنّهما ودودان للغاية

150
00:11:41,620 --> 00:11:43,760
أتساءل ما اسمهما

151
00:11:44,240 --> 00:11:45,590
ابقيا مُطيعين

152
00:11:46,480 --> 00:11:49,510
سنقضي بعضَ الوقتِ معاً

153
00:11:50,240 --> 00:11:52,350
أحتاجكما لفعل شيء لأجلي حالاً

154
00:11:52,350 --> 00:11:54,750
هل ابتلعتُما أخي؟

155
00:11:57,370 --> 00:11:58,930
!ابصقاه! ابصقاه

156
00:11:58,930 --> 00:12:00,690
!ابصقاه حالاً

157
00:12:06,960 --> 00:12:08,060
!خرجا

158
00:12:08,060 --> 00:12:09,290
!أخي

159
00:12:12,570 --> 00:12:15,070
!لحظة، لحظة! إنّهما في صفّنا الآن

160
00:12:15,070 --> 00:12:16,030
!اشرحي

161
00:12:16,030 --> 00:12:17,240
...ماذا؟ في الواقع

162
00:12:17,240 --> 00:12:21,530
التسوغاي اللّذان حبسانا داخل ذلك
الفضاء الغريب هُما في صفِّنا الآن

163
00:12:21,530 --> 00:12:24,410
بما أنّهما يستطيعان إخفاء
،الأشخاص فوراً

164
00:12:24,410 --> 00:12:28,210
فإنّ سيّدهما قد يعرف شيئاً
عن والدَي آسا-تشان

165
00:12:29,900 --> 00:12:32,550
لذا سوف نذهب للقبض عليه

166
00:12:33,010 --> 00:12:34,980
حسناً. كيف؟

167
00:12:36,470 --> 00:12:38,200
لديّ طلبٌ آخر

168
00:12:39,420 --> 00:12:43,560
هلّا أخبرتُماني عن سيّدكما السّابق؟

169
00:12:45,560 --> 00:12:48,580
تطلب من التسوغاي الغدر بسيّدهما السّابق

170
00:12:49,060 --> 00:12:52,160
مُراهِقو هذه الأيّام مُخيفون حقّاً

171
00:12:58,200 --> 00:13:00,340
بجدّيّة؟ يا لها من قدرة خارقة

172
00:13:00,340 --> 00:13:04,590
لا أُصدّق بأنّ ذلكما الغبيّين
خاناني بهذه السّهولة

173
00:13:04,590 --> 00:13:06,990
—أين هو؟ المكان مُظلمٌ جدّاً

174
00:13:09,230 --> 00:13:10,930
اقبض عليه يا يمين

175
00:13:10,930 --> 00:13:12,580
عُلِم

176
00:13:12,580 --> 00:13:13,390
حسناً

177
00:13:13,610 --> 00:13:15,320
على مَن سنقبض أيضاً؟

178
00:13:15,320 --> 00:13:18,580
تمكّنتُ من رؤية مدى روعة
أخي بشكلٍ شخصيّ

179
00:13:18,580 --> 00:13:20,450
!أنا مسرورة جدّاً لأنّني على قيد الحياة

180
00:13:25,240 --> 00:13:26,350
جين-سان

181
00:13:27,300 --> 00:13:29,430
أعتذر على هذه الجلبة

182
00:13:29,430 --> 00:13:34,380
ينبغي لغير المُقاتلين أن يبقوا مُختبئين
في مكانٍ آمن ريثما نتولّى زِمام الأمر

183
00:13:36,350 --> 00:13:38,090
!حاضر

184
00:13:40,910 --> 00:13:43,710
حسناً. واصل المشي

185
00:13:43,710 --> 00:13:45,260
سنسحقك من الأسفل

186
00:14:05,060 --> 00:14:07,350
حسناً، أُنجِزَ العمل

187
00:14:10,580 --> 00:14:13,040
لا أعرفه أيضاً

188
00:14:13,370 --> 00:14:15,480
أحسنت صنعاً يا جين-تشان

189
00:14:15,790 --> 00:14:20,880
قتلتُ حوالي خمس مجموعات من الضُّعفاء
ولم أعرف أحداً منهم

190
00:14:21,210 --> 00:14:23,100
لم يكن أيّاً منهم قويّاً على وجه الخصوص

191
00:14:23,100 --> 00:14:24,380
صحيح؟

192
00:14:30,030 --> 00:14:31,540
شخص آخر غريب

193
00:14:31,960 --> 00:14:36,230
مُؤلم! طقم الأسنان ذاك نالَ
!من التسوغاي الخاصّين بي

194
00:14:36,230 --> 00:14:37,800
!أستسلم

195
00:14:37,800 --> 00:14:39,860
سهم؟

196
00:14:40,590 --> 00:14:42,280
أخو آسا؟

197
00:14:44,040 --> 00:14:46,290
من أين يرمي؟

198
00:14:59,370 --> 00:15:01,580
هذا مُخيف

199
00:15:01,570 --> 00:15:06,280
لو واجهتُه بشكل مُباشر، فسيرميني صريعاً
حتّى قبل أن أدخل المجال

200
00:15:07,060 --> 00:15:11,840
هناك الآخرون أيضاً، لذا
سوف أكتفي بهذا القدر

201
00:15:12,250 --> 00:15:14,650
أُفضّل ألّا أتأذّى

202
00:15:14,650 --> 00:15:19,200
كان ينبغي أن أعلم بأنّني لن أملك
فُرصة بجمع فريق بعُجالة

203
00:15:19,200 --> 00:15:21,010
سأخرج من هنا

204
00:15:24,460 --> 00:15:26,110
هذا غير مُمكن

205
00:15:26,110 --> 00:15:28,860
قبلتُ هذا العمل لأنّ الأجر كان جيّداً

206
00:15:29,770 --> 00:15:32,480
والآن سيترتّب عليّ البحث
عن تسوغاي جديدين ثانية

207
00:16:10,330 --> 00:16:12,660
أبليتَ حسناً يا جين-سان

208
00:16:13,210 --> 00:16:16,020
كان ذلك شاقّاً حقّاً

209
00:16:16,880 --> 00:16:20,400
آسف لإقحامك في هذا
أيُّها الأخ الكبير

210
00:16:20,400 --> 00:16:22,660
يا لها من طريقة لضيافة زُوّارك

211
00:16:23,090 --> 00:16:24,420
نشكرك على المُساعدة

212
00:16:24,850 --> 00:16:27,460
لم أفعل هذا لأجلكم

213
00:16:27,940 --> 00:16:30,870
فعلتُ هذا لتقفّي أثر أمّي وأبي

214
00:16:31,560 --> 00:16:33,620
آسا، هل أنتِ بخير؟

215
00:16:37,080 --> 00:16:38,350
الطّفل الحقير

216
00:16:38,350 --> 00:16:39,770
الطّفلة القزمة

217
00:16:40,240 --> 00:16:42,810
سأعترف بأنّني طفلة، لكن
أنا واثقة بأنّني أكبر منك

218
00:16:42,810 --> 00:16:43,840
!كاذبة

219
00:16:43,840 --> 00:16:45,980
أظهِر بعض الاحترام لغابي-تشان-ساما

220
00:16:45,980 --> 00:16:50,810
سأدعكِ تفلتين إذاً، لكن لم أُسامحكِ

221
00:16:51,320 --> 00:16:53,560
اهدآ، اهدآ

222
00:16:54,040 --> 00:16:57,220
أخي والتسوغاي الخاصّان به أنقذانا

223
00:16:57,220 --> 00:17:00,110
أجل، أعلم. هذا واضح

224
00:17:00,540 --> 00:17:02,330
قبضتَ على مجموعةٍ منهم

225
00:17:06,350 --> 00:17:08,140
ماذا سنفعل معهم؟

226
00:17:08,140 --> 00:17:12,080
سنترك القرارَ للسيّد حالما يعود

227
00:17:12,420 --> 00:17:16,320
حاليّاً، لنستخرج ما نستطيع من معلومات

228
00:17:16,320 --> 00:17:17,670
أجل

229
00:17:18,390 --> 00:17:21,940
قالوا بأنّهم سيدفعون لي ثروةً
طائلة إذا قبضتُ على التّوأمين

230
00:17:21,940 --> 00:17:25,170
لا أعرف مَن كانوا

231
00:17:26,280 --> 00:17:28,690
هل نلجأ للطّريقة القديمة؟

232
00:17:34,470 --> 00:17:38,930
!إنّها أشبح بصخرة! يا إلهي، هذا مُؤلم

233
00:17:38,930 --> 00:17:42,910
ما المجموعة الّتي كلّفتكم بذلك؟
هل كانت من كاغيموري؟

234
00:17:44,200 --> 00:17:49,330
!لا أعرف أي مجموعة! صدّقني لا أعرف

235
00:17:49,330 --> 00:17:50,760
!كان عملاً وحيداً

236
00:17:50,760 --> 00:17:54,680
!التقيتُ بالجميع في فريقي للمرّة الأولى

237
00:17:54,680 --> 00:17:57,920
إنّهم غالباً مُستخدِمو تسوغاي عاديّون

238
00:17:57,920 --> 00:18:02,100
لا تعلم؟ لكن لا بُدّ أن يكون هناك
من يصدر الأوامر

239
00:17:58,380 --> 00:18:01,680
!عِظامي! أنت تُهشِّم عِظامي

240
00:18:02,310 --> 00:18:07,280
!كان رجلاً مُلتحياً بسترة مُموَّهة

241
00:18:10,410 --> 00:18:13,890
أعتقد بأنّني قضيتُ على ذلك
الرّجل أمام البوّابة

242
00:18:14,360 --> 00:18:15,710
آسف

243
00:18:17,390 --> 00:18:19,110
السّؤال التّالي

244
00:18:19,480 --> 00:18:23,250
هل تعرف مكانَ الزّوجين اللّذين
هربا من قرية هيغاشي؟

245
00:18:24,590 --> 00:18:29,290
إنّهما والدا التّوأمين. اختفيا
في رحلة طيران إلى أوكيناوا

246
00:18:29,290 --> 00:18:32,930
!لا أعرف شيئاً عنهما

247
00:18:33,150 --> 00:18:35,930
أيّ معلومة قد تُفيدنا في إيجادهما

248
00:18:35,930 --> 00:18:37,590
!قلتُ بأنّني لا أعلم

249
00:18:39,270 --> 00:18:40,790
لا أعلم أيضاً

250
00:18:40,790 --> 00:18:41,990
ولا أنا

251
00:18:41,990 --> 00:18:43,610
هل تعرفان شيئاً؟

252
00:18:47,300 --> 00:18:50,360
لا طرف خيط يقودنا إلى والدينا

253
00:18:50,750 --> 00:18:54,560
آسفة يا أخي. أعلم بأنّك أتيت
على أمل إيجاد شيء

254
00:18:59,380 --> 00:19:01,990
هل لدى أحدكم أسئلة لهم؟

255
00:19:02,430 --> 00:19:03,360
أجل

256
00:19:03,810 --> 00:19:05,490
هلّا طرحتُ عليك سؤالاً؟

257
00:19:05,910 --> 00:19:10,000
سأخبركِ بأيّ شيء، فقط أبعدوا
هذه السُّلحفاة عنّي

258
00:19:10,410 --> 00:19:12,710
أخبرني باسميهما

259
00:19:13,020 --> 00:19:15,460
اسماهما؟ ماذا؟

260
00:19:15,780 --> 00:19:17,560
بماذا تناديهما؟

261
00:19:17,560 --> 00:19:19,920
أقول "أنت" مثلاً

262
00:19:20,210 --> 00:19:22,500
ينبغي أن تمنحهما اسماً مُناسباً

263
00:19:22,500 --> 00:19:25,320
لكنّهما مُجرّد مواشي

264
00:19:25,320 --> 00:19:30,170
يجب الإثبات لهما مَن يكون الزّعيم
كي لا يخرجان عن السّيطرة

265
00:19:30,590 --> 00:19:34,400
لا أحاول أن أكون ودوداً بمنحهما اسماً

266
00:19:43,300 --> 00:19:44,620
غابي-تشان

267
00:19:53,260 --> 00:19:54,660
سأذهب لتبديل ملابسي

268
00:19:59,500 --> 00:20:04,010
فهمت. لا عجب في أنّ التسوغاي
الخاصّين بك خاناك بسهولة

269
00:20:04,330 --> 00:20:07,720
للتسوغاي مشاعر أيضاً يا سيّد

270
00:20:09,490 --> 00:20:12,920
إن كنتم تعرفون شيئاً، فحريّ بكم
أن تخبرونا ما دامت الفُرصة سانحة

271
00:20:12,920 --> 00:20:14,410
!كان هذا مُجرّد عمل قبلتُه

272
00:20:14,410 --> 00:20:15,130
!كذلك أنا

273
00:20:15,130 --> 00:20:17,610
!وقد منحتُ اسماً لشريكَي

274
00:20:18,380 --> 00:20:22,900
والآن، ماذا ينبغي أن نُسمّيكما؟

275
00:20:24,090 --> 00:20:29,140
لا تفعلا. أنا سيّدتكما المُؤقّتة

276
00:20:31,980 --> 00:20:35,410
آسفة. هلّا صغّرتُما حجمكما قليلاً؟

277
00:20:38,150 --> 00:20:40,170
!ظريفان للغاية! ما أظرفهما

278
00:20:41,560 --> 00:20:45,340
قلتِ بأنّكِ تعرّضتِ لهجوم من قِبَل
مُغتالين الواحد تلو الآخر

279
00:20:46,050 --> 00:20:48,910
هل كان الوضع هكذا منذ
مُغادرتكِ للجبل؟

280
00:20:48,910 --> 00:20:54,440
على ما أعتقد، لكن كان العدد أكبر
هذه المرّة. نجوتُ بأعجوبة

281
00:20:56,400 --> 00:21:00,060
يسرّني أنّك كنتَ هنا. شكراً لك

282
00:21:03,850 --> 00:21:08,190
أرخيتُ دفاعي لأنّني كنتُ بأمان هنا

283
00:21:08,760 --> 00:21:10,480
ينبغي أن أتوخّى حذراً أكبر

284
00:21:10,480 --> 00:21:14,120
لا عجب في أنّها مُرهَقة ومُتجهِّمة طوال الوقت

285
00:21:15,120 --> 00:21:16,090
...عينكِ اليُمنى

286
00:21:17,300 --> 00:21:20,220
هل أخذوها منكِ أيضاً؟

287
00:21:27,640 --> 00:21:31,260
شيء من هذا القبيل

288
00:21:34,060 --> 00:21:38,400
لا، لا أريد أن أكذب عليك

289
00:21:42,260 --> 00:21:43,400
...في الواقع

290
00:21:44,220 --> 00:21:45,680
متُّ مرّة في السّابق

291
00:21:47,770 --> 00:21:50,190
قُتِلتُ بواسطة مُغتال من قرية هيغاشي

292
00:23:27,960 --> 00:23:31,280
شعرتُ بأنّ ذلك يخترق كلَّ
مسامٍّ في جسدي

293
00:23:31,720 --> 00:23:36,980
ويغرس في جلدي ويطعن لحمي
وأعضائي الحيويّة مُباشرة