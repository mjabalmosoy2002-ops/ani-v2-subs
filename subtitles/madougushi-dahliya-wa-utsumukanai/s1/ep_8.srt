1
00:00:15,740 --> 00:00:20,240
لم أستطع التّخلّص من كلّ القلق بشأن
!فطريات القدم من ذهني تمامًا أبدًا

2
00:00:20,440 --> 00:00:23,440
!يمكنني التّركيز على الضّفادع الكبيرة بالكامل

3
00:00:20,750 --> 00:00:24,750
بالإمكان التّخلّص من كلّ القلق
...بشأن فطريّات القدم

4
00:00:24,030 --> 00:00:24,750
!ولا عرق أيضًا

5
00:00:24,750 --> 00:00:25,830
!ولا حكّة

6
00:00:25,830 --> 00:00:27,640
!إنّها لا تنزلق حتّى عندما أدوس عليها

7
00:00:25,830 --> 00:00:27,840
...لا تصاب الأقدام بالحكّة

8
00:00:27,640 --> 00:00:29,500
!اكتب بسرعة يا وُلفريد

9
00:00:29,490 --> 00:00:31,900
...لحظة رجاء. إنّ ملاحظاتي

10
00:00:29,880 --> 00:00:31,790
.يحتاج الكعب لتعزيز أكثر

11
00:00:31,790 --> 00:00:33,750
!سيكون زوج يصل إلى الرّكبة ممتازًا إن أمكن

12
00:00:33,300 --> 00:00:34,830
...تصل حتّى الرّكبة

13
00:00:35,510 --> 00:00:37,140
!أودّ مقاسات أكثر

14
00:00:37,140 --> 00:00:39,610
!سنكتب الملاحظات بأنفسنا
!أحضروا بعض أوراق البرشمان

15
00:02:13,350 --> 00:02:18,120
الحلقة الثّامنة
شركة روسيتّي

16
00:02:13,920 --> 00:02:16,200
!ثمانين مجموعة؟

17
00:02:16,200 --> 00:02:19,030
تقصد جوارب الأصابع الخمسة
والنّعال الدّاخليّة المجفّفة؟

18
00:02:19,030 --> 00:02:20,900
.أودّ أن أطلبها في الحال

19
00:02:20,900 --> 00:02:25,410
.طلبتُ منك تقريرًا عن تجربتك فحسب

20
00:02:25,410 --> 00:02:28,710
.التّقرير معي أيضًا. تفضّلي

21
00:02:28,960 --> 00:02:31,960
كم ضغطتَ على نفسك لتجهّز كلّ هذا؟

22
00:02:31,960 --> 00:02:35,420
.إنّ من سأضغط عليه الآن هو أنت

23
00:02:35,880 --> 00:02:38,440
.هذه هي خطّة التّنفيذ خاصّتنا

24
00:02:38,440 --> 00:02:42,010
،بعد المجموعات الثّمانين الأولى"
"...فالإجراءات المتواصلة

25
00:02:42,330 --> 00:02:44,300
كيف آلت الأمور لهذا الحال؟

26
00:02:44,300 --> 00:02:46,880
.يتضمّن التّقرير ذلك أيضًا

27
00:02:50,050 --> 00:02:53,530
يتحوّل التّقرير إلى رسائل شكر
.عند الوصول لمنتصفه

28
00:02:53,530 --> 00:02:56,440
إنّ العديد من الرّجال كانوا
.قلقين حيال فطريّات القدم

29
00:02:56,440 --> 00:03:00,280
إنّه مليء بعبارات الإعجاب بالفكرة
.والمهارة الّتي جعلت ذلك حقيقة

30
00:03:00,280 --> 00:03:03,050
هذا خطّ يدك، صحيح يا وُلف؟

31
00:03:03,350 --> 00:03:08,040
بصفتي ممثّل الوحدة، سُمح لي
.بتسجيل الرّأي الّذي أجمعوا عليه

32
00:03:12,550 --> 00:03:15,290
.لا أعرف كيف أتولّى كلّ هذه الطّلبات

33
00:03:15,290 --> 00:03:18,570
.سأذهب غدًا إلى النّقابة التّجاريّة لطلب النّصيحة

34
00:03:18,570 --> 00:03:20,130
ماذا عنك يا وُلف؟

35
00:03:20,130 --> 00:03:23,890
،سأرافقك. يريد منّي القائد أن أعجّل في الأمر

36
00:03:23,890 --> 00:03:26,450
.لذلك أودّ المساعدة بأيّ طريقة ممكنة

37
00:03:26,450 --> 00:03:29,090
أودّ أيضًا الحصول على نصيحة
.بشأن ما عليّ فعله تاليًا

38
00:03:29,090 --> 00:03:32,900
في تلك الحالة، سأرى متى سيكون
.السّيّد دومينيك متفرّغًا

39
00:03:32,900 --> 00:03:35,750
.ولنستشر مع نائبة الرّئيس أيضًا

40
00:03:36,020 --> 00:03:39,770
هل يمكنني أن أصير أحد الضّامنين
أيضًا لأستطيع تقديم الدّعم لك؟

41
00:03:39,770 --> 00:03:44,370
سيزيد ذلك من فرصنا
.في الحصول على الموادّ

42
00:03:44,370 --> 00:03:46,160
!شكرًا جزيلاً لك

43
00:03:46,500 --> 00:03:51,510
ومع ذلك، قد يؤدّي هذا فقط
.إلى إشاعات عن سلوك غير لائق

44
00:03:51,510 --> 00:03:56,470
تقصد إشاعات عن وجود علاقة بيننا؟

45
00:03:56,470 --> 00:03:58,960
أنا آسف لأنّني لم أفكرّ
.حتّى الآن في هذا الاحتمال

46
00:04:00,020 --> 00:04:03,640
أسيكون من الأفضل لي الحفاظ على مسافة
معيّنة عندما نكون في الأماكن العامة؟

47
00:04:03,640 --> 00:04:06,730
.لا أهتمّ ما رأي النّاس بي

48
00:04:06,730 --> 00:04:08,510
ما دمتُ أستطيع إنجاز العمل

49
00:04:08,510 --> 00:04:11,170
والتّعامل مع الأشخاص
.الّذين يعترفون بنجاحاتي

50
00:04:11,170 --> 00:04:12,240
...داليا

51
00:04:12,240 --> 00:04:14,690
.لكنّ ذلك رأيي في المسألة فحسب

52
00:04:15,040 --> 00:04:18,110
إن كنت تفضّل تغيير طريقة
،تفاعلنا مع بعض يا وُلف

53
00:04:18,110 --> 00:04:20,640
.فلا يحقّ لي أن أمنعك

54
00:04:20,640 --> 00:04:24,400
،إن كان ذلك ما تودّ القيام به
.فلا تتردّد في إخباري

55
00:04:25,950 --> 00:04:27,220
.أنا آسف

56
00:04:27,530 --> 00:04:29,500
.لا أريد تغيير علاقتنا

57
00:04:29,830 --> 00:04:35,610
بصفتي صديقك، أريد أن أقول بكلّ فخر
.أنّي أدعم عملك في صناعة الأدوات السّحريّة

58
00:04:35,610 --> 00:04:38,130
.لا أريد إخفاء ذلك من أيّ أحد

59
00:04:40,420 --> 00:04:42,160
.شكرًا لك

60
00:04:43,440 --> 00:04:46,890
!في تلك الحالة، ابق صديقي رجاءً

61
00:04:46,890 --> 00:04:50,180
سأبذل جهدي لأحرص أنّ صداقتنا
!ليست مصدر إحراج لك

62
00:04:58,690 --> 00:05:04,110
كنّا في انتظارك أيّها السّيّد سكالفاروتّو
.ويا رئيسة شركة روسيتّي

63
00:05:05,220 --> 00:05:09,170
أنا نائبة رئيس النّقابة التّجاريّة
.واسمي غابرييلاّ جيدر

64
00:05:09,170 --> 00:05:12,110
.أنا هنا كممثّلة لرئيس النّقابة

65
00:05:12,110 --> 00:05:15,660
،سيّد وُلفريد سكالفاروتّو
تودّ القيام بالإجراءات لتصبح

66
00:05:15,660 --> 00:05:17,880
أحد الضّامنين في شركة روسيتّي، صحيح؟

67
00:05:18,210 --> 00:05:19,140
.إيفانو

68
00:05:19,140 --> 00:05:21,090
.سأقوم بتجهيز كلّ شيء في الحال

69
00:05:21,490 --> 00:05:25,380
،إنّ دومينيك متأهّب أيضًا
.لذلك سيصل إلى هنا قريبًا

70
00:05:25,600 --> 00:05:28,900
.سيّد سكالفاروتّو، أودّ منك أن تلتقي به

71
00:05:28,900 --> 00:05:29,590
.بالطّبع

72
00:05:30,000 --> 00:05:34,130
داليا، أريد التّحدّث معك للحظة
.بينما يقوم بذلك

73
00:05:34,130 --> 00:05:37,310
هلاّ رافقتني إلى مكتبي؟

74
00:05:37,990 --> 00:05:41,550
يفترض أن يكون هذا هو كلّ
.ما نحتاج في الوقت الحاليّ

75
00:05:42,200 --> 00:05:45,630
.شكرًا لشرح كلّ شيء عن هذا لي

76
00:05:45,980 --> 00:05:50,750
إن كنت ستواصل عملك كفارس
،بينما تعمل كضامن أيضًا

77
00:05:50,750 --> 00:05:55,250
.فأنا أوصيك بإبلاغ منزل سكالفاروتّو بنواياك

78
00:05:55,530 --> 00:05:57,740
إذًا تظنّ أنّ ذلك ضروريّ؟

79
00:05:57,740 --> 00:06:00,700
.نعم، احتسابًا لأيّ شيء في المستقبل

80
00:06:00,700 --> 00:06:04,810
إضافة لذلك، يُقال أنّ النّصر حليف
صاحب المبادرة، أليس كذلك؟

81
00:06:06,360 --> 00:06:08,260
.تلقّت النّقابة رسالة

82
00:06:08,600 --> 00:06:12,660
.كانت من طرف قائد قوّات قمع الوحوش

83
00:06:12,660 --> 00:06:15,550
.قال أنّه سيرسل شخصًا وطلب منّا أن نلتقي به

84
00:06:15,550 --> 00:06:17,360
هل قصد وُلف؟

85
00:06:17,360 --> 00:06:19,280
.ذلك الجزء غير مهمّ

86
00:06:19,280 --> 00:06:25,050
.والأهمّ من ذلك أنّه سأل عن الدّعم للمخترع

87
00:06:25,050 --> 00:06:27,520
.عليّ الاعتراف، هذه سابقة لنوعها

88
00:06:27,520 --> 00:06:31,790
.غابرييلاّ، لا أعرف كيف أتولّى هذا
.أخبريني ما العمل رجاءً

89
00:06:31,790 --> 00:06:33,610
هلاّ أخبرتني بالتّفاصيل؟

90
00:06:33,610 --> 00:06:38,400
نعم. جوارب الأصابع الخمسة
...المجفّفة والنّعال

91
00:06:39,940 --> 00:06:43,540
كم يمكنك أن تمزجي بالسّحر في اليوم؟

92
00:06:43,760 --> 00:06:48,130
.خمسة عشر أو عشرون على الأرجح

93
00:06:48,130 --> 00:06:49,730
لا يمكنك تجهيز أكثر من ذلك؟

94
00:06:49,730 --> 00:06:52,950
.لا أستطيع تجهيز أكثر من ذلك وحدي

95
00:06:52,950 --> 00:06:55,210
.في تلك الحالة، علينا تعيين شخص ما

96
00:06:55,210 --> 00:06:58,440
.سينجح هذا الأمر بطريقة ما
.سيكون الوضع بخير. سيكون بخير

97
00:06:58,440 --> 00:07:01,810
لا تقولي ذلك وكأنّك تتمنّين
.أن يصير حقيقة رجاءً

98
00:07:03,240 --> 00:07:06,350
.والآن، دعيني أعرض عليك نصيحة

99
00:07:06,840 --> 00:07:12,360
داليا، اكتبي اتّفاق أرباح لجوارب
.الأصابع الخمسة والنّعال الدّاخليّة

100
00:07:12,710 --> 00:07:14,780
.سأعيّن مساعدًا لك

101
00:07:14,780 --> 00:07:16,000
.حسنًا

102
00:07:16,000 --> 00:07:20,530
بالنّسبة للتّصنيع... لنرسل مبعوثًا
.إلى نقابل الألبسة

103
00:07:20,530 --> 00:07:23,650
هل تودّ أن تكون حاضرًا يا سيّد وُلفريد؟

104
00:07:23,650 --> 00:07:25,580
.نعم، بالطّبع

105
00:07:25,580 --> 00:07:27,760
بدلاً من إجراء مثلَ

106
00:07:27,760 --> 00:07:31,300
،هذه التّرتيبات الرّسميّة الكبرى
ألا يمكننا التّحدّث إلى ورشة بشكل مباشر؟

107
00:07:31,300 --> 00:07:33,680
.سيكون من الأفضل ألاّ نفعل ذلك

108
00:07:33,980 --> 00:07:39,220
سيّد وُلفريد، هل فرسان وجنود
القصر يرتدون أحذية جلديّة؟

109
00:07:39,220 --> 00:07:41,650
وماذا عن الموظّفين المدنيّين؟

110
00:07:41,650 --> 00:07:44,130
.أعتقد أنّ معظمهم يرتدون أحذية جلديّة

111
00:07:44,130 --> 00:07:48,690
إذًا من العدل أن نفترض
.أنّها شائعة في جميع أنحاء القصر

112
00:07:48,690 --> 00:07:52,490
.قد يصير هذا رائجًا بين النّبلاء وحتّى العامّة

113
00:07:52,490 --> 00:07:55,470
فهمت. إنّ أيّ شخص يرتدي
...أحذية جلديّة

114
00:07:55,470 --> 00:07:59,170
لذلك السّبب لا أعتقد أنّ ورشة
.واحدة ستكون كافية

115
00:07:59,170 --> 00:08:03,620
وأيضًا، أعتقد أنّنا سنحتاج لمصدر للسلايم
.الأخضر الّذي يُستعمل في النّعال الدّاخليّة

116
00:08:03,620 --> 00:08:06,460
.إذًا علينا العمل مع نقابة مغامرين أيضًا

117
00:08:06,460 --> 00:08:09,550
،إضافة إلى الإمساك بالسلايم
.ننصح أيضًا بزراعتها

118
00:08:09,800 --> 00:08:12,050
!لن نحتاج لذلك العدد الكبير

119
00:08:12,050 --> 00:08:15,480
سيكون سلايم واحدًا صغيرًا كافيًا
.لتجهيز خمسة أزواج

120
00:08:15,480 --> 00:08:18,160
النّعال الدّاخليّة ليست للاستعمال
الدّائم، صحيح؟

121
00:08:18,720 --> 00:08:22,480
.لن يكون صيد السلايم وحده كافيًا
.علينا الشّروع بزراعتها أيضًا

122
00:08:25,490 --> 00:08:27,680
.مرحبًا بكم في النّقابة التّجاريّة

123
00:08:27,680 --> 00:08:31,940
،أثناء هذه المفاوضات
.ستقوم نقابتنا بمقام الوسيط

124
00:08:33,660 --> 00:08:36,460
.هذه هي تفاصيل الموضوع

125
00:08:36,460 --> 00:08:38,960
،أنا أفهم الوضع

126
00:08:38,960 --> 00:08:40,980
،لكن إن كنتم تطلبون منّا المشاركة

127
00:08:40,980 --> 00:08:43,960
فهل يعني ذلك أنّكم لا تنوون
الحفاظ على سرّيّة هذه التّقنيّة؟

128
00:08:43,960 --> 00:08:47,540
.نعم. نريدها أن تنتشر قدر الإمكان

129
00:08:47,540 --> 00:08:51,040
.بإمكان شركة روسيتّي بناء ورشتها الخاصّة

130
00:08:51,040 --> 00:08:54,460
،حسب حجم شركتنا الحاليّ
.فذلك ليس واقعيًّا

131
00:08:54,460 --> 00:08:59,150
،يا مساعدة المدير فرنو
،إن تمّ العمل بكلّ إمكانات ورشتكم

132
00:08:59,150 --> 00:09:02,020
فكم جوربًا بإمكانكم صنعه في اليوم؟

133
00:09:02,340 --> 00:09:06,110
،إنّ بنيتها فريدة من نوعها
.لذلك سيكون 20 زوجًا هو الحدّ الأقصى

134
00:09:09,190 --> 00:09:13,450
إن عدّلنا آلات الحياكة المستخدمة في القفّازات
...لجعل جزء من العمل يتمّ بشكل آليّ

135
00:09:13,450 --> 00:09:16,000
.لنطلب من التّقنيّين أن يأتوا في الحال

136
00:09:20,410 --> 00:09:23,130
.سنستعمل الإسكافيّين لصناعة النّعال الدّاخليّة

137
00:09:23,130 --> 00:09:25,960
هل علينا تسليم البضاعة المنتهية
للنّقابة التّجاريّة؟

138
00:09:26,240 --> 00:09:30,000
أم أنّ حرفيّي السّحر هنا سيتولّون
عمليّة المزج بالسّحر؟

139
00:09:30,000 --> 00:09:32,370
.سأعهد بذلك لكم

140
00:09:32,370 --> 00:09:34,350
إذًا هل نستطيع أن نقول
أنّ حصّة شركة روسيتّي

141
00:09:34,350 --> 00:09:38,210
هي ما في اتّفاقيّة الرّبح بالإضافة
إلى 20% من أيّ ربحٍ صافٍ؟

142
00:09:38,210 --> 00:09:42,450
.%تُفضّل النّقابة التّجاريّة نسبة 25

143
00:09:42,450 --> 00:09:45,900
أرجو أن تأخذوا بالاعتبار الوقت
.الّذي ستستثمره نقابة الألبسة

144
00:09:46,250 --> 00:09:48,100
.أعتذر على التّدخّل

145
00:09:48,320 --> 00:09:50,540
.ستكون 20% كافية

146
00:09:54,610 --> 00:09:58,680
نطلب أيضًا أن تحتفظ شركة روسيتّي

147
00:09:58,680 --> 00:10:01,120
.بحقّ تقرير أيّ الزّبائن ستكون له الأولويّة

148
00:10:01,680 --> 00:10:04,620
.نعم، بإمكاننا المثول لهذه الشّروط

149
00:10:04,620 --> 00:10:07,700
هل يناسب هذا رئيسة شركة روسيتّي؟

150
00:10:07,700 --> 00:10:09,950
...نعم! عفوًا

151
00:10:09,950 --> 00:10:12,530
.أجد الشّروط مقبولة أيضًا

152
00:10:12,530 --> 00:10:14,620
.لنعمل بها إذًا

153
00:10:14,620 --> 00:10:19,040
بإمكان شركة روسيتّي تعيين مشرف
.على العمل إن أردتم ذلك

154
00:10:19,040 --> 00:10:24,480
.لا، أنا أثق بك أيّها السّيّد فورتوناتو
.سأترك كلّ شيء لكم

155
00:10:25,030 --> 00:10:26,520
.حان دورنا إذًا

156
00:10:26,900 --> 00:10:30,610
بخصوص استعمال السلايم
...الأخضر للنّعال الدّاخليّة

157
00:10:30,610 --> 00:10:32,870
كم واحدة يمكن صنعها من سلايم واحد؟

158
00:10:32,870 --> 00:10:35,200
إنّ سلايم واحد صغير كافٍ
.لتجهيز خمسة أزواج

159
00:10:35,200 --> 00:10:38,470
ما يعني أنّنا سنحتاج لمائتين
.من أجل تجهيز ألف مجموعة

160
00:10:38,860 --> 00:10:41,020
ما رأيك يا جان؟

161
00:10:41,020 --> 00:10:43,860
لطالما كان تعاملنا جيّدًا
.مع عائلة روسيتّي في الماضي

162
00:10:43,860 --> 00:10:49,620
خلال أيّام السّيّد كارلو، كان يرسلنا
.للحصول على كراكن وسحالي رمليّة

163
00:10:49,890 --> 00:10:52,130
.يا لها من ذكريات عزيزة

164
00:10:52,130 --> 00:10:55,820
ولا ننسى السلايم الأزرق المستعمل في النّسيج
.المضادّ للماء الخاصّ برئيسة شركة روسيتّي

165
00:10:55,820 --> 00:10:57,870
.إنّنا ندين لكم بالكثير

166
00:10:58,130 --> 00:11:01,280
!وتبدو الإمكانات هذه المرّة أعظم بكثير

167
00:11:01,280 --> 00:11:03,700
.إنّ جسدي بأكمله متحمّس بسبب التّرقّب

168
00:11:04,330 --> 00:11:10,580
كـ-كلانا أنا وأبي مدينان لكم
.بشدّة على كلّ ما فعلتموه

169
00:11:17,510 --> 00:11:19,560
!داليا

170
00:11:19,860 --> 00:11:22,690
.لوتشيا! شكرًا على كلّ شيء

171
00:11:22,690 --> 00:11:27,040
ما الّذي كنت تفكّرين به
بإرسالك لمبعوث لنقابة الألبسة؟

172
00:11:27,040 --> 00:11:29,090
.كاد يُغمى على أبي

173
00:11:29,090 --> 00:11:31,090
'!قالت أمّي، "أنت صنعتها، لذلك اذهبي أنت

174
00:11:31,090 --> 00:11:33,550
.ثمّ جعلتني مساعدة المدير في الحال

175
00:11:33,550 --> 00:11:35,740
تتكوّن الورشة منّا نحن أفراد
.العائلة الخمسة فقط

176
00:11:35,740 --> 00:11:38,750
من يحتاج لمساعِدة مدير؟

177
00:11:38,750 --> 00:11:42,560
أنا آسفة. لم أفكّر أنّ كلّ هذا
.سيحدث بسبب ذلك

178
00:11:42,560 --> 00:11:46,320
.لقد صنعتُها فقط لإضحاك السّيّد كارلو

179
00:11:46,320 --> 00:11:48,560
من كان يظنّ أنّها ستصير مهمّة لهذا الحدّ؟

180
00:11:48,800 --> 00:11:53,590
صحيح! هل يمكنك إرسال نسيج
معاطف المطر بالعربة؟

181
00:11:53,590 --> 00:11:59,060
أردتُ تجهيز بعض المعاطف الظّريفة، لكن
.لا فكرة لديّ عن متى سيكون عندي الوقت

182
00:12:00,210 --> 00:12:03,000
أنا مسرور لأنّ الأمور تبدو
.وكأنّها تسير على ما يرام الآن

183
00:12:03,000 --> 00:12:05,610
هل تسير على ما يرام بالفعل...؟

184
00:12:05,900 --> 00:12:10,190
،لم أقصد أن أزعجك يا داليا

185
00:12:10,190 --> 00:12:14,630
لكن أعتقد أنّه عليك تعلّم
.تفادي التّعامل مع النّبلاء

186
00:12:14,630 --> 00:12:16,960
هل قلّلت من احترام أيّ أحد بكلامي؟

187
00:12:16,960 --> 00:12:22,430
قلت أنّك تثقين بالسّيّد فورتوناتو
.وستتركين كلّ شيء له

188
00:12:22,430 --> 00:12:23,930
.صـ-صحيح

189
00:12:24,340 --> 00:12:28,520
،عندما تقول آنسة عزباء ذلك لنبيل
.فقد يمكن فهمه كتعبير عن الحبّ

190
00:12:28,520 --> 00:12:34,350
،قصدتُ أنّي أثق بالطّريقة الّذي يعمل بها
!لذلك قرّرتُ ترك تلك القرارات له

191
00:12:34,590 --> 00:12:37,590
،إنّه يعلم أنّك لست نبيلة

192
00:12:37,590 --> 00:12:40,840
كما أنّي سأتدخّل إن حدث أيّ
.شيء ما، فلا داعي للقلق

193
00:12:41,200 --> 00:12:43,860
كيف لي أن أكون معدومة اللّباقة هكذا؟

194
00:12:44,080 --> 00:12:45,950
.كانت جملة في مسرحيّة أوبرا قديمة

195
00:12:45,950 --> 00:12:51,870
.أنا أثق بك يا سيّد أورفينو"
".سأترك كلّ شيء لك

196
00:12:51,870 --> 00:12:53,500
.هكذا إذًا

197
00:12:53,500 --> 00:12:56,820
.صار الاستشهاد بها أمرًا شائعًا

198
00:12:56,820 --> 00:13:01,650
.وتقوله النّبيلات للرّجال في أوّل ليلة يقضونها معًا

199
00:13:01,990 --> 00:13:04,260
...لا أعرف أيّ شيء عن ذلك

200
00:13:07,270 --> 00:13:09,970
تفهم ما أقوله، صحيح؟

201
00:13:13,980 --> 00:13:16,690
تفهم ما أقوله، صحيح؟

202
00:13:17,940 --> 00:13:19,910
.نعم، بالكامل

203
00:13:20,190 --> 00:13:26,030
نطلب أيضًا أن تحتفظ شركة روسيتّي"
".بحقّ تقرير أيّ الزّبائن ستكون له الأولويّة

204
00:13:26,330 --> 00:13:30,900
ولا شكّ أنّ هذا سيكون له
.أهمّيّة قصوى بالنّسبة لأيّ شركة

205
00:13:30,900 --> 00:13:32,480
.أنا جدّ آسف

206
00:13:32,770 --> 00:13:39,420
أعطيتُ الأولويّة لمصالحي كضامن لشركة
.روسيتّي على مصالح النّقابة التّجاريّة

207
00:13:39,730 --> 00:13:42,170
هلّي أن أسألك عن السّبب؟

208
00:13:42,170 --> 00:13:46,170
،يا نائبة الرّئيسة... بل يا سيّدة غابرييلاّ

209
00:13:46,170 --> 00:13:49,080
اقبلي استقالتي من وظيفتي
.في النّقابة التّجاريّة رجاءً

210
00:13:49,840 --> 00:13:51,850
.توقّعتُ أن يكون ذلك هو السّبب

211
00:13:51,850 --> 00:13:54,180
.مع أنّ هذا حدث أبكر ممّا توقّعت

212
00:13:59,130 --> 00:14:03,450
اعتقدت أنّني سأنهي مسيرتي
.المهنيّة هنا تحت إشرافك

213
00:14:03,450 --> 00:14:06,710
لكنّك ستتخلّى عن ذلك، صحيح؟
.لأجل داليا

214
00:14:06,710 --> 00:14:11,280
.بل لأجل صالحي
!أنا أحبّ كوني تاجرًا بالفعل

215
00:14:11,600 --> 00:14:15,040
بالكاد يمكنني مجادلتك في ذلك
.بعد رؤية تلك الابتسامة

216
00:14:15,460 --> 00:14:19,040
،قبل أن تترك عملك هنا
لماذا لا تسأل داليا إن كان ستعيّنك؟

217
00:14:19,380 --> 00:14:21,530
.لن يكون ذلك عادلاً

218
00:14:21,530 --> 00:14:24,980
اسمحي لي رجاءً بكتابة رسالة
.استقالتي هنا وفي الحال

219
00:14:32,100 --> 00:14:34,020
.سأحتفظ بها

220
00:14:34,020 --> 00:14:35,890
لن تقبلي استقالتي؟

221
00:14:35,890 --> 00:14:38,770
.عد إن رفضت داليا طلبك

222
00:14:39,100 --> 00:14:42,370
.عليك الحديث مع السّيّد وُلفريد أوّلاً

223
00:14:42,370 --> 00:14:46,290
،إن أوصى هو بك
.فلن تستطيع داليا أن ترفض

224
00:14:46,290 --> 00:14:49,030
ألا تجعلين الأمر يبدو صعبًا؟

225
00:14:49,030 --> 00:14:53,030
يمكنك انتهاز الفرصة لترى أيّ
.نوع من الرّجال يكون نيابة عنّي

226
00:15:01,370 --> 00:15:05,130
.يا إلهي. سرقت داليا رجلاً جيّدًا منّي

227
00:15:10,100 --> 00:15:12,950
.شكرًا لأخذك وقتًا لرؤيتي

228
00:15:12,950 --> 00:15:13,870
.العفو

229
00:15:14,140 --> 00:15:18,390
سيّد سكالفاروتّو، ما رأيك بالآنسة داليا؟

230
00:15:18,390 --> 00:15:22,390
.إنّها حرفيّة سحر مذهلة وصديقة عزيزة

231
00:15:22,750 --> 00:15:27,150
ما علاقة ذلك بكوني ضامنًا لشركة روسيتّي؟

232
00:15:28,610 --> 00:15:32,160
.إنّك تقف حيث مات السّيّد كارلو بالضّبط

233
00:15:32,640 --> 00:15:36,950
التقيته هنا، لكن لم يكن
.بوسعي فعل أيّ شيء

234
00:15:48,550 --> 00:15:50,790
.شكرًا على إخبارك لي بهذا

235
00:15:50,790 --> 00:15:54,970
كلاّ... ربّما أخبرتك بذلك فقط
.لأنّي كنت آمل رؤية ردّة فعلك

236
00:15:55,530 --> 00:15:59,840
بالنّسبة لي، تبدو الآنسة داليا
.مثل إلهة ترتدي رخاءً ذهبيًّا

237
00:15:59,840 --> 00:16:01,300
ماذا تعني؟

238
00:16:01,300 --> 00:16:05,310
أعتقد أنّ شركة روسيتّي قادرة
.على القيام بأشياء عظيمة

239
00:16:05,630 --> 00:16:09,490
أريد أن أكون إلى جانب الآنسة داليا
.وأساعدها لتنمّي الشّركة

240
00:16:09,870 --> 00:16:13,750
.قدّمتُ رسالة استقالتي للنّقابة التّجاريّة للتّوّ

241
00:16:14,660 --> 00:16:16,610
لماذا تخبرني بهذا؟

242
00:16:16,610 --> 00:16:20,360
.أرجو أن توصي بي لها يا سيّد وُلفريد

243
00:16:21,010 --> 00:16:24,700
لماذا عليّ أن أوصي بك لداليا؟

244
00:16:24,700 --> 00:16:28,600
،أنا الابن الأكبر لشركة تجاريّة عريقة

245
00:16:28,600 --> 00:16:31,040
.وعملت في النّقابة لمدّة ستّة عشر عامًا

246
00:16:31,300 --> 00:16:35,070
.أنا فخور بمهاراتي في التّجارة وإدارة شركتي

247
00:16:35,070 --> 00:16:37,890
.إذًا فعليك تولّي زمام عمل عائلتك

248
00:16:37,890 --> 00:16:40,830
.فقدنا كلّ شيء في أيّام والدي

249
00:16:41,310 --> 00:16:44,480
التجأت إلى العاصمة الملكيّة
،وكأنّي كنتُ أحاول الهرب من ذلك

250
00:16:44,480 --> 00:16:47,960
ووجدتُ لنفسي هنا في النّقابة
.العمل الّذي عليّ القيام به

251
00:16:48,470 --> 00:16:51,270
.إنّ شركة الآنسة داليا جذّابة بشكل كبير

252
00:16:51,270 --> 00:16:54,480
لكن كيف لشركة تجاريّة
ألاّ يوجد فيها تاجر واحد؟

253
00:16:54,480 --> 00:16:57,510
!سيلتهمها السّوق في الحال

254
00:16:57,510 --> 00:16:59,320
.لا يمكنني تحمّل ذلك

255
00:16:59,700 --> 00:17:01,750
ومع ذلك لا تملك شركة خاصّة بك؟

256
00:17:02,200 --> 00:17:07,580
إنّها تتخيّل أحلامًا ذهبيّة
.قد تكون لها القوّة لتغيير العالم

257
00:17:07,580 --> 00:17:11,090
لا يوجد تاجر في هذا العالم
!ما كان لينجذب إلى ذلك

258
00:17:11,380 --> 00:17:14,340
لذلك هل من طريقة ستجعلك توصي بي لها؟

259
00:17:16,840 --> 00:17:19,060
هلاّ وعدتني بشيئين؟

260
00:17:19,350 --> 00:17:22,000
سنستخدم سحر العهد في الكنيسة
.لجعل الأمر مُلزِمًا

261
00:17:22,000 --> 00:17:25,370
.الأوّل، لن تتعمّد إلحاق الضّرر بداليا أو شركتها

262
00:17:25,370 --> 00:17:28,860
،إن كان ذلك سيُكسبني ثقتك
فبكلّ سرور. وما الوعد الثّاني؟

263
00:17:28,860 --> 00:17:31,800
.أريدك أن تحمي داليا قبل كلّ شيء

264
00:17:31,800 --> 00:17:36,290
إن حدث شيء ما، فالأولويّة لها على
.الشّركة وعلى كلّ شيء

265
00:17:36,290 --> 00:17:38,130
.أريدك أن تحمي داليا

266
00:17:39,990 --> 00:17:42,870
.أعدك بذلك وعد رجال

267
00:17:44,080 --> 00:17:46,370
.تفضّل. خذ هذه للقيام بالتّجهيزات

268
00:17:48,480 --> 00:17:51,250
!هذه عملة ذهبيّة صدرت تخليدًا لذكرى التّتويج

269
00:17:51,250 --> 00:17:54,260
.سمعتُ أنّ تغيير المهن يحتاج لمال

270
00:17:54,480 --> 00:17:56,630
.اقبل ذلك ولكن لا تخبر داليا

271
00:17:57,010 --> 00:18:00,670
.مفهوم. سأقبل بهذا بدون أيّ تحفّظات إذًا

272
00:18:00,670 --> 00:18:05,540
.والآن، نادني إيفانو من الآن فصاعدًا لو سمحت

273
00:18:16,090 --> 00:18:18,360
كان يوم الأمس صعبًا، صحيح؟

274
00:18:18,360 --> 00:18:22,300
.كنتُ لأضيع بالكامل لولا إرشادك

275
00:18:22,590 --> 00:18:24,360
.شكرًا جزيلاً لك

276
00:18:24,360 --> 00:18:27,220
.داليا، دعيني أعتذر مقدّمًا

277
00:18:27,220 --> 00:18:28,020
ماذا؟

278
00:18:28,020 --> 00:18:29,620
...قنّينة ضخّ الرّغوة

279
00:18:29,620 --> 00:18:33,690
كان استعمالها مذهلاً لدرجة
.أنّي أوصيتُ بها لصديق

280
00:18:33,690 --> 00:18:37,500
.وها قد توصّلنا الآن بطلب لتجهيز 200 قنّينة

281
00:18:37,500 --> 00:18:39,580
.سيجعلنا ذلك مشغولين جدًّا

282
00:18:39,920 --> 00:18:42,380
.أنا ممتنّة لدرجة البكاء

283
00:18:42,380 --> 00:18:45,960
كما وصلك طلب من رئيس
،شركة أورلاندو التّجاريّة

284
00:18:45,960 --> 00:18:49,600
،بصفتك رئيسة لشركة روسيتّي
.يطلب منك أن تكون موزعًا

285
00:18:49,600 --> 00:18:51,420
هل ستلتقين به؟

286
00:18:51,420 --> 00:18:53,950
.أظنّ أنّه يريد الاعتذار

287
00:19:03,930 --> 00:19:06,790
يُقال أنّ النّصر حليف
صاحب المبادرة، أليس كذلك؟

288
00:19:13,540 --> 00:19:16,800
.أقدّر قولك لذلك

289
00:19:16,800 --> 00:19:20,810
ألا يمكننا أن نتحدّث كما اعتدنا
سابقًا لو سمحت؟

290
00:19:20,810 --> 00:19:23,350
.شكرًا على لطفك هذا

291
00:19:24,750 --> 00:19:28,060
.تفضّلي. توجد اثنا عشر قطعة ذهبيّة هنا

292
00:19:28,060 --> 00:19:30,550
!سبق وحصلتُ على كلّ التّعويضات

293
00:19:30,550 --> 00:19:33,870
أريد ترك دليل من نوع ما
.على أنّني اعتذرتُ لك

294
00:19:33,870 --> 00:19:36,070
.فقط من أجل إرضاء نفسي

295
00:19:36,320 --> 00:19:38,650
.عليك أن تقبلي به

296
00:19:38,650 --> 00:19:42,330
إلاّ إذا كنت ترغبين في الاستفادة
.من شركة أورلاندو التّجاريّة بالطّبع

297
00:19:42,700 --> 00:19:45,560
.حسنًا. سأقبل به

298
00:19:46,330 --> 00:19:48,420
.لديّ طلب واحد

299
00:19:48,830 --> 00:19:53,070
آمل ألاّ تقاضين توبياس بسبب
.تسجيل الجهاز السّحريّ

300
00:19:53,070 --> 00:19:57,590
.لا أستطيع إجبارك على ذلك بالطّبع
.ذلك ليس ما أرغب فيه

301
00:19:57,970 --> 00:20:01,610
.لكن لديّ عرض في المقابل

302
00:20:02,090 --> 00:20:08,100
خلال السّنوات الثّلاث المقبلة، سنعطي
.طلبات الموادّ خاصّتك الأولويّة القصوى

303
00:20:08,340 --> 00:20:11,850
ولن نستثني أيّ موادّ، حتّى الموادّ
.الأكثر غرابة أو نُدرة

304
00:20:14,150 --> 00:20:15,930
ما رأيك يا داليا؟

305
00:20:15,930 --> 00:20:18,090
.ولكن لديّ شرط واحد

306
00:20:18,090 --> 00:20:21,780
.اطلبي ما تشائين رجاءً
.سأفعل أيّ شيء قدر المستطاع

307
00:20:21,780 --> 00:20:26,410
أرغب في الحصول على بلورات
.الجنّيّات في أسرع وقت ممكن

308
00:20:26,410 --> 00:20:29,660
.بلّورات الجنّيّات؟ مفهوم

309
00:20:29,660 --> 00:20:32,790
.سأقوم بالتّجهيز للتّواصل مع كلّ مورّدينا

310
00:20:33,180 --> 00:20:38,450
غابرييلاّ، هلاّ منحتني بعض الوقت
للحديث مع الآنسة داليا على انفراد؟

311
00:20:38,450 --> 00:20:41,000
عجبًا يا إيرينيو! أتحاول إغواءها؟

312
00:20:41,000 --> 00:20:43,510
.ما كنتُ لأفعل أيّ شيء غير لائق كهذا

313
00:20:51,520 --> 00:20:55,060
.آنسة داليا، لم أكن واثقًا إن كان عليّ منحك هذا

314
00:20:55,510 --> 00:20:57,690
،كنتُ أنوي تقديمه كهديّة زفاف

315
00:20:57,690 --> 00:21:00,320
لكن اعتبريه كتعويض على
.المشاكل الّتي تسبّبتُ بها لك

316
00:21:00,670 --> 00:21:03,820
.إنّه صغير الحجم، لكنّه قرن أنثى أحاديّ قرن

317
00:21:04,220 --> 00:21:06,820
.لكن لا يمكنني الجزم إن كان حقيقيًّا أم لا

318
00:21:06,820 --> 00:21:11,080
سمعتُ أنّ بالإمكان استعمال
.لإبطال أيّ سموم وتخفيف أيّ ألم

319
00:21:11,080 --> 00:21:13,080
لماذا تقدّمه لي أنا؟

320
00:21:13,700 --> 00:21:16,400
.طلب السّيّد كارلو ذلك منّي

321
00:21:16,400 --> 00:21:18,500
،أخذ الأمر أطول ممّا ظننت

322
00:21:18,540 --> 00:21:23,410
لكن هلاّ قبلتِ به لأستطيع
الوفاء بوعدي له؟

323
00:21:24,360 --> 00:21:25,630
.حسنًا

324
00:21:25,850 --> 00:21:29,190
.أنا نادم لأنّك لم تصيري زوجة أخي

325
00:21:29,190 --> 00:21:32,390
.لكن أعتقد أنّ ذلك كان أفضل لك

326
00:21:32,750 --> 00:21:35,610
.هذه آخر مرّة سأناديك فيها بالآنسة داليا

327
00:21:35,610 --> 00:21:39,160
بدءًا من الآن، آمل أن تصير علاقتنا
،علاقة رئيسَيْن لشركتيهما

328
00:21:39,540 --> 00:21:40,900
.يا رئيسة شركة روسيتّي

329
00:21:41,290 --> 00:21:43,510
.بالطّبع يا سيّد إيرينيو

330
00:21:43,510 --> 00:21:46,480
.لا... بل أقصد يا رئيس شركة أورلاندو التّجاريّة

331
00:21:48,290 --> 00:21:52,130
.لقد وصل السّيّد غويدو يا سيّد وُلفريد

332
00:21:52,720 --> 00:21:54,010
.سأذهب في الحال

333
00:21:58,460 --> 00:22:01,090
مرّ وقت طويل يا وُلفريد؟

334
00:22:01,640 --> 00:22:04,180
.معك حقّ يا أخي

335
00:23:35,010 --> 00:23:39,980
الحلقة التّاسعة   ما وراء الكابوس