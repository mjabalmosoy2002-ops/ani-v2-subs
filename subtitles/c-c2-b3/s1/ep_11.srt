1
00:00:01,090 --> 00:00:04,250
.هذا يُذكرني بمنزلي

2
00:00:04,450 --> 00:00:06,250
.الكنيسة التي لا تملك اسمًا

3
00:00:06,960 --> 00:00:09,340
.آه، لقد كان منزلاً خلابًا

4
00:00:09,540 --> 00:00:11,580
.لقد كانت كنيستي المُتهالكة والمُحبوبة

5
00:00:11,780 --> 00:00:13,670
.لم يعد لها وجودٌ بعد الآن

6
00:00:18,800 --> 00:00:19,940
.أجل

7
00:00:20,140 --> 00:00:22,940
.كُل شيءٍ وله ثمنه

8
00:01:58,840 --> 00:02:00,650
.آسف، أيتها الرئيسة

9
00:02:00,800 --> 00:02:02,320
...لا بُد بأنكِ لا تزالين مُتألمة مما حدث

10
00:02:02,370 --> 00:02:04,170
.كّلا، أنا على ما يُرام الآن

11
00:02:05,300 --> 00:02:06,440
،وأيضًا

12
00:02:06,490 --> 00:02:10,660
.يُفضل وضع طرفٍ ثالث في مثل هذه المواقف

13
00:02:19,770 --> 00:02:22,250
.دعونيَ أُلخص ما تقولونه

14
00:02:23,050 --> 00:02:27,760
،فيار-كُن تشتبه بـ نينجيّوهارا كوروي

15
00:02:27,810 --> 00:02:31,050
.كـ شخصٍ له علاقةٌ في جرائم القتل المُتسلسلة

16
00:02:31,730 --> 00:02:34,100
.كما أنها تملك إثباتًا على كلامها

17
00:02:34,150 --> 00:02:39,100
.الدليل الأول: هوَ أن جميع الضحايا قد كانوا إحدى زبائن صالون كوروي-كُن

18
00:02:39,150 --> 00:02:40,060
...والدليل الثاني

19
00:02:40,110 --> 00:02:45,070
."لقد رأيتُ كوروي-سان تتناول شعر إحدى الضحايا"

20
00:02:45,940 --> 00:02:49,840
...تم الإعلان في الأخبار بأن بعضًا من أجزاء الضحايا

21
00:02:50,390 --> 00:02:53,810
.لم تكن موجودةً في الصندوق الذي وجدوا فيه الضحية

22
00:02:54,500 --> 00:02:57,790
.مما يعني بأن أجزاءً من جسد الضحية قد أُخذت

23
00:03:03,120 --> 00:03:04,550
إذن، ما رأيكم بهذا؟

24
00:03:05,760 --> 00:03:09,200
.احبسوني حتى يزول شكُكم

25
00:03:10,800 --> 00:03:14,220
!إن كان بمقدوري فعل هذا فسوف أفعلها على الفور

26
00:03:14,270 --> 00:03:15,990
ما هيَ لعنتكِ بالضبط؟

27
00:03:16,040 --> 00:03:18,720
!رُبما لعنتكِ لم تزل أصلاً

28
00:03:18,870 --> 00:03:20,730
.لعنةٌ بغيضةٌ كهذه

29
00:03:21,180 --> 00:03:24,590
.لعنةٌ تراكمت عليها العديد من اللعنات

30
00:03:24,640 --> 00:03:25,500
...لِمَ أنا

31
00:03:25,550 --> 00:03:25,870
!فيار

32
00:03:30,450 --> 00:03:31,410
.ياشي

33
00:03:32,210 --> 00:03:34,750
.دعها لوحدها الآن

34
00:03:43,200 --> 00:03:46,800
.في الحقيقة هيَ لا ترغب بالاشتباه بـ كوروي

35
00:03:47,350 --> 00:03:49,430
.فبعد كُل شيء لا تزال طفلة

36
00:03:50,590 --> 00:03:53,020
،لا أُحبذ ما فعلتيه قبل قليل

37
00:03:53,070 --> 00:03:54,560
لكن لِمَ تقومين بهذا، كوروي؟

38
00:03:54,610 --> 00:03:56,390
لِمَ قدمت عرض حبسي لكم؟

39
00:03:56,440 --> 00:03:59,200
.سبب فعلتكِ التي رأتها فيار-سان

40
00:04:00,820 --> 00:04:03,150
.هذا لا دخل له بلعنتي

41
00:04:03,320 --> 00:04:06,900
.إنَّها مُجرد طريقةٍ كيّ أُعيد تزويد طاقتي

42
00:04:07,270 --> 00:04:09,150
،وأيضًا فهُناك

43
00:04:09,540 --> 00:04:13,050
،بطريقةٍ ما شعرت بموت مالكة الشعر

44
00:04:13,100 --> 00:04:15,160
.لهذا قُمت بتناول شعرها لكيّ أُحيِّ ذكراها

45
00:04:15,210 --> 00:04:18,200
لماذا لم تُخبري فيار إذن؟

46
00:04:18,250 --> 00:04:21,680
أتعتقد بأنَّها ستقتنع لأجل سببٍ كهذا؟

47
00:04:24,870 --> 00:04:28,250
لا أعلم لِمَ لا تقتنع بأن اللعنات تزول؟

48
00:04:32,500 --> 00:04:33,800
عن ماذا تبحثين؟

49
00:04:33,850 --> 00:04:35,090
.لعبة الورق

50
00:04:35,140 --> 00:04:36,610
.يُفضل أن تكون محلية

51
00:04:36,660 --> 00:04:37,930
.فالليل طويل

52
00:04:37,980 --> 00:04:41,310
كونو-سان، لا بأس بقضاء الليلة في لعبها، صحيح؟

53
00:04:41,820 --> 00:04:43,180
على ورق اللعب؟

54
00:04:43,230 --> 00:04:44,940
.حسنًا، يمكننا الخوض في القيل والقال

55
00:04:44,990 --> 00:04:45,940
!لستُ موافقة

56
00:04:46,460 --> 00:04:47,590
.أجل، أجل

57
00:04:47,640 --> 00:04:50,480
،لقد كُنت أتساءل مُنذ وهلة

58
00:04:50,530 --> 00:04:52,010
من هذه الفتاة؟

59
00:04:52,060 --> 00:04:54,090
أيعقل بأنَّها خاصتكَ يا هارو؟

60
00:04:54,140 --> 00:04:59,460
.إنَّها أول مرةٍ نتقابل فيها... لكن يبدو بأنني عرفت ما هوَ نوع شخصيتكِ

61
00:04:59,510 --> 00:05:01,910
.هذه رئيسة فصل هارواكي-كُن

62
00:05:02,850 --> 00:05:04,790
أوه، فهمت

63
00:05:06,660 --> 00:05:08,140
،قد أكون غرةٍ عليكِ

64
00:05:08,190 --> 00:05:09,630
.أعتمد عليكِ

65
00:05:10,050 --> 00:05:11,510
."إنَّها "قد أكون عبئًا

66
00:05:19,740 --> 00:05:21,800
.لقد كُشف أمري

67
00:05:22,150 --> 00:05:25,310
لا يجب على الرفاق أن يتشاجروا، حسنٌ؟

68
00:05:27,420 --> 00:05:31,440
.أعتقد بأنكِ اكتشفتِ الأمر، لذا قررت زيارتكم

69
00:05:31,900 --> 00:05:34,570
.أعتقد بأن هذه صفةٌ نتشارك فيها

70
00:05:35,060 --> 00:05:39,040
أنتِ من قتلتِ زبائن صالون التجميل، أليس كذلك؟

71
00:05:39,430 --> 00:05:41,160
،للأسف

72
00:05:44,050 --> 00:05:46,080
.وهكذا ستسكتشف السر بنفسك

73
00:05:46,130 --> 00:05:47,040
ماذا؟

74
00:05:47,090 --> 00:05:48,830
أليس هذا هو الرابط بينهم؟

75
00:05:50,700 --> 00:05:51,950
.الآلية الرابع عشرة

76
00:05:52,000 --> 00:05:54,800
!نموذج مخالب الوحوش: كف القطة

77
00:05:55,010 --> 00:05:57,010
!استدعاء اللعنة

78
00:05:57,650 --> 00:05:59,350
.لا مفر إذن

79
00:05:59,400 --> 00:06:01,510
.فقد حان الوقت للمرحلة الثانية من الخُطة

80
00:06:06,360 --> 00:06:08,810
!النمط: كوشينونيج مويوموري

81
00:06:11,700 --> 00:06:13,200
.شُكرًا لكِ، كوروي

82
00:06:13,250 --> 00:06:16,750
إذن، ما هو المكان الذي سنحسم أمورنا فيه؟

83
00:06:16,800 --> 00:06:18,860
.لا بأس بأي مكانٍ بالنسبة لي

84
00:06:19,300 --> 00:06:20,490
!قفي مكانك

85
00:06:20,540 --> 00:06:21,250
!كونوها

86
00:06:21,300 --> 00:06:22,250
!ابقى في مكانك

87
00:06:22,300 --> 00:06:24,830
!لا أرغب بأن أنشغل في البحث عنكَ في أنقاض المعركةٌ مُجددًا

88
00:06:24,880 --> 00:06:25,730
...فيار

89
00:06:26,800 --> 00:06:28,000
.توخى الحذر

90
00:06:31,400 --> 00:06:32,500
...هذا مُريب

91
00:06:32,550 --> 00:06:34,150
لِمَ كسرت الزُجاج؟

92
00:06:34,200 --> 00:06:38,910
ما سبب افتعالها تلك المعركة والهروب فور إعلانها؟

93
00:06:38,960 --> 00:06:40,620
،قد يكون مُجرد حدس

94
00:06:40,670 --> 00:06:43,260
لكن ألا تظن بأنَّها استطاعت تفريقنا بسهولة؟

95
00:06:45,310 --> 00:06:47,610
يبدو بأنكِ سريعة البديهة، أليس كذلك؟

96
00:06:47,660 --> 00:06:49,770
.ليست كما لو أنها مُشكلةٌ بالنسبة لي

97
00:06:49,820 --> 00:06:50,390
!هارو

98
00:06:50,440 --> 00:06:53,600
.لينتقل الروح والجسد لعالم الآخر

99
00:06:57,580 --> 00:06:58,360
!كوروي

100
00:06:59,080 --> 00:06:59,730
!ياشي

101
00:07:01,980 --> 00:07:05,200
.لن أقوم بأي تحركاتٍ مُريبة لو كُنت مكانكَ

102
00:07:05,690 --> 00:07:08,030
ما الذي ستفعلينه بنا؟

103
00:07:08,080 --> 00:07:11,660
.كُلّ ما أُريده هو رهينة

104
00:07:11,710 --> 00:07:14,460
،لا داعي للقلق بشأن كوروي-ساما

105
00:07:14,510 --> 00:07:17,020
،كُلّ ما فعلته هو إصابتها بالشلل

106
00:07:17,070 --> 00:07:18,960
.تسطيع التحكم بعينها وفمها

107
00:07:19,010 --> 00:07:20,850
...شُكرًا لكِ على هذا

108
00:07:20,900 --> 00:07:23,050
...دعي الرئيسة تذهب

109
00:07:28,500 --> 00:07:34,750
.قومي بأيّ حركةٍ مُريبة وسأحوله لعصير رُمان

110
00:07:36,500 --> 00:07:37,350
.حسنٌ

111
00:07:37,400 --> 00:07:38,440
.قومي بفعل ما تُريدين

112
00:07:41,700 --> 00:07:45,800
حاليًا، هلّا دخلتم هذه الحاوية؟

113
00:07:47,810 --> 00:07:50,150
،يا لهُ من مسكنٍ مُذهل ورائع

114
00:07:50,200 --> 00:07:52,890
!إن الأرضية والبرودة التي به هيَ الأفضل

115
00:07:53,730 --> 00:07:55,830
.ضعي هذا على قدمكِ وأرجلكِ

116
00:07:59,560 --> 00:08:01,550
أتريدين بعضًا من العصير الدافئ؟

117
00:08:04,100 --> 00:08:05,550
.لقد فهمت

118
00:08:08,260 --> 00:08:09,840
.والآن قد حان دورك

119
00:08:12,550 --> 00:08:13,690
.أعتذر على تأخري

120
00:08:14,160 --> 00:08:16,190
.إذن، دعونا نبدأ هذه الأُمسية

121
00:08:17,500 --> 00:08:19,100
.سنقوم بتسجيل فيديو

122
00:08:19,510 --> 00:08:20,690
.إذن، دعونا نبدأ

123
00:08:22,220 --> 00:08:23,590
،والآن، فيار-ساما

124
00:08:24,460 --> 00:08:27,320
،إن كُنت تُريدين عودة هؤلاء الثلاثة سالمين

125
00:08:27,920 --> 00:08:29,700
...فسوف يكون عليكِ

126
00:08:30,170 --> 00:08:33,080
.أن تعديني بالانضمام إلينا

127
00:08:33,550 --> 00:08:35,050
!هل فهمتِ يا فيار؟

128
00:08:35,590 --> 00:08:36,900
.كّلا، كّلا

129
00:08:36,970 --> 00:08:38,420
...لم تفهم

130
00:08:38,890 --> 00:08:40,200
...فـ فيار-ساما

131
00:08:40,220 --> 00:08:41,250
ماذا تقولين؟

132
00:08:41,720 --> 00:08:44,300
.لا خلاص بلا مُعانة

133
00:08:44,890 --> 00:08:47,880
.فكر بأمر جرائم القتل تلك

134
00:08:49,080 --> 00:08:53,930
.بدلاً منها فكر بأنكَ تحتاج لأن تخوض العديد من المآسي والمُعانة كيَ تجد الحقيقة

135
00:08:54,400 --> 00:08:55,810
!ما الذي تحاولين قوله؟

136
00:08:57,930 --> 00:09:02,190
...هذه تمامًا... تمامًا كـ العائلة

137
00:09:03,500 --> 00:09:06,070
...فبجانبكِ معنا

138
00:09:06,620 --> 00:09:08,310
...فقد بإمضاء الوقت معنا

139
00:09:08,920 --> 00:09:11,500
...فقط تشربين الشاي معنا

140
00:09:11,550 --> 00:09:12,070
...فقط

141
00:09:12,670 --> 00:09:14,580
...لن يجعلكِ تقبلين بنا

142
00:09:15,160 --> 00:09:18,210
...كـ جزءٍ من عائلتك

143
00:09:18,800 --> 00:09:20,250
.هذا صحيح

144
00:09:20,300 --> 00:09:23,970
.نحن نرغب بأن نكون جزءًا من عائلتك

145
00:09:24,760 --> 00:09:26,690
.عائلتُكِ الرائعة هذه

146
00:09:26,860 --> 00:09:29,250
.عائلتكِ التي لا تملك أيّ فردٍ بشري

147
00:09:29,270 --> 00:09:30,390
...العائلة

148
00:09:30,540 --> 00:09:31,970
!العائلة هيَ الحُب

149
00:09:32,530 --> 00:09:34,470
!العائلة هيَ الخلاص

150
00:09:34,520 --> 00:09:36,100
!العائلة هيَ التقبل فيما بينهم

151
00:09:36,820 --> 00:09:39,850
!وهذا لأجل أن تكون العائلة عائلة

152
00:09:42,230 --> 00:09:46,540
،نحن نملكٌ موقفًا في غاية البساطة

153
00:09:49,660 --> 00:09:50,740
...نحن

154
00:09:51,250 --> 00:09:53,320
،عائلة بيفوريو

155
00:09:53,870 --> 00:09:57,520
.نقبل بوجود كُل الواس

156
00:10:00,300 --> 00:10:02,320
تقبلون بوجود كُل الواس؟

157
00:10:03,350 --> 00:10:04,240
.أجل

158
00:10:04,370 --> 00:10:07,020
.كُل شيءٍ مُتعلق بالواس وكُل ما يُربطُ به

159
00:10:07,390 --> 00:10:10,470
.وطبعًا نقبل بلعناتهم

160
00:10:11,210 --> 00:10:16,360
.نحن نقبل باللعنة التي خلقت أمثالكِ من ذويَ الرُتب العالية

161
00:10:17,270 --> 00:10:19,840
،بمقدوركِ أن تستخدمي لعنتكِ

162
00:10:19,840 --> 00:10:22,350
.بالطريقة التي تُريدينها وعلى من تُريدين

163
00:10:23,230 --> 00:10:24,730
،نحن نعترف بكِ

164
00:10:25,410 --> 00:10:26,240
،نقبلكِ

165
00:10:26,910 --> 00:10:29,720
،إن كانت لعنتكِ تُلزمُكِ على القتل

166
00:10:29,770 --> 00:10:31,640
.فحينها تفضلي واقتلي من تُريدين

167
00:10:32,200 --> 00:10:34,750
،إن كانت لعنتكِ تجعل مالكها يُجَنّ

168
00:10:34,800 --> 00:10:36,740
.حينها تفضلي واجعليه مجنونًا

169
00:10:37,250 --> 00:10:40,510
،وإن كانت لعنتكِ تجعلكِ تأخذين حياة مالككِ

170
00:10:40,560 --> 00:10:41,370
...فحينها تفضلي

171
00:10:41,920 --> 00:10:44,390
.تفضلي وخُذيّ حياته

172
00:10:44,930 --> 00:10:46,300
...هذا لا يجعلني سعيدة

173
00:10:46,700 --> 00:10:48,250
.على الأقل لا يجعلني أنا سعيدة

174
00:10:48,300 --> 00:10:49,490
.ولا حتى قليلاً

175
00:10:50,260 --> 00:10:53,680
.أن تُحب الواس بشكلٍ تام

176
00:10:54,270 --> 00:10:58,600
.هذا هوَ شرط القبُول في عائلتنا

177
00:10:59,150 --> 00:11:02,640
.أجل، لذا هُناكَ بعضٌ أفراد عائلتي يتعاونون معي

178
00:11:03,730 --> 00:11:04,600
يتعاونون؟

179
00:11:05,900 --> 00:11:11,030
.أجل، فـ كُلّ أفراد عائلتنا مُستعدون للموت بلا أيّ ندم

180
00:11:12,160 --> 00:11:13,370
!كفى هراءً

181
00:11:13,420 --> 00:11:14,360
ما هذا؟

182
00:11:14,410 --> 00:11:15,530
!ما هذا الشيء بحق؟

183
00:11:15,580 --> 00:11:18,050
!مُحال! أيعقل بأن هذا هو العاملُ المُشترك؟

184
00:11:18,210 --> 00:11:20,120
.أجل، أنتَ مُحق

185
00:11:21,270 --> 00:11:22,430
...هكذا إذن

186
00:11:22,480 --> 00:11:25,850
.زبائن صالون كوروي لم يُقتلوا

187
00:11:26,130 --> 00:11:29,200
!لقد كانوا يأتون لها كيَ يموتوا

188
00:11:30,510 --> 00:11:33,130
.بخصوص هذا هُناكَ أمرٌ آخر

189
00:11:33,750 --> 00:11:36,930
.جميعهنَ كُنَ يرتدينَ الصليب

190
00:11:36,980 --> 00:11:39,390
أكان هذا مُبهمًا بالنسبة لكم؟

191
00:11:39,440 --> 00:11:48,270
.لقد كُنا نُريد أن نُريكِ يا فيار-ساما مقدار الألم الذي ننوي تحمله لأجلكِ

192
00:11:48,740 --> 00:11:52,170
.لم أستوعب الأمور مُجملاً، ولكن لديّ سؤال

193
00:11:52,420 --> 00:11:55,530
ما الهدف من أخذ أجزاءٍ منهم؟

194
00:11:55,970 --> 00:11:59,500
طابخة آكلي البشر

195
00:11:55,970 --> 00:11:59,500
.أوه... طريقة عمل كانيّبال كووكير بسيطةٌ للغاية

196
00:11:59,550 --> 00:12:03,300
.تشعر بالرغبة بقتل أحدهم وتناوله

197
00:12:03,470 --> 00:12:05,420
،وبهذا فيار-ساما

198
00:12:05,470 --> 00:12:09,540
هل استوعبتِ موقفكِ الحالي؟

199
00:12:09,590 --> 00:12:11,340
،عندما تقومين بتصفية عقلكِ

200
00:12:11,390 --> 00:12:14,900
.تفضلي رجاءً بزيارة المكان المُعلم على الخريطة

201
00:12:15,520 --> 00:12:17,050
.فسأكون موجودةً للترحيب بكِ

202
00:12:18,080 --> 00:12:19,420
.نرفض هذا

203
00:12:19,470 --> 00:12:21,210
!أجل، أرفض هذا

204
00:12:38,640 --> 00:12:39,910
.والآن جميعكم

205
00:12:39,960 --> 00:12:42,800
.لتشعروا بالراحة بفعل ما تشاؤون

206
00:12:48,940 --> 00:12:51,780
كوروي، أبمقدوركِ أن تتحكمي بشعركِ؟

207
00:12:51,830 --> 00:12:54,300
.إن كُنت قادرةً على هذا، كُنت لأستغله مُنذ مدة

208
00:12:55,340 --> 00:12:56,210
أليس كذلك؟

209
00:12:56,550 --> 00:12:59,470
ياشي، أهناك أيّ ثغرةٍ على الباب؟

210
00:13:11,240 --> 00:13:12,740
...هُناكَ واحدة

211
00:13:12,790 --> 00:13:13,810
.دعيني أُساعدكِ

212
00:13:23,910 --> 00:13:25,250
...كيف تجُرؤ

213
00:13:25,380 --> 00:13:27,450
.باستغلال الفُرصة كيّ تعبث بتنورتي

214
00:13:27,500 --> 00:13:29,080
!انتظري قليلاً

215
00:13:29,130 --> 00:13:31,170
!لقد كُنت أُساعدكِ، لم أنوي العبث أصلاً

216
00:13:35,520 --> 00:13:37,760
.أوه... أهذا ما يُدعونه بتفاعل العُشاق

217
00:13:37,810 --> 00:13:39,970
!كما قُلت فهذا مُجرد حادثٍ بسيط

218
00:13:45,240 --> 00:13:46,320
...أنت

219
00:13:47,130 --> 00:13:48,680
.هادئ

220
00:13:48,730 --> 00:13:50,010
أحقًا؟

221
00:13:50,060 --> 00:13:51,820
.أعتقد بأن هذا أمرٌ عادي

222
00:13:51,870 --> 00:13:54,300
ألا تعتقد بأنَّهُ أمرٌ أغرب من العادي؟

223
00:13:54,350 --> 00:13:56,170
.لقد تم حبسُنا

224
00:13:56,220 --> 00:13:58,240
.إنَّ هارو يبدو كـ رجلٍ مُسن

225
00:13:58,290 --> 00:14:02,360
.إن عُمره الروحي كافٍ بالفعل كيّ يكون رئيسًا لكهنة إحدى المعابد

226
00:14:02,410 --> 00:14:05,070
.في الحقيقة... هذا لأنَّهُ لا يوجد شيءٌ لكيّ أفعله

227
00:14:05,120 --> 00:14:07,350
.فكل ما علينا فعله هوَ الانتظار

228
00:14:09,580 --> 00:14:12,400
.لكن إن كُنت لوحدي كُنتَ سـ أُصاب بنوبة ذُعر

229
00:14:12,790 --> 00:14:16,250
.سبب هدوئي هذا هو تواجدكِ أيتها الرئيسة وكوروي

230
00:14:16,860 --> 00:14:18,000
.لقد ساعدتماني

231
00:14:19,190 --> 00:14:20,200
فهمت

232
00:14:21,750 --> 00:14:23,680
.أنا أشعر بالمثل كذلك

233
00:14:23,960 --> 00:14:25,900
.بوجودكَ هُنا لقد ساعدتني

234
00:14:26,460 --> 00:14:31,140
.لكني أنا الشخص الوحيد الذي سيُساعدكِ بشكلٍ حقيقي

235
00:14:31,190 --> 00:14:32,900
مـ- من أنت؟

236
00:14:33,030 --> 00:14:34,000
كيف دخلت؟

237
00:14:34,230 --> 00:14:35,650
.لم أُلاحظه البتّة

238
00:14:37,450 --> 00:14:39,390
...تقولان كيف

239
00:14:39,440 --> 00:14:42,200
.فتحت الباب ودخلت بشكلٍ طبيعي

240
00:14:42,520 --> 00:14:46,900
.هذه الواس تقوم بإخفاء وجود مالكها

241
00:14:47,260 --> 00:14:52,250
.سُميت على اسم الرجل الذي ارتداها لأول مرة

242
00:14:53,050 --> 00:14:55,040
.إنَّهُ يدعي بـ باسيتلي

243
00:14:55,090 --> 00:14:57,220
...إذن، كيف دخلت هُنا

244
00:14:57,270 --> 00:14:58,530
.صحيح

245
00:14:58,580 --> 00:15:01,670
،هذا القناع لا يقوم بإخفاء وجودك فحسب

246
00:15:01,720 --> 00:15:05,000
.لكنَّهُ يقوم بإخفاء والتغاضي عن أفعال مالكه كذلك

247
00:15:05,130 --> 00:15:10,060
.تستحق مئة نُقطةٍ على ما قدمته لي من استماع جيّدٍ لكلامي، ياشي-كُن

248
00:15:10,610 --> 00:15:12,390
أنّى لكَ معرفة اسمي؟

249
00:15:14,080 --> 00:15:16,410
...يبدو بأن كيريكا لم تُخبركَ بعد

250
00:15:16,460 --> 00:15:17,890
...كما هوَ متوقعٌ من

251
00:15:17,940 --> 00:15:18,860
!اخرس

252
00:15:19,480 --> 00:15:23,550
،أجل، أنا عضوٌ في مملكة الأبحاث

253
00:15:23,900 --> 00:15:26,440
.كما أني شريكٌ لـ إينو كيريكا

254
00:15:26,490 --> 00:15:31,580
لهذا السبب بالذات أعلمتكِ بأن لا تتدخلي مع العائلات، صحيح؟

255
00:15:33,330 --> 00:15:38,320
.اسم تلك المرأة آليس بيبوليو باسكريجا

256
00:15:38,970 --> 00:15:41,280
.والدة الكنائس

257
00:15:41,330 --> 00:15:45,700
.كما أنَّها البداية أيضًا A هيَ أول امرأة تُلقب بـ

258
00:15:46,080 --> 00:15:48,720
،كما أنَّها المُؤسسة للعائلات

259
00:15:49,180 --> 00:15:55,250
.إن كان الجنون يُعمَ في منطقةٍ بوجودها فهذا يُعدَ أمرًا طبيعيًا

260
00:15:56,130 --> 00:16:00,750
.لكن أن تجعليه يرى سركِ لهيَ مُخاطرةٌ عالية، كيريكا

261
00:16:01,940 --> 00:16:03,110
لقد رأيتهم، صحيح؟

262
00:16:04,680 --> 00:16:06,650
أيعقل بأن هذا قد أثارك؟

263
00:16:06,700 --> 00:16:08,870
.حياتكَ بهذا ستكون في غاية البؤوس

264
00:16:08,920 --> 00:16:10,290
!كُف عن الهُراء

265
00:16:10,340 --> 00:16:14,250
...أنت هو السبب الذي جعل الرئيسة تتحمل وتصبر

266
00:16:15,480 --> 00:16:17,150
.إذن، اسمح لي بسؤال

267
00:16:17,200 --> 00:16:19,710
ما هوَ سبب تواجدها في هذه الخزانة بالضبط؟

268
00:16:21,390 --> 00:16:22,590
!دع ياشي في الحال

269
00:16:27,310 --> 00:16:28,170
.أيها الطفل

270
00:16:28,220 --> 00:16:28,970
.كم هوَ مُزعج

271
00:16:34,430 --> 00:16:37,120
،سأشكرك لإنقاذي

272
00:16:37,170 --> 00:16:40,180
.لكني لن أُسامحكَ على ما فعلته لـ ياشي

273
00:16:40,230 --> 00:16:42,810
.لم أرغب حقًا بلمسه حقًا

274
00:16:42,860 --> 00:16:43,900
!اخرس

275
00:16:43,990 --> 00:16:45,190
.فُك وثاق ياشي بسرعة

276
00:16:45,240 --> 00:16:46,300
.كيريكا

277
00:16:46,580 --> 00:16:48,370
ما الذي تتحدثين عنه؟

278
00:16:48,800 --> 00:16:49,620
ماذا؟

279
00:16:49,670 --> 00:16:52,370
.لا أملك أيّ سببٍ لإنقاذه

280
00:16:52,900 --> 00:16:57,630
.بما أن هذه الفتاة واقعةٌ على تأثيرٍ مُعين فهيَ تُعامل نفس مُعاملة الفتى

281
00:16:57,680 --> 00:16:58,170
...أنت

282
00:17:03,260 --> 00:17:04,260
!الرئيسة

283
00:17:05,570 --> 00:17:08,000
.حسنٌ، هذا ما حدث

284
00:17:08,190 --> 00:17:09,500
.لا تحمل أيّ ضغينةٍ عليّ

285
00:17:09,780 --> 00:17:11,490
!أنا سأحمل وأحقد

286
00:17:11,540 --> 00:17:12,600
!ساعدنا

287
00:17:12,650 --> 00:17:15,230
!في المُقابل سأدعكَ تلمسني قليلاً

288
00:17:15,600 --> 00:17:17,610
.لست مُهتمًا بالأطفال

289
00:17:17,660 --> 00:17:19,230
...إن الرئيسة

290
00:17:21,100 --> 00:17:23,990
...أرجو بأن تعتني بالرئيسة رجاءً

291
00:17:25,960 --> 00:17:27,960
.يا لكَ من رجلٍ غريب

292
00:17:28,010 --> 00:17:32,000
.لا تعلم حتى أن كُنتَ ستعيش للغد أم لا

293
00:17:43,410 --> 00:17:44,410
!هيمورا

294
00:17:44,460 --> 00:17:45,730
استيقظتِ للتو؟

295
00:17:45,780 --> 00:17:47,300
ما هيَ حالتكِ الآن؟

296
00:17:47,350 --> 00:17:48,350
.عُد

297
00:17:48,520 --> 00:17:52,340
.من يعلم ما الذي ستفعله تلك المرأة بـ ياشي

298
00:17:53,550 --> 00:17:55,310
.لكن لا دخل لي

299
00:17:55,660 --> 00:17:56,560
ماذا؟

300
00:17:56,610 --> 00:17:57,890
،العائلات

301
00:17:57,940 --> 00:17:59,410
،منزل عائلة ياشي

302
00:17:59,460 --> 00:18:01,100
.فيار إينكويب

303
00:18:01,480 --> 00:18:04,960
.أتساءل حقًا كيف ارتبطت هذه الأشياء الثلاثة ببعضها

304
00:18:06,020 --> 00:18:08,440
.هذه الارتباطات هيَ عملي

305
00:18:09,290 --> 00:18:11,550
...إذن، فكُل شيءٍ لأجل أبحاثك

306
00:18:11,600 --> 00:18:13,050
.هذا أكيد

307
00:18:13,380 --> 00:18:14,800
...إذن

308
00:18:15,300 --> 00:18:17,300
.إذن، فنحن مُجرد أدوات

309
00:18:17,550 --> 00:18:18,710
.لذاك الرجل

310
00:18:18,760 --> 00:18:22,400
.فالبداية كُنا نحن صانعيَ هذه الأدوات

311
00:18:22,750 --> 00:18:25,310
.أجزاءٌ منا، وطمعنا

312
00:18:25,360 --> 00:18:27,100
...لا شيء تغير عن السابق

313
00:18:27,150 --> 00:18:28,340
.هذا يكفي

314
00:18:28,390 --> 00:18:29,850
!لقد اكتفيت

315
00:18:29,900 --> 00:18:31,150
!لقد سئمت مما يحدث

316
00:18:31,390 --> 00:18:32,710
.لقد سئمت من ياميماجاري باكواكي

317
00:18:32,760 --> 00:18:34,140
.وسئمت من مملكة الأبحاث

318
00:18:34,190 --> 00:18:35,370
!كما سئمت منك

319
00:18:35,420 --> 00:18:37,810
!سئمت من هذا الهُراء بأكمله

320
00:18:50,240 --> 00:18:55,650
،إن لم أقدر على إنقاذ الرجل الذي أُحبه لهذه الأسباب

321
00:18:56,120 --> 00:18:59,500
.حينها لن أعرف السبب الذي أستمر للعيش لأجله

322
00:19:00,540 --> 00:19:05,200
.هذا الأمر برمته مُجرد مهزلة

323
00:19:14,470 --> 00:19:15,310
.آسفة

324
00:19:15,360 --> 00:19:16,850
...أنا وحدي

325
00:19:16,900 --> 00:19:18,670
.لا داعي للاعتذار

326
00:19:18,720 --> 00:19:22,600
بمعنى آخر، فلقد خرجتي من مملكة الأبحاث، صحيح؟

327
00:19:23,710 --> 00:19:25,110
.على ما يبدو

328
00:19:25,160 --> 00:19:27,230
أأنتِ بخير الآن؟

329
00:19:27,480 --> 00:19:28,450
.أجل

330
00:19:28,500 --> 00:19:30,070
.يبدو بأني تعافيت

331
00:19:30,120 --> 00:19:31,600
.جاهزةٌ للذهاب في أيّ وقت

332
00:19:33,100 --> 00:19:34,290
،صدر البقرة

333
00:19:34,790 --> 00:19:37,240
.لديّ معروفٌ أطلبه منكِ

334
00:19:37,290 --> 00:19:38,540
.اضربيني

335
00:19:39,410 --> 00:19:41,500
.لقد أخطئت

336
00:19:41,550 --> 00:19:42,900
،اشتبهت بكوروي

337
00:19:42,950 --> 00:19:44,740
.كما أني رغبت بحبسها

338
00:19:44,790 --> 00:19:46,040
أأنتِ جادة؟

339
00:19:46,090 --> 00:19:47,100
.أجل

340
00:19:47,150 --> 00:19:49,260
.لذا اضربيني وأنتِ جادة

341
00:19:50,350 --> 00:19:52,150
.إذن، سأُحقق أمنيتكِ هذه

342
00:19:55,730 --> 00:19:57,670
مـ- ما الذي تقومين به؟

343
00:19:57,720 --> 00:19:59,560
!سألعنكِ... سألعنكِ

344
00:20:01,450 --> 00:20:05,580
.للأسف، فهذا ما بمقدوري فعله حاليًا

345
00:20:05,630 --> 00:20:07,980
.سندع الباقي لـ كوروي-سان عندما تعود

346
00:20:08,700 --> 00:20:11,000
.ما حدث قد حدث ومضى

347
00:20:11,190 --> 00:20:12,750
.المُشكلة فيما سيحدث

348
00:20:13,270 --> 00:20:14,490
.أعلم هذا

349
00:20:14,840 --> 00:20:18,650
.سأستخدم كُل ما أملكه، وأفعل ما هوَ ضروري

350
00:20:18,700 --> 00:20:21,750
.وما أُخذ مني سأخذه

351
00:20:23,980 --> 00:20:25,690
،فيار-كُن، كونوها-كُن

352
00:20:25,840 --> 00:20:29,250
إن كان ياشي يملك القوة، فماذا ستكون؟

353
00:20:29,300 --> 00:20:31,510
هارواكي-كُن يملك قوة؟

354
00:20:31,560 --> 00:20:34,250
.لكنَّهُ مُجرد بشريٍّ عادي

355
00:20:34,300 --> 00:20:36,970
رُبما عدم عمل اللعنات عليه، وكونَّهُ مُنحرفًا؟

356
00:20:37,020 --> 00:20:40,180
،لا تنسيّ طيبّته، وأنانيته

357
00:20:40,230 --> 00:20:41,600
.كما أنَّهُ ماهرٌ في الطهو

358
00:20:43,440 --> 00:20:46,380
.ياشي هارواكي يملك أصدقاءً مثلنا

359
00:20:46,430 --> 00:20:49,390
.مثلي، ومثلكما

360
00:22:31,380 --> 00:22:32,920
.صباح الخير

361
00:22:33,480 --> 00:22:36,400
.إن فُزنا سنستعيد هارواكي

362
00:22:36,780 --> 00:22:40,800
.وإن فُزتِ بمقدوركِ أخذي

363
00:22:40,990 --> 00:22:44,700
.فيار-ساما، لقد كانت هذه هيَ رغبتي

364
00:22:44,900 --> 00:22:47,260
،بأن أستمر وأظل أُلعن مرارًا وتكرارًا

365
00:22:47,310 --> 00:22:49,810
.حتى يُزال وجودي من بين بني جنسي

366
00:22:50,650 --> 00:22:52,810
.أجل، تمامًا مثلكِ

367
00:22:53,530 --> 00:22:56,800
.لا أحد سوى الحمقى يرغبوا بأن يُلعنوا

368
00:22:56,990 --> 00:22:58,880
!الآلية الرابع عشرة

369
00:22:58,930 --> 00:23:02,710
.نموذج مخالب الوحوش: كف القطة

370
00:23:25,100 --> 00:23:26,650
.الفصل الثاني عشر

371
00:23:26,950 --> 00:23:29,420
.التسامي قد يكون موجودًا في أيّ مكان

372
00:23:29,650 --> 00:23:31,540
!شاهدوها أو سألعنكم