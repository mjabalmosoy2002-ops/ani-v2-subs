1
00:00:01,180 --> 00:00:04,480
،بمجرّد انتهاء العطلة الصّيفيّة
.نُدرك أنّها مرّت في غمضة عين

2
00:00:05,090 --> 00:00:07,660
.لم أنُهِ كلّ واجباتي المدرسيّة الصّيفيّة حتّى

3
00:00:07,660 --> 00:00:11,160
!فعلاً؟! لكنّ الدّراسة بدأت قبل أسبوعين

4
00:00:11,160 --> 00:00:12,940
مرحبًا؟

5
00:00:12,940 --> 00:00:15,200
هلاّ استمعتُم لي؟

6
00:00:15,200 --> 00:00:18,470
أعطوني أفكارًا عمّا نقوم به
!في المهرجان المدرسيّ

7
00:00:18,470 --> 00:00:19,960
!حسنًا

8
00:00:26,580 --> 00:00:28,920
تسوناغو، أجاهز للغداء؟

9
00:00:28,920 --> 00:00:32,580
.سأذهب لإعادة هذا الكتاب
.اذهبا إلى السّطح بدوني

10
00:00:32,590 --> 00:00:33,650
.مفهوم

11
00:00:33,650 --> 00:00:35,840
.أحتاج للتّحقّق من أمر ما

12
00:00:35,840 --> 00:00:37,750
.حسنًا، حسنًا. استمتعا بوقتكما

13
00:00:37,750 --> 00:00:38,840
!أكيد

14
00:00:53,110 --> 00:00:55,480
.القليل فقط

15
00:00:55,480 --> 00:00:59,200
—ليتني لم أتكاسل وأحضرتُ السّلّم

16
00:01:01,520 --> 00:01:02,450
هذا؟

17
00:01:03,330 --> 00:01:04,500
.نعم

18
00:01:06,200 --> 00:01:07,370
.شكرًا

19
00:01:07,770 --> 00:01:10,370
.لا بدّ أنّه من الرّائع أن يكون المرء طويلاً

20
00:01:10,370 --> 00:01:11,760
.مهلاً لحظة

21
00:01:11,760 --> 00:01:13,340
.سأذهب لأستعير هذا الكتاب

22
00:01:16,430 --> 00:01:18,600
!ماذا؟ إنّه وحشيّ

23
00:01:18,600 --> 00:01:21,230
!مهلاً، الزم الهدوء وأنت في المكتبة

24
00:01:21,230 --> 00:01:23,010
!حا-حاضر، أنا آسف

25
00:01:23,270 --> 00:01:25,500
!لنغادر إن عثرت على الكتاب

26
00:01:25,500 --> 00:01:27,360
!مهلاً، انتظر

27
00:01:28,120 --> 00:01:33,660
.آ-آسفة. ظننتُ أنّهم قد يرونا معًا

28
00:01:34,020 --> 00:01:37,800
...لكن عندما اختبأت، صرنا أقرب

29
00:01:37,800 --> 00:01:39,660
.لا عليك، لا بأس بذلك

30
00:01:39,660 --> 00:01:42,710
فعلاً؟ ألا بأس برائحتي؟

31
00:01:46,260 --> 00:01:47,870
.بكلّ تأكيد

32
00:01:50,960 --> 00:01:53,460
.لنذهب. يوكيهيرو ينتظرنا

33
00:03:26,340 --> 00:03:29,220
.لا أستطيع الخروج من مزاج العطلة الصّيفيّة

34
00:03:29,220 --> 00:03:32,600
سيصيح الجوّ باردًا جدًّا على
.الأكل هنا على السّطح قريبًا

35
00:03:32,600 --> 00:03:34,540
.أتساءل إن كان هنالك مكان جيّد آخر

36
00:03:34,540 --> 00:03:36,100
.من الأفضل أن يكون مكانًا هادئًا أيضًا

37
00:03:36,100 --> 00:03:39,490
.لا يسعني إلاّ التّفكير بهيداكا-كُن

38
00:03:40,260 --> 00:03:42,110
...لكنّ هيداكا-كُن

39
00:03:42,570 --> 00:03:48,990
يبدو أنّه يتصرّف بشكل طبيعيّ أكثر
.قربي وقرب رائحتي مقارنة بالسّابق

40
00:03:50,260 --> 00:03:51,750
.أظنّ ذلك

41
00:03:52,670 --> 00:03:54,870
.ربّما يكون الفضل لأنّنا تدرّبنا

42
00:03:55,200 --> 00:03:59,910
إذا لم نعد مضطرّين للقلق
،بشأن كبح أنفسنا في أيّ لحظة

43
00:03:59,910 --> 00:04:01,950
...فسيكون ذلك أفضل

44
00:04:02,850 --> 00:04:04,630
...قليلاً فحسب

45
00:04:05,040 --> 00:04:11,800
لو أنّ الرّائحة الحلوة الّتي سحرت هيداكا-كُن
...في البداية صارت أمرًا عاديًّا بالنّسبة له

46
00:04:12,620 --> 00:04:16,160
...فكفتاة بشريّة عاديّة تمامًا

47
00:04:16,550 --> 00:04:19,910
هل بقي لديّ أيّ شيء قد يجذبه إليّ؟

48
00:04:20,310 --> 00:04:21,480
أساكا؟

49
00:04:22,840 --> 00:04:24,390
هل أنت بخير؟

50
00:04:24,390 --> 00:04:25,830
هل الجوّ بارد جدًّا هنا؟

51
00:04:26,450 --> 00:04:28,340
!لا، أنا بخير تمامًا

52
00:04:28,340 --> 00:04:30,220
!أعتقد أنّ لا بأس به

53
00:04:30,220 --> 00:04:31,330
فعلاً؟

54
00:04:31,700 --> 00:04:33,970
.أعتقد أنّه سيكون علينا إيجاد فصل فارغ

55
00:04:33,970 --> 00:04:36,950
ربّما سيكون فصل السّنة الأولى
...الّذي أمام الدّرج

56
00:04:36,950 --> 00:04:38,040
!إلى اللّقاء

57
00:04:38,040 --> 00:04:38,820
!مع السّلامة

58
00:04:38,820 --> 00:04:40,880
هل يشغل بالك شيء ما؟

59
00:04:42,140 --> 00:04:44,340
أكان واضحًا أنّي كنتُ شاردة؟

60
00:04:44,340 --> 00:04:45,760
.نوعًا ما

61
00:04:47,120 --> 00:04:48,510
هل حدث شيء ما؟

62
00:04:48,510 --> 00:04:53,310
سيكون من الغريب أن أسأله فجأة
إن كان لا يزال يجدني جذّابة، صحيح؟

63
00:04:53,800 --> 00:04:55,640
.لا أعتقد... ذلك

64
00:04:56,230 --> 00:04:57,620
.أشم رائحة كذب

65
00:04:57,620 --> 00:04:58,700
!أيمكنك معرفة ذلك؟

66
00:04:58,700 --> 00:04:59,650
.لا يمكنني

67
00:04:59,650 --> 00:05:01,400
...لا يمكنك إذًا

68
00:05:01,400 --> 00:05:02,520
!ها أنت

69
00:05:02,520 --> 00:05:03,660
!أساكا

70
00:05:05,430 --> 00:05:06,570
!كيسارا-سان؟

71
00:05:06,570 --> 00:05:10,660
.حمدًا على هذا. كنتُ خائفة ألاّ ألقاك

72
00:05:11,860 --> 00:05:14,160
ما الّذي تفعلينه هنا؟

73
00:05:14,160 --> 00:05:18,900
.أنا... أردتُ الذّهاب للتّسوّق مع أساكا
.لذلك السّبب أنا هنا

74
00:05:18,900 --> 00:05:20,050
معي؟

75
00:05:20,050 --> 00:05:23,340
.نعم... إن أردت

76
00:05:23,340 --> 00:05:27,410
قمتِ بحمايتي في ذلك اليوم
وأفسدتِ ربطة شعرك، صحيح؟

77
00:05:27,410 --> 00:05:30,930
،ظلّ ذلك يضايقني مذّاك الحين
...لذلك أردت إهداءك واحدة جديدة

78
00:05:30,930 --> 00:05:35,080
!واثقة تمامًا أنّي أستطيع اختيار واحدة ظريفة

79
00:05:35,720 --> 00:05:38,190
ظريفة...؟

80
00:05:38,400 --> 00:05:39,160
!هيّا بنا

81
00:05:39,160 --> 00:05:40,060
!مرحى

82
00:05:40,390 --> 00:05:44,320
قد أستطيع إيجاد شيء ما
!قد يجعله يظنّ أنّي جذّابة

83
00:05:44,320 --> 00:05:46,310
.اثنان، اثنان، ثلاثة، أربعة

84
00:05:46,310 --> 00:05:48,310
.ثلاثة، اثنان، ثلاثة، أربعة

85
00:05:48,310 --> 00:05:50,320
.أربعة، اثنان، ثلاثة، أربعة

86
00:05:50,320 --> 00:05:52,590
.خمسة، اثنان، ثلاثة، أربعة

87
00:05:50,870 --> 00:05:52,750
ما الخطب يا تسوناغو؟

88
00:05:53,260 --> 00:05:55,470
.غادرت كيسارا مع أساكا

89
00:05:55,470 --> 00:05:57,000
!ماذا؟! ولكن لماذا؟

90
00:05:57,640 --> 00:06:00,970
عندما أتت أساكا إلى مدينة
،الوحشيّين خلال العطلة الصّيفيّة

91
00:06:00,970 --> 00:06:02,610
.صارتا صديقتين

92
00:06:02,610 --> 00:06:05,300
ماذا؟ أهذا معقول؟

93
00:06:05,300 --> 00:06:09,000
كنتُ قلقًا لأنّ أساكا كانت
،تتصرّف بشكل غريب

94
00:06:09,560 --> 00:06:12,200
.لكنّها قرّرت الذّهاب مع كيسارا

95
00:06:13,880 --> 00:06:15,550
أتشعر الاكتئاب؟

96
00:06:15,550 --> 00:06:18,180
.كنتُ أتمنّى لو أنّها اعتمدت عليّ

97
00:06:18,180 --> 00:06:21,390
عجبًا. إنّك لا تُخفي أنّ ماري
.مهمّة جدًّا بالنّسبة لك

98
00:06:22,930 --> 00:06:24,350
.بالطّبع هي مهمّة

99
00:06:26,480 --> 00:06:28,780
أيّها تفضّلين أكثر؟

100
00:06:29,080 --> 00:06:32,470
بشرتك فاتحة لدرجة أنّ الأسوَد
.سيبرز عليك بشكل جميل

101
00:06:32,470 --> 00:06:34,450
أيّها أعجبك يا أساكا؟

102
00:06:34,450 --> 00:06:37,580
...عفوًا... أنا

103
00:06:37,580 --> 00:06:39,660
ماذا؟ هل من خطب ما؟

104
00:06:40,120 --> 00:06:44,120
...أيمكنني أن أسألك أيّها في رأيك

105
00:06:44,760 --> 00:06:46,540
قد يُعجب هيداكا-كُن؟

106
00:06:47,450 --> 00:06:49,230
.ليس عليك اختيار ما قد يحبّه هو

107
00:06:49,230 --> 00:06:51,370
.اختاري ما يليق بك أنت

108
00:06:51,370 --> 00:06:53,800
...ذلك ما سأفعل! ولكن

109
00:06:54,760 --> 00:06:59,180
.أريد أن يراني هيداكا-كُن كفتاة

110
00:07:00,940 --> 00:07:02,310
!تقولين ذلك الآن؟

111
00:07:02,950 --> 00:07:07,070
بعد أن صارت تفوح منكما رائحة
تقول "نحن نحبّ بعضنا بالتّأكيد"؟

112
00:07:07,070 --> 00:07:10,840
.صحيح. أعتقد أنّ البشر لا يعرفون ذلك

113
00:07:11,460 --> 00:07:14,840
لكن يجدر بك أن تعرفي ولو قليلاً
عندما تكونان معًا، صحيح؟

114
00:07:15,290 --> 00:07:16,440
...نعم

115
00:07:17,030 --> 00:07:20,270
...أعرف أنّه يهتمّ لأمري، ولكن

116
00:07:20,270 --> 00:07:25,060
.أريد أن يراني هيداكا-كُن أكثر كفتاة

117
00:07:25,060 --> 00:07:29,460
أوهنالك وقت محدّد ليرغب فيه المرء
أن يبدو جذّابًا في نظر من يحبّ؟

118
00:07:30,670 --> 00:07:33,910
.إنّك تبذلين جهدك دائمًا كلّما تحدّثتُ معك

119
00:07:33,910 --> 00:07:36,460
...أعلم أنّي ربّما أكون قد طلبتُ الكثير

120
00:07:36,820 --> 00:07:39,980
لا بأس في الرّغبة بأن تكوني
.ظريفة من أجله

121
00:07:40,330 --> 00:07:46,000
لكن أعتقد أنّ عليك أن تعرفي
أنّ الرّائحة من مشاعر تسوناغو

122
00:07:46,000 --> 00:07:48,180
.تُجاهك حلوة بشكل كبير أيضًا

123
00:07:48,640 --> 00:07:52,690
،إنّكما مقرّبان من بعض كثيرًا
.واثقة أنّكما ستكتشفان ذلك قريبًا

124
00:07:53,080 --> 00:07:56,150
.ذلك أيضًا لماذا وافقتُ على دعمكما

125
00:07:53,810 --> 00:07:57,480
.لا يمكنني رؤية ذلك، ولا الشّعور به

126
00:07:57,480 --> 00:08:01,580
.لكنّ مشاعرك تجاهي حقيقيّة

127
00:08:01,980 --> 00:08:05,750
.نعم، شكرًا لاستماعك لي يا كيسارا-سان

128
00:08:05,750 --> 00:08:09,330
.لا داعي لشكري حقًّا
!بالمناسبة، لنتبادل أرقام هواتفنا

129
00:08:12,120 --> 00:08:15,830
.ماري، يبدو شعرك مختلفًا اليوم وجديدًا

130
00:08:16,270 --> 00:08:18,710
.أردتُ فقط تغيير بعض الأمور قليلاً

131
00:08:18,710 --> 00:08:22,090
،تبذل الفتيات جهدًا كبيرًا في هذا
.إنّه أمر مذهل

132
00:08:22,580 --> 00:08:23,780
صحيح يا تسوناغو؟

133
00:08:23,780 --> 00:08:25,350
.نعم، ذلك صحيح

134
00:08:28,990 --> 00:08:31,240
!أيدا

135
00:08:31,240 --> 00:08:33,430
!حان وقت التّدريب

136
00:08:33,430 --> 00:08:34,810
.ياناغي-سِنباي

137
00:08:34,810 --> 00:08:37,630
سبق وأخبرتك أنّي لستُ مهتمًّا
!ما لم تكن كرة السّلّة

138
00:08:37,630 --> 00:08:42,200
!ماذا؟ أنت طبّاخ جيّد، لذلك ساعدنا

139
00:08:41,630 --> 00:08:44,160
!كم هذا مزعج

140
00:08:42,200 --> 00:08:43,480
الطّبخ؟

141
00:08:43,910 --> 00:08:47,270
أعتقد أنّ فريق كرة السّلّة سيطبخ
.ياكيسوبا في المهرجان المدرسيّ

142
00:08:44,160 --> 00:08:46,490
.لا بأس. لا بأس

143
00:08:47,550 --> 00:08:49,780
!لا أريد ذلك

144
00:08:48,180 --> 00:08:50,580
.هيّا، لنذهب

145
00:08:50,580 --> 00:08:54,210
،إن حصلنا على المركز الأوّل في فئة الطّعام
.سنحصل على تمويل إضافيّ للنّادي، لذا أرجوك

146
00:08:54,210 --> 00:08:56,910
!بئسًا، لا بأس! سأذهب

147
00:08:56,910 --> 00:08:58,630
مهلاً، هل تريدان المجيء أيضًا؟

148
00:08:58,630 --> 00:08:59,750
...أنا

149
00:09:02,480 --> 00:09:06,240
لدينا خُطط سلفًا، لذلك خذ
.يوكيهيرو فقط اليوم

150
00:09:09,280 --> 00:09:11,560
.حسنًا! إلى اللّقاء

151
00:09:14,000 --> 00:09:15,780
هيداكا-كُن؟

152
00:09:18,440 --> 00:09:20,200
!ما-ما الخطب؟

153
00:09:20,200 --> 00:09:22,540
.أردتُ أن أحرص ألاّ تهربي اليوم أيضًا

154
00:09:22,540 --> 00:09:24,610
،اعتدتُ أخيرًا على رائحتك

155
00:09:25,120 --> 00:09:27,780
...وظننتُ أنّ بإمكاننا أن نظلّ معًا أكثر

156
00:09:28,090 --> 00:09:29,540
.لذلك لا تتركيني

157
00:09:30,790 --> 00:09:34,540
...كنتُ أفكّر بنفسي كثيرًا

158
00:09:34,540 --> 00:09:38,180
.لم أبالي بقلب هيداكا-كُن على الإطلاق

159
00:09:38,180 --> 00:09:41,420
.أنا آسفة. لن أتركك

160
00:09:41,420 --> 00:09:43,030
.أنا أحبّك

161
00:09:52,600 --> 00:09:55,020
هل غيّرتِ شعرك اليوم بالفعل

162
00:09:55,020 --> 00:09:56,570
من دون سبب؟

163
00:09:56,570 --> 00:10:01,580
...أ-أردتُك أن تظنّ أنّي ظريفة
.لذلك غيّرته

164
00:10:01,580 --> 00:10:03,490
.نعم، أنت ظريفة

165
00:10:04,270 --> 00:10:06,320
.مع أنّي أعتقد أنّي أخبرك بذلك طوال الوقت

166
00:10:06,710 --> 00:10:10,420
كلّما ابتسمتِ، أو حتّى إن كنت
.متوتّرة، فإنّك تبدين ظريفة

167
00:10:10,420 --> 00:10:12,220
.أنا أحبّ كلّ شيء فيك

168
00:10:13,980 --> 00:10:16,330
حتّى بدون رائحتي؟

169
00:10:16,840 --> 00:10:19,710
،ربّما تكون رائحتك المغرية ما يجذبني إليك

170
00:10:20,510 --> 00:10:23,090
.لكنّ ذلك ليس ضروريًّا بالنّسبة لي لأحبّك

171
00:10:24,320 --> 00:10:25,090
.نعم

172
00:10:25,380 --> 00:10:32,100
المسافة بيننا مختلفة الآن، لكنّ
.قلبانا أقرب من أيّ وقت مضى

173
00:10:32,100 --> 00:10:33,060
.أساكا

174
00:10:33,750 --> 00:10:34,980
.ثمّة أمر واحد

175
00:10:34,980 --> 00:10:35,600
ماذا؟

176
00:10:37,360 --> 00:10:39,080
...عـ-عفوًا

177
00:10:39,780 --> 00:10:42,620
،بإمكاني كبح نفسي قليلاً الآن

178
00:10:42,620 --> 00:10:45,580
لكنّ ذلك لا يعني أنّ بإمكاني
.منع نفسي من لمسك

179
00:10:46,740 --> 00:10:50,480
ماذا؟ أليس المهرجان
المدرسيّ هو الفرصة الوحيدة؟

180
00:10:50,480 --> 00:10:55,120
،لن تكون إذًا إلاّ صورة تذكاريّة
.لذلك لن ينجح الأمر

181
00:10:57,380 --> 00:11:00,920
إنّنا نريد خبرًا حصريًّا حقيقيًّا
!بصفتنا جريدة المدرسة

182
00:11:01,130 --> 00:11:02,050
ماذا؟

183
00:11:02,640 --> 00:11:04,110
.أخافني هذا

184
00:11:05,180 --> 00:11:06,670
.مـ-مرحبًا

185
00:11:05,740 --> 00:11:07,080
.أهلاً

186
00:11:09,400 --> 00:11:11,350
.لقد أفزعني ذلك كثيرًا

187
00:11:11,350 --> 00:11:14,350
.لم أر وحشيًّا عن قرب هكذا من قبل

188
00:11:14,350 --> 00:11:14,900
.نعم

189
00:11:19,650 --> 00:11:22,510
...اعتقد أنّي وجدتُ قصّة ممتازة

190
00:11:26,270 --> 00:11:28,030
...حجر، ورقة

191
00:11:28,030 --> 00:11:29,030
!مقصّ

192
00:11:31,370 --> 00:11:34,940
!حسنًا. أيدا وأساكا هما فريق التّسوّق

193
00:11:35,440 --> 00:11:36,410
!سُحقًا

194
00:11:37,470 --> 00:11:40,420
تسوناغو، هلاّ ساعدتنا في التّسوّق؟

195
00:11:40,420 --> 00:11:43,660
.لا. أنا مشغول بواجباتي الخاصّة

196
00:11:43,660 --> 00:11:46,430
!مذهل، الزّينة الّتي وضعها هيداكا تبدو رائعة

197
00:11:46,430 --> 00:11:47,360
ما هذا؟

198
00:11:47,360 --> 00:11:49,230
!لإحداها جودة أعلى بكثير

199
00:11:49,230 --> 00:11:52,450
أنت قويّ وتجيد النّجارة ويمكنك الخياطة أيضًا؟

200
00:11:52,450 --> 00:11:53,720
!إنّك الأفضل بالفعل

201
00:11:53,720 --> 00:11:54,830
.مذهل

202
00:11:54,190 --> 00:11:55,930
!منقذ المهرجان المدرسيّ

203
00:11:55,930 --> 00:11:57,530
.هيداكا-كُن رائع بالفعل

204
00:11:57,530 --> 00:12:01,410
أنتم! لا تعتمدوا على تسوناغو
!فقط لأنّه شخص رائع

205
00:12:01,410 --> 00:12:03,030
!ماذا؟

206
00:12:03,350 --> 00:12:07,650
.طلبتَ منه المساعدة للتّوّ أيضًا يا أيدا

207
00:12:07,650 --> 00:12:08,780
فعلاً؟

208
00:12:10,520 --> 00:12:12,400
.يوكيهيرو-كُن، يوكيهيرو-كُن

209
00:12:13,020 --> 00:12:17,170
سأعمل بجهد مضاعف مكان
.هيداكا-كُن، لذلك لنذهب للتّسوّق

210
00:12:19,680 --> 00:12:22,410
...لم أرد الاعتماد عليه فحسب

211
00:12:22,410 --> 00:12:25,900
ظننتُ أنّنا سنستمتع بوقتنا
.أكثر نحن الثّلاثة معًا

212
00:12:25,900 --> 00:12:28,430
!نعم، أنت محقّ. أنا آسفة

213
00:12:29,930 --> 00:12:32,820
.إن كانت أغراضكما كثيرة، نادياني

214
00:12:34,000 --> 00:12:37,060
!يتجلّى لطفك بالكامل الآن! شكرًا لك

215
00:12:37,060 --> 00:12:37,690
.نعم

216
00:12:38,300 --> 00:12:39,430
.إلى اللّقاء

217
00:12:39,430 --> 00:12:41,430
.نعم، أراك لاحقًا

218
00:12:42,180 --> 00:12:43,960
...إنّنا نستعدّ للمهرجان المدرسيّ

219
00:12:44,320 --> 00:12:48,320
بالإمكان سماع الفوضى من كلّ
.فصل بينما نقوم بالتّجهيزات

220
00:12:48,820 --> 00:12:51,260
.إنّ هذا الحدث يكون فوضويًّا دائمًا

221
00:12:49,320 --> 00:12:51,870
!مهلاً! سوف يسقط

222
00:12:52,850 --> 00:12:53,930
...وأيضًا

223
00:12:53,930 --> 00:12:57,200
...هيداكا، بشأن الأزياء

224
00:12:58,780 --> 00:13:03,090
وها هو هيداكا-كُن ينسجم مع
.الجميع أكثر بعض الشّيء ثانية

225
00:13:03,820 --> 00:13:05,620
!ماري! لنذهب

226
00:13:05,620 --> 00:13:06,830
!حسنًا

227
00:13:12,620 --> 00:13:17,290
المعذرة! هل هيداكا-سان الوحشيّ هنا؟

228
00:13:19,690 --> 00:13:23,690
.واثق أنّنا سنستمتع أكثر في المستقبل

229
00:13:25,000 --> 00:13:28,570
سيقيم فصلنا مقهى بأسلوب قديم، صحيح؟

230
00:13:28,570 --> 00:13:30,320
.نعم، مقهى

231
00:13:30,320 --> 00:13:32,210
سيعدّ فريق كرة السّلّة الياكيسوبا، صحيح؟

232
00:13:32,210 --> 00:13:36,330
نعم. لكن قيل لتلاميذ السّنة الأولى
.أنّه يمكننا التّركيز على نشاطات فصلنا

233
00:13:37,300 --> 00:13:40,510
.مع أنّه عليّ المشاركة في تدريب الياكيسوبا

234
00:13:40,510 --> 00:13:41,580
...نعم

235
00:13:41,790 --> 00:13:44,420
...حسنًا، نحتاج الآن لأثواب و

236
00:13:44,420 --> 00:13:45,200
...نعم، نعم

237
00:13:45,200 --> 00:13:49,600
شريط لاصق للنّوافذ وأغطية
...فينيل للطّاولات

238
00:13:49,600 --> 00:13:52,350
.أعتقد أنّ ذلك غير موجود هنا

239
00:13:53,600 --> 00:13:54,880
.يبدو أنّك مستمتعة بهذا

240
00:13:54,880 --> 00:13:58,420
أليس من المثير أن نتمكّن من مغادرة
المدرسة في يوم دراسيّ للذّهاب للتّسوّق؟

241
00:13:58,420 --> 00:14:00,400
!صحيح، أفهم ما تقصدينه

242
00:14:00,400 --> 00:14:04,270
لكنّي لا أعرف ماذا أختار عندما
.يتعلّق الأمر بأشياء قديمة

243
00:14:04,700 --> 00:14:07,590
لا أعرف أيضًا أيّ نوع من الهدايا
.يمكنني تقديمه للآخرين

244
00:14:08,830 --> 00:14:11,750
بالمناسبة، أليس عيد ميلادك وشيك يا ماري؟

245
00:14:11,750 --> 00:14:14,440
.نعم. سأكون في السّادسة عشر

246
00:14:14,440 --> 00:14:16,230
.ذلك ممتاز

247
00:14:16,540 --> 00:14:18,860
.أخبريني ماذا تريدين إذًا

248
00:14:19,300 --> 00:14:21,170
.بما أنّي لا أجيد اختيار الهدايا

249
00:14:22,930 --> 00:14:24,110
أأنت واثق؟

250
00:14:24,110 --> 00:14:24,950
.نعم

251
00:14:26,400 --> 00:14:28,230
.طوق من أجل يوكي-تشان

252
00:14:29,140 --> 00:14:30,290
طوق؟

253
00:14:31,080 --> 00:14:33,710
.أحتاج لذوق جيّد لاختيار الطّوق الصّحيح أيضًا

254
00:14:33,710 --> 00:14:35,970
...ناهيك عن ذكر أنّه لأجل يوكيمي

255
00:14:35,970 --> 00:14:38,560
.لست بحاجة للتّفكير كثيرًا في ذلك

256
00:14:38,810 --> 00:14:44,430
،في الحقيقة، أنت من يساعدني دائمًا

257
00:14:44,430 --> 00:14:46,950
.لذلك أريد تقديم هديّة لك

258
00:14:47,420 --> 00:14:49,810
أنا؟ لكنّ عيد ميلادي بعد
.مدّة طويلة من الآن

259
00:14:50,160 --> 00:14:51,670
متى بالضّبط؟

260
00:14:51,670 --> 00:14:53,280
.الثّامن من ديسمبر

261
00:14:53,280 --> 00:14:57,210
.وُلدتَ في الشّتاء إذًا
أهنالك أيّ شيء بالتّحديد تريده؟

262
00:14:59,750 --> 00:15:00,670
.ماري

263
00:15:05,270 --> 00:15:07,710
.سأقبل بأيّ شيء تختارينه لي

264
00:15:09,220 --> 00:15:11,740
.حسنًا. سأبذل جهدي وأختار شيئًا ما

265
00:15:12,700 --> 00:15:13,960
.أتطلّع قدمًا لذلك

266
00:15:14,710 --> 00:15:16,790
.سأذهب لدفع ثمن هذه

267
00:15:16,790 --> 00:15:18,970
.سأضع كلّ شيء في كيس

268
00:15:18,970 --> 00:15:20,680
أين صندوق الدّفع...؟

269
00:15:20,680 --> 00:15:24,430
...ماذا؟ ها هي ذي ثانية

270
00:15:25,200 --> 00:15:27,430
...تلك الوقفة الفضوليّة

271
00:15:27,750 --> 00:15:31,110
،عندما نكون معًا نحن الثّلاثة

272
00:15:31,110 --> 00:15:35,360
يُظهر يوكيهيرو-كُن الكثير من
.الاهتمام لنكون جميعنا معًا

273
00:15:36,570 --> 00:15:39,320
...نصائحه لطيفة دائمًا

274
00:15:40,080 --> 00:15:41,110
...لكن

275
00:15:41,550 --> 00:15:44,580
أشعر أنّي بالكاد أحظى بفرصة لسماع

276
00:15:45,330 --> 00:15:47,590
.مشاعر يوكيهيرو-كُن الحقيقيّة

277
00:15:49,520 --> 00:15:52,090
،إن فكّرتَ في شيء ما تريده بشدّة

278
00:15:52,600 --> 00:15:54,080
فأطلعني عليه، موافق؟

279
00:15:54,720 --> 00:15:58,110
هل كنتُ أتصرّف بغرابة أو ما شابه؟

280
00:15:58,110 --> 00:16:02,220
!راودني الفضول فحسب

281
00:16:02,520 --> 00:16:05,790
.لكنّي قد أطلب شيئًا مستحيلاً

282
00:16:05,790 --> 00:16:06,900
.لا بأس بذلك

283
00:16:07,320 --> 00:16:09,650
،إن كان شيئًا بإمكاني فعلاً إهداءك إيّاه

284
00:16:10,150 --> 00:16:12,660
.أريد أن أختاره من قلبي

285
00:16:13,370 --> 00:16:14,690
.حسنًا

286
00:16:15,420 --> 00:16:18,610
أعتقد أنّه من المحرج ألاّ أستطيع
.التّعبير عن ذلك بالكلمات

287
00:16:19,250 --> 00:16:22,410
.سأخبرك بأكثر في المرّة القادمة

288
00:16:22,870 --> 00:16:26,660
.أعدك بأنّني سأخبرك بما أريده حينها

289
00:16:28,410 --> 00:16:30,950
هل أضغط أكثر من اللاّزم؟

290
00:16:30,950 --> 00:16:34,580
على الإطلاق. أنا مسرور
...لأنّك تهتمّين لأمري

291
00:16:34,580 --> 00:16:37,190
.وأنت الوحيدة الّتي بإمكانها دفعي

292
00:16:38,950 --> 00:16:41,860
...إنّ ثِقل كلمات يوكيهيرو-كُن

293
00:16:42,960 --> 00:16:44,890
.أعدك بخنصري

294
00:16:45,460 --> 00:16:48,230
.جعل صدري يضيق بعضًا الشّيء بغرابة

295
00:16:48,980 --> 00:16:51,860
!لقد عدنا! واشترينا بعض الأشياء

296
00:16:51,860 --> 00:16:54,780
.مرحبًا بعودتكما
أكان ذلك المال كافيًا؟

297
00:16:54,780 --> 00:16:56,160
.نعم، نعم

298
00:16:56,490 --> 00:16:58,780
بالمناسبة، أين تسوناغو؟

299
00:16:58,780 --> 00:17:02,250
.أتى فتى من جريدة المدرسة وذهب معه

300
00:17:02,670 --> 00:17:04,640
.قال شيئًا عن مقابلة ما

301
00:17:04,640 --> 00:17:08,500
ولكن بصراحة، إنّه نجمنا الحقيقيّ
...في صناعة كلّ الزّينة

302
00:17:09,010 --> 00:17:11,190
.لذلك آمل أن يعود قريبًا

303
00:17:11,190 --> 00:17:14,230
.إنّكم تعتمدون عليه كثيرًا

304
00:17:14,230 --> 00:17:17,870
في الحقيقة، كان ذلك الفتى من
.جريدة المدرسة يقف في طريقنا

305
00:17:17,870 --> 00:17:21,360
،لم يُرده هيداكا أن يزعجنا
.لذلك غادر الفصل معه

306
00:17:21,360 --> 00:17:22,760
...وبعدها صرنا جميعًا

307
00:17:22,760 --> 00:17:24,760
!استعملتُ اللّون الخاطئ

308
00:17:24,760 --> 00:17:27,750
أين يفترض وضع لوحة قائمة الطّعام؟

309
00:17:25,750 --> 00:17:27,180
.مشغولين أيضًا

310
00:17:27,750 --> 00:17:28,720
.ماري

311
00:17:29,400 --> 00:17:30,660
.اذهبي

312
00:17:32,960 --> 00:17:35,150
مقابلة؟

313
00:17:35,150 --> 00:17:36,810
.أتساءل ما الّذي يسألونه

314
00:17:37,210 --> 00:17:38,450
...إذًا

315
00:17:38,940 --> 00:17:43,570
كيف يبدو الأمر حين تنسجم مع البشر
وتشارك في مهرجان مدرسيّ بصفتك وحشيًّا؟

316
00:17:43,980 --> 00:17:46,020
هل يمكنك على الأقلّ أن تجيب عن هذا؟

317
00:17:46,020 --> 00:17:52,090
نحن البشر فضوليوّن جدًّا
.لمعرفة كيف يفكّر الوحشيّون

318
00:17:52,920 --> 00:17:57,780
أُعجبتُ فقط بمدى إتقان
.تصميم الدّيكور الدّاخليّ

319
00:17:57,780 --> 00:17:59,720
.ها أنت تقوم بهذا ثانية

320
00:17:59,720 --> 00:18:02,840
.أريد أن يكون المقال حماسيًّا

321
00:18:03,240 --> 00:18:06,470
هل يعجز الوحشيّون عن فهم تلميحات البشر؟

322
00:18:06,470 --> 00:18:07,420
!المعذرة

323
00:18:07,910 --> 00:18:09,100
!أنا آسفة

324
00:18:09,680 --> 00:18:12,240
،لكنّ المُدرّس يبحث عن هيداكا-كُن

325
00:18:13,140 --> 00:18:14,980
لذلك هل يستطيع الذّهاب الآن؟

326
00:18:14,980 --> 00:18:16,530
ماذا؟

327
00:18:16,530 --> 00:18:19,490
حتّى إن كانت كلّ أجوبته عاديّة
جدًّا وليست جيّدة للمقال؟

328
00:18:19,880 --> 00:18:21,030
...هيداكا-كُن

329
00:18:21,030 --> 00:18:22,190
.شكرًا

330
00:18:25,200 --> 00:18:28,330
،أنا آسف. ربّما أعيش حياتي كوحشيّ

331
00:18:28,330 --> 00:18:30,790
.لكن لديّ أجوبة بشريّة فقط من أجلك

332
00:18:31,180 --> 00:18:33,790
.لن تسمع أيّ شيء منّي سيُرضيك

333
00:18:35,720 --> 00:18:38,590
.يبحث المُدرّس عنّي، صحيح؟ لنذهب

334
00:18:39,100 --> 00:18:41,440
!لا! لن أستسلم

335
00:18:42,220 --> 00:18:47,090
!سأكتب مقالاً مؤثّرًا مهما كلّف الأمر

336
00:18:46,240 --> 00:18:47,970
!إ-إنّه لا يريد الاستسلام

337
00:18:51,730 --> 00:18:55,110
!مهلاً، انتظر! انتظر

338
00:18:55,430 --> 00:18:59,490
دعني أرافقك حتّى تصل
!إلى المُدرّس على الأقلّ

339
00:19:01,120 --> 00:19:05,600
إ-إنّه يطاردنا. لا أعتقد
.أنّه يخطّط للاستسلام أبدًا

340
00:19:07,520 --> 00:19:08,250
.أساكا

341
00:19:14,310 --> 00:19:17,760
هل يمكنك إغلاق عينيك
وفمك والتّشبّث بي بشدّة؟

342
00:19:21,580 --> 00:19:22,940
!لحقت بك

343
00:19:22,940 --> 00:19:24,370
مهلاً، ماذا...؟

344
00:19:24,750 --> 00:19:27,220
!أين ذهبت...؟ ماذا؟

345
00:19:34,420 --> 00:19:35,920
أكان ذلك مخيفًا؟

346
00:19:35,920 --> 00:19:37,180
.أنا بخير

347
00:19:38,640 --> 00:19:41,230
أتعتقد أنّنا بأمان الآن؟

348
00:19:41,230 --> 00:19:42,550
.لستُ واثقًا

349
00:19:43,190 --> 00:19:46,250
.ربّما ينتظرنا في الفصل

350
00:19:48,140 --> 00:19:51,270
.آسفة لأنّي لم أقاطعك أبكر

351
00:19:51,270 --> 00:19:52,330
.لا

352
00:19:52,330 --> 00:19:54,170
.أنقذتني بالفعل

353
00:19:54,170 --> 00:19:57,830
كان من الواضح أنّه يحاول
،استفزازي لقول شيء ما

354
00:19:57,830 --> 00:20:00,890
.لكنّي نسيت الهرب حتّى وصلتِ

355
00:20:00,890 --> 00:20:05,990
،عندما سألني كيف هي علاقتي بالبشر

356
00:20:05,990 --> 00:20:09,090
.لم أكن أفكّر وكدتُ أزمجر في وجهه

357
00:20:10,440 --> 00:20:11,990
.كان ذلك وشيكًا

358
00:20:11,990 --> 00:20:13,580
.هذا نادر

359
00:20:14,180 --> 00:20:16,310
...نعم. كلّ ما هنالك

360
00:20:16,310 --> 00:20:19,660
أنّي أعتقد أنّ جميع من في الفصل
،يناديني هيداكا الآن

361
00:20:19,660 --> 00:20:24,320
ولا أفكّر في حقيقة
.أنّي وحشيّ كثيرًا بعد الآن

362
00:20:26,580 --> 00:20:28,670
.ربّما أرخي دفاعاتي كثيرًا

363
00:20:31,740 --> 00:20:35,000
كانت هنالك أشياء في المدرسة
...تختبر غضبه

364
00:20:35,390 --> 00:20:40,440
،لكن كما هو حال الجميع حولنا
.حياة هيداكا-كُن تتغيّر أيضًا

365
00:20:41,570 --> 00:20:44,820
.الجميع ينتظروننا، لذلك لنعد للفصل

366
00:20:49,800 --> 00:20:51,480
.لقد عادا

367
00:20:51,480 --> 00:20:53,310
!حمدًا على هذا

368
00:20:53,690 --> 00:20:56,270
.ثمّة شيء ما على الباب

369
00:20:56,270 --> 00:20:57,320
.إنّه لمكافحة الآفات

370
00:20:57,610 --> 00:21:00,070
كي لا يسرقك أيّ أحد منّا
.ثانية يا هيداكا-كُن

371
00:21:00,070 --> 00:21:02,950
،لقد عاد ثانية قبل دقائق
.لكنّنا طردناه

372
00:21:05,440 --> 00:21:07,230
.مرحبًا بعودتك

373
00:21:07,230 --> 00:21:08,320
.شكرًا لك

374
00:21:08,970 --> 00:21:12,160
،كان الجميع ينتظرونك بسبب مهاراتك

375
00:21:12,160 --> 00:21:14,690
.ولكنّهم بدؤوا يقلقون عليك بعد ذلك

376
00:21:14,690 --> 00:21:16,820
.يا له من شعور رائع

377
00:21:16,820 --> 00:21:17,990
صحيح؟

378
00:21:17,990 --> 00:21:18,920
.لا أحبّ هذا

379
00:21:18,920 --> 00:21:20,160
ولكن لماذا؟

380
00:21:20,160 --> 00:21:21,720
.أرخيتُ دفاعاتي

381
00:21:21,720 --> 00:21:23,540
ماذا؟ هل حدث شيء ما؟

382
00:21:23,540 --> 00:21:24,830
!عفوًا

383
00:21:25,110 --> 00:21:27,110
!أحتاج لبعض المساعدة

384
00:21:27,110 --> 00:21:28,720
.حـ-حسنًا

385
00:21:29,110 --> 00:21:32,800
.إنّكم الثّلاثة معًا دائمًا

386
00:21:32,800 --> 00:21:35,590
.لن نسمح لكم بأخذ تسوناغو

387
00:21:35,590 --> 00:21:37,100
.لن نأخذه منكم

388
00:21:37,100 --> 00:21:40,210
.إنّكم تبدون كثلاثيّ جيّد

389
00:21:40,210 --> 00:21:41,480
من طلب رأيك؟

390
00:21:43,110 --> 00:21:46,270
.يتحدّث الجميع عن هيداكا-كُن

391
00:21:48,150 --> 00:21:50,020
...كنّا نفكّر في الأمر للتّوّ

392
00:21:50,020 --> 00:21:52,280
أساكا وهيداكا يسيران معًا
للمنزل دائمًا، صحيح؟

393
00:21:52,280 --> 00:21:55,820
،كما أنّها ذهبت لإحضاره قبل قليل
،ويبدوان منسجمان معًا كثيرًا

394
00:21:55,820 --> 00:21:59,760
.لذلك ظننّا أنّهما ربّما يتواعدان