1
00:00:04,760 --> 00:00:06,610
!مرحبًا بكم

2
00:00:11,570 --> 00:00:13,250
طاولة لاثنين؟

3
00:00:13,250 --> 00:00:17,250
.استعملوا الجرس عندما تكونون جاهزين للطّلب

4
00:00:18,870 --> 00:00:20,690
!ماري، حان الوقت لنتبادل

5
00:00:20,690 --> 00:00:22,080
.حـ-حسنًا

6
00:00:23,130 --> 00:00:26,070
.صار المكان مزدحمًا أكثر منذ الغداء

7
00:00:26,070 --> 00:00:28,960
إنّ وجود مكان للجلوس يجلب
.زبناء أكثر بكلّ تأكيد

8
00:00:31,810 --> 00:00:35,470
.كان ذلك صمتًا عابرًا

9
00:00:36,600 --> 00:00:40,580
.لذلك ظننّا أنّهما ربّما يتواعدان

10
00:00:42,160 --> 00:00:43,570
.يا إيكِدا

11
00:00:42,190 --> 00:00:44,240
!مهلاً يا أيدا

12
00:00:43,570 --> 00:00:47,100
ربّما عليك التّفكير أكثر بقليل قبل
.أن تقول شيئًا كهذا بصوت عالٍ

13
00:00:44,240 --> 00:00:45,800
!غضِب أيدا

14
00:00:47,100 --> 00:00:48,780
!العقاب المقدّس

15
00:00:49,610 --> 00:00:51,940
.عودوا للعمل أيّها الأغبياء

16
00:00:54,490 --> 00:00:56,480
،ولحسن الحظّ

17
00:00:57,140 --> 00:01:02,240
سرعان ما انتهى ذلك الصّمت بفضل
،يوكيهيرو-كُن ومضى الجميع قُدمًا

18
00:01:03,030 --> 00:01:07,650
لكن من الطّبيعيّ أن يفكّر النّاس
.فينا على هذا النّحو

19
00:01:08,730 --> 00:01:09,760
،أساكا

20
00:01:11,120 --> 00:01:13,910
هل أنت بخير؟ هل تعبت؟

21
00:01:16,740 --> 00:01:18,540
!أنا بخير

22
00:01:18,540 --> 00:01:23,250
لكن في هذه المرحلة، لا أظنّني أستطيع
.إخفاء الأمر حين يجعل قلبي يخفق فجأة

23
00:02:58,010 --> 00:03:00,200
تسوناغو، هل أحضرت النّسخ؟

24
00:03:00,550 --> 00:03:01,450
.نعم

25
00:03:01,450 --> 00:03:02,950
.شكرًا لك

26
00:03:03,620 --> 00:03:05,130
.أحسنت عملاً أيضًا يا ماري

27
00:03:05,130 --> 00:03:07,020
.وأنت كذلك يا يوكيهيرو-كُن

28
00:03:07,020 --> 00:03:08,960
!مهلاً لحظة

29
00:03:09,720 --> 00:03:11,460
!نحن الثّلاثة معًا

30
00:03:11,960 --> 00:03:13,130
!لذلك علينا التقاط صورة

31
00:03:13,130 --> 00:03:13,900
ماذا؟

32
00:03:15,240 --> 00:03:17,320
.لا تسحبني فجأة

33
00:03:17,320 --> 00:03:18,720
.لقد أفزعتني

34
00:03:19,110 --> 00:03:20,880
.علينا تخليد هذه اللّحظات

35
00:03:20,880 --> 00:03:23,230
يوكيهيرو-كُن، هلاّ أرسلت لي الصّورة لاحقًا؟

36
00:03:23,520 --> 00:03:24,720
.أكيد، أكيد

37
00:03:24,720 --> 00:03:26,480
.أيّها القذر أيدا

38
00:03:26,480 --> 00:03:31,780
،تبًّا. إن تهاونتَ في توزيع المنشورات
فكيف يفترض بي أنا أن أتهاون؟

39
00:03:31,780 --> 00:03:33,290
.عد إلى هنا بسرعة

40
00:03:33,290 --> 00:03:35,140
.يا له من سبب تافه

41
00:03:35,140 --> 00:03:37,280
!سأعمل بجدّ

42
00:03:37,280 --> 00:03:39,030
!بالتّوفيق

43
00:03:41,130 --> 00:03:45,660
.سآخذ استراحة
ماذا عنك يا هيداكا-كُن؟

44
00:03:47,420 --> 00:03:48,680
...أنا

45
00:03:49,650 --> 00:03:52,300
.اذهب للاستمتاع بوقتك خارجًا

46
00:03:52,300 --> 00:03:54,830
.إنّه مهرجان مدرسيّ قبل كلّ شيء

47
00:03:54,830 --> 00:03:57,790
،عملت بجدّ على التّجهيزات
!لذلك عليك اللّهو بجدّ أيضًا

48
00:03:57,790 --> 00:04:00,790
.أنت أيضًا يا ماري. اذهبي للاستمتاع بوقتك

49
00:04:03,790 --> 00:04:05,550
.هيداكا-كُن

50
00:04:08,520 --> 00:04:09,680
.هيّا بنا

51
00:04:18,560 --> 00:04:20,950
!عجبًا، مرحبًا بكما

52
00:04:20,950 --> 00:04:24,510
مرحبًا! هل يمكننا الحصول على
ياكيسوبا وصفة يوكيهيرو-كُن العائليّة؟

53
00:04:24,510 --> 00:04:27,930
!أكيد، أكيد! أنتما أكثر اثنين أردتُ أن تجرّباها

54
00:04:27,930 --> 00:04:28,930
!انتظرا لحظة

55
00:04:32,460 --> 00:04:33,210
.سأحملها عنك

56
00:04:33,210 --> 00:04:37,330
.شكرًا. لنذهب إلى فصل حيث يمكننا الأكل

57
00:04:43,420 --> 00:04:48,440
حينما ترى ناديًا لم تكن
،تعرف بوجوده يبرز هكذا

58
00:04:48,440 --> 00:04:51,090
.يكون الأمر جديدًا ومثيرًا للحماسة

59
00:04:51,090 --> 00:04:55,020
نعم. اليوم هو اليوم المثاليّ
.للتّباهي وتقديم النّوادي

60
00:04:55,020 --> 00:04:55,850
.نعم

61
00:04:57,450 --> 00:04:59,570
هل أنت بخير؟

62
00:05:00,870 --> 00:05:03,880
ألا مانع من السّير معًا في الخارج؟

63
00:05:04,800 --> 00:05:09,300
كان من المفاجئ سماع إيكِدا-كُن
.يسأل إن كنّا نتواعد

64
00:05:13,150 --> 00:05:16,870
،إن أجبتُ على سؤاله
...فسأقول أنّنا لا نتواعد

65
00:05:16,870 --> 00:05:21,000
،لكنّنا نحبّ بعضنا بكلّ تأكيد
،وهو ببساطة نفس الشّيء

66
00:05:21,000 --> 00:05:23,340
.لذلك فقد أخذني على حين غرّة بالطّبع

67
00:05:28,550 --> 00:05:32,350
أخائف أنّ يُكشف أمر ما مجدّدًا وسط الزّحام؟

68
00:05:35,730 --> 00:05:42,490
ذلك الجهد الصّغير الّذي أبذله لأعتاد
...رائحتك ولأتصرّف بشكل بشريّ أكثر

69
00:05:43,130 --> 00:05:47,250
أتساءل إن كان يبدو جميلاً بقدر
.المشهد الّذي أراه أمامي الآن

70
00:05:48,130 --> 00:05:51,030
.أخشى ألاّ يتقبّلني النّاس

71
00:05:51,810 --> 00:05:54,650
.هذا أكثر ما يخيفني على الأرجح

72
00:05:56,760 --> 00:05:59,420
وهو أمر مختلف قليلاً عن
.أن يكتشف النّاس أمرنا

73
00:06:00,180 --> 00:06:01,160
...وأيضًا

74
00:06:01,970 --> 00:06:04,940
انظر، تلك الفتاة الّتي ترتدي
.الأسود ظريفة جدًّا

75
00:06:04,940 --> 00:06:07,050
!انظر كم أنّ رقبتها تبدو ناصعة

76
00:06:07,050 --> 00:06:08,180
أتريد الحديث معها؟

77
00:06:11,180 --> 00:06:12,170
...وأيضًا

78
00:06:14,600 --> 00:06:17,240
...بالنّسبة لمن عليه الاستمتاع باليوم معك

79
00:06:18,930 --> 00:06:20,650
.هو أنا دون سواي

80
00:06:21,070 --> 00:06:23,070
.شكرًا لدعوتي إلى هنا

81
00:06:23,500 --> 00:06:26,030
.لنستمتع بوقتنا هنا

82
00:06:29,730 --> 00:06:30,830
.أكيد

83
00:06:40,000 --> 00:06:42,790
.إنّه وحشيّ. هذا مخيف

84
00:06:49,220 --> 00:06:52,340
.هنالك من يراقبنا دائمًا

85
00:06:53,650 --> 00:06:55,360
.لا يمكننا تغيير ذلك

86
00:06:55,820 --> 00:07:00,350
لا يمكننا أيضًا التّخلّص من الخوف
...المتجذّر أيضًا، لكن

87
00:07:00,850 --> 00:07:05,750
لذلك السّبب بالضّبط لا أريد
.التّخلّي عن الاستمتاع بوقتنا

88
00:07:10,290 --> 00:07:11,860
.منزل أشباح

89
00:07:13,140 --> 00:07:15,870
أتساءل إن كان بإمكاننا إخافة
.وحشيّ من الأساس

90
00:07:19,650 --> 00:07:21,470
.لقد صرختِ هناك بكلّ تأكيد

91
00:07:21,470 --> 00:07:23,170
!بالطّبع صرخت

92
00:07:23,170 --> 00:07:25,380
أعتقد أنّك أخفتَ الشّخص
.الّذي كان يؤدّي دور الشّبح

93
00:07:25,380 --> 00:07:27,250
.أشعر بالإحراج

94
00:07:30,420 --> 00:07:33,550
،حتّى إن عشنا بعض الأوقات الصّعبة

95
00:07:34,800 --> 00:07:37,170
يكفينا أن نتذكّر هذه اللّحظة

96
00:07:38,410 --> 00:07:43,400
وألاّ ننسى الضّحك أبدًا. أريد أن
.نتمشّى معًا في الخارج بتلك الجرأة

97
00:07:50,180 --> 00:07:53,480
.أوتشي! لا تتهاون بالفعل

98
00:07:53,480 --> 00:07:55,860
.أنا الوحيد الّذي كنتُ أوزّع منشورات

99
00:07:57,870 --> 00:08:00,130
.أنا هنا على الأقلّ

100
00:08:00,650 --> 00:08:04,570
.في الحقيقة، ذلك تحسُّنٌ بالنّسبة لك

101
00:08:04,570 --> 00:08:07,480
ماذا؟ هل تظنّ نفسك أبي؟

102
00:08:07,480 --> 00:08:08,500
.كفّ عن النّظر هكذا

103
00:08:09,170 --> 00:08:13,110
كما أنّك لم تعد تقضي وقتك مع
.ذلكما الشّخصين مؤخّرًا كالعادة

104
00:08:13,110 --> 00:08:14,450
ماذا؟

105
00:08:14,450 --> 00:08:18,270
.كالعادة؟ لم يكونا مقرّبين منّي أساسًا

106
00:08:24,200 --> 00:08:25,700
.فهمت

107
00:08:25,700 --> 00:08:29,760
،أنا هنا معك الآن
.لذلك دعنا نوزّع المنشورات

108
00:08:29,760 --> 00:08:32,770
ماذا؟ قلتُ للتّوّ أنّ عليك أن تكون
.شاكرًا لأنّي هنا من الأساس

109
00:08:32,770 --> 00:08:36,400
ما هذا؟ هل تقول أنّك تعجز
عن توزيع المنشورات؟

110
00:08:36,400 --> 00:08:39,560
ولا تعرف حتّى كيف تبتسم للزّبائن؟

111
00:08:39,560 --> 00:08:43,920
.صحيح. أنت أوتشي
.أعتقد أنّ ما بيدك حيلة

112
00:08:43,920 --> 00:08:44,780
.سلّمني هذه

113
00:08:44,780 --> 00:08:45,350
ماذا؟

114
00:08:45,350 --> 00:08:47,420
.أعطني كلّ تلك الأوراق

115
00:08:50,080 --> 00:08:51,620
.المعذرة

116
00:08:52,500 --> 00:08:56,080
.يقيم الفصل 3-1 مقهى في الطّابق الثّالث

117
00:08:56,080 --> 00:08:58,050
هل ترغبن في زيارته؟

118
00:08:59,040 --> 00:09:02,820
.آسف. أردتُ دعوتكنّ بشدّة فحسب

119
00:09:02,820 --> 00:09:04,330
.ربّما بإمكانكنّ أخذ منشور على الأقلّ

120
00:09:05,070 --> 00:09:06,110
!بالطّبع سآخذه

121
00:09:06,110 --> 00:09:08,540
في الحقيقة، سنأخذها كلّها ونوزّعها
!على أصدقائنا، لذلك أعطنا الكثير منها

122
00:09:08,540 --> 00:09:11,400
هلاّ أخبرتنا متى ستعمل في المقهى؟

123
00:09:11,400 --> 00:09:13,880
.الآن في الحقيقة

124
00:09:13,880 --> 00:09:15,190
!سنذهب إلى هناك حالاً

125
00:09:17,730 --> 00:09:20,710
.لا أستطيع المواصلة. أنا منهك جدًّا

126
00:09:20,710 --> 00:09:22,660
!مهلاً، مهلاً، مهلاً! مستحيل

127
00:09:23,000 --> 00:09:25,660
رأيتُ للتّوّ نسخة وسيمة
!وفي كامل الكفاءة من أوتشي

128
00:09:25,660 --> 00:09:27,670
.لم أعلم أنّ بإمكانك ذلك

129
00:09:28,220 --> 00:09:29,490
.لا يمكنني

130
00:09:29,490 --> 00:09:30,170
ماذا؟

131
00:09:31,220 --> 00:09:35,840
.أنا أكره الكذب والمجاملات الكاذبة بشدّة

132
00:09:36,660 --> 00:09:38,350
.لا ترغمني على القيام بذلك ثانية

133
00:09:39,760 --> 00:09:41,300
.آسف

134
00:09:44,210 --> 00:09:47,430
.أنت شخص صادق مع نفسك بالفعل يا أوتشي

135
00:09:47,430 --> 00:09:49,110
.أعتقد أنّي لا أكره ذلك فيك

136
00:09:49,110 --> 00:09:52,690
.ماذا؟ كم أنت مزعج بالفعل
.ابتعد عنّي

137
00:09:52,690 --> 00:09:56,030
ما رأيك أن نتجاهل كلّ هذا
—ونصير صديقين

138
00:09:56,440 --> 00:09:59,570
.كلاّ. أنا آسفة

139
00:09:59,570 --> 00:10:01,490
لستُ معتادة على وجود
.الكثير من النّاس حولي

140
00:10:01,490 --> 00:10:04,530
.لا داعي للقلق. أنا بخير

141
00:10:05,940 --> 00:10:08,210
هل أنت كيسارا؟

142
00:10:09,380 --> 00:10:10,450
—كيف عر

143
00:10:10,450 --> 00:10:13,780
.مهلاً، أنت صديق تسوناغو

144
00:10:14,450 --> 00:10:17,510
يوكي... يوكيهيرو؟

145
00:10:17,510 --> 00:10:20,170
.نعم، تذكّرتِ اسمي أيضًا

146
00:10:20,470 --> 00:10:23,890
عفوًا... هل أتيت لرؤية تسوناغو؟

147
00:10:23,890 --> 00:10:27,170
.لا. أساكا من دعتني

148
00:10:27,730 --> 00:10:31,430
.وهي... صديقتي

149
00:10:32,920 --> 00:10:35,590
.صحيح. صرتما متفاهمتان الآن

150
00:10:37,570 --> 00:10:43,410
لكن هنالك أشخاص
،وروائح أكثر ممّا توقّعته

151
00:10:43,410 --> 00:10:45,320
...لذلك فقد أرهقني كلّ هذا

152
00:10:49,340 --> 00:10:51,280
.ثمّة فطائر هناك

153
00:10:51,280 --> 00:10:54,040
.إنّها ظريفة جدًّا! هيّا بنا

154
00:10:54,800 --> 00:10:58,500
نعم، قد يكون تواجد الكثير من
.الأشخاص حولك خانقًا بالفعل

155
00:10:58,500 --> 00:11:00,460
أتريدين منّا اصطحابك إلى ماري؟

156
00:11:07,720 --> 00:11:09,830
.مهلاً، والمنشورات

157
00:11:16,180 --> 00:11:18,370
.سأكون بخير وحدي

158
00:11:18,750 --> 00:11:22,360
.سأسير ببطء فحسب. لديّ خريطة أيضًا

159
00:11:24,430 --> 00:11:27,060
.لـ-لكن شكرًا لك

160
00:11:31,850 --> 00:11:35,120
.كانت ناعمة جدًّا

161
00:11:43,480 --> 00:11:45,130
.أفزعني ذلك

162
00:11:46,510 --> 00:11:50,170
.أعتقد أنّ يوكيهيرو شخص طيّب أيضًا

163
00:11:54,850 --> 00:11:56,790
.سآتي لأخذ طلبكم قريبًا

164
00:11:56,790 --> 00:11:58,440
.شكرًا على الانتظار

165
00:11:58,730 --> 00:12:00,000
!نفد منّا الخبز

166
00:12:00,000 --> 00:12:00,860
!والمثلّجات

167
00:12:00,860 --> 00:12:02,950
!وسينفد منّا أساس القهوة بالحليب أيضًا

168
00:12:02,950 --> 00:12:04,510
!يا إلهي

169
00:12:04,510 --> 00:12:06,360
!ليحضر شخص ما المزيد منها

170
00:12:07,120 --> 00:12:08,460
.لقد عدت

171
00:12:08,460 --> 00:12:09,510
.مرحبًا بعودتكما

172
00:12:09,510 --> 00:12:11,940
.ما الّذي يحدث؟ المكان ممتلئ

173
00:12:11,940 --> 00:12:16,070
يبدو أنّ شخصًا جذّابًا كان يوزّع
...الكثير من المنشورات

174
00:12:17,210 --> 00:12:19,450
.أتساءل إن كان يوكيهيرو-كُن المقصود

175
00:12:19,450 --> 00:12:22,160
.ثمّة الكثير من الأشخاص

176
00:12:22,160 --> 00:12:24,460
عودوا للعمل يا هؤلاء... ماذا؟

177
00:12:25,360 --> 00:12:29,220
مهلاً، لماذا ترتدين سترة هيداكا يا أساكا؟

178
00:12:29,220 --> 00:12:31,480
—إذًا فأنتما تتواعـ

179
00:12:32,850 --> 00:12:35,080
!هذا طبيعيّ لأنّ الجوّ بارد

180
00:12:35,080 --> 00:12:36,720
.وتشعر ماري بالبرد بسهولة

181
00:12:36,720 --> 00:12:38,230
فعلاً؟

182
00:12:38,230 --> 00:12:40,080
.حسنًا، عد للعمل

183
00:12:40,080 --> 00:12:41,320
.هيّا، هيّا

184
00:12:41,320 --> 00:12:44,860
.ر-ريتسوكا، أيانو... شكرًا لكما

185
00:12:47,580 --> 00:12:50,110
.سأبذل جهدي في المقهى

186
00:12:50,900 --> 00:12:51,820
.نعم

187
00:12:51,820 --> 00:12:56,130
هدفنا اليوم هو إنهاء اليوم
.ونحن جميعًا مستمتعون

188
00:12:56,720 --> 00:12:58,520
.قالت جميعًا

189
00:12:58,520 --> 00:13:00,250
.سأذهب للعمل

190
00:13:01,140 --> 00:13:03,930
،تاوري، إن كنت ستذهبين للتّسوّق
.فسأحمل عنك الأغراض

191
00:13:03,930 --> 00:13:06,140
.ماذا؟ حسنًا، لنذهب

192
00:13:06,140 --> 00:13:08,690
.سأذهب لترتيب الطّوابير الّتي في الخارج

193
00:13:08,690 --> 00:13:09,890
!شكرًا لك

194
00:13:10,890 --> 00:13:13,890
.عليّ العمل بجدّ بالفعل

195
00:13:29,940 --> 00:13:33,360
.حسنًا.. هدأت الأوضاع أخيرًا

196
00:13:34,160 --> 00:13:36,530
!أساكا

197
00:13:36,810 --> 00:13:37,990
!كيسارا-سان

198
00:13:38,360 --> 00:13:39,830
.حمدًا على هذا

199
00:13:39,830 --> 00:13:43,300
،في كلّ مرّة أتواصل فيها معك
.لم تكوني على ما يرام، فساورني القلق

200
00:13:43,300 --> 00:13:46,260
!استطعتُ أخيرًا رؤيتك، لذلك أنا بخير الآن

201
00:13:46,260 --> 00:13:49,150
.كما أنّ ملابسك ظريفة جدًّا

202
00:13:49,150 --> 00:13:50,380
!شكرًا لك

203
00:13:50,380 --> 00:13:51,650
!لنلتقط صورة

204
00:13:51,650 --> 00:13:52,620
!أكيد

205
00:13:52,620 --> 00:13:55,400
مرحى! أين نلتقطها؟

206
00:13:55,400 --> 00:13:57,490
.عليك زيارة المقهى أوّلاً

207
00:13:56,150 --> 00:13:59,230
الفتاة ذات قلنسوة القطّة
.والخادمة ظريفتان جدًّا

208
00:14:00,670 --> 00:14:01,930
هل يمكننا الدّخول؟

209
00:14:01,930 --> 00:14:05,700
...أكيد. ستتوفّر مقاعد بعد قليل، لذلك

210
00:14:05,700 --> 00:14:07,440
!مـ-مهلاً

211
00:14:07,440 --> 00:14:11,200
!هذا ظريف جدًّا بالفعل
.كما أنّ لديك ذيل أيضًا

212
00:14:15,080 --> 00:14:16,260
!هذا مؤلم

213
00:14:16,260 --> 00:14:18,590
!ماذا؟ مهلاً، أنت وحشيّة

214
00:14:18,590 --> 00:14:20,320
!ذيلك حقيقيّ إذًا؟

215
00:14:20,320 --> 00:14:21,860
!بالطّبع هو حقيقيّ

216
00:14:21,860 --> 00:14:23,840
!هذا مقرف. لا تلمسني بدون إذن

217
00:14:25,330 --> 00:14:26,520
ما الّذي يحدث؟

218
00:14:26,520 --> 00:14:28,040
هل من مشكلة؟

219
00:14:28,040 --> 00:14:30,280
.هناك الكثير من الوحشيّين في هذه المدرسة

220
00:14:30,280 --> 00:14:33,760
نعم، كان هنالك وحشيّ آخر
.في مكان ما هنا أيضًا

221
00:14:32,260 --> 00:14:36,080
.ما هذا؟ لا أصدّق أنّي وجدتك ظريفة أيضًا

222
00:14:37,600 --> 00:14:38,850
...المعذرة

223
00:14:39,220 --> 00:14:41,490
هلاّ تفضّلت وتركتها بسرعة؟

224
00:14:41,490 --> 00:14:44,730
.إنّها صديقة عزيزة عليّ وزبونة

225
00:14:57,690 --> 00:14:58,840
أذلك ثقيل؟

226
00:14:58,840 --> 00:14:59,810
!لا بأس

227
00:15:00,600 --> 00:15:04,510
.هيداكا-كُن لطيف وقويّ جدًّا

228
00:15:06,000 --> 00:15:07,250
أهي وحشيّة قطّة؟

229
00:15:07,250 --> 00:15:08,840
.إنّهم يتناقشون بشأن أمر ما

230
00:15:14,540 --> 00:15:16,060
أساكا-سان؟

231
00:15:17,810 --> 00:15:19,170
!هـ-هيداكا-كُن؟

232
00:15:19,170 --> 00:15:20,920
...والمؤن... والمؤن

233
00:15:25,740 --> 00:15:26,770
يوكيهيرو؟

234
00:15:26,770 --> 00:15:27,610
!صه

235
00:15:28,170 --> 00:15:30,210
—لكنّ أساكا قد

236
00:15:30,210 --> 00:15:33,160
...أعلم ذلك. لكن

237
00:15:33,750 --> 00:15:35,640
!أنا آسف يا تسوناغو

238
00:15:35,640 --> 00:15:36,280
ماذا؟

239
00:15:38,980 --> 00:15:41,670
.لا داعي للغضب كثيرًا

240
00:15:41,670 --> 00:15:44,460
.نحن لا نمانعك أنت أيّتها الآنسة الخادمة

241
00:15:45,020 --> 00:15:46,700
...أساكا

242
00:15:47,560 --> 00:15:50,180
.ليس لدينا أيّ اهتمام بالوحشيّين

243
00:15:50,180 --> 00:15:51,070
صحيح؟

244
00:15:52,130 --> 00:15:53,480
...ليساعدنا أحد

245
00:15:54,190 --> 00:15:56,280
!لستم مهتمّين بالوحشيّين؟

246
00:15:57,220 --> 00:16:00,540
.ذلك مؤسف للغاية أيّها الزّبون

247
00:16:03,190 --> 00:16:07,660
أتدري أيّ نوع من المقاهي هذا؟

248
00:16:08,930 --> 00:16:10,190
ماذا؟

249
00:16:10,190 --> 00:16:12,350
!مرحبًا

250
00:16:13,760 --> 00:16:16,410
!إنّه مقهى وحشيّين

251
00:16:19,370 --> 00:16:20,660
ماذا؟ ماذا؟

252
00:16:20,940 --> 00:16:22,780
.انظروا للاّفتة

253
00:16:23,160 --> 00:16:24,530
...مقهانا التّقليديّ

254
00:16:24,530 --> 00:16:27,110
!واضح تمامًا أنّه مكتوب مقهى الوحشيّين

255
00:16:27,690 --> 00:16:29,670
!لقد أضافوا حروفًا لتغيير المعنى سرًّا

256
00:16:30,250 --> 00:16:31,930
...هذا صحيح

257
00:16:33,380 --> 00:16:35,380
هلاّ تفضّلتم بالانصراف؟

258
00:16:39,620 --> 00:16:40,810
!مرحبًا

259
00:16:41,220 --> 00:16:43,710
!أهلاً بكما في مقهى الوحشيّين

260
00:16:43,710 --> 00:16:44,890
.كم هذا ممتع

261
00:16:44,890 --> 00:16:46,610
!ظريف جدًّا

262
00:16:47,660 --> 00:16:49,610
.مهلاً، مهلاً، مهلاً

263
00:16:50,320 --> 00:16:53,110
!ما هذا المكان؟! إنّه مرعب

264
00:16:53,390 --> 00:16:55,790
كيسارا، هل ذيلك بخير؟

265
00:16:55,790 --> 00:16:59,360
لا بأس. كما أنّك هادئ أكثر
!من اللاّزم يا تسوناغو

266
00:16:59,660 --> 00:17:02,610
أكنت تدري بشأن هذا يا هيداكا-كُن؟

267
00:17:02,610 --> 00:17:03,770
...حسنًا

268
00:17:04,310 --> 00:17:07,620
أثناء فترة التّحضيرات، تحدّث
...معي المسؤول عن الأزياء

269
00:17:08,040 --> 00:17:09,220
...وثمّ

270
00:17:10,140 --> 00:17:11,670
!آسف يا تسوناغو

271
00:17:14,400 --> 00:17:19,790
ذكر كلّ من في الفصل أنّهم يريدون طرد
.هؤلاء الأشخاص، لذلك انتظر لحظة

272
00:17:19,790 --> 00:17:20,840
...الجميع

273
00:17:21,540 --> 00:17:24,440
...سيُساعدنا ذلك كثيرًا، لكن

274
00:17:24,440 --> 00:17:26,250
!حسنًا، جيّد

275
00:17:26,250 --> 00:17:27,180
!ممتاز

276
00:17:29,800 --> 00:17:30,600
ماذا؟

277
00:17:30,940 --> 00:17:32,590
!لنقم بهذا يا رفاق

278
00:17:32,590 --> 00:17:34,430
!أجل

279
00:17:34,690 --> 00:17:38,950
،لم يُخبرني أيّ أحد عن الأقنعة
.لذلك أفزعني ذلك قليلاً

280
00:17:38,950 --> 00:17:40,940
.كان المنظر مرعبًا حقًّا

281
00:17:43,450 --> 00:17:47,140
ووافقتَ على هذا يا تسوناغو؟

282
00:17:47,140 --> 00:17:47,960
.نعم

283
00:17:48,920 --> 00:17:53,460
أرادوا تجهيز هذه الأمور تحسّبًا
.لجلب أيّ انتباه سيّئ لي

284
00:17:54,600 --> 00:17:57,730
...تحسّبًا لجلب الوحشيّ أيّ انتباه له

285
00:17:59,970 --> 00:18:04,110
.حسنًا! سلّمتُ أولئك الأشخاص للّجنة

286
00:18:04,110 --> 00:18:05,860
.شكرًا

287
00:18:06,200 --> 00:18:08,990
.كان يوكيهيرو-كُن هو الحصان

288
00:18:09,360 --> 00:18:10,470
!نعم

289
00:18:10,470 --> 00:18:13,480
.شـ-شكرًا على إنقاذنا

290
00:18:13,480 --> 00:18:14,400
.نعم

291
00:18:15,410 --> 00:18:16,860
.أنا مسرور لأنّكما بخير

292
00:18:19,020 --> 00:18:21,150
.يا كوكونوها

293
00:18:21,600 --> 00:18:24,370
هل سنواصل مسألة مقهى
الوحشيّين هذه بعد الآن؟

294
00:18:24,370 --> 00:18:26,130
.نعم، إنّه محبوب

295
00:18:26,130 --> 00:18:27,740
ماذا؟ فعلاً؟

296
00:18:27,740 --> 00:18:29,960
هل ستواصل القيام بهذه الأمور الغريبة؟

297
00:18:29,960 --> 00:18:33,500
غريبة؟! أعتقد أنّها ستكون غريبة
...من وجهة نظر الوحشيّين

298
00:18:33,500 --> 00:18:38,430
أنا فقط أريد أن أُظهر للنّاس
!مدى روعة الوحشيّين

299
00:18:38,430 --> 00:18:42,400
حتّى أنّي جهّزتُ كُتيّبًا عن الوحشيّين
.للحرص ألاّ يكون أيّ شيء مهينًا

300
00:18:42,400 --> 00:18:45,260
!وافقت اللّجنة عليه أيضًا

301
00:18:45,260 --> 00:18:48,140
.يبدو أنّ كوكونوها يحبّ الوحشيّين كثيرًا

302
00:18:48,140 --> 00:18:50,180
!أريد أن أصير وحشيًّا بالفعل

303
00:18:50,710 --> 00:18:52,890
!صرتُ معجبًا منذ مباراة كرة السّلّة

304
00:18:53,230 --> 00:18:57,500
منعَنا هيداكا-كُن من إقامة
،مقهى وحشيّين في البداية

305
00:18:57,500 --> 00:19:00,660
لأنّه سيجلب الأنظار له بشكل
...سيّئ، ولكنّي

306
00:19:01,040 --> 00:19:06,320
،سأعيد تجهيز هذا المقهى
،حيث سيندمج الجميع معًا

307
00:19:06,320 --> 00:19:08,170
.ونحوّل الغرابة إلى متعة

308
00:19:08,800 --> 00:19:11,430
!هذه ليست مجرّد لعبة بالنّسبة لي

309
00:19:14,250 --> 00:19:15,830
ماذا...؟

310
00:19:18,090 --> 00:19:20,430
.تمّ التّغلّب على كيسارا-سان

311
00:19:20,740 --> 00:19:24,930
واضح لي أنّ الجميع يبذلون
،كلّ جهدهم لأجل هذا

312
00:19:25,310 --> 00:19:27,270
.لذلك يمكننا مجاراتهم فحسب

313
00:19:29,920 --> 00:19:34,100
لا بأس، فهذا المقهى الغريب
...هو ما أنقذني، لذا

314
00:19:35,520 --> 00:19:36,690
.بالتّوفيق

315
00:19:36,690 --> 00:19:39,560
!شكرًا لك! شكرًا لك

316
00:19:39,560 --> 00:19:42,860
.لكنّ قناع الحصان لا يناسب يوكيهيرو

317
00:19:42,860 --> 00:19:45,700
!ماذا؟! ماذا تقصدين؟
!أنا حصان جذّاب للغاية

318
00:19:45,700 --> 00:19:46,770
.يا لسخافتك

319
00:19:46,770 --> 00:19:48,070
ماذا؟

320
00:19:48,470 --> 00:19:51,430
تركتُ الأغراض الّتي كنتُ أحملها
.في الخارج، لذلك سأذهب لإحضارها

321
00:19:51,430 --> 00:19:52,580
.حسنًا

322
00:19:53,700 --> 00:19:55,960
هل سترتدين قناعًا يا أساكا؟

323
00:19:56,580 --> 00:19:58,080
...لنرَ

324
00:19:58,080 --> 00:20:00,180
!أساكا، عليك أن تكوني قطّة

325
00:20:00,180 --> 00:20:01,310
.بل ذئبة ستكون أفضل

326
00:20:01,310 --> 00:20:06,690
ماذا؟ لا، لا مانع لديّ كما
.أنا الآن... على ما أظنّ

327
00:20:06,690 --> 00:20:09,040
!لا! ستبدين رائعة كقطّة
!جرّبي ذلك

328
00:20:09,040 --> 00:20:10,440
!أودّ رؤية ذلك

329
00:20:11,460 --> 00:20:17,700
منذ مدّة، خلف كلّ من يحاولون
...الاقتراب منّا بجهد أكبر

330
00:20:18,750 --> 00:20:21,070
.كان هنالك ذيل لا يتحرّك

331
00:20:23,200 --> 00:20:24,490
.هيداكا-كُن

332
00:20:26,110 --> 00:20:27,950
هل أنت بخير؟

333
00:20:36,420 --> 00:20:38,080
.قابليني على السّطح لاحقًا

334
00:20:38,830 --> 00:20:39,970
.حسنًا

335
00:20:41,080 --> 00:20:43,090
.لا يبدو محبَطًا

336
00:20:45,060 --> 00:20:46,350
...المهرجان المدرسيّ

337
00:20:47,240 --> 00:20:52,120
هل استطعتَ الاستمتاع بالأمر
حتّى النّهاية يا هيداكا-كُن؟

338
00:20:57,170 --> 00:20:59,480
.حان الوقت للاستعداد للحفلة اللاّحقة

339
00:20:59,480 --> 00:21:01,480
،الذّهاب ليس إجباريًّا
لكن هل تريدين الذّهاب؟

340
00:21:01,480 --> 00:21:05,270
.سأرافق كيسارا-سان إلى المحطّة أوّلاً

341
00:21:05,270 --> 00:21:08,060
مهلاً. ماذا لو رافقتُها أنا؟

342
00:21:06,560 --> 00:21:07,810
.أنا سأذهب

343
00:21:09,980 --> 00:21:12,800
ماذا؟ هل حان وقتي أخيرًا أم ماذا؟

344
00:21:12,800 --> 00:21:14,870
.تعرّضتِ لحادثة هذا الغداء فحسب

345
00:21:14,870 --> 00:21:16,240
.الوضع خطير في اللّيل

346
00:21:19,380 --> 00:21:23,590
أيّهما أختار يا ترى؟

347
00:21:22,520 --> 00:21:24,870
.يا للكسل

348
00:21:23,590 --> 00:21:28,080
...كما يقول الإله

349
00:21:33,980 --> 00:21:36,100
.وقع عليّ الاختيار بالطّبع

350
00:21:36,100 --> 00:21:39,470
.لا تقلها هكذا. الإله هو من قرّر ذلك

351
00:21:39,470 --> 00:21:40,730
.نعم، صحيح

352
00:21:42,720 --> 00:21:43,730
...ولكن

353
00:21:44,380 --> 00:21:47,420
.غششتُ قليلاً عندما كنتُ أختار

354
00:21:47,420 --> 00:21:49,120
ماذا؟ لماذا؟

355
00:21:50,100 --> 00:21:52,130
...يا يوكيهيرو

356
00:21:53,850 --> 00:21:56,000
أنت معجب بأساكا، صحيح؟

357
00:21:58,740 --> 00:21:59,990
...وأنت

358
00:22:00,580 --> 00:22:02,120
معجبة بتسوناغو، صحيح؟