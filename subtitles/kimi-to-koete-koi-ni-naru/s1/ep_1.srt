1
00:00:03,580 --> 00:00:08,880
"مايو، ××20"

2
00:00:16,920 --> 00:00:19,000
!أ-أنا آسفة

3
00:00:19,130 --> 00:00:21,210
.لا بأس –
!اعذرني رجاءً –

4
00:00:28,880 --> 00:00:30,290
...الوحشيّون

5
00:00:31,580 --> 00:00:34,250
.أنا أراهم كثيرًا مؤخّرًا

6
00:00:34,920 --> 00:00:38,420
!مهلاً! كلاّ! لقد تأخّرت

7
00:00:40,750 --> 00:00:41,790
،ابتداءً من هذه السّنة

8
00:00:41,920 --> 00:00:44,880
ستستقبل ثانويّة يوتسونوها مجموعة
.ذات مكانة خاصّة من التّلاميذ

9
00:00:45,500 --> 00:00:47,170
...مجموعة التّلاميذ ذات المكانة الخاصّة هم

10
00:00:47,290 --> 00:00:51,500
كما تعلمون جميعًا، مشاركون من
.أحد البرامج التّعليميّة للوحشيّين

11
00:00:52,170 --> 00:00:54,420
"وحشيّون"
.إنّ الوحشيّين عبارة عن جنس نادر ببساطة –

12
00:00:54,540 --> 00:00:56,790
،لقد وُلدوا بسبب تجارب قبل مدّة طويلة

13
00:01:02,790 --> 00:01:04,630
.يوجد حوالي 3000 منهم

14
00:01:05,040 --> 00:01:08,670
.إنّهم يعيشون حياة مشابهة للبشر خلف أسوارهم

15
00:01:09,790 --> 00:01:12,630
"وحشيّون"
...يزور العديد منهم جانب البشر –

16
00:01:12,750 --> 00:01:16,130
لذلك مُنح التّلاميذ مكانة خاصّة للمساعدة
.في تعليمهم عن المجتمع البشريّ

17
00:01:17,080 --> 00:01:18,420
!يا أستاذ

18
00:01:18,540 --> 00:01:22,290
.سمعتُ أنّ الكثير من الوحشيّين عنيفون جدًّا

19
00:01:22,420 --> 00:01:24,670
!كم هذا مخيف –
.مستحيل –

20
00:01:24,790 --> 00:01:26,170
.لا داعي للقلق

21
00:01:26,290 --> 00:01:28,830
الوحشيّون الوحيدون الّذين سُمح لهم
بارتياد المدرسة في شهر مايو هذا

22
00:01:28,960 --> 00:01:31,460
.قد خضعوا لفحص شامل من الحكومة

23
00:01:31,580 --> 00:01:32,920
أقلت في مايو؟

24
00:01:33,630 --> 00:01:35,000
!تقصد اليوم؟

25
00:01:40,540 --> 00:01:41,540
...لقد وصلت

26
00:01:41,670 --> 00:01:42,830
"ممنوع الدّخول بلا إذن"
!كلاّ –

27
00:01:49,830 --> 00:01:51,790
يرتدي زيّنا المدرسيّ؟

28
00:01:55,460 --> 00:01:57,420
هل تأخّرت أنت أيضًا؟

29
00:01:57,540 --> 00:02:00,750
،نـ-نعم. أضعتُ الطّريق
.ثمّ رأيت البوّابة تُغلق عليّ

30
00:02:00,880 --> 00:02:02,540
.حسنًا، يمكنا الدّخول من هنا

31
00:02:03,580 --> 00:02:04,580
.هيّا

32
00:02:04,790 --> 00:02:06,830
ستتسلّقين السّور؟

33
00:02:07,670 --> 00:02:13,420
،نعم. لا يفترض بنا فعل ذلك
.لكن لا بأس بما أنّنا تلاميذ هنا

34
00:02:14,330 --> 00:02:16,380
!لنتسلّقه معًا

35
00:02:44,710 --> 00:02:51,670
"معك، سيتجاوز حبُّنا كلّ الصّعاب"

36
00:04:07,000 --> 00:04:08,000
.حسنًا

37
00:04:11,250 --> 00:04:13,960
.شكرًا لك. ساعدتني على اتّخاذ القرار

38
00:04:17,500 --> 00:04:19,960
!إ-إنّه وحشيّ؟

39
00:04:20,080 --> 00:04:22,630
!لقد تكلّمنا! لقد لمستُه

40
00:04:23,290 --> 00:04:25,750
...يده... كانت باردة

41
00:04:26,290 --> 00:04:27,330
.عفوًا

42
00:04:27,460 --> 00:04:28,460
ألن تنزلين؟

43
00:04:28,580 --> 00:04:30,830
...نعم! لـ-لكن

44
00:04:32,000 --> 00:04:33,960
.إذًا لا تستطيعين النّزول

45
00:04:39,790 --> 00:04:40,790
.أنت خفيفة

46
00:04:45,250 --> 00:04:46,330
.إلى اللّقاء

47
00:04:47,500 --> 00:04:50,210
ما.. ما... ماذا؟

48
00:04:53,000 --> 00:04:54,130
.يا ماري

49
00:04:54,250 --> 00:04:57,290
.أنت محظوظة. لم تنته الحصّة بعد

50
00:04:57,420 --> 00:04:59,790
.ذهب الأستاذ لإحضار بعض المطبوعات

51
00:05:01,750 --> 00:05:02,920
ما الخطب؟

52
00:05:03,250 --> 00:05:06,000
.تحدّث معي... وحملني

53
00:05:06,130 --> 00:05:10,670
.وساعدني على النّزول. قال أنّي خفيفة

54
00:05:11,830 --> 00:05:13,420
.اهدؤوا

55
00:05:13,880 --> 00:05:16,040
غادرتُ لدقائق وعدتُ لأجدكم هكذا؟ –
!كلاّ –

56
00:05:16,170 --> 00:05:19,040
!عودوا –
.عودوا إلى مقاعدكم –

57
00:05:22,290 --> 00:05:25,830
حسنًا، هذا هو التّلميذ ذو المكانة
.الخاصّة الّذي حدّثتكم عنه

58
00:05:25,960 --> 00:05:28,170
"هيداكا تسوناغو"
.سيدرس معنا في هذا الفصل –

59
00:05:28,630 --> 00:05:31,750
.أنا هيداكا تسوناغو
.سررت بلقائكم جميعًا

60
00:05:32,580 --> 00:05:34,250
أمعقول أنّه في صفّنا نحن؟

61
00:05:34,380 --> 00:05:35,380
.كلاّ

62
00:05:35,500 --> 00:05:38,040
!غير معقول، إنّه ضخم –
...أمّا بالنّسبة لمقعدك –

63
00:05:38,460 --> 00:05:40,130
.فستجلس قرب أساكا ماري

64
00:05:40,250 --> 00:05:41,250
لا تمانعين، صحيح يا أساكا؟

65
00:05:41,380 --> 00:05:43,210
!ماذا؟ أكيد

66
00:05:49,290 --> 00:05:52,330
.شكرًا لك –
.ا-العفو –

67
00:05:52,830 --> 00:05:56,130
هيداكا تلميذ ثانويّة
.في السّادسة عشر مثلكم

68
00:05:56,250 --> 00:05:58,750
.احرصوا أن تنسجموا معه كزميل دراسة لكم

69
00:05:59,330 --> 00:06:02,500
.حسنًا! سأوزّع عليكم هذه المطبوعات الآن

70
00:06:04,080 --> 00:06:07,670
السّماء الجميلة الّتي لطالما حدّقتُ فيها

71
00:06:07,790 --> 00:06:10,380
.صارت الآن محجوبة بجدار ضخم

72
00:06:15,580 --> 00:06:16,880
لقد تكلّم، صحيح؟

73
00:06:16,960 --> 00:06:18,210
.كان صوته عميقًا

74
00:06:18,330 --> 00:06:19,830
.لديه وجه كلب بالفعل

75
00:06:20,500 --> 00:06:23,290
!هل يوجد وحشيّ في فصلكم بالفعل؟ –
!صه –

76
00:06:23,420 --> 00:06:25,580
!عجبًا، إنّه ضخم –
!صه –

77
00:06:28,380 --> 00:06:30,670
!كفّوا عن الحديث عنه بصوت عالٍ

78
00:06:30,790 --> 00:06:33,000
!بصراحة، هذا الأمر بدأ يزعجني فعلاً

79
00:06:33,460 --> 00:06:34,750
.صحيح

80
00:06:34,880 --> 00:06:37,750
.عليّ أن أشكره على مـ-مساعدتي

81
00:06:37,880 --> 00:06:38,880
"الرّياضيّات 1"
.المعذرة –

82
00:06:39,380 --> 00:06:41,630
الوحشيّون الكلاب أشبه بالكلاب، صحيح؟

83
00:06:41,750 --> 00:06:43,790
هل تستطيع التّحدّث مع الكلاب؟

84
00:06:49,380 --> 00:06:50,960
.كلاّ، ذلك فظيع

85
00:06:51,080 --> 00:06:53,170
.لا تضحكوا –
!إنّه يسخر منه –

86
00:06:53,290 --> 00:06:54,540
.الوحشيّون أشخاص أيضًا

87
00:06:54,670 --> 00:06:57,920
ربما يكون أسلافهم قد امتزجوا
...مع الكلاب، ولكن رغم ذلك

88
00:06:59,170 --> 00:07:00,170
!هذا مؤلم

89
00:07:00,630 --> 00:07:03,250
.ما خطبك يا أيدا؟ آلمني ذلك

90
00:07:03,380 --> 00:07:07,290
.كان ذلك فظًّا جدًّا. تحلّ بالأدب –
!ماذا؟ –

91
00:07:07,420 --> 00:07:09,580
.اسمع، أنت تبدو مثل قرد

92
00:07:09,710 --> 00:07:12,170
فهل كان ليُعجبك الأمر إن سألتك
هل تتحدّث مع القردة؟

93
00:07:17,420 --> 00:07:18,540
.أنا آسف

94
00:07:18,670 --> 00:07:20,210
.لا بأس

95
00:07:20,330 --> 00:07:23,080
،أنا لم أصادف كلبًا من قبل في الحقيقة

96
00:07:24,000 --> 00:07:26,630
سأرى إن كنتُ أستطيع التّحدّث
.إليهم إن قابلتُ واحدًا

97
00:07:28,880 --> 00:07:30,500
!مهلاً، أنت هادئ أكثر من اللاّزم

98
00:07:30,630 --> 00:07:32,380
!لا بأس تمامًا بأن تغضب ممّا قاله

99
00:07:32,500 --> 00:07:33,630
.لا يمكنني أن أغضب

100
00:07:34,080 --> 00:07:35,920
ما الّذي تقصده بذلك؟

101
00:07:36,040 --> 00:07:37,330
أهي قاعدة تتّبعها؟

102
00:07:38,920 --> 00:07:40,500
.هيّا، لا تتجاهلني

103
00:07:40,630 --> 00:07:43,460
.أنا أيدا يوكيهيرو. سررت بلقائك

104
00:07:43,580 --> 00:07:44,580
.وأنا بالمثل

105
00:07:45,500 --> 00:07:47,330
.أعتقد أنّك ستردّ على ذلك على الأقلّ

106
00:07:47,460 --> 00:07:48,710
.ماري

107
00:07:48,830 --> 00:07:51,000
.ها أنت تتجاهلني ثانية –
.تعالي إلى هنا –

108
00:07:51,130 --> 00:07:52,580
.حـ-حسنًا

109
00:07:57,210 --> 00:07:58,580
...إنّ هيداكا-كُن

110
00:07:58,710 --> 00:08:01,830
رغم حجمه الضّخم وكم أنّ مظهره
،جذب الانتباه في ذلك اليوم

111
00:08:01,960 --> 00:08:05,040
إلاّ أنّه كان أكثر هدوءًا من
.أيّ أحد آخر وهو يدرس

112
00:08:07,830 --> 00:08:11,330
لم يسعني سوى الشّعور بالفضول
.وأنا جالسة أمامه طوال اليوم

113
00:08:11,920 --> 00:08:15,830
.وحتّى الآن، كانت حياتي عاديّة بالكامل

114
00:08:15,960 --> 00:08:21,170
أذهب للمدرسة، وأحصل على أصدقاء
...جدد، وأتمشّى في أيّام إجازتي

115
00:08:21,500 --> 00:08:24,210
.نعم. كانت عاديّة

116
00:08:24,500 --> 00:08:30,670
بدأت نظرتي لما هو عاديّ
.تمتلئ بأشياء مختلفة

117
00:08:34,210 --> 00:08:36,580
.أتساءل إن كنتُ سأستطيع التّكلّم معه غدًا

118
00:08:37,380 --> 00:08:39,460
.انظر، إنّه وحشيّ

119
00:08:39,830 --> 00:08:43,580
.مخيف. إنّه ضخم ومزعج

120
00:08:44,710 --> 00:08:46,210
أتسمحان لي بالعبور؟

121
00:08:46,330 --> 00:08:49,290
.لا يوجد أيّ طريق لك هنا لتعبره

122
00:08:50,500 --> 00:08:53,710
،آسف. أنا في طريقي للمنزل
.لذلك اسمحا لي بالعبور

123
00:08:53,830 --> 00:08:57,330
.ماذا؟ اسمع أيّها الوحش
هل سمعتَ ما قلناه من الأساس؟

124
00:08:57,460 --> 00:09:01,080
أعتقد أنّك لا تفهم كلام البشر
.على أيّ حال بما أنّك كلب

125
00:09:03,790 --> 00:09:06,880
ماذا؟ هل ستردّ بالعنف
!على بشريّ بالفعل؟

126
00:09:08,380 --> 00:09:10,580
!مـ-مهلاً، لا تهرب

127
00:09:10,710 --> 00:09:11,710
.بالطّبع سأهرب

128
00:09:11,830 --> 00:09:13,130
.كم هذا مزعج

129
00:09:17,670 --> 00:09:18,670
.كلاّ

130
00:09:23,960 --> 00:09:25,130
!هيداكا-كُن

131
00:09:25,670 --> 00:09:27,420
!مهلاً، لقد وقع بالفعل

132
00:09:27,540 --> 00:09:28,630
!لنهرب من هنا

133
00:09:29,420 --> 00:09:32,130
!ماذا أفعل؟ كان ذلك بسببي بكلّ تأكيد

134
00:09:35,880 --> 00:09:40,290
ماذا؟ مهلاً... أيستطيع الوحشيّون السّباحة؟

135
00:09:41,330 --> 00:09:43,420
!كلاّ، سُحقًا

136
00:09:57,830 --> 00:10:01,380
اسمك أساكا، صحيح؟
ما الّذي كنت تفعلينه من الأساس؟

137
00:10:01,500 --> 00:10:03,830
.كـ-كنتُ أحاول إنقاذك

138
00:10:03,960 --> 00:10:07,420
.كان ذلك خطيرًا. لا تكرّري ذلك

139
00:10:10,420 --> 00:10:13,880
.لكنّك وقعتَ بسببي أنا

140
00:10:14,000 --> 00:10:15,500
.لا، بل كان خطئي أنا

141
00:10:15,630 --> 00:10:17,880
.ظننتُ أنّك قد لا تستطيع السّباحة

142
00:10:18,000 --> 00:10:21,000
،أستطيع السّباحة
.وأنت هي الّتي كدت تغرقين

143
00:10:21,130 --> 00:10:23,040
...نعم، لكن

144
00:10:24,000 --> 00:10:26,670
!حسنًا... شكرًا لك

145
00:10:28,130 --> 00:10:30,790
وأريد شكرك أيضًا لمساعدتي
.على النّزول من السّور هذا الصّباح

146
00:10:32,170 --> 00:10:34,630
كنتُ أود شكرك منذ... ذلك الوقت؟

147
00:10:38,080 --> 00:10:41,170
...عفوًا... هذه أوّل مرّة

148
00:10:41,290 --> 00:10:43,080
.يشكرني فيها بشريّ على أيّ شيء

149
00:10:43,790 --> 00:10:47,330
...أريد أن أشكرك أيضًا
.لأنّك قلقت عليّ

150
00:10:49,830 --> 00:10:53,040
لماذا لم تغضب عليهما قبل قليل؟

151
00:10:53,170 --> 00:10:54,830
.ماذا؟ حسنًا

152
00:10:55,500 --> 00:10:58,290
،صحيح أنّهما أغضباني
.ولكنّ هذا هو حال البشر

153
00:10:58,420 --> 00:11:00,420
،وإن سمحتُ لغضبي بالتّغلّب عليّ

154
00:11:00,540 --> 00:11:02,630
.فسأُعامل كوحش أكثر وأكثر فحسب

155
00:11:02,750 --> 00:11:06,460
أريد أن أظلّ شخصًا، لذلك أقبل
.بما هو عاديّ لمن هم حولي

156
00:11:06,880 --> 00:11:08,380
.لذلك لن أغضب

157
00:11:13,130 --> 00:11:14,960
.عدتُ يا أمّي

158
00:11:15,630 --> 00:11:17,880
.وقعنا في النّهر الّذي قربنا

159
00:11:19,670 --> 00:11:24,130
.ابنتي ووحشيّ... مبلّلان بالكامل

160
00:11:28,040 --> 00:11:29,380
.عليّ العودة للمنزل

161
00:11:29,500 --> 00:11:31,670
لا يمكنك. أنت تعيش بعيدًا من هنا، صحيح؟

162
00:11:31,790 --> 00:11:34,130
.ستُصاب بالزّكام إن ظللت هكذا –
...ولكن –

163
00:11:34,250 --> 00:11:37,500
ذلك النّهر متّسخ أيضًا، لذلك
.قد تصابان بما هو أسوأ

164
00:11:38,080 --> 00:11:40,000
.ادخلا بسرعة

165
00:11:40,130 --> 00:11:42,250
"الرّياضيّات 1"

166
00:11:42,380 --> 00:11:44,290
.شكرًا يا أمّي

167
00:11:44,420 --> 00:11:46,130
...لا بأس بذلك، ولكن

168
00:11:46,500 --> 00:11:49,170
إنّه وحشيّ، فهل لا بأس بهذا؟

169
00:11:50,380 --> 00:11:51,380
.تعالي معي

170
00:11:53,210 --> 00:11:54,500
.سررت بلقائك

171
00:11:55,210 --> 00:11:56,580
.أتمنّى ألاّ أكون قد تطفّلت عليكم

172
00:12:01,830 --> 00:12:04,290
.حسنًا، لا أفهمك بكلّ تأكيد

173
00:12:05,000 --> 00:12:06,420
.كانت تجربة فاشلة

174
00:12:09,380 --> 00:12:10,460
.عجبًا

175
00:12:10,580 --> 00:12:13,040
.هيداكا-كُن زميلي في الفصل

176
00:12:14,170 --> 00:12:18,670
،أعتقد أنّه مجرّد فتى لطيف
لكنّه أكثر حساسيّة من غيره

177
00:12:18,790 --> 00:12:20,880
.تُجاه ما يُعتبر عاديًّا

178
00:12:24,130 --> 00:12:26,170
هل ستأخذ حمّامًا؟

179
00:12:26,290 --> 00:12:27,290
.نعم

180
00:12:27,540 --> 00:12:29,750
.كنتُ سأغسل ذلك القميص من أجلك

181
00:12:30,500 --> 00:12:33,040
—عفوًا... سآخذه لاحقًا

182
00:12:35,580 --> 00:12:37,000
لـ-لماذا تخلع ملابسك؟

183
00:12:37,130 --> 00:12:39,460
.ألم تكوني ستغسلينه؟ يمكنك الدّخول

184
00:12:39,580 --> 00:12:41,790
لا، أعني... ألا بأس بذلك؟

185
00:12:41,920 --> 00:12:44,580
لك الأولويّة بما أنّك تعيشين هنا، صحيح؟

186
00:12:52,880 --> 00:12:55,960
إنّ الفرو يغطّي أجساد
.الوحشيّين قبل كلّ شيء

187
00:12:56,080 --> 00:12:58,290
.لكنّ عضلات بطنه مشدودة جدًّا

188
00:12:58,420 --> 00:13:01,540
.جسده ضخم... هذا مذهل

189
00:13:02,250 --> 00:13:05,380
.مهلاً، أبدو مثل منحرفة الآن
.عليّ التّوقّف

190
00:13:08,580 --> 00:13:10,500
...القليل فحسب

191
00:13:11,540 --> 00:13:12,540
أتحتاجين هذا؟

192
00:13:18,290 --> 00:13:20,000
...هذا يدغدغ

193
00:13:20,130 --> 00:13:22,460
أساكا. أهذا هو؟

194
00:13:26,420 --> 00:13:28,330
.آسف، اقتربتُ منك كثيرًا

195
00:13:28,460 --> 00:13:29,920
.لا... بأس

196
00:13:31,170 --> 00:13:34,210
.عفوًا، سأعود بعد قليل

197
00:13:34,670 --> 00:13:36,420
!استمتع بالحمّام

198
00:13:48,290 --> 00:13:50,170
.كانت رائحتها عطِرة

199
00:13:50,290 --> 00:13:54,420
.انتقلت مباشرة إلى أسفل بطني
.لم أشمّ أيّ شيء مثل ذلك من قبل

200
00:13:58,580 --> 00:14:00,960
لماذا ينبض قلبي بشدّة هكذا؟ –
ما هذا الشّعور؟ –

201
00:14:10,250 --> 00:14:13,330
.يوكي-تشان، لنأخذ استراحة

202
00:14:13,460 --> 00:14:16,040
.الرّكض بشدّة في الصّباح الباكر صعب

203
00:14:16,330 --> 00:14:19,420
...كم أنا متعبة

204
00:14:22,170 --> 00:14:24,830
.لقد ذكّرتني بما حدث البارحة

205
00:14:29,040 --> 00:14:30,540
!تسوناغو

206
00:14:30,790 --> 00:14:32,750
أذاهب إلى المدرسة؟

207
00:14:33,130 --> 00:14:35,500
.سمعتُ أنّك ترتاد مدرسة في الخارج

208
00:14:35,630 --> 00:14:37,210
لم تتعرّض لأيّ تنمّر، صحيح؟

209
00:14:37,330 --> 00:14:39,210
ماذا؟ تنمّر؟ أأنت بخير؟

210
00:14:39,330 --> 00:14:40,670
.لم يكن هنالك أيّ تنمّر

211
00:14:40,790 --> 00:14:43,250
.حسنًا، أخبرنا إن حدث أيّ شيء

212
00:14:43,380 --> 00:14:44,830
.جميعنا إلى جانبك

213
00:14:44,960 --> 00:14:47,830
.آمل أن تقابل بشريًّا لطيفًا

214
00:14:47,960 --> 00:14:49,920
!يكفي، هذا مزعج

215
00:14:50,040 --> 00:14:51,210
.عجبًا –
.لقد غضب –

216
00:14:52,170 --> 00:14:54,670
اتّخذتُ قراري بتولّي هذا الأمر
،للسّنوات الثّلاث القادمة

217
00:14:54,790 --> 00:14:56,080
.لذلك لا تعاملوني كطفل

218
00:15:00,710 --> 00:15:02,460
"رخصة"
"الاسم: هيداكا تسوناغو"

219
00:15:19,210 --> 00:15:20,750
!تسوناغو! سأمرّرها لك

220
00:15:28,830 --> 00:15:30,500
ما كان ذلك؟

221
00:15:30,630 --> 00:15:33,830
.لم أرَ شيئًا كهذا إلاّ في البطولات العالميّة

222
00:15:33,960 --> 00:15:37,130
.للوحشيّين لياقة مذهلة

223
00:15:37,250 --> 00:15:39,250
!كان ذلك رائعًا يا تسوناغو

224
00:15:39,380 --> 00:15:41,420
!انضمّ إلى فريق كرة السّلّة
!أنا فيه أيضًا

225
00:15:41,540 --> 00:15:44,380
لا يُسمح للوحشيّين بالانضمام
.للنّوادي الرّياضيّة

226
00:15:44,500 --> 00:15:48,130
.فهمت. هنالك الكثير من هذه القواعد –
.فعلاً؟ هذا سيّئ –

227
00:15:48,250 --> 00:15:49,790
هل يمكنك مساعدتنا أحيانًا على الأقلّ؟

228
00:15:49,920 --> 00:15:50,920
.واثق أنّ ذلك غير مسموح

229
00:15:51,040 --> 00:15:52,380
.يراودني الفضول –
ماذا؟ –

230
00:15:52,500 --> 00:15:54,790
.أريد مواصلة مشاهدته فحسب –
.أعتقد أنّك لا تتعرّق كثيرًا –

231
00:15:54,920 --> 00:15:57,630
.أتمنّى لو أستطيع بصراحة –
.أنا أتصرّف بغرابة –

232
00:15:57,750 --> 00:15:58,750
.أنا أشتعل

233
00:16:00,920 --> 00:16:01,920
!ماري

234
00:16:04,380 --> 00:16:06,630
.كنت تراقبين ذلك الوحشيّ طوال هذا الوقت

235
00:16:06,750 --> 00:16:08,710
هل يراودك الفضول حيال الوحشيّين؟

236
00:16:08,830 --> 00:16:11,250
.لا، لا! بالطّبع لا

237
00:16:12,330 --> 00:16:13,750
!اجتمعوا

238
00:16:14,830 --> 00:16:16,460
.سأسأل عن المزيد من التّفاصيل لاحقًا

239
00:16:16,580 --> 00:16:18,540
.أكيد –
!لا! لا –

240
00:16:18,920 --> 00:16:21,210
!سُحقًا، لقد خسرنا

241
00:16:21,330 --> 00:16:23,460
.أحرز ذلك الوحش الغبيّ نقاطًا عديدة

242
00:16:23,580 --> 00:16:25,130
.لم يكن ذلك عادلاً

243
00:16:25,500 --> 00:16:27,250
.لا تسمحوا له باللّعب

244
00:16:27,380 --> 00:16:29,210
.معك حقّ تمامًا

245
00:16:29,330 --> 00:16:31,250
.لا أريد حتّى النّظر إليه

246
00:16:32,790 --> 00:16:35,420
.أنا متعب –
.وأنا جائع –

247
00:16:35,540 --> 00:16:37,830
.ماري. سنسبقك –
هل لأحدكنّ مزيل عرق؟ –

248
00:16:37,960 --> 00:16:39,040
!اشتريتُ واحدًا جديدًا –
!حسنًا –

249
00:16:42,540 --> 00:16:45,130
هـ-هل جفّ زيّك المدرسيّ جيّدًا البارحة؟

250
00:16:45,250 --> 00:16:47,500
.نعم. وكُتبي كانت بخير أيضًا

251
00:16:47,630 --> 00:16:48,880
.حمدًا على هذا

252
00:16:49,380 --> 00:16:51,000
.كنتَ ممتازًا في كرة السّلّة

253
00:16:51,130 --> 00:16:53,580
.بدوت رائعًا وأنت تحرز تلك النّقاط

254
00:16:56,080 --> 00:16:59,500
.أنا بارع في الأمور الجسديّة

255
00:17:00,670 --> 00:17:04,630
.إنّه يشعر بالحرج
.تتحرّك أذناه ويبدو ظريفًا جدًّا

256
00:17:04,750 --> 00:17:07,460
.من الجميل رؤيته يتجاوب

257
00:17:10,250 --> 00:17:12,170
.أريد الحديث معه أكثر

258
00:17:16,670 --> 00:17:17,960
!أساكا

259
00:17:20,420 --> 00:17:23,130
أيمكنك سماعنا أيّها الوحش؟

260
00:17:23,250 --> 00:17:25,830
!ابق هناك للأبد فحسب

261
00:17:35,080 --> 00:17:37,420
.لقد تأخّر تسوناغو

262
00:17:37,830 --> 00:17:39,920
.أوتشي، لقد حبسناه

263
00:17:40,040 --> 00:17:42,330
.لكن كان علينا التّضحية بفتاة أيضًا

264
00:17:43,130 --> 00:17:45,380
.كما أسقطنا بعض الأغراض عليه

265
00:17:45,500 --> 00:17:47,630
.أحسنتما عملاً

266
00:17:47,750 --> 00:17:50,750
.لنرمِ كُتبه أيضًا

267
00:17:50,880 --> 00:17:52,170
!أجل

268
00:18:03,750 --> 00:18:05,710
هل تأذّيتِ؟

269
00:18:06,630 --> 00:18:09,130
...أنا بخير، لكن

270
00:18:09,460 --> 00:18:12,290
!هيداكا-كُن؟! أليس ذلك عمود دعم؟

271
00:18:12,790 --> 00:18:14,630
.لقد خدشني فحسب

272
00:18:14,750 --> 00:18:17,670
،صددتُ البقيّة الّتي كانت ستصيبك
.لذلك لا داعي للقلق

273
00:18:18,540 --> 00:18:20,040
...الأهمّ الآن

274
00:18:22,920 --> 00:18:25,330
!ابق هناك للأبد فحسب

275
00:18:28,130 --> 00:18:30,830
.آسف لأنّي ورّطتك معي في هذا

276
00:18:30,960 --> 00:18:33,080
.إنّها ليست غلطتك يا هيداكا-كُن

277
00:18:33,210 --> 00:18:37,250
!يقع اللّوم فقط على من حبسونا هنا

278
00:18:37,380 --> 00:18:39,540
!حتّى أنّك تعرّضت للأذى

279
00:18:39,670 --> 00:18:41,420
.ستتّسخ منشفتك بالدّماء

280
00:18:41,540 --> 00:18:43,500
.إنّها رخيصة، فلا بأس

281
00:18:44,330 --> 00:18:46,750
.هيداكا-كُن، يدك باردة

282
00:18:46,880 --> 00:18:48,500
.تكون دافئة في العادة

283
00:18:48,630 --> 00:18:50,830
.ربّما بقدر دفء البشر

284
00:18:50,960 --> 00:18:53,750
.إنّها تبرد في المدرسة فقط لأنّي متوتّر

285
00:18:57,040 --> 00:18:59,710
.لم تعقديها جيّدًا
أتمانعين إن أعدتُ لفّها؟

286
00:18:59,830 --> 00:19:01,460
.تـ-تفضّل، تفضّل

287
00:19:02,830 --> 00:19:03,960
.أنت معتاد على هذا بالفعل

288
00:19:04,580 --> 00:19:07,790
لا توجد أيّ مستشفيات
،أو أطبّاء في مدينة الوحشيّين

289
00:19:07,920 --> 00:19:10,460
.لذلك علينا علاج كلّ شيء بأنفسنا

290
00:19:11,040 --> 00:19:14,580
لا يتسنّى لنا دخول المستشفيات
.خارجًا إلاّ إن كان مرضًا خطيرًا

291
00:19:14,710 --> 00:19:16,580
لم أعلم أنّ الأمور غير عادلة
.بالنّسبة لكم لهذه الدّرجة

292
00:19:16,710 --> 00:19:20,130
صحيح. لذلك السّبب أريد
.أن أصير طبيبًا وبسرعة

293
00:19:21,880 --> 00:19:25,500
أريد إنشاء مكان في مدينتنا بإمكانه
.علاج الحالات البسيطة على الأقلّ

294
00:19:26,250 --> 00:19:29,710
حصلتُ أخيرًا على الفرصة للدّراسة
،عندما صرت تلميذًا بمكانة خاصّة

295
00:19:30,420 --> 00:19:33,710
لكن أعتقد أنّ مدرسة بشر
.لن تسمح لي بالتّعلّم بسلام

296
00:19:34,500 --> 00:19:37,210
،أحاول ألاّ ألحق الأذى بأيّ أحد
،مهما كان ما سيحدث لي

297
00:19:37,330 --> 00:19:40,130
.لكنّ البشر يختبرون صبري باستمرار

298
00:19:40,580 --> 00:19:43,290
.لا أملك الوقت لذلك فحسب

299
00:19:46,380 --> 00:19:49,540
،قضاء الوقت في المدرسة عاديّ بالنّسبة لنا

300
00:19:49,670 --> 00:19:53,670
،ولكن بالنّسبة لوحشيّ مثل هيداكا-كُن
.فلا بدّ أنّه أمر بالغ الأهمّيّة

301
00:19:55,080 --> 00:20:01,080
،ليتهم لا يحاولون محاصرته
.ولا يقفون في طريق حلمه العزيز

302
00:20:02,750 --> 00:20:03,920
أساكا؟

303
00:20:04,380 --> 00:20:09,040
،إن كنتَ تشعر بالتّوتّر دائمًا
.قد تتعب وتتأثّر دراستك بسبب ذلك

304
00:20:09,670 --> 00:20:14,040
لذلك بإمكاني مساعدتك لتدفئة
.يديك على الأقلّ

305
00:20:14,750 --> 00:20:15,960
لماذا قد تفعلين ذلك؟

306
00:20:16,500 --> 00:20:18,880
.لأنّك صديقي

307
00:20:21,960 --> 00:20:23,830
...ماذا؟ أعني

308
00:20:23,960 --> 00:20:25,750
أ-ألا بأس بذلك؟

309
00:20:29,170 --> 00:20:31,830
،لا يوجد متّسع كبير هنا
.لذلك كفّي عن التّحرّك كثيرًا

310
00:20:31,960 --> 00:20:33,960
.آ-آسفة

311
00:20:35,000 --> 00:20:37,420
.إ-إنّه ناعم جدًّا

312
00:20:37,540 --> 00:20:38,750
...أواثقة

313
00:20:39,250 --> 00:20:40,540
أنّك تريدين أن نصير أصدقاء؟

314
00:20:40,670 --> 00:20:42,580
.أنا وحشيّ قبل كلّ شيء

315
00:20:43,290 --> 00:20:44,500
!أكيد

316
00:20:46,710 --> 00:20:49,040
.أسعدني ذلك

317
00:20:52,250 --> 00:20:56,880
يبدو وكأنّني تمكّنتُ من الطّرق
بلطف على الباب الصّغير

318
00:20:57,000 --> 00:20:59,500
.للقلب الّذي يسكن هذا الجسد الضّخم

319
00:21:00,290 --> 00:21:02,000
.أسعدني ذلك أيضًا

320
00:21:03,250 --> 00:21:04,880
...مهلاً، يدك

321
00:21:06,330 --> 00:21:09,330
.أعتقد أنّ التقطتُ حرارتك. كم هذا محرج

322
00:21:15,920 --> 00:21:18,380
!هيداكا-كُن؟

323
00:21:18,500 --> 00:21:19,580
أنت قريب جدًّا. ما هذا؟

324
00:21:19,710 --> 00:21:23,630
.آسف. ثمّة رائحة عطِرة جدًّا صادرة منك

325
00:21:24,380 --> 00:21:27,630
...كلّما شممتُها، شعرتُ بالهدوء أكثر

326
00:21:28,460 --> 00:21:30,170
.لكنّي أشعر بشيء ما في بطني بعدها

327
00:21:34,250 --> 00:21:36,920
...إنّ فروه يدغدغني

328
00:21:42,290 --> 00:21:43,540
...لا

329
00:21:46,790 --> 00:21:48,830
...أساكا

330
00:21:50,330 --> 00:21:51,880
ما هذا؟

331
00:21:53,380 --> 00:21:54,920
لماذا حدث هذا فجأة؟

332
00:21:55,920 --> 00:21:57,420
...إ-إنّه قويّ جدًّا

333
00:21:58,130 --> 00:21:59,670
.لا يمكنني التّحرّك

334
00:21:59,790 --> 00:22:00,880
!سيأكلني