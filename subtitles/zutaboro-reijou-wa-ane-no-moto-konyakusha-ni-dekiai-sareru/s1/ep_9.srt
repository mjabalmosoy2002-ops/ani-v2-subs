1
00:00:00,600 --> 00:00:05,280
هذا الرّجل... كان سائق العربة
الّتي ركبتها أناستاشيا-ساما

2
00:00:07,240 --> 00:00:08,640
هل كان أنت؟

3
00:00:09,310 --> 00:00:12,140
هل قتلت أناستاشيا شاديران؟

4
00:01:55,170 --> 00:01:58,540
كما توقّعت، لا يبدو أنّه سيخبرنا

5
00:02:00,280 --> 00:02:01,740
لقد أحضرتُه

6
00:02:05,840 --> 00:02:07,260
...يوهان

7
00:02:10,820 --> 00:02:15,530
.سمعتُ بأنّك من جُزُر بانديلي
أنا من نفس المنطقة

8
00:02:15,530 --> 00:02:18,030
ما الجزيرة الّتي وُلِدت فيها؟

9
00:02:18,030 --> 00:02:22,700
أ-أنت من بانديلي؟ لماذا تعمل في قلعة؟

10
00:02:23,590 --> 00:02:27,520
أمّ الكونت غرانادو هي لاجئة
من بلد آخر

11
00:02:27,520 --> 00:02:31,390
كَبُرَ أيضاً وهو يُعاني من إهانات
من شعب هذه المملكة

12
00:02:31,390 --> 00:02:34,370
.لهذا السّبب لا يستعمل التّمييز ضدّنا
يمكنك أن تطمئنّ من ذلك

13
00:02:35,040 --> 00:02:38,810
لم يستدعك مولايّ إلى هنا لإدانتك

14
00:02:38,810 --> 00:02:41,120
يريد أن يقدّم لك تعويضاً

15
00:02:41,120 --> 00:02:41,970
ماذا؟

16
00:02:42,570 --> 00:02:45,680
تعويض عن قتل أناستاشيا

17
00:02:48,440 --> 00:02:49,770
فهمت

18
00:02:49,770 --> 00:02:52,640
يوهان يكذب للحصول على الحقيقة منه

19
00:02:53,280 --> 00:02:58,060
كابنٍ للدّوق، كان المُعلّم مُرتبطاً
،بخطيبة من خلال واجب

20
00:02:58,060 --> 00:03:02,090
لكن كانت أختها الصّغرى ماري الّتي
تقف هنا هي الّتي وقع في حُبّها

21
00:03:02,090 --> 00:03:04,250
أنا متأكّد بأنّك لست بحاجة
لأخبرك بالباقي

22
00:03:04,740 --> 00:03:07,710
إذاً كانت الأخت الكبرى الجميلة عقبة

23
00:03:08,100 --> 00:03:12,760
بالفعل. ولذلك يريد مولايّ
أن يكافئك بشكل سرّي

24
00:03:12,760 --> 00:03:16,830
بل في الحقيقة، قد يُوظّفك هنا
في القلعة حتّى

25
00:03:18,220 --> 00:03:23,190
وإن كنتَ موظّفاً في قلعة، فلن يُوبّخك
مالك شركة تأجير العربات

26
00:03:23,190 --> 00:03:27,140
سـ-سيكون ذلك كثيراً، أليس كذلك؟

27
00:03:36,910 --> 00:03:39,910
أخبرنا بالحقيقة من فضلك يا ياكوب

28
00:03:40,260 --> 00:03:44,160
في ذلك اليوم، العجوز الّذي يدير
المتجر كان مُتحمّساً جدّاً

29
00:03:44,600 --> 00:03:48,420
!ياكوب، أحضر أفضل عربة

30
00:03:48,420 --> 00:03:50,280
ماذا؟ ما الأمر؟

31
00:03:50,280 --> 00:03:52,550
الابنة الكبرى للحاكم سوف تتزوّج

32
00:03:52,550 --> 00:03:56,120
وعمل كبير هذا نادراً ما يسنح

33
00:03:56,880 --> 00:03:59,590
المعذرة لو تأخّرتُ عليك أيّها البارون

34
00:03:59,590 --> 00:04:02,880
حضّرنا أفضل عربة لدينا لك

35
00:04:03,160 --> 00:04:06,580
تقريباً هذا هو المبلغ

36
00:04:07,290 --> 00:04:09,270
!كلام فارغ

37
00:04:09,270 --> 00:04:11,510
لن أدفع سوى نصف هذا المبلغ

38
00:04:11,510 --> 00:04:17,600
لـ-لكن بمبلغ كهذا، لا نستطيع توفير
عربة جيّدة أو نُزُل مُناسب

39
00:04:17,850 --> 00:04:21,220
إنّ إيجاد حلّ لذلك هو عملك، صحيح؟

40
00:04:21,220 --> 00:04:22,980
،ولو قلتَ لي ذلك

41
00:04:23,330 --> 00:04:27,750
لكن الآنسة الّتي ستتزوّج هي
ابنتك العزيزة، أليس كذلك؟

42
00:04:31,460 --> 00:04:34,540
ياكوب، أنت تفهم، أليس كذلك؟

43
00:04:34,540 --> 00:04:37,550
إذا مسست ابنة الحاكم بسوء
—فإنّ الطّرد هو أقلّ

44
00:04:37,550 --> 00:04:40,520
أجل، أجل. أعلم

45
00:04:40,520 --> 00:04:42,700
لكن هذا غريب، أليس كذلك؟

46
00:04:43,540 --> 00:04:46,090
،بخلاف تلك الابنة الصّغرى البالية

47
00:04:46,090 --> 00:04:49,360
فينبغي أن تكون الكبرى هي
المحبوبة، أليس كذلك؟

48
00:04:50,190 --> 00:04:52,420
!هذا ليس شأننا لنقلق

49
00:04:52,420 --> 00:04:54,150
!والآن هيّا، بسرعة

50
00:05:01,520 --> 00:05:06,490
!مولاتي! أنتِ جميلة كما تُفيد الإشاعات

51
00:05:06,490 --> 00:05:09,260
أنا واثق بأنّ أمامكِ الكثير من الخيارات
بين الرّجال، صحيح؟

52
00:05:09,260 --> 00:05:11,860
هل يُعقَل أنّكِ تتلاعبين بهم وتعبثين؟

53
00:05:11,860 --> 00:05:16,190
أمزح فحسب. آسف لوقاحتي

54
00:05:16,770 --> 00:05:19,540
أنا مُجرّد سائق مُستأجر مُتواضع
في نهاية المطاف

55
00:05:20,510 --> 00:05:21,810
إطلاقاً

56
00:05:21,810 --> 00:05:24,260
،موقفها جعلني أدرك

57
00:05:24,720 --> 00:05:28,400
أنّ الطّريقة الوحيدة الّتي تستطيع العيش
فيها هي بتنفيذ أوامر والديها

58
00:05:28,400 --> 00:05:31,080
كانت دُمية لا تملك شيئاً آخر غير مظهرها

59
00:05:36,770 --> 00:05:39,630
هكذا عرفتُ بأنّها لن تتمكّن من الهرب

60
00:05:40,270 --> 00:05:42,030
مهما حدث

61
00:05:50,100 --> 00:05:52,580
لـ-لماذا أوقفت العربة؟

62
00:05:52,580 --> 00:05:54,290
العاصمة الملكيّة قريبة، أليس كذلك؟

63
00:05:54,290 --> 00:05:56,900
سنُخيّم هنا في هذه اللّيلة

64
00:05:56,900 --> 00:05:59,170
والخيول مُرهَقة من المطر

65
00:05:59,480 --> 00:06:01,750
النّهر خطير ومنسوب المياه
مُرتفع بسبب الأمطار

66
00:06:01,750 --> 00:06:03,550
أليس هذا سبباً آخر للاستعجال؟

67
00:06:06,000 --> 00:06:10,450
،إ-إذا تجرأت على مسّ خطيبة كونت
هل تعلم ماذا سيحلّ بك؟

68
00:06:10,450 --> 00:06:12,810
لا، لا أُبالي

69
00:06:13,060 --> 00:06:17,250
عندما يكتشف الكونت بأنّ خطيبته
،قد دُنّست بواسطة أجنبيّ

70
00:06:17,250 --> 00:06:19,950
فلا أدري ما سيحلّ بكِ أنتِ

71
00:06:23,830 --> 00:06:25,150
!مؤلم

72
00:06:24,680 --> 00:06:25,500
!ميو

73
00:06:25,500 --> 00:06:27,000
!لم يُكمل قصّته بعد

74
00:06:26,010 --> 00:06:27,800
ماذا تفعلين؟

75
00:06:27,800 --> 00:06:30,670
!ماذا؟ ظننتُ بأنّ هذا ما أردتموه

76
00:06:31,570 --> 00:06:32,480
!ميو

77
00:06:35,510 --> 00:06:36,710
سأحلّ مكانك

78
00:06:40,990 --> 00:06:46,230
أنت! من أين حصلت على شعر وملابس
الدُّمية الّتي في بيت البارون؟

79
00:06:46,880 --> 00:06:47,710
!أخبرينا

80
00:06:48,410 --> 00:06:51,310
!أ-أخذتُ الملابس منها بنفسي

81
00:06:51,310 --> 00:06:52,480
والشّعر؟

82
00:06:52,480 --> 00:06:54,470
...كـ-كان ذلك

83
00:06:55,090 --> 00:06:57,680
!لا تتحرّكي! ابقي ثابتة

84
00:06:57,680 --> 00:06:59,850
!لا

85
00:07:02,190 --> 00:07:04,810
!قامت بقصّ شعرها بنفسها

86
00:07:04,810 --> 00:07:07,570
!انظروا! ما زالت آثار الجرح واضحة

87
00:07:07,570 --> 00:07:09,280
!تستحقّ هذا

88
00:07:09,820 --> 00:07:13,200
،وأنت جريح، أخذتَ الملابس والشّعر

89
00:07:13,660 --> 00:07:17,270
ثمّ بعتها للسيّدة إيلفيرا الّتي
أصيبَتْ بصدمة جرّاء وفاة ابنتها

90
00:07:17,270 --> 00:07:20,330
!لـ-لم أكن أخطّط لبيعها لها منذ البداية

91
00:07:20,560 --> 00:07:24,020
سمعتُ بأنّ البارونة كانت تبحث
!عن مواد لصنع دُمية

92
00:07:23,360 --> 00:07:26,970
،للتستُّر على جريمتك، دمّرتَ العربة

93
00:07:26,970 --> 00:07:29,970
وكذبتَ في شهادتك قائلاً بأنّك
هوجِمت بواسطة قُطّاع طُرُق

94
00:07:29,970 --> 00:07:33,450
!سقطتْ تلك المرأة في النّهر
!هذه هي الحقيقة

95
00:07:33,450 --> 00:07:35,760
!كانت تحاول الهرب فانزلقت

96
00:07:35,760 --> 00:07:37,630
!كان حادثاً

97
00:07:37,630 --> 00:07:39,430
!لم أقتلها

98
00:07:39,430 --> 00:07:41,470
!صدّقوني أرجوكم

99
00:07:41,470 --> 00:07:42,730
هذا يكفي

100
00:07:43,100 --> 00:07:44,510
لا أريد سماع المزيد

101
00:07:45,010 --> 00:07:46,050
ماري

102
00:07:50,330 --> 00:07:53,820
ماتت أختي الكبرى بسببك، أليس كذلك؟

103
00:07:59,580 --> 00:08:04,430
لـ-لكن أتعلم؟ أعتقد بأنّه كان التّصرُّف
الصّحيح ألّا تتّخذ تلك المرأة زوجة لك

104
00:08:04,830 --> 00:08:09,130
كانت تُخفي ملابس رجال في حقائبها

105
00:08:09,830 --> 00:08:14,120
يا لها من امرأة مجنونة! لا بُدّ أنّ كان
!لديها رجال آخرون غير خطيبها

106
00:08:14,120 --> 00:08:17,680
حتّى لو تزوّجتك، كانت ستخونك بالتّأكيد

107
00:08:17,680 --> 00:08:19,610
!لا تُهِن أختي

108
00:08:25,800 --> 00:08:29,830
ما-ماذا؟ هل تريدين أن تحصلي على
ما حصلتْ عليه تلك المرأة أيضاً؟

109
00:08:29,830 --> 00:08:30,680
!كُفّ عن الكلام

110
00:08:38,930 --> 00:08:41,530
...أختي، أنا

111
00:08:48,050 --> 00:08:51,080
أنا آسفة جدّاً يا كيروس-ساما

112
00:08:51,080 --> 00:08:54,150
لا، أنا من ينبغي أن يعتذر

113
00:08:55,740 --> 00:09:00,820
قبل الآن، لم أحزن على وفاة أناستاشيا

114
00:09:01,410 --> 00:09:02,430
ماذا؟

115
00:09:02,430 --> 00:09:03,680
ولا أنا

116
00:09:05,540 --> 00:09:06,830
...ميو

117
00:09:06,830 --> 00:09:12,990
اعتقدنا بأنّ أناستاشيا اضطهدتكِ
مثلما فعل والداكِ

118
00:09:13,540 --> 00:09:17,170
!لـ-لم تفعل! ولا حتّى مرّة

119
00:09:17,170 --> 00:09:19,870
أجل، أتفهّم ذلك الآن

120
00:09:19,870 --> 00:09:21,710
لهذا أشعر بتأنيب الضّمير

121
00:09:22,830 --> 00:09:27,230
ظننتُ بأنّ موتها كان عقوبتها الإلهيّة

122
00:09:27,230 --> 00:09:28,700
وهذا ليس كلّ شيء

123
00:09:29,100 --> 00:09:32,550
ظننتُ بأنّ خطبتي منها بالخطأ
كان ضرباً من الحظّ السّعيد

124
00:09:32,550 --> 00:09:34,830
بسبب ذلك الخطأ، بقيتِ آمنة يا ماري

125
00:09:34,830 --> 00:09:36,720
هذا ما آمنتُ به

126
00:09:37,590 --> 00:09:41,520
للأمانة، كان ينبغي أن أكون
أنا من يتواجد في تلك العربة

127
00:09:41,520 --> 00:09:44,940
كانت أختي هناك بالنّيابة عنّي

128
00:09:44,940 --> 00:09:49,650
ماري... هلّا سمحتِ لي بالاعتذار
عند قبر أناستاشيا؟

129
00:09:50,050 --> 00:09:51,470
ليس لديها قبر

130
00:09:51,960 --> 00:09:54,320
قال أبي بأنّ بناء شاهدة قبر
سيكون إسرافاً

131
00:09:55,830 --> 00:09:58,190
كانت جنازتها بسيطة جدّاً أيضاً

132
00:09:58,190 --> 00:10:03,000
في النّهاية، لم يُنقَش اسم أختي
حتّى في المقبرة العامّة

133
00:10:03,480 --> 00:10:06,620
أريد على الأقلّ أن أقدّم
بعض الرّاحة لروحها

134
00:10:06,620 --> 00:10:08,920
هل من مكان كانت تُحبّه أناستاشيا؟

135
00:10:08,920 --> 00:10:11,220
زهور أو طعام؟ ماذا عن أُغنية؟

136
00:10:14,850 --> 00:10:16,920
لا أعرف شيئاً

137
00:10:18,160 --> 00:10:22,790
في مرحلة ما، أصبح الفرق بيننا شاسعاً

138
00:10:23,460 --> 00:10:27,580
،أنا، الّتي ترتدي ملابس رثّة دوماً
لكن تستطيع السّير بحرّية في الخارج

139
00:10:28,430 --> 00:10:32,670
وأختي الّتي كانت تُجبَر على ارتداء
ملابسها في حديقة صغيرة مُسوّرة

140
00:10:34,120 --> 00:10:37,580
كائن مثاليّ ينبغي أن يُحَبّ
بواسطة الجميع

141
00:10:37,960 --> 00:10:42,780
واعتقدتُ بأنّ ذلك كان سبب
أخذها بواسطة الآلهة

142
00:10:45,670 --> 00:10:50,200
لكن حتّى أختي... كانت مُجرّد
شخص يعيش حياته فحسب

143
00:10:50,700 --> 00:10:54,290
إنّه أمر واضح، لكن كنتُ قد نسيتُ ذلك

144
00:10:55,760 --> 00:10:57,990
كلّ هذا غلطتي

145
00:10:57,990 --> 00:11:01,750
لم يكن أملك حقّاً بلكم ذلك الرّجل

146
00:11:02,860 --> 00:11:04,620
ولا أنا

147
00:11:05,700 --> 00:11:07,220
...لأنّني

148
00:11:07,920 --> 00:11:10,880
أنا مُجرّد شخص من بين الكثيرين
الّذين قتلوا أناستاشيا

149
00:11:17,310 --> 00:11:19,990
ارقدي بسلام يا أناستاشيا

150
00:11:24,310 --> 00:11:28,580
يمتدّ هذا الماء كلّ الطّريق إلى
حيّ الحِرفيّين في العاصمة الملكيّة

151
00:11:29,060 --> 00:11:30,790
،بينما كانت لا تزال على قيد الحياة

152
00:11:30,790 --> 00:11:34,300
قالت أختي ذات مرّة بأنّها تريد
تصميم الملابس في العاصمة

153
00:11:35,250 --> 00:11:41,470
في مكان حيويّ كهذا، لن تشعر
أناستاشيا بالوحدة غالباً

154
00:11:41,470 --> 00:11:42,930
أجل

155
00:11:49,250 --> 00:11:51,980
!ماري! لنلعب

156
00:11:58,670 --> 00:12:00,520
آمل أن يكون ذلك صحيحاً

157
00:12:04,950 --> 00:12:10,530
مضى أسبوع منذ ذلك الحين، والأجواء
في القلعة قد عادت إلى طبيعتها

158
00:12:11,260 --> 00:12:13,830
الآنسة ماري تُطرّز

159
00:12:14,550 --> 00:12:17,640
وماذا تفعل أنت؟

160
00:12:17,640 --> 00:12:21,890
،إذا وخزتْ ماري إصبعها بإبرة
فأنا هنا لمُعالجتها فوراً

161
00:12:18,590 --> 00:12:24,970
علبة
دواء

162
00:12:21,890 --> 00:12:24,340
إذاً أنت لا تفعل شيئاً

163
00:12:24,890 --> 00:12:26,500
!انتهى

164
00:12:26,500 --> 00:12:30,170
كيروس-ساما، سأستخدم شعرك للحظة

165
00:12:30,470 --> 00:12:31,570
!بالطّبع

166
00:12:32,300 --> 00:12:35,270
تـ-تحوّل ابني إلى كلب مُخلص

167
00:12:32,510 --> 00:12:34,600
الرّجاء النّظر إلى الاتّجاه الآخر

168
00:12:34,600 --> 00:12:35,540
هكذا؟

169
00:12:35,540 --> 00:12:37,150
والآن أرجو النّظر للأمام

170
00:12:40,110 --> 00:12:42,310
شعرك جميل جدّاً

171
00:12:44,890 --> 00:12:48,790
ماري، تتحرّك أصابعكِ بطريقة
جذّابة. هذا يمنح شعوراً لطيفاً

172
00:12:50,690 --> 00:12:52,620
!كلاكما بريئان

173
00:12:52,620 --> 00:12:55,030
كزوجين هما الحُبّ الأوّل
في نظر بعضهما الآخر

174
00:12:55,030 --> 00:12:56,590
معكِ حقّ. فإن يكن؟

175
00:12:57,080 --> 00:13:00,010
حدثت أمور كثيرة جعلَتني أؤجّل
تقديم هذه لكُن

176
00:13:00,010 --> 00:13:02,300
!إنّها هدايا اشتريتُها من السُّوق

177
00:13:02,870 --> 00:13:05,770
!شكراً جزيلاً لكِ

178
00:13:05,770 --> 00:13:07,180
!ما أجملها

179
00:13:07,860 --> 00:13:09,320
إنّها ظريفة، أليس كذلك؟

180
00:13:09,020 --> 00:13:10,100
ماري-ساما

181
00:13:09,320 --> 00:13:10,910
بالفعل

182
00:13:11,520 --> 00:13:13,480
،قد تكون الهدايا المتعة الحقيقيّة للسّفر

183
00:13:13,480 --> 00:13:16,540
لكن أعتقد بأنّ إنفاق المال والجهود
—عليّ هو مضيعة لـ

184
00:13:15,860 --> 00:13:17,440
!يكفي! اقبلي الهديّة فحسب

185
00:13:17,440 --> 00:13:25,240
نكز نكز نكز نكز نكز نكز

186
00:13:17,730 --> 00:13:21,820
يجدر بكِ أن تكوني سعيدة فقط
وتصيحي من الفرحة مثلي

187
00:13:21,820 --> 00:13:25,230
!أ-أنا آسفة! لم أقصد فرضها عليكِ

188
00:13:27,770 --> 00:13:29,670
أقبل

189
00:13:29,670 --> 00:13:31,870
شكراً لكِ يا ماري-ساما

190
00:13:32,810 --> 00:13:36,290
.شكراً لكِ على كلّ ما تفعلينه
!أحبّكِ يا ميو

191
00:13:41,720 --> 00:13:45,720
منذ وصولكِ يا آنسة ماري، تغيّرتْ
سلوكيّات الجميع قليلاً

192
00:13:45,720 --> 00:13:47,930
حقّاً؟

193
00:13:48,430 --> 00:13:49,920
...وبالنّسبة لكِ يا ماري

194
00:13:49,920 --> 00:13:51,940
لديّ هديّة كذلك

195
00:13:53,170 --> 00:13:55,390
!قصّة القطّة الحمراء الرّثّة

196
00:13:55,770 --> 00:13:57,640
!عُدّلَتْ بشكل جميل

197
00:13:57,640 --> 00:14:00,510
...بما أنّكِ كنتِ ستُعدّلينها بنفسكِ

198
00:14:02,720 --> 00:14:06,370
.هذا الكتاب مليء بذكريات أختي
إنّه عزيز جدّاً على قلبي

199
00:14:07,130 --> 00:14:08,910
شكراً جزيلاً لكِ

200
00:14:09,340 --> 00:14:11,720
يسرّني أنّه أعجبكِ فحسب

201
00:14:11,720 --> 00:14:12,960
وهذا أيضاً

202
00:14:13,640 --> 00:14:15,890
شخصيّات بارزة حول العالم"؟"

203
00:14:15,890 --> 00:14:17,570
أنا من طلبتُ هذا

204
00:14:18,460 --> 00:14:23,290
هذه أمّ  البارون شاديران وجدّتكِ
يا ماري. ساشا تيليك

205
00:14:23,690 --> 00:14:25,870
جدّتي عندما كانت صغيرة

206
00:14:25,870 --> 00:14:29,640
ماري، أخبرتِني بأنّ أناستاشيا
كانت تُشبهها كثيراً

207
00:14:29,950 --> 00:14:33,920
ارتأيتُ بأنّ هذا قد يُساهم في
التقاط أوصافها في لوحة

208
00:14:34,810 --> 00:14:37,730
شكراً لك يا كيروس-ساما

209
00:14:38,100 --> 00:14:40,990
إذاً أختكِ الكبرى كانت تشبه جدّتكِ

210
00:14:40,990 --> 00:14:42,610
فهل هذا يعني أنّكِ تشبهين أمّكِ؟

211
00:14:42,900 --> 00:14:46,000
من حيث الطّول وسِمات الوجه، أجل

212
00:14:46,000 --> 00:14:50,030
لكن أمّي شقراء. أنا الوحيدة
الّتي شعرها أحمر

213
00:14:50,500 --> 00:14:54,670
،الشّعر الأحمر سيجلب الدّمار للمنزل
لذا تجنّبتني

214
00:14:54,670 --> 00:14:59,980
ماذا؟! ما زال هناك أُناساً يُصدّقون
مثل هذه الخرافة القديمة؟

215
00:14:59,980 --> 00:15:00,920
أجل، أتّفق

216
00:15:01,190 --> 00:15:04,520
لكن لماذا جدّتي موجودة بين
الشّخصيّات البارزة؟

217
00:15:04,520 --> 00:15:08,140
يا إلهي! أنتما قريبتان، لكن
لم تسمعي بالبطلة ساشا؟

218
00:15:08,140 --> 00:15:09,110
إنّها مشهورة جدّاً

219
00:15:09,110 --> 00:15:10,100
ماذا؟

220
00:15:10,760 --> 00:15:15,000
،بالرّغم من أنّه عند الولادة أثناء الحرب
عندما لم يكن للنّساء مكانة حقيقيّة

221
00:15:18,180 --> 00:15:20,440
تُجيد سبع لغات. عبقريّة حقيقيّة

222
00:15:20,750 --> 00:15:25,220
أحدثتْ جدّتُكِ ثورة مثلما تتقدّم
النّساء في المُجتمعات

223
00:15:25,220 --> 00:15:26,950
حقّاً؟

224
00:15:27,200 --> 00:15:30,690
لعلّ أمثال أبيكِ لديهم عقدة ما

225
00:15:30,690 --> 00:15:33,070
كانت صارمة في تربيته

226
00:15:33,480 --> 00:15:38,220
لستُ متأكّدة من ذلك. لم يتفاعل
أبي مع جدّتي كثيراً

227
00:15:38,220 --> 00:15:40,870
لعلّه كان هناك خِلافاً بينهما

228
00:15:41,460 --> 00:15:44,330
...بخصوص البارون شاديران

229
00:15:44,920 --> 00:15:47,370
،أرسلنا دعوة من أجل مراسم الخطوبة

230
00:15:47,370 --> 00:15:48,550
لكن لم نتلقّ ردّاً

231
00:15:48,960 --> 00:15:50,620
!ماذا؟ هذا مستحيل

232
00:15:50,620 --> 00:15:54,520
أكثر من عدم القدرة على ترتيب اجتماع
بخصوص ذلك، لا نعلم حتّى ما إن كان سيحضر

233
00:15:54,900 --> 00:15:57,810
الشّخص الّذي أحضر ماري إلى هنا
لم يكن سوى البارون بحدّ ذاته

234
00:15:58,290 --> 00:16:01,510
لماذا يعارض الزّواج الآن؟

235
00:16:02,040 --> 00:16:06,680
لا أعتقد بأنّ والدَي أراداني أن أتزوّج يوماً

236
00:16:07,310 --> 00:16:12,770
،لو كنتُ أستطيع توفير خدمة ولو لليلة واحدة
لما اضطررنا لإعادة هدايا الخطوبة الخاصّة بأختي

237
00:16:12,770 --> 00:16:13,740
...رغم ذلك

238
00:16:14,330 --> 00:16:17,260
إذا اكتسب علاقات بعائلة دوقيّة
،من خلال هذا الزّواج

239
00:16:17,260 --> 00:16:19,290
فإنّ مكانته سترتقي بشكل كبير

240
00:16:19,640 --> 00:16:22,510
...مهما عملتِ بجدّ يا ماري

241
00:16:22,510 --> 00:16:23,790
...ربّما

242
00:16:24,120 --> 00:16:28,710
لأنّ ماري-ساما كانت تقوم بعمل مُهمّ
لا يستطيع ائتمان شخص آخر عليه

243
00:16:30,430 --> 00:16:35,690
لكن كنتُ أقوم بأشياء بسيطة تعلّمتُها
من جدّتي وأنا طفلة

244
00:16:36,290 --> 00:16:41,970
جدّتكِ عملتْ كحاكمة للأرض بالنّيابة
عن البارون السّابق، أليس كذلك؟

245
00:16:42,250 --> 00:16:43,790
أ-أجل

246
00:16:43,790 --> 00:16:50,190
سمعتُ بأنّ الرّسميّات المشمولة في تبوُّء
منصب الحاكم المحلّي كانت صعبة

247
00:16:50,190 --> 00:16:53,230
،وجدّتكِ وأبوكِ

248
00:16:53,540 --> 00:16:56,870
البارون الحاليّ شاديران، كان
يوجد خلاف بينهما

249
00:16:56,870 --> 00:17:01,950
في السّابق، أخبرتِني بأنّكِ كتبتِ رسائلَ
بالنّيابة عن الحاكم، أليس كذلك؟

250
00:17:02,520 --> 00:17:05,310
هل يستطيع أبوكِ الكتابة
والقراءة بالفلاريانيّة؟

251
00:17:05,310 --> 00:17:08,750
أجل، بالطّبع! أؤمن بأنّه يستطيع

252
00:17:08,990 --> 00:17:11,540
هل رأيتِه يوماً يستخدم هذه اللّغة؟

253
00:17:13,190 --> 00:17:16,090
على ذكر الأمر، لم أره

254
00:17:16,090 --> 00:17:18,770
لكن من المستحيل ألّا يستطيع النّطق بها

255
00:17:18,770 --> 00:17:20,960
الفلارانيّة هي اللّغة العامّة للطّبقة النّبيلة

256
00:17:21,280 --> 00:17:24,670
لو لم يكن يستطيع النّطق بها، لما
تمكّن من أداء واجباته كحاكم

257
00:17:25,200 --> 00:17:26,360
توقّعت

258
00:17:26,660 --> 00:17:28,850
مستحيل. لا أُصدِّق ذلك

259
00:17:29,410 --> 00:17:31,240
ما الأمر؟

260
00:17:31,560 --> 00:17:35,820
ميو، أرسلي لعائلة شاديران استدعاء إلزاميّاً

261
00:17:35,820 --> 00:17:36,800
ماذا؟

262
00:17:36,800 --> 00:17:38,720
،إن لم يردّوا على ذلك أيضاً

263
00:17:38,720 --> 00:17:40,710
فسيترتّب علينا اقتيادهم للمُحاكمة
في محكمة المملكة

264
00:17:40,990 --> 00:17:45,110
أنا آسف يا ماري. أردتُ مُعالجة
هذه الأمور بهدوء قدر المُستطاع

265
00:17:45,110 --> 00:17:46,840
ما الّذي يجري؟

266
00:17:47,520 --> 00:17:51,170
ما الّذي فعله أبي؟

267
00:17:53,670 --> 00:17:56,010
بعد أربعة أيّام

268
00:17:59,540 --> 00:18:00,380
ماري

269
00:18:08,980 --> 00:18:15,230
،مرحباً جميعاً! إنّه الأمير الّذي يُحبّه الجميع
!لويفون ساندالكيا ديلتز

270
00:18:16,750 --> 00:18:18,340
لماذا أنت؟

271
00:18:19,940 --> 00:18:22,910
عزيزتي ميو، تحبّين الخشونة

272
00:18:22,910 --> 00:18:24,580
يكفي. كُل قبل أن يبرد

273
00:18:27,030 --> 00:18:28,770
!هذا شهيّ

274
00:18:28,770 --> 00:18:31,410
لا أتوقّع أقلّ من هذا من طبّاخ قلعة غرانادو

275
00:18:31,410 --> 00:18:33,800
—أتمنّى استضافته في

276
00:18:34,320 --> 00:18:36,220
أنت لطيف جدّاً، سموّك

277
00:18:36,220 --> 00:18:39,580
نقص وزنه كثيراً، أليس كذلك؟

278
00:18:40,220 --> 00:18:43,330
ستحضر العائلةُ الملكيّة مراسمَ الخطوبة

279
00:18:43,330 --> 00:18:45,800
...وكذلك النّبلاء وعامّة النّاس من بلدان عديدة، لذا

280
00:18:45,800 --> 00:18:50,050
هكذا إذاً. كنتَ مشغولاً بتطوير
وصفات وتوفير المُكوّنات

281
00:18:50,050 --> 00:18:52,720
توبّو، لا تضغط على نفسك كثيراً

282
00:18:53,250 --> 00:18:54,560
أبداً

283
00:18:54,560 --> 00:18:57,900
،كلّ هذا هو ما أتمنّى أنا، توبّو، صنعه
لذا أنا مُتحمّس أكثر من أيّ وقت مضى

284
00:18:58,360 --> 00:18:59,450
توبّو

285
00:19:00,880 --> 00:19:04,610
كيروس، أنت محظوظ بوجود خدم كهؤلاء لك

286
00:19:04,610 --> 00:19:08,200
أجل. لكن الأهمّ، ما الّذي جاء
بك إلى هنا اليوم؟

287
00:19:09,340 --> 00:19:10,840
...في الواقع

288
00:19:13,660 --> 00:19:15,620
خاتم خطوبتك

289
00:19:16,010 --> 00:19:19,850
أتيتُ لأتفقّد المقاس قبل
تثبيت الحجر في مكانه

290
00:19:19,850 --> 00:19:22,120
والآن يا عزيزتي ماري، مدّي يدكِ

291
00:19:22,580 --> 00:19:24,020
!توقّف مكانك

292
00:19:24,020 --> 00:19:24,730
ماذا؟

293
00:19:24,730 --> 00:19:26,970
أتفقّد المقاس فحسب

294
00:19:26,970 --> 00:19:30,630
لا! حتّى ولو كان ذلك لتفقُّد
!المقاس! ابتعد قليلاً

295
00:19:30,630 --> 00:19:31,900
حسناً، حسناً

296
00:19:34,740 --> 00:19:37,160
هل يمكنني تفقُّد المقاس؟

297
00:19:37,160 --> 00:19:38,060
أجل

298
00:19:38,060 --> 00:19:41,770
لم يُثبت الحجر في مكانه بعد، لذا
لا تُحرّكي يدكِ كثيراً رجاء

299
00:19:46,820 --> 00:19:48,380
إنّه مثاليّ

300
00:19:48,380 --> 00:19:51,780
لم أكن أعلم بأنّ ارتداء خاتم
يمنح شعوراً لطيفاً كهذا

301
00:19:51,780 --> 00:19:54,410
لم ترتدي خاتماً من قبل؟

302
00:19:54,780 --> 00:19:55,800
أبداً

303
00:19:56,380 --> 00:19:59,340
!يسرّني أنّني أوقفتُ لويفون

304
00:19:59,880 --> 00:20:04,070
بحث كيروس-ساما عن حجر لمُطابقة لون شعري

305
00:20:04,070 --> 00:20:08,390
هذا الخاتم صُنِع خصّيصاً لي

306
00:20:13,500 --> 00:20:14,790
...ماري

307
00:20:14,790 --> 00:20:16,610
شكراً لك

308
00:20:17,190 --> 00:20:21,410
حقيقة أنّ خاتمي الأوّل هو هديّة
منك تجعلني سعيدة حقّاً

309
00:20:25,660 --> 00:20:27,600
أحبّكِ يا ماري

310
00:20:28,090 --> 00:20:30,170
أحبّكِ من أعماق قلبي

311
00:20:30,570 --> 00:20:31,630
!يراودني نفس الشّعور

312
00:20:32,700 --> 00:20:34,790
...أكثر من أيّ شخص آخر في العالم

313
00:20:36,020 --> 00:20:37,630
...أنت الّذي

314
00:20:39,400 --> 00:20:41,560
أنتما! ألم تنتهيا بعد؟

315
00:20:43,970 --> 00:20:46,140
حسناً، ما رأيكِ به؟

316
00:20:46,140 --> 00:20:48,830
جـ-جودة الصّنع رائعة

317
00:20:48,830 --> 00:20:53,350
ظننتُ بأنّ الحِرفيّ الوحيد القادر على
عمل من هذا النّوع كان نورمان

318
00:20:53,350 --> 00:20:57,680
هل تقصد حِرفيّ الأزرار سميث نورمان؟

319
00:20:57,680 --> 00:20:58,480
أجل

320
00:20:59,480 --> 00:21:03,410
أعلم بأنّه كبير في السّنّ، لكن
من المُؤسف أن يتقاعد

321
00:21:03,410 --> 00:21:05,690
كانت لديه مهارات مُذهلة حقّاً

322
00:21:05,690 --> 00:21:08,530
كان صانع أزرار يصنع خواتمَ أيضاً؟

323
00:21:08,530 --> 00:21:11,570
كانت الأزرار في الأصل نوعاً
من المُجوهرات القيّمة

324
00:21:12,200 --> 00:21:14,650
إنّ الحرص بشأنها يُبدي
عناية بمظهر الشّخص

325
00:21:14,650 --> 00:21:17,700
بعض الملابس تُصنَع أحياناً
لتتطابق مع الأزرار

326
00:21:18,580 --> 00:21:20,300
هكذا إذاً

327
00:21:20,300 --> 00:21:26,850
بالفعل. الوحيد القادر على تنفيذ تصميم
هذا الخاتم قد يكون نورمان

328
00:21:26,850 --> 00:21:27,610
ماذا؟

329
00:21:28,060 --> 00:21:32,020
هل تقصد... بأنّ سميث نورمان
!بحدّ ذاته من صنع هذا؟

330
00:21:33,530 --> 00:21:37,370
هذا صحيح! إنّها هديّتي الحقيقيّة لكما

331
00:21:37,370 --> 00:21:40,170
!رحتُ إليه أثناء تقاعده وتوسّلتُ له

332
00:21:40,170 --> 00:21:41,180
أنا، من بين كلّ النّاس

333
00:21:41,180 --> 00:21:43,400
!لا عجب

334
00:21:43,680 --> 00:21:46,370
شكراً لك يا سعادة الأمير لويفون

335
00:21:46,370 --> 00:21:50,990
لكن نورمان مشهور بعِناده، أنا
مُندهش من قدرتك على إقناعه

336
00:21:50,990 --> 00:21:55,610
،بدا بأنّه حصل على تلميذ جديد
لذا ربّما يكون قد غيّر رأيه

337
00:21:55,610 --> 00:21:56,780
تلميذ؟

338
00:21:56,780 --> 00:22:00,470
أجل. يبدو أنّه تبنّى طفلاً ليقطاً أو مُتشرّداً

339
00:22:00,810 --> 00:22:03,350
حدث ذلك قبل ثلاثة أشهر في حيّ
الحِرفيّين في العاصمة الملكيّة

340
00:22:03,620 --> 00:22:04,600
ماذا؟

341
00:22:04,920 --> 00:22:06,390
لقيط؟

342
00:22:06,390 --> 00:22:09,310
،بفرض أنّه أتى من خارج العاصمة
هل كان طفلاً من مزرعة؟

343
00:22:09,310 --> 00:22:12,930
التّباينات الإقليميّة هي مُشكلة بالنّسبة الحكومة
الملكيّة، أليس كذلك يا أمير لويفون؟

344
00:22:13,160 --> 00:22:14,560
...قبل ثلاثة أشهر

345
00:22:17,590 --> 00:22:19,810
...حيّ الحِرفيّين في العاصمة الملكيّة

346
00:22:21,510 --> 00:22:24,910
!هذا... غير ممكن

347
00:23:58,470 --> 00:24:00,220
،مولاتنا جميلة

348
00:24:00,220 --> 00:24:04,990
،لكن عندما يتعلّق الأمر بأختها الكبرى
فإنّ وجهها يتجهّم دوماً

349
00:24:05,380 --> 00:24:08,360
"الحلقة القادمة، "من فضلك افسخ الخطوبة

350
00:24:08,760 --> 00:24:11,380
سأعبس إذا لم تُشاهدوها