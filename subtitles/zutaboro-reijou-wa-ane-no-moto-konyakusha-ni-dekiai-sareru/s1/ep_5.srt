1
00:00:00,750 --> 00:00:03,670
،اسمي لويفون ساندالكيا ديلتز

2
00:00:03,670 --> 00:00:06,590
الأمير الثّالث لهذه البلاد وقائد الفُرسان

3
00:00:06,590 --> 00:00:08,720
...لكن رُبّما الأهمّ من كلّ ذلك

4
00:00:09,660 --> 00:00:11,860
!أنا صديق كيروس العزيز

5
00:00:12,120 --> 00:00:14,990
!سُرِرتُ بلقائكِ يا عزيزتي ماري

6
00:00:14,990 --> 00:00:18,140
إ-إذاً هذه هي طبيعته كشخص

7
00:01:52,290 --> 00:01:55,140
مهما انتظرنا من فترة طويلة يا سعادة
،الأمير لويفون، لم تأتِ أبداً

8
00:01:55,140 --> 00:01:57,530
لذا كنتُ مُستعدّة لإعادة ماري-ساما
إلى المنزل دون رؤيتك

9
00:01:57,530 --> 00:02:01,930
قلتُ بأنّني آسف، أليس كذلك؟
أكون عديم الرّحمة أحياناً يا عزيزتي ميو

10
00:02:01,930 --> 00:02:03,850
"لا تُنادِني "بعزيزتي

11
00:02:03,850 --> 00:02:04,590
ميو

12
00:02:04,590 --> 00:02:05,470
...بالمناسبة

13
00:02:05,750 --> 00:02:07,240
هل أنتِ جائعة؟

14
00:02:07,240 --> 00:02:10,110
كيف يبدو بوفيه فاخر في صالون النُّبلاء؟

15
00:02:10,110 --> 00:02:11,330
...نُبلاء

16
00:02:12,730 --> 00:02:15,560
لـ-لستُ جائعة جدّاً

17
00:02:15,850 --> 00:02:19,750
إيلزا وهانّا ليستا هنا بعد
الآن. لا تقلقي

18
00:02:19,750 --> 00:02:23,160
أنا آسف لأنّني أوصيتُ بهما
دون معرفة شخصيّتهما

19
00:02:23,160 --> 00:02:25,280
لا، الأمر ليس كذلك

20
00:02:25,280 --> 00:02:28,200
فكرة مكان راقٍ كصالون تُوتّرني

21
00:02:30,160 --> 00:02:33,040
في هذه الحالة، ما رأيكِ بعرض
مهارات المُبارزة بالسّيف؟

22
00:02:33,040 --> 00:02:35,150
!لديّ مقاعد محجوزة. لنذهب ونتفرّج

23
00:02:35,150 --> 00:02:37,460
مُـ-مُبارزة بالسّيف؟

24
00:02:37,460 --> 00:02:38,300
!هذا صحيح

25
00:02:38,300 --> 00:02:41,640
...أنا، في الواقع

26
00:02:43,400 --> 00:02:45,880
ماري-ساما، لا داعي لتضغطي على نفسكِ

27
00:02:45,880 --> 00:02:47,930
تكرهين المُنافسات، أليس كذلك؟

28
00:02:47,930 --> 00:02:50,040
!ماذا؟! لكن لماذا؟

29
00:02:50,040 --> 00:02:52,150
!هذه إحدى أفضل التّسالي الأرستقراطيّة

30
00:02:52,150 --> 00:02:54,690
!أجل، من فضلك، أتمنّى مُشاهدة ذلك

31
00:02:54,690 --> 00:02:56,800
!هذه هي ردّة الفعل الّتي كنتُ أتمنّاها

32
00:02:56,800 --> 00:02:59,480
من حيث المُبارزة بالسّيف، يمكنني
الوقوف في وجه أيّ فارس

33
00:02:59,480 --> 00:03:03,860
مدحني كيروس ذات مرّة بالقول، "السّيف هو
"المكان الوحيد الّذي تُظهِر فيه عبقريّتك

34
00:03:04,100 --> 00:03:07,650
هل كيروس-ساما قويّ حقّاً؟

35
00:03:07,650 --> 00:03:09,090
!أجل، بالفعل

36
00:03:09,800 --> 00:03:13,060
تلقّي مديح بواسطة كيروس-ساما
أسعدَك، أليس كذلك؟

37
00:03:16,350 --> 00:03:21,250
سوف نشرع الآن في نصف نهائي عرض
!مهارات المُبارزة بالسّيف لمملكة ديلتز

38
00:03:23,460 --> 00:03:26,000
هذا الحماس عالٍ، أليس كذلك؟

39
00:03:26,000 --> 00:03:28,240
في العام الماضي، نمتُ أثناء الحفل الغنائي

40
00:03:28,240 --> 00:03:30,800
وظلّ عزيزي كيروس يقرص خدَّي

41
00:03:31,320 --> 00:03:34,690
الأمير لويفون يحبّ كيروس-ساما حقّاً، أليس كذلك؟

42
00:03:34,690 --> 00:03:36,570
أستمتع بالإصغاء له

43
00:03:36,570 --> 00:03:39,660
هذا لأنّه من المُمتع التكلُّم مع الآخرين
حول الأشياء الّتي نُحبّها

44
00:03:40,720 --> 00:03:41,740
حسناً إذاً

45
00:03:42,200 --> 00:03:44,700
سأذهب وأوفّر بعض الطّعام

46
00:03:44,700 --> 00:03:46,530
ماذا؟ لكن أكلنا للتو

47
00:03:46,530 --> 00:03:48,580
ارتأيتُ أن أذهب وأزور كافّة الأكشاك

48
00:03:48,580 --> 00:03:50,910
كالعادة، معدتك هي بُعد مُنفصل كُلّياً

49
00:03:50,910 --> 00:03:52,330
اذهبي وكُلي قدر ما تشائين

50
00:04:00,180 --> 00:04:03,070
هذا المُقاتل بالدّرع الأسود
هو مُحارب مُبهر

51
00:04:03,070 --> 00:04:04,460
هكذا إذاً

52
00:04:05,010 --> 00:04:09,470
هل أنتِ هكذا مع كيروس أيضاً؟

53
00:04:09,470 --> 00:04:10,520
ماذا؟

54
00:04:11,500 --> 00:04:12,740
...في الواقع

55
00:04:12,740 --> 00:04:16,010
كنتُ أقول فقط بأنّكِ نوع جديد

56
00:04:16,010 --> 00:04:18,140
وأنا أعرف كيروس منذ زمن طويل

57
00:04:18,530 --> 00:04:22,020
سمعتُ بأنّكما كنتُما في نفس العام في المدرسة

58
00:04:22,020 --> 00:04:25,030
!أجل، وفي أوّل مرّة التقينا تشاجرنا

59
00:04:25,030 --> 00:04:26,110
!ماذا؟

60
00:04:26,450 --> 00:04:31,800
في المدرسة، كان هو ثاني أقرب شخص لي
من حيث التّصنيف، كابن دوق

61
00:04:31,800 --> 00:04:36,380
لكن قال، "كُفّ عن الحكم على الأشخاص اعتماداً
"على تصنيفهم، أيّها الأمير الأبله

62
00:04:36,380 --> 00:04:37,790
ا-الأبله؟

63
00:04:37,790 --> 00:04:42,350
قلتُ لنفسي، "ما مُشكلته" ولكمتُه
ثمّ ردّ اللّكمة إليّ

64
00:04:42,350 --> 00:04:44,430
تحوّل الأمر إلى فوضى عارمة

65
00:04:47,300 --> 00:04:49,590
هل يستحقّ الأمر كلّ هذا الضّحك؟

66
00:04:54,720 --> 00:04:57,070
!الرّابح، المُحارب حالك السّواد

67
00:04:57,770 --> 00:05:00,050
هل انتهى الأمر فعلاً؟

68
00:05:00,050 --> 00:05:03,270
،أجل. بإسقاط سيف الفارس الأزرق

69
00:05:03,270 --> 00:05:05,720
تمكّن مُحارب الظّلام من الفوز
بهجمة واحدة

70
00:05:05,720 --> 00:05:07,920
بحسب ما يبدو، كان يتحفّظ

71
00:05:07,920 --> 00:05:10,530
يبدو أنّه لطيف بما يكفي للقلق على خصومه

72
00:05:13,180 --> 00:05:14,610
...عزيزتي ماري

73
00:05:15,200 --> 00:05:18,280
ألا يجعلكِ رؤية هذا تعتقدين بأنّهم شُجعان؟

74
00:05:18,280 --> 00:05:21,370
الكثير من الفتيات يصحنَ بهجةً

75
00:05:21,370 --> 00:05:23,000
...أ-أنا

76
00:05:23,420 --> 00:05:26,840
لا أرى بأنّ القوّة في معركة
أمراً رائعاً بالضّرورة

77
00:05:27,120 --> 00:05:30,630
أليست القوّة والموثوقيّة هما أكثر
أمرين جذّابين في الرّجال؟

78
00:05:31,190 --> 00:05:33,120
بصراحة، أنا خائفة

79
00:05:33,120 --> 00:05:36,600
أشعر وكأنّ ذلك السّيف سوف
يُشهَر نحوي يوماً ما

80
00:05:36,600 --> 00:05:40,150
!ماذا من المُفترض أن يعني هذا؟
!أنتِ سلبيّة جدّاً

81
00:05:40,150 --> 00:05:42,440
أنا آسفة

82
00:05:42,750 --> 00:05:48,360
،أجيبيني يا آنسة ماري شاديران
لماذا أصبحتِ خطيبة كيروس؟

83
00:05:48,740 --> 00:05:50,440
...لـ-لأنّ

84
00:05:50,840 --> 00:05:52,630
لأنّني بديلة أختي الكبرى

85
00:05:52,630 --> 00:05:54,550
أجل، لستُ سوى مُجرّد بديلة

86
00:05:54,550 --> 00:05:56,690
!والآن سوف نبدأ بجولة البطولة

87
00:05:58,150 --> 00:06:00,330
!مُحارب الظّلام ضدّ الفارس الأخضر

88
00:06:01,120 --> 00:06:01,830
!ابدآ

89
00:06:12,370 --> 00:06:14,430
!ا-الرّابح... مُحارب الظّلام

90
00:06:16,600 --> 00:06:18,680
حسناً، كانت هزيمة فوريّة

91
00:06:18,990 --> 00:06:22,110
—تهانينا! هذا هو كأس الرّابـ

92
00:06:23,900 --> 00:06:26,610
إنّه يضع الأولويّة لسلامة خصمه أوّلاً؟

93
00:06:26,950 --> 00:06:31,730
إذا كان هو مَن يقاتل، فرُبّما حتّى أنا
أستمتع بمُشاهدة نِزالاته قليلاً

94
00:06:32,200 --> 00:06:34,190
هذه أنباء سارّة

95
00:06:35,040 --> 00:06:37,190
أ-أهلاً بعودتكِ

96
00:06:35,240 --> 00:06:39,120
غنائم الحرب

97
00:06:37,840 --> 00:06:39,530
عدتُ للتو فحسب

98
00:06:43,050 --> 00:06:44,570
هل ذكرتِ أنباء سارّة؟

99
00:06:44,570 --> 00:06:47,260
مُحارب الظّلام ذاك هو مولايّ

100
00:06:47,260 --> 00:06:48,000
ماذا؟

101
00:06:49,290 --> 00:06:50,720
تبدين مُتيقّنة جدّاً

102
00:06:51,180 --> 00:06:55,390
مهارات السّيف تلك وتفاصيل حركات قدميه
هي نفس حركات مولايّ تماماً

103
00:06:56,420 --> 00:06:59,700
كيروس-ساما... هو مُحارب الظّلام؟

104
00:07:01,350 --> 00:07:03,130
هل نتحقّق من ذلك؟

105
00:07:06,240 --> 00:07:09,700
!الكونت كيروس غرانادو، أنت جسور

106
00:07:09,700 --> 00:07:11,780
!انظر إليّ

107
00:07:13,280 --> 00:07:14,590
كيروس؟

108
00:07:14,590 --> 00:07:15,630
الكونت؟

109
00:07:15,930 --> 00:07:17,840
من شركة غرانادو؟

110
00:07:17,840 --> 00:07:18,820
حقّاً؟

111
00:07:18,820 --> 00:07:20,990
!كيروس-ساما! انظر إليّ هنا

112
00:07:20,990 --> 00:07:23,080
!اخلع خوذتك

113
00:07:34,110 --> 00:07:38,410
كلّ نبيل في مملكة ديلتز يُطلَب منه
إشهار السّيف مرّة على الأقلّ

114
00:07:38,410 --> 00:07:42,870
تدرّب مولايّ بشكل مُكثّف منذ
كان طفلاً للدّفاع عن النّفس

115
00:07:42,870 --> 00:07:44,230
حـ-حقّاً؟

116
00:07:45,040 --> 00:07:47,940
شكراً لكِ على إظهار أفضل تعابير
الوجه لأجلي في هذا اليوم

117
00:07:47,940 --> 00:07:51,360
كان الأمير لويفون يعلم منذ البداية، أليس كذلك؟

118
00:08:01,950 --> 00:08:04,260
ا-المعذرة. ما-ما سبب هذا الطّابور؟

119
00:08:04,260 --> 00:08:07,700
ماذا؟ إنّه طابور لاسترضاء الكونت بالطّبع

120
00:08:07,700 --> 00:08:08,440
ماذا؟

121
00:08:08,440 --> 00:08:12,260
.يبدو أنّ خطيبته قد تُوفّيت نتيجة حادث
!هذه فُرصة للتقرُّب منه

122
00:08:12,570 --> 00:08:19,260
بالطّبع. لن يتوقّع أحد بأن تحلّ مكانها
أختها العاجزة

123
00:08:19,500 --> 00:08:22,740
،لعلّ دماء همجيّة تجري في عروقه
لكنّه الدّوق المُقبل في نهاية المطاف

124
00:08:22,740 --> 00:08:27,260
بالفعل! ومن تصبح زوجة الدّوق ستكون
لها مكانة مرموقة في المُجتمع

125
00:08:27,490 --> 00:08:30,730
سمعتُ بأنّ شخصيّته مُعقّدة، لكنّه وسيمٌ جدّاً

126
00:08:31,840 --> 00:08:32,810
أليس كذلك؟

127
00:08:31,840 --> 00:08:33,320
همجيّة؟

128
00:08:34,020 --> 00:08:35,590
مُعقّدة؟

129
00:08:36,090 --> 00:08:38,100
عمّن يتكلّمن؟

130
00:08:39,970 --> 00:08:41,100
ماري-ساما؟

131
00:08:43,560 --> 00:08:44,640
المعذرة

132
00:08:44,640 --> 00:08:45,790
ما-ماذا؟

133
00:08:47,110 --> 00:08:48,260
!توقّفي مكانكِ

134
00:08:48,260 --> 00:08:49,970
من تكونين بالضّبط؟

135
00:08:49,970 --> 00:08:51,680
بالفعل! من تعتقدين نفسكِ؟

136
00:08:51,930 --> 00:08:56,090
!أنا خطيبـ... أنا قريبة الكونت

137
00:08:56,090 --> 00:08:57,400
ماذا؟

138
00:08:57,750 --> 00:09:00,760
!ماري-ساما، سوف أحتجزهن هنا حتّى آخر دور

139
00:09:00,760 --> 00:09:02,150
!شكراً لكِ يا ميو

140
00:09:02,150 --> 00:09:04,390
ابتعدي عن طريقي! من أنتِ؟

141
00:09:06,580 --> 00:09:09,230
ماذا كان ذلك؟ جميعهن قُلنَ كلاماً غير لائق

142
00:09:09,670 --> 00:09:12,010
...كلّ ما فعلتُه هو اكتشاف شيء أحببتُه

143
00:09:12,010 --> 00:09:15,440
وهو لطيف جدّاً لدرجة ابتسم لي بسعادة

144
00:09:15,440 --> 00:09:17,440
!لا سبب للسّخرية منه هكذا

145
00:09:18,720 --> 00:09:20,310
...حتّى لو كان يوجد سبب

146
00:09:21,510 --> 00:09:24,140
هذا لن يجلب إلّا المشاكل

147
00:09:25,740 --> 00:09:27,860
ما الّذي تُفكّر فيه؟

148
00:09:28,130 --> 00:09:30,700
لماذا طلبت منّي المُشاركة في مُنافسة
المُبارزة بالسّيف؟

149
00:09:32,030 --> 00:09:36,310
!قمتَ بعمل ممتاز! بفضلك، كان نجاحاً مُثيراً

150
00:09:36,310 --> 00:09:38,500
هذه الابتسامة مُغيظة

151
00:09:38,500 --> 00:09:40,860
هل كنتَ أنت من فضح هويّتي للجمهور؟

152
00:09:42,040 --> 00:09:44,730
!تـ-تهانينا فوز

153
00:09:48,100 --> 00:09:50,320
بدأتُ أهلوس أخيراً

154
00:09:50,320 --> 00:09:51,690
...ا-المعذرة

155
00:09:51,690 --> 00:09:54,130
هل أنتِ ماري الحقيقيّة؟! بشحمها ولحمها؟

156
00:09:54,130 --> 00:09:57,280
!الّتي تُعَدّ كمُعجزة حيّة؟

157
00:09:55,880 --> 00:09:57,280
كيروس-ساما؟

158
00:09:57,630 --> 00:09:59,710
دعيتُها أنا

159
00:09:59,710 --> 00:10:00,660
!ماذا؟

160
00:10:00,910 --> 00:10:04,400
أردتُ أن أُريها كم أنت جسور يا كيروس

161
00:10:04,400 --> 00:10:08,520
لكن يبدو أنّها لم تكن مسرورة بذلك

162
00:10:09,600 --> 00:10:12,250
ماري لا تُحبّ الوحشيّة

163
00:10:12,250 --> 00:10:14,090
أو السّلوكيّات الأرستقراطيّة أيضاً

164
00:10:14,090 --> 00:10:17,500
هذا صحيح. ولا أريد أن أفرض قِيَم
أحد آخر عليها

165
00:10:17,500 --> 00:10:19,540
أريد أن أمنح ماري الأشياء الّتي تتمنّاها فقط

166
00:10:19,840 --> 00:10:23,150
...حسناً. تبدو كشخص مخمور حقّاً

167
00:10:23,150 --> 00:10:25,520
لكنّها لا تبدو سعيدة بذلك

168
00:10:26,970 --> 00:10:31,560
إنّها تحلّ ببساطة بديلة لأختها الكبرى
في زواج سياسيّ، أليس كذلك؟

169
00:10:32,740 --> 00:10:37,310
ستُخطبان مهما كانت هويّة الرّجل
الّذي تلتقين به. أليس كذلك؟

170
00:10:38,860 --> 00:10:40,060
...أنا

171
00:10:40,510 --> 00:10:44,090
صحيح أنّه عندما أُخِذتُ أوّل مرّة
...إلى قلعة غرانادو

172
00:10:44,430 --> 00:10:46,830
لم أكن أعرف شكل كيروس-ساما حتّى

173
00:10:47,340 --> 00:10:48,420
...لكن

174
00:10:49,320 --> 00:10:53,530
،كما توقّعت، لا تلقين بالاً لكيروس
ناهيكِ عن حبّكِ له

175
00:10:53,530 --> 00:10:55,750
كُفّ عن مُهاجمتها. لِمَ أنت مُستاء هكذا؟

176
00:10:55,750 --> 00:10:59,980
عندما سمعتُ بأنّك ستخطب، غمرَتْني السّعادة

177
00:10:59,980 --> 00:11:05,890
يا صديقي العزيز العنيد الّذي رفض كلّ امرأة
نبيلة وقد وجد ربيعه أخيراً

178
00:11:06,780 --> 00:11:08,670
...لكن في النّهاية

179
00:11:09,620 --> 00:11:11,430
زواج سياسيّ؟

180
00:11:11,430 --> 00:11:14,940
ومن امرأة لا تألف ولا ترتاح
،لتقاليد الطّبقة النّبيلة

181
00:11:14,940 --> 00:11:17,390
لا ترى جدوى في جهودك يا كيروس؟

182
00:11:17,390 --> 00:11:18,580
—إنّها بيدق والديها و

183
00:11:18,890 --> 00:11:22,810
ما معنى هذا؟! هل دعيتَ ماري
إلى هنا لإهانتها فقط؟

184
00:11:22,810 --> 00:11:25,530
إطلاقاً. أنا أسخر أيضاً من حالتك
المُثيرة للشّفقة

185
00:11:25,770 --> 00:11:29,210
جبان. كنتَ لتلكمني قديماً

186
00:11:29,210 --> 00:11:30,790
!ماري هنا

187
00:11:30,790 --> 00:11:33,380
وحتّى أنا قديماً لم يُبادر في اللّكمة
!الأولى يوماً

188
00:11:33,790 --> 00:11:38,250
أنت خائف منّي فحسب. فأساساً، لم تهزمني
،يوماً في نِزال سيف

189
00:11:38,250 --> 00:11:39,460
!أيّها الجبان

190
00:11:41,120 --> 00:11:44,260
لم تلحظ أبداً بأنّني كنتُ أدعك
،تحظى بالمجد

191
00:11:44,260 --> 00:11:45,560
يا سموّك؟

192
00:11:59,460 --> 00:12:04,840
.قبل قليل، كانت الحلبة تضجّ بالهتافات
هذه المرّة، لنُلطّخها بالصّرخات

193
00:12:06,530 --> 00:12:09,820
علّم على كلامي. سأجعلك
تعتذر على إهانتك لماري

194
00:12:14,510 --> 00:12:15,830
!انتظر من فضلك

195
00:12:15,830 --> 00:12:19,720
من فضلك أصلح الأمور معه! ما قاله
!الأمير لويفون صحيح

196
00:12:19,720 --> 00:12:21,830
لا أستطيع لوم أحد على قول
بأنّني بعتُ نفسي

197
00:12:22,440 --> 00:12:26,720
أنا حمقاء وخجولة، ولطالما فعلتُ
ما يُمليه عليّ والدايّ

198
00:12:27,140 --> 00:12:29,100
...لكن الأهمّ من كلّ تلك الأمور

199
00:12:29,540 --> 00:12:33,080
ما لا أستطيع تحمّله هو سخرية النّاس منك بسببي

200
00:12:34,620 --> 00:12:38,980
أنا آسفة، أنا... أسبّب لك المتاعب باستمرار

201
00:12:41,270 --> 00:12:46,820
سخرَ منّي لأنّه يشعر بالشّفقة عليّ
بسبب حُبّي من طرف واحد

202
00:12:48,710 --> 00:12:52,950
أنا متأكّد بأنّه لا يستطيع تحمُّل رؤية مُنافسه
يصبح مُثيراً للشّفقة هكذا

203
00:12:53,530 --> 00:12:56,460
بالرّغم ممّا يبدو عليه، إنّه رجل شغوف

204
00:12:57,410 --> 00:13:02,040
لكن... مهما كانت أسبابه، هذا لا يعني
بأن يُسمَح له بإهانتكِ يا ماري

205
00:13:02,040 --> 00:13:05,530
سأواجهه بشكل مُباشر وأهزمه، وأجعله
!يسحب كلّ كلامه

206
00:13:07,140 --> 00:13:10,270
شكراً لك على الغضب لأجلي

207
00:13:10,270 --> 00:13:14,340
لكن لا عليك. سوف أستعيد
!كرامتي بنفسي

208
00:13:14,760 --> 00:13:16,780
...الأهمّ بالنّسبة للأمير لويفون

209
00:13:18,310 --> 00:13:22,160
كيروس-ساما، أريده أن يُصحّح حقيقة
أنّه نعتَك بالجبان

210
00:13:22,160 --> 00:13:23,650
أغاظني ذلك أيضاً

211
00:13:24,870 --> 00:13:29,020
عظيم إذاً. قبل أن أخوض المعركة، أريد
منح قبلة حظّ سعيد

212
00:13:29,020 --> 00:13:29,800
ماذا؟

213
00:13:30,270 --> 00:13:31,490
أمزح فحسب

214
00:13:35,410 --> 00:13:37,760
والآن، سأذهب لسحق أعزّ صديق لي

215
00:13:38,470 --> 00:13:40,030
حـ-حسناً

216
00:13:43,990 --> 00:13:45,040
...والآن

217
00:13:45,040 --> 00:13:48,300
،لدينا الرّابح في مُنافسة المُبارزة بالسّيف
الكونت كيروس غرانادو

218
00:13:48,300 --> 00:13:51,240
،وأمير مملكة ديلتز الثّالث، قائد الفُرسان

219
00:13:51,240 --> 00:13:55,180
،سموّه، لويفون ساندالكيا ديلتز
!في مُباراة ودّية خاصّة

220
00:13:55,180 --> 00:13:56,640
يمكنك فعلها يا كيروس-ساما

221
00:13:59,480 --> 00:14:02,610
لويفون، ارتدِ خوذتك. ستُصاب إصابة بليغة

222
00:14:02,610 --> 00:14:03,920
وأنت يا عزيزي كيروس

223
00:14:03,920 --> 00:14:07,910
إذا أُزيلَ أنفك النّبيل هذا، فقد
تكرهك ماري اللّطيفة أخيراً

224
00:14:07,910 --> 00:14:09,030
ارتدِ خوذتك

225
00:14:13,520 --> 00:14:14,750
...إ-إذاً

226
00:14:16,250 --> 00:14:17,280
!ابدآ

227
00:14:28,040 --> 00:14:30,720
!يبدو أنّ مهاراتك لم تتراجع

228
00:14:32,690 --> 00:14:34,030
!ولا مهاراتك

229
00:14:39,770 --> 00:14:41,940
...يبدو أنّهما مُتكافئان من حيث القوّة، لكن

230
00:14:43,130 --> 00:14:44,570
!نلتُ منك

231
00:14:50,480 --> 00:14:52,160
!كيروس-ساما، لا تدعه يهزمك

232
00:15:00,680 --> 00:15:03,320
!هذه حركة مُثيرة للاهتمام

233
00:15:04,730 --> 00:15:06,600
!ماذا؟ هل هذا مسموح؟

234
00:15:06,600 --> 00:15:07,470
قطعاً لا

235
00:15:25,240 --> 00:15:28,050
!الرّابح! الكونت كيروس غرانادو

236
00:15:28,570 --> 00:15:31,960
!فـ-فعلتها! كيروس-ساما

237
00:15:33,240 --> 00:15:34,990
...صمت

238
00:15:39,000 --> 00:15:41,690
كانت تلك المعركة مُذهلة! أعتقد
اللّكمات جيّدة أيضاً

239
00:15:41,690 --> 00:15:43,340
!كان مُذهلاً

240
00:15:44,570 --> 00:15:45,740
!ماري

241
00:15:48,430 --> 00:15:49,780
!انزلي إلى هنا

242
00:15:58,190 --> 00:16:00,740
هـ-هل أردت شيئاً منّي؟

243
00:16:04,770 --> 00:16:06,820
!هـ-هذا عالٍ جدّاً

244
00:16:06,820 --> 00:16:08,680
لا تقلقي يا ماري

245
00:16:08,680 --> 00:16:09,740
كيروس-ساما

246
00:16:12,200 --> 00:16:14,660
!سأستغلّ هذه اللّحظة للإعلان

247
00:16:15,200 --> 00:16:21,290
،أنا، كيروس غرانادو، والآنسة ماري شاديران
!ابنة البارون، مخطوبان

248
00:16:21,290 --> 00:16:22,200
ماذا؟

249
00:16:23,910 --> 00:16:28,100
معاً، الآنسة ماري وأنا سنخدم
!المملكة بأقصى جهودنا

250
00:16:28,100 --> 00:16:30,100
!أقسم باسم غراندو

251
00:16:30,360 --> 00:16:32,680
مخطوب؟ كيروس-ساما؟

252
00:16:32,680 --> 00:16:34,930
من هو البارون شاديران؟

253
00:16:37,570 --> 00:16:38,530
ماري

254
00:16:38,530 --> 00:16:40,970
الجميع يريدون رؤية وجهك

255
00:16:41,560 --> 00:16:42,940
...لـ-لكن

256
00:16:43,470 --> 00:16:47,140
الجميع يتوقّعون جمالاً مُكافئاً لكيروس-ساما

257
00:16:47,140 --> 00:16:50,650
إنّ شخصاً مثلي سوف يُحرجه فحسب

258
00:16:51,460 --> 00:16:52,660
أنا خائفة

259
00:16:58,280 --> 00:17:02,670
لا مُشكلة، أنتِ امرأة أروع بكثير ممّا تدركين

260
00:17:03,000 --> 00:17:05,990
ومهما حدث، سأبقى دوماً بجانبكِ

261
00:17:06,410 --> 00:17:07,660
!أنتِ جميلة

262
00:17:08,170 --> 00:17:11,470
...هناك كثير من الأشياء الّتي تُخيفني

263
00:17:13,250 --> 00:17:17,680
لكن إن بقيت معي هنا، فيمكنني
غالباً أن أتغلّب على المخاوف

264
00:17:17,680 --> 00:17:19,960
!أحسنت صنعاً! تهانينا

265
00:17:19,960 --> 00:17:21,560
!يا للرّوعة

266
00:17:21,560 --> 00:17:25,550
!غرانادو! غرانادو

267
00:17:36,160 --> 00:17:37,040
المعذرة

268
00:17:38,260 --> 00:17:40,300
!أنتِ تلك الفتاة ظهر اليوم

269
00:17:40,300 --> 00:17:43,720
آسف لأنّني لم أستطع إيقاف مقالب
الأمير الفظيعة

270
00:17:43,720 --> 00:17:46,330
...إطلاقاً. لا تقلق من فضلك. الأهمّ من ذلك الآن

271
00:17:46,830 --> 00:17:49,390
!هذه المرّة، أودّ أن أشارك في مُسابقة التّقشير

272
00:17:49,390 --> 00:17:51,300
!أنتِ غريبة أطوار حقّاً

273
00:17:51,570 --> 00:17:53,070
تفضّلي

274
00:17:53,070 --> 00:17:55,380
شكراً لك. لا أطيق انتظار اختبار مهارتي

275
00:17:56,500 --> 00:17:57,390
ماذا؟

276
00:17:57,830 --> 00:17:59,050
يبدو هذا مُمتعاً

277
00:17:59,050 --> 00:18:00,130
كيروس-ساما؟

278
00:18:00,130 --> 00:18:01,780
هل يمكنني تجربة هذه معكِ؟

279
00:18:01,780 --> 00:18:03,260
أ-أجل

280
00:18:10,250 --> 00:18:11,720
أنت ماهر جدّاً

281
00:18:11,720 --> 00:18:14,140
أضطرّ للتّخييم في الخارج بداعي العمل أحياناً

282
00:18:14,920 --> 00:18:16,800
كيف حال الأمير لويفون؟

283
00:18:16,800 --> 00:18:18,400
في ذروة صحّته

284
00:18:22,400 --> 00:18:24,880
هذه غلطتك يا لويفون. قشّر واحدة أيضاً

285
00:18:24,880 --> 00:18:26,380
ماذا؟ لِمَ عليّ فعل ذلك؟

286
00:18:26,670 --> 00:18:27,490
خُذ

287
00:18:28,230 --> 00:18:30,540
ماري، هل هناك خدعة ما وراء الأمر؟

288
00:18:30,540 --> 00:18:31,460
!أ-أجل

289
00:18:31,840 --> 00:18:36,110
،أوّلاً، نُوجّه السّابق للأسفل
ثمّ ندوّرها بشكل جانبيّ

290
00:18:37,240 --> 00:18:39,570
!أنتِ ماهرة في هذا حقّاً

291
00:18:40,170 --> 00:18:42,980
أجل، أنا ماهرة في تقشير الأشياء

292
00:18:42,980 --> 00:18:46,010
فأساساً، اعتمدتْ حياتي على ترك أكبر
قدر مُمكن من الأجزاء الصّالحة للأكل

293
00:18:46,010 --> 00:18:50,120
أنتِ أقوى ممّا تبدين. وأحبّ هذه
!الجزئيّة فيكِ أيضاً

294
00:18:50,120 --> 00:18:51,470
ليس تماماً

295
00:18:52,460 --> 00:18:54,600
المرأة لا تحبّك حتّى

296
00:18:54,600 --> 00:18:57,270
هل من المُمتع أن تكون مُهرّجاً ينتقل من مكان
إلى آخر دون أن يفعل شيئاً؟

297
00:18:57,270 --> 00:18:59,060
أجل، هذا مُمتع

298
00:18:59,930 --> 00:19:03,030
مُجرّد وجود ماري معي يجعل
كلّ يوم يبدو برّاقاً

299
00:19:03,440 --> 00:19:09,440
حتّى لو كانت لا تُحبّني، كلّما تذكّرتُ بأنّنا غداً
،قد نتقارب أكثر

300
00:19:10,180 --> 00:19:12,160
أستمتع كثيراً لدرجة لا أحتمل ذلك

301
00:19:13,220 --> 00:19:20,090
،قد يكون يوم زفافنا الحقيقيّ بعد سنوات
،أو عقود، في المُستقبل

302
00:19:20,370 --> 00:19:24,890
لكن أنا متأكّد بأنّني سأستمتع بإمطار
ماري بالحُبّ حتّى أموت

303
00:19:25,880 --> 00:19:27,400
كيروس-ساما

304
00:19:27,630 --> 00:19:30,870
اسمح لي بالقول بأنّ هذا لا يجعلك
جسوراً البتّة يا عزيزي كيروس

305
00:19:30,870 --> 00:19:31,970
أعلم

306
00:19:32,760 --> 00:19:35,100
...حسناً، إن كنت تقول بأنّك لا تُمانع ذلك

307
00:19:35,100 --> 00:19:37,240
فافعل ما يحلو لك إذاً

308
00:19:37,480 --> 00:19:38,870
!ا-المعذرة

309
00:19:40,310 --> 00:19:43,990
!أريد أن أعرف كافّة خصال كيروس-ساما الجيّدة

310
00:19:43,990 --> 00:19:44,920
ماذا؟

311
00:19:44,920 --> 00:19:46,210
...ولذا

312
00:19:46,820 --> 00:19:49,710
آمل أن تروي لي الكثير من القصص
!ثانية يوماً ما

313
00:19:51,220 --> 00:19:53,950
فهمتُ الآن، سموّك

314
00:19:54,410 --> 00:19:58,420
أردتَ فقط الحديث عن أفضل صِفات
!أعزّ صديق لك

315
00:19:58,420 --> 00:20:00,500
لهذا دعيتَني

316
00:20:03,790 --> 00:20:05,830
أنا آسف بشأن ذلك

317
00:20:08,200 --> 00:20:10,760
ما هذه؟ إنّها للاستعراض، أليس كذلك؟

318
00:20:11,180 --> 00:20:13,380
!كان ينبغي أن تُلاحظ عندما لمستها

319
00:20:13,380 --> 00:20:18,200
اللّعنة عليك! أنا الأمير الثّالث
!وقائد فُرساننا المشاهير

320
00:20:18,200 --> 00:20:22,190
،ذات يوم سأسحلكما معاً، كزوج وزوجة
!على إهانة الطّبقة الملكيّة

321
00:20:23,970 --> 00:20:28,430
أنا غاضب جدّاً الآن! ألا تعلمان
ماذا تعني خيانة الملك؟

322
00:20:25,480 --> 00:20:28,190
الأمير لويفون طريف، أليس كذلك؟

323
00:20:28,190 --> 00:20:30,640
أجل. لا يضجر المرء منه أبداً، صحيح؟

324
00:20:34,460 --> 00:20:39,670
ماري-ساما، أحمل رسالة لمولايّ، لذا
سوف أبقى هنا

325
00:20:39,930 --> 00:20:43,410
خادمه الخاصّ ولفغانغ سيُرافقكِ بدلاً منّي

326
00:20:43,410 --> 00:20:46,300
يسرّني أن أكون في خدمتكِ يا مولاتي

327
00:20:46,300 --> 00:20:47,290
هكذا إذاً

328
00:20:47,940 --> 00:20:50,280
شكراً لكِ على اليوم يا ماري

329
00:20:50,280 --> 00:20:55,940
لا، أنا من يشكرك يا كيروس-ساما، على السّماح لي
برؤية جانب جسور منك

330
00:20:56,150 --> 00:21:01,060
الحقيقة هي أنّني لم أهزم لويفون
في نِزال سيف من قبل

331
00:21:02,430 --> 00:21:05,230
كيروس-ساما، أنت حقّاً شخص قويّ

332
00:21:05,570 --> 00:21:08,820
هذا لأنّكِ معي يا ماري

333
00:21:09,860 --> 00:21:15,070
أيّاً كانت أُمنيتكِ، سوف أكرّس كلّ كياني
لتحقيق تلك الأُمنية

334
00:21:15,610 --> 00:21:18,070
لأنّ كلّ ما أنا عليه الآن هو بفضلكِ

335
00:21:19,120 --> 00:21:21,140
سأراكِ في القلعة يا ماري

336
00:21:21,610 --> 00:21:22,620
أجل

337
00:21:36,300 --> 00:21:37,950
!تُصبح على خير

338
00:21:39,420 --> 00:21:41,610
!أيّها الحوذيّ، انطلق الآن من فضلك

339
00:21:43,400 --> 00:21:46,650
...ماري! لحظة، قبل قليل، أنتِ

340
00:21:47,160 --> 00:21:48,360
!انتظري رجاء

341
00:21:50,540 --> 00:21:52,720
...بعد شهرين فقط من الآن

342
00:21:52,720 --> 00:21:55,860
سأتزوّج من الشّخص الّذي كانت
أختي مخطوبة له

343
00:21:56,520 --> 00:22:01,780
،إنّه زواجٌ سياسيّ، لكن ذات يوم
كزوجين يربطهما الحُبّ

344
00:22:02,180 --> 00:22:04,440
آمل أن نجد السّعادة

345
00:22:04,860 --> 00:22:06,410
نحن الاثنتان معاً

346
00:22:10,840 --> 00:22:13,930
تبدو هذه كرسالة من عائلة شاديران فعلاً

347
00:22:14,280 --> 00:22:16,930
أجل. خطّ اليد صحيح كذلك

348
00:22:17,300 --> 00:22:18,340
...ميو

349
00:22:19,430 --> 00:22:26,290
هل البارون شاديران وزوجته هما
والدا ماري الفعليّان؟

350
00:23:58,420 --> 00:24:01,620
!طبخ توبّو هو الأفضل في العالم

351
00:24:01,620 --> 00:24:03,870
!سأواصل استعراض مهاراتي ثانية اليوم

352
00:24:04,730 --> 00:24:09,040
مولاتي تعمل بجدٍّ تحضيراً لمراسم الزّفاف

353
00:24:09,490 --> 00:24:13,560
!دعي حلويّات توبّو السّامية تُسكن قلبكِ وجسدك

354
00:24:14,730 --> 00:24:15,660
...الحلقة القادمة

355
00:24:16,010 --> 00:24:18,600
"هل أنا كافٍ كما أنا؟"

356
00:24:19,340 --> 00:24:20,760
هل تريدين طبقاً ثانياً؟

357
00:24:20,760 --> 00:24:22,420
!هذا من دواعي سروري