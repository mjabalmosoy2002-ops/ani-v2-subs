1
00:00:01,810 --> 00:00:05,560
ألقيت نظرة واحدة... فصمتَ لساني

2
00:00:14,120 --> 00:00:18,660
كانت تتلألأ. كانت جميلة جدّاً
كما لو أنّها وُلِدت من جديد

3
00:00:19,840 --> 00:00:24,440
عيناها الحزينتان كانتا تلمعان كنجمة

4
00:00:29,220 --> 00:00:30,650
حسناء للغاية

5
00:00:34,720 --> 00:00:36,960
كُفّ عن الهرب من الواقع

6
00:00:37,290 --> 00:00:40,730
رفضت ماري-ساما طلبك لخطبتها يا مولايّ

7
00:00:41,040 --> 00:00:43,740
!لا... لا أستطيع فعل هذا

8
00:00:46,370 --> 00:00:49,290
لا تفرضي الواقع عليّ يا ميو

9
00:00:49,290 --> 00:00:51,840
!أنتِ قاسية دوماً، دوماً

10
00:00:51,840 --> 00:00:54,180
هذا واجبي

11
00:00:54,180 --> 00:00:58,360
رغم ذلك، من كان يتوقّع أن تخلط
بين الأختين عندما تقدّمت بطلب خطوبة

12
00:00:59,130 --> 00:01:01,380
وما أدراني أنا؟

13
00:01:02,310 --> 00:01:04,960
في تلك اللّيلة، كان عيد ميلاد ماري

14
00:01:05,380 --> 00:01:08,710
...الفتاة تجلس لوحدها في الظّلام

15
00:01:09,060 --> 00:01:12,710
من كان يتوقّع أن تكون هي نجمة الحفلة؟

16
00:02:44,090 --> 00:02:49,360
أبي، الدّوق آلفريد غرانادو، لديه زوجتان

17
00:02:49,360 --> 00:02:53,350
إذا استلقت القطّة كقمامة، فإنّها تصبح قمامة

18
00:02:53,660 --> 00:02:56,490
إذا صاحت القمامة "مياو"، فإنّها تصبح قطّة

19
00:02:56,490 --> 00:02:58,080
—ثمّ معي، تصبح

20
00:02:57,140 --> 00:02:58,540
!كفى لعِباً

21
00:03:01,600 --> 00:03:03,860
ألا تدركين مركزكِ هنا؟

22
00:03:03,860 --> 00:03:05,890
!عليك أن تعرفي حجمكِ

23
00:03:08,120 --> 00:03:13,080
،ابنة عائلة نبيلة مُكافئة لعائلة الدّوق
،الزّوجة الرّسميّة لأبي آلفريد

24
00:03:13,080 --> 00:03:14,380
السّيّدة لورا

25
00:03:19,850 --> 00:03:23,890
مُؤدّية رحّالة إيبساندريّة
،اتّخذها مَحظيّة له

26
00:03:23,890 --> 00:03:26,380
أمّي، ليو ليو

27
00:03:50,080 --> 00:03:52,120
كأنّني سمعتُ صوت ضجيج

28
00:03:52,830 --> 00:03:55,180
خُذ. كُل هذه واهدأ

29
00:04:00,160 --> 00:04:02,330
هذا من إعدادي

30
00:04:02,980 --> 00:04:05,300
وثقت بي وأكلتها، أليس كذلك؟

31
00:04:05,300 --> 00:04:08,350
!هذا لأنّها لذيذة جدّاً

32
00:04:08,350 --> 00:04:09,430
!أعجبَتْني

33
00:04:12,230 --> 00:04:15,190
حقّاً؟ ماذا تحبّ أيضاً؟

34
00:04:15,520 --> 00:04:21,080
لنرَ. كعك وكريمة منفوشة
!وبسكويت بالشّوكولاتة

35
00:04:21,080 --> 00:04:22,690
!أعشق الحلويّات

36
00:04:23,040 --> 00:04:24,980
!أُحبّ الحلويّات أيضاً

37
00:04:25,480 --> 00:04:29,580
عندما أُعدّ الحلويّات، ليس عليّ
التّفكير بأشياء سيّئة

38
00:04:36,580 --> 00:04:39,790
في المرّة المُقبلة، سأُعدّ لك بعض
البسكويت بالشّوكولاتة

39
00:04:41,480 --> 00:04:42,410
!حسناً

40
00:04:49,360 --> 00:04:51,610
،صحيح أنّ لورا زوجتي الرّسميّة

41
00:04:52,090 --> 00:04:55,340
لكن كلّ الأطفال الّذين أنجبتهم
منّي كانوا إناثاً

42
00:04:56,140 --> 00:04:58,930
...لهذا الشّخص الّذي سيرِث دوقيّتي

43
00:05:00,140 --> 00:05:02,190
سيكون كيروس

44
00:05:17,950 --> 00:05:20,020
!لا

45
00:05:26,700 --> 00:05:30,230
!افتحي عينيكِ! أُمّي

46
00:05:32,180 --> 00:05:35,160
لماذا؟ لماذا تتجرّعين سُمّاً؟

47
00:05:36,370 --> 00:05:39,010
...لماذا المرأة الّتي كانت لطيفة جدّاً معي

48
00:05:39,730 --> 00:05:42,540
اختارت الموت بمحض إرادتها؟

49
00:05:48,850 --> 00:05:51,820
بعد أن ترقّتْ ليو ليو إلى منصب
،الزّوجة الرّسميّة

50
00:05:51,820 --> 00:05:56,380
قالتْ بأنّها ليست أكثر من مُجرّد
مَحظيّة وتركت الدُّوق، لتأخذني معها

51
00:05:57,560 --> 00:06:00,870
،وأنا، من أجل البقاء في هذه البلاد

52
00:06:00,870 --> 00:06:03,740
اكتسبتُ منصبَ الكونت من خلال جهودي

53
00:06:06,890 --> 00:06:09,890
،لكن أكره اجتماعات الطّبقات الرّفيعة

54
00:06:10,640 --> 00:06:14,130
وتجنّبتُ أيّ حديث عن زواج
من بنات نُبلاء

55
00:06:23,020 --> 00:06:25,070
!مرحباً يا صديقي

56
00:06:27,760 --> 00:06:30,150
كشفت عن وجهك أخيراً إذاً

57
00:06:31,090 --> 00:06:33,620
بما أنّكم استدعيتموني، فلا أملك خياراً

58
00:06:33,620 --> 00:06:38,180
هل تلقّيت دعوة كذلك؟ دعوة
من بارون ريفيّ

59
00:06:38,180 --> 00:06:39,910
لويفون، هل تلقّيت دعوة أيضاً؟

60
00:06:40,240 --> 00:06:45,140
يبدو أنّهم أرسلوا دعوة إلى كلّ أعزب
ثريّ أو من عائلة عظيمة

61
00:06:45,660 --> 00:06:50,800
المشاكل العائليّة الماليّة الخاصّة بالبارون
شاديران معروفة بين صفوف الأرستقراطيّين

62
00:06:51,050 --> 00:06:56,480
من الواضح وضوح الشّمس أنّ حفلة عيد
الميلاد هذه هي ذريعة للتّسويق لابنته

63
00:06:56,870 --> 00:06:59,220
بصراحة. هذا بغيض

64
00:06:59,680 --> 00:07:03,560
لكن طبقاً للإشاعات، إنّها جميلة جدّاً

65
00:07:03,560 --> 00:07:06,070
لديّ خطيبة، لذا لا أستطيع الحضور

66
00:07:06,470 --> 00:07:08,330
لكن لِمَ لا تحضر يا كيروس؟

67
00:07:08,330 --> 00:07:09,580
لستُ مُهتمّاً

68
00:07:11,300 --> 00:07:13,120
الكونت غرانادو؟

69
00:07:14,070 --> 00:07:16,820
يمكنك أن تتناول من هذه إن أحببت

70
00:07:21,270 --> 00:07:22,820
أجل، شكراً لكِ

71
00:07:33,970 --> 00:07:35,940
الفتيات مُعجبات بك، أليس كذلك؟

72
00:07:35,940 --> 00:07:39,740
مُعجبات بي؟ كلّ ما يرينه هو لقبي ومالي

73
00:07:39,740 --> 00:07:42,930
في أعماقهن، هؤلاء النّسوة يكرهنَ إرثي

74
00:07:43,310 --> 00:07:48,910
حسناً، أيّ ابنة نبيل عاديّ تمقت إيبساندروس
مُعتبرة إيّاها بلداً لغير المُتمدّنين

75
00:07:49,400 --> 00:07:51,140
إنّه غاية في الرّوعة

76
00:07:51,140 --> 00:07:52,880
...لكن لون بشرته

77
00:07:52,880 --> 00:07:54,170
ورثَ ذلك عن أمّه

78
00:07:57,950 --> 00:07:59,840
،أتفهّم شعورك

79
00:07:59,840 --> 00:08:03,060
لكن لا تملك خيار البقاء أعزب
مدى الحياة، أليس كذلك؟

80
00:08:03,710 --> 00:08:07,930
أنت كون والابن الوحيد لعائلة دوقيّة

81
00:08:07,930 --> 00:08:11,410
إذا بقيت أعزب، فلن يحمل أحدٌ نسل الدّوق

82
00:08:11,410 --> 00:08:12,790
أعلم

83
00:08:16,560 --> 00:08:20,160
مَن هي الفتاة الّتي ستكسب قلبك؟

84
00:08:20,160 --> 00:08:22,420
أنا مُتلهّف لمعرفة ذلك

85
00:08:23,600 --> 00:08:25,910
مُحال أن يأتي يوم كهذا

86
00:08:32,140 --> 00:08:34,380
لا، معه حقّ

87
00:08:34,920 --> 00:08:38,830
ابنة بارون فقير قد تكون مُلائمة

88
00:08:40,030 --> 00:08:43,060
،وإذا كان زواج مصلحة فقط

89
00:08:43,060 --> 00:08:44,820
فسيكون الأفضل فتاة من السّهل السّيطرة عليها

90
00:08:50,900 --> 00:08:51,970
...الحُبّ

91
00:08:53,420 --> 00:08:55,220
هذا شيء لستُ بحاجة للشّعور به أبداً

92
00:09:01,550 --> 00:09:04,080
على الأقلّ، هذا ما ظننتُه

93
00:09:04,830 --> 00:09:09,340
شخصيّاً، أحبّ القصص من إيبساندروس

94
00:09:10,130 --> 00:09:12,600
ومع ذلك، وقعتُ في حُبّها

95
00:09:13,090 --> 00:09:18,120
أردتُ التكلّم معها أكثر، لكنّها
أفلتت من بين أصابعي

96
00:09:25,880 --> 00:09:27,810
—بالمناسبة، كنتُ أتساءل إذا كان هذا العام

97
00:09:27,810 --> 00:09:30,150
المعذرة، هل أنت البارون شاديران؟

98
00:09:30,150 --> 00:09:31,630
أين ابنتك؟

99
00:09:31,630 --> 00:09:34,540
،إن كنتَ تبحث عن نجمة اللّيلة
!فهي هناك

100
00:09:34,540 --> 00:09:38,370
!من فضلك! اتّخذ ابنتنا عروسة لك

101
00:09:38,370 --> 00:09:40,970
!عزيزي! أسرفتَ في الشّرب

102
00:09:40,970 --> 00:09:42,090
!لا، لم أفعل

103
00:09:41,550 --> 00:09:43,490
قيل لي بأنّ عائلة شاديران

104
00:09:43,490 --> 00:09:46,620
لديها ابنة كُبرى تُدعى أناستاشيا
وصُغرى تُدعى ماري

105
00:09:47,310 --> 00:09:49,240
نجمة اللّيلة"؟"

106
00:09:49,240 --> 00:09:51,820
إذا كانت ماري، الأخت الصُّغرى
،هي صاحبة عيد الميلاد

107
00:09:52,240 --> 00:09:54,820
فالفتاة الّتي التقيتُها هي الأخت
!الكُبرى، أناستاشيا

108
00:09:57,450 --> 00:09:59,790
بحثتُ عنها في كلّ مكان

109
00:10:09,190 --> 00:10:12,420
...لكن بحثتُ جاهداً

110
00:10:15,620 --> 00:10:18,730
ولم أستطع إيجادها

111
00:10:21,130 --> 00:10:23,590
قرّرتُ إرسال رسالة

112
00:10:23,590 --> 00:10:25,350
،لم أُرِد الأخت الصّغرى ماري

113
00:10:25,350 --> 00:10:28,170
إنّما الأخت الكُبرى أناستاشيا كزوجة لي

114
00:10:28,930 --> 00:10:31,390
!مُمتاز! وصلَ ردّ

115
00:10:31,850 --> 00:10:34,070
بعد ذلك، أصبحتُ مشغولاً جدّاً

116
00:10:34,070 --> 00:10:36,490
من أجل توفير أعظم ضيافة
،لخطيبتي العزيزة

117
00:10:36,490 --> 00:10:39,850
جهّزتُ فساتينَ ومجوهرات وخدماً جدُد

118
00:10:39,860 --> 00:10:45,120
أناستاشيا

119
00:10:40,610 --> 00:10:44,750
وحتّى أنّني حصلتُ على وسادة جسد
لأتحمّل لياليّي الخالية من النّوم

120
00:10:51,200 --> 00:10:52,370
...لكن

121
00:11:06,470 --> 00:11:09,290
العربة... سقطت؟

122
00:11:14,270 --> 00:11:17,070
...ثمّ وسط انفطار قلبي ويأسي

123
00:11:18,430 --> 00:11:21,830
وصلت المرة الّتي ظننتُها تحمل
اسم أناستاشيا

124
00:11:22,380 --> 00:11:24,120
ماري شاديران

125
00:11:25,900 --> 00:11:29,250
بصراحة يا مولايّ، أنت أحمق

126
00:11:29,250 --> 00:11:31,200
رغم أنّني أفتقر للمعرفة بحدّ ذاتي كذلك

127
00:11:34,260 --> 00:11:36,450
والآن... تمّ رفضي؟

128
00:11:36,930 --> 00:11:40,730
إنّ قبول الحقيقة كحقيقة هو أمر رائع بصراحة

129
00:11:40,730 --> 00:11:44,720
ميو، ألا يمكنكِ أن تخفّفي وطأة
كلامكِ المُباشر هذا؟

130
00:11:44,720 --> 00:11:47,830
حسناً إذاً يا مولاي، هل يمكنك شرح هذا؟

131
00:11:47,830 --> 00:11:50,570
،عندما رأيتَ شكل ماري-ساما الجديد
استدرتَ بصمت

132
00:11:51,340 --> 00:11:56,220
وأيضاً قول "اطرد ماري شاديران" لم يكُن مُحبّباً

133
00:11:56,490 --> 00:12:01,970
مولايّ، أنا متأكّدة بأنّ ماري-ساما
تعتقد بأنّك تكرهها

134
00:12:01,970 --> 00:12:06,590
إذا وضّحتُ سوء الفهم هذا، هل تعتقدين
بأنّها ستصبح زوجتي طوعاً؟

135
00:12:06,590 --> 00:12:07,830
لا أعلم

136
00:12:09,250 --> 00:12:11,300
لكن كلّ ما يمكنك فعله هو
بذل قصارى جهدك

137
00:12:11,710 --> 00:12:15,080
فأساساً يا مولايّ، أنت الشّخص الّذي
يشعر بحُبّ من طرف واحد هنا

138
00:12:15,380 --> 00:12:17,400
أجل، معكِ حقّ

139
00:12:18,880 --> 00:12:20,540
لنذهب ونرَ ماري

140
00:12:22,120 --> 00:12:23,470
...ما أريد رؤيته

141
00:12:24,490 --> 00:12:26,160
!هو ابتسامتها

142
00:12:30,600 --> 00:12:32,860
ملابس رثّة ومُهترئة

143
00:12:33,260 --> 00:12:35,600
وكتابي المُفضّل الّذي قرأتُه كثيراً

144
00:12:36,280 --> 00:12:41,560
...هذا كلّ ما منحني إيّاه هذا العالم ومع ذلك

145
00:12:45,660 --> 00:12:48,400
من هذه؟

146
00:12:50,040 --> 00:12:51,950
نعم؟ تفضّل

147
00:12:54,590 --> 00:12:57,120
ميو... وكيروس-ساما؟

148
00:12:58,040 --> 00:13:01,290
أ-أنا آسفة للوقاحة الّتي بدرتْ
!منّي قبل قليل

149
00:13:02,550 --> 00:13:05,250
وقاحة؟ عمّاذا تتكلّمين؟

150
00:13:05,250 --> 00:13:08,800
كان كلّ ذلك مُفاجئاً لدرجة فقدتُ
فيها هدوئي. أنا آسفة حقّاً

151
00:13:08,800 --> 00:13:11,720
لا. أنا من ينبغي أن يعتذر

152
00:13:25,040 --> 00:13:29,400
يـ-يبدو أنّ هناك سوء فهم كبير بيننا

153
00:13:30,410 --> 00:13:33,920
فقبل كلّ شيء، لا أكرهكِ يا ماري

154
00:13:34,390 --> 00:13:39,180
ثانياً، كنتُ قد ظننتُ بأنّكِ ستأتين
إلى هذا القصر بمحض إرادتكِ

155
00:13:39,920 --> 00:13:42,080
أنا آسف لافتراضي هذا

156
00:13:42,500 --> 00:13:45,590
أريد حقّاً أن أُرحّب بكِ زوجةً لي

157
00:13:45,590 --> 00:13:48,050
أجل. شكراً لك على استضافتي

158
00:13:48,050 --> 00:13:49,720
ماذا؟

159
00:13:51,000 --> 00:13:56,210
،عـ-عندما قلتُ بأنّني لا أستطيع أن أكون خطيبتك
كان ذلك فقط لأنّني أُصِبتُ بصدمة

160
00:13:56,210 --> 00:13:57,930
حـ-حقّاً؟

161
00:13:58,240 --> 00:14:01,600
أجل. لا أنوي رفضك

162
00:14:01,600 --> 00:14:05,740
لديّ صورة عامّة حول مركزك يا مولايّ

163
00:14:06,270 --> 00:14:11,250
لخِلافة لقب الدّوق، يجب عليك
الزّواج من ابنة عائلة نبيلة

164
00:14:11,250 --> 00:14:14,250
غير أنّ إيجاد عروس كان صعباً

165
00:14:14,250 --> 00:14:16,640
...ما تقولينه صحيح، لكن

166
00:14:16,640 --> 00:14:21,750
إن لم يكن كذلك، فإنّ شخصاً بمكانتك يا سيّدي
مُحال أن يحضر حفلة بارون فقير

167
00:14:22,330 --> 00:14:27,500
،هناك، كشريكة مُحتمَلة لك في زواج مصلحة
وقعت في حُبّ أختي

168
00:14:27,970 --> 00:14:31,060
أناستاشيا الحسناء

169
00:14:35,800 --> 00:14:37,610
!مـ-ما كان ينبغي أن أقول ذلك

170
00:14:37,610 --> 00:14:39,080
أنا آسفة حقّاً

171
00:14:39,080 --> 00:14:42,490
كنتيجة لتلك الحادثة المُفاجئة، أنا، الأخت
،الصُّغرى عديمة الفائدة، جاءت إليك

172
00:14:42,490 --> 00:14:44,540
لكن أطمئنك، أدرك مكانتي

173
00:14:45,040 --> 00:14:49,820
فخامتك، عاملني من فضلك
بأيّ طريقة تراها مُناسبة

174
00:14:49,820 --> 00:14:52,180
!انتظري! انتظري من فضلكِ

175
00:14:52,180 --> 00:14:55,740
لا أنكر بأنّني كنتُ أضع في الحسبان زواجاً
سياسيّاً عندما حضرتُ تلك الحفلة

176
00:14:56,060 --> 00:14:59,020
!لكن في تلك اللّيلة، تغيّرت مشاعري

177
00:14:59,020 --> 00:15:01,920
.لم تكن تلك الرّسالة مُجرّد غطاء
!قصدتُ كلّ كلمة كتبتُها

178
00:15:02,350 --> 00:15:07,620
أجل، أعلم. مشاعرك تجاه أناستاشيا
قد نُقِلَتْ بشكل واضح تماماً

179
00:15:07,620 --> 00:15:09,790
!لا! هنا تكمن غلطتكِ

180
00:15:10,720 --> 00:15:12,440
لا أفهم شيئاً ممّا تقول

181
00:15:17,360 --> 00:15:20,800
كلاكما، حان وقت العشاء

182
00:15:20,800 --> 00:15:23,430
أعتقد أنّه سيكون من الأفضل استكمال
حديثكما أثناء الأكل

183
00:15:23,360 --> 00:15:25,190
هدير

184
00:15:26,830 --> 00:15:30,890
أجل، معكِ حقّ. أنا جائع جدّاً
لدرجة أشعر وكأنّني سأموت

185
00:15:39,110 --> 00:15:41,010
!كلّ شيء شهيّ

186
00:15:41,010 --> 00:15:43,040
!هذا أفضل من طعامنا بلا مُقارنة

187
00:15:46,000 --> 00:15:47,040
ماري

188
00:15:47,470 --> 00:15:49,820
لن يكون هذا زواج مصلحة

189
00:15:50,540 --> 00:15:53,470
...رسالة الخطوبة الّتي أرسلتُها إلى أناستاشيا

190
00:15:53,470 --> 00:15:58,010
،دوّنتُ اسمها ببساطة مُعتقداً بأنّها أنتِ
الفتاة الّتي التقيتُها في الحديقة تلك اللّيلة

191
00:15:58,490 --> 00:16:01,420
الفتاة الّتي أريد الزّواج منها هي أنتِ يا ماري

192
00:16:03,140 --> 00:16:04,480
هذا شرف لي

193
00:16:04,480 --> 00:16:06,060
لا تُصدّقينني، أليس كذلك؟

194
00:16:06,490 --> 00:16:09,300
كيروس-ساما، أنت شخص لطيف

195
00:16:09,300 --> 00:16:11,650
لا حاجة لتكون حريصاً على مشاعري

196
00:16:11,650 --> 00:16:14,280
عرفتُ أنّكِ لم تُصدّقيني

197
00:16:15,290 --> 00:16:18,970
بالنّسبة لأيّ شخص وُلِد في كنف
عائلة نبيلة، الزّواج واجب

198
00:16:18,970 --> 00:16:21,150
نفس الأمر ينطبق على كيروس-ساما

199
00:16:21,150 --> 00:16:24,170
لا، مسؤوليّاته ومسؤوليّاتي لا يمكن
المُقارنة بينهما

200
00:16:25,020 --> 00:16:27,740
أنا متأكّدة بأنّه سيتّخذ مَحظيّة

201
00:16:27,740 --> 00:16:30,910
قد ينتهي المطاف بارتدائي ثياباً
رثّة والعمل مُجدّداً

202
00:16:34,280 --> 00:16:36,060
لكن لا أُمانع

203
00:16:36,060 --> 00:16:38,620
ففي نهاية المطاف، لن يختلف الأمر
عمّا كنتُ أعيشه حتّى الآن

204
00:16:39,660 --> 00:16:41,980
المعذرة، هل من شيء آخر؟

205
00:16:45,480 --> 00:16:47,830
أُحبّكِ يا ماري

206
00:16:51,120 --> 00:16:52,620
!حُبّ؟

207
00:16:52,620 --> 00:16:55,280
من يقع في الحُبّ؟ مع من؟

208
00:16:56,170 --> 00:16:58,880
!لم أعد أفهم شيئاً

209
00:17:05,560 --> 00:17:08,540
على أيّ حال، نحن مُوافقان على خطوبتنا

210
00:17:09,090 --> 00:17:11,150
ستُقام مراسم الخطوبة بعد ثلاثة أشهر

211
00:17:11,150 --> 00:17:13,020
سأُرتّب لكلّ شيء

212
00:17:13,020 --> 00:17:14,990
ليس عليكِ القلق بشأن شيء

213
00:17:14,990 --> 00:17:17,050
حسناً. عُلِم

214
00:17:17,330 --> 00:17:20,230
آمل أن تستمتعي بحياتكِ هنا
في هذه الأثناء

215
00:17:20,230 --> 00:17:21,800
!ا-المعذرة

216
00:17:21,800 --> 00:17:24,310
لمرّة واحدة فقط، أرغب في العودة إلى الدّيار

217
00:17:24,310 --> 00:17:26,390
إلى عائلة شاديران؟ لماذا؟

218
00:17:26,390 --> 00:17:30,150
لم يتوقّع أبي أن تتحقّق خطوبتنا

219
00:17:31,100 --> 00:17:33,670
كان عليّ أن أخدمك وأُلبّي طلباتك لليلة واحدة

220
00:17:33,670 --> 00:17:37,290
بعد تشكيل رابط معك، كنتُ سأُطرَد
وأعود إليه. كان مُلحّاً

221
00:17:38,290 --> 00:17:39,920
!ماذا؟

222
00:17:39,920 --> 00:17:44,910
،لـ-لم أتوقّع هذا التبدُّل في الأحداث أيضاً
لذا يجب عليّ العودة إلى المنزل لتلقّي التّعليمات

223
00:17:47,410 --> 00:17:48,240
ميو

224
00:17:48,240 --> 00:17:48,890
حاضرة

225
00:17:48,890 --> 00:17:51,380
ماري-ساما، انتظري قليلاً لو سمحتِ

226
00:17:56,630 --> 00:18:00,050
هـ-هل تصرّفتُ بقلّة احترام معهما؟

227
00:18:00,050 --> 00:18:02,560
لا، كلّ ما كنتُ أفعله هو قلّة احترام

228
00:18:07,140 --> 00:18:09,350
يؤسفني القول يا ماري-ساما

229
00:18:09,770 --> 00:18:13,110
بأنّكِ ممنوعة من العودة إلى منزل والديكِ

230
00:18:13,440 --> 00:18:14,910
لـ-لماذا؟

231
00:18:14,910 --> 00:18:17,080
هذه أوامر مولايّ

232
00:18:17,080 --> 00:18:19,830
،إذا أتى السيّد أو السيّدة شاديران للزّيارة

233
00:18:19,830 --> 00:18:23,340
فإنّنا نطلب منكِ الحصول على إذن
قبل اللّقاء بهما

234
00:18:27,750 --> 00:18:31,500
ماري-ساما، هل يمكنني سؤالكِ؟

235
00:18:32,460 --> 00:18:37,000
لماذا لديكِ انطباع بأنّكِ قبيحة؟

236
00:18:38,610 --> 00:18:42,010
...لـ-لأنّ أُمّي وأبي

237
00:18:42,700 --> 00:18:45,600
شعري مليء بكُرات الزّغب، ولديّ نمش

238
00:18:45,600 --> 00:18:48,270
كانت دائماً ما تعكس ذاتي الرّثّة
والمُهترئة في المرآة

239
00:18:55,960 --> 00:18:58,060
،إن سمحتِ لي بالقول يا ماري-ساما

240
00:18:58,500 --> 00:19:01,980
من بين تلك الأشياء الّتي ذكرِتِها، الشّيء
الوحيد الموجود هنا هو المرآة

241
00:19:01,980 --> 00:19:04,290
من فضلكِ، انظري إليها قدر ما تشائين

242
00:19:07,240 --> 00:19:09,230
أَنظر إلى المرآة؟

243
00:19:09,740 --> 00:19:12,700
وماذا سيحدث إذا فعلت؟

244
00:19:18,110 --> 00:19:22,520
في نهاية المطاف، ذاتي الحقيقيّة ليست
هذا الشّخص الّذي لم أره من قبل

245
00:19:28,420 --> 00:19:30,650
لا يبدو هذا حقيقيّاً إطلاقاً

246
00:19:33,280 --> 00:19:34,950
!ما-ما هذا؟

247
00:19:36,400 --> 00:19:38,440
!إنّه منفوش جدّاً ودافئ

248
00:19:40,210 --> 00:19:42,860
وكأنّه عالم في حكاية خرافيّة

249
00:19:44,610 --> 00:19:46,840
قصر ذو أسوار بيضاء مُبهر

250
00:19:46,840 --> 00:19:49,140
ملابس جميلة وبرّاقة

251
00:19:49,140 --> 00:19:51,210
وخادمات مُدهشات

252
00:19:51,210 --> 00:19:55,280
و... كونت بعينين خضراوتين جميلتين

253
00:19:56,390 --> 00:19:57,960
...إنّه حقّاً

254
00:19:58,380 --> 00:19:59,910
أشبه بحلم

255
00:20:08,430 --> 00:20:09,800
هذا صحيح

256
00:20:10,560 --> 00:20:13,430
،أنا متأكّدة بأنّني عندما أستيقظ
،ستُبطَل التّعويذة

257
00:20:13,430 --> 00:20:15,730
وكلّ ما سيبقى هو أنا بملابسي الرّثّة

258
00:20:18,470 --> 00:20:20,400
أحبّكِ يا ماري

259
00:20:24,890 --> 00:20:29,260
أنا مُحرَجة للغاية! رؤية حلم
...كهذا هو مُجرّد

260
00:20:32,670 --> 00:20:36,780
لكن إذا كان حلماً، فلا أريد الاستيقاظ بعد

261
00:20:37,730 --> 00:20:38,750
...في نهاية المطاف

262
00:20:39,640 --> 00:20:43,720
إذا كان هذا حلماً، فلا ضير
أن أشعر بسعادة

263
00:21:00,370 --> 00:21:04,140
رأيتُ حلماً غريباً كهذا في اللّيلة الماضية

264
00:21:04,140 --> 00:21:09,330
،والآن عليّ إشعال النّار في الموقد
...وإيقاظ الجميع في العائلة، و

265
00:21:09,330 --> 00:21:10,200
لحظة

266
00:21:16,520 --> 00:21:20,180
ما زلتُ أحلم، أليس كذلك؟

267
00:21:20,180 --> 00:21:22,720
في هذه الحالة، لا ضير من أن
أستمتع بهذا فترة أطول

268
00:21:26,040 --> 00:21:27,150
ماري-ساما؟

269
00:21:27,150 --> 00:21:28,640
هل استيقظتِ؟

270
00:21:29,310 --> 00:21:31,100
!أ-أجل، أنا مُستيقظة

271
00:21:31,670 --> 00:21:33,200
أعتذر لو أزعجتُكِ

272
00:21:38,110 --> 00:21:40,120
صباح الخير يا ماري-ساما

273
00:21:40,120 --> 00:21:41,350
...صـ-صـ

274
00:21:41,710 --> 00:21:43,090
!صباح الخير

275
00:21:43,090 --> 00:21:45,350
ماذا تفعلين يا ماري-ساما؟

276
00:21:46,020 --> 00:21:50,950
كـ-كنتِ لطيفة بما يكفي للانحناء لي
بأدب حتّى ترتّب عليّ الانحناء أكثر

277
00:21:52,240 --> 00:21:55,450
لماذا؟ من فضلكِ خذي راحتكِ هنا

278
00:21:58,330 --> 00:22:01,550
المعذرة، من هاتان الآنستان؟

279
00:22:02,000 --> 00:22:05,930
ماري-ساما، أصبحتِ رسميّاً خطيبة مولايّ

280
00:22:05,930 --> 00:22:10,440
من الآن فصاعداً، سنُلبّي نحن
الثّلاثة احتياجاتكِ اليوميّة

281
00:22:10,440 --> 00:22:11,550
اسمحي لي أن أُعرّفكِ

282
00:22:15,130 --> 00:22:16,850
هذه هانّا وإيلزا

283
00:22:18,000 --> 00:22:20,130
اسمي إيلزا

284
00:22:20,130 --> 00:22:21,980
اسمي هانّا

285
00:23:59,340 --> 00:24:01,180
ماري

286
00:24:01,670 --> 00:24:04,440
لماذا لا تُصدّقين مشاعري تجاهكِ؟

287
00:24:05,130 --> 00:24:09,260
صحيح، هذه غلطتي للخلط بين اسمكِ
...واسم أختكِ، لكن

288
00:24:10,170 --> 00:24:12,640
!إن كان هناك ما ينقصك، فسأمنحكِ إيّاه

289
00:24:13,240 --> 00:24:16,900
لذا أرجوكِ... افتحي قلبكِ لي، ولو قليلاً

290
00:24:17,600 --> 00:24:22,020
،الحلقة القادمة، "حياة رأيتُها في حلم
"وحياة أشبه بحلم

291
00:24:22,650 --> 00:24:24,020
من فضلك، تعالي وشاهدي