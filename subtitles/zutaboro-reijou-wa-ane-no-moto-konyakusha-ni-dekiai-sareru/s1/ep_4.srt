1
00:00:07,270 --> 00:00:11,680
،أنا بديلة عن أختي الكبرى، أناستاشيا
الّتي تُوفّيت

2
00:00:13,830 --> 00:00:16,690
...أتيتُ إلى هنا لأهداف زواج سياسي

3
00:00:17,290 --> 00:00:19,550
...كخطيبة صوريّة، ومع ذلك

4
00:00:21,010 --> 00:00:23,410
حدّثيني عن نفسكِ من فضلكِ

5
00:00:27,380 --> 00:00:30,380
أشياء... أحبّها

6
00:02:01,720 --> 00:02:02,850
ماري
هي
الحياة

7
00:02:03,550 --> 00:02:06,220
...ماري

8
00:02:06,590 --> 00:02:07,510
مولايّ

9
00:02:09,380 --> 00:02:11,630
!ميو، إن كنتِ هنا، فقولي شيئاً

10
00:02:11,630 --> 00:02:12,820
فعلتُ ذلك للتو

11
00:02:13,340 --> 00:02:17,060
،رؤية ماري بعد فراق أربعة أيّام
ما رأيك؟

12
00:02:17,340 --> 00:02:18,050
!أحبّها

13
00:02:18,050 --> 00:02:18,830
ليس هذا ما قصدت

14
00:02:19,170 --> 00:02:21,120
!ازدادت جمالاً حتّى

15
00:02:23,870 --> 00:02:25,220
،قبل خمسة أيّام

16
00:02:25,220 --> 00:02:30,530
قلتَ بأنّك ستُوفّر أحسن ضيافة
لماري-ساما، وكلّ ما تستحقّه فعليّاً

17
00:02:30,530 --> 00:02:32,090
قلتَ ذلك، صحيح؟

18
00:02:32,090 --> 00:02:33,090
أجل

19
00:02:33,360 --> 00:02:37,530
من الواضح أنّ مُعاملتها في عائلة
البارون كانت سيّئة للغاية

20
00:02:37,530 --> 00:02:42,340
تعتقد ماري نفسها قبيحة وغير جديرة بالحُبّ

21
00:02:43,010 --> 00:02:47,870
لذا أريد أن أمنحها كلّ رفاهيّة ترغبها
وذلك كي تتمكّن من كسب بعض الثّقة

22
00:02:47,870 --> 00:02:50,610
أريدها أن تعلم بأنّها جديرة بذلك

23
00:02:50,930 --> 00:02:53,670
،مهما كدّستَ من رفاهيّة أمامها

24
00:02:53,670 --> 00:02:55,700
ماري-ساما سوف تتجنّبها على الأغلب

25
00:02:55,700 --> 00:02:56,620
ماذا؟

26
00:02:57,620 --> 00:02:58,820
مولايّ

27
00:02:59,270 --> 00:03:03,930
أنا طفلة مهجورة، لكن كنتُ محظوظة بما يكفي
لتتبنّاني ليو ليو-ساما

28
00:03:04,660 --> 00:03:08,010
تمّت ترقيتي إلى منصب رئيسة
،حاجبي قلعة غرانادو

29
00:03:08,010 --> 00:03:11,930
منصب أعلى ممّا أستحقّ، بواسطتك، يا مولايّ

30
00:03:11,930 --> 00:03:14,420
لأجل ذلك، أشعر بأنّني مَدينة
أكثر من أيّ شخص آخر

31
00:03:14,680 --> 00:03:17,300
ما كلّ هذا؟ هذا ليس طبعكِ

32
00:03:18,120 --> 00:03:23,060
بسبب هذا أستطيع أن أفهم قليلاً
من مشاعر ماري-ساما

33
00:03:23,800 --> 00:03:28,510
أن أفهم معنى الانتقال من حياة الاضطهاد
...إلى حياة مُقيمة في قلعة فاخرة

34
00:03:28,510 --> 00:03:29,960
والخوف الّذي يخلقه ذلك

35
00:03:30,450 --> 00:03:33,070
...الظّهور المفاجئ لأمير ساحر

36
00:03:33,070 --> 00:03:35,380
...كافّة الفساتين والأحذية، الممنوحة لها

37
00:03:35,380 --> 00:03:39,880
،إنّها تتساءل ما إذا كان هذا سحراً زائلاً
سوف يختفي يوماً ما فجأة

38
00:03:41,070 --> 00:03:43,020
لن يختفي

39
00:03:43,900 --> 00:03:46,750
ماري جميلة وذكيّة

40
00:03:46,750 --> 00:03:49,440
ميو، أنتِ رئيسة حاجبين مُتألّقة

41
00:03:49,440 --> 00:03:53,150
وليو ليو تعتبركِ ابنتها

42
00:03:55,080 --> 00:03:58,590
هذا ليس سحراً، إنّه حقيقة

43
00:04:00,460 --> 00:04:02,620
أجل، معك حقّ

44
00:04:02,620 --> 00:04:04,820
مولايّ، أنت بالضّبط كما ينبغي أن تكون

45
00:04:04,820 --> 00:04:09,860
من فضلك استمرّ، بتلك الطريقة العاديّة، لأصدّق
بأنّ هذه الأشياء العاديّة هي الحقيقة

46
00:04:10,360 --> 00:04:12,450
هل تتهكّمين؟

47
00:04:12,450 --> 00:04:15,400
إطلاقاً. أنا أمدحك من أعماق قلبي

48
00:04:18,940 --> 00:04:22,440
غداً، سأضطرّ لمُغادرة القلعة بمهمّة عمل ثانية

49
00:04:22,440 --> 00:04:27,400
أريدكِ أن تستخدمي صلاحيّاتكِ لضمان
راحة ماري هنا

50
00:04:27,400 --> 00:04:30,520
هل يمكنني مُراجعة المشاكل
الّتي تخصّ الموظّفين أيضاً؟

51
00:04:30,520 --> 00:04:31,530
أأتمنكِ على كلّ شيء

52
00:04:32,010 --> 00:04:34,640
هذه هي الكلمات الّتي انتظرتُها

53
00:04:34,640 --> 00:04:35,890
...رغم ذلك

54
00:04:36,960 --> 00:04:40,250
هل من المُناسب أن تكون ماري
بهذه الظّرافة؟

55
00:04:40,640 --> 00:04:41,640
ماذا؟

56
00:04:41,640 --> 00:04:45,920
إنّها أنيقة جدّاً بالثّياب الرّسميّ، لكنّها كانت
رائعة حتّى بملابسها المنزليّة أيضاً

57
00:04:45,920 --> 00:04:47,930
هل سيستغرق هذا وقتاً طويلاً؟

58
00:04:47,930 --> 00:04:50,750
إنّها ذكيّة ومُثقّفة، لكنّها لا تعرف
!الكثير عن العالم

59
00:04:50,750 --> 00:04:52,010
!إنّها تُثير غرائزي الوقائيّة

60
00:04:52,010 --> 00:04:54,250
!إنّها مُستمعة جيّدة، لذا التّحادث معها مُمتع

61
00:04:54,250 --> 00:04:56,280
!إنّها مليئة بالفضول، ممّا يجعل عينيها تلمعان

62
00:04:56,280 --> 00:04:58,850
!وجهها الباسم وضحكتها لديهما تأثير هائل

63
00:04:58,850 --> 00:05:01,600
الخطوط الطبيعيّة في جسدها تعني
!أنّ كلّ شيء يليق بها

64
00:04:59,600 --> 00:05:00,900
أنت تتكلّم بسرعة فائقة

65
00:05:01,600 --> 00:05:03,960
!نتكلّم عن ذلك المظهر وبتلك الشّخصيّة

66
00:05:03,960 --> 00:05:06,300
!ذلك التّضافُر يُعزّز ظرافتها مئة ضعف

67
00:05:06,300 --> 00:05:08,990
مولايّ، لا أعتقد بأنّك في موقف
يسمح لك بالتحدُّث عن الآخرين

68
00:05:08,990 --> 00:05:09,710
ماذا؟

69
00:05:11,210 --> 00:05:13,290
اخلد إلى النّوم الآن من فضلك

70
00:05:13,290 --> 00:05:15,290
إن لم تفعل، فسيُؤثّر ذلك عليك سلباً غداً

71
00:05:13,290 --> 00:05:19,160
ماري هي الحياة

72
00:05:17,130 --> 00:05:18,620
لا أستطيع النّوم

73
00:05:20,130 --> 00:05:24,050
حسناً إذاً، تلقّيتُ إذناً بإعادة توجيه الموظّفين

74
00:05:24,590 --> 00:05:26,980
ينبغي أن أتّخذ خطوات في أسرع وقت ممكن

75
00:05:34,770 --> 00:05:36,290
هل هذه كمّية مُلائمة؟

76
00:05:36,290 --> 00:05:38,960
أجل! سوف أتمكّن من إكمالها كلّها

77
00:05:42,500 --> 00:05:43,900
!كان ذلك شهيّاً

78
00:05:45,440 --> 00:05:47,440
اسمحي لي بالانضمام لكِ رجاء

79
00:05:47,440 --> 00:05:49,440
ماذا؟ لا تُمانعين؟

80
00:05:49,440 --> 00:05:52,300
،أثناء طعامكِ، من واجبي أن أخدمكِ

81
00:05:52,300 --> 00:05:54,290
لكن يمكنني اصطحابكِ لاحتساء الشّاي

82
00:05:54,560 --> 00:05:55,810
!أنا سعيدة للغاية

83
00:05:55,810 --> 00:05:58,980
ميو، كنتُ أرغب في احتساء الشّاي
!معكِ لفترة طويلة

84
00:06:00,210 --> 00:06:05,000
ميو، بما أنّكِ هنا، فهل هذا يعني بأنّ
كيروس-ساما قد غادر بالفعل؟

85
00:06:07,500 --> 00:06:10,070
لا، لقد تبادلنا المهام

86
00:06:10,070 --> 00:06:13,350
إيلزا وهانّا تخدمان مولايّ

87
00:06:13,350 --> 00:06:15,930
ارتأيتُ أنّ هذا أفضل للجميع

88
00:06:16,420 --> 00:06:18,360
...هكذا إذاً

89
00:06:18,900 --> 00:06:25,040
معها حقّ. أنا متأكّدة بأنّها ستكونان أسعد
إذا تمكّنتا من خدمة نبيل حقيقيّ

90
00:06:26,200 --> 00:06:26,950
!تفضّل

91
00:06:27,450 --> 00:06:30,720
!مولاتي! أنا، توبّو، أحضرتُ أحدث تجاربي الشّهيّة

92
00:06:30,720 --> 00:06:31,800
هل تريدين بعضاً؟

93
00:06:31,800 --> 00:06:32,670
!أجل

94
00:06:35,890 --> 00:06:37,570
بودينغ... أبيض؟

95
00:06:37,800 --> 00:06:42,390
إنّها مُهلّبيّة صُنِعت من طحين
!اللّوز والحليب الطّازج

96
00:06:42,390 --> 00:06:44,000
آنسة ميو، ينبغي أن تُجرّبيها أيضاً

97
00:06:46,030 --> 00:06:48,640
!إنّها هزّازة جدّاً

98
00:06:51,910 --> 00:06:53,610
!شهيّة

99
00:06:53,610 --> 00:06:55,860
!طعام توبّو هو الأشهى في العالم حقّاً

100
00:06:56,110 --> 00:06:58,850
يجب أن أسرع وأعدّ ما يكفي
!للجميع في القلعة

101
00:06:58,850 --> 00:07:00,520
!أنا، توبّو، سوف أنصرف الآن

102
00:07:00,520 --> 00:07:01,700
!انتظر

103
00:07:03,050 --> 00:07:06,820
كلّ ما في الأمر أنّ إيلزا وهانّا
قد لا تحبّان الحليب كثيراً

104
00:07:07,140 --> 00:07:09,830
لم يسبق أن سمعتُ بذلك

105
00:07:10,170 --> 00:07:12,820
،لكن عندما طلبتُ حليباً للشّاي

106
00:07:12,820 --> 00:07:15,270
قالتا بأنّها طريقة مُبتكَرة لشربه

107
00:07:16,020 --> 00:07:16,990
ماذا؟

108
00:07:17,740 --> 00:07:20,130
لا بدّ أنّهما قالتا ذلك لأنّهما
لا تحبّان الحليب، أليس كذلك؟

109
00:07:20,130 --> 00:07:22,830
هل من المُمكن إعدادها من دون حليب؟

110
00:07:22,830 --> 00:07:25,880
!عُلِم يا مولاتي! سأجرّب الأمر

111
00:07:25,880 --> 00:07:27,650
!شكراً لك يا توبّو

112
00:07:29,420 --> 00:07:32,200
...ماري-ساما، أنتِ

113
00:07:39,420 --> 00:07:43,190
أنا متأكّدة بأنّ إيلزا وهانّا سوف تُصدَمان
من شدّة لذّتها

114
00:07:43,750 --> 00:07:45,360
!مولاتي

115
00:07:49,040 --> 00:07:50,860
كنتُ في طريقي إلى غرفتكِ للتو

116
00:07:51,390 --> 00:07:53,070
توماس، ما هذا؟

117
00:07:53,070 --> 00:07:55,630
وصلَتْ إلى مولاتي

118
00:07:55,630 --> 00:07:58,000
إنّها من عائلتها، منزل البارون شاديران

119
00:07:59,500 --> 00:08:01,500
توماس! لماذا أحضرت هذا إلى هنا؟

120
00:08:08,210 --> 00:08:12,200
لـ-لكن قال مولايّ بأنّ أيّ شيء
من عائلة شاديران

121
00:08:12,200 --> 00:08:15,300
ينبغي أن يُقدَّم لمولاتي إذا قال
خدمُها بأنّه لا مانع من ذلك

122
00:08:15,300 --> 00:08:17,200
إن كنتَ تعلم ذلك، فلماذا إذاً؟

123
00:08:17,200 --> 00:08:18,930
!لم أفتّش هذا

124
00:08:18,930 --> 00:08:24,230
ماذا؟ لكن الآنسة هانّا والآنسة إيلزا قد فحصاها
وقالتا بأن آخذها إلى مولاتي

125
00:08:30,830 --> 00:08:34,290
هذه، بلا شكّ، أغراضي

126
00:08:35,760 --> 00:08:37,700
تهانينا خطوبتكِ

127
00:08:37,700 --> 00:08:41,080
نسيتِ أن تأخذي كلّ الأغراض الّتي ستحتاجينها
للعمل في عائلة الكونت

128
00:08:52,950 --> 00:08:55,230
"قصّة القطّة الحمراء الرّثّة"

129
00:08:55,600 --> 00:08:58,390
الخيوط في حاشية الكتاب كانت
مُهلهلة منذ مدّة

130
00:08:58,390 --> 00:09:00,630
لكن أنا متأكّدة بأنّني وضعتُه
جانباً بحرص وعناية

131
00:09:00,960 --> 00:09:04,930
أ-أنا آسف! فعلتُ شيئاً فظيعاً، أليس كذلك؟

132
00:09:03,510 --> 00:09:06,140
!ماذا تفعلين؟ أفلتيني

133
00:09:06,140 --> 00:09:08,060
!أطلقي سراحي فوراً

134
00:09:08,060 --> 00:09:08,730
!أنتِ

135
00:09:09,410 --> 00:09:10,470
هذا مؤلم

136
00:09:10,470 --> 00:09:12,350
ماذا تعتقدين بأنّكِ تفعلين؟
!أنتِ مُجرّد خادمة

137
00:09:13,060 --> 00:09:14,780
وكذلك أنتما

138
00:09:14,780 --> 00:09:18,920
ماذا؟! خدمتُ الأمير الثّالث في القصر

139
00:09:18,920 --> 00:09:22,530
أوصى بنا الأمير لويفون، ولذا أُرسِلنا
!إلى هنا، قلعة غرانادو

140
00:09:22,530 --> 00:09:25,320
وأنا رئيسة الخدَم هنا في قلعة غرانادو

141
00:09:25,920 --> 00:09:27,690
أنتِ مُجرّد عجوز

142
00:09:27,690 --> 00:09:30,960
تمّ تخفيضكِ لخدمة ابنة بارون فقير فحسب

143
00:09:30,960 --> 00:09:33,170
وكنتُ أنا من رتّب لذلك الانتقال

144
00:09:33,550 --> 00:09:35,110
لا تتكلّمي معي بفوقيّة

145
00:09:35,110 --> 00:09:37,070
على ذكر الأمر، هذا معروف، أليس كذلك؟

146
00:09:37,070 --> 00:09:38,690
،الكونتيسة هي مومس سابق همجيّة

147
00:09:38,690 --> 00:09:41,970
تُهيّئ ابنتها مع زبون كخادمة هنا

148
00:09:41,970 --> 00:09:46,100
،ماذا؟ ظننتُ بأنّ الطّفلة كانت يتيمة
هُجرَتْ على قارعة الطّريق كلقيطة

149
00:09:46,710 --> 00:09:47,890
إنّها بلا كنية

150
00:09:47,890 --> 00:09:50,860
!أضحك كلّما فكّرتُ بأنّها تخدم في قلعة كونت

151
00:09:54,100 --> 00:09:56,860
فهمت. أنتما بغيضتان حقّاً

152
00:09:56,860 --> 00:09:59,280
ماذا قلتِ للتو؟

153
00:10:06,810 --> 00:10:09,170
والآن، دوركِ

154
00:10:09,170 --> 00:10:11,220
!لا

155
00:10:13,820 --> 00:10:18,220
أعتذر من أعماق قلبي. سبب كلّ هذا
فشلي كمُشرفة

156
00:10:18,870 --> 00:10:23,470
لا عليكِ. الأهمّ، هل يمكنني استعارة
مقصّاً وبعض الخيوط؟

157
00:10:27,870 --> 00:10:28,760
!يوهان

158
00:10:29,200 --> 00:10:30,910
!مولاتي

159
00:10:30,910 --> 00:10:32,650
...مـ-ملابسكِ

160
00:10:34,300 --> 00:10:36,670
أعدتُ تطريز بعض ملابسي القديمة

161
00:10:36,670 --> 00:10:39,390
قلتَ بأنّك ستأخذني في جولة
حول الحديقة، أليس كذلك؟

162
00:10:39,390 --> 00:10:41,360
بهذه، لا يهمّ إن توسّخت

163
00:10:42,700 --> 00:10:44,090
أهذا كلّ شيء؟

164
00:10:44,090 --> 00:10:47,370
كان بوسعي أن أزوّدكِ بأيّ عدد من الأحذية
المخصّصة لنا نحن الخدم

165
00:10:47,370 --> 00:10:49,210
!صحيح، كان بوسعنا فعل ذلك

166
00:10:51,100 --> 00:10:52,380
حسناً، لا يهمّ

167
00:11:06,510 --> 00:11:08,490
أدركتُ هذا للمرّة الأولى

168
00:11:08,490 --> 00:11:10,180
...الأشياء الّتي أحبّها

169
00:11:10,930 --> 00:11:13,570
،لطالما ظننتُ بأنّني أفعل كلّ شيء لعائلتي

170
00:11:13,570 --> 00:11:16,140
لكن الحقيقة هي أنّ كلّ الأعمال
...الشّاقّة بدتْ سهلة

171
00:11:16,580 --> 00:11:20,500
بسبب شدّة حبّي لزراعة خضراوات شهيّة

172
00:11:21,290 --> 00:11:25,770
لديّ أشياء أحبّها حقّاً وأشياء
أريد فعلها

173
00:11:26,980 --> 00:11:29,770
أنا آسف لأنّني كنتُ فظّاً تجاهكِ قبل الآن

174
00:11:29,770 --> 00:11:34,480
،ارتأيتُ بأنّني لا ينبغي أن أسبّب مُشكلة لكِ
أنتِ ابنة الكونت، بالتكلّم معكِ

175
00:11:34,480 --> 00:11:35,800
مُشكلة؟

176
00:11:35,800 --> 00:11:39,430
أنا خادم. وأجنبيّ أيضاً

177
00:11:39,430 --> 00:11:41,340
هذا غير مُهمّ

178
00:11:42,200 --> 00:11:46,550
نحن نعيش في نفس المنزل. ممّا
يجعلنا عائلة، أليس كذلك؟

179
00:11:50,140 --> 00:11:56,010
لـ-لم أصبح خطيبته رسميّاً بعد، لكن
الجميع هنا يبدون كعائلة

180
00:11:57,330 --> 00:12:00,360
تقولين نفس الكلام الّذي يقوله مولايّ

181
00:12:00,360 --> 00:12:01,620
تقصد كيروس-ساما؟

182
00:12:01,620 --> 00:12:02,870
!مولاتي

183
00:12:03,750 --> 00:12:06,160
!مولايّ سيُغادر

184
00:12:08,400 --> 00:12:10,090
!كيروس-ساما

185
00:12:13,890 --> 00:12:15,820
ماري

186
00:12:15,820 --> 00:12:19,320
سهرَ مولايّ كلّ اللّيل، لذا هو مُرهَق جدّاً

187
00:12:16,460 --> 00:12:19,210
اللّيلة الماضية

188
00:12:16,640 --> 00:12:19,610
!ماري! أحبّك يا ماري

189
00:12:19,320 --> 00:12:21,960
إنّه مشغول حقّاً، أليس كذلك؟

190
00:12:22,330 --> 00:12:27,400
الأهمّ يا مولايّ، إن كنتَ ستزور القصر
...لإقامة حفل مسائيّ

191
00:12:25,960 --> 00:12:26,760
!أطلق سراحي

192
00:12:26,760 --> 00:12:28,880
!انقلع أيّها الخادم القذر

193
00:12:28,880 --> 00:12:31,820
!أنت قذر ورائحتك كريهة

194
00:12:29,440 --> 00:12:32,550
من فضلك أعِد هذا العبء الثّقيل
إلى الأمير لويفون

195
00:12:32,550 --> 00:12:36,930
هـ-هل نعتِّنا للتو بالعبء الثّقيل؟
!نحن هنا بتوصية منه

196
00:12:36,930 --> 00:12:40,040
،هذا صحيح! قال بأنّنا يوماً ما
سوف نصبح محظيّاته

197
00:12:40,040 --> 00:12:41,320
...كلّ ما يجري

198
00:12:41,320 --> 00:12:43,030
!هو غلطتكِ أنتِ

199
00:12:43,560 --> 00:12:47,250
!أنتِ ابنة بارون مُفلِس أغواه المال

200
00:12:47,250 --> 00:12:49,320
!لستِ أكثر من مُجرّد بديلة لأختكِ الميّتة

201
00:12:49,320 --> 00:12:53,010
الجميع يعلم بأنّ الابنة الصّغرى
لعائلة شاديران هي شخص فاشل

202
00:12:53,010 --> 00:12:56,340
والكونت هو من سيصبح أضحوكة
!لأنّه اختار الخيار الخاطئ

203
00:12:56,640 --> 00:12:59,330
كيروس-ساما... أضحوكة؟

204
00:12:59,550 --> 00:13:01,400
!يجب أن تدركي حجمكِ

205
00:13:01,400 --> 00:13:02,850
!فتاة قبيحة

206
00:13:03,620 --> 00:13:04,830
أي جزء منها؟

207
00:13:06,390 --> 00:13:08,130
حاولا قول ذلك ثانية

208
00:13:08,130 --> 00:13:11,340
أي جزء من عائلتي، من ماري، تجدانه قبيحاً؟

209
00:13:11,340 --> 00:13:13,300
...لا، نقصد

210
00:13:14,910 --> 00:13:17,240
...وكلّ هذا الكلام عن بيوت النُّبلاء والأموال

211
00:13:17,240 --> 00:13:19,480
هذه ليست أشياء تنتمي لكما، أليس كذلك؟

212
00:13:19,910 --> 00:13:24,080
هل أنتما أجمل من ماري؟ أكثر وقاراً؟ أذكى؟

213
00:13:24,080 --> 00:13:26,110
أظرف؟ هل أنتما كذلك؟

214
00:13:26,580 --> 00:13:29,210
هل هناك جزء منكما يدفعني للوقوع في حبّكما؟

215
00:13:30,830 --> 00:13:32,300
أخبراني رجاء

216
00:13:32,640 --> 00:13:35,500
لأنّني لا أستطيع إيجاد أيّ شيء

217
00:13:42,790 --> 00:13:44,070
خذهما بعيداً

218
00:13:44,070 --> 00:13:44,720
!حاضر

219
00:13:47,260 --> 00:13:49,280
أنا آسفة جدّاً

220
00:13:49,280 --> 00:13:50,090
على ماذا؟

221
00:13:51,020 --> 00:13:54,610
قالتا أنّه بسببي، يا كيروس-ساما، سيضحك
الجميع عليك

222
00:14:02,080 --> 00:14:03,080
ماري

223
00:14:06,610 --> 00:14:08,270
أنتِ جميلة

224
00:14:09,190 --> 00:14:10,900
لا شيء هنا يدعو للسّخرية

225
00:14:11,570 --> 00:14:14,280
شعركِ الأحمر الجميل، والّذي
...يُبرزه هذا اللّون الأخضر

226
00:14:14,280 --> 00:14:16,360
...عيناكِ اللّتان تتلألآن كالنّجوم

227
00:14:16,780 --> 00:14:19,320
...معرفتكِ الغزيرة وفضولكِ

228
00:14:19,320 --> 00:14:22,300
ابتسامتكِ البريئة عندما تتكلّمين
...عن أشياء تُحبّينها

229
00:14:24,960 --> 00:14:26,890
جميلة من كافّة النّواحي

230
00:14:33,590 --> 00:14:35,240
أحم

231
00:14:35,240 --> 00:14:38,230
مولايّ، الوقت يُداهمنا

232
00:14:39,100 --> 00:14:41,540
،يمكننا الانتظار لبضع ثوانٍ أُخرى

233
00:14:41,540 --> 00:14:43,800
لكن أنا متأكّدة بأنّ ذلك لن يكون كافياً

234
00:14:43,800 --> 00:14:45,720
ماذا؟ أ-أجل

235
00:14:49,110 --> 00:14:52,180
مولايّ المسكين. بعد أن كان وشيكاً

236
00:14:52,930 --> 00:14:56,890
أتيتُ فقط لجمع أعشاب
،من أجل بعض العلاجات

237
00:14:56,890 --> 00:14:59,110
لكن تمكّنتُ من رؤية أمر لطيف جدّاً

238
00:14:59,110 --> 00:15:00,080
ألا تُوافقني؟

239
00:15:00,080 --> 00:15:03,490
هل تعتقدين بأنّ الأوريغانو الّذي
زرعتُه كان مُفيداً؟

240
00:15:05,420 --> 00:15:07,630
رأوا
...كلّ شيء

241
00:15:08,010 --> 00:15:11,520
قيل لي بأنّ كيروس-ساما كان ذاهباً
،إلى القصر الملكيّ لإجراء مراسم

242
00:15:11,520 --> 00:15:13,620
وبأنّه سيغيب لمدّة عشرة أيّام

243
00:15:13,620 --> 00:15:18,080
وعند عودته، كنّا سنبدأ بالتّحضيرات
لمراسم خطوبتنا بتفانٍ واجتهاد

244
00:15:14,880 --> 00:15:17,620
!ماري! سوف أعود قريباً

245
00:15:23,360 --> 00:15:26,120
لا شيء هنا يدعو للسّخرية

246
00:15:26,120 --> 00:15:29,180
...هذا ما قاله كيروس-ساما، لكن

247
00:15:32,950 --> 00:15:34,400
...هذه

248
00:15:35,020 --> 00:15:37,030
أليس من المُفترَض أن يكون
هذا تهديداً؟

249
00:15:37,260 --> 00:15:40,910
لا، ليس كذلك. كُتِبتْ كدعوة

250
00:15:41,880 --> 00:15:43,770
"ماري شاديران-ساما"

251
00:15:43,770 --> 00:15:49,770
أبارك لكِ خطوبتكِ من صديقي"
"القديم الكونت كيروس غرانادو

252
00:15:50,140 --> 00:15:51,920
الأمر طبيعيّ حتّى الآن

253
00:15:52,210 --> 00:15:57,840
بناء على ذلك، خطّطنا لحدث خاصّ"
"مُستغلّين كلّ وسائلنا وجهودنا

254
00:15:58,630 --> 00:16:05,230
تمّ تعميم إشعار في كلّ أنحاء العاصمة"
"الملكيّة والجميع ينتظرون اليوم بلهفة

255
00:16:05,530 --> 00:16:09,980
،ماري-ساما، إذا لم تستطيعي الحضور"
"فسيذهب كلّ شيء أدراج الرّياح

256
00:16:10,330 --> 00:16:14,900
"سيشعر النّاس باليأس وستدوم أحزانهم لأجيال"

257
00:16:14,900 --> 00:16:17,230
"أرجوكِ، يجب أن تحضري فحسب"

258
00:16:18,040 --> 00:16:21,590
يبدو هذا كتهديد بالفعل

259
00:16:21,590 --> 00:16:24,380
هذا الرّجل النّبيل هو أمير، أليس كذلك

260
00:16:24,380 --> 00:16:25,000
أجل

261
00:16:25,420 --> 00:16:30,010
إنّه الأمير الثّالث وقائد الفُرسان الملكيّين

262
00:16:30,010 --> 00:16:32,470
يتمتّع بشخصيّة طيّبة القلب

263
00:16:34,010 --> 00:16:36,700
حقيقة وصول هذا في عشيّة الحدث

264
00:16:36,700 --> 00:16:38,230
تُثبِت بأنّه يتوقّع منكِ الحضور

265
00:16:47,780 --> 00:16:49,610
ما-ما هذا؟

266
00:16:49,610 --> 00:16:52,030
عربة خيول من الفُرسان الملكيّين

267
00:17:32,350 --> 00:17:33,900
...و-وهذا

268
00:17:34,310 --> 00:17:39,160
،قلعة عسكريّة لمملكة ديلتز
معقل الفُرسان الملكيّين

269
00:17:39,160 --> 00:17:42,780
هل سيتمّ إعدامي علناً؟

270
00:17:42,780 --> 00:17:44,160
اهدئي من فضلكِ

271
00:17:44,470 --> 00:17:47,020
لـ-لكن لماذا الحصن؟

272
00:17:47,020 --> 00:17:49,510
لو كان القصر، لتمكّنتُ من أن أكون
مع كيروس-ساما

273
00:17:49,510 --> 00:17:53,420
الأمير لويفون هو من أوصى بهانّا وإيلزا

274
00:17:53,420 --> 00:17:55,000
لا بُدّ أنّه يريد أن يعتذر

275
00:17:55,010 --> 00:17:59,640
بضاعة مُرتجَعة

276
00:17:57,370 --> 00:17:59,340
هذا يُعزّز مخاوفي من الإعدام فحسب

277
00:18:02,080 --> 00:18:03,630
هل من مُشكلة؟

278
00:18:03,630 --> 00:18:07,870
،إذا كان الأمير لويفون هو المُضيف
فغالباً لديه خطط طريفة

279
00:18:07,870 --> 00:18:08,560
خطط؟

280
00:18:09,210 --> 00:18:11,040
...فزعات وحوش

281
00:18:11,040 --> 00:18:12,890
...انهمار بصل من الأعلى

282
00:18:13,420 --> 00:18:15,370
...أو ربّما بركة مليئة بالجيلي

283
00:18:16,080 --> 00:18:18,580
أيّ شخص هو الأمير لويفون بالضّبط؟

284
00:18:18,580 --> 00:18:20,810
في الواقع، إنّه ليس شرّيراً

285
00:18:20,810 --> 00:18:23,370
بما أنّنا هنا، أعتقد ينبغي أن نستمتع

286
00:18:36,730 --> 00:18:38,470
كلّ شيء مُفعم بالحيويّة

287
00:18:38,780 --> 00:18:42,320
.مضى خمسون عاماً منذ الحرب
العالم في سلام

288
00:18:42,320 --> 00:18:44,260
هذا النّوع من الحماس هو ترفيه جيّد

289
00:18:45,080 --> 00:18:46,350
كُلي من فضلكِ

290
00:18:46,670 --> 00:18:48,970
شـ-شكراً لكِ

291
00:18:47,350 --> 00:18:51,310
متى اشترتْ هذه؟

292
00:18:48,970 --> 00:18:51,320
أوّلاً، ينبغي أن أذهب وألقي التّحيّة
على الأمير لويفون، أليس كذلك؟

293
00:18:51,650 --> 00:18:55,510
لا، إنّه غالباً لا ينتظر تحيّة منكِ

294
00:18:55,510 --> 00:18:58,240
من المُمكن أنّه لم يأتِ إلى هنا حتّى

295
00:18:58,240 --> 00:19:02,200
ماذا؟ إذاً، كلّ ما عليّ هو الاستمتاع
بالاحتفالات ثمّ المُغادرة فقط؟

296
00:19:02,200 --> 00:19:07,150
من يدري؟ لا أفهم ما الّذي يدور
في ذهن الأمير لويفون إطلاقاً

297
00:19:09,810 --> 00:19:14,250
أشعر وكأنّ ميو قاسية قليلاً تجاه الأمير

298
00:19:18,200 --> 00:19:22,690
أتساءل، هل يبدو هذا كحدث صغير
بالنّسبة لشخص من العائلة الملكيّة؟

299
00:19:22,690 --> 00:19:26,230
لا، الفعاليّات بهذا الحجم نادرة نسبيّاً

300
00:19:26,230 --> 00:19:27,350
...ما يؤرقني

301
00:19:30,300 --> 00:19:33,870
هو أنّه لم تصلنا أي إشاعة
في قلعة غرانادو

302
00:19:34,230 --> 00:19:38,820
إذا أصدر الأمير أمراً بحظر النّشر قبل
...تنفيذ هذه التّرتيبات، حينها

303
00:19:40,970 --> 00:19:43,180
يراودني شعور سيّئ حيال هذا

304
00:19:43,570 --> 00:19:45,350
مـ-ميو؟

305
00:19:45,350 --> 00:19:46,410
!الأمير لويفون

306
00:19:48,400 --> 00:19:50,130
أين؟ كيف هو شكله؟

307
00:19:50,130 --> 00:19:52,320
في آخر الجهة اليسرى عند الجدار الحجريّ

308
00:19:52,320 --> 00:19:54,290
شعر فضّي، بلباس عسكريّ لفارس

309
00:19:55,170 --> 00:19:57,290
ميو، عيناكِ ثاقبتان

310
00:19:57,290 --> 00:20:00,550
،سأذهب وأتفقّد. ماري-ساما
انتظريني هنا رجاء

311
00:20:00,550 --> 00:20:01,840
!سـ-سأذهب معكِ

312
00:20:02,990 --> 00:20:06,580
من المُحتمَل أنّه جعل أحد رجاله يتنكّرون
...بهيئته لاستدراجنا

313
00:20:06,580 --> 00:20:10,410
كجزء من الخطّة للظّهور فجأة
وإخافتكِ يا ماري-ساما

314
00:20:10,410 --> 00:20:11,010
ماذا؟

315
00:20:13,820 --> 00:20:16,260
كائناً من كان مَن يناديكِ، تجاهليه رجاء

316
00:20:16,260 --> 00:20:17,430
!حـ-حسناً

317
00:20:17,430 --> 00:20:18,810
!سأعود بعد قليل

318
00:20:19,640 --> 00:20:22,490
!مهما حدث، لن أخطو خطوة واحدة

319
00:20:22,490 --> 00:20:26,620
مرحباً؟ الوقوف أمام متجري
!هكذا يُسبّب مُشكلة لي

320
00:20:26,620 --> 00:20:28,500
!أنا آسفة

321
00:20:29,620 --> 00:20:33,250
نبحث عن مُتسابعين
!في مُنافسة تقشير التّفّاحة

322
00:20:29,850 --> 00:20:32,150
يبحث عن مُتسابقين في مُسابقة تقشير تفّاحة؟

323
00:20:32,150 --> 00:20:33,240
!يبدو هذا مُمتعاً

324
00:20:34,060 --> 00:20:35,790
!المعذرة، أودّ التّجربة

325
00:20:35,790 --> 00:20:37,770
ماذا؟ هذا غير مألوف

326
00:20:37,770 --> 00:20:41,140
ظننتُ أنّ فتيات النّبلاء لا يستخدمنَ السّكاكين

327
00:20:44,560 --> 00:20:47,730
...إ-إذا قشّرتْ زوجة نبيل تفّاحاً

328
00:20:48,300 --> 00:20:50,610
أتعتقد بأنّ ذلك سيجعل زوجها أضحوكة؟

329
00:20:50,860 --> 00:20:52,540
عمّاذا تتكلّمين؟

330
00:20:52,540 --> 00:20:55,030
عليكِ تقشير تفّاحة لأكلها، أليس كذلك؟

331
00:20:57,180 --> 00:20:59,550
!وتفّاحنا لذيذ

332
00:20:59,440 --> 00:21:02,070
أمير ما مُرتبط
بالفُرسان

333
00:20:59,550 --> 00:21:02,080
حاز على ختم مُوافقة الفرسان

334
00:21:03,430 --> 00:21:05,690
!أجل، تبدو شهيّة جدّاً

335
00:21:05,690 --> 00:21:07,030
أتمنّى لو أنافس

336
00:21:07,030 --> 00:21:08,160
!حسناً إذاً

337
00:21:08,160 --> 00:21:10,600
،إذا استطعتِ تقشير تفّاحة كاملة
،ضمن الحدّ الزّمنيّ

338
00:21:10,600 --> 00:21:12,710
!فسأمنحكِ صندوقاً كاملاً من التّفّاح

339
00:21:12,710 --> 00:21:14,620
ابدئي لدى سماع إشارتي

340
00:21:14,860 --> 00:21:15,780
حسناً

341
00:21:15,780 --> 00:21:17,980
!حسناً، ها نحن أولاء

342
00:21:19,550 --> 00:21:21,890
يا لها من تفّاحة شهيّة المنظر

343
00:21:25,430 --> 00:21:28,170
!هـ-هذه لي! أعدها من فضلك

344
00:21:28,540 --> 00:21:31,420
ماذا أفعل؟

345
00:21:31,420 --> 00:21:32,490
!مهلاً

346
00:21:31,420 --> 00:21:33,350
!هيّا! هنا

347
00:21:33,350 --> 00:21:35,230
ربّما لا تريدينها في نهاية المطاف؟

348
00:21:38,890 --> 00:21:41,230
!تفّاحتي

349
00:21:41,230 --> 00:21:43,270
أجل، هذا عام جيّد للتّفّاح، أليس كذلك؟

350
00:21:43,270 --> 00:21:46,870
عجباً. كانت زبونتي مُستمتعة

351
00:21:46,870 --> 00:21:50,100
ما الفائدة إذا أفسد المُضيف
كلّ شيء، سموّك؟

352
00:21:50,100 --> 00:21:51,200
ماذا؟ "سموّك"؟

353
00:21:51,200 --> 00:21:55,760
مهلاً، مهلاً. أردتُ فقط التّسلية قليلاً
مع خطيبة صديقي

354
00:21:56,330 --> 00:21:57,240
أليس كذلك؟

355
00:21:57,460 --> 00:22:00,380
...هذا الرّجل إذاً هو

356
00:22:00,000 --> 00:22:01,420
خبط خبط خبط

357
00:22:01,760 --> 00:22:04,290
،كان فخّاً في نهاية المطاف إذاً
!أليس كذلك أيّها الأمير لويفون؟

358
00:22:06,810 --> 00:22:09,530
،أنا لويفون ساندالكيا ديلتز

359
00:22:09,530 --> 00:22:12,010
الأمير الثّالث لهذا البلد وقائد الفُرسان

360
00:22:12,310 --> 00:22:14,490
...لكن الأهمّ من كلّ ذلك

361
00:22:15,690 --> 00:22:17,970
!أنا صديق كيروس العزيز

362
00:22:18,360 --> 00:22:21,020
!سُرِرتُ بلقائكِ يا ماري-تشان

363
00:22:21,740 --> 00:22:24,700
هـ-هذه هي طبيعته كشخص إذاً

364
00:23:58,490 --> 00:24:00,470
!مرحباً جميعاً

365
00:24:00,470 --> 00:24:03,340
!أنا الأمير لويفون

366
00:24:03,660 --> 00:24:07,570
كيروس وأنا كنّا أعزّ صديقين منذ
!أيّامنا في المدرسة

367
00:24:07,570 --> 00:24:11,660
هل تستحقّ أن تكون ماري-تشان خطيبته؟

368
00:24:11,660 --> 00:24:15,130
!سأتحقّق من هذا الأمر من خلال مُفاجأة خاصّة

369
00:24:16,210 --> 00:24:19,590
"الحلقة القادمة، "الأمير والمُحارب حالك السّواد

370
00:24:20,060 --> 00:24:22,150
ستأتون وترون، بالطّبع، أليس كذلك؟