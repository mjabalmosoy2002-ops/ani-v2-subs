1
00:00:03,220 --> 00:00:04,610
حقّاً، من كان يتوقّع

2
00:00:04,610 --> 00:00:08,760
ذلك العنيد نورمان يتّخذ يتيماً كتلميذ؟

3
00:00:08,760 --> 00:00:10,230
هذه مُفاجأة

4
00:00:10,610 --> 00:00:14,120
كان مُتشدّداً جدّاً لدرجة أنّه لا يقبل
بتوريث مهاراته لأحد

5
00:00:15,040 --> 00:00:17,950
ما-ما اسم تلميذه؟

6
00:00:19,630 --> 00:00:25,170
اسمه آرثر. إنّه فتى في الثّانية عشر
أو الثّالثة عشر من العمر

7
00:00:27,430 --> 00:00:30,140
هكذا إذاً

8
00:00:30,480 --> 00:00:34,630
ماري... لا تقولي لي بأنّكِ تعتقدين
بأنّ أناستاشيا ما زالت حيّة؟

9
00:00:35,180 --> 00:00:38,220
أتعتقدين بأنّ تلميذة نورمان قد تكون أختك؟

10
00:00:38,220 --> 00:00:40,480
هذا غير مُرجّح بالطّبع

11
00:00:40,480 --> 00:00:42,310
أجل، بالطّبع

12
00:00:42,870 --> 00:00:44,330
فهمت

13
00:02:23,710 --> 00:02:27,230
مضت أسابيع قليلة منذ إرسال
مُذكّرة استدعاء إلى أبي

14
00:02:27,230 --> 00:02:29,000
لم يلقَ أيّ ردّ بعد

15
00:02:30,050 --> 00:02:35,500
كلّ ما يمكنني فعله هو تكريس كلّ ما لديّ
لتعلّم آداب السّلوك الأرستقراطيّة

16
00:02:36,010 --> 00:02:41,360
وكتابة رسائل شكر لتوزيعها على
الضّيوف الّذين يحضرون مراسم الخطوبة

17
00:02:42,530 --> 00:02:48,140
كلّ هذا كي أزداد قيمة وأكون
مُستحقّة لكيروس-ساما

18
00:03:20,630 --> 00:03:24,560
في الأمس، أرسلتُ عربة لإحضار
البارون إلى هنا مباشرة

19
00:03:25,470 --> 00:03:28,300
هكذا إذاً

20
00:03:28,540 --> 00:03:33,190
إذا لم يستجب رغم ذلك، فقد ألجأ
لإجراءات أكثر صرامة قليلاً

21
00:03:33,650 --> 00:03:35,770
أنا آسفة جدّاً

22
00:03:35,770 --> 00:03:38,440
،إذا ظلّ أبي مُختبئاً، فبصفتي ابنته

23
00:03:38,440 --> 00:03:40,450
أنا مُستعدّة لمواجهة أي عقوبة

24
00:03:40,840 --> 00:03:44,620
لا تقولي ذلك رجاء! هل تعتقدين
بأنّني سأسمح بشيء كهذا؟

25
00:03:45,350 --> 00:03:50,450
لكن على شخص أن يتحمّل
مسؤوليّة تصرّفاته، أليس كذلك؟

26
00:03:50,770 --> 00:03:52,070
!ماري

27
00:03:52,070 --> 00:03:53,990
أنا بخير

28
00:03:59,170 --> 00:04:01,770
سأذهب للتّمرين على الرّقص الآن

29
00:04:12,750 --> 00:04:16,040
ليس لديّ ما أُعلّمها إيّاه

30
00:04:16,040 --> 00:04:18,050
إنّها تبذل جهداً أكبر من معظم النّاس

31
00:04:18,050 --> 00:04:18,940
أجل

32
00:04:23,060 --> 00:04:25,320
إيّاك أن تتركها

33
00:04:25,750 --> 00:04:27,150
أعلم

34
00:04:31,170 --> 00:04:32,310
،مولاتي النّبيلة

35
00:04:33,800 --> 00:04:37,430
هلّا شرّفتِني برقصة؟

36
00:04:43,150 --> 00:04:45,600
بكلّ سرور... سيّدي

37
00:04:51,670 --> 00:04:54,190
!أصبحتِ ماهرة في هذا حقّاً

38
00:04:54,610 --> 00:04:57,180
يسرّني كلامك هذا

39
00:04:57,180 --> 00:04:59,140
—تمرّنتُ كثيراً، لذا

40
00:05:04,260 --> 00:05:06,460
ما الأمر؟ هل أنت بخير؟

41
00:05:06,460 --> 00:05:10,320
أ-أنا آسفة. زلّتْ قدمي فجأة

42
00:05:11,250 --> 00:05:13,150
أنتِ تضغطين على نفسكِ كثيراً

43
00:05:13,810 --> 00:05:15,330
ارتاحي قليلاً

44
00:05:15,590 --> 00:05:18,120
!لا، لم أضغط على نفسي إطلاقاً

45
00:05:18,120 --> 00:05:20,250
—عندما تحين مراسم الخطوبة، سأكون أفضـ

46
00:05:21,850 --> 00:05:22,960
!ماري

47
00:05:29,260 --> 00:05:32,450
هل أنتِ بخير؟ ألا ينبغي أن تذهبي
إلى غرفتكِ وترتاحي؟

48
00:05:32,450 --> 00:05:34,470
لا، أنا بخير

49
00:05:34,910 --> 00:05:36,470
!لا، لستِ كذلك

50
00:05:36,470 --> 00:05:40,370
منذ سمعنا عن تلميذ نورمان، أمسيتِ
!تتصرّفين بشكل غريب

51
00:05:40,370 --> 00:05:42,780
ما زلتِ تُفكّرين في أناستاشيا، أليس كذلك؟

52
00:05:42,780 --> 00:05:44,940
...هـ-هذا ليس

53
00:05:44,940 --> 00:05:47,950
ثمّة شيء يُضايقكِ، أليس كذلك؟

54
00:05:48,670 --> 00:05:52,200
رأيتُ شخصاً... بالقرب من حيّ الحِرفيّين

55
00:05:52,200 --> 00:05:53,830
شخصاً يشبه أختي

56
00:05:54,580 --> 00:05:55,670
شقراء

57
00:05:57,190 --> 00:06:00,100
حسناً. لنلتقِ بتلميذ نورمان

58
00:06:00,100 --> 00:06:00,590
ماذا؟

59
00:06:00,870 --> 00:06:05,050
حالما ترينه بأمّ عينكِ، فسوف
تهدأ مشاعركِ

60
00:06:08,520 --> 00:06:09,490
حسناً

61
00:06:19,470 --> 00:06:21,920
أحضرتُ سميث نورمان

62
00:06:31,700 --> 00:06:34,120
نورمان، مضى وقت طويل، أليس كذلك؟

63
00:06:34,120 --> 00:06:37,960
بالفعل يا حضرة الكونت غرانادو

64
00:06:43,690 --> 00:06:45,880
نورمان... ماذا حدث لعينيك؟

65
00:06:46,100 --> 00:06:48,990
،قبل ثلاث سنوات وبينما كنتُ أعمل

66
00:06:48,990 --> 00:06:53,260
تطايرت نثرات من الحديد السّاخن
واخترقتْ ناظوري

67
00:06:53,260 --> 00:06:58,280
،ما زلتُ أستطيع رؤية ضوء وظلال وألوان
لذا أستطيع العيش بشكل طبيعيّ

68
00:06:58,690 --> 00:07:00,810
ماذا عن وجوه النّاس؟

69
00:07:01,150 --> 00:07:03,530
إذا كان شخصاً أعرفه جيّداً، فأستطيع
أن أتدبّر أمري

70
00:07:03,530 --> 00:07:06,270
لكن تلميذي يخدم كافّة الزبائن الجدُد

71
00:07:06,270 --> 00:07:09,090
على ذكر الأمر، أين تلميذك؟

72
00:07:09,090 --> 00:07:10,470
لماذا هو ليس هنا؟

73
00:07:12,580 --> 00:07:14,480
أعتذر

74
00:07:14,800 --> 00:07:19,070
قلتُ له أن يأتي معي، لكن
قال بأنّه يشعر بوعكة

75
00:07:19,960 --> 00:07:22,180
سنرسل مبعوثاً آخر

76
00:07:23,600 --> 00:07:27,860
نورمان، قال لويفون بأنّ
،تلميذك هو شابّ صغير

77
00:07:27,860 --> 00:07:29,790
لكن كيف عرفت بأنّه رجل؟

78
00:07:29,790 --> 00:07:33,710
هو من قال ذلك بنفسه. لماذا تسأل؟

79
00:07:33,980 --> 00:07:37,440
هل تقصد بأنّك تعتقد بأنّني آوي امرأة؟

80
00:07:37,440 --> 00:07:41,610
لا تمزح بشأن أمر كهذا! مُحال
!أن أدع امرأة تدخل إلى ورشتي

81
00:07:41,610 --> 00:07:44,900
وما زال آرثر غرّاً، لكن لديه
!الموهبة والعزيمة معاً

82
00:07:44,900 --> 00:07:49,310
هـ-هكذا إذاً. سمعتُ بأنّك التقيت
بآرثر في العاصمة الملكيّة

83
00:07:49,770 --> 00:07:53,730
،أجل، كان يهرب من بيعه لبعض النّبلاء

84
00:07:53,730 --> 00:07:56,190
لذا كان يتجوّل في البلدة وهو مُفلس

85
00:07:56,470 --> 00:07:58,950
،عندما قلتُ بأنّني حِرفيّ أزرار، قال

86
00:07:58,950 --> 00:08:02,360
"!حقّاً يا عمّ؟ إذاً اجعلني تلميذك"

87
00:08:02,360 --> 00:08:03,350
ماذا؟

88
00:08:03,350 --> 00:08:05,090
قالها بنفسه؟

89
00:08:05,090 --> 00:08:06,310
بالفعل

90
00:08:06,310 --> 00:08:11,540
قال، "سئمتُ من حياة يتمّ استغلالي
"!فيها بواسطة أشرار أثرياء فاسدين

91
00:08:11,850 --> 00:08:13,060
!هكذا إذاً

92
00:08:13,060 --> 00:08:15,060
كما توقّعت، إنّه شخص آخر إذاً

93
00:08:15,060 --> 00:08:18,520
مُحال أن تتكلّم ابنة نبيل بهذه الطّريقة

94
00:08:18,520 --> 00:08:23,430
،ما زالت مهاراته في الحرفة تحتاج لصقل
لكن فهمه للملابس استثنائيّ

95
00:08:23,880 --> 00:08:26,500
ملابس لترتديها النّساء لتصبحن رجالاً، صحيح؟

96
00:08:26,500 --> 00:08:29,760
قال بأنّه كان يصنع مثل هذه
الملابس منذ مدّة

97
00:08:30,390 --> 00:08:34,090
...ملابس للنّساء لتصبحن رجالاً؟ هـ-هذا مثل

98
00:08:34,700 --> 00:08:38,620
يا لها من هواية غير مألوفة. هل كان
والداه حرفيّين أيضاً؟

99
00:08:38,620 --> 00:08:42,650
لا يبدو أنّه يريد الحديث عن والديه

100
00:08:42,650 --> 00:08:45,380
،مهما سألتُه، يجيب دوماً

101
00:08:45,380 --> 00:08:48,700
"!كُفّ عن السّؤال أيّها الأحمق! أنا مُجرّد قطّ رثّ"

102
00:08:48,700 --> 00:08:49,590
تخيّل

103
00:08:52,850 --> 00:08:54,790
!يا له من تلميذ مُثير للاهتمام

104
00:08:55,160 --> 00:08:56,070
بالفعل

105
00:08:56,070 --> 00:08:59,470
في المرّة المُقبلة، سأحضر بعضاً من الملابس

106
00:08:59,470 --> 00:09:01,700
أتطلّع قُدماً لذلك

107
00:09:01,700 --> 00:09:03,990
ستليق بماري بشكل مُفاجئ غالباً

108
00:09:06,150 --> 00:09:07,080
ماري؟

109
00:09:09,470 --> 00:09:11,810
!ماري

110
00:09:12,420 --> 00:09:13,610
أين أنتِ؟

111
00:09:15,040 --> 00:09:16,600
!اخرجي رجاء

112
00:09:23,380 --> 00:09:25,700
!ابدؤوا في البحث في المنطقة فوراً

113
00:09:25,700 --> 00:09:26,740
!عُلِم

114
00:09:26,740 --> 00:09:28,600
!ماري

115
00:09:28,600 --> 00:09:30,590
أين أنتِ؟

116
00:09:30,590 --> 00:09:32,550
!ماري

117
00:09:32,850 --> 00:09:34,490
!ماري-ساما

118
00:09:35,900 --> 00:09:38,420
...مولاتي، لماذا

119
00:09:41,130 --> 00:09:43,640
سيّد يوهان! هل رأيت مولاتنا؟

120
00:09:47,560 --> 00:09:48,480
!اللّعنة

121
00:09:50,910 --> 00:09:52,870
لماذا لا أستطيع إيجادها؟

122
00:10:04,730 --> 00:10:07,290
ماري؟ هل أنتِ هنا؟

123
00:10:07,870 --> 00:10:10,730
أنتِ كذلك، صحيح؟ هل يمكنني الدّخول؟

124
00:10:11,310 --> 00:10:12,440
ابتعد

125
00:10:13,900 --> 00:10:16,000
لماذا هذه الغرفة؟

126
00:10:16,730 --> 00:10:18,770
هذه الغرفة؟

127
00:10:19,620 --> 00:10:23,090
...على ذكرِه للأمر

128
00:10:27,870 --> 00:10:32,570
لسبب ما... شعرتُ وكأنّ هذا
المكان سوف يحميني

129
00:10:32,570 --> 00:10:36,180
من فضلكِ... من فضلكِ دعيني أنضمّ لكِ

130
00:10:36,180 --> 00:10:40,060
الجوّ بارد هنا. لنحتسِ بعض الشّاي
السّاخن ونهدّئ من روعنا

131
00:10:40,950 --> 00:10:42,390
...كيروس-ساما

132
00:11:03,480 --> 00:11:04,470
...ماري

133
00:11:05,020 --> 00:11:07,650
سماع كلام السيّد نورمان جعلني
مُتيقّنة من ذلك

134
00:11:08,250 --> 00:11:10,730
كانت أختي تحبّ صنع الملابس

135
00:11:11,190 --> 00:11:14,190
"وتلك العبارات من "حكاية القطّة الحمراء الرّثّة

136
00:11:15,330 --> 00:11:17,390
إنّها حيّة كما توقّعت

137
00:11:17,390 --> 00:11:20,980
والآن لا سبب يدفع لبقائي هنا

138
00:11:21,260 --> 00:11:22,770
ماذا تقصدين؟

139
00:11:22,770 --> 00:11:27,700
حتّى لو كانت أناستاشيا حيّة، مشاعرنا
تجاه بعضنا الآخر مُشتركة، أليس كذلك؟

140
00:11:28,150 --> 00:11:31,950
أختي امرأة لطيفة وجميلة ورائعة

141
00:11:32,340 --> 00:11:36,450
مهما فعلت، لن أكون ندّة لها أبداً

142
00:11:36,950 --> 00:11:39,940
أعلم بأنّ مشاعرك تجاهي ليست كذبة

143
00:11:39,940 --> 00:11:43,470
لكن... لكن هذا فقط لأنّك لا تعرف أختي

144
00:11:44,060 --> 00:11:47,390
لو كنت تعرفها جيّداً، فأنا متأكّدة
بأنّك ستقع في حُبّها أيضاً

145
00:11:48,250 --> 00:11:49,940
أكثر من حبّك لشخص مثلي

146
00:11:51,240 --> 00:11:52,900
!ما الّذي تقولينه؟

147
00:11:52,900 --> 00:11:56,550
!أنتِ من أُحبّها! أحببتُكِ طوال هذا الوقت

148
00:11:56,550 --> 00:12:01,100
هل تقصدين... بأنّكِ تستطيعين التخلّي
عن مشاعركِ تجاهي؟

149
00:12:02,280 --> 00:12:03,740
أتخلّى عنها؟

150
00:12:04,560 --> 00:12:06,460
!مُحال أن أتخلّى عنها

151
00:12:06,990 --> 00:12:10,010
ليس عليكِ القلق

152
00:12:10,450 --> 00:12:12,860
أحبّكِ كما أنتِ فحسب

153
00:12:13,370 --> 00:12:17,780
...أنا الّتي تحبّها هي أنا الجميلة

154
00:12:17,780 --> 00:12:20,580
وليس الإنسانة القبيحة الّتي أنا عليها

155
00:12:23,220 --> 00:12:26,810
أنا... أبغض نفسي

156
00:12:27,560 --> 00:12:28,800
ماري

157
00:12:29,540 --> 00:12:32,760
ظننتُ بأنّني تمّيتُ لو أنّ أختي
...كانت لا تزال حيّة، ومع ذلك

158
00:12:33,620 --> 00:12:38,450
لو كانت أختي ميّتة، فحينئذ
سأتمكّن من البقاء بجانبك

159
00:12:39,650 --> 00:12:42,540
سمحتُ لنفسي بالحلم

160
00:12:42,950 --> 00:12:45,180
...مشاعري الحقيقيّة مُثيرة للاشمئزاز

161
00:12:45,700 --> 00:12:48,440
أنا متأكّدة بأنّها ستُخيّبك

162
00:12:49,860 --> 00:12:52,960
...والآن بينما لا تزال تحبّني

163
00:12:54,300 --> 00:12:56,640
افسح الخطوبة من فضلك

164
00:13:00,130 --> 00:13:03,090
سأعود إلى بيت شاديران

165
00:13:06,860 --> 00:13:11,120
حسناً. سأحقّق لكِ أُمنيتكِ

166
00:13:27,870 --> 00:13:29,610
شكراً لك على الاهتمام بي

167
00:13:29,900 --> 00:13:35,110
سأكرّس حياتي على تعويضك عن نفقات
عيشي وعن فسخ حطوبتنا

168
00:13:35,110 --> 00:13:38,600
ليس عليكِ القلق بشأن ذلك

169
00:13:39,050 --> 00:13:41,130
سأوصلها إلى المنزل

170
00:14:09,100 --> 00:14:12,880
ماري... أهذا ما تريدينه حقّاً؟

171
00:14:18,190 --> 00:14:19,120
أجل

172
00:14:24,080 --> 00:14:25,610
أنا ضعيف جدّاً

173
00:14:27,330 --> 00:14:31,060
...أعلم بأنّكِ لا تقصدين ما تقولينه، ومع ذلك

174
00:14:31,580 --> 00:14:32,480
...أنا

175
00:14:33,380 --> 00:14:37,130
ماري، ألم يبقَ شيء أستطيع فعله؟

176
00:14:39,070 --> 00:14:41,000
لا شيء

177
00:14:41,000 --> 00:14:43,140
فعلتِ أكثر ما هو كافٍ لأجلي

178
00:14:46,910 --> 00:14:48,010
هكذا إذاً

179
00:14:55,780 --> 00:14:58,020
...إذا استجمعتُ شجاعتي

180
00:14:58,620 --> 00:15:01,410
...إذا استطعتُ النّضوج كرجل أقوى ولو قليلاً

181
00:15:04,860 --> 00:15:06,910
فذات يوم، أعِدك بأنّني سآتي إليكِ

182
00:15:07,780 --> 00:15:11,320
أتوسّل إليكِ، انتظريني أرجوكِ
إلى أن يحين ذلك الوقت

183
00:15:21,340 --> 00:15:24,180
غادرتُ دون أن أقول وداعاً للجميع

184
00:15:24,640 --> 00:15:26,940
رغم أنّهم اعتنوا بي جيّداً

185
00:15:27,370 --> 00:15:30,160
،لو اتّخذ شخصاً جاحداً مثلي زوجة له

186
00:15:30,160 --> 00:15:31,940
فسيجلب ذلك البليّة للجميع

187
00:15:32,710 --> 00:15:35,510
هذا هو الصّواب في نهاية المطاف

188
00:15:35,510 --> 00:15:38,030
خيّب مولايّ أملي

189
00:15:38,030 --> 00:15:40,820
لم أتصوّر أن يكون بهذا الضّعف والجبن

190
00:15:40,820 --> 00:15:42,200
جبن؟

191
00:15:42,560 --> 00:15:48,170
،بدلاً من اختيار مُستقبل سعيد لأجلك
اختار إيقاف دموعك في الحاضر

192
00:15:48,710 --> 00:15:51,440
لأنّه خائف من أذيّتكِ

193
00:15:51,440 --> 00:15:53,720
خائف من أذيّتي؟

194
00:15:54,780 --> 00:15:59,760
،لا أريد أن أتأذّى، لذا أذيتُه بدلاً من ذلك

195
00:15:59,760 --> 00:16:02,390
وسعى لحمايتي

196
00:16:02,390 --> 00:16:05,060
أنا متأكّدة لأنّني بدوتُ وكأنّني
على وشك أن أنهار

197
00:16:05,960 --> 00:16:08,890
هل هذه نقطة ضعف؟

198
00:16:29,830 --> 00:16:32,290
...عيون أجمل من أيّ نجم

199
00:16:33,640 --> 00:16:38,230
منذ لحظة لقائي بك، أحببتُك

200
00:16:38,910 --> 00:16:40,960
أحبّكِ يا ماري

201
00:16:41,380 --> 00:16:43,510
أحبّكِ من أعماق قلبي

202
00:16:43,830 --> 00:16:46,710
ومهما حدث، سأبقى دوماً إلى جانبكِ

203
00:16:47,190 --> 00:16:48,560
أنتِ جميلة

204
00:16:50,290 --> 00:16:55,500
لطالما أخبرني كيروس-ساما بمشاعره فعليّاً

205
00:16:55,940 --> 00:16:58,060
...ومع ذلك أنا

206
00:16:58,060 --> 00:17:00,440
!كلّ ما فعلته هو الهرب

207
00:17:02,630 --> 00:17:05,010
أوّل كنز وجدتُه في حياتي

208
00:17:09,240 --> 00:17:11,580
...كنتُ خائفة جدّاً من فقدانه

209
00:17:11,980 --> 00:17:14,240
لدرجة أنّني كذبتُ وقلتُ بأنّني لا أريده

210
00:17:15,130 --> 00:17:17,150
،لم أُرد أن أُجرَح

211
00:17:17,150 --> 00:17:20,140
لذا حاولتُ إقناع نفسي بأنّني لستُ جديرة

212
00:17:21,720 --> 00:17:25,540
لكن... الحقيقة هي أنّني لطالما أردتُه

213
00:17:26,070 --> 00:17:29,100
أردتُه باستماتة لدرجة أنّني
لم أستطع تحمُّل ذلك

214
00:17:34,650 --> 00:17:37,380
!ميو، من فضلكِ! العربة

215
00:17:37,380 --> 00:17:38,850
عُلِم

216
00:17:41,200 --> 00:17:42,370
ما-ماذا؟

217
00:17:45,970 --> 00:17:47,790
سنعود عمّا قريب

218
00:17:47,790 --> 00:17:51,210
حتّى الآن، كنّا ببساطة ندور بالقرب من القلعة

219
00:17:51,620 --> 00:17:52,500
ماذا؟

220
00:17:52,750 --> 00:17:55,730
ستهتزّ العربة قليلاً. من فضلكِ احذري
ألّا تعضّي لسانكِ

221
00:18:06,860 --> 00:18:10,940
مرّرتُ الأمر في السّابق، لكن هذه المرّة
!سيكون كلّ شيء على ما يُرام

222
00:18:23,250 --> 00:18:24,880
!لن أهرب بعد الآن

223
00:18:24,880 --> 00:18:26,880
!لن أكذب على نفسي بعد الآن

224
00:18:28,470 --> 00:18:30,000
!كيروس-ساما

225
00:18:30,410 --> 00:18:34,610
الجبان... الشّخص الّذي يحتاج
!شجاعة أكبر هو أنا

226
00:18:34,610 --> 00:18:36,830
!لذا، سأخبرك كما ينبغي

227
00:18:38,110 --> 00:18:40,120
!أنا أريدك

228
00:18:40,460 --> 00:18:42,240
!والجميع في هذه القلعة أيضاً

229
00:18:42,240 --> 00:18:44,390
!وكلّ ما يتعلّق بك، كلّ شيء

230
00:18:44,390 --> 00:18:46,140
!لا أريد أحداً آخر أن يحصل عليه

231
00:18:47,480 --> 00:18:50,990
!أرجوك امنحني كلّ كيانك

232
00:19:00,510 --> 00:19:02,060
كيروس-ساما؟

233
00:19:02,060 --> 00:19:03,960
لماذا أنت خلفي؟

234
00:19:07,020 --> 00:19:08,690
كنتُ ألحق بكِ

235
00:19:30,440 --> 00:19:32,440
!حمقاء! ماري، أنتِ حمقاء للغاية

236
00:19:32,900 --> 00:19:35,100
لن تُغادري بعد الآن، صحيح؟

237
00:19:35,100 --> 00:19:37,270
ستقولين بأنّكِ عدتِ إلى المنزل الآن، صحيح؟

238
00:19:37,650 --> 00:19:40,640
أجل، عُدتُ يا سيلي

239
00:19:40,640 --> 00:19:41,830
...مولاتي

240
00:19:43,120 --> 00:19:44,580
أهلاً بعودتكِ

241
00:19:46,780 --> 00:19:48,250
...الجميع

242
00:19:49,200 --> 00:19:51,410
أنا آسفة لأنّني أثرتُ قلقكم

243
00:19:51,410 --> 00:19:53,740
!فطيرة التّفاح العظمى

244
00:19:53,740 --> 00:19:57,870
!لقمة واحدة ولن تفكّري في المُغادرة ثانية

245
00:19:58,790 --> 00:19:59,680
معك حقّ

246
00:20:00,970 --> 00:20:03,390
ما رأيكِ بالمُكوِّن السّرّي؟

247
00:20:03,390 --> 00:20:04,660
آنسة ماري؟

248
00:20:05,700 --> 00:20:07,710
من فضلكِ لا تذهبي إلى أيّ مكان

249
00:20:08,440 --> 00:20:11,560
لطالما تهرّب كيروس من الوقوع
،في حُبّ أحد

250
00:20:12,050 --> 00:20:14,350
لكنّه التقى بكِ أخيراً الآن

251
00:20:14,670 --> 00:20:18,260
أجل، لن أهرب بعد الآن

252
00:20:19,330 --> 00:20:21,500
حدث ذلك قبل أن أدرك ذلك حتّى

253
00:20:22,250 --> 00:20:26,070
،هنا، في هذه القلعة، شيئاً فشيئاً
...بنيتُ المكان الحقيقيّ

254
00:20:26,470 --> 00:20:28,260
مكاناً أنتمي إليه

255
00:20:50,280 --> 00:20:52,970
...هذا صحيح. أنا

256
00:20:56,470 --> 00:20:57,800
...ماري

257
00:21:00,820 --> 00:21:02,680
هل يبحث عنّي؟

258
00:21:07,810 --> 00:21:10,600
إنّه ظريف... بعض الشّيء

259
00:21:13,300 --> 00:21:14,820
عذراً على الإزعاج

260
00:21:14,820 --> 00:21:16,620
ميو؟

261
00:21:16,620 --> 00:21:19,370
إن أحببت، الحمّام جاهز

262
00:21:19,370 --> 00:21:21,030
جهّزت تونيكا كلّ شيء

263
00:21:21,030 --> 00:21:22,590
!حـ-حسناً

264
00:21:31,940 --> 00:21:34,030
كان الحمّام السّاخن لطيفاً

265
00:21:34,030 --> 00:21:36,640
أتساءل إن استيقظ كيروس-ساما أم لا

266
00:21:38,050 --> 00:21:40,580
ماذا لو كان يبحث عنّي ثانية؟

267
00:21:45,200 --> 00:21:46,340
!لا تتحرّكي

268
00:21:47,160 --> 00:21:49,890
أين غرفة ماري شاديران؟

269
00:21:49,890 --> 00:21:51,040
...هذا الصّوت

270
00:21:51,040 --> 00:21:54,990
.الظّلام حالك لدرجة تجعل الرّؤية صعبة
—أسرعي ودلّيني على

271
00:21:58,730 --> 00:22:00,970
ماري، هل أنتِ بخير؟

272
00:22:00,970 --> 00:22:02,290
كيروس-ساما؟

273
00:22:02,290 --> 00:22:05,960
.استيقظتُ، لذا أتيتُ بحثاً عنكِ
!كان ذلك وشيكاً

274
00:22:06,240 --> 00:22:09,220
ما-ماذا تعتقد أنّك تفعل أيّها الرّجل الضّخم؟

275
00:22:09,580 --> 00:22:13,250
ما هذا؟ سفّاح صغير مُفعم بالحيويّة

276
00:22:13,250 --> 00:22:15,980
...ا-الأمر ليس كذلك. إنّها

277
00:22:19,550 --> 00:22:21,470
!أختي الكبرى أناستاشيا

278
00:23:57,560 --> 00:23:59,430
،الآنسة ماري هي من العائلة

279
00:23:59,430 --> 00:24:02,000
!ويسرّني أنّها عادت

280
00:24:02,610 --> 00:24:05,500
لحظة، الآنسة أناستاشيا؟

281
00:24:05,910 --> 00:24:09,130
"الحلقة القادمة، "حياة الأميرة الفارغة

282
00:24:09,430 --> 00:24:11,160
احرصوا على مُشاهدتها