.طالما أنك تعلمتِ درسك

194
00:11:38,130 --> 00:11:39,550
.الساعة السادسة إذن

195
00:11:40,050 --> 00:11:42,640
...سأذهب إلى المنزل وسأغسل الملابس ثم

196
00:11:43,970 --> 00:11:46,260
أتساءل ما الذي يُعرض على التلفاز اليوم؟

197
00:11:47,260 --> 00:11:48,640
.ليست لدي خطط هذه الليلة

198
00:11:49,730 --> 00:11:52,140
.لن أستمتع بلعب تلك اللعبة بمفردي

199
00:11:52,690 --> 00:11:53,850
.إنها تعيقنا

200
00:11:55,860 --> 00:11:58,570
.لم أدخل اللعبة منذ ذلك اليوم

201
00:11:59,240 --> 00:12:02,610
هل يستمتع ذلك الأفرو المتغطرس بوقته؟

202
00:12:03,110 --> 00:12:04,660
.آسفة يا أكيتو-كن

203
00:12:07,080 --> 00:12:09,910
.آسفة على إيقافك وتضييع وقتك هكذا

204
00:12:15,170 --> 00:12:16,130
...كما ترى

205
00:12:16,710 --> 00:12:18,460
...فتاة ثانوية

206
00:12:18,460 --> 00:12:20,300
.تعترف بحبها على ما أظن

207
00:12:20,670 --> 00:12:22,300
!من الجميل أن يكون المرء يافعًا

208
00:12:22,800 --> 00:12:25,050
!أنت ذو شعبية أيها السيد

209
00:12:26,640 --> 00:12:31,060
اعترفت بحبي لطالب يكبرني أيضًا
.عندما كنت في الثانوية

210
00:12:31,480 --> 00:12:33,480
!أنا مغرمة بك -
.لدي حبيبة -

211
00:12:33,850 --> 00:12:37,310
.سايتو الوسيم، أتساءل كيف حاله

212
00:12:35,600 --> 00:12:40,860
ذكريات سعيدة

213
00:12:37,310 --> 00:12:39,940
.أنصت

214
00:12:39,940 --> 00:12:40,860
ألم تنتهي بعد؟

215
00:12:42,700 --> 00:12:46,120
.لقد مضت 7 دقائق على إيقافك لي

216
00:12:47,280 --> 00:12:50,540
هلا نتحدث عن هذا في يوم آخر
بعد أن تستجمعي أفكارك؟

217
00:12:51,660 --> 00:12:54,670
.آسف، لكن يكاد يحين وقت ظهور الزعيم

218
00:12:56,830 --> 00:12:58,000
.عذرًا

219
00:12:59,170 --> 00:13:00,420
!انتظر

220
00:13:06,390 --> 00:13:09,100
لقد نسيت بالطبع، صحيح؟

221
00:13:09,100 --> 00:13:11,930
!أنا أكاني التي ساعدتها في تلك الفعالية

222
00:13:11,930 --> 00:13:15,350
.الآنسة التي ثملت وتقيأت في منزلي

223
00:13:15,480 --> 00:13:18,020
.آسفة حقًا بشأن ذلك

224
00:13:18,020 --> 00:13:19,440
!كلا، انس هذا

225
00:13:19,440 --> 00:13:21,230
.كان هذا قاسيًا من يامادا

226
00:13:21,230 --> 00:13:23,360
!يمكن لأي شخص أن يرى أن ذلك كان اعترافًا بالحب

227
00:13:24,860 --> 00:13:26,780
.كان عليك الاستماع لها

228
00:13:28,280 --> 00:13:30,830
أكانت تعترف لي بحبها؟

229
00:13:34,750 --> 00:13:38,960
ربما عليك تعلم خفايا الطبيعة الانسانية
.بدل اللعب

230
00:13:38,960 --> 00:13:40,210
.يخبرني الناس بهذا طوال الوقت

231
00:13:42,880 --> 00:13:44,920
.إذن أنت طالب في الثانوية يا يامادا

232
00:13:44,920 --> 00:13:45,760
.أجل

233
00:13:46,470 --> 00:13:50,140
بالتفكير في الأمر، كنت تشرب مشروبًا غازيًا
.طوال الوقت في إيزاكايا

234
00:13:50,140 --> 00:13:51,310
.أجل

235
00:13:51,310 --> 00:13:52,560
في أي سنة أنت؟

236
00:13:52,560 --> 00:13:53,520
.في السنة الثالثة

237
00:13:53,970 --> 00:13:56,980
.مهلًا، ذلك زيّ أكاديمية توسي

238
00:13:56,980 --> 00:13:58,770
أنت ذكي إذن يا يامادا؟

239
00:13:59,400 --> 00:14:01,320
.من الصعب ولوج تلك المدرسة

240
00:14:06,030 --> 00:14:06,860
...في الواقع

241
00:14:07,360 --> 00:14:09,950
.أردت لقاءك مجددًا

242
00:14:18,080 --> 00:14:21,840
...آسف. عثرت عليها لاحقًا، لكن

243
00:14:21,840 --> 00:14:23,090
.دُستها

244
00:14:24,130 --> 00:14:26,880
.انشطر القلب إلى نصفين

245
00:14:33,060 --> 00:14:34,810
!شكرًا على تكبدك هذه المشقة

246
00:14:35,310 --> 00:14:37,390
أكنت تحملها إذن طوال هذا الوقت؟

247
00:14:37,390 --> 00:14:39,940
،سمعت أننا نعيش قرب المحطة نفسها

248
00:14:39,940 --> 00:14:41,770
.لذا ظننت أنني سأصادفك بمكان ما

249
00:14:42,820 --> 00:14:44,780
!أظن أنه كان علي تسجيل دخولي

250
00:14:44,780 --> 00:14:46,190
!لا شك أن هذا كان مزعجًا

251
00:14:46,190 --> 00:14:47,030
.كلا

252
00:14:50,030 --> 00:14:51,240
!شكرًا لك

253
00:14:51,240 --> 00:14:54,330
،كنت أخطط لرميها على أي حال
!لذا تقلق بشأنها

254
00:14:54,330 --> 00:14:55,740
.حسنًا، سأغادر الآن

255
00:15:05,670 --> 00:15:06,510
...عذرًا

256
00:15:16,350 --> 00:15:18,350
.استخدمي هذه رجاءً

257
00:15:18,930 --> 00:15:20,690
.لا داعي لإعادتها لي

258
00:15:26,070 --> 00:15:27,940
.أستأذن إذن

259
00:15:36,660 --> 00:15:38,790
الأمطار التي بدأت البارحة في منطقة كانتو

260
00:15:38,790 --> 00:15:41,120
.ستنتقل نحو الشمال، لذا سيكون الطقس مشمسًا اليوم

261
00:15:41,120 --> 00:15:42,790
.سيكون القمر مكتملًا الليلة

262
00:15:43,920 --> 00:15:45,380
.استخدمي هذه رجاءً

263
00:15:49,050 --> 00:15:52,640
،كنت أخطط لرميها على أي حال
!لذا تقلق بشأنها

264
00:16:03,650 --> 00:16:04,980
أجل؟

265
00:16:09,530 --> 00:16:11,780
!مرحبًا! نحن من تاغاوا للنقل السريع

266
00:16:12,740 --> 00:16:14,910
!لدينا توصيل من كينوشيتا-ساما

267
00:16:15,620 --> 00:16:17,450
سندخلها فحسب، حسنًا؟

268
00:16:17,830 --> 00:16:19,450
!شكرًا على استئجارنا

269
00:16:27,590 --> 00:16:29,840
،بشأن غرفتك هنا يا أكاني

270
00:16:29,840 --> 00:16:32,550
،بما أنني أرغب في تحويلها إلى غرفة للتدريب

271
00:16:32,550 --> 00:16:36,050
تفضلي كل حاجياتك، حسنًا؟

272
00:16:36,050 --> 00:16:36,970
!شكرًا لك

273
00:16:38,970 --> 00:16:40,390
...إذن

274
00:16:40,390 --> 00:16:42,020
فيما تحتاجينني؟

275
00:16:40,850 --> 00:16:42,730
...تعلمين أنني عدت من العمل للتو

276
00:16:43,020 --> 00:16:47,060
!ساعديني يا مومو-تشان
!المكان مكتظ، لا يوجد مكان لأقف به

277
00:16:47,940 --> 00:16:51,400
،أرسلت لي أمي أغراضي فجأة
لكن هل تصدقين وجود كل هذا القدر؟

278
00:16:51,400 --> 00:16:53,030
ما الذي يفترض بي فعله؟

279
00:16:54,530 --> 00:16:56,780
.يا للإزعاج. ارمها كلها

280
00:16:58,410 --> 00:17:00,120
!بدءًا بذلك الدب الضخم

281
00:17:00,120 --> 00:17:02,910
!مهلًا! لدي ذكريات عزيزة مع ذلك الدب
!ذكريات تخص جدتي

282
00:17:02,910 --> 00:17:04,620
!ذكريات تخص جدتي -
!اخرسي -

283
00:17:05,370 --> 00:17:07,080
!جدتي -
!حسنًا، التالي

284
00:17:07,880 --> 00:17:10,000
!التالي

285
00:17:17,510 --> 00:17:18,760
!أكاني

286
00:17:19,720 --> 00:17:21,930
.تعيق هاتين الطريق فحسب

287
00:17:23,350 --> 00:17:24,890
أين تريدين وضعهما؟

288
00:17:25,140 --> 00:17:27,900
المظلة جديدة، لذا ما زلت تستخدمينها، صحيح؟

289
00:17:27,900 --> 00:17:30,770
هذه القلادة مكسورة، لذا يمكنني رميها؟

290
00:17:32,990 --> 00:17:35,280
.حاولي أن تكوني أكثر انتقائية

291
00:17:36,200 --> 00:17:38,240
.لأن مساحة المخزن محدودة

292
00:17:46,080 --> 00:17:47,710
.كوني انتقائية

293
00:17:48,540 --> 00:17:49,710
سأرمي كلتاهما

294
00:17:51,750 --> 00:17:56,720
.لا يمكنني التمسك بكل غرض عزيز علي

295
00:18:03,430 --> 00:18:07,230
.لم ترمي هذا في النهاية

296
00:18:07,230 --> 00:18:08,060
.أجل

297
00:18:09,610 --> 00:18:10,480
...لكن

298
00:18:11,270 --> 00:18:12,780
.سأرمي كل شيء آخر

299
00:18:14,150 --> 00:18:17,240
.لأنني لم أعد بحاجتها

300
00:18:23,870 --> 00:18:25,870
هوّني عليك

301
00:18:26,580 --> 00:18:30,040
حسنًا! ما رأيك بالذهاب إلى محل شواء
للاستمتاع بوقتنا؟

302
00:18:30,040 --> 00:18:31,750
!على حسابك بالطبع يا أكاني

303
00:18:31,750 --> 00:18:35,300
أعاني ضائقة مالية لذا سأطلب منك
.عدم التمادي

304
00:18:56,570 --> 00:18:57,400
أجل؟

305
00:18:57,950 --> 00:19:01,820
!أتيت لإعادة مظلتك يا يامادا

306
00:19:02,280 --> 00:19:05,540
!إنه وسيم حقًا

307
00:19:06,580 --> 00:19:08,040
!أنا مومو

308
00:19:08,750 --> 00:19:11,750
!سُررت بلقائك يا يامارا-كن

309
00:19:11,290 --> 00:19:13,540
...منزعج

310
00:19:14,040 --> 00:19:15,340
!تفضل

311
00:19:17,300 --> 00:19:20,130
أهناك ما يزعجك؟

312
00:19:20,130 --> 00:19:23,050
.كلا، الأمر فحسب... لا أعلم ما الذي علي قوله

313
00:19:23,430 --> 00:19:28,430
.آسفة لأن أكاني تتسبب لك بالمتاعب دومًا يا يامادا-كن

314
00:19:28,430 --> 00:19:32,440
...لكن يمكنك استغلال هذه الفرصة إن أردت

315
00:19:32,440 --> 00:19:35,480
!للخروج برفقتي بهدف الزواج

316
00:19:37,650 --> 00:19:39,950
.أكاد أتصل بالشرطة

317
00:19:39,950 --> 00:19:46,580
...تفوح منها رائحة الكحول

318
00:19:40,650 --> 00:19:42,870
ألم أخبرك أنه لا داعي لإعادتها؟

319
00:19:43,370 --> 00:19:44,990
.هذا مزعج حقًا

320
00:19:48,620 --> 00:19:51,080
.المظلة. صحيح، أنت محق

321
00:19:51,580 --> 00:19:52,710
...لكن بالإضافة إلى ذلك

322
00:19:54,380 --> 00:19:55,630
!أتيت لشكرك

323
00:19:57,880 --> 00:19:59,670
...يوم الفعالية

324
00:19:59,670 --> 00:20:01,630
.يسعدني أنك كنت هناك يا يامادا

325
00:20:03,470 --> 00:20:07,600
.كنت لأكون وحيدة، كان الأمر ليكون شاقًا

326
00:20:09,430 --> 00:20:10,560
...أنا حقًا

327
00:20:11,480 --> 00:20:12,650
هل أنت بخير؟

328
00:20:13,480 --> 00:20:14,690
!ممتنة لك

329
00:20:18,530 --> 00:20:19,490
.حسنًا

330
00:20:24,620 --> 00:20:27,910
!حسنًا! سنغادر قبل اتصالك بالشرطة

331
00:20:27,910 --> 00:20:28,950
.أقدر هذا

332
00:20:30,290 --> 00:20:32,920
!هيا يا مومو-تشان! سنعود إلى المنزل

333
00:20:32,920 --> 00:20:37,420
يامادا

334
00:20:34,920 --> 00:20:37,420
امشي كفتاة راشدة، حسنًا؟

335
00:20:47,260 --> 00:20:50,100
!انتبهي إلى خطواتك يا مومو-تشان

336
00:20:54,100 --> 00:20:55,270
...بالمناسبة

337
00:20:59,320 --> 00:21:00,150
...روري

338
00:21:00,940 --> 00:21:03,860
...كانت زعيمة النقابة قلقة بشأنك

339
00:21:05,110 --> 00:21:08,370
.قائلة أنك لم تسجلي دخولك منذ ذلك اليوم

340
00:21:12,790 --> 00:21:13,620
...لذا

341
00:21:14,750 --> 00:21:18,090
...إن كنت متفرغة في وقت ما

342
00:21:21,710 --> 00:21:22,840
!سأفعل ذلك

343
00:21:23,260 --> 00:21:24,340
!سأفعل ذلك على الفور

344
00:21:24,340 --> 00:21:25,970
!سأدخل فور وصولي إلى المنزل

345
00:21:25,970 --> 00:21:27,140
ماذا عنك يا يامادا؟

346
00:21:27,140 --> 00:21:28,680
.كلا، سأخلد للنوم

347
00:21:28,680 --> 00:21:29,810
ألن تلعب؟

348
00:21:29,810 --> 00:21:31,600
.سأخلد للنوم -
ألن تلعب؟ -

349
00:21:32,600 --> 00:21:34,520
.سوف... أتزوجه

350
00:23:14,740 --> 00:23:16,200
.هناك العديد منها الآن

351
00:23:15,540 --> 00:23:18,210
أُجبر على تسجيل الدخول

352
00:23:16,700 --> 00:23:18,210
ما الذي علينا فعله يا يامادا؟

353
00:23:20,120 --> 00:23:21,080
يامادا؟

354
00:23:23,750 --> 00:23:24,590
يامادا؟

355
00:23:25,250 --> 00:23:27,090
ما الخطب؟

356
00:23:27,380 --> 00:23:29,970
!يامادا

357
00:23:30,180 --> 00:23:34,470
...يامادا! يامادا! يامادا! ياما