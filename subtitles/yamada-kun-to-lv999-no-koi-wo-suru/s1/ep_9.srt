1
00:00:01,270 --> 00:00:02,980
!أهلًا بك

2
00:00:03,350 --> 00:00:06,110
ما رأيك ببعض الدجاج المقلي الساخن؟

3
00:00:06,110 --> 00:00:08,730
.ضع هاتفك هناك رجاءً

4
00:00:10,230 --> 00:00:15,360
اسحب واحدة إن تجاوزت قيمة
!!مشترياتك 700 ين

5
00:00:10,230 --> 00:00:15,360
!حسنًا يا سيدي
!اسحب تذكرة الياناصيب خاصتك

6
00:00:15,950 --> 00:00:17,320
.اسحب واحدة رجاءً

7
00:00:19,580 --> 00:00:20,490
...أيُعقل

8
00:00:20,910 --> 00:00:22,580
ستذهب إلى محل بقالة غدًا، صحيح؟

9
00:00:22,580 --> 00:00:25,580
هل أزعجتني بشدة لجعلي أقوم بهذا فحسب؟ -
!زر المحل الذي أعمل به إذن -

10
00:00:25,580 --> 00:00:28,420
لِم لا؟ إنه في طريقك إلى المنزل، صحيح؟

11
00:00:28,420 --> 00:00:31,130
وتشتري عشاءك من هنا كل يوم، أليس كذلك؟

12
00:00:31,130 --> 00:00:32,590
.أجل، أظن ذلك

13
00:00:32,970 --> 00:00:35,930
لم نرَ بعضنا منذ المهرجان. كيف حال رونا-تشان؟

14
00:00:36,340 --> 00:00:38,890
.أجل، يبدو أنها تدرس بجد

15
00:00:39,560 --> 00:00:40,640
أهذا صحيح؟

16
00:00:40,760 --> 00:00:42,350
فاز بعلبة رامين

17
00:00:40,760 --> 00:00:44,520
.تتصل بي أحيانًا لكننا بالكاد نلتقي بعضنا

18
00:00:45,940 --> 00:00:48,020
زميلة أكاني بالعمل، شينوهارا-سان"
"(ربة بيت)

19
00:00:45,940 --> 00:00:48,020
هل هو صديقك يا أكاني-تشان؟

20
00:00:48,520 --> 00:00:49,610
!شينوهارا-سان

21
00:00:49,610 --> 00:00:51,360
!يا له من فتى وسيم

22
00:00:51,360 --> 00:00:54,570
!هذا صحيح! التقينا في لعبة

23
00:00:54,570 --> 00:00:58,120
!وجهه فاتن. يبدو كالممثلين

24
00:00:58,120 --> 00:00:59,370
!تتسارع دقات قلبي

25
00:01:00,200 --> 00:01:01,490
...حسنًا، سأذهب إلى

26
00:01:01,490 --> 00:01:03,870
!ستنتهي نوبتي قريبًا لذا انتظرني

27
00:01:03,870 --> 00:01:05,040
!لنعد إلى المنزل معًا

28
00:02:37,880 --> 00:02:39,880
.انظري إليه ينتظر بوفاء

29
00:02:40,430 --> 00:02:41,970
أيُعقل أنه حبيبك؟

30
00:02:41,970 --> 00:02:46,640
كلا، كلا! يبدو أنه يواجه صعوبة
.في التعامل مع النساء، لذا فالأمر ليس كذلك

31
00:02:46,640 --> 00:02:48,020
.هذا مؤسف

32
00:02:48,020 --> 00:02:51,020
لكنكِ معجبة به يا أكاني-تشان، صحيح؟

33
00:02:51,850 --> 00:02:54,270
!كنتِ مصرّة على منعه من المغادرة

34
00:02:55,110 --> 00:03:01,780
.لا أعلم بشأن هذا-
!تحدثت كعذراء حقيقية -

35
00:03:02,320 --> 00:03:04,910
،صحيح، بالمقارنة مع أول لقاء لنا

36
00:03:04,910 --> 00:03:09,620
.يبدو أن يامادا منفتح تجاهي

37
00:03:04,910 --> 00:03:09,620
"لست مهتمًا"

38
00:03:11,040 --> 00:03:14,540
.أدرك أنه فتى لطيف

39
00:03:16,460 --> 00:03:17,380
.أحسنت عملًا

40
00:03:17,880 --> 00:03:19,300
.تخطر الفكرة ببالي

41
00:03:19,760 --> 00:03:20,670
!شكرًا لك على الانتظار

42
00:03:22,220 --> 00:03:27,560
،حتى لو مانت تربطنا لعبة فحسب
.يسرني أننا تمكنا من التقرب من بعضنا

43
00:03:29,560 --> 00:03:35,060
لكن ينطبق هذا على إيتا-كن ورونا-تشان أيضًا، صحيح؟

44
00:03:30,560 --> 00:03:35,060
!!تواجه النقابة أزمة

45
00:03:36,690 --> 00:03:39,320
.لم أطلب منك الحضور من أجل اليانصيب

46
00:03:39,780 --> 00:03:44,740
لقد حضرت لك وجبة لشكرك
.وأردت تقديمها لك

47
00:03:45,240 --> 00:03:46,160
لشكري؟

48
00:03:46,160 --> 00:03:47,160
.على إصلاح حاسوبي

49
00:03:47,580 --> 00:03:50,200
.بما أنني لم أستطع فعل أي شيء خلال المهرجان

50
00:03:50,870 --> 00:03:52,710
.لا داعي لشكري حقًا

51
00:03:53,000 --> 00:03:56,210
...بما أن أيام تقشفي قد انتهت أخيرًا

52
00:03:56,710 --> 00:03:58,420
!فستجد وليمة هناك

53
00:04:01,340 --> 00:04:03,090
...لا أعلم السبب

54
00:04:04,090 --> 00:04:07,050
...لكنني أشعر كأنه علي ألا ألتقيه

55
00:04:07,560 --> 00:04:09,100
.لقاءً رومانسيًا

56
00:04:14,980 --> 00:04:17,820
لقد عطست أمام شخص على وشك
.اجتياز اختبار الولوج

57
00:04:18,230 --> 00:04:19,320
هل أصبت بنزلة برد؟

58
00:04:19,320 --> 00:04:21,110
.لا أدري

59
00:04:21,320 --> 00:04:22,860
هل لدي كمامة هنا؟

60
00:04:35,370 --> 00:04:36,210
هل عثرت عليها؟

61
00:04:37,130 --> 00:04:37,960
.عثرت عليها

62
00:04:57,400 --> 00:04:59,230
...آمل ألا تسوء

63
00:04:59,770 --> 00:05:00,610
.نزلة البرد

64
00:05:04,820 --> 00:05:05,650
.أجل

65
00:05:07,410 --> 00:05:08,370
.شكرًا لك

66
00:05:16,080 --> 00:05:21,090
...تحديق بعيد

67
00:05:16,080 --> 00:05:21,090
،رجل لطيف على نحو عفوي
أليس هذا مرعبًا؟

68
00:05:23,760 --> 00:05:24,670
.واصلي

69
00:05:25,050 --> 00:05:26,510
،تخلي عن حذرك

70
00:05:26,510 --> 00:05:29,350
"وستقولين، "مهلًا، هل هو معجب بي؟

71
00:05:29,350 --> 00:05:32,930
.لكنه مجرد وهم وتلك ليست نية الرجل

72
00:05:32,930 --> 00:05:37,230
.إنه يُظهر طيبته فحسب. إنه فخ مرعب

73
00:05:38,150 --> 00:05:40,310
.دعيني أتأكد من أمر واحد

74
00:05:40,860 --> 00:05:43,280
لماذا أنتِ متيقنة من أنها ليست نيته؟

75
00:05:43,780 --> 00:05:46,110
تدرس فن الأظافر

76
00:05:43,780 --> 00:05:46,110
هل يمكنني تجربة شيء برّاق عليك؟

77
00:05:46,110 --> 00:05:47,450
."السمة هي "فراشة الليل

78
00:05:47,450 --> 00:05:48,570
.ماذا؟ لا تفعلي هذا رجاءً

79
00:05:48,570 --> 00:05:49,950
.سأقع في المتاعب بالعمل

80
00:05:50,990 --> 00:05:54,660
لم تذكري أي أسماء لكنك تتحدثين
عن يامادا، صحيح؟

81
00:05:55,160 --> 00:05:56,000
.أجل

82
00:05:56,000 --> 00:05:58,830
لكنك كنت سعيدة لأنه يعتبرك
!بعيدة المنال

83
00:05:58,830 --> 00:06:01,130
.لا أظنه كان يقصد شيئًا بذلك

84
00:06:02,290 --> 00:06:04,960
.هذا ما يجعل الأمر مرعبًا

85
00:06:06,590 --> 00:06:09,180
،لو أخبرني شاب وسيم أصغر سنًا

86
00:06:09,180 --> 00:06:11,510
،حتى لو لم يكن يفكر بوضوح

87
00:06:11,510 --> 00:06:14,100
.لن أضيع أي وقت في المبادرة

88
00:06:14,100 --> 00:06:16,730
.لماذا تتلعثمين وتقفزين بين الجمل

89
00:06:14,100 --> 00:06:18,850
فراشة الليل

90
00:06:16,730 --> 00:06:18,850
.لم أفعل ذلك

91
00:06:19,020 --> 00:06:23,110
.حقًا؟ يبدو لي أقصى تلعثم لك

92
00:06:23,900 --> 00:06:26,610
أرى أنك تستمتعين بالتحدث عن يامادا

93
00:06:26,610 --> 00:06:28,740
...ومحاولة فهمه

94
00:06:29,610 --> 00:06:33,200
.لكنك لم تتحدثي عما تريدين فعله

95
00:06:34,990 --> 00:06:39,460
.إن لم تخبريني بذلك فلا أستطيع التعليق

96
00:06:42,040 --> 00:06:43,540
.أنت محقة

97
00:06:44,250 --> 00:06:45,840
فراشة الليل؟ -
!أرفض ذلك -

98
00:06:45,960 --> 00:06:51,510
"ساساكي رونا"

99
00:06:45,960 --> 00:06:51,510
.إنها رونا-تشان -
.ذلك الفتاة؟ أتذكرها -

100
00:06:51,510 --> 00:06:53,010
.فتاة المتوسطة القوطية

101
00:06:53,010 --> 00:06:53,850
.هذا صحيح

102
00:06:54,260 --> 00:06:55,100
مرحبًا؟

103
00:06:55,100 --> 00:06:57,220
هل يمكننا أن نلتقي الآن يا أكاني-سان؟

104
00:06:57,220 --> 00:06:59,480
!تواجه النقابة أزمة

105
00:07:08,940 --> 00:07:10,490
!رونا-تشان

106
00:07:11,070 --> 00:07:12,320
!آسفة على التأخر

107
00:07:13,780 --> 00:07:16,790
هل أنت واثقة من أنه لا بأس
بتواجدك هنا في هذا الوقت؟

108
00:07:16,790 --> 00:07:18,540
.يكاد يحل الظلام

109
00:07:18,540 --> 00:07:20,660
.أتيت في سيارة أجرة لذا لا بأس

110
00:07:20,660 --> 00:07:22,670
.سأعود للمنزل كذلك في سيارة أجرة

111
00:07:22,790 --> 00:07:24,670
!أظن أنه لا داعي للقلق إذن

112
00:07:24,670 --> 00:07:27,090
...أنصتي، كنت برفقة يامادا هذا المساء و

113
00:07:27,090 --> 00:07:29,090
من يهتم لذلك! هل قرأتِ رسالتي؟

114
00:07:29,590 --> 00:07:30,590
.أجل

115
00:07:30,930 --> 00:07:33,760
.قرأتها. ستنضم لنا عضوة جديدة

116
00:07:34,140 --> 00:07:37,720
.فتاة أخرى لا أعرفها قد انضمت لنقابتنا

117
00:07:38,770 --> 00:07:42,650
غير معقول! اتفقنا على إبقاء الأمر بيننا
!عندما بدأنا

118
00:07:42,650 --> 00:07:44,440
،أنتِ تروقين لي الآن يا أكاني-سان

119
00:07:44,440 --> 00:07:46,770
.يا لطائفيتها -
،لكن على هذا الحال، عندما أنتهي من اختباراتي -

120
00:07:46,770 --> 00:07:48,280
!سأجد نقابة مختلفة كليًا

121
00:07:48,280 --> 00:07:49,860
!ليس هذا فحسب، بل هي فتاة

122
00:07:49,860 --> 00:07:53,360
!لا أستطيع التعامل مع الفتيات
!تكرهني الفتيات دومًا

123
00:07:53,360 --> 00:07:55,160
!لأنني ظريفة

124
00:07:53,360 --> 00:07:55,160
.أتطلع للأمر

125
00:07:55,700 --> 00:07:58,540
.آمل أن تكون فتاة دخلت عالم الألعاب حديثًا

126
00:07:58,540 --> 00:08:00,660
.اشتريت مشروب الشوكولاتة الساخن
أتريدين بعضها؟

127
00:08:00,660 --> 00:08:01,540
!أنت لا تبالين

128
00:08:00,660 --> 00:08:01,540
إنه إصدار محدود خاص بالشتاء

129
00:08:01,910 --> 00:08:03,370
"سري للغاية"

130
00:08:01,910 --> 00:08:03,370
...على أي حال

131
00:08:03,370 --> 00:08:05,710
.رسمت خطة لجعلها تغادر فورًا

132
00:08:07,630 --> 00:08:12,090
يصيب القلق اللاعبين الجدد
لذا علينا الترحيب بهم، حسنًا؟

133
00:08:14,970 --> 00:08:17,350
،وبعد أن تتعرفي عليها

134
00:08:17,350 --> 00:08:18,760
.فقد تصبحان صديقتين

135
00:08:19,270 --> 00:08:20,930
.مثلنا

136
00:08:30,360 --> 00:08:32,990
فكرة أن تصبحي صديقة شخص

137
00:08:32,990 --> 00:08:35,410
...لم تكوني لتلتقيه عادة

138
00:08:35,410 --> 00:08:36,870
أليس هذا مثيرًا نوعًا ما؟

139
00:08:38,490 --> 00:08:39,660
!هذا ما لا يروق لي

140
00:08:39,660 --> 00:08:42,410
!أعلم أنك ستتقربين منها بسرعة

141
00:08:42,620 --> 00:08:46,250
ثم ستتسكعان معًا طوال الوقت بدوني، صحيح؟

142
00:08:46,250 --> 00:08:48,960
.هذا غير صحيح. لم أتحدث إليها بعد

143
00:08:48,960 --> 00:08:50,800
!أعلم أن هذا ما سيحدث فحسب

144
00:08:50,800 --> 00:08:53,550
يمكن لثلاثتنا أن نصبح صديقات، صحيح؟

145
00:08:53,550 --> 00:08:56,300
!لا أحب الاعداد الفردية! ستُهمل إحدانا

146
00:08:57,260 --> 00:08:59,350
لننسجم معًا، حسنًا؟

147
00:09:00,390 --> 00:09:01,520
حسنًا؟

148
00:09:07,350 --> 00:09:10,360
...تجاوزي هذا بشرب الكاكاو

149
00:09:07,350 --> 00:09:10,360
.كأن لدي حبيبة غيورة

150
00:09:11,110 --> 00:09:13,320
...عرفت هذا مسبقًا

151
00:09:13,990 --> 00:09:15,650
.أنك ستقولين أمرًا مشابهًا

152
00:09:18,160 --> 00:09:22,620
،وقال أخي، :"قدم لنا يامادا هذه الفتاة

153
00:09:22,620 --> 00:09:25,160
"لذا من الأفضل أن ترحبي بها بشكل ملائم

154
00:09:25,960 --> 00:09:26,920
شكرً على الكاكاو

155
00:09:25,960 --> 00:09:26,920
أفعل يامادا هذا؟

156
00:09:26,920 --> 00:09:28,540
.سمعت أنها زميلته بالصف

157
00:09:29,040 --> 00:09:32,590
،تلعب عادة ألعاب التصويب

158
00:09:32,760 --> 00:09:35,300
لكنها تريد أخذ استراحة لتلعب
.لعبة جماعية

159
00:09:35,840 --> 00:09:39,970
يبدو أنهما مقربان لكن عندما اتصلت
...لأسأله بشأنها

160
00:09:39,970 --> 00:09:41,140
!أخبرني

161
00:09:41,140 --> 00:09:41,970
.إنها عادية

162
00:09:42,720 --> 00:09:45,600
.لم يخبرني بأي شيء

163
00:09:46,140 --> 00:09:51,070
وأخبرني أنه سيغضب إن ضايقتها
.كما فعلت معك

164
00:09:51,900 --> 00:09:54,110
حتى أنني لم أفعل
...شيئًا بعد

165
00:09:51,900 --> 00:09:54,110
صديقته؟

166
00:09:54,820 --> 00:09:58,410
هذا غير متوقع، أليس كذلك؟
إحضار يامادا لفتاة؟

167
00:09:58,910 --> 00:10:01,120
.أجل، أظن ذلك

168
00:10:01,620 --> 00:10:04,370
!لا تكثرتي! لدي فكرة رائعة

169
00:10:04,620 --> 00:10:05,790
!أعطني هاتفك

170
00:10:09,290 --> 00:10:10,420
ما الذي تفعلينه؟

171
00:10:10,420 --> 00:10:12,550
.أحفظ رقم يامادا-سان

172
00:10:12,550 --> 00:10:14,130
!اتصلي به يا أكاني-سان

173
00:10:14,710 --> 00:10:19,390
،كان يتحدث إلي بحذر لذا لم أتوصل لشيء
!لكن أراهن أنه سيخبرك

174
00:10:19,930 --> 00:10:23,930
إن عرفت رونا أي نوع من الفتيات هي
!فسأتمكن من الاسترخاء

175
00:10:26,060 --> 00:10:27,940
!سمعت أنهما خرجا في موعد بعد ذلك

176
00:10:27,940 --> 00:10:29,140
حقًا؟

177
00:10:29,140 --> 00:10:32,650
لكن ألم يقولا أنهما لا يناسبان بعضهما؟

178
00:10:32,650 --> 00:10:35,150
...مع ذلك، نحن نتحدث عن فتى وفتاة، لذا

179
00:10:35,900 --> 00:10:37,820
،حتى لو ظننت أن الأمر مستحيل

180
00:10:37,820 --> 00:10:40,990
فيمكن أن ينتهي بهما المطاف معًا
.بفضل أمر بدائي

181
00:10:45,950 --> 00:10:50,120
هل يمكن للأشخاص أن يقعوا في الحب
بسبب أمر بدائي؟

182
00:10:51,170 --> 00:10:52,960
!مرحبًا أيتها الرئيسة

183
00:10:52,960 --> 00:10:55,250
.مساء الخير يا أوكاموتو-كن ويامادا-كن

184
00:10:55,750 --> 00:10:57,720
.مرحبًا -
،أيتها الرئيسة -

185
00:10:57,720 --> 00:11:00,840
.من المضحك أن تدخلي إلى هنا تتمتمين لنفسك

186
00:11:00,840 --> 00:11:07,180
آسف بشأن ذلك

187
00:11:00,840 --> 00:11:07,180
.ماذا؟ كنت أسألكما -
...حبيبان؟ الأمر هو

188
00:11:07,350 --> 00:11:10,060
عدة سنوات بدون حبيبة = حياتهما بأكملها

189
00:11:07,350 --> 00:11:10,060
.لا أظن أنه يجدر بك طرح هذا السؤال علينا

190
00:11:10,060 --> 00:11:11,270
عدة سنوات بدون حبيبة = حياتهما بأكملها
الهواية = ألعاب الفيديو

191
00:11:11,650 --> 00:11:15,190
وشكرًا على السماح لي بالانضمام
...إلى نقابتكم يا يامادا-كن

192
00:11:15,520 --> 00:11:17,280
.بتحدثك إلى زعيم النقابة

193
00:11:17,610 --> 00:11:18,440
.أجل

194
00:11:18,940 --> 00:11:20,110
عما يدور هذا؟

195
00:11:20,110 --> 00:11:21,030
.الألعاب

196
00:11:21,530 --> 00:11:22,410
فوس"؟"

197
00:11:22,910 --> 00:11:24,830
،بدأت لعبها للتو

198
00:11:24,830 --> 00:11:27,660
وسمعت أنه من الأفضل أن تنضم
.لاحدى أقوى النقابات

199
00:11:28,160 --> 00:11:30,080
هل أستطيع تناول البورغر؟

200
00:11:28,160 --> 00:11:30,080
،لذا طلبت من يامادا السماح لي بالانضمام إلى نقابته

201
00:11:30,580 --> 00:11:32,580
لكن تكاد الحصة تبدأ

202
00:11:30,580 --> 00:11:32,580
أنتِ تلعبين بشكل سري أيتها الرئيسة، صحيح؟

203
00:11:32,880 --> 00:11:34,920
،ليس كأنني أخفي الأمر

204
00:11:34,920 --> 00:11:37,840
.لكنني لا أستطيع التحدث به مع بقية الفتيات

205
00:11:37,840 --> 00:11:39,300
.معظم الحديث متعلق بأمور الفتيات عمومًا

206
00:11:40,420 --> 00:11:42,760
أيروق لك حديث الفتيات أيتها الرئيسة؟

207
00:11:43,640 --> 00:11:44,510
.كلا

208
00:11:46,890 --> 00:11:50,270
.إذن فقد ضحيتِ بشبابك للعب أيضًا

209
00:11:59,990 --> 00:12:02,950
يرن بشدة

210
00:11:59,990 --> 00:12:02,950
ألن تجيب؟ -
.إنه رقم مجهول -

211
00:12:02,950 --> 00:12:06,080
.وتكاد الحصة تبدأ

212
00:12:06,080 --> 00:12:08,080
.لقد توقف

213
00:12:08,490 --> 00:12:12,040
.يبدو أنك تتوصل بالكثير من هذه الاتصالات يا يامادا

214
00:12:12,040 --> 00:12:15,210
لا تحدث أمور كهذه

215
00:12:12,040 --> 00:12:15,210
وعندما تجيب، تجد أنها فتاة
!لا تعرفها تعترف بحبها لك

216
00:12:16,000 --> 00:12:17,710
...إن أردت، يمكنك الحصول على أي

217
00:12:17,710 --> 00:12:18,710
...يامادا-كن

218
00:12:20,090 --> 00:12:22,590
لا يكترث بالرومانسية، أليس كذلك؟

219
00:12:22,720 --> 00:12:24,130
أفزعتني
يا له من صوت مرتفع

220
00:12:24,640 --> 00:12:26,760
.هذا صحيح

221
00:12:33,440 --> 00:12:34,520
.كما ظننت

222
00:12:37,520 --> 00:12:38,980
!أنا جائع

223
00:12:39,400 --> 00:12:40,900
!لم يعد بوسعي التحمل، سأموت

224
00:12:41,400 --> 00:12:43,610
ألم تأكل هامبرغر للتو؟

225
00:12:43,610 --> 00:12:45,570
.كم أودّ تناول الهامبرغر الآن

226
00:12:45,570 --> 00:12:46,410
مجددًا؟

227
00:12:46,660 --> 00:12:49,080
صحيح، سأحصل على بطاطس مقلية
!هذه المرة

228
00:12:51,540 --> 00:12:53,500
هل تنصت؟

229
00:12:53,500 --> 00:12:54,420
.هاتفي

230
00:12:54,420 --> 00:12:56,290
نفس الشخص الذي اتصل من قبل؟

231
00:12:57,080 --> 00:13:00,460
إن كانت فتاة ذات صوت حسن
فناولني الهاتف، حسنًا؟

232
00:13:01,300 --> 00:13:02,590
هل تتجاهلني؟

233
00:13:06,050 --> 00:13:07,050
يامادا أكيتو
اتصال وارد

234
00:13:07,390 --> 00:13:08,800
!أنا قادمة

235
00:13:11,850 --> 00:13:12,680
أجل؟

236
00:13:12,680 --> 00:13:14,390
.عذرًا. لقد اتصلت بي للتو

237
00:13:14,390 --> 00:13:15,440
يامادا؟

238
00:13:16,560 --> 00:13:18,230
!هذه أنا، أكاني

239
00:13:19,520 --> 00:13:20,480
أكاني-سان؟

240
00:13:20,650 --> 00:13:21,730
.عرفت أنها فتاة

241
00:13:22,230 --> 00:13:24,240
...مهلًا، هل أعطيتك رقم

242
00:13:24,240 --> 00:13:26,860
!أعلم. آسفة على اتصالي المفاجئ

243
00:13:27,360 --> 00:13:30,410
...الأمر أن رونا-تشان هذا المساء

244
00:13:32,450 --> 00:13:33,660
هل انت بخير؟

245
00:13:33,660 --> 00:13:37,500
،أجل. عمومًا، أردت أن أسألك عن أمر ما

246
00:13:37,500 --> 00:13:40,420
.لكن علي الذهاب إلى العمل الآن

247
00:13:40,460 --> 00:13:42,460
!أهلًا لك

248
00:13:40,460 --> 00:13:42,460
.ماذا؟ لكنك عملتِ هذا المساء

249
00:13:42,710 --> 00:13:46,300
لا يستطع مديري التواصل مع
...صاحب النوبة الليلية

250
00:13:46,800 --> 00:13:49,090
.لذا اتصل بي فجأة

251
00:13:49,090 --> 00:13:51,100
ألا يستطيع شخص ما أن يحل محلك؟

252
00:13:51,100 --> 00:13:52,470
.يبدو أنه لا أحد متفرغ

253
00:13:53,680 --> 00:13:56,980
بما أنني أسكن بمكان قريب
!فأظن أنه لا يجد حرجًا في استدعائي

254
00:13:56,980 --> 00:13:57,980
أهذا صحيح؟

255
00:13:59,650 --> 00:14:01,150
.يامادا

256
00:14:01,150 --> 00:14:02,230
أجل؟

257
00:14:03,070 --> 00:14:05,110
.صوتك منخفض قليلًا في الهاتف

258
00:14:05,990 --> 00:14:06,900
!لا تهتم

259
00:14:11,580 --> 00:14:14,450
هل الفتاة التي أتت إلى المهرجان
هي التي اتصلت بك؟

260
00:14:15,200 --> 00:14:20,080
مذهل

261
00:14:15,200 --> 00:14:20,080
كيف عرفتِ ذلك؟ -
.لأنني سمعتك تدعوها باسمها -

262
00:14:20,540 --> 00:14:23,090
،نحن زملاء في النقابة داخل اللعبة

263
00:14:23,090 --> 00:14:26,130
لذا ستتسكعين برفقتها أيضًا
.عاجلًا أو آجلًا

264
00:14:26,130 --> 00:14:27,170
.فهمت

265
00:14:28,430 --> 00:14:31,050
.تبدون مقربين في الواقع أيضًا

266
00:14:31,050 --> 00:14:32,050
.أظن ذلك

267
00:14:32,680 --> 00:14:35,270
كان زعيم النقابة طالبًا أكبر سنًا مني
.في مكان نشأتي

268
00:14:36,230 --> 00:14:37,100
...لا أستطيع

269
00:14:37,890 --> 00:14:39,230
.تذكر ملامحها

270
00:14:41,400 --> 00:14:42,360
كيف هي طباعها؟

271
00:14:43,270 --> 00:14:45,400
أتقصدين الزعيم؟

272
00:14:45,400 --> 00:14:47,570
.كلا، أقصد الفتاة التي تدعى أكاني

273
00:14:48,740 --> 00:14:50,280
...أكاني

274
00:14:53,370 --> 00:14:56,870
!هذا حبيبي الجديد -
أيُعقل أننا أقمنا علاقة عابرة؟ -
!يامارا -

275
00:14:56,870 --> 00:14:59,710
تعلو وجهها
تعابير غريبة دومًا

276
00:15:02,290 --> 00:15:03,130
!يامادا

277
00:15:08,800 --> 00:15:10,890
.لا أدري حقًا

278
00:15:14,810 --> 00:15:15,640
...أيُعقل

279
00:15:18,140 --> 00:15:18,980
أنك معجب بها؟

280
00:15:27,110 --> 00:15:30,910
!آسف يا أكاني-تشان، أنا مدين لك

281
00:15:31,320 --> 00:15:33,450
،لم أستطع التواصل مع عامل النوبة الليلية

282
00:15:33,450 --> 00:15:35,580
.ولا أستطيع تولي الأمر بمفردي

283
00:15:35,580 --> 00:15:39,540
ألم يحن وقت طردك لذلك المتشرد؟

284
00:15:39,870 --> 00:15:41,670
أنا حاقدة بشدة

285
00:15:39,870 --> 00:15:41,670
!أنت محقة على ما أظن

286
00:15:41,670 --> 00:15:45,040
...لكنه ليس شخصًا سيئًا! يحب الغيتار

287
00:15:45,040 --> 00:15:47,550
!سأدعوكِ للعشاء لتعويضك عن هذا

288
00:15:47,760 --> 00:15:49,510
ما رأيك بليلة الغد؟

289
00:15:49,510 --> 00:15:51,180
...أعرف مكانًا -
!لن أذهب -

290
00:15:51,180 --> 00:15:52,050
"سأتناول العشاء بالمنزل"

291
00:15:55,970 --> 00:15:59,770
أردت الخلود للفراش بما أنني
.مصابة بنزلة برد

292
00:16:08,730 --> 00:16:09,990
سجل الاتصالات

293
00:16:11,400 --> 00:16:13,990
يبدو غريبًا وجود اسم يامادا
!في سجل اتصالاتي

294
00:16:15,410 --> 00:16:16,950
!حسنًا، لنبدأ العمل

295
00:16:29,880 --> 00:16:33,470
لا تخبريني بأي شيء عما تودّين
.فعله يا أكاني

296
00:16:34,050 --> 00:16:35,930
!أكاني-تشان

297
00:16:36,220 --> 00:16:37,220
!أنا قادمة

298
00:16:37,220 --> 00:16:38,680
!هذا سيء، هذا سيء

299
00:16:47,440 --> 00:16:49,360
هل تودين الدخول إلى خادم آريا 5؟

300
00:16:47,440 --> 00:16:49,360
نعم                    لا

301
00:16:54,070 --> 00:16:56,740
لقد دُعيت من طرف
اللاعب روريهيمي
للانضمام إلى نقابة
أرنب الشوكولاتة

302
00:16:54,070 --> 00:16:56,740
هل تودين الانضمام؟

303
00:16:54,070 --> 00:16:56,740
نعم                             لا

304
00:17:09,920 --> 00:17:13,720
...ليس كأنني ما زلت أكن له المشاعر

305
00:17:14,880 --> 00:17:16,680
...لكن الآن، ربما قليلًا فحسب

306
00:17:18,350 --> 00:17:19,720
.آسف يا أكاني

307
00:17:22,640 --> 00:17:24,890
.أنا نادمة على بعض الأمور

308
00:17:28,230 --> 00:17:30,650
!إنها أكاني-سان

309
00:17:32,860 --> 00:17:34,990
أنا متعبة
للغاية

310
00:17:32,860 --> 00:17:34,990
هل يمكنني الرد؟ -
.تفضلي -

311
00:17:36,360 --> 00:17:39,990
ما الأمر يا أكاني-سان؟
!أنا في حصة دراسية

312
00:17:41,330 --> 00:17:42,500
.رو... نا

313
00:17:42,500 --> 00:17:44,870
مثل الزومبي

314
00:17:42,500 --> 00:17:44,870
!ما خطب صوتك؟ يبدو سيئًا

315
00:17:45,210 --> 00:17:48,670
نزلة برد؟ لا تستطيعين اللعب برفقتي الليلة إذن؟

316
00:17:49,500 --> 00:17:51,050
.فهمت

317
00:17:51,750 --> 00:17:54,760
كلا، كلا، لا بأس. ما باليد حيلة، صحيح؟

318
00:17:55,590 --> 00:17:57,130
.اعتني بنفسك

319
00:18:00,260 --> 00:18:02,260
وعدنا بعضنا
...باللعب معًا ليلًا

320
00:18:00,260 --> 00:18:02,260
.قالت أكاني-سان أنها مصابة بنزلة برد

321
00:18:02,890 --> 00:18:04,890
.بدا صوتها كأنها تحتضر

322
00:18:04,890 --> 00:18:06,560
أتساءل إن كانت بخير؟

323
00:18:06,890 --> 00:18:09,270
.آمل ألا تكون حالتها خطيرة

324
00:18:10,820 --> 00:18:14,820
"ضمادات باردة"

325
00:18:37,630 --> 00:18:39,470
.يؤلمني حلقي بشدة

326
00:18:39,470 --> 00:18:41,350
.لا أستطيع شرب الماء

327
00:18:42,140 --> 00:18:43,930
.علي تناول الدواء

328
00:18:44,680 --> 00:18:48,690
مريضة بشدة

329
00:18:44,680 --> 00:18:48,690
.يجب أن آكل شيئًا ما أولًا

330
00:18:49,400 --> 00:18:51,770
.لم آكل منذ البارحة

331
00:18:55,570 --> 00:18:57,950
.سأستريح قليلًا

332
00:18:57,950 --> 00:19:01,200
استراحة قصيرة

333
00:18:57,950 --> 00:19:01,200
.أنا مرهقة

334
00:19:01,780 --> 00:19:06,450
ليس هذا فحسب، بل اخترت الوقت المثالي
...بطريقة ما... لأكون

335
00:19:03,870 --> 00:19:05,080
مغلق
السبت / الأحد

336
00:19:06,450 --> 00:19:09,580
...لا يمكن ربط الاتصال بالرقم الذي طلبته -
.حظ سيء للغاية -

337
00:19:06,790 --> 00:19:09,580
مومو

338
00:19:10,370 --> 00:19:11,290
...لكن

339
00:19:11,790 --> 00:19:15,420
.لن يساعدني أحد حتى لو انتحبت

340
00:19:16,380 --> 00:19:19,930
.لذا ينتظرني الموت فحسب إن لم أفعل شيئًا

341
00:19:21,640 --> 00:19:23,140
.عليك الأكل أولًا

342
00:19:23,640 --> 00:19:25,310
...شيء مثل عصيدة الأرز

343
00:19:27,140 --> 00:19:28,270
.التسوق

344
00:19:29,060 --> 00:19:30,690
.لقد نفد الأرز

345
00:19:37,150 --> 00:19:39,990
.لن أستقل الحافلة كيلا أنشر العدوى

346
00:19:40,950 --> 00:19:42,450
.صحيح، سأستقل الدراجة

347
00:19:44,030 --> 00:19:47,120
.أحسنتِ. ما زلتِ ذكية

348
00:19:48,700 --> 00:19:52,670
.علي التحلي بالعزيمة لتجاوز الليلة

349
00:20:12,190 --> 00:20:13,850
.لا أستطيع الذهاب بالدراجة

350
00:20:14,360 --> 00:20:16,110
.لا أستطيع حتمًا

351
00:20:16,520 --> 00:20:18,110
.حرارتي مرتفعة

352
00:20:18,780 --> 00:20:20,990
ألا أستطيع طلب الطعام؟

353
00:20:21,490 --> 00:20:23,700
لماذا لم أفكر بهذا؟

354
00:20:23,700 --> 00:20:26,080
.صحيح، سيفي طلب الطعام بالغرض

355
00:20:26,660 --> 00:20:27,910
!فتاة ذكية

356
00:20:28,410 --> 00:20:32,000
.علي أولًا إعادة الدراجات إلى مكانها

357
00:20:33,250 --> 00:20:36,250
.ثم سأعود إلى شقتي

358
00:20:37,840 --> 00:20:39,710
ثم ما الذي علي فعله؟

359
00:20:42,170 --> 00:20:43,550
.أشعر بالصداع

360
00:20:57,190 --> 00:20:58,190
أكاني-سان؟

361
00:21:02,240 --> 00:21:03,280
ما الأمر؟

362
00:21:03,780 --> 00:21:05,660
.يمكنني رؤية شخص شبيه بيامادا

363
00:21:08,120 --> 00:21:11,620
لكن يستحيل أن يكون قرب منزلي، صحيح؟

364
00:21:12,620 --> 00:21:13,620
هل يمكنك سماعي؟

365
00:21:15,830 --> 00:21:18,920
.أهو حلم؟ كلا

366
00:21:20,840 --> 00:21:23,590
هل أصبح يظهر في أحلامي أيضًا؟

367
00:21:26,470 --> 00:21:27,890
.آسفة يا يامادا

368
00:21:29,050 --> 00:21:31,770
...لرؤيتي لحلم يخدم مصلحتي

369
00:23:06,570 --> 00:23:10,360
...فراشة

370
00:23:11,030 --> 00:23:13,120
...تعال وألق ضوءك

371
00:23:13,280 --> 00:23:14,870
!علي

372
00:23:15,330 --> 00:23:17,370
.فراشة الليل، مايدا موموكو

373
00:23:17,370 --> 00:23:19,580
سأقبض على الأمير الليلة حتمًا

374
00:23:19,580 --> 00:23:20,420
...مُقدر لي أن

375
00:23:21,130 --> 00:23:24,090
فتاة ترتدي نظارة

376
00:23:21,130 --> 00:23:24,090
من النوع المُطمئن

377
00:23:24,090 --> 00:23:27,050
هزيمة كارثية لفراشة الليل

378
00:23:31,050 --> 00:23:35,010
عذرًا؟ هل لي بكأس آخر؟
.مع شراب جِن إضافي

379
00:23:32,510 --> 00:23:35,010
أكاني

380
00:23:35,310 --> 00:23:37,470
.مومو لا تجيب