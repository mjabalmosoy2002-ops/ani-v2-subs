1
00:00:10,300 --> 00:00:13,210
كان لديك الكثير من الأعمال الإداريّة اليوم

2
00:00:16,110 --> 00:00:19,090
غرانتز. سأعدُّ بعض الشّاي

3
00:00:20,290 --> 00:00:22,530
سيكون من دواعي سروري
مُشاركة جلالتك

4
00:00:23,240 --> 00:00:24,740
لا تكُن رسميّاً هكذا

5
00:00:24,740 --> 00:00:26,710
لسنا ملِكاً ورئيس وزراء هنا

6
00:00:27,150 --> 00:00:29,420
أريد فقط أن نتحدّث كصديقين الآن

7
00:00:30,910 --> 00:00:33,000
عُلِم يا أورفانس

8
00:00:38,110 --> 00:00:41,430
هل أنت ممتعض بشأن الأميرة أنيسفيا ثانية؟

9
00:00:41,430 --> 00:00:43,900
!أنا مُمتعض منها على الدّوام

10
00:00:48,240 --> 00:00:51,810
،إنّها أكبر بعامين من ابنتك يوفيليا

11
00:00:51,810 --> 00:00:55,030
ومع ذلك تلك المعتوهة لا تُظهِر
أي مؤشّرات للاستقرار

12
00:00:55,430 --> 00:00:59,230
إذا استقرّتْ، فلن تكون الأميرة أنيسفيا بعدها

13
00:00:59,740 --> 00:01:03,110
يحقّق بحثها حول علم السّحر بعض النّتائج، صحيح؟

14
00:01:03,110 --> 00:01:07,460
المُشكلة هي أنّها تمتلك موهبة كبيرة جدّاً
في إحداث المشاكل خارج إطار بحثها

15
00:01:08,140 --> 00:01:10,180
يعزو ذلك لانشغال الآباء في العمل

16
00:01:11,330 --> 00:01:15,380
يبدو أنّه حتّى ابني قد أصبح مُعضلة مؤخّراً

17
00:01:17,710 --> 00:01:19,850
تقصد مسألة ابنة البارون شيان؟

18
00:01:21,070 --> 00:01:22,840
...أجل. ذلك الأحمق آلغارد

19
00:01:23,960 --> 00:01:27,230
لا يفقه شيئاً عن المعايير الّتي
ينبغي له اتّباعها كملِك مُستقبلي

20
00:01:27,840 --> 00:01:30,310
أمسى يتصرّف بجسارة كبيرة فعلاً

21
00:01:32,970 --> 00:01:34,760
أنا آسف يا غرانتز

22
00:01:34,760 --> 00:01:38,090
أعلم بأنّ العائلة الملكيّة فرضَتْ
هذه الخطوبة عليكم

23
00:01:38,090 --> 00:01:41,750
من واجب يوفيليا أن تكسب قلب خطيبها

24
00:01:42,270 --> 00:01:45,200
ينبغي أن تكون هذه تجربة سعيدة
بالنسبة لها كملِكة مُستقبليّة

25
00:01:45,200 --> 00:01:47,500
يا لك من فيلسوف

26
00:01:47,500 --> 00:01:48,010
—لكن

27
00:01:49,560 --> 00:01:50,840
!أبي

28
00:01:51,100 --> 00:01:53,290
عسى أن تكون بأتمّ صحّة وعافية

29
00:01:53,620 --> 00:01:55,250
...أنا، أنيسفيا

30
00:01:55,630 --> 00:01:58,460
!أخذتُ الآنسة يوفيليا بعيداً

31
00:03:34,930 --> 00:03:39,350
!ما خطبكِ؟

32
00:03:39,650 --> 00:03:42,830
...أرجوك... دعني أشرح مُبرّري

33
00:03:42,830 --> 00:03:46,790
!مُبرّركِ؟! هل هناك عذر لاختطاف شخص؟

34
00:03:46,790 --> 00:03:49,390
،كنتُ أختبر الطّيران بمِكنسة السّاحرة خاصّتي

35
00:03:53,760 --> 00:03:56,470
!وها هي ذي مُشكلة أخرى سبّبتِها

36
00:03:56,470 --> 00:03:58,410
!أيّتها الابنة الحمقاء

37
00:03:58,720 --> 00:04:03,340
ثمّ قال آل بأنّه سيفسخ خطوبته
من الآنسة يوفيليا

38
00:04:05,300 --> 00:04:06,080
ماذا؟

39
00:04:06,580 --> 00:04:08,060
فسخَ الخطوبة

40
00:04:08,350 --> 00:04:11,080
خطوبته... مِمَّن؟

41
00:04:11,080 --> 00:04:13,240
آل والآنسة يوفيليا

42
00:04:18,010 --> 00:04:19,300
هذا صحيح

43
00:04:19,690 --> 00:04:22,510
أنا آسفة حقّاً

44
00:04:28,600 --> 00:04:33,210
...في وسط سهرة... أمام كلّ أولئك النّاس

45
00:04:33,850 --> 00:04:35,950
...ومن بين كلّ الأوقات

46
00:04:36,340 --> 00:04:38,030
!آلغارد

47
00:04:38,030 --> 00:04:40,500
!ما الّذي كنتَ تفكّر فيه بالتّحديد؟

48
00:04:45,850 --> 00:04:47,020
...آنسة يوفيليا

49
00:04:49,260 --> 00:04:53,970
أنا آسف يا غرانتز. يبدو أنّ حُكمي لم يكُن سديداً

50
00:04:54,520 --> 00:04:55,520
لا عليك

51
00:04:56,310 --> 00:04:57,430
يوفيليا

52
00:04:58,910 --> 00:05:02,900
سمعتُ بأنّكِ والأمير لم تتقرّبا من بعضكما

53
00:05:03,810 --> 00:05:04,980
أجل

54
00:05:05,340 --> 00:05:09,420
من المؤسف أن ينتهي الأمر هكذا

55
00:05:09,990 --> 00:05:12,880
أنا... آسفة جدّاً

56
00:05:12,880 --> 00:05:14,830
لا داعي للاعتذار

57
00:05:14,830 --> 00:05:19,280
ما تحتاجين التّفكير فيه الآن هو
ما سوف تفعلينه من الآن فصاعداً

58
00:05:20,280 --> 00:05:22,250
ماذا ستكون عقوبتي؟

59
00:05:25,640 --> 00:05:28,430
ما تفعله يوفيليا من هنا؟

60
00:05:29,630 --> 00:05:31,350
!وجدتُها يا أبي

61
00:05:31,350 --> 00:05:33,910
!وجدتُ الفكرة السّديدة الّتي أتيتُ لمُشاركتها معك

62
00:05:34,300 --> 00:05:36,760
أتقولين فكرة سديدة؟

63
00:05:37,920 --> 00:05:39,720
...أبي، الدّوق غرانتز

64
00:05:41,160 --> 00:05:44,070
!من فضلكما امنحاني الآنسة يوفيليا

65
00:05:46,780 --> 00:05:49,730
!سأبذل كلّ طاقتي لإسعادها

66
00:05:51,830 --> 00:05:52,710
...لـ

67
00:05:52,710 --> 00:05:55,150
!لحظة، لحظة، لحظة، لحظة

68
00:05:55,150 --> 00:05:58,120
!أيّ نكتة سخيفة هي هذه؟

69
00:05:58,480 --> 00:06:00,830
أنا جادّة تماماً يا أبي

70
00:06:00,830 --> 00:06:03,390
!جدّيتكِ تُخيفني أكثر حتّى

71
00:06:03,390 --> 00:06:05,290
أين المُشكلة في ذلك؟

72
00:06:05,290 --> 00:06:07,770
!أنتِ المُشكلة هنا

73
00:06:10,050 --> 00:06:11,440
...ما أعنيه هو

74
00:06:11,820 --> 00:06:14,890
!أريد التّرحيب بالآنسة يوفيليا كمُساعدة لي

75
00:06:15,240 --> 00:06:18,090
أنا... مُساعدتكِ؟

76
00:06:20,410 --> 00:06:22,430
...ظـ-ظريفة للغاية

77
00:06:22,430 --> 00:06:26,530
!لا بدَّ أنّ عينَي الجرو هاتين سِحرٌ قائمٌ بذاته

78
00:06:26,800 --> 00:06:29,450
!مجرّد وجودها طاغٍ

79
00:06:36,960 --> 00:06:41,220
،ا-المشكلة هنا ليست الخطوبة الّتي فُسِخت

80
00:06:41,220 --> 00:06:43,220
بل لأنّها أعلنها أمام العامّة

81
00:06:43,540 --> 00:06:44,640
صحيح؟

82
00:06:45,140 --> 00:06:46,360
...أجل

83
00:06:46,360 --> 00:06:50,040
،بما أنّ كثيراً من النّاس سمعوا ذلك
لا يمكننا الرّجوع عنها

84
00:06:50,040 --> 00:06:54,530
إذا أردت ترتيب خطوبة لآنسة تمّ
،رفضها بواسطة الطبقة الملكيّة

85
00:06:54,530 --> 00:06:56,400
فإنّ خياراتك للشّركاء المُحتملين محدودة

86
00:06:56,660 --> 00:06:58,920
،وفتاة مُتألّقة مثل يوفيليا

87
00:06:58,920 --> 00:07:02,340
لا يمكنني تسليمها اعتباطيّاً لدولة أجنبيّة

88
00:07:02,980 --> 00:07:05,060
...فأساساً، الآنسة يوفيليا

89
00:07:05,060 --> 00:07:07,650
!محبوبة بواسطة الأرواح

90
00:07:07,650 --> 00:07:12,120
يُقال بأنّها تمتلك خصائصَ سحريّة
أكثر من أيّ شخص في التّاريخ

91
00:07:14,150 --> 00:07:18,140
وهي بارعة في آداب السّلوك
!والفنون القتاليّة! إنّها عبقريّة

92
00:07:18,140 --> 00:07:20,550
!إنّها كنز مملكة باليتّيا

93
00:07:21,610 --> 00:07:23,050
!إنّها الأفضل على الإطلاق

94
00:07:24,530 --> 00:07:25,880
...وفوق كلّ شيء

95
00:07:26,460 --> 00:07:28,430
!إنّها حسناء وظريفة

96
00:07:33,460 --> 00:07:39,300
غير أنّ هذه المسألة تركَتْ لطخة
في حياتها كآنسة نبيلة

97
00:07:46,310 --> 00:07:49,570
إذاً عندما تقولين بأنّكِ تُريدينها مُساعدة
لكِ، تقصدين في علم السّحر؟

98
00:07:50,710 --> 00:07:53,510
،دراسة العلم السّحري الّتي أتبنّاها

99
00:07:54,750 --> 00:07:58,540
علم السّحر" ستحقّق برأيي تكنولوجيا جديدة"

100
00:07:59,080 --> 00:08:00,260
...حسناً

101
00:08:00,840 --> 00:08:04,780
هذا بحث تقدُّمي ومليء بالإمكانيات المجهولة بالفعل

102
00:08:05,280 --> 00:08:06,360
!تماماً

103
00:08:06,970 --> 00:08:08,950
،إذا تمّت مُشاركته مع العامّة

104
00:08:08,950 --> 00:08:11,880
فقد يؤثّر ذلك وبشكل كبير على المملكة بأسرِها

105
00:08:12,800 --> 00:08:16,840
لكنّك أحجمت عن الإعلان عنه أمام العوام

106
00:08:16,840 --> 00:08:19,480
لا أحبّ الشّهرة كثيراً

107
00:08:19,480 --> 00:08:22,070
كلّ ما أريده هو أن أغمس نفسي في بحثي

108
00:08:22,610 --> 00:08:24,510
،فهمت. بعبارة أخرى

109
00:08:24,990 --> 00:08:26,980
...تريدين من إنجازاتكِ في علم السّحر أن تكون

110
00:08:28,950 --> 00:08:31,540
!تماماً يا حضرة الدّوق غرانتز

111
00:08:31,540 --> 00:08:35,480
لمَ لا ندع الآنسة يوفيليا تُعلِن
عن نتائج بحثنا المُشترك

112
00:08:35,480 --> 00:08:37,910
لاستعادة سمعتها المُتضرِّرة؟

113
00:08:37,910 --> 00:08:39,860
!أ-أنا؟

114
00:08:40,480 --> 00:08:41,750
بوسعِ هذا على الأقلّ

115
00:08:41,750 --> 00:08:45,090
أن يمنح النّاس شيئاً يتحدّثون عنه
غير الخطوبة المفسوخة

116
00:08:45,090 --> 00:08:46,540
!صحيح؟

117
00:08:48,970 --> 00:08:51,510
لكن... أن أعمل مُساعدة لكِ...؟

118
00:08:51,510 --> 00:08:55,480
سأكسب الكثير من هذه الاتّفاقيّة أيضاً

119
00:08:57,170 --> 00:08:58,900
،بوضعي الحالي

120
00:08:58,900 --> 00:09:02,390
سُمعتي سيّئة جدّاً لدرجة أنّني
لا أستطيع توظيف مُساعدة ماهرة

121
00:09:03,340 --> 00:09:04,840
...لكن هذا

122
00:09:05,210 --> 00:09:08,010
،لكنّكِ موهوبة جدّاً

123
00:09:08,010 --> 00:09:10,810
وستكونين الخيار المثاليّ للترويج
لعلم السّحر للنّاس

124
00:09:10,810 --> 00:09:15,270
لكن ألن أخطف مجد إنجازاتكِ في هذه الحالة؟

125
00:09:15,960 --> 00:09:16,990
لا

126
00:09:17,420 --> 00:09:19,960
!أنا أفعل ذلك بداعي الحبّ فقط

127
00:09:20,870 --> 00:09:23,080
تقصدين لأجل علم السّحر؟

128
00:09:23,080 --> 00:09:23,840
!أجل

129
00:09:24,410 --> 00:09:26,620
سيغيّر العالم الّذي نعيش فيه

130
00:09:26,620 --> 00:09:29,550
!إنّها تكنولوجيا جديدة مليئة بالأحلام والرّومانسيّة

131
00:09:32,640 --> 00:09:38,170
وإن أمكن، أريدكِ أن تقعي في الحبّ
أيضاً يا آنسة يوفيليا

132
00:09:39,330 --> 00:09:42,020
!تـ-تقصدين حبّ علم السّحر، صحيح؟

133
00:09:43,640 --> 00:09:49,020
هل تتذكّرين ما قلتِه لي ذات مرّة؟

134
00:09:49,320 --> 00:09:53,740
تقصد ما قالَتْه عندما تنازلَتْ عن حقّها بالعرش؟

135
00:09:54,140 --> 00:09:55,810
أبي؟

136
00:09:56,120 --> 00:10:00,090
...منذ مدّة طويلة، قالت الأميرة أنيسفيا

137
00:10:00,840 --> 00:10:02,150
!أبي

138
00:10:02,580 --> 00:10:04,540
ما الأمر؟

139
00:10:04,780 --> 00:10:07,320
!لا أريد أن أتزوّج رجلاً

140
00:10:07,320 --> 00:10:08,550
،إذا وقعتُ في الحبّ

141
00:10:08,550 --> 00:10:11,750
!فأريد أن يكون ذلك مع امرأة

142
00:10:12,150 --> 00:10:13,970
هل تختلقين مجرّد أعذار

143
00:10:13,970 --> 00:10:17,930
لتُخفي رغبتكِ الحقيقيّة وهي
جعل يوفيليا مُلككِ فحسب؟

144
00:10:21,610 --> 00:10:25,510
...هـ-هذا ليس... خطأ تماماً، لكن... أقصد

145
00:10:25,510 --> 00:10:27,600
...لا أريد أن أصبح حبلى بالخطأ أو ما شابه

146
00:10:29,430 --> 00:10:33,190
!ما مُشكلتكِ؟

147
00:10:33,190 --> 00:10:37,140
كيف تجرئين على الحديث عن واجب
!ملكيّ مهمّ كهذا بهذه الطريقة؟

148
00:10:37,440 --> 00:10:39,500
!مؤلم! مؤلم! مؤلم

149
00:10:39,500 --> 00:10:43,100
!ستسحق رأس أميرتك العزيزة

150
00:10:42,110 --> 00:10:46,080
!كي يُطابِق ميولكِ المُشوّه بشكل مثاليّ

151
00:10:46,410 --> 00:10:50,900
ما الفائدة من وِراثة جيناتي بينما
!لا أستطيع حتّى استخدام السّحر

152
00:10:50,040 --> 00:10:51,970
!المسألة لا تتعلّق بالفائدة

153
00:10:51,970 --> 00:10:55,180
!ألا تفهمين رغبة الأب في رؤية حفيده؟

154
00:10:55,180 --> 00:10:56,710
!أشعر بالبؤس لدرجة أكاد أبكي

155
00:10:56,710 --> 00:11:00,420
!حسناً، أنا أبكي! أنفجر بُكاء كطفل رضيع

156
00:11:00,420 --> 00:11:02,730
!لم تذرفي دمعة واحدة

157
00:11:00,800 --> 00:11:03,860
!هل يمكننا الافتراض بأنّني فهمتُ الآن؟

158
00:11:05,530 --> 00:11:08,100
أهكذا ينبغي أن تكون علاقة الأب وابنته؟

159
00:11:09,250 --> 00:11:10,560
أبي؟

160
00:11:32,430 --> 00:11:34,540
أنا آسف يا يوفيليا

161
00:11:35,120 --> 00:11:37,090
أ-أبي؟

162
00:11:37,530 --> 00:11:40,800
!غرانتز... انحنى برأسه

163
00:11:41,200 --> 00:11:45,840
عملتِ بجدّ لتجنُّب تلويث سمعة عائلة ماجينتا

164
00:11:46,270 --> 00:11:50,730
آمنتُ بأنّ تشجيعكِ لتحقيق تلك
الغاية كان عملي بصِفتي أبيكِ

165
00:11:50,730 --> 00:11:53,930
ما-ماذا تقول؟

166
00:11:54,340 --> 00:11:58,240
أشعر الآن بأنّني كنتُ مُخطئاً

167
00:12:00,360 --> 00:12:04,810
!أنا ما أنا عليه اليوم بفضل التّربية الّتي منحتني إيّاها

168
00:12:04,810 --> 00:12:06,570
!كان كلّ هذا غلطتي أنا

169
00:12:06,980 --> 00:12:11,190
...لأنّني غير كافية كابنة دوق، وكملِكة مُستقبليّة

170
00:12:11,190 --> 00:12:13,470
—أنا حمقاء لوّثت اسم عـ

171
00:12:13,470 --> 00:12:14,720
ابنتي

172
00:12:15,790 --> 00:12:17,710
ليست حمقاء

173
00:12:19,880 --> 00:12:22,770
ارتقيتِ لكلّ توقُّعاتي

174
00:12:22,770 --> 00:12:24,390
كلّ الارتقاء

175
00:12:25,000 --> 00:12:28,840
بدأتُ أتساءل ما إن كان ما أردتِه
قد لعبَ أيّ دور في ذلك

176
00:12:30,840 --> 00:12:32,300
توقّف أرجوك

177
00:12:32,840 --> 00:12:36,300
...أنا حقّاً لم... أنا راضية

178
00:12:46,410 --> 00:12:49,010
...أنا متأكّد بأنّني لم أكن أباً جيّداً

179
00:12:49,010 --> 00:12:51,220
أو حتّى شخصاً جيّداً

180
00:12:51,610 --> 00:12:54,210
ليس عليكِ القلق بشأن عائلتنا

181
00:12:54,580 --> 00:12:56,830
،إذا كان هناك شيء أردتِه

182
00:12:56,830 --> 00:12:59,550
فسوف أحقّقه حتّى لو اضطررتُ لمواجهة الملك

183
00:13:01,340 --> 00:13:02,450
...يوفيليا

184
00:13:03,650 --> 00:13:05,910
هل دور الملِكة المُستقبلي شكّل عبئاً عليكِ؟

185
00:13:36,100 --> 00:13:39,420
هل كان هذا التصرُّف الصّائب فعلاً؟

186
00:13:39,810 --> 00:13:43,390
قصر الأميرة هو مكان مثالي لتتوارى عن الأنظار

187
00:13:43,390 --> 00:13:47,390
ومُقترحها ببحث علم السّحر
المُشترك يستحقّ النّظر فيه

188
00:13:48,280 --> 00:13:49,350
...فضلاً عن ذلك

189
00:13:49,850 --> 00:13:51,400
فضلاً عن ماذا؟

190
00:13:51,400 --> 00:13:54,300
،حتّى لو سُرِقَتْ يوفيليا

191
00:13:54,700 --> 00:13:56,530
قد لا يكون ذلك سيّئاً جدّاً

192
00:13:56,530 --> 00:13:57,860
!غرانتز

193
00:13:57,860 --> 00:13:59,160
كنتُ أمزح

194
00:13:59,670 --> 00:14:05,440
لكن قد يكون هناك معنى من إعطاء
يوفيليا للأميرة أنيسفيا

195
00:14:05,920 --> 00:14:07,410
ماذا تقصد؟

196
00:14:07,670 --> 00:14:12,090
لا يوجد قانون ينصّ على أنّ هناك
درب واحد لخِلافة العرش

197
00:14:14,300 --> 00:14:17,330
هل ينبغي لرئيس وزراء أن يقول ذلك لملِك؟

198
00:14:17,700 --> 00:14:20,710
أذكر بأنّنا قلنا أنّنا سنتكلّم كصديقين

199
00:14:21,330 --> 00:14:24,070
قد تكون الأميرة أنيسفيا الحاكمة التّالية لهذه المملكة

200
00:14:24,530 --> 00:14:26,400
إنّه ليس بحلم سيّئ يمتلكه المرء، صحيح؟

201
00:14:28,350 --> 00:14:30,880
هذا ليس حلماً أردتُه يوماً

202
00:14:30,880 --> 00:14:32,230
إنّه مجرّد كابوس

203
00:14:43,370 --> 00:14:45,150
هل ينتابكِ فضول حياله؟

204
00:14:45,430 --> 00:14:49,320
!إنّه قِدر حراريّ مصنوع من حجر روح النّار

205
00:14:49,320 --> 00:14:51,370
هل أنتِ من اخترعه؟

206
00:14:51,370 --> 00:14:54,450
،إنّه مُعدّ للحفاظ على حرارة مُعيّنة

207
00:14:54,450 --> 00:14:56,620
لذا يمكنه إعداد الشّاي خلال فترة قصيرة

208
00:14:56,910 --> 00:14:59,260
يمكن استخدامه لمياه حوض الحمّام كذلك

209
00:14:59,260 --> 00:15:02,570
يمكنني حتّى غسل الصّحون دون أن يبرد الماء

210
00:15:04,530 --> 00:15:06,530
جرّبي بعضاً من فضلكِ

211
00:15:09,530 --> 00:15:10,960
هكذا إذاً

212
00:15:11,390 --> 00:15:13,020
إنّه لذيذ بالفعل

213
00:15:13,020 --> 00:15:14,420
شكراً لكِ على قول ذلك

214
00:15:14,710 --> 00:15:16,390
هذا عمليّ جدّاً

215
00:15:16,390 --> 00:15:19,140
يبدو وكأنّه لديه استعمالات أخرى كثيرة أيضاً

216
00:15:19,140 --> 00:15:21,590
!صحيح؟ ها أنتِ تفهمين ذلك

217
00:15:21,590 --> 00:15:24,750
ليس كلّ النّاس يفهمون ذلك

218
00:15:24,750 --> 00:15:28,260
اسمعي! بما أنّكِ هنا، تعالي
!وألقي نظرة إلى ورشتي

219
00:15:30,160 --> 00:15:34,620
قبل أن تُصبحي مُساعدتي، ينبغي أن تأخذي
!صورة عامّة عن المكان أوّلاً

220
00:15:36,100 --> 00:15:38,800
...لكن الأميرة أنيسفيا

221
00:15:38,800 --> 00:15:40,760
"يمكنكِ أن تناديني "أنيس

222
00:15:40,760 --> 00:15:42,960
!"وسأناديكِ "يوفي

223
00:15:43,480 --> 00:15:45,710
!لم نعُد غريبتين في نهاية المطاف

224
00:15:45,710 --> 00:15:48,110
مـ... ماذا؟

225
00:15:48,670 --> 00:15:51,920
لا شيء يُوقِف أنيس-ساما الآن

226
00:15:51,920 --> 00:15:55,780
اعتبري أنّها سُحِرت بواسطة شيطان واستسلمي

227
00:15:56,310 --> 00:15:58,300
!هيّا بنا يا يوفي

228
00:15:58,300 --> 00:15:59,910
—أنيس، انتـ

229
00:15:59,910 --> 00:16:01,640
!تشبّثي

230
00:16:09,490 --> 00:16:13,150
!أهلاً بكِ في ورشة عملي

231
00:16:16,120 --> 00:16:18,760
...هناك أشياء كثيرة لم أرها من قبل

232
00:16:18,760 --> 00:16:20,570
—صنعتِ كلّ هذا يا أميرة أنيسفـ

233
00:16:21,820 --> 00:16:24,330
أعني يا أنيس-ساما؟

234
00:16:24,330 --> 00:16:27,040
!هذا صحيح! امدحيني يا يوفي

235
00:16:27,400 --> 00:16:29,510
أ-أحسنتِ صنعاً

236
00:16:29,510 --> 00:16:32,970
من فضلكِ لا تُدلّلي أنيس-ساما كثيراً

237
00:16:37,510 --> 00:16:39,660
،الأدوات بحدّ ذاتها جديرة بالمُلاحظة

238
00:16:39,660 --> 00:16:42,970
لكن أنا مصدومة بأنّه خطرَتْ على ذهنكِ
فكرة استخدام الأحجار الرّوحيّة

239
00:16:42,970 --> 00:16:47,180
لأنّ الأرواح هي ما يجعل استخدام
السّحر مُمكِناً، أليس كذلك؟

240
00:16:47,490 --> 00:16:50,510
،لكن لا أشعر بالأرواح إطلاقاً

241
00:16:50,510 --> 00:16:52,390
لذا لا يمكنني استخدام السّحر

242
00:16:53,010 --> 00:16:54,690
...لم أكن أدري

243
00:16:55,610 --> 00:17:00,270
لذا ترتّبَ عليّ التّفكير في شيء
!بديل عن الأرواح

244
00:17:01,730 --> 00:17:04,770
أنتِ مُذهلة حقّاً يا أنيس-ساما

245
00:17:05,770 --> 00:17:09,760
لطالما اعتبرتُ وجود السّحر والأرواح بديهيّاً

246
00:17:09,760 --> 00:17:13,580
لم أفكّر يوماً في آليّة عملها

247
00:17:13,580 --> 00:17:16,350
من الجيّد أنّكِ لم تفكّري في ذلك يوماً

248
00:17:16,350 --> 00:17:18,890
،لأنّكِ مُتوافقة مع الكثير من الأرواح المُختلِفة

249
00:17:18,890 --> 00:17:21,560
قوّتكِ طاغية بما يكفي لاستخدام أيّ خاصّية تريدينها

250
00:17:22,180 --> 00:17:23,520
طاغية؟

251
00:17:24,250 --> 00:17:25,530
...الحقيقة هي

252
00:17:26,520 --> 00:17:31,470
أحسد الأشخاص الّذين يستطيعون
استخدام السّحر. قليلاً فقط

253
00:17:32,410 --> 00:17:33,940
...المعذرة

254
00:17:33,940 --> 00:17:36,530
،لأنّها كأميرة لا تستطيع استخدام السّحر

255
00:17:36,530 --> 00:17:40,030
أنيس-ساما هي تعرف للملكيّ عديم الفائدة

256
00:17:40,980 --> 00:17:43,710
!قلّة احترام! قلّة احترام حقيقيّة! كفّي عن هذا

257
00:17:43,710 --> 00:17:45,670
!كيف أمكنكِ قول ذلك؟

258
00:17:45,670 --> 00:17:47,420
،في مملكة باليتّيا

259
00:17:47,420 --> 00:17:50,350
قيل بأنّ أولئك الّذين أبرموا عقوداً مع أرواح أعظم

260
00:17:50,350 --> 00:17:53,260
كانوا أسلاف العائلتين الملكيّة والنّبيلة، صحيح؟

261
00:17:53,630 --> 00:17:56,330
...أجل، لكن... أعلم، لكن

262
00:17:56,330 --> 00:17:58,600
ما يعني بأنّ الطبقتين الحاليّتين الملكيّة والنّبيلة

263
00:17:58,600 --> 00:18:01,650
مُؤهّلتان بفضل سُلطة السّحر

264
00:18:02,090 --> 00:18:03,570
...بينما أنيس-ساما من النّاحية الأخرى

265
00:18:03,570 --> 00:18:05,240
...أجل، لكن

266
00:18:05,240 --> 00:18:08,810
!تمتلك الأدوات السحريّة إمكانيّات أكبر من السّحر نفسه

267
00:18:09,260 --> 00:18:11,630
!أنتِ لا تفهمين الأمر فحسب يا إيليا

268
00:18:10,000 --> 00:18:15,490
إذا كان شيء مُكافئ للسّحر يمكن استخدامه
...لمنح النّاس حرّية أكبر

269
00:18:11,630 --> 00:18:15,490
.نحن لا نتحدّث عن شيء غير السّحر
نحن نتحدّث عن السّحر

270
00:18:15,490 --> 00:18:19,540
!لكنّكِ تستخدمين القِدر الحراريّ أيضاً

271
00:18:16,040 --> 00:18:20,200
فكيف سيكون شعور النُّبلاء المُحافظين جدّاً
حيال فقدانهم للسُّلطة والتسيُّد؟

272
00:18:20,200 --> 00:18:25,670
!ما معنى هذا؟! لن أدعكِ تستخدميه بعد الآن

273
00:18:20,890 --> 00:18:25,080
ستُثبت هذه الشابّة بأنّها دواء ناجع لهذه المملكة

274
00:18:26,410 --> 00:18:27,760
يوفيليا-ساما؟

275
00:18:28,130 --> 00:18:29,610
...لا شيء

276
00:18:31,190 --> 00:18:33,800
،حسناً، فات الأوان، انتهينا لليوم

277
00:18:33,800 --> 00:18:37,810
،لكن احتفالاً بوصولكِ إلى هنا
!سأصنع لكِ أداة سحريّة خاصّة

278
00:18:38,470 --> 00:18:40,760
لي أنا؟

279
00:18:41,720 --> 00:18:43,330
!تطلَّعي قُدماً لذلك

280
00:18:46,370 --> 00:18:49,430
!أنيس-ساما، توقّفي أرجوكِ

281
00:18:49,430 --> 00:18:52,680
من الصّعب إزالة هذه الأشياء
!لوحدك، صحيح؟ لذا سأساعدكِ

282
00:18:52,680 --> 00:18:53,810
...انتظري

283
00:19:00,350 --> 00:19:02,680
يمكنكِ أن تستعيري لِباس النّوم الخاص بي

284
00:19:03,990 --> 00:19:06,050
...شكراً لكِ

285
00:19:07,710 --> 00:19:09,680
والآن اذهبي إلى هناك رجاء

286
00:19:16,980 --> 00:19:19,630
تعالي وانضمّي إليّ يا مولاتي

287
00:19:20,710 --> 00:19:23,090
!كنتُ أمزح فحسب! لن أفعل شيئاً

288
00:19:27,460 --> 00:19:29,000
المعذرة من فضلك

289
00:19:32,430 --> 00:19:34,760
شكراً على القدوم معي اليوم

290
00:19:34,760 --> 00:19:36,300
،أعلم بأنّه حدث الكثير

291
00:19:36,940 --> 00:19:40,200
لكن آمل أن تري جاذبيّة علم السّحر
وجاذبيّتي عمّا قريب

292
00:19:43,180 --> 00:19:48,120
...أجل... أنتِ مجنونة كما تُفيد الإشاعات يا أنيس-ساما

293
00:19:49,610 --> 00:19:52,080
وأكثر غموضاً حتّى

294
00:19:53,750 --> 00:19:56,810
ما... أنتِ بالضبط؟

295
00:19:57,500 --> 00:19:59,720
ماذا... تقصدين؟

296
00:20:00,200 --> 00:20:02,190
ممّا حدث اليوم فقط، أستطيع التّمييز

297
00:20:02,190 --> 00:20:05,790
بأنّكِ ذكيّة جدّاً ولديكِ أحلام كبيرة يا أنيس-ساما

298
00:20:07,510 --> 00:20:10,900
أنا متأكّدة بأنّكِ تستطيعين العيش
بحرّية أكبر من أيّ شخص آخر

299
00:20:11,680 --> 00:20:15,370
لماذا ساعدتِني إذاً؟

300
00:20:15,940 --> 00:20:19,670
...أنا الّتي لم أكن صديقتكِ حتّى

301
00:20:20,560 --> 00:20:22,660
كانت لديّ أسباب كثيرة

302
00:20:24,690 --> 00:20:28,250
إحدى الأسباب كان هو أنّني مُعجبة
بكِ، وسبب آخر كان اهتماماً بالنّفس

303
00:20:28,900 --> 00:20:32,990
لكن السّبب الأهمّ كان هو لأنّكِ مثاليّة

304
00:20:33,340 --> 00:20:34,960
...المعذرة

305
00:20:35,650 --> 00:20:39,520
لطالما كنتِ هادئة وتتحكّمين بعواطفكِ

306
00:20:40,540 --> 00:20:42,830
،حتّى بعد ما حدث في السّهرة

307
00:20:42,830 --> 00:20:45,240
حاولتِ رغم ذلك قويّة وهادئة

308
00:20:47,190 --> 00:20:49,800
أنتِ حقّاً ابنة الدّوق المثاليّة

309
00:20:49,800 --> 00:20:53,070
أعتقد لهذا السّبب لم أستطع ترككِ وحدكِ

310
00:20:53,350 --> 00:20:58,060
لستُ أفهم. لا يمكنكِ أن تتركيني لأنّني مثاليّة؟

311
00:21:02,230 --> 00:21:05,670
،إن كنتِ شخصاً يستطيع الابتسام بمفرده
يمكنكِ فعل ما تشائين

312
00:21:06,350 --> 00:21:10,790
لكن لم يبدُ أنّكِ تستطيعين فعل ذلك بوضعكِ الآن

313
00:21:17,650 --> 00:21:20,590
،إذا كنتُ حُرّة كما تقولين

314
00:21:20,590 --> 00:21:25,370
فلا يسعني إلّا أنّ أمدّ يدي لشخص
يفتقر لتلك الحرّية

315
00:21:27,080 --> 00:21:29,940
...وكان سببكِ الوحيد

316
00:21:30,500 --> 00:21:34,930
يبدو أنّه أمر تافه، لكنّه مهمّ جدّاً بالنسبة لي

317
00:21:37,430 --> 00:21:42,600
يجدر للسّحرة أن يستخدموا سحرهم
لرسم البسمة في وجوه الآخرين

318
00:21:46,690 --> 00:21:48,320
عملتِ بجدٍّ واجتهاد

319
00:21:49,130 --> 00:21:51,990
ارتاحي الآن يا يوفي

320
00:21:58,000 --> 00:21:59,540
تصبحين على خير