1
00:00:22,820 --> 00:00:24,150
يوفيليا-ساما

2
00:00:26,600 --> 00:00:28,610
هل يمكنني حمل هذا كذلك؟

3
00:00:29,960 --> 00:00:32,350
أجل، من فضلك

4
00:02:55,790 --> 00:02:58,850
...صحيح... القصر

5
00:03:04,530 --> 00:03:07,170
يوفيليا-ساما، صباح الخير

6
00:03:07,170 --> 00:03:09,320
هل يمكنني الدّخول؟

7
00:03:09,320 --> 00:03:10,620
إيليا؟

8
00:03:14,670 --> 00:03:16,830
شكراً على قدومكِ في كلّ صباح

9
00:03:16,830 --> 00:03:18,960
يمكنكِ الدّخول

10
00:03:18,960 --> 00:03:20,200
المعذرة

11
00:03:25,180 --> 00:03:27,100
هل نمتِ جيّداً في اللّيلة الماضية؟

12
00:03:31,550 --> 00:03:33,850
أجل، نمتُ جيّداً

13
00:03:38,930 --> 00:03:40,950
هل تأقلمتِ مع هذا المكان؟

14
00:03:40,950 --> 00:03:44,540
أجل، والانتقال سارَ بسلاسة

15
00:03:45,210 --> 00:03:51,820
،حدثت أمور كثيرة، لكن بفضل آنيس-ساما
لم أعُد أُعتبَر مجرّد مُتطفّلة

16
00:03:51,820 --> 00:03:53,920
هذا رائع

17
00:03:55,350 --> 00:03:59,330
،أكره قول هذا بعد أن استقرّت الأمور فوراً

18
00:03:59,870 --> 00:04:03,750
لكن تمّ استدعاؤكِ إلى القلعة ظهر اليوم

19
00:04:03,750 --> 00:04:06,350
أجل، أعلم. بداعي الاستعلام، صحيح؟

20
00:04:06,960 --> 00:04:09,440
هلّا طلبتُ منكِ اصطحابي؟

21
00:04:09,440 --> 00:04:11,570
ثمّة أمور أريد أن أعيدها

22
00:04:11,880 --> 00:04:13,760
أمركِ

23
00:04:21,080 --> 00:04:23,030
المعذرة، أين آنيس-ساما؟

24
00:04:23,030 --> 00:04:25,900
طارَتْ بمِكنستها فجراً

25
00:04:25,900 --> 00:04:27,360
تباهَتْ بذلك سرّاً

26
00:04:27,360 --> 00:04:31,450
تباهَتْ سرّاً؟ يا لها من طريقة
غريبة لوصف الأمر

27
00:04:31,450 --> 00:04:33,280
هكذا تسير الأمور دوماً

28
00:04:42,380 --> 00:04:44,250
!ما هذا الضّجيج؟

29
00:04:45,070 --> 00:04:48,320
نظام الإنذار الّذي اخترعته آنيس-ساما

30
00:04:48,320 --> 00:04:51,050
يُطلَق الإنذار عندما يدخل شخصٌ
مشبوهٌ المنطقة

31
00:04:51,050 --> 00:04:54,850
...ويُرسِل إشعاراً إلى آنيس-ساما، لكن هذه المرّة

32
00:04:57,520 --> 00:04:59,180
...مؤلم

33
00:04:59,630 --> 00:05:01,400
أفسدتُ الأمر مجدّداً

34
00:05:03,110 --> 00:05:05,470
!صباح الخير يا يوفي

35
00:05:05,470 --> 00:05:07,160
صباح الخير

36
00:05:07,160 --> 00:05:08,940
هل تناولتِ الفطور؟

37
00:05:08,940 --> 00:05:10,910
!تعالي وساعديني في التّجربة إذاً

38
00:05:10,910 --> 00:05:13,120
تجربة؟

39
00:05:13,120 --> 00:05:14,840
أجل! أتتذكّرين ما قلتُه؟

40
00:05:15,270 --> 00:05:18,050
!سأصنع أداةً سحريّةً خاصّةً لكِ

41
00:05:26,470 --> 00:05:29,180
!أوّل شيء سنُطبِّق التّجربة عليه هو هذا

42
00:05:29,180 --> 00:05:33,390
!مفاجأة! نصل مانا

43
00:05:34,260 --> 00:05:36,090
!هيّا، جرّبيه

44
00:05:38,740 --> 00:05:41,500
...ا-المعذرة، ماذا يُفترَض بي أن أفعل

45
00:05:41,500 --> 00:05:43,470
مرّري بعض المانا من خلاله فحسب

46
00:05:43,740 --> 00:05:45,460
...حـ-حسناً

47
00:06:02,490 --> 00:06:04,920
هذا مُبهر جدّاً

48
00:06:04,920 --> 00:06:09,420
!أجل! إنّه سيفٌ سحريّ يتفعّل نصلُه بواسطة المانا

49
00:06:09,420 --> 00:06:11,610
،لكن توازُن الأحجار الرّوحيّة دقيق حقّاً

50
00:06:11,610 --> 00:06:13,050
لذا لا تُفكِّري أبداً في القتال عن كثب

51
00:06:13,050 --> 00:06:15,410
،من المؤسف أنّه ضعيف قليلاً أمام الصّدمات الجسديّة

52
00:06:14,350 --> 00:06:18,130
إنّه نقّال وفعّال في القتال السحريّ

53
00:06:15,410 --> 00:06:17,160
!لكنّه قويٌّ جدّاً ضدّ السّحر

54
00:06:17,160 --> 00:06:19,040
!إنّه نافع حقّاً للتخلُّص من السّحر

55
00:06:18,130 --> 00:06:21,820
إذا كان من المُمكن أن يعمل كعصا
سحريّة، سيكون نافعاً للغاية

56
00:06:19,040 --> 00:06:21,820
...قوّته وديمومته تعتمدان على كيفيّة تهيئته

57
00:06:22,510 --> 00:06:25,930
!هكذا! أحسنتِ يا يوفي

58
00:06:26,240 --> 00:06:30,790
!مظهر جميل، ذكاء حادّ، وشخصيّة عظيمة

59
00:06:30,790 --> 00:06:32,340
...أ-أجل

60
00:06:35,030 --> 00:06:37,830
!حسناً، لنجرّب هذا تالياً

61
00:06:51,630 --> 00:06:55,600
!هل أنتِ متأكّدة من أمان هذه؟ إنّها تهتزّ كثيراً

62
00:06:55,600 --> 00:06:56,600
!لن أموت، صحيح؟

63
00:06:56,870 --> 00:07:00,270
!ستكونين بخير! اعتمدي عليّ

64
00:07:00,270 --> 00:07:01,810
!لن أُفلِت الجزءَ الخلفيّ

65
00:07:02,280 --> 00:07:04,800
هل أنتِ جادّة؟ مهما حدث؟

66
00:07:04,800 --> 00:07:06,260
!عِديني بذلك

67
00:07:06,260 --> 00:07:08,470
!لا تُفلِتي مهما كانت الظّروف

68
00:07:08,470 --> 00:07:11,950
!أجل، مهما حدث! أعِدُكِ

69
00:07:11,950 --> 00:07:13,500
!الملكيّون لا يكذبون

70
00:07:20,470 --> 00:07:21,830
أنا... أطير؟

71
00:07:22,370 --> 00:07:25,280
هذا هو الشّعور بالطّيران؟

72
00:07:30,690 --> 00:07:33,190
—آنيس-ساما، هل هذا صائـ

73
00:07:46,910 --> 00:07:48,440
!يوفي

74
00:07:51,680 --> 00:07:54,780
!هل أنتِ بخير؟! أنا آسفة! كانت حادثة

75
00:07:54,780 --> 00:07:56,410
!أ-أعني ما أقول

76
00:07:56,410 --> 00:07:58,970
،تحقّقتُ من كلّ إجراءات الأمان بنفسي

77
00:07:58,970 --> 00:08:00,370
!لذا ظننتُكِ ستكونين بخير

78
00:08:01,780 --> 00:08:05,530
...لذا... في الواقع

79
00:08:05,530 --> 00:08:07,340
أ-أنا آسفة

80
00:08:20,600 --> 00:08:22,160
اعذريني على وقاحتي

81
00:08:22,160 --> 00:08:24,720
!لا مُشكلة إطلاقاً

82
00:08:24,720 --> 00:08:26,910
لا، بل هذه مُشكلة

83
00:08:26,910 --> 00:08:29,070
أنتِ أميرة

84
00:08:29,070 --> 00:08:31,330
لكن لستُ خليفة أو ما شابه

85
00:08:31,330 --> 00:08:32,610
هذا غير مهمّ

86
00:08:32,610 --> 00:08:36,590
فضلاً عن ذلك، أنا مُساعدتكِ الآن يا آنيس-ساما

87
00:08:36,590 --> 00:08:38,330
يجب أن أُظهِر لكِ بعض الاحترام

88
00:08:38,330 --> 00:08:42,010
لا داعي لتتعاملي مع هذا الأمر برسميّة

89
00:08:42,010 --> 00:08:44,750
أريدكِ فقط أن تستمتعي باللّعب الآن

90
00:08:45,220 --> 00:08:47,250
اللّعب؟

91
00:08:47,250 --> 00:08:49,510
!حسناً، أعني إلى أن تعتادي على ذلك

92
00:08:49,510 --> 00:08:51,460
!يمكنكِ اعتبار هذا كمسرحيّة

93
00:08:51,870 --> 00:08:54,430
وإذا كنتِ ستدرسين، يجدر بكِ
أن تستمتعي بفعل ذلك

94
00:08:55,970 --> 00:08:58,470
مثل هذه الأدوات تتمتّع بعناصر
هزليّة مُسلّية أيضاً

95
00:08:58,470 --> 00:09:01,140
إذا توتّرتِ عند استخدامها، سرعان ما سوف تنكسر

96
00:09:06,530 --> 00:09:09,310
رغم ذلك، لا يمكننا أن ندعكِ
تلعبين زيادة عن اللّزوم

97
00:09:17,440 --> 00:09:19,840
يوفيليا-ساما، حان الوقت

98
00:09:19,840 --> 00:09:21,590
استعدّي للذهاب من فضلكِ

99
00:09:21,590 --> 00:09:22,280
حسناً

100
00:09:22,810 --> 00:09:25,590
حسناً يا آنيس-ساما، أستأذن

101
00:09:25,590 --> 00:09:26,890
إلى أين أنتِ ذاهبة؟

102
00:09:26,890 --> 00:09:28,780
تمَّ استدعائي بواسطة جلالته

103
00:09:28,780 --> 00:09:32,000
حسناً. أراكِ لاحقاً إذاً

104
00:09:49,400 --> 00:09:52,720
هل كانت آنيس-ساما هكذا دوماً؟

105
00:09:52,720 --> 00:09:54,850
قطعاً لا

106
00:09:54,850 --> 00:09:57,060
منذ زمن بعيد، كانت أكثر طَيشاً وتهوُّراً

107
00:09:57,060 --> 00:10:00,090
كانت سخافتها وغباؤها وجنونها بلا حدود

108
00:10:00,720 --> 00:10:03,250
واجهتِ وقتاً عصيباً حقّاً

109
00:10:03,250 --> 00:10:05,020
لا مُشكلة لديّ

110
00:10:05,020 --> 00:10:07,570
عمل الخادِمة هو أن تكون تحت رحمة سيّدتها

111
00:10:08,190 --> 00:10:10,710
لا... إنّها منفعة في الواقع

112
00:10:10,960 --> 00:10:13,480
منفعة؟ حقّاً؟

113
00:10:13,480 --> 00:10:15,430
أجل، منفعة

114
00:10:16,230 --> 00:10:19,130
أعتقد لا يزال هذا يفوق استيعابي

115
00:10:19,130 --> 00:10:20,400
بكلِّ تأكيد

116
00:10:20,400 --> 00:10:24,210
إن لم يعجبكما ذلك، سيكون من الأفضل
لكما أن تقولا ذلك ببساطة

117
00:10:24,210 --> 00:10:26,730
لا، ليست مسألة أنّه لا يُعجبني

118
00:10:26,730 --> 00:10:27,920
هذا غير مألوف

119
00:10:27,920 --> 00:10:32,720
لم أكن أعلم بوجود شخص جدير بالثّناء
أن يعتبر الأميرةَ شخصاً جيّداً

120
00:10:32,720 --> 00:10:35,360
...لا أقول أنّني أعتبرها جيّدة

121
00:10:36,450 --> 00:10:39,820
الحقيقة هي أنّني لستُ أفهم ببساطة

122
00:10:40,780 --> 00:10:44,380
...أؤمن بأنّها شخص طيّب، لكن

123
00:10:48,460 --> 00:10:51,160
إنّها... بعيدة عنّي فحسب

124
00:10:56,840 --> 00:11:01,300
بئس الأمر... لا أريد حتّى النّظر
إلى هذه الشّهادة

125
00:11:01,300 --> 00:11:04,160
،كنتُ حاضراً أثناء الاستعلام

126
00:11:04,160 --> 00:11:06,640
ولم يقل إلّا نفس الكلام مراراً وتكراراً

127
00:11:06,640 --> 00:11:08,320
هكذا إذاً

128
00:11:08,320 --> 00:11:12,990
أمرتُ آلغارد بالبقاء في حُجرته، لكن
أعتقد أنّه لم يتغيّر شيء

129
00:11:13,450 --> 00:11:16,110
،يُصرُّ على اختيار دربه الخاصّ

130
00:11:16,110 --> 00:11:20,130
ما يعني بأنّه لن يكون مُقيّداً بخطوبة
اختارَها له والده

131
00:11:21,060 --> 00:11:23,930
،بالنسبة لشخص عشوائي في الشّارع، لا مشكلة

132
00:11:23,930 --> 00:11:26,160
لكن نحن عائلة ملكيّة

133
00:11:26,160 --> 00:11:28,810
!لدينا مسؤوليّات مُحدّدة

134
00:11:28,810 --> 00:11:30,770
ليس الأمير آلغارد فقط

135
00:11:30,770 --> 00:11:33,010
بقيّة الفتيان قالوا نفس الكلام

136
00:11:33,010 --> 00:11:37,110
بوسعنا تشكيل المزيد من الضغط
عليهم، لكن سيكون ذلك صعباً

137
00:11:37,110 --> 00:11:39,400
جميعهم أبناء شخصيّات نافذة

138
00:11:39,400 --> 00:11:41,490
قد ينتج عن ذلك تدخُّلات غير مرغوب فيها

139
00:11:41,490 --> 00:11:48,450
أجل... والكونت تشارتروز، سكرتير
السّحر، هو مصدر قلق

140
00:11:48,450 --> 00:11:51,270
...أنا متأكّد بأنّه يريد حماية ابنه، لكن

141
00:11:51,270 --> 00:11:53,600
الكونت هو قائد مُحافظ

142
00:11:53,600 --> 00:11:57,540
،بما أنّني مدعوم بواسطة الإصلاحيّين
،يعتبرني عدوّاً

143
00:11:57,540 --> 00:11:59,020
لذا يُقاومني بشدّة

144
00:11:59,020 --> 00:12:01,540
مُواجهة مُحافِظ؟

145
00:12:01,540 --> 00:12:03,320
كلّ هذا يؤرقني

146
00:12:05,520 --> 00:12:06,480
ادخل

147
00:12:15,660 --> 00:12:16,840
هكذا إذاً

148
00:12:17,380 --> 00:12:22,040
كان تفاعلكِ قليل جدّاً مع ابنة البارون شيان؟

149
00:12:22,040 --> 00:12:23,080
صحيح

150
00:12:23,080 --> 00:12:26,770
أسديتُ لها نصيحة ذات مرّة ليس إلّا

151
00:12:29,100 --> 00:12:34,140
لا أرى أيّ خطأ في سلوككِ
كآنسة نبيلة مخطوبة

152
00:12:34,590 --> 00:12:38,050
أيّ نبيل ينبغي أن يتفهّم ذلك

153
00:12:38,050 --> 00:12:41,100
لستُ مُقتنعاً من أنّ الأمير والآنسة بالغا في الردّ

154
00:12:41,100 --> 00:12:43,540
فقط لأنّ الحبّ قد أفقدهما صوابهما

155
00:12:43,540 --> 00:12:47,190
هل لديكِ أيّ أفكار أو تحقيقات أخرى تُشاركينها؟

156
00:12:47,190 --> 00:12:49,900
مع أنّني واثق بأنّكِ لستِ مُتحمّسة
...لتذكّر تلك اللّحظة

157
00:12:55,540 --> 00:12:59,210
بدا الجميع مُقتنعين جيّداً بصواب أفعالهم

158
00:12:59,470 --> 00:13:01,800
حتّى عندما أهانني، شعرتُ أنّه كان يفعل ذلك

159
00:13:01,800 --> 00:13:05,260
فقط ليتبع إيمانه الخاصّ، لا من باب الضّغينة

160
00:13:07,350 --> 00:13:10,330
أولئك الّذين يُخدَّرون بحسِّ صوابهم وصلاحهم

161
00:13:10,330 --> 00:13:13,200
...يُصبحون عُمياً لما يدور حولهم

162
00:13:15,030 --> 00:13:18,220
أنا آسف، لكن هلّا أمهلتني بعض الوقت؟

163
00:13:18,660 --> 00:13:21,560
إذا توصّلتُ لأيّ شيء، سأتّصل بكِ

164
00:13:21,560 --> 00:13:23,950
...حسناً. في هذه الحالة

165
00:13:36,650 --> 00:13:37,840
ما هذا؟

166
00:13:37,840 --> 00:13:39,160
مفتاح المكتبة المُحرّمة

167
00:13:39,860 --> 00:13:42,880
كنتُ أستعيره لدروس تتعلّق
بكيف يجب أن أتصرّف كملِكة

168
00:13:43,410 --> 00:13:45,110
هكذا إذاً

169
00:13:45,110 --> 00:13:48,460
إذا أردتِ، يمكنكِ الاحتفاظ به

170
00:13:50,670 --> 00:13:53,490
لم أعُد أملك الحقّ

171
00:13:53,490 --> 00:13:54,940
أنا أعيده لك

172
00:13:54,940 --> 00:13:58,190
...كنتِ تمرّين بكلّ هذا لأجلنا

173
00:13:59,470 --> 00:14:00,450
أنا آسف

174
00:14:00,450 --> 00:14:03,150
!لـ-لا! جلالتك! لا تقل ذلك أرجوك

175
00:14:03,590 --> 00:14:04,860
...لكن

176
00:14:05,920 --> 00:14:11,770
لم يكن هناك مكان لي في قلب
الأمير من الأساس

177
00:14:12,490 --> 00:14:17,950
لكن جرحي ليس بعميق بسبب تلك الحادثة

178
00:14:19,060 --> 00:14:21,980
...لا أشعر بأيّ شيء

179
00:14:21,980 --> 00:14:25,630
وكأنّ كلّ شيء قد جفَّ تماماً

180
00:14:27,510 --> 00:14:30,220
أدّيتِ دوركِ وأكثر

181
00:14:30,640 --> 00:14:32,990
عليك التّفكير فيما سيأتي لاحقاً

182
00:14:32,990 --> 00:14:36,020
ليس عليكِ فعل ما هو أكثر من ذلك

183
00:14:40,700 --> 00:14:44,810
إذاً سألقي التحيّة على الجميع هنا
الّذين كانوا لُطفاء معي وأعود إلى الدّيار

184
00:14:48,980 --> 00:14:52,500
ألا تعتقد أنّه كان بمقدورك صياغة
ذلك بطريقة مختلفة؟

185
00:14:52,500 --> 00:14:54,460
لم يكن كلامك كافياً

186
00:14:55,390 --> 00:14:56,670
حقّاً؟

187
00:14:57,010 --> 00:14:59,790
من الصّعب أن يكون المرء أباً

188
00:15:00,230 --> 00:15:01,870
أتّفق معك

189
00:15:28,900 --> 00:15:30,510
...يوفيليا-ساما

190
00:15:34,480 --> 00:15:36,320
هل جميعكم بخير؟

191
00:15:38,540 --> 00:15:40,380
فعلتُم الكثير لأجلي

192
00:15:43,300 --> 00:15:44,840
!يوفيليا-ساما

193
00:15:47,220 --> 00:15:50,810
لو كنتُ أعلم بأنّكِ ستأتين، لأتيتُ لأقلكِ

194
00:15:50,810 --> 00:15:53,100
أنا آسفة للاقتطاع من وقتكِ

195
00:15:53,100 --> 00:15:55,280
أردتُ أن ألقي التحيّة على الجميع

196
00:15:55,280 --> 00:15:57,050
أنتِ تُشرّفيننا

197
00:15:57,680 --> 00:16:00,280
هل فقدتِ بعض الوزن؟

198
00:16:00,280 --> 00:16:02,870
أجل، قليلاً فقط. أنا آسفة

199
00:16:02,870 --> 00:16:05,520
لا، لا. لا داعي للاعتذار

200
00:16:06,290 --> 00:16:08,030
هذا صحيح

201
00:16:08,310 --> 00:16:11,490
لن تكون هناك ضرورة لتفصيل
فُستان بحسب مقاسي بعد الآن

202
00:16:12,990 --> 00:16:17,590
لم يتغيّر قوام جسدكِ أبداً يا يوفيليا-ساما

203
00:16:17,590 --> 00:16:18,790
حقّاً؟

204
00:16:18,790 --> 00:16:20,150
بالطبع

205
00:16:20,150 --> 00:16:21,620
يبدو هذا رائعاً

206
00:16:23,080 --> 00:16:25,220
،الأميرة تأكل وتشرب كثيراً

207
00:16:25,220 --> 00:16:28,540
،ودائماً ما تركض من مكان لآخر بفساتينها
لذا يجب عليّ تعديلها مراراً

208
00:16:28,540 --> 00:16:32,600
وتكره المِشدّ والصدريّة. روحها حُرّة حقّاً

209
00:16:34,800 --> 00:16:36,660
يمكنني تصوُّر ذلك

210
00:16:39,120 --> 00:16:43,100
لعلّكِ حُرّة الآن يا يوفيليا-ساما

211
00:16:43,100 --> 00:16:45,790
ليس عليكِ ارتداء فساتين أو مِشدّات بعد الآن

212
00:16:45,790 --> 00:16:49,650
لم يعد هناك ما يُقيّدكِ

213
00:16:51,850 --> 00:16:53,320
معكِ حقّ

214
00:16:58,020 --> 00:17:01,010
لا شيء... لا شيء إطلاقاً

215
00:17:19,010 --> 00:17:20,720
!يوفي

216
00:17:20,720 --> 00:17:23,430
آنيس-ساما؟ ماذا ترتدين؟

217
00:17:23,430 --> 00:17:26,990
...آسفة! نمتُ لحوالي ساعتين فقط

218
00:17:26,990 --> 00:17:28,770
...بل في الحقيقة، ساعة واحدة

219
00:17:28,770 --> 00:17:30,930
أجل، نمتُ لساعة فقط

220
00:17:30,930 --> 00:17:32,860
!في الحقيقة، لم أنم إطلاقاً

221
00:17:35,080 --> 00:17:37,290
!آسفة لو تأخّرتُ عليكِ

222
00:17:41,100 --> 00:17:42,460
...هل هذا

223
00:17:42,460 --> 00:17:47,230
أجل! النّصل هو سبيكة تحتوي على أحجار
!روحيّة، ممّا يجعله ناقلاً للمانا

224
00:17:47,870 --> 00:17:51,020
لكن يجدر بنا أوّلاً اختبار مدى ناقليّته للمانا

225
00:17:51,020 --> 00:17:53,840
!إذا نجح، يمكننا إضافة خواص مختلفة إلى النّصل

226
00:17:53,840 --> 00:17:57,050
!ثمّ سيكون أداة فاخرة ستُساعدكِ في استخدام السّحر

227
00:17:58,690 --> 00:17:59,750
...بصيغة أخرى

228
00:17:59,750 --> 00:18:02,980
!أنهيتُ أداتكِ السحريّة الخاصّة

229
00:18:03,490 --> 00:18:06,430
أداتي السحريّة... الخاصّة؟

230
00:18:06,430 --> 00:18:08,340
—أجل! والآن هيّا

231
00:18:08,340 --> 00:18:11,890
يا أميرة، بدّلي ملابسكِ أوّلاً من فضلكِ

232
00:18:17,860 --> 00:18:20,980
!حسناً! تابعي وجرّبي ذلك

233
00:18:20,980 --> 00:18:24,290
يمكنكِ استخدام تلك الشّجرة كهدف

234
00:18:24,290 --> 00:18:26,740
ماذا؟ هـ-هل أنتِ متأكّدة؟

235
00:18:26,740 --> 00:18:27,620
!أجل

236
00:18:34,290 --> 00:18:38,760
مُذهل... وكأنّه جزء منّي بالفعل

237
00:18:41,240 --> 00:18:42,740
!كُرة النّار

238
00:18:51,690 --> 00:18:53,860
!كان ذلك رائعاً

239
00:18:53,860 --> 00:18:55,870
حسناً؟ حسناً؟ ما رأيكِ؟

240
00:18:57,150 --> 00:18:59,330
إنّه أداة مُبهرة

241
00:18:59,740 --> 00:19:01,620
!يسرُّني سماع ذلك

242
00:19:01,620 --> 00:19:04,220
!حسناً، والآن سنختبره كسيف سحريّ أيضاً

243
00:19:07,110 --> 00:19:08,910
...أيُّها النّصل، اتّخذ شكلاً

244
00:19:10,500 --> 00:19:12,220
!نصل الماء

245
00:19:13,220 --> 00:19:16,570
!إنّه سيف بالفعل

246
00:19:17,390 --> 00:19:20,890
هذا... كيف أُعبِّر عن الأمر؟ مُثير للغاية

247
00:19:31,370 --> 00:19:32,760
بالفعل صحيح

248
00:19:35,490 --> 00:19:38,700
سحر يوفي جميل جدّاً

249
00:19:45,970 --> 00:19:48,700
شكراً لكِ يا آنيس-ساما

250
00:19:48,700 --> 00:19:49,880
العفو

251
00:19:49,880 --> 00:19:54,180
كان من المُمتع حقّاً التّفكير
فيما سيُلائمكِ أكثر

252
00:19:54,840 --> 00:19:57,960
هل هذا... يلائمني حقّاً؟

253
00:19:58,970 --> 00:20:00,100
بكلّ تأكيد

254
00:20:02,310 --> 00:20:06,560
بدأ كلّ شيء بمفهوم شيء صُنِعَ خصّيصاً لكِ

255
00:20:07,270 --> 00:20:08,820
لا بدّ أن يلائمكِ

256
00:20:11,810 --> 00:20:15,060
فكّرتُ في اسم له أيضاً

257
00:20:15,060 --> 00:20:17,300
اسم؟

258
00:20:17,940 --> 00:20:18,730
أجل

259
00:20:20,090 --> 00:20:21,700
آركينشيل

260
00:20:23,950 --> 00:20:26,220
آركين...شيل؟

261
00:20:27,870 --> 00:20:29,200
"يعني "قوس قزح

262
00:20:30,260 --> 00:20:32,680
،يحتوي على خواص سحريّة مختلفة كثيرة

263
00:20:32,680 --> 00:20:34,610
وكثير من الألوان

264
00:20:34,610 --> 00:20:36,140
إنّه مثاليّ لكِ

265
00:20:36,840 --> 00:20:39,760
ألوان قوس قزح... ومثاليّ لي؟

266
00:20:45,170 --> 00:20:48,730
شكراً لكِ. إنّه اسم جميل

267
00:20:53,420 --> 00:20:55,820
حقّاً؟ يسرُّني ذلك

268
00:21:05,110 --> 00:21:06,670
...ا-المعذرة

269
00:21:07,420 --> 00:21:10,650
إنّه فعلاً تطابُق مثاليّ

270
00:21:12,160 --> 00:21:14,150
...لطالما ارتأيتُ

271
00:21:14,750 --> 00:21:18,800
أنّكِ جميلة كقوس قزح

272
00:21:19,800 --> 00:21:23,160
...أنتِ حقّاً... جميلة جدّاً، هذا ليس عدلاً

273
00:21:27,430 --> 00:21:29,210
آنيس-ساما؟

274
00:21:36,770 --> 00:21:38,600
ماذا سأفعل بكِ؟

275
00:21:40,570 --> 00:21:45,410
لم يسند أحدٌ رأسه على حضني من قبل

276
00:21:51,560 --> 00:21:55,780
أحسدكِ يا آنيس-ساما

277
00:21:57,440 --> 00:22:03,370
...ليتني أستطيع أن أكون مثلكِ ولو قليلاً