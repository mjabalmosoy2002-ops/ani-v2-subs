1
00:00:11,960 --> 00:00:13,980
!عادت الأميرة

2
00:00:14,930 --> 00:00:17,520
إنّها في الفناء مع يوفيليا-ساما

3
00:00:31,800 --> 00:00:33,110
!آنيس

4
00:00:47,090 --> 00:00:50,010
لا أريد أن أدعكِ تصبحين ملِكة

5
00:00:50,010 --> 00:00:53,110
لا أريد أن أدعكِ تتخلّين عن كلّ شيء

6
00:00:55,780 --> 00:00:57,250
...لذا

7
00:00:59,620 --> 00:01:01,210
لنحسم هذا الأمر

8
00:01:35,440 --> 00:01:37,570
تستحقّين أن تُكافئي

9
00:01:38,530 --> 00:01:41,710
!أقصد بأنّكِ تعرّضتِ لكثير من الألم

10
00:01:41,710 --> 00:01:45,710
بوسعكِ أن تحظي بالحرّية من الآن
!فصاعداً وتعيشي كما تريدين

11
00:01:47,460 --> 00:01:51,260
!لذا لا حاجة لتحلّي مكاني

12
00:01:51,680 --> 00:01:53,640
أجل، معكِ حقّ

13
00:01:54,160 --> 00:01:56,300
لا بديل لكِ

14
00:01:56,730 --> 00:01:59,390
من يحلم بأخذ مكانكِ؟

15
00:02:01,540 --> 00:02:05,190
آنيس-ساما، أنا أؤمن بكِ

16
00:02:05,730 --> 00:02:13,140
حلمكِ، سحركِ، وتستطيعين التّحليق أعلى فأعلى

17
00:02:13,990 --> 00:02:16,510
لم يحن يومكِ بعد

18
00:02:16,510 --> 00:02:19,950
عندما يحين، أريد أن أعيشه معكِ

19
00:02:19,950 --> 00:02:24,150
!لا أريد أن أضحّي بكِ لتحقيق حلمي

20
00:02:24,550 --> 00:02:27,120
!ليس عليكِ الخضوع لكلّ ذلك لأجلي

21
00:02:27,340 --> 00:02:28,950
—أنا بخـ

22
00:02:28,950 --> 00:02:30,930
!لا تقولي لي بأنّكِ بخير

23
00:02:30,930 --> 00:02:35,480
!أنتِ تبكين الآن لأنّكِ لستِ بخير إطلاقاً

24
00:02:38,190 --> 00:02:41,060
!ما دام لا يتأذّى أحد، فمن يأبه؟

25
00:02:41,060 --> 00:02:45,900
،إذا استسلمتُ وسمحتُ لذلك أن يحدث
!فحينها ينتهي كلّ شيء

26
00:02:45,900 --> 00:02:47,810
!لم يعُد ذلك مُهِمّاً

27
00:02:49,250 --> 00:02:52,320
لا أستطيع الموافقة على أيّ شيء يؤذيكِ

28
00:02:53,140 --> 00:02:57,870
لا أستطيع الغفران لعالم يؤذيكِ ويحاول سحق حلمكِ

29
00:02:58,400 --> 00:03:01,420
،سأكون الجرح الوحيد الّذي تحتاجينه

30
00:03:01,420 --> 00:03:03,970
النّدبة التي تمنعكِ من الاستسلام

31
00:03:04,580 --> 00:03:08,160
،حتّى لو مقتِّني أو كرهتِني

32
00:03:08,160 --> 00:03:11,260
سأظلّ أتمنّى سعادتكِ مراراً وتكراراً

33
00:03:12,570 --> 00:03:16,640
آنيس-ساما، أريدكِ أن تكوني سعيدة

34
00:03:16,640 --> 00:03:20,160
أسعد من أيّ شخص في هذا العالم

35
00:03:26,050 --> 00:03:28,840
هذا ينطبق عليّ أيضاً

36
00:03:30,350 --> 00:03:33,580
!الهجوم الهوائي: قلب التنّين

37
00:03:38,030 --> 00:03:40,730
!لن أدعكِ تعانين فحسب

38
00:03:41,110 --> 00:03:43,300
!لهذا لا أستطيع أن أدعكِ تربحين

39
00:03:43,300 --> 00:03:44,710
!لا أريد الخسارة

40
00:03:45,990 --> 00:03:50,300
إذا كان هذا ما يتطلّبه لإيقاف دموعكِ، فلن أخسر

41
00:03:51,250 --> 00:03:53,380
!سأقبله كلّه

42
00:03:57,000 --> 00:03:59,290
اجمع وادمج

43
00:04:07,320 --> 00:04:09,610
!ادمج... وكُن

44
00:04:13,310 --> 00:04:14,440
...هذا

45
00:04:15,790 --> 00:04:18,720
تمّ الأمر

46
00:04:20,030 --> 00:04:21,240
!آنيس-ساما

47
00:04:22,640 --> 00:04:26,160
!هذه هي القوّة الّتي بداخلي والّتي أريتني إيّاها

48
00:04:26,160 --> 00:04:28,360
!إنّه المُستقبل الّذي حلمتِ به

49
00:04:28,360 --> 00:04:31,220
،مهما حاولتِ من مرّات أن تستسلمي

50
00:04:31,220 --> 00:04:32,570
!سأريك إيّاه

51
00:04:40,080 --> 00:04:41,710
!آركينشيل

52
00:05:21,420 --> 00:05:22,680
آنيس-ساما

53
00:05:28,790 --> 00:05:31,900
كان ذلك... جميلاً جدّاً

54
00:05:35,660 --> 00:05:38,550
مُحال أن أتمكّن من هزيمة هذا

55
00:05:40,790 --> 00:05:41,970
...يوفي

56
00:05:42,570 --> 00:05:43,400
نعم؟

57
00:05:45,470 --> 00:05:48,860
!لستِ مُنصِفة. لستِ مُنصِفة فحسب

58
00:05:49,630 --> 00:05:54,840
آنيس-ساما، كنتِ أنتِ من أحضرني إلى هنا

59
00:05:55,360 --> 00:05:57,570
ما كنتُ لأستطيع فعلها بمُفردي

60
00:05:58,050 --> 00:06:02,730
ما كنتُ لأستطيع أن أحبّ العالم
إلى هذا الحدّ من تلقاء نفسي

61
00:06:03,300 --> 00:06:08,550
العالم يبدو جميلاً فقط لأنّكِ فيه

62
00:06:09,240 --> 00:06:12,350
...إن كنتِ ترينه جميلاً أيضاً، فمن فضلكِ

63
00:06:13,120 --> 00:06:15,720
أحبِّي نفسكِ كذلك

64
00:06:18,490 --> 00:06:23,330
...يوفي... أنا... أنا

65
00:06:23,850 --> 00:06:24,930
أنا آسفة

66
00:06:25,610 --> 00:06:28,060
أنا لستُ بخير

67
00:06:28,060 --> 00:06:30,670
!مُحال أن أكون بخير

68
00:06:38,450 --> 00:06:41,050
سوف أمسك بيدكِ

69
00:06:41,770 --> 00:06:43,890
أحتاجكِ

70
00:06:46,180 --> 00:06:49,410
أنتِ ولا أحد آخر

71
00:07:15,260 --> 00:07:17,450
—آنيس، أنا

72
00:07:17,450 --> 00:07:18,550
...أمّي

73
00:07:19,540 --> 00:07:20,790
أنا آسفة

74
00:07:21,660 --> 00:07:25,710
لا أعتقد حقّاً أنّني أستطيع أن أكون ملِكة

75
00:07:27,120 --> 00:07:32,790
لطالما عرفتُ أنّكِ أدنتِ نفسكِ لأنّني
،لا أستطيع استخدام السّحر

76
00:07:33,510 --> 00:07:37,050
لذا ارتأيتُ أنّني ينبغي أن أزيح ذلك
...عن كاهلكِ بأن أصبح ملِكة

77
00:07:38,010 --> 00:07:42,210
وأنّني إذا لم أفعل، لن أستطيع تسمية
نفسي ابنتك وابنة أبي

78
00:07:43,300 --> 00:07:45,230
—آسفة لكوني ابنة عديمة الجـ

79
00:07:49,640 --> 00:07:52,350
كيف تسمّي نفسك عديم الجدوى؟

80
00:07:52,350 --> 00:07:56,630
!أنتِ ابنة أفضل بكثير ممّا أستحقّ

81
00:07:57,370 --> 00:07:58,810
...أمّي

82
00:07:59,450 --> 00:08:02,890
كنتِ تبذلين قصارى جهدكِ طوال هذا الوقت

83
00:08:02,890 --> 00:08:06,530
لكن ليس عليكِ أن تبذلي جهدكِ
بمفردكِ بعد الآن

84
00:08:06,930 --> 00:08:09,840
هل يمكنني البقاء كأميرة حقّاً؟

85
00:08:10,590 --> 00:08:13,010
كابنتكِ وابنة أبي؟

86
00:08:42,000 --> 00:08:44,190
يوفي، هل ما زلتِ مستيقظة؟

87
00:08:45,120 --> 00:08:46,660
آنيس-ساما

88
00:08:47,660 --> 00:08:50,630
آ-آسفة على إزعاجك في هذا الوقت المتأخّر

89
00:08:51,710 --> 00:08:54,590
لا، لا أمانع إطلاقاً

90
00:09:03,590 --> 00:09:06,580
.أردتُ أن أقول... آسفة على ما أعتقد
وشكراً لكِ

91
00:09:14,520 --> 00:09:18,560
هناك سبب دفعَني لأتشبّث بفكرة
،أن أكون ملِكة

92
00:09:18,560 --> 00:09:21,710
وأن أكون ابنة أمّي وأبي

93
00:09:22,150 --> 00:09:23,750
سبب؟

94
00:09:24,970 --> 00:09:26,890
احتفظتُ بذلك سرّاً طوال هذا الوقت

95
00:09:27,440 --> 00:09:31,100
سرّ لم أشاركه مع أحد أبداً

96
00:09:31,500 --> 00:09:35,800
مع أحد؟ ولا حتّى إيليا أو تيلتي؟

97
00:09:36,390 --> 00:09:37,110
أجل

98
00:09:37,880 --> 00:09:40,910
أنتِ أوّل شخص فكّرتُ في إخباره بذلك

99
00:09:42,290 --> 00:09:45,470
خطّطتُ لأخذه معي إلى قبري

100
00:09:47,310 --> 00:09:48,330
...يوفي

101
00:09:49,500 --> 00:09:53,890
هلّا أخذتِ هذا السرّ إلى القبر معي؟

102
00:09:56,730 --> 00:09:58,870
أجل. أعِدُكِ

103
00:10:02,080 --> 00:10:05,610
لديّ ذكريات من حياة ماضيّة

104
00:10:07,070 --> 00:10:10,560
عشتُ في عالم مختلف كلّياً عن هذا العالم

105
00:10:10,560 --> 00:10:14,090
السّحر لا يوجد سوى في القصص الخرافيّة هناك

106
00:10:15,380 --> 00:10:18,500
،عندما رأيتُ وجود السّحر في هذا العالم

107
00:10:18,500 --> 00:10:20,620
ظننتُه حُلماً

108
00:10:25,880 --> 00:10:28,540
أحياناً أتمنّى لو كان حُلماً

109
00:10:29,280 --> 00:10:30,780
آنيس-ساما؟

110
00:10:32,580 --> 00:10:37,690
هل أنا آنيسفيا وين باليتّيا حقّاً؟

111
00:10:39,870 --> 00:10:44,370
"من الدّاخل. أنا لستُ ببساطة "آنيسفيا وين باليتيّا

112
00:10:45,630 --> 00:10:52,090
أتساءل ما إن كانت إعادة ولادتي هنا
...قد مسحت آنيسفيا الأصليّة

113
00:10:53,420 --> 00:10:57,890
ما إن انتزعتُ منهما ابنتهما

114
00:10:59,310 --> 00:11:03,520
عندما فكّرتُ في ذلك... شعرتُ بالخوف

115
00:11:04,960 --> 00:11:07,480
...اعتقدتُ نفسي مُزيّفة

116
00:11:10,220 --> 00:11:13,940
!مُحال أن تكوني مُزيّفة

117
00:11:15,400 --> 00:11:18,200
!أنتِ من مدّ يده لي

118
00:11:18,560 --> 00:11:22,600
من سحبَني من أعماق اليأس في ذلك اليوم

119
00:11:22,600 --> 00:11:24,470
!كان أنتِ الّتي تجلسين هنا الآن

120
00:11:25,300 --> 00:11:28,320
،هنا، أليس كذلك؟ كلّ ما شعرتِ به

121
00:11:28,320 --> 00:11:29,510
،كلّ ما تمنّيتِه

122
00:11:30,030 --> 00:11:31,730
!كلّ ما أردتِه... كلّه

123
00:11:34,390 --> 00:11:39,050
،أنتِ" الّتي تعرفينها، و"أنتِ" الّتي تهتمّين لأمري"

124
00:11:39,050 --> 00:11:41,070
موجودة هنا بشكل غير قابل للنكران

125
00:11:41,880 --> 00:11:44,290
!لذا لا تقولي عن نفسكِ مُزيّفة رجاء

126
00:11:45,680 --> 00:11:50,920
!بالنسبة لي، أنتِ السّاحر الأعظم في العالم

127
00:11:57,100 --> 00:11:58,390
شكراً لكِ

128
00:12:28,710 --> 00:12:31,830
!لـ-لماذا قبّلتني؟! حمقاء

129
00:12:31,830 --> 00:12:33,680
لأنّني أردتُ ذلك

130
00:12:33,680 --> 00:12:38,440
أ-أردتِ؟! يجدر بكِ أن تقبّلي
!الشّخص الّذي تحبّينه فقط

131
00:12:39,720 --> 00:12:40,900
أحبّكِ

132
00:12:41,720 --> 00:12:47,400
لكن فقط من باب الاحترام والصّداقة، صحيح؟
!لا بدّ أن يكون كذلك

133
00:12:48,870 --> 00:12:54,030
إذا كان هذا ما تريدينه، سوف
أقدّم لكِ ولائي وصداقتي

134
00:12:59,630 --> 00:13:05,250
لكن إذا استطعتِ، أريدكِ أن تقبلي
هذا الشّعور على حقيقته

135
00:13:05,250 --> 00:13:07,470
...يوفي، انتظري

136
00:13:08,590 --> 00:13:09,700
لن أنتظر

137
00:13:18,010 --> 00:13:21,110
أتممت يوفيليا العقد الرّوحي

138
00:13:21,110 --> 00:13:23,970
وتمّ الاعتراف بها كعضو في العائلة الملكيّة

139
00:13:28,290 --> 00:13:30,040
الوقت مناسب

140
00:13:30,810 --> 00:13:33,620
سوف أتنحّى

141
00:13:40,670 --> 00:13:45,020
أأتمنكِ على أن تكوني الحاكمة التّالية
لهذه المملكة يا يوفيليا

142
00:13:45,020 --> 00:13:46,540
حاضرة يا أبتي

143
00:13:46,930 --> 00:13:48,390
أقبل بذلك

144
00:13:48,940 --> 00:13:50,040
...آنيس

145
00:13:51,430 --> 00:13:54,820
ستدعمين الملِكة بصفتكِ الأخت
الكبرى من الآن فصاعداً

146
00:13:54,820 --> 00:13:57,120
رافقيها في رسم المستقبل

147
00:13:57,600 --> 00:13:59,220
حاضرة يا أبي

148
00:13:59,770 --> 00:14:02,850
مُستقبلي هو مع يوفي

149
00:14:04,020 --> 00:14:07,200
،والآن كيف ستحكمين

150
00:14:07,200 --> 00:14:09,290
وكيف ستبنين هذه المملكة؟

151
00:14:12,580 --> 00:14:16,190
سأنهي وبطريقة مناسبة عصرَ السّحر الحاليّ

152
00:14:16,190 --> 00:14:18,530
والتّقاليد الّتي احتفظنا بها لأجيال

153
00:14:18,530 --> 00:14:21,740
هذا هدفي من أن أصبح ملِكة

154
00:14:22,050 --> 00:14:25,100
،وسأصنع عصراً يغدو فيه السّحر مُتاحاً لأيّ شخص

155
00:14:25,100 --> 00:14:28,820
ليس فقط الطبقة النّبيلة كامتياز حصريّ لها

156
00:14:28,820 --> 00:14:30,740
...والشّخص الّذي سيصنع ذلك العصر سيكون

157
00:14:32,400 --> 00:14:33,480
...أريد

158
00:14:35,240 --> 00:14:37,170
،إذا وجبَ عليّ وصف الأمر بكلمات

159
00:14:37,170 --> 00:14:39,270
أريد توسيع الحرّية لتشمل الجميع

160
00:14:42,000 --> 00:14:43,390
هكذا إذاً

161
00:14:43,650 --> 00:14:45,970
أرغب في رؤية مملكة كهذه بنفسي

162
00:14:46,690 --> 00:14:49,190
أعلم بأنّكما تستطيعان فعلها

163
00:14:53,050 --> 00:14:57,360
،رغم ذلك، مع أنّها قد تكون حرّية
لكن من الصّعب تصوّرها

164
00:14:57,360 --> 00:15:00,970
هناك شقّ بين عمليّة تفكير النّبلاء والعوام

165
00:15:00,970 --> 00:15:03,990
الفهم الكامل لن يتحقّق بسرعة

166
00:15:03,990 --> 00:15:05,100
...بخصوص ذلك

167
00:15:05,580 --> 00:15:07,920
لديّ اقتراح

168
00:15:58,340 --> 00:16:00,770
حسناً، هذه هي طلبيّة التّسليم الأخيرة

169
00:16:02,080 --> 00:16:04,520
ماذا؟ هل هناك شيء آخر؟

170
00:16:08,300 --> 00:16:09,700
...هل هذا

171
00:16:10,120 --> 00:16:12,200
أنا طلبتُه

172
00:16:13,280 --> 00:16:15,290
سيف سحريّ لأجلكِ فقط

173
00:16:15,290 --> 00:16:15,860
ماذا؟

174
00:16:20,400 --> 00:16:22,280
ما هو اسمه؟

175
00:16:26,460 --> 00:16:27,810
"سيليستيال"

176
00:16:28,460 --> 00:16:30,620
"يعني "من السّماوات

177
00:16:34,600 --> 00:16:37,570
،"بما أنّ آركينشيل الخاص بي يعني "قوس قزح

178
00:16:37,570 --> 00:16:39,590
أردتُ اسماً قريباً بالمعنى

179
00:16:44,030 --> 00:16:46,460
قوس قزح والسّماء؟

180
00:16:46,460 --> 00:16:48,070
معكِ حقّ. إنّهما مُتطابقان

181
00:16:48,070 --> 00:16:53,480
أعتقد من المثاليّ لأوّل شخص في العالم
أن يفكّر في سُبُل للطيران

182
00:17:13,950 --> 00:17:15,120
!إنّهم يُحلّقون

183
00:17:15,120 --> 00:17:17,220
!يستطيع أشخاص غير آنيس-ساما التّحليق الآن

184
00:17:20,730 --> 00:17:24,680
شكراً جزيلاً لكم على تصفيقكم بحرارة

185
00:17:24,930 --> 00:17:28,850
حسناً، الشّيء التّالي الّذي سأريكم
!إيّاه... هو هذا

186
00:17:32,520 --> 00:17:36,620
فُستان ومعطف يمنح أيّ شخص
!يرتديه القدرة على الطيران

187
00:17:37,000 --> 00:17:41,870
سوف نستعرض لكم الآن الطيران والرّقص الجوّي

188
00:17:44,130 --> 00:17:48,420
هذا هو الشّكل الجديد الّذي نأمل
إعطاءه لهذه المملكة

189
00:17:48,820 --> 00:17:54,390
إمكانيّة لا حدود لها، غير مُقيّدة بمفاهيم
مرسومة مُسبقاً ونمطيّات

190
00:17:54,680 --> 00:17:55,840
!هذه هي الحرّية

191
00:18:03,110 --> 00:18:04,330
...يوفي

192
00:18:05,540 --> 00:18:07,250
سأعيش حياة مديدة، حسناً؟

193
00:18:08,030 --> 00:18:09,810
أرجو أن تفعلي

194
00:18:10,550 --> 00:18:12,540
سأفعل شيئاً بشأن الخلود أيضاً

195
00:18:13,220 --> 00:18:14,920
سأبذل قصارى جهودي في الدّراسة

196
00:18:14,920 --> 00:18:17,940
على الأقلّ، بوسعي دوماً أن أصبح خالدة أيضاً

197
00:18:17,940 --> 00:18:19,330
أتطلّع قُدماً لذلك

198
00:18:20,200 --> 00:18:23,030
لذا ابقي معي للأبد، اتّفقنا؟

199
00:18:23,470 --> 00:18:24,260
حسناً

200
00:18:25,120 --> 00:18:26,660
معاً للأبد

201
00:18:50,800 --> 00:18:51,730
...يوفي

202
00:18:52,780 --> 00:18:53,980
!هيّا بنا

203
00:18:54,500 --> 00:18:56,430
!حسناً يا آنيس-ساما

204
00:19:20,060 --> 00:19:22,820
!لنُحلّق

205
00:20:00,070 --> 00:20:02,360
تاريخ المملكة منذ هذه اللّحظة

206
00:20:03,390 --> 00:20:06,110
سيُسجّل اسم الملِكة الّتي ائتمنت الجيل التّالي

207
00:20:06,110 --> 00:20:10,310
على المُستقبل، لتصبح تلك نقطة تحوّل
من العصر القديم إلى الجديد

208
00:20:11,290 --> 00:20:14,270
الملِكة الّتي، ومن أجل تصحيح
،العادات والتّقاليد المُشوّهة

209
00:20:14,270 --> 00:20:17,630
حقّقت نفس الإنجاز العظيم الّذي
،حقّقَه الملِك المُؤسّس

210
00:20:17,630 --> 00:20:21,270
لتصبح آخر ملِكة نبيلة والشّخص الّذي أنهى التّقاليد

211
00:20:21,660 --> 00:20:25,680
كان اسم تلك الملِكة يوفيليا فيز باليتيّا

212
00:20:26,910 --> 00:20:30,160
وبجانب الملِكة

213
00:20:30,160 --> 00:20:33,560
كانت الأميرة الّتي حملت دم
.العائلة الملكيّة الأصليّ

214
00:20:34,480 --> 00:20:38,530
،مُبتكِرة تمّ اضطهادها طويلاً بواسطة التّقاليد

215
00:20:38,530 --> 00:20:40,880
أمست الآن قائدة الجيل المُقبل

216
00:20:41,780 --> 00:20:44,800
،الأميرة الّتي أحبّت السّحر أكثر من أيّ شخص

217
00:20:44,800 --> 00:20:47,690
بالرّغم من تجنّب السّحر لها أكثر من أيّ شيء

218
00:20:48,320 --> 00:20:53,290
كان اسم تلك الأميرة آنيسفيا وين باليتيّا

219
00:20:54,380 --> 00:20:58,200
تلكما الشابّتان أغلقتا الفجوة بين التّقاليد والثّورة

220
00:20:58,710 --> 00:21:03,780
سيعتبر النّاس إنجازاتهما العظيمة
أسطورة في السّنوات المُقبلة

221
00:21:04,320 --> 00:21:07,980
لكن كلّ ذلك لم يحن بعد

222
00:21:08,280 --> 00:21:13,670
فأساساً ثورتهم قد بدأت للتو

223
00:21:14,990 --> 00:21:16,280
!لنضع في السّماء

224
00:21:16,700 --> 00:21:17,900
!قوس قزح...

225
00:21:30,080 --> 00:21:32,030
...أمطري كلّ أولئك

226
00:21:32,030 --> 00:21:33,690
...الّذين يقطنون في هذه المملكة...

227
00:21:34,390 --> 00:21:35,870
!بالبرَكات

228
00:21:51,020 --> 00:21:54,580
!بحقّكِ يا آنيس-ساما! أسهبتِ في النّوم

229
00:21:54,580 --> 00:21:56,160
!فطوركِ سيبرد

230
00:21:56,160 --> 00:21:58,590
آسفة يا ليني

231
00:21:58,590 --> 00:22:00,860
صباح الخير يا آنيس-ساما

232
00:22:00,860 --> 00:22:02,130
صباح الخير يا يوفي

233
00:22:03,350 --> 00:22:07,080
ليس عليكِ مُناداتي بـ"ساما" بعد
الآن، لكن مع ذلك تفعلين

234
00:22:07,390 --> 00:22:08,900
إنّها عادة

235
00:22:08,900 --> 00:22:11,550
سأكون أكثر حذراً من الآن فصاعداً يا آنيس

236
00:22:13,510 --> 00:22:15,370
شكراً لكِ

237
00:22:16,570 --> 00:22:19,930
تبدين مُتأقلمة تماماً مع دوركِ كخادمة

238
00:22:21,520 --> 00:22:24,010
يعزو كلّ الفضل لإيليا-ساما

239
00:22:24,010 --> 00:22:26,620
أنتِ سريعة التعلّم يا ليني

240
00:22:27,140 --> 00:22:28,710
أنتِ تلميذة جديرة بالتّعليم

241
00:22:28,710 --> 00:22:32,000
...لـ-لا إطلاقاً

242
00:22:32,000 --> 00:22:34,260
كنتِ ذات عون كبير حقّاً

243
00:22:36,740 --> 00:22:37,880
آنيس؟

244
00:22:39,210 --> 00:22:42,070
لا، لا شي

245
00:22:43,980 --> 00:22:46,620
،آنيسفيا-ساما، يوفيليا-ساما

246
00:22:46,620 --> 00:22:49,150
ستتأخّران إن لم تغادرا قريباً

247
00:22:49,150 --> 00:22:51,310
!ماذا؟ تأخّر الوقت بالفعل؟

248
00:22:51,310 --> 00:22:54,430
!أنتِ تستغرقين وقتاً طويلاً في الأكل يا آنيس-ساما

249
00:22:57,300 --> 00:22:58,850
...يوفي

250
00:23:04,600 --> 00:23:05,480
حسناً

251
00:23:10,470 --> 00:23:15,030
متى ستُقبّلينني من الشّفتين بدلاً من ذلك؟

252
00:23:15,030 --> 00:23:17,300
!لـ-لا أدري

253
00:23:22,510 --> 00:23:23,950
!يوفي

254
00:23:24,850 --> 00:23:27,430
!سوف نتأخّر يا آنيس