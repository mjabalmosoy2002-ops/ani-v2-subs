17
00:01:00,740 --> 00:01:04,560
!سـأقتل كيدا ماساومي لأنه من أمرهم بفعل هذا

18
00:01:04,560 --> 00:01:06,500
تبدو هذه عينا شخص مستعد للموت

19
00:01:06,500 --> 00:01:08,710
هورادا؟ أيّ هورادا؟

20
00:01:08,710 --> 00:01:12,120
أُريد إخبارك بما يفكر به

21
00:01:12,120 --> 00:01:14,260
أنا مُستعدٌ لأقتل

22
00:01:14,260 --> 00:01:16,400
!ولن أسمح لأيّ شخص بـانكار هذا

23
00:01:16,400 --> 00:01:17,970
،مهما بلغت بشاعة ما سـتراه

24
00:01:17,970 --> 00:01:19,740
هل سـتتقبله؟

25
00:01:20,680 --> 00:01:21,430
!كيدا

26
00:01:21,670 --> 00:01:22,270
لماذا؟

27
00:01:30,340 --> 00:01:31,310
كينّوزكي كوزوهارا

28
00:01:36,880 --> 00:01:37,850
شينقين كيشيتاني

29
00:01:39,550 --> 00:01:40,520
شينرا كيشيتاني

30
00:01:45,980 --> 00:01:46,950
سيلتي سترلسون

31
00:01:46,980 --> 00:01:50,060
Trans: нίкαяί

32
00:01:55,460 --> 00:01:56,420
!ماساومي

33
00:01:57,320 --> 00:01:58,680
...ميكادو

34
00:01:59,110 --> 00:02:01,890
ريوقاميني، لماذا؟

35
00:02:02,650 --> 00:02:05,990
!معكِ حق، هذا أبشع مما تخيّلت

36
00:02:06,930 --> 00:02:08,920
الــولاء

37
00:02:06,930 --> 00:02:08,920
نكران الذات

38
00:02:09,420 --> 00:02:11,890
ها أنتِ ذا أيتها الدرّاجة السوداء

39
00:02:11,890 --> 00:02:14,700
!نالوا منهم جميعًا

40
00:02:26,970 --> 00:02:28,020
!الآن

41
00:02:28,020 --> 00:02:29,040
!انقلبوا ضدّهم

42
00:02:35,510 --> 00:02:38,760
أوي، ما الذي يحدث؟

43
00:02:58,800 --> 00:02:59,970
أهلاً

44
00:02:59,970 --> 00:03:03,240
!كـ- كـ- كـ- كادوتا

45
00:03:03,240 --> 00:03:04,990
...لـ- لـ- لمَ ، أنتَ

46
00:03:05,470 --> 00:03:08,500
إذًا فقد كان هذا التنكّر كفيلاً بـخداعك؟

47
00:03:08,500 --> 00:03:12,330
لا أعتقد بـأن السماح لأي شخص بـالانضمام كانت فكرةً جيدة

48
00:03:12,330 --> 00:03:14,920
...كادوتا، ما الذي يحدث هنا

49
00:03:14,920 --> 00:03:18,710
لقد ذكّرني توقوسا

50
00:03:18,710 --> 00:03:23,290
عندما تم اعتقال إيزومي، قام شخصٌ يُدعى هورادا

51
00:03:23,290 --> 00:03:25,550
بـمحاولة تجنّب المسؤولية

52
00:03:25,550 --> 00:03:32,430
لذا قمت بـجمع حوالي 30 من أصدقائي وارتدينا أوشحةً صفراء

53
00:03:32,430 --> 00:03:35,840
لقد كانا يومازاكي وكاريزاوا عنيدان جدًا فـلم نحضرهما

54
00:03:35,840 --> 00:03:38,250
ألن نفعل أيّ شيء؟

55
00:03:38,250 --> 00:03:40,780
أحيانًا يكون العناد أمرًا سيئًا

56
00:03:42,070 --> 00:03:45,200
لم أرغب بـتذكّرك حتى

57
00:03:45,200 --> 00:03:48,040
فـهذا أمرٌ مقزز

58
00:03:48,040 --> 00:03:50,950
هل أنت من كسر ساقيها؟

59
00:03:50,950 --> 00:03:54,160
...لا، حسنًا، أنــا

60
00:03:54,160 --> 00:03:56,500
هل أنت من جعلها تبكي؟

61
00:03:57,060 --> 00:03:59,370
...تـبـًا... مـ- مُسدسي

62
00:03:59,370 --> 00:04:00,630
أين اختفى مسدسي اللعين؟

63
00:04:01,180 --> 00:04:02,130
إنهُ أنت، أليس كذلك؟

64
00:04:06,800 --> 00:04:10,890
لقد كنتُ سـأستخدم ذلك المفك لـفتح رأسك

65
00:04:12,310 --> 00:04:16,120
لكن آنري و ميكادو ليسا مثلنا

66
00:04:16,120 --> 00:04:19,500
لذلك لا داعي لأن يروا جثة

67
00:04:19,500 --> 00:04:21,370
...هذا كل ما في الأمر

68
00:04:24,000 --> 00:04:25,160
!ماساومي

69
00:04:25,910 --> 00:04:27,520
!ماساومي !ماساومي

70
00:04:27,520 --> 00:04:28,700
!تـمـاسك

71
00:04:28,260 --> 00:04:29,510
!كيدا

72
00:04:32,530 --> 00:04:36,820
لقد أخبرتني سيلتي كل شيء عنك وعن سونوهارا

73
00:04:36,820 --> 00:04:40,270
...أنـا آسف... لم أكُن أعرف

74
00:04:40,270 --> 00:04:42,450
...ريوقاميني، أنــا

75
00:04:42,450 --> 00:04:43,850
ليس عليكِ قول أيّ شيء

76
00:04:43,850 --> 00:04:46,230
،أظن بـأنني أفهم ما يحدث

77
00:04:46,230 --> 00:04:48,330
...لذا لا تضغطي على نفسكِ

78
00:04:49,390 --> 00:04:53,870
،لو أنني أخبرتك بما كان يقلقني ويسبب لي المعاناة

79
00:04:53,870 --> 00:04:56,540
لما حدث كل هذا

80
00:04:57,980 --> 00:05:03,820
لقد شعرتُ وكأنك تبتعد عني، لذا شعرت بـالخوف

81
00:05:04,370 --> 00:05:05,390
ماساومي

82
00:05:05,390 --> 00:05:07,360
!إنها غلطتي أنا أيضًا

83
00:05:07,360 --> 00:05:11,690
لم أخبركما بما كان يحدث معي

84
00:05:11,690 --> 00:05:12,910
سونوهارا

85
00:05:13,780 --> 00:05:15,290
أنا آسفة

86
00:05:15,290 --> 00:05:18,830
إنكما شخصان مهمان جدًا بـالنسبة لي

87
00:05:19,570 --> 00:05:22,120
لقد كنتما معي طوال الوقت

88
00:05:26,580 --> 00:05:29,130
إنكما رائعان معًا

89
00:05:29,130 --> 00:05:30,500
...ماساومي

90
00:05:31,120 --> 00:05:36,560
إن كنتم سـتنقلونني إلى المشفى، هل يمكنني أن أطلب معروفًا؟

91
00:05:36,560 --> 00:05:37,260
ما هو؟

92
00:05:37,260 --> 00:05:40,510
خذوني إلى مشفى رايرا العامّ

93
00:05:40,510 --> 00:05:43,660
...هنالك فتاةٌ تنتظرني

94
00:05:44,880 --> 00:05:46,500
مـ- ماساومي؟

95
00:05:46,500 --> 00:05:48,760
!ماساومي! ماساومي

96
00:05:48,760 --> 00:05:50,750
...يا لهول

97
00:05:50,750 --> 00:05:51,620
كادوتا

98
00:05:51,620 --> 00:05:54,950
،لقد أخبرتهُ بـألاّ يهرب

99
00:05:54,950 --> 00:05:56,430
لكن لم يكُن هذا ما قصدته

100
00:05:56,430 --> 00:05:58,370
عليه أن يتمهّل قليلاً

101
00:05:58,370 --> 00:06:00,630
...هل هؤلاء الأشخاص

102
00:06:01,300 --> 00:06:04,470
نعم، إنهم الدولارات

103
00:06:04,470 --> 00:06:07,240
هنالك أشياء يمكنك القيام بها عندما تكون بلا لون

104
00:06:07,240 --> 00:06:13,270
حتى لو أخبرتهم بـأن يختفوا، لم يكونوا مرئيين من البداية لذا لا يمكنهم الاختفاء

105
00:06:14,330 --> 00:06:16,270
!أوي! إن هورادا يهرب

106
00:06:16,890 --> 00:06:18,390
هورادا، من هُنا

107
00:06:18,390 --> 00:06:20,650
...ذلك الوغد

108
00:06:21,160 --> 00:06:22,720
سـأتبعه

109
00:06:22,720 --> 00:06:24,400
خذوا كيدا إلى المشفى

110
00:06:24,970 --> 00:06:26,650
فهمت

111
00:06:29,410 --> 00:06:31,430
هنالك شاحنةٌ صغيرة بـالخارج

112
00:06:31,430 --> 00:06:32,570
توقوسا، أعتمد عليك

113
00:06:34,070 --> 00:06:34,690
!حاضر

114
00:06:34,690 --> 00:06:37,020
عليّ القيام ببعض التنظيف

115
00:06:37,020 --> 00:06:38,470
اعتنوا بـ كيدا

116
00:06:41,170 --> 00:06:42,160
ما الأمر؟

117
00:06:42,160 --> 00:06:44,540
لا، لا شيء

118
00:06:51,300 --> 00:06:53,300
!هورادا، إن هيقا ليس هنا

119
00:06:53,300 --> 00:06:55,150
!دعوه وشأنه

120
00:06:57,080 --> 00:06:58,870
!إنها هـ- هـ- هنا

121
00:06:58,870 --> 00:07:00,490
!الدرّاجة السوداء

122
00:07:00,490 --> 00:07:01,840
!اخــرس

123
00:07:06,400 --> 00:07:08,860
هورادا، ما الذي سـنفعله الآن؟

124
00:07:08,860 --> 00:07:13,870
علينا الاختباء في مكانٍ ما حتى تهدأ الأوضاع

125
00:07:13,870 --> 00:07:18,500
حالما يخرج إيزومي من السجن، سـتكون الأمور على ما يرام

126
00:07:28,780 --> 00:07:30,610
!هورادا، انظر! أمامنا، أمامنا

127
00:07:30,610 --> 00:07:31,560
أمامنا؟

128
00:07:34,580 --> 00:07:36,460
...إ- إنه هو

129
00:07:36,460 --> 00:07:39,460
!شيزو! هيواجيما شيزو

130
00:07:39,460 --> 00:07:41,600
أهوَ حيّ؟

131
00:07:41,600 --> 00:07:45,460
لكن ما سبب وجود تلك اللافتة هناك؟

132
00:07:49,640 --> 00:07:51,890
- لمَ لا يزال حيًا... لماذا

133
00:07:51,890 --> 00:07:53,310
!هورادا

134
00:08:15,440 --> 00:08:18,420
!لا تحاولوا الهرب

135
00:08:30,200 --> 00:08:32,980
!هورادا، تماسك

136
00:08:34,200 --> 00:08:35,410
الدراجة السوداء؟

137
00:08:46,710 --> 00:08:51,440
يا للشجاعة، من الأفضل أن تتوقفوا قبل أن أقوم بـتشغيل الأضواء الحمراء

138
00:08:52,850 --> 00:08:55,430
لا تستهينوا بـشرطة المرور يا أولاد

139
00:09:03,060 --> 00:09:05,890
تم القبض على هورادا وعصابته

140
00:09:05,890 --> 00:09:10,150
،لقد حاولوا الاشتكاء على هيواجيما شيزو لأنه قد دمر سيارتهم

141
00:09:10,150 --> 00:09:13,190
ولكن الشرطة لم تكُن مهتمةً بهذا

142
00:09:21,330 --> 00:09:21,990
اعتن بـنفسك

143
00:09:21,990 --> 00:09:23,500
شكرًا جزيلاً لكِ

144
00:09:35,690 --> 00:09:37,880
أين سونوهارا؟

145
00:09:43,050 --> 00:09:44,810
نعم، هذا هوَ

146
00:09:44,810 --> 00:09:47,020
شكرًا

147
00:09:47,020 --> 00:09:49,850
والآن سـأحصل على مكافأة آواكوسو

148
00:09:49,850 --> 00:09:51,160
رائع

149
00:09:51,160 --> 00:09:53,550
لكنني لم أتمكّن من الحصول على الذخائر

150
00:09:53,550 --> 00:09:55,360
لا بأس، لا بأس

151
00:09:56,160 --> 00:09:57,220
لا يهم

152
00:09:57,220 --> 00:10:00,450
سـيكون رائعًا لو تمكّن من قتل شيزو - تشان أيضًا

153
00:10:00,940 --> 00:10:05,650
إذًا فقد استغليتني لـ أقوم بـتوصيل معلومات عن شيزو إلى هورادا، صحيح؟

154
00:10:05,650 --> 00:10:09,910
لقد كان سـيموت لو أنهُ تلقّى طلقةً في رأسه أو قلبه

155
00:10:09,910 --> 00:10:12,010
...يا للأسف

156
00:10:12,010 --> 00:10:14,210
هذا ما حدث، يـ أُمي

157
00:10:20,640 --> 00:10:22,580
شكرًا لك

158
00:10:22,580 --> 00:10:25,220
عُد إلى منزلك وعش حياةً عادية

159
00:10:34,860 --> 00:10:38,410
أنتَ هو أوريهارا إيزايا، صحيح؟

160
00:10:38,410 --> 00:10:40,710
سونوهارا آنري - تشان؟

161
00:10:40,710 --> 00:10:44,340
أم عليّ أن أُخاطبكِ بـ سايكا؟

162
00:10:44,340 --> 00:10:45,990
ما الذي تريدينه في هذا الوقت؟

163
00:10:48,170 --> 00:10:51,570
!سوف أقوم بـقطعك

164
00:10:52,700 --> 00:10:54,000
...لماذا

165
00:10:54,000 --> 00:10:56,280
لماذا تقوم بـهذا؟

166
00:10:57,240 --> 00:10:59,710
لم أقم بـفعل أيّ شيء

167
00:10:59,710 --> 00:11:04,720
،لـنرى... إن كان عليّ منحك سببًا

168
00:11:04,720 --> 00:11:07,900
!فـ سـأقول لأنني أُحب البشر

169
00:11:07,900 --> 00:11:12,480
لذا قد أكون أرغب بـرؤيتهم في جميع حالاتهم

170
00:11:13,120 --> 00:11:14,840
!والآن، سـأسألكِ

171
00:11:14,840 --> 00:11:18,190
هل كانت تلك الإجابة حقيقة أم كذبة؟

172
00:11:21,560 --> 00:11:24,870
سـأعرف عندما أُسيطر عليك

173
00:11:24,870 --> 00:11:27,320
بـالمناسبة، ماذا عنكِ؟

174
00:11:27,320 --> 00:11:30,770
،إن كنتِ تريدين حياةً يوميةً مُسالمة

175
00:11:30,770 --> 00:11:34,420
فـاستعملي السيف لـقطع كل من تعرفين

176
00:11:34,790 --> 00:11:38,190
!ذلك... سـيكون ذلك خاطئًا

177
00:11:38,190 --> 00:11:42,150
،يا إلهي، إذًا رفضكِ لـتوضيح الأمور لـ ميكادو وماساومي

178
00:11:42,150 --> 00:11:50,180
عندما علمتِ بـأنهما مثلكِ... هل هذه إجابةٌ صحيحة؟

179
00:11:51,870 --> 00:11:54,950
،لقد أقنعتِ نفسكِ بـأنكِ غير قادرةٍ على حبّ أيّ شخص

180
00:11:54,950 --> 00:11:58,270
وتستعملين هذا كـعذر لـتكوني راضيةً عن نفسكِ

181
00:11:58,830 --> 00:12:02,440
سايكا سـتُحب الأشخاص بدلاً منكِ؟

182
00:12:02,440 --> 00:12:03,620
...يا للسذاجة

183
00:12:03,620 --> 00:12:04,660
!اخــرس رجاءً

184
00:12:12,920 --> 00:12:17,120
أتعلمين بـأنهُ لا يجب عليك الاستخفاف بي؟

185
00:12:17,120 --> 00:12:21,910
هنالك سببٌ يجعلني قادرًا على مواجهة شيزو - تشان، صحيح؟

186
00:12:21,910 --> 00:12:23,010
،وإن لم يكُن هنالك شيء

187
00:12:23,010 --> 00:12:26,800
ما كان يجب عليكِ منحي هذا

188
00:12:28,830 --> 00:12:31,300
لا تقلقي، لن أُطلق عليكِ

189
00:12:31,830 --> 00:12:34,560
ولكن من سـأُطلق عليه؟

190
00:12:34,560 --> 00:12:36,690
هذان الزوجان هناك؟

191
00:12:37,800 --> 00:12:41,440
لا يمكنكِ أن تُحبي أيّ شخص، لذا لن يضايقكِ هذا

192
00:12:41,440 --> 00:12:46,510
لقد كنت أعلم بـأن هيقا كان أحد ضحايا المشرّح

193
00:12:46,510 --> 00:12:50,830
لمَ تعتقدين بـأنني طلبت منه إحضار المسدس؟

194
00:12:50,830 --> 00:12:52,270
بـسببكِ

195
00:12:52,270 --> 00:12:55,080
لقد أردتُ إعلان الحرب عليكِ

196
00:12:55,590 --> 00:12:58,440
فـأنا أُحب البشر كثيرًا

197
00:12:58,440 --> 00:13:01,650
ولا أقوم بـتسليمهم إلى سيفٍ سخيف

198
00:13:01,650 --> 00:13:05,380
...فـالبشر

199
00:13:03,730 --> 00:13:05,380
هم ملكي رغم كل شيء

200
00:13:06,840 --> 00:13:11,040
ولكنني لستُ بـحاجةٍ إلى شيزو - تشان، يمكنكِ الحصول عليه

201
00:13:11,040 --> 00:13:15,220
قومي بـتشريحه إلى قطع بـأسرع ما يمكن

202
00:13:15,220 --> 00:13:16,680
حظًا موفقًا

203
