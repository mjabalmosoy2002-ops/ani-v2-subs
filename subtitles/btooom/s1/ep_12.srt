...تايرا-سان

215
00:12:52,610 --> 00:12:54,660
...اللعنة

216
00:12:55,350 --> 00:12:58,210
!تايرا-سان! تايرا-سان

217
00:12:58,930 --> 00:12:59,790
...كلا

218
00:13:00,150 --> 00:13:01,500
.سوف يقتُلني

219
00:13:03,170 --> 00:13:04,050
!ابتعد

220
00:13:05,770 --> 00:13:07,170
!تايرا-سان

221
00:13:08,850 --> 00:13:12,680
!كُفّ عن هذا وعُد

222
00:13:14,010 --> 00:13:15,060
...ريوتا

223
00:13:15,750 --> 00:13:17,040
!ريوتا

224
00:13:24,500 --> 00:13:26,340
...و-وركي

225
00:13:26,340 --> 00:13:29,780
!تايرا-سان

226
00:13:31,490 --> 00:13:32,620
...سيقتلاني

227
00:13:34,780 --> 00:13:37,410
لم يتبقّى لديّ سوى واحدة؟

228
00:13:38,380 --> 00:13:41,600
.عليّ أن أقتُله قبل أن يقتُلَني

229
00:13:42,690 --> 00:13:44,620
!لأجل يوزوهيكو

230
00:13:44,620 --> 00:13:46,210
!لاجل آكيكو

231
00:13:46,210 --> 00:13:47,420
،تايرا-سان

232
00:13:48,000 --> 00:13:49,620
أين أنت؟

233
00:13:53,370 --> 00:13:57,430
.تايرا-سان، أودُ الاعتذار منك

234
00:13:58,520 --> 00:13:59,540
...أودُ

235
00:14:00,200 --> 00:14:02,110
!أودُ العودة معك

236
00:14:02,590 --> 00:14:04,230
.أودُ العودة للديار معك

237
00:14:05,090 --> 00:14:07,330
.لن أجعل تقلق مُجددًا

238
00:14:07,330 --> 00:14:08,960
...سأفعل الصواب هذه المرّة

239
00:14:09,630 --> 00:14:13,240
!امنحني فرصة أخيرة فحسب رجاءً

240
00:14:13,700 --> 00:14:15,720
...أتوسّل إليك يا تايرا-سان

241
00:14:15,720 --> 00:14:19,700
.أرجوك دعني أعتذر، تايرا-سان

242
00:14:20,540 --> 00:14:21,940
!تايرا-سان

243
00:14:22,970 --> 00:14:27,280
...سـ-ساكاموتو-هان، أنا

244
00:14:27,280 --> 00:14:30,260
...أنا... أنا

245
00:14:41,990 --> 00:14:45,150
هذه هي عاقبة أفعالي، أليست كذلك؟

246
00:14:46,170 --> 00:14:49,770
.عقابٌ لما فعلتُه

247
00:14:50,850 --> 00:14:54,050
.إنني آسف يا ساكاموتو-هان، هيميكو-هان

248
00:14:54,570 --> 00:14:57,370
...أردتُ العودة للمنزل وحسب

249
00:14:58,000 --> 00:15:00,240
.إنني أفتقدُ عائلتي

250
00:15:00,240 --> 00:15:02,250
.كان ذلك كُل شيء

251
00:15:06,050 --> 00:15:08,640
...يوزوهيكو... آكيكو

252
00:15:09,070 --> 00:15:10,300
...إنني آسف

253
00:15:12,900 --> 00:15:17,310
.والدُك لا يُمكنه تحمّل المزيد من الألم

254
00:15:25,080 --> 00:15:26,720
تايرا-سان؟

255
00:15:34,930 --> 00:15:35,830
لِمَ؟

256
00:15:36,690 --> 00:15:38,530
لِمَ فعلت هذا؟

257
00:15:40,250 --> 00:15:42,550
أما كُنّا سنعود معًا؟

258
00:15:43,470 --> 00:15:44,850
...انهض

259
00:15:45,360 --> 00:15:46,770
!قُل شيئًا

260
00:15:47,300 --> 00:15:49,550
!أخبرني بنُكتةٍ غبيّة كما كُنتَ تفعل دائمًا

261
00:15:50,040 --> 00:15:52,500
!ابدأ بأكل الرامن سريع التحضير قبل أن يُطبخ تمامًا

262
00:15:55,580 --> 00:16:00,640
...لم أتمكّن من الاعتذار منك

263
00:16:01,900 --> 00:16:03,140
لِمَ؟

264
00:16:03,560 --> 00:16:05,050
!لِمَ؟

265
00:16:16,630 --> 00:16:20,790
أتظُن أنّ تايرا-سان كان يُخطط لخيانتنا طوال الوقت؟

266
00:16:20,790 --> 00:16:22,190
كـ داتي-سان؟

267
00:16:23,020 --> 00:16:26,190
.كلا، ليس ذلك النوع من الأشخاص

268
00:16:26,830 --> 00:16:29,790
.لقد كان مُجرّد شخصٍ عاديّ

269
00:16:32,770 --> 00:16:37,340
.ولهذا السبب أصابه الخوف والقلق

270
00:16:38,250 --> 00:16:40,010
.لا أحد يُريد الموت

271
00:16:40,010 --> 00:16:41,390
.والجميع يُريد العودة للديار

272
00:16:42,490 --> 00:16:45,860
،لذا عندما تأذّى

273
00:16:45,860 --> 00:16:47,920
...وكان وحيدًا واليأس يُحيط به

274
00:16:49,050 --> 00:16:52,070
.انفطر قلبُه

275
00:16:52,570 --> 00:16:54,370
...إنني

276
00:16:54,370 --> 00:16:56,570
!إنني ببساطة قتلتُه

277
00:16:57,730 --> 00:16:58,980
...أنا

278
00:17:02,580 --> 00:17:05,540
أترغب بالعودة للديار أنتَ أيضًا؟

279
00:17:06,280 --> 00:17:09,590
...أجل، أُريد الخروج من هُنا

280
00:17:09,890 --> 00:17:12,000
.بعيدًا عن هذا الجحيم

281
00:17:17,390 --> 00:17:19,220
.يُمكنك المُغادرة يا ريوتا

282
00:17:20,510 --> 00:17:22,220
يُمكنني؟

283
00:17:22,630 --> 00:17:23,470
.أجل

284
00:17:23,470 --> 00:17:25,510
.أخذتُ هذه الرقاقات من هناك

285
00:17:26,440 --> 00:17:27,940
.أحدها هي رقاقة تايرا-سان

286
00:17:28,760 --> 00:17:31,870
.كما أنّهُ أخذ الاثنتين الأُخريتين بلا أن يُخبرنا

287
00:17:32,500 --> 00:17:36,220
.بهذه والثلاثة التي عثرنا عليها تُصبح ستّة

288
00:17:37,250 --> 00:17:38,860
،بالإضافة لواحدة منّي

289
00:17:39,420 --> 00:17:40,750
.وواحدة منك

290
00:17:41,050 --> 00:17:44,050
.هذه هي الرقاقات الثمانية التي تحتاجها لمُغادرة الجزيرة

291
00:17:45,790 --> 00:17:49,010
.إن مات أحدُنا، أحدُنا يُمكنه المُغادرة

292
00:17:51,780 --> 00:17:54,840
.لذا اقتلني

293
00:17:56,630 --> 00:17:57,510
.أجل

294
00:17:57,990 --> 00:17:59,220
.هذا صحيح

295
00:18:00,000 --> 00:18:04,060
.ليس لديّ مكانٌ أعود إليه

296
00:18:04,680 --> 00:18:08,060
.عندما لم أملك ملجئًا أفر إليه، أنتَ غيّرتني

297
00:18:09,400 --> 00:18:14,070
.أشعر أننا حتّى وإن لم نكُن مُرتبطين في العالم الحقيقي، فإنّ قلوبنا كانت مُرتبطة

298
00:18:15,320 --> 00:18:17,660
،حتّى وإن كان العالم افتراضيًا

299
00:18:17,660 --> 00:18:19,720
.فقد أنقذتني

300
00:18:20,570 --> 00:18:24,950
...وكذلك أيضًا، عندما أتيتُ لهذه الجزيرة وكُدتُ أموت عدّة مرّات

301
00:18:24,950 --> 00:18:26,910
.حتّى عندما كُدتُ أنهار

302
00:18:27,430 --> 00:18:30,160
...لذا الآن، إنني مُدركةٌ

303
00:18:31,510 --> 00:18:34,870
.أنّك أملي الوحيد في النجاة

304
00:18:37,230 --> 00:18:38,300
...ريوتا

305
00:18:39,770 --> 00:18:42,130
،إن نجوت

306
00:18:42,130 --> 00:18:43,720
...إن عِشتَ

307
00:18:45,300 --> 00:18:47,540
.فلا أهتم بما يحدثُ إليّ

308
00:18:48,340 --> 00:18:49,530
.لا أهتم

309
00:18:50,060 --> 00:18:51,900
!لـ-لا تكوني سخيفة

310
00:18:52,370 --> 00:18:55,780
أتظُنّين أنني أودُ العودة للديار لدرجة أنني قد أُضحّي بكِ؟

311
00:18:56,940 --> 00:18:59,200
أتظُنّين أنني من ذلك النوع من الرجال؟

312
00:19:00,020 --> 00:19:01,240
!لن أتخلّى عنكِ

313
00:19:01,740 --> 00:19:03,390
...لن أتخلى عنكِ أبدًا

314
00:19:04,510 --> 00:19:07,450
!ليس في هذا العالم ولا في العالم الافتراضي

315
00:19:10,350 --> 00:19:13,700
أنتِ هي هيميكو من اللعبة، صحيح؟

316
00:19:17,200 --> 00:19:18,670
...أدركتُ أخيرًا

317
00:19:19,440 --> 00:19:20,950
.أخيرًا تمكّنتُ من رؤيتكِ

318
00:19:21,920 --> 00:19:22,840
...هيميكو

319
00:19:33,410 --> 00:19:34,550
...أنا دائمًا

320
00:19:36,220 --> 00:19:38,040
.أنا دائمًا أردتُ رؤيتكِ

321
00:20:26,510 --> 00:20:27,530
هيميكو؟

322
00:20:28,980 --> 00:20:30,080
.هذا صحيح

323
00:20:31,310 --> 00:20:34,290
...هي ما تزال خائفة

324
00:20:37,480 --> 00:20:38,820
.ينبغي أن تكون خائفة

325
00:20:39,500 --> 00:20:42,270
.ولكن بالنسبة لي، هي تبذل قصارى جهدها لكي لا تكون كذلك

326
00:20:43,260 --> 00:20:45,480
...ولكنني

327
00:20:45,480 --> 00:20:46,840
ألن تفعلها؟

328
00:20:47,630 --> 00:20:49,450
أتذكر ما قُلته لك؟

329
00:20:49,450 --> 00:20:51,970
.أوّل من يتحرّك يظفر بالنصر

330
00:20:52,220 --> 00:20:54,110
...أظهر لها رجولتك

331
00:20:54,110 --> 00:20:56,980
أم أنّك ما زِلتَ راضيًا بكبح نفسك؟

332
00:20:57,240 --> 00:20:58,690
!ا-اخرس

333
00:21:00,130 --> 00:21:02,860
.لن تصل إليّ أبدًا بهذه الطريقة

334
00:21:03,340 --> 00:21:04,310
!اخرس

335
00:21:04,860 --> 00:21:06,310
إنني

336
00:21:07,350 --> 00:21:08,410
!لا أتطلّع إليك بعد الآن

337
00:21:10,240 --> 00:21:11,440
...فهمتُ أخيرًا

338
00:21:12,040 --> 00:21:15,190
.ما هو مُهم هو الاهتمام بمشاعر الآخرين

339
00:21:16,250 --> 00:21:17,860
،لو أنني علمتُ ذلك

340
00:21:19,070 --> 00:21:21,070
.لما كُنتُ تركتُ تايرا-سان يموت

341
00:21:22,050 --> 00:21:24,210
.لكنتُ قادرًا على التوافق مع عائلتي

342
00:21:25,150 --> 00:21:27,930
...ظننتُ أنني كُنتُ الوحيد المُهم

343
00:21:28,450 --> 00:21:30,060
.استصغرت الآخرين

344
00:21:31,300 --> 00:21:34,430
...لو أنني لم أفعل، لما

345
00:21:34,430 --> 00:21:36,820
!جُلبتُ لهذه الجزيرة

346
00:21:38,910 --> 00:21:39,770
...أودا

347
00:21:40,440 --> 00:21:42,040
.إنني لستُ مثلك

348
00:21:43,080 --> 00:21:44,710
...لن أكون مِثلك

349
00:21:46,150 --> 00:21:48,350
!اخرُج من قلبي

350
00:22:03,680 --> 00:22:04,820
ريوتا؟

351
00:22:05,380 --> 00:22:06,420
أثمّة خطب؟

352
00:22:07,290 --> 00:22:09,110
.آسفٌ لمُفاجئتكِ

353
00:22:09,880 --> 00:22:13,340
...ولكن فِعلُ هذا بشغفٍ في لحظة

354
00:22:14,040 --> 00:22:15,550
.ليس صحيحًا

355
00:22:16,860 --> 00:22:20,150
.هيميكو، لنُغادر هذه الجزيرة معًا

356
00:22:20,880 --> 00:22:22,220
!لنعُد معًا

357
00:22:22,930 --> 00:22:25,900
...وعندها

358
00:22:26,990 --> 00:22:29,170
.سأبدأ مواعدكِ بشكل رسمي

359
00:22:38,070 --> 00:22:39,080
.أجل

360
00:22:39,080 --> 00:22:40,360
.لا بأس بهذا

361
00:22:40,710 --> 00:22:46,270
.سأُغادر هذا الجحيم مع هيميكو بلا شك

362
00:22:52,710 --> 00:22:53,880
...أربعة وعشرون ساعة

363
00:22:53,880 --> 00:22:57,080
!فلتُعد توصيلها خلال أربعة وعشرون ساعة

364
00:22:57,960 --> 00:23:00,180
.حالما تصل للجزيرة، ابدأ فورًا

365
00:23:00,180 --> 00:23:01,130
أفهمت؟

366
00:23:01,130 --> 00:23:02,260
.عُلم

367
00:23:02,260 --> 00:23:02,940
.بالإذن

368
00:23:03,450 --> 00:23:06,930
.أوي، احرص ألّا يكتشف العملاء هذا الأمر

369
00:23:06,930 --> 00:23:07,940
.مـ-مفهوم

370
00:23:08,440 --> 00:23:12,620
...تبًا، مشاكل فنّية في الجزيرة الآن، من بين جميع الأوقات

371
00:23:15,250 --> 00:23:17,240
!من بين جميع الأوقات

372
00:23:22,980 --> 00:23:25,130
.ريوتا، أنا آسف

373
00:23:25,650 --> 00:23:28,870
.هذا كُل ما يُمكنني فعلُه