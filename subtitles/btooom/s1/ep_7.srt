1
00:00:19,390 --> 00:00:23,430
بهذا نحن متزوجان الآن، أليس كذلك يا ساكوموتو-سان؟

2
00:00:23,770 --> 00:00:25,960
.أجل، هيميكو

3
00:00:25,960 --> 00:00:27,680
!في عالم "بتوم" فقط

4
00:00:28,310 --> 00:00:32,380
.كُل ما نملكه هُنا هي قلوبنا التي تثق بإنسانيّة بعضنا البعض بها

5
00:00:32,970 --> 00:00:35,640
.رُبّما يكون هذا حُبٌّ حقيقي نقي

6
00:00:37,510 --> 00:00:38,940
...لكنني

7
00:00:39,450 --> 00:00:41,190
.أُريدُ لقاءكِ

8
00:00:42,940 --> 00:00:44,280
.دعنا لا نفعل ذلك

9
00:00:44,810 --> 00:00:46,620
.أحب الأمر على هذا الحال

10
00:00:46,620 --> 00:00:48,530
.أود الاستمرار بالحلم بهذه الطريقة

11
00:00:49,410 --> 00:00:52,320
.أنا أُحبك بهذه الطريقة

12
00:00:53,360 --> 00:00:54,460
.هيميكو

13
00:02:29,910 --> 00:02:33,760
.إذا ابتعد في المسح التالي، فلن يكون هنالك حاجةٌ للقتال

14
00:02:45,850 --> 00:02:46,820
.اللعنة

15
00:02:53,570 --> 00:02:54,460
ماذا؟

16
00:02:54,460 --> 00:02:56,760
.لم يستخدم بيم، بل استخدم سكّينًا لمهاجمتي

17
00:02:58,160 --> 00:02:59,790
!لا تتحرك

18
00:02:59,790 --> 00:03:01,520
لِمَ هاجمتني؟

19
00:03:01,520 --> 00:03:05,180
!ألا تعتقد أن محاولة قتل بعضنا حماقة؟

20
00:03:06,090 --> 00:03:09,530
.توقف عن هذا، واعمل معنا

21
00:03:09,530 --> 00:03:11,140
.دعنا نهرب معًا

22
00:03:11,930 --> 00:03:13,280
كيف؟

23
00:03:14,110 --> 00:03:15,240
...هذا

24
00:03:17,210 --> 00:03:18,720
ليس لديك خُطة، إذن؟

25
00:03:20,240 --> 00:03:22,470
!لا يُمكنك هزيمة بيم بسكين

26
00:03:23,330 --> 00:03:25,860
أولًا إقناع ثم تهديد؟

27
00:03:26,650 --> 00:03:30,230
.أكره الأطفال الأنانيين أمثالك أكثر من أي شيء آخر

28
00:03:30,890 --> 00:03:32,460
.قل ما شئت

29
00:03:32,460 --> 00:03:34,400
.أنا مُغادر

30
00:03:34,400 --> 00:03:35,860
...إن حاولت ملاحقتي

31
00:03:45,780 --> 00:03:46,750
.إنّهُ الشخص الذي رصدتُه حينها

32
00:03:49,080 --> 00:03:50,800
هل يعملون معًا؟

33
00:03:57,990 --> 00:03:59,550
!انفجار

34
00:03:59,550 --> 00:04:02,240
إنه في المكان الذي ذهب إليه ساكاموتو-هان، أليس كذلك؟

35
00:04:02,240 --> 00:04:03,880
.آمل أن يكون على ما يُرام

36
00:04:07,670 --> 00:04:10,740
.لديه ثلاثة أنواع من البيم

37
00:04:10,740 --> 00:04:13,940
!رغم كل ما تفوهت به، أنت قاتلٌ أيضًا

38
00:04:17,950 --> 00:04:21,660
!ليس هنالك فائدة في إضاعة البيم عليه

39
00:04:21,660 --> 00:04:25,180
.ماياموتو-سان، اطعنه بسكينك

40
00:04:25,750 --> 00:04:27,410
...إن أردت، يُمكنني

41
00:04:33,130 --> 00:04:35,380
!اللعنة! ما الذي فعلته؟

42
00:04:35,380 --> 00:04:37,220
!مـ-مهلًا

43
00:04:37,700 --> 00:04:39,720
.قوّة سلاح التخدير بدأت تضعف

44
00:04:39,720 --> 00:04:42,190
!اللعنة

45
00:04:42,190 --> 00:04:43,500
...ذلك الشاب اللعين

46
00:04:43,500 --> 00:04:46,260
...ماياموتو-سان، اسرع بالذهاب خلفه

47
00:04:46,260 --> 00:04:48,880
.لقد كُنتُ أُخطط لتركه يذهب

48
00:04:50,010 --> 00:04:54,020
،فقد قال لي قبل قليل

49
00:04:54,020 --> 00:04:56,990
."اعمل معنا"

50
00:04:58,070 --> 00:05:01,070
.إنّ لديه أصدقاء

51
00:05:03,450 --> 00:05:05,240
!ساكاموتو-هان

52
00:05:05,240 --> 00:05:07,460
.لقد استغرقت الكثير من الوقت

53
00:05:07,460 --> 00:05:08,800
أأنت بخير؟

54
00:05:09,870 --> 00:05:11,760
،أنا بخير

55
00:05:11,760 --> 00:05:13,240
.لكنّهم أخذوا البيم خاصّتي

56
00:05:13,890 --> 00:05:16,380
أنت لم تدعهم يلحقون بك، أليس كذلك؟

57
00:05:16,930 --> 00:05:18,360
.لا بأس

58
00:05:18,360 --> 00:05:20,400
.سلكتُ أطول طريقٍ وجدته للعودة إلى هنا

59
00:05:20,990 --> 00:05:23,980
.وأيضًا هم لم يستخدموا الرادار

60
00:05:23,980 --> 00:05:25,640
.لابد أن يكونوا قد فقدوا أثري الآن

61
00:05:26,010 --> 00:05:27,300
رادار؟

62
00:05:27,300 --> 00:05:28,340
!كلا

63
00:05:28,340 --> 00:05:30,890
!يُمكنهم استخدام آثار الأقدام أو ما شابه ذلك

64
00:05:30,890 --> 00:05:33,440
.كلا، لا أستطيع البقاء هُنا

65
00:05:34,230 --> 00:05:37,230
.سأُغادر، أعد إليَّ حقائبي

66
00:05:37,230 --> 00:05:38,300
.انتظري

67
00:05:38,300 --> 00:05:39,940
.هنالكَ صندوقٌ واحدٌ فقط

68
00:05:39,940 --> 00:05:41,350
.إذن أعطني إياه

69
00:05:41,350 --> 00:05:42,490
...أنتِ

70
00:05:43,510 --> 00:05:44,520
ماذا؟

71
00:05:49,170 --> 00:05:50,560
.لا تتحركوا

72
00:05:51,250 --> 00:05:52,760
كـ-كيف عثرت علينا؟

73
00:05:52,760 --> 00:05:54,940
.لقد كُنتُ مُرتزقًا

74
00:05:54,940 --> 00:05:58,420
.تتبع أحدهم في الغابة أمرٌ سهل بالنسبة لي

75
00:05:58,970 --> 00:06:00,920
.لقد التقينا مُجددًا، أيّتها الفتاة الصغيرة

76
00:06:01,590 --> 00:06:05,050
...عندما رأيتُ مُسدس التخدير خاصّته، أدركت

77
00:06:05,550 --> 00:06:08,430
.أنني إن تعقّبتُه فسوف ألقاكِ مُجددًا

78
00:06:11,190 --> 00:06:14,320
أليست هذه هي البيم والطعام الذان أخذتيهما منّي؟

79
00:06:14,320 --> 00:06:15,770
.سوف أسترجعهما

80
00:06:16,290 --> 00:06:19,190
بالمناسبة، ألم يكن ذلك السمين آكيشي معكِ؟

81
00:06:21,090 --> 00:06:22,920
لقد قتلتيه، صحيح؟

82
00:06:22,920 --> 00:06:25,110
ألديكِ رقاقته؟

83
00:06:27,070 --> 00:06:28,940
!لم تكن أنا

84
00:06:28,940 --> 00:06:30,910
!لم أقم بشيءٍ خاطئ

85
00:06:30,910 --> 00:06:32,700
.لا أعلم أين هي رقاقته

86
00:06:32,700 --> 00:06:34,710
!ليست لدي

87
00:06:34,710 --> 00:06:36,020
.لا بأس

88
00:06:36,020 --> 00:06:38,000
.سأنزع ثيابكِ وأبحث عنها فقط

89
00:06:39,130 --> 00:06:40,200
!توقّف

90
00:06:42,670 --> 00:06:44,360
.دعنا وشأننا

91
00:06:44,360 --> 00:06:45,800
!ابتعد من هنا

92
00:06:46,760 --> 00:06:48,760
ألم تفهم بعد؟

93
00:06:49,590 --> 00:06:52,620
.هذه الجزيرة كالجحيم، إمّا أن تعيش أو تموت

94
00:06:53,210 --> 00:06:55,520
.من المُحال أن تهرب بنفسك

95
00:06:56,250 --> 00:07:00,400
.الطريقة الوحيدة هي قتل الآخرين وأخذ رقاقتهم

96
00:07:01,210 --> 00:07:04,760
ألا تُريد الحصول على ثمانية رقاقات ومُغادرة هذا المكان؟

97
00:07:05,350 --> 00:07:10,450
.إن سألتني، فإن الذين يلعبون اللعبة هُم العاقلون

98
00:07:11,950 --> 00:07:12,980
!اخرس

99
00:07:12,980 --> 00:07:14,420
!اخرس! اخرس

100
00:07:14,950 --> 00:07:19,110
!مهما كان ما يحدث، ليس لديك مُبرر للقتل

101
00:07:19,110 --> 00:07:21,550
.هذه لعبةٌ أعدّها شخصٌ ما

102
00:07:21,550 --> 00:07:25,720
.لابُد من وجود ثغرات مُخلّة بموازين لعبة بهذا الحجم في مكانٍ ما

103
00:07:26,150 --> 00:07:31,220
.لقد عملتُ كمُصحح أخطاء برمجية لتيرانوس اليابان، الأشخاص الذين قد يكونون خلف هذا الأمر

104
00:07:31,220 --> 00:07:33,440
!لذا يُمكنني معرفة ذلك بطريقةٍ ما

105
00:07:34,150 --> 00:07:36,080
.هذه اللعبة ليست كاملة

106
00:07:36,080 --> 00:07:37,730
.لا زالت قيد التطوير

107
00:07:38,130 --> 00:07:39,730
!يوجد ثغرة في مكانٍ ما

108
00:07:39,730 --> 00:07:40,980
.يُمكنني معرفة ذلك

109
00:07:43,170 --> 00:07:47,920
.خُطتك ليست سوى تفاؤل شابٍ أناني

110
00:07:47,920 --> 00:07:49,240
.لستُ مُهتمًا في ذلك

111
00:07:50,070 --> 00:07:50,660
.مُت

112
00:08:09,670 --> 00:08:11,640
.الحصول على تلك الرقاقة سيكون مُزعجًا

113
00:08:17,230 --> 00:08:19,270
أليس كذلك أيّتها الفتاة الصغيرة؟

114
00:08:21,930 --> 00:08:25,940
...هيميكو

115
00:08:31,390 --> 00:08:33,160
...هـ-هيميكو

116
00:08:34,970 --> 00:08:35,700
.مؤلم

117
00:08:46,120 --> 00:08:48,480
!أسقطتُ من هناك؟

118
00:08:49,530 --> 00:08:51,050
!الآخرين

119
00:08:55,370 --> 00:08:56,060
!تايرا-سان؟

120
00:08:58,970 --> 00:09:01,310
...سـ-ساكاموتو-هان

121
00:09:01,830 --> 00:09:03,310
.ينبغي أن نوقف النزيف

122
00:09:03,850 --> 00:09:05,970
!الحقيبة... والبيم

123
00:09:05,970 --> 00:09:07,570
هل أخذهم؟

124
00:09:08,890 --> 00:09:09,900
أين الفتاة؟

125
00:09:11,910 --> 00:09:14,460
أيعقل أنّه أخذها؟

126
00:09:16,330 --> 00:09:17,330
...مُحال

127
00:09:20,110 --> 00:09:21,700
.إنها غلطتي

128
00:09:21,700 --> 00:09:23,700
...كل هذا

129
00:09:33,750 --> 00:09:34,720
!بتوم؟

130
00:09:34,720 --> 00:09:36,560
ملابس تنكّرية من نوع ثيتا؟

131
00:09:39,410 --> 00:09:40,430
...هيميكو

132
00:09:41,810 --> 00:09:42,690
أذلك هو اسمها؟

133
00:09:43,940 --> 00:09:45,440
...مُحال، إذن فهي

134
00:09:46,110 --> 00:09:47,460
هيميكو؟

135
00:09:50,310 --> 00:09:51,580
...عليّ أن أذهب

136
00:09:52,130 --> 00:09:53,080
.وأُنقذها

137
00:09:53,990 --> 00:09:54,950
...هيميكو

138
00:09:57,010 --> 00:09:58,580
!كلا! لا تذهب

139
00:09:59,210 --> 00:10:01,000
.أرجوك لا تذهب

140
00:10:01,000 --> 00:10:03,210
.لا يُمكنني تحمّل المزيد من الانتظار

141
00:10:03,970 --> 00:10:07,820
.نحن بحاجة لمناشف نظيفة وماء من أجلك

142
00:10:09,670 --> 00:10:11,620
.سأعود بأسرع وقت

143
00:10:11,620 --> 00:10:12,430
.أعدك

144
00:10:12,430 --> 00:10:13,800
!كلا

145
00:10:13,800 --> 00:10:15,960
!كلا، كلا، كلا، كلا، كلا

146
00:10:15,960 --> 00:10:18,800
.هذه المرّة، سينتهي أمري

147
00:10:19,220 --> 00:10:22,640
...إن تركتني هُنا، فأنا.... فأنا

148
00:10:22,640 --> 00:10:24,730
.فلن أتمكّن من البقاء عاقلًا

149
00:10:25,290 --> 00:10:28,260
!أرجوك، ابقَ هُنا

150
00:10:33,770 --> 00:10:34,740
...سا

151
00:10:35,490 --> 00:10:38,740
!ساكاموتو-هان

152
00:10:53,890 --> 00:10:55,150
.مُنعش

153
00:10:55,150 --> 00:10:56,220
.أشعر بتحسّن

154
00:10:55,270 --> 00:10:56,220
!توقّف

155
00:10:56,220 --> 00:10:58,220
!إنّهُ طعامي

156
00:11:02,890 --> 00:11:04,600
...أيّتها الغبيّة

157
00:11:04,600 --> 00:11:07,340
.لقد كان مُلكي قبل أن تسرقيه

158
00:11:07,340 --> 00:11:10,010
.اسرع واقتلني فحسب

159
00:11:10,010 --> 00:11:12,150
.لن أُقاوم

160
00:11:13,350 --> 00:11:14,650
...في المقابل

161
00:11:15,310 --> 00:11:18,100
.دعني أمت وأنا نقيّة

162
00:11:22,530 --> 00:11:26,370
أتظنين أنني جلبتُكِ إلى هنا لهذا السبب؟

163
00:11:26,790 --> 00:11:30,500
.يوجد الكثير من أساليب المُتعة في ساحة المعركة

164
00:11:33,030 --> 00:11:34,960
.تعذيب العدو

165
00:11:36,890 --> 00:11:37,970
.السلخ

166
00:11:39,270 --> 00:11:41,720
.تقشير البشرة كالتفاح

167
00:11:42,210 --> 00:11:47,230
.نزع الجلد بأكمله، ورؤية مدّة البقاء على قيد الحياة

168
00:11:47,670 --> 00:11:52,230
.سأُبقي جسدكِ نقيًا كما أردتِ

169
00:11:55,230 --> 00:11:57,360
!كلا

170
00:11:59,170 --> 00:12:00,160
ماذا؟

171
00:12:00,160 --> 00:12:02,120
كان ذلك رادار للتو، صحيح؟

172
00:12:03,030 --> 00:12:05,160
ذلك العجوز ذو لهجة كانساي؟

173
00:12:05,160 --> 00:12:07,370
أم أنّهُ لاعبٌ آخر؟

174
00:12:08,890 --> 00:12:11,040
!لا تتجرأي على فعل شيء

175
00:12:13,330 --> 00:12:16,580
.كلاهما أطلقا الرادار خاصّتهما مرّتين

176
00:12:16,580 --> 00:12:18,300
ألا تظن أنّها إشارة من نوعٍ ما؟

177
00:12:18,870 --> 00:12:21,050
...هذا يعني بأنّ ذلك

178
00:12:22,530 --> 00:12:25,360
.الشاب لا يزال حيًّا

179
00:12:32,790 --> 00:12:35,020
.لقد توقّفت العاصفة

180
00:12:35,790 --> 00:12:37,780
.سوف يكون هنا عمّا قريب

181
00:12:38,330 --> 00:12:40,840
.أنت توجّه للقاعة الأماميّة

182
00:12:40,840 --> 00:12:42,720
.أنا سألتف من اليسار

183
00:12:42,720 --> 00:12:45,620
.لقد أخذنا كُلَّ البيم خاصّته

184
00:12:45,620 --> 00:12:47,790
.وهو أعزل، لذا لا تُخفق

185
00:12:51,710 --> 00:12:53,040
.اعتمد عليّ

186
00:12:53,590 --> 00:12:57,060
.قنابلك تستغرق 10 ثوانٍ قبل أن تنفجر

187
00:12:57,060 --> 00:13:00,640
.قم بضبطها لثلاث ثوانٍ حتى لا تخفق

188
00:13:00,640 --> 00:13:01,520
!حسنًا

189
00:13:04,890 --> 00:13:05,810
.حسنٌ

190
00:13:10,890 --> 00:13:13,180
.إنّهُ يتوجّه نحو ناتسومي

191
00:13:13,730 --> 00:13:14,810
.ذلك الأبله

192
00:13:14,810 --> 00:13:17,320
.يُمكنني معرفة مكانك بالتحديد

193
00:13:19,170 --> 00:13:21,320
ناتسومي، هل نِلتَ منه؟

194
00:13:25,130 --> 00:13:27,140
.إنّهُ يقترب

195
00:13:27,140 --> 00:13:29,310
هل أخفق ناتسومي؟

196
00:13:29,310 --> 00:13:30,520
.كلا، لم يُخفق

197
00:13:30,520 --> 00:13:33,320
...لو لم يكن هنالكَ انفجارٌ آخر

198
00:13:33,320 --> 00:13:34,830
هل نال من ناتسومي؟

199
00:13:39,170 --> 00:13:41,240
.إنّهُ يتوجّه نحوي مُباشرةً

200
00:13:42,190 --> 00:13:44,160
.هذا يعني أنّهُ سيمر من هنا

201
00:13:44,160 --> 00:13:46,260
.سأُجهزُ عليه بهجومٍ واحد

202
00:13:48,270 --> 00:13:50,350
أتظن أنني لا أستطيع سماعك؟

203
00:13:51,230 --> 00:13:51,980
!نِلتُ منك

204
00:13:56,390 --> 00:13:57,720
أين هو؟

205
00:13:57,720 --> 00:13:58,690
ماذا حدث؟

206
00:13:59,310 --> 00:14:02,570
.لقد رأيتُه لذا هاجمت

207
00:14:02,570 --> 00:14:04,980
.لكنّهُ اختفى تمامًا

208
00:14:04,980 --> 00:14:08,580
أمن المُمكن أن يتبخّر شخصٌ ما ولا يتبقّى منهُ شيء؟

209
00:14:08,990 --> 00:14:10,580
!طبعًا لا، أيّها الأبله

210
00:14:10,580 --> 00:14:12,320
!ابحث جيّدًا

211
00:14:20,890 --> 00:14:24,120
.أنا مُتأكّد أنّها كانت بالقرب من هنا

212
00:14:37,310 --> 00:14:38,780
.كان ذلك وشيكًا

213
00:14:38,780 --> 00:14:41,160
.كان هذا فخًا من طرازٍ عسكري

214
00:14:42,270 --> 00:14:44,030
!لكنني تفاديتُه

215
00:14:44,410 --> 00:14:47,530
.وحصلتُ على بيمٍ ثمينة

216
00:14:48,090 --> 00:14:51,700
.البيم التي تُعطّل تُصبح مُلكًا للشخص الذي عطّلها كائنَ من كان

217
00:14:52,390 --> 00:14:54,420
.أثبتُ ذلك من خلال البيم خاصّتها

218
00:14:57,050 --> 00:14:59,660
.لرُبّما يُمكنني صنع مُعجزة بهذه

219
00:15:18,370 --> 00:15:19,730
،أتيتُ لإنقاذكِ

220
00:15:20,270 --> 00:15:21,240
.هيميكو

221
00:15:24,790 --> 00:15:27,200
كيف عرفتَ اسمي؟

222
00:15:28,890 --> 00:15:32,500
.آسف، رأيتُ خلفيّة هاتفكِ

223
00:15:33,640 --> 00:15:37,340
لعبتِ بتوم باسم "هيميكو"، صحيح؟

224
00:15:37,960 --> 00:15:39,540
.أ-أجل

225
00:15:40,130 --> 00:15:41,710
.رغم أنّهُ ليس اسمي الحقيقي

226
00:15:42,390 --> 00:15:44,610
.اسمي هو ساكاموتو

227
00:15:44,610 --> 00:15:45,970
أسمعتي بي من قبل؟

228
00:15:46,650 --> 00:15:49,970
.من المُحتمل أننا لعبنا معًا كثيرًا

229
00:15:56,010 --> 00:15:57,630
.أعرف الاسم

230
00:15:57,630 --> 00:16:00,230
،إن كُنتَ تعني ساكاموتو اللاعب ذا التصنيف العالمي

231
00:16:00,230 --> 00:16:02,380
.فقد كُنتَ مشهورًا بين أصدقائي

232
00:16:03,060 --> 00:16:05,380
.لكن الاسم هو كُل ما أعرفه

233
00:16:06,090 --> 00:16:08,300
.لم نلعب معًا من قبل قط

234
00:16:13,350 --> 00:16:15,930
!أكانت شخصًا آخر؟

235
00:16:15,930 --> 00:16:19,580
.أنا... لا ألعب كثيرًا

236
00:16:20,990 --> 00:16:22,600
.بالطبع

237
00:16:22,600 --> 00:16:25,160
.بيع من تلك اللعبة ثلاثة ملايين نسخة

238
00:16:25,160 --> 00:16:27,260
.ليس مُستغربًا أن يتشارك لاعبون نفس الاسم

239
00:16:28,030 --> 00:16:33,260
.لكنني تشجّعت للقدوم كل هذه المسافة إلى هنا لأنني ظننتُ أنّها كانت هيميكو

240
00:16:34,110 --> 00:16:35,260
،لذا من الآن فصاعدًا

241
00:16:36,250 --> 00:16:38,600
.سأثق بما يُمليه عليَّ قلبي وحسب

242
00:16:44,310 --> 00:16:48,100
حتى وإن لم يكن اسمكِ الحقيقي، أيُمكنني مُناداتكِ بهيميكو؟

243
00:16:48,810 --> 00:16:51,040
.لا أُمانع

244
00:16:51,040 --> 00:16:52,280
.شُكرًا

245
00:16:54,030 --> 00:16:56,820
.ذلك الوغد مع الفتاة

246
00:16:56,820 --> 00:16:59,790
!هو لم يظهر على الرادار إطلاقًا

247
00:17:00,150 --> 00:17:02,600
تجاوز الفخ ودخل الغرفة؟

248
00:17:02,600 --> 00:17:05,040
...سُحقًا... الرادار والبيم

249
00:17:05,710 --> 00:17:08,780
.علمتُ أنّ هذا كان الشيء الوحيد الذي يُمكنني الوثوق به

250
00:17:10,750 --> 00:17:13,180
.يوجد طريقان وحيدان للأسفل من تلك الغرفة

251
00:17:13,750 --> 00:17:15,160
.اذهب أنت من هذا الاتجاه

252
00:17:15,160 --> 00:17:16,820
.سأتولّى أنا الاتجاه الآخر

253
00:17:16,820 --> 00:17:18,900
.لا تُخفق هذه المرّة

254
00:17:18,900 --> 00:17:19,800
!حسنًا

255
00:17:19,800 --> 00:17:21,310
!ياهوو

256
00:17:22,530 --> 00:17:26,500
!قسم قانون العقوبات رقم 361 المادة الأولى... الدفاع عن النفس

257
00:17:26,500 --> 00:17:33,640
!اتّخاذ الإجراءات الضرورية للدفاع عن النفس في مواجهة أيّ تهديد لا يُعاقب عليه القانون

258
00:17:34,320 --> 00:17:38,830
!الدفاع عن النفس! الدفاع عن النفس

259
00:17:39,670 --> 00:17:41,420
!وجدتك

260
00:17:42,500 --> 00:17:44,420
!مُت، مُت، مُت

261
00:17:44,420 --> 00:17:46,550
!غير مسلح وغد

262
00:17:47,630 --> 00:17:50,880
.لا يُمكنني الموت في عالمٍ جنونيٍ كهذا

263
00:17:53,290 --> 00:17:56,510
!أنا من صفوة المُحامين

264
00:17:59,530 --> 00:18:00,700
!أحمق

265
00:18:00,700 --> 00:18:03,140
...ذلك الطريق يؤدّي لنهاية مسدودة

266
00:18:11,150 --> 00:18:13,760
.لستَ سيئًا أيّها الشاب

267
00:18:13,760 --> 00:18:15,400
.أنا مُنبهر

268
00:18:15,400 --> 00:18:17,490
.لكنَّ الفتاة أصبحت في حوزتي

269
00:18:18,990 --> 00:18:20,980
.أُخرج

270
00:18:20,980 --> 00:18:24,250
.سأمنحك فُرصة، قتالٌ بلا أسلحة

271
00:18:26,370 --> 00:18:28,580
ليست صفقةً سيّئة، صحيح؟

272
00:18:28,580 --> 00:18:30,000
.هيّا، اخرج الآن

273
00:18:30,570 --> 00:18:32,300
...إن كان بإمكاني الحصول على تلك

274
00:18:32,760 --> 00:18:36,260
.حقيبتك كانت تحتوي على 3 أنواع من البيم

275
00:18:36,260 --> 00:18:39,250
.ينبغي أن يكون لديك رقاقتين على الأقل

276
00:18:39,250 --> 00:18:42,920
.وهذه الفتاة قتلت ذلك السمين آكيشي، لذا فهي تملك واحدة أيضًا

277
00:18:42,920 --> 00:18:44,620
!أخبرتُك أنني لا أمتلكها

278
00:18:44,620 --> 00:18:46,770
أما زِلتِ تلعبين دور الغبيّة؟

279
00:18:47,350 --> 00:18:48,660
.لا بأس

280
00:18:48,660 --> 00:18:51,480
.ينبغي أن يكون لديكم ثلاثة رقاقات

281
00:18:51,480 --> 00:18:53,780
.حالما أقتلكم، يُمكنني أن أستغرق وقتي بالبحث

282
00:18:53,780 --> 00:18:56,840
،ناتسومي، الرجل ذا لهجة الكانساي

283
00:18:56,840 --> 00:19:00,200
.والشخص الذي قتلتُه من قبل، يجعلون المجموع ثمانية رقاقات

284
00:19:00,200 --> 00:19:01,790
.هذا كل ما أحتاجه

285
00:19:02,590 --> 00:19:05,220
!لذا عجّل بالخروج

286
00:19:05,220 --> 00:19:09,280
.إن هزمتني فيُمكنك أخذ كُل الرقاقات الثمانية أيضًا

287
00:19:14,470 --> 00:19:15,420
.الآن

288
00:19:25,310 --> 00:19:27,270
!تلك السكين هي أوّل شيء سيسعى إليه الناس

289
00:19:27,810 --> 00:19:29,020
!اللعنة

290
00:19:40,930 --> 00:19:42,890
.لن أدعك تموت بسهولة

291
00:19:42,890 --> 00:19:44,660
،لقد قُلت قتالًا بلا أسلحة

292
00:19:44,660 --> 00:19:47,820
.لكنّكَ تجاهلتني واتجهت نحو السكين

293
00:19:47,820 --> 00:19:49,900
.هذا مُخالف للقوانين

294
00:19:53,010 --> 00:19:56,170
أهذه هي نهاية... حياتي؟

295
00:19:57,110 --> 00:19:59,220
.الحياة لم تسر كما أردت

296
00:19:59,220 --> 00:20:02,930
.ظننتُ أنّ ذلك سيحدث بطريقةٍ ما ولكنّه لم يحدث

297
00:20:03,470 --> 00:20:05,680
.حياة مُهدرة على الألعاب

298
00:20:06,790 --> 00:20:09,720
...لو كان بإمكاني على الأقل لقاء هيميكو الحقيقيّة

299
00:20:16,320 --> 00:20:17,530
!ما الذي تفعلينه؟

300
00:20:21,070 --> 00:20:22,600
...يا هذه

301
00:20:22,600 --> 00:20:23,410
!اهرب

302
00:20:23,410 --> 00:20:24,830
!بسُرعة

303
00:20:24,830 --> 00:20:26,360
...ماذا

304
00:20:28,430 --> 00:20:29,120
ماذا؟

305
00:20:29,120 --> 00:20:31,120
!اركض! من هذا الطريق

306
00:20:31,630 --> 00:20:34,010
لقد شغّلت القنبلة؟

307
00:20:37,930 --> 00:20:39,140
!الغاز قادم

308
00:20:39,140 --> 00:20:39,880
!أين المخرج؟

309
00:20:46,620 --> 00:20:47,700
!نهاية مسدودة؟

310
00:20:47,700 --> 00:20:48,540
.مُحال

311
00:20:57,190 --> 00:20:58,440
ما الذي ستفعله؟

312
00:21:02,160 --> 00:21:02,950
.مُذهل

313
00:21:07,190 --> 00:21:07,700
!تعالي

314
00:21:12,750 --> 00:21:13,290
.حسنًا

315
00:21:18,130 --> 00:21:19,800
.قليلًا بعد

316
00:21:22,760 --> 00:21:23,260
ماذا؟

317
00:21:25,450 --> 00:21:28,020
.سأُريكِ الجحيم

318
00:21:28,470 --> 00:21:32,270
.الجحيم الحقيقي الذي رأيتُه في ساحة المعركة

319
00:21:33,210 --> 00:21:34,700
.إنّهُ جيّد

320
00:21:35,250 --> 00:21:36,400
...لكن

321
00:21:40,090 --> 00:21:41,480
قُنبلة موقوته؟

322
00:21:41,480 --> 00:21:42,960
لِمَ قد يفعل ذلك؟

323
00:21:44,780 --> 00:21:46,520
.ستستغرق 10 ثوانٍ حتّى تنفجر

324
00:21:46,520 --> 00:21:48,170
.لديّ الكثير من الوقت

325
00:21:48,170 --> 00:21:49,580
...سأجعلها مُلكي وأستخدمها

326
00:21:51,150 --> 00:21:54,290
.قم بضبطها لثلاث ثوانٍ حتى لا تخفق

327
00:21:54,290 --> 00:21:56,790
...لقد أخذ قنابل ناتسومي

328
00:22:09,830 --> 00:22:11,180
.آ-آسف

329
00:22:17,090 --> 00:22:18,180
!مُذهل

330
00:22:18,180 --> 00:22:19,120
.جميل

331
00:22:19,120 --> 00:22:20,190
.كما لو أنّهُ فيلم

332
00:22:20,990 --> 00:22:25,540
!ساكاموتو-كُن ذلك هزم مياموتو ماساشي الذي كان فوزهُ راجحًا

333
00:22:26,130 --> 00:22:27,200
ما رأيكم أيّها الجميع؟

334
00:22:29,530 --> 00:22:33,880
!في الجولة الثالثة، موازين اللعبة قد انقلبت حقًا

335
00:24:06,660 --> 00:24:10,020
،بعد أن تخلصنا أنا وهيميكو بالكاد من اللاعبين الأعداء

336
00:24:10,460 --> 00:24:12,230
.تهديد جديد يقترب

337
00:24:12,850 --> 00:24:15,230
...شبحٌ أبيض قالت هيميكو أنّها رأته في الظلام

338
00:24:15,900 --> 00:24:19,780
أيعني ذلك أنّ هنالك عدوٌ جديد؟

339
00:24:19,780 --> 00:24:20,530
...أم أنّهُ