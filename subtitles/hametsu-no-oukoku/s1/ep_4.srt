1
00:00:08,020 --> 00:00:09,980
!فلتثبتنّه جميعكنّ

2
00:00:10,280 --> 00:00:11,500
!ثبتنّه

3
00:00:15,640 --> 00:00:19,340
.كلٍ من دقات قلبه وضغط دمه ودرجة حرارته آخذة في الارتفاع

4
00:00:19,340 --> 00:00:21,240
...على هذا المعدل، فإن قلبه

5
00:00:21,960 --> 00:00:26,250
.مثلما توقعت لن يتحمل أي بشري طور النقل المتغاير

6
00:00:35,370 --> 00:00:38,260
.لا تفقدنّ الأمل

7
00:00:38,260 --> 00:00:40,160
.أوفيليا-ساما

8
00:00:47,280 --> 00:00:50,280
.سأحفز دماغه حتى أعيد له وعيه

9
00:02:48,420 --> 00:02:51,520
...كـ-كلو..ي

10
00:03:06,620 --> 00:03:09,230
.سحر النسخ: إبطال الموت

11
00:03:12,940 --> 00:03:14,440
سحر النسخ؟

12
00:03:14,440 --> 00:03:17,790
ما الذي يجري لي؟

13
00:03:21,070 --> 00:03:22,740
.أنا أدعى آنا

14
00:03:22,740 --> 00:03:25,770
.تسللت إلى الإمبراطورية مع دوروكا

15
00:03:27,070 --> 00:03:28,560
...كل هذا

16
00:03:28,990 --> 00:03:31,800
.جزء من خطة إحياء كلوي

17
00:03:33,440 --> 00:03:35,400
.سأخرجك من هذا المكان

18
00:03:36,890 --> 00:03:38,320
من أنتِ؟

19
00:03:38,320 --> 00:03:39,690
.آجل سؤالك لما بعد

20
00:03:40,430 --> 00:03:43,450
.أنقليه من فضلك يا أوفيليا-ساما

21
00:03:47,700 --> 00:03:48,620
...ما هذا

22
00:03:58,440 --> 00:04:00,490
.آسفة يا دوروكا

23
00:04:14,920 --> 00:04:21,240
.شكرًا للقتال إلى جانبنا

24
00:04:27,310 --> 00:04:29,040
من أنتِ أيتها اللعينة؟

25
00:04:31,600 --> 00:04:34,590
...هكذا إذن، هذه

26
00:04:37,430 --> 00:04:40,540
.نعم، هذا موطن الساحرات

27
00:04:59,920 --> 00:05:03,110
.تبدو بخير حال ما دمت غادرتَ فراشك

28
00:05:08,410 --> 00:05:09,300
.أجل

29
00:05:10,200 --> 00:05:11,500
.هذا مطمئن

30
00:05:11,500 --> 00:05:15,160
.كانت كلوي ستحزن لو أصابك مكروه

31
00:05:17,440 --> 00:05:20,120
أقد قابلتماها؟

32
00:05:20,120 --> 00:05:21,390
.بالتأكيد

33
00:05:21,390 --> 00:05:24,810
.كانت تعاملنا بلطف عندما كنّا أطفالًا

34
00:05:24,810 --> 00:05:26,380
.لهذا نحبها

35
00:05:27,530 --> 00:05:29,090
.هكذا إذن

36
00:05:47,430 --> 00:05:50,000
.لا داعِ لدفعي أستطيع المشي

37
00:05:52,400 --> 00:05:55,680
.هذا الموطن بعيد عن أيادي الأنس

38
00:05:56,520 --> 00:06:02,040
.طريقة وصولك إلى هنا أكبر مما يستوعبه عقلك

39
00:06:03,800 --> 00:06:07,180
.تعرض جسدك إلى ضغطٍ كبير

40
00:06:15,900 --> 00:06:17,070
.أوفيليا-ساما

41
00:06:19,400 --> 00:06:21,810
.حصاد هذا الموسم وفير

42
00:06:28,190 --> 00:06:29,900
ماذا فعلتن لي؟

43
00:06:31,920 --> 00:06:32,580
...ما هذا

44
00:06:35,860 --> 00:06:38,600
،مجرد دعوة لحضورك هنا

45
00:06:40,490 --> 00:06:43,330
.يا تلميذ كلوي، أدونيس

46
00:06:43,720 --> 00:06:46,210
تعرفين كلوي إذن؟

47
00:06:46,720 --> 00:06:48,030
.بالطبع

48
00:06:48,440 --> 00:06:52,220
.كل ساحرة في هذا الموطن تعرفها

49
00:06:52,220 --> 00:06:58,290
.كانت لا مثيل لها في القوة والذكاء والتفاؤل واللطف

50
00:06:58,290 --> 00:07:05,240
.رغم أنها ساحرة جليد إلا أنها كان لها قلبًا دافئًا مثل أشعة الشمس

51
00:07:06,280 --> 00:07:12,740
.ولكنها طُردت من موطن الساحرات

52
00:07:12,740 --> 00:07:15,840
...تقصدين بأنكِ أنتِ من طردها

53
00:07:16,360 --> 00:07:19,740
.بسبب تعلميها السحر لبشري

54
00:07:22,800 --> 00:07:25,520
.إذن أخبرتك كلوي بهذا الخصوص

55
00:07:26,410 --> 00:07:28,930
.لا، بل أنا من أستنتجه

56
00:07:29,410 --> 00:07:31,450
.فقد عشت معها عمرًا

57
00:07:34,350 --> 00:07:39,890
.السحر للساحرات أمر لا غنى عنه، إنه روحنا

58
00:07:39,890 --> 00:07:47,400
.فهو يمثل الألفة والتفاني اللذان منحتهما الآلهة لنا كي نرشد الأنس

59
00:07:47,400 --> 00:07:51,900
.فهو شيء يجب ألا يتعلمه بشر

60
00:07:51,900 --> 00:07:55,030
.لكن كلوي أتخذت بشري تلميذًا لها

61
00:07:55,030 --> 00:07:58,160
،لم نفهم ما تنوي عليه

62
00:07:58,160 --> 00:08:06,680
.وآنذاك توسلنا جميعنا أن تتخلى عن تلميذها وتعود إلينا

63
00:08:06,680 --> 00:08:10,670
.ولكنها كانت تردّد كلمة واحدة

64
00:08:11,080 --> 00:08:12,600
.سامحوني

65
00:08:14,200 --> 00:08:16,590
.هذه طباعها بلا أدنى شك

66
00:08:17,010 --> 00:08:19,330
هل انتهيتِ من سرد الماضي؟

67
00:08:20,080 --> 00:08:21,280
.أجل

68
00:08:22,250 --> 00:08:25,140
.لا بد أنك تريد هذه

69
00:08:28,770 --> 00:08:31,520
!ريشتي

70
00:08:32,800 --> 00:08:34,570
.أنقلعي

71
00:08:39,640 --> 00:08:41,040
!أعطيني إياها

72
00:08:43,030 --> 00:08:49,830
.ريشة طائر العنقاء السحرية المزينة بريش يشبه الأمواج وعين تنين حمراء

73
00:08:49,830 --> 00:08:52,040
.تحفه فريدة

74
00:08:58,550 --> 00:09:03,290
صنعتها خصيصًا لك، ألستُ محقةً؟

75
00:09:05,310 --> 00:09:07,600
.بكل تأكيد

76
00:09:11,770 --> 00:09:13,970
اسمكِ أوفيليا؟

77
00:09:15,520 --> 00:09:18,340
هل يمكنك إحياء كلوي؟

78
00:09:19,060 --> 00:09:21,490
.الساحرات لا يكذبن

79
00:09:23,010 --> 00:09:24,250
.فهمت

80
00:09:26,320 --> 00:09:27,720
.فهمت

81
00:09:34,090 --> 00:09:36,860
ما هذا؟

82
00:09:38,090 --> 00:09:41,890
.هذه الأرض منعزلة وبعيدة عن متناول الأنس

83
00:09:41,890 --> 00:09:44,000
.إنه جرم سماوي هادئ

84
00:09:44,490 --> 00:09:46,750
،حطينا رحالنا هنا قبل عقد

85
00:09:46,750 --> 00:09:50,800
.وصار مكانًا للساحرات ليعيشن فيه بأمن وسلام

86
00:09:51,300 --> 00:09:55,130
.هذه لوناميليا، موطن الساحرات الجديد

87
00:10:07,600 --> 00:10:11,630
.العلم أظهر حقيقة الأنس

88
00:10:11,630 --> 00:10:14,250
،لعل الآلهة خلقت الأرض كروية

89
00:10:14,250 --> 00:10:17,380
،حتى لا يروا ما وراء الأفق

90
00:10:17,380 --> 00:10:20,940
.خوفًا عليهم من المستقبل

91
00:10:22,300 --> 00:10:24,430
.لا وجود للآلهة

92
00:10:25,680 --> 00:10:27,430
.لم أعد أطيق هذا

93
00:10:30,050 --> 00:10:34,980
.وهذه قبور الساحرات اللواتي قُتلنّ

94
00:10:43,530 --> 00:10:47,460
.غالبًا مفردات الأنس محدودة

95
00:10:49,550 --> 00:10:52,320
."الفجر قريب مهما طال الليل"

96
00:10:52,320 --> 00:10:54,990
."الحب واللامبالاة لا يجتمعان"

97
00:10:54,990 --> 00:10:56,660
،ولكن في أرض الواقع

98
00:10:56,660 --> 00:11:00,800
،تُنير السماء مع أقتراب الفجر

99
00:11:00,970 --> 00:11:04,580
.وعكس الحب هو الكراهية

100
00:11:05,680 --> 00:11:08,840
."الساحرات سيفسدنّ الأنس"

101
00:11:09,560 --> 00:11:14,060
.هذه المفردات التي آمن بها حاكم الأنس

102
00:11:32,050 --> 00:11:35,370
.هذه ميتو وهي الشجرة التي تلّد منها الساحرات

103
00:11:37,640 --> 00:11:40,090
هل رأيت مثلها من قبل؟

104
00:11:40,560 --> 00:11:45,160
.لا، هذه أول مرة أراها

105
00:11:47,830 --> 00:11:51,260
.كانت كلوي تمتنع الحديث بشأن أصولها

106
00:11:52,120 --> 00:11:55,360
.الساحرات ليس لهن جنس

107
00:11:55,360 --> 00:11:58,360
.فبخلاف الأنس نحن لا نتزاوج

108
00:11:59,060 --> 00:12:02,360
،تُمنح لنا الحياة عن طريق هذه الشجرة

109
00:12:02,910 --> 00:12:06,150
.مثل ثمار تحتوي على قوة الآلهة

110
00:12:06,150 --> 00:12:07,560
خيالي، صحيح؟

111
00:12:08,480 --> 00:12:10,080
.أيًا يكن

112
00:12:10,080 --> 00:12:14,290
.هذه هي الشجرة الأخيرة التي تم إنقاذها من الأرض

113
00:12:14,290 --> 00:12:18,590
.جميع الميتو الأخرى أحرقوها الأنس

114
00:12:21,150 --> 00:12:26,600
في الوقت الحالي، تعد هذه الشجرة الوحيدة
.التي تلّد الساحرات وبعثّهن إلى الحياة مجددًا

115
00:12:27,360 --> 00:12:28,970
بعثهنّ؟

116
00:12:30,730 --> 00:12:32,030
...هل يمكن

117
00:12:36,030 --> 00:12:38,130
...هل يمكن أن هذه

118
00:12:45,780 --> 00:12:47,040
كلوي؟

119
00:12:47,490 --> 00:12:49,080
أهذه كلوي؟

120
00:12:50,310 --> 00:12:57,130
.لا، ما هي إلا ساحرة تنتظر ولادتها

121
00:12:57,680 --> 00:13:01,760
.نحن نحتاج قوتك حتى تُصبح كلوي

122
00:13:02,300 --> 00:13:03,860
إلامَ ترمين؟

123
00:13:09,060 --> 00:13:15,140
.السحر عبارة عن تحويل أفكار المرء إلى واقع ملموس

124
00:13:17,080 --> 00:13:20,800
...فمثل سحر الاستدعاء المكتوب الذي تستخدمه

125
00:13:20,800 --> 00:13:26,450
.يمكنك تحويل أي فكرة في عقلك إلى واقع ملموس بناءًا على براعتك

126
00:13:26,450 --> 00:13:29,030
.بمعنى آخر، له عدة أستخدامات

127
00:13:33,110 --> 00:13:35,770
...جميع الأفكار

128
00:13:36,650 --> 00:13:38,910
.لناخذ الذكريات على سبيل المثال

129
00:13:38,910 --> 00:13:41,170
.الذكريات هي حياة بحد ذاتها

130
00:13:41,630 --> 00:13:48,880
...لو استطعت وضع ذكرياتك في تلك الثمرة، فرُبما

131
00:13:49,570 --> 00:13:52,640
وضح الأمر لك، أليس كذلك؟

132
00:13:52,640 --> 00:13:57,400
.في كلتا الحالتين أنت مفتاح إعادة بعث كلوي

133
00:13:59,890 --> 00:14:02,510
.أخبرني من فضلك عندما تجهز

134
00:14:02,510 --> 00:14:04,900
.عندها سنبدأ الطقوس

135
00:14:08,850 --> 00:14:10,260
بجدية؟

136
00:14:14,120 --> 00:14:18,310
.سحري سيُحيي كلوي

137
00:14:23,360 --> 00:14:26,790
ألستِ ساحرة النسخ تلك؟

138
00:14:27,760 --> 00:14:31,550
أهذا كل ما ستقوله؟

139
00:14:32,120 --> 00:14:34,960
ما الأمر؟ أتريديني أن أشكرك؟

140
00:14:37,160 --> 00:14:38,800
.لا بد أنك تمزح

141
00:14:39,130 --> 00:14:41,810
.لقد ماتت دوروكا من أجل إنقاذك

142
00:14:42,670 --> 00:14:44,810
.وما شأني

143
00:14:46,660 --> 00:14:49,580
ألستم من خطّط لكل هذا؟

144
00:14:49,580 --> 00:14:52,070
.لا تفرغي غضبك علي

145
00:14:54,000 --> 00:14:56,240
...ماذا؟ أنتظر لحظة

146
00:14:56,570 --> 00:14:58,440
!ما زلتُ لم أنهِ كلامي

147
00:14:58,440 --> 00:14:59,960
.أنتظر

148
00:15:00,260 --> 00:15:02,930
.أنتم يا معشر الأنس لا تحبون إلا أنفسكم

149
00:15:02,930 --> 00:15:10,760
لا بد أن السعادة تغمرك بعد معرفتك أنه يمكنك إعادة
.إحياء معلمتك قدر ما تشاء باستخدام سحرك والشجرة هذه

150
00:15:12,550 --> 00:15:19,160
لماذا خاطرنا بحيواتنا من أجل أمرؤ مثلك؟

151
00:15:20,490 --> 00:15:22,200
لماذا إذن؟

152
00:15:22,860 --> 00:15:25,260
أليس هذا بهدف الانتفاع من كلوي؟

153
00:15:25,730 --> 00:15:30,680
أليس هذا هدفكم من إنقاذي؟

154
00:15:32,440 --> 00:15:34,360
عمَّ تتحدث؟

155
00:15:34,360 --> 00:15:35,540
.لا تتصنعي الغباء

156
00:15:39,670 --> 00:15:43,120
.أصغ يا أدونيس

157
00:15:43,740 --> 00:15:48,120
.ينونّ الساحرات استغلال كلوي

158
00:15:49,080 --> 00:15:56,960
.يجب عليكما الهرب من موطن الساحرات

159
00:16:01,010 --> 00:16:02,750
...موطن الساحرات

160
00:16:02,750 --> 00:16:06,640
.تستطعنّ العيش في بيئة قاسية دون معدات لتحميكم

161
00:16:06,640 --> 00:16:10,360
.فأنتن لستن بحاجة لتشيّيد مستعمرة بهذا العتاد

162
00:16:10,900 --> 00:16:15,160
.ما هي إلا قفص لأجل حبس الأنس فيه

163
00:16:16,960 --> 00:16:22,160
،تختطفن الأطفال والعبيد من البشر وتنقلنّهم عبر طور النقل المتغاير إلى هنا

164
00:16:22,160 --> 00:16:26,130
.وتعلمونهم سحر الاستدعاء المكتوب بهدف تجنيدهم

165
00:16:26,610 --> 00:16:29,800
.لأن الساحرات على شفا الانقراض

166
00:16:29,800 --> 00:16:32,170
.فأنتنّ بحاجة لمصدر قتالي آخر لأجل الانتصار

167
00:16:32,790 --> 00:16:37,170
صنعتها خصيصًا لك، ألستُ محقةً؟

168
00:16:37,440 --> 00:16:40,070
.لأن الوحيدة التي تصنع الريش هي كلوي

169
00:16:40,070 --> 00:16:43,750
أليس لهذا تريدون إعادة بعثّها؟

170
00:16:45,440 --> 00:16:47,920
."السحر هو روح الساحرات"

171
00:16:49,910 --> 00:16:52,690
.بالطبع هذا صحيح أيها الماكرون

172
00:16:57,640 --> 00:16:59,200
.لـ-لحظة

173
00:16:59,200 --> 00:17:02,410
مـ-ما الذي تنوي عليه بعد ما علمت بكل هذا؟

174
00:17:04,160 --> 00:17:06,050
.من فضلك ساعدنا

175
00:17:06,050 --> 00:17:09,590
.لا أريد أن يذهب موت دوروكا سدى

176
00:17:11,080 --> 00:17:14,670
.ما زلت أريد إحياء كلوي، قراري لن يتغير

177
00:17:14,670 --> 00:17:15,520
ماذا؟

178
00:17:16,520 --> 00:17:20,810
.فبعد كل شيء، أنا أنفذّ ما ترغبُ به

179
00:17:21,200 --> 00:17:24,800
...لكن، لو رفضتكم كلوي

180
00:17:26,310 --> 00:17:28,570
.حينها فأنتنّ أعدائي

181
00:17:29,080 --> 00:17:30,950
.هذا هو الأمر برمته

182
00:17:42,800 --> 00:17:45,250
.لنشرع بالطقوس

183
00:17:56,840 --> 00:18:01,100
.برغبتنا أحضرناك

184
00:18:01,100 --> 00:18:07,090
.ولكن، برغبتك ستعيد بعث كلوي

185
00:18:08,040 --> 00:18:08,990
.أعلم

186
00:18:22,120 --> 00:18:24,360
:سحر الاستدعاء نمط الكتابة

187
00:18:34,910 --> 00:18:36,680
.ذكريات الماضي

188
00:18:58,420 --> 00:18:59,640
...كلوي

189
00:19:04,670 --> 00:19:08,040
.ذاك فالالو وهو برج الساحرة

190
00:19:08,420 --> 00:19:09,480
.أنظر

191
00:19:09,480 --> 00:19:11,440
...عندما تربط تلك النجمة وتلك النجمة

192
00:19:11,440 --> 00:19:12,540
.أنظر

193
00:19:14,300 --> 00:19:16,140
.أجل، أعرف

194
00:19:16,140 --> 00:19:21,050
.فهو يشكّل وجه جميل للفالالو العظيم الذي يشبهك

195
00:19:21,050 --> 00:19:24,300
.سمعتها ألف مرة، كما أنكِ لا تشبهيها إطلاقًا

196
00:19:24,300 --> 00:19:26,800
.لم تكن بحاجة لقول ذلك

197
00:19:27,280 --> 00:19:31,060
.وذاك برج تنين البحار

198
00:19:31,060 --> 00:19:36,140
.تلك العنقاء الأخيرة وذاك كلاريس عملاق المعرفة

199
00:19:36,810 --> 00:19:40,160
.هذا مذهل، يبدو أنك حفظتهم جميعًا

200
00:19:40,160 --> 00:19:42,340
هذا لا يصدق، أَأنت معجزة إلهية؟

201
00:19:43,290 --> 00:19:46,820
بما أني معلمتك فهذا يجعل مني آلهة؟

202
00:19:48,840 --> 00:19:53,760
وذاك برج أدونيس، صح؟

203
00:19:54,470 --> 00:19:56,840
.وكان من تأليفك

204
00:20:01,350 --> 00:20:03,080
!كلوي الغبية

205
00:20:03,080 --> 00:20:04,740
.أنّني أتذكّره

206
00:20:04,740 --> 00:20:09,040
تربط تلك النجوم ذات ألوان الطيف ببعضها، صحيح؟

207
00:20:09,040 --> 00:20:11,960
.هذا خطأ تمامًا، بل هي تلك

208
00:20:11,960 --> 00:20:14,680
.لم تبذلي مجهودًا لتفكري حتى

209
00:20:14,680 --> 00:20:16,770
.هذا غير صحيح

210
00:20:19,720 --> 00:20:23,860
.لن أقايض ما قضيته معك بأي شيء آخر

211
00:20:25,010 --> 00:20:29,970
.التفكير بالأمر وحده أشبه بالحلم

212
00:20:31,830 --> 00:20:34,620
.كلوي، كلوي

213
00:20:35,230 --> 00:20:37,980
.أنكِ دائمًا ما تلقين بملابسك

214
00:20:38,400 --> 00:20:41,770
.ظننتُ عرقكم عرقًا نبيلًا

215
00:20:42,700 --> 00:20:46,240
سامحني يا أدونيس. هلا تركتها عندك؟

216
00:20:46,920 --> 00:20:49,640
.لا عليك، سأشيلهم

217
00:20:59,570 --> 00:21:05,320
.يجب ألا تتجسّس على الفتيات أثناء استحمامهنّ يا أدونيس

218
00:21:07,040 --> 00:21:09,140
.يا لك من طفلٍ بالغ

219
00:21:09,530 --> 00:21:11,280
.ها؟ لا، لم أكن أتجسس

220
00:21:11,930 --> 00:21:15,040
.فـ-فقط قلقتُ عليك لأنكِ أطلتي

221
00:21:19,800 --> 00:21:22,800
.سـ-سأخرج وأراقب المكان

222
00:21:25,040 --> 00:21:31,950
،أعلم بأنه مضت فترة لم نستحم لكن مطاردينا
.قد يظهرون بأي لحظة لذا عجّلي

223
00:21:34,400 --> 00:21:35,800
...شكرًا

224
00:21:37,440 --> 00:21:39,240
.لوجودك بجانبي

225
00:21:40,800 --> 00:21:42,860
،لو لم تكن بجواري

226
00:21:43,190 --> 00:21:44,160
...لما

227
00:21:45,490 --> 00:21:50,140
.لما استطعت العيش في هذا العالم وحدي

228
00:21:57,400 --> 00:22:00,090
.ولا أنا يا كلوي

229
00:22:16,150 --> 00:22:17,770
...أحبكِ

230
00:22:18,140 --> 00:22:18,920
...لهذا

231
00:22:23,610 --> 00:22:25,290
.شكرًا لك