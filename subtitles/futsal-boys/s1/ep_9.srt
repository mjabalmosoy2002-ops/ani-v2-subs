1
00:00:05,330 --> 00:00:08,000
!ساكاكي--
...ناغومو--

2
00:00:08,000 --> 00:00:09,370
!تبا

3
00:00:11,460 --> 00:00:15,260
هل كان علي أن أمرر؟

4
00:00:17,090 --> 00:00:18,680
...أنا

5
00:00:19,930 --> 00:00:22,260
ما الذي علي فعله؟

6
00:01:52,020 --> 00:01:55,020
"كويو غاكوين" "ثانوية مومومي"

7
00:01:55,110 --> 00:01:55,690
"الحلقة 09: اللعب الجماعي"

8
00:01:55,690 --> 00:01:58,690
"الحلقة 09: اللعب الجماعي"
!تلك نقة واحدة فقط
!فلنرد الهجوم

9
00:01:58,690 --> 00:02:00,070
!علم

10
00:02:12,410 --> 00:02:13,960
!إنها لي

11
00:02:13,960 --> 00:02:15,830
!أحسنت يا كوموري-سينباي

12
00:02:15,830 --> 00:02:17,710
!ليس بهذه السرعة

13
00:02:17,710 --> 00:02:21,670
!أنا في أحسن حالاتي اليوم

14
00:02:27,800 --> 00:02:31,180
!هذه التسديدة في سبيل قططي الصغيرة

15
00:02:33,770 --> 00:02:36,440
!تبا! لا أصدق أنني أخطأت التصويب

16
00:02:36,440 --> 00:02:41,320
لا بأس يا نون! رغم ذلك، تكره
.الفتيات أن تلقبن بالقطط الصغيرة

17
00:02:41,320 --> 00:02:43,610
!ماذا؟ هل أنت جاد؟

18
00:02:43,610 --> 00:02:49,280
إنهم يندمجون مع المباراة. على هذه
!الوتيرة، قد تنقلب الكفة إلى صالح فريق مومومي

19
00:02:49,280 --> 00:02:52,200
!ابقوا هادئين وركزوا يا رفاق

20
00:02:55,620 --> 00:02:57,130
!ياماتو

21
00:02:59,960 --> 00:03:03,420
!يراوغ ساكاكي بينما يقترب إلى مرمى الخصم

22
00:03:05,380 --> 00:03:08,220
!سأنتزع الكرة هذه المرة

23
00:03:08,220 --> 00:03:10,680
!سوف يحاصر

24
00:03:14,060 --> 00:03:15,480
!ساكاكي

25
00:03:33,540 --> 00:03:35,330
!تسوكيوكا-سينباي

26
00:03:45,420 --> 00:03:49,340
،عجبا! لساكاكي سمعة شائنة للعبه الفردي

27
00:03:49,340 --> 00:03:53,770
لكنه يمرر الكرة لتسوكيوكا بدل
!بدل شق طريقه قدما

28
00:03:53,770 --> 00:03:58,230
هل يستطيع تسوكيوكا تحويل
!هذه الفرصة إلى هدف؟

29
00:04:00,610 --> 00:04:02,110
!ريو

30
00:04:07,530 --> 00:04:09,070
!ناغومو

31
00:04:10,910 --> 00:04:16,000
!عجبا! هل غير ساكاكي أسلوب لعبه؟

32
00:04:16,000 --> 00:04:17,500
!انطلق

33
00:04:18,460 --> 00:04:21,840
سحقا لرجولتي إن لم
!أستطيع إحراز هذا الهدف

34
00:04:28,720 --> 00:04:35,770
!هدف! هذا هدف كويو غاكوين الثالث اليوم

35
00:04:35,770 --> 00:04:40,560
!تمكنهم تمريراتهم الممتازة من إحراز هدف آخر

36
00:04:41,940 --> 00:04:44,190
.تمريرة جيدة يا ساكاكي

37
00:04:44,190 --> 00:04:45,730
...في المرة القادمة

38
00:04:46,990 --> 00:04:51,200
.اجر قدما عند المنتصف المرة القادمة

39
00:04:52,870 --> 00:04:54,660
.لك ذلك

40
00:04:54,660 --> 00:04:56,450
!شكرا لك يا ساكاكي

41
00:04:56,450 --> 00:04:58,830
!صنعت فرصة رائعة

42
00:05:07,960 --> 00:05:14,760
!يوسع كويو فارق الأهداف إلى هدفين
!هل سيتمكن فريق مومومي من رد الهجوم؟

43
00:05:14,760 --> 00:05:19,520
!يقطع ساكاكي تمريرة بمجرد استكمال المباراة

44
00:05:19,520 --> 00:05:19,810
!هل حسنت التمريرات من أدائهم؟

45
00:05:19,810 --> 00:05:22,310
"النصر"
"!هدف"
!هل حسنت التمريرات من أدائهم؟

46
00:05:22,310 --> 00:05:24,690
!هل حسنت التمريرات من أدائهم؟

47
00:05:24,690 --> 00:05:28,690
!لكن هانومارو لا يبرح أعقابهم

48
00:05:28,690 --> 00:05:29,940
!ماذا؟

49
00:05:29,940 --> 00:05:37,370
!إنها تمريرة جانبية بالكعب
ساكاكي مليء بالمفاجآت بالنسبة إلى
!طالب في سنته الأولى

50
00:05:37,370 --> 00:05:42,540
النتيجة 3-1! هل سيستطيع فريق
!مومومي أن يثور ويقلب الموازين؟

51
00:05:44,170 --> 00:05:46,800
!اعطني الكرة

52
00:05:46,800 --> 00:05:50,720
!يقطع الفتى السيء كوموري التمريرة

53
00:05:50,720 --> 00:05:52,800
!لا بأس يا ياماتو

54
00:05:57,720 --> 00:06:00,520
!اسرق كراتنا وسنسرقها منك مجددا

55
00:06:02,100 --> 00:06:04,480
!سأسرقها مجددا إذن

56
00:06:04,480 --> 00:06:05,900
!انظروا لكل تلك الحركات الرشيقة
!كيف يستطيعون أدائها؟

57
00:06:05,900 --> 00:06:09,900
"ناتسوكي" "كيوسوكي"
"آي" "كيوسوكي"
!انظروا لكل تلك الحركات الرشيقة
!كيف يستطيعون أدائها؟

58
00:06:12,990 --> 00:06:15,950
سأحرز هدفا هذه المرة، حسنا؟

59
00:06:22,910 --> 00:06:26,540
!هدف! هل رأيتم حركات القدمين تلك؟

60
00:06:26,540 --> 00:06:30,460
لحصان البطولة الأسود
!مومومي بعض الحركات الخداعة

61
00:06:30,460 --> 00:06:33,840
!يقلص الهدف الثاني فارق الأهداف

62
00:06:33,840 --> 00:06:37,100
!مرحى! أنا سعيد

63
00:06:37,970 --> 00:06:43,180
محاولة جيدة يا ساكاكي. لقد احرزوا
.هدفا، لكن لا بأس. فلنحافظ على معنوياتنا عالية

64
00:06:43,180 --> 00:06:45,270
.حسنا

65
00:06:45,270 --> 00:06:47,560
.النتيجة 3-2 إذن

66
00:06:47,560 --> 00:06:52,740
حتى بصدارتنا، لا يمكننا
.التهاون أمام تحركاتهم الغريبة

67
00:06:54,320 --> 00:06:56,700
!ساكاكي--
ماذا؟--

68
00:06:56,700 --> 00:07:02,870
!أريد أن أسدد تمريرة أنا أيضا
!سأبقي على نفسي متاحا، لذا فلنفعلها

69
00:07:02,870 --> 00:07:04,370
ماذا؟

70
00:07:06,540 --> 00:07:08,710
.لك ذلك

71
00:07:09,750 --> 00:07:10,750
!مرحى

72
00:07:10,750 --> 00:07:12,760
!كف عن هذا

73
00:07:20,640 --> 00:07:22,140
!ساكاكي

74
00:07:23,810 --> 00:07:25,440
!ساكاكي

75
00:07:31,270 --> 00:07:32,820
!ياماتو

76
00:07:35,990 --> 00:07:37,610
!ألا يمكنني فعلها؟

77
00:07:53,300 --> 00:07:54,800
!سحقا

78
00:07:55,840 --> 00:07:57,930
!يا لحسن حظنا

79
00:08:07,890 --> 00:08:10,230
.ها نحن أولاء

80
00:08:10,230 --> 00:08:12,230
!ناتسوكي--
ماذا؟--

81
00:08:12,230 --> 00:08:13,860
!أحرز هدفا آخر

82
00:08:13,860 --> 00:08:15,150
!قاتل

83
00:08:15,150 --> 00:08:20,410
!شكرا لكن! مرحى

84
00:08:20,410 --> 00:08:21,240
ماذا؟

85
00:08:21,240 --> 00:08:22,330
.الكرة لكويو

86
00:08:22,330 --> 00:08:23,790
!لماذا؟

87
00:08:23,790 --> 00:08:26,450
.أقلت لماذا؟ قاعدة الثواني الأربع

88
00:08:26,450 --> 00:08:28,580
ماذا؟ ما هذا؟

89
00:08:28,580 --> 00:08:31,210
.يا له من خطأ مبتدئين

90
00:08:31,210 --> 00:08:36,920
،حركاتهم الخداعة مبهرة بكل تأكيد
...لكنهم مبتدؤون حقا

91
00:08:36,920 --> 00:08:41,090
!ما الذي تفعله يا نات-سينباي؟

92
00:08:41,090 --> 00:08:42,680
.ما باليد حيلة

93
00:08:42,680 --> 00:08:46,850
.لا يستطيع أي رجل تجاهل انتباه الفتيات

94
00:08:46,930 --> 00:08:49,270
"كويو غاكوين" "ثانوية مومومي"

95
00:08:52,110 --> 00:08:53,690
!ريو-سينباي

96
00:08:57,530 --> 00:09:00,610
!سأضيق الخناق على تمريراتم

97
00:09:00,610 --> 00:09:05,330
أتمانع لو أجرب شيئا قد رأيته
على بينستا ليلة البارحة؟

98
00:09:06,490 --> 00:09:08,500
!هكذا

99
00:09:09,540 --> 00:09:10,920
!ماذا؟

100
00:09:19,420 --> 00:09:21,090
!سحقا

101
00:09:21,090 --> 00:09:22,890
!لا أحد هناك

102
00:09:24,390 --> 00:09:27,020
!حان الوقت لمعادلة النتيجة

103
00:09:27,020 --> 00:09:28,850
!في أحلامك

104
00:09:39,240 --> 00:09:43,620
!فانتاسيستا... الصيف

105
00:09:45,530 --> 00:09:48,330
!أهداف متتالية

106
00:09:48,330 --> 00:09:55,420
لا يعرف القواعد، لكن قدمه تعرف
!جيدا تسديد الكرات! هذا هو سوغو ناتسوكي

107
00:09:55,420 --> 00:09:58,760
!تعادل ثانوية مومومي النتيجة

108
00:09:58,760 --> 00:10:01,420
!مرحى

109
00:10:01,420 --> 00:10:02,720
.أنا آسف

110
00:10:02,720 --> 00:10:07,720
...لا عليك. لكن ما يقلقني حقا هو

111
00:10:10,430 --> 00:10:15,980
نحن نواجه هذا الفريق
!السخيف... والنتيجة متعادلة؟

112
00:10:23,360 --> 00:10:27,200
أيها الوسيم. أيعقل أنه قد أصابك الهلع؟

113
00:10:27,200 --> 00:10:31,120
!يعرقل سوغو من ثانوية مومومي إيقاع كويو

114
00:10:31,120 --> 00:10:35,500
!ما الخطوة التي سيتخذها ساكاكي تاليا يا ترى؟

115
00:10:35,500 --> 00:10:39,800
لا ألومك بعد على ذلك،
.خصوصا بعد أن رأيت حركاتي الخارقة

116
00:10:41,760 --> 00:10:45,090
!يتحداه سوغو وجها لوجه

117
00:10:48,180 --> 00:10:49,640
!ساكاكي

118
00:10:52,560 --> 00:10:59,320
!يستحوذ الفريق الخصم على الكرة
!لمن سيمرر طالب السنة الأولى كوراما الكرة يا ترى؟

119
00:11:00,940 --> 00:11:04,280
يا ترى! إلى من سأمرر الكرة؟

120
00:11:09,780 --> 00:11:12,080
!لقد غيرت رأيي

121
00:11:12,080 --> 00:11:15,210
!يسدد هانامورا الكرة بنفسه

122
00:11:16,170 --> 00:11:18,420
!يا لخيبة الأمل

123
00:11:18,420 --> 00:11:21,630
!هذه فرصتنا! فلنحرز هدفا

124
00:11:25,970 --> 00:11:30,430
!امض قدما يا كوموري-سينباي
!مررها يا ريو-سينباي

125
00:11:36,390 --> 00:11:39,400
!تسديدة الفتى السيء

126
00:11:39,400 --> 00:11:45,650
هدف! يقلب فريق مومومي الموازين
!في أول ظهور لهم في بطولة كرة قدم خماسية

127
00:11:45,650 --> 00:11:48,370
!مرحى! نحن نهز الملعب كنجوم الروك

128
00:11:48,370 --> 00:11:49,620
!كوموري-سينباي

129
00:11:49,620 --> 00:11:51,410
!أرأيت ذلك يا يوكيمارو؟

130
00:11:51,410 --> 00:11:53,580
!أجل! كان ذلك رائعا جدا

131
00:11:53,580 --> 00:11:56,080
!هذا أيضا بفضل مهاراتك في صناعة الفرص

132
00:11:56,080 --> 00:11:59,210
!أجل. أحسنت يا يوكيمارو

133
00:11:59,210 --> 00:12:01,130
!أحسنتم

134
00:12:01,130 --> 00:12:03,840
!هذه هي المعنويات المطلوبة يا يوكيمارو

135
00:12:03,840 --> 00:12:08,840
إنها تنتقل إلي! فلنبقها مرتفعة
!ونحرز المزيد من الأهداف

136
00:12:08,840 --> 00:12:10,390
!سحقا

137
00:12:10,390 --> 00:12:12,010
.استرخ يا ساكاكي

138
00:12:12,010 --> 00:12:15,180
--هدئ من روعك يا ساكاكي, في العادة لا

139
00:12:15,180 --> 00:12:16,980
!أنا هادئ

140
00:12:24,530 --> 00:12:29,410
تحتفظ مومومي بالصدارة في
!هذه المباراة بنتيجة 4-3

141
00:12:29,410 --> 00:12:33,540
!لكن كلا الفريقين يعانيان لإحراز المزيد من الأهداف

142
00:12:44,130 --> 00:12:48,470
!خدعة... وحلوى

143
00:12:49,510 --> 00:12:51,050
!ريو-سينباي

144
00:12:53,220 --> 00:12:58,440
!لا يمكن إيقاف فريق مومومي--
!لقد سجلوا أربعة أهداف متتالية--

145
00:12:58,440 --> 00:13:00,230
!ليسوا سيئين--
!لا يمكن إيقاف فريق مومومي--
!لقد سجلوا أربعة أهداف متتالية

146
00:13:00,230 --> 00:13:03,650
!لم أكن أعرف أن فريق ثانويتنا بهذه البراعة

147
00:13:02,690 --> 00:13:04,690
"كويو غاكوين" "ثانوية مومومي"

148
00:13:04,940 --> 00:13:11,820
!مرحى

149
00:13:11,820 --> 00:13:14,700
.أتساءل ما إن كان ساكاكي على ما يرام

150
00:13:14,700 --> 00:13:20,500
إنه يقدم أداء جيدا أخيرا، لكن
.يبدو أنه يفقد أعصابه

151
00:13:26,090 --> 00:13:29,800
!لا يمكننا تحمل المزيد من العثرات

152
00:13:29,800 --> 00:13:31,090
!تسوكيوكا-سينباي

153
00:13:31,090 --> 00:13:32,890
!مرحبا

154
00:13:37,560 --> 00:13:39,560
!ما رأيكم في هدف آخر؟

155
00:13:39,560 --> 00:13:42,230
هل سيسدد إلى اليمين أم اليسار؟

156
00:13:43,690 --> 00:13:50,030
!تنهي الصافرة الشوط الأول
!تتصدر ثانوية مومومي النتيجة بفارق هدفين

157
00:13:50,030 --> 00:13:54,070
!سحقا! كنت على وشك التباهي بمهاراتي

158
00:13:54,070 --> 00:13:59,200
لا تقلقوا، سأطلق العنان أكثر
!لأدائي الخارق في الشوط الثاني

159
00:14:03,920 --> 00:14:07,090
.كل ما يمكن قوله عن تحركاتهم أنها جنونية

160
00:14:07,090 --> 00:14:13,090
أجل، هم ليسوا غير متوقعين
.فحسب، بل إنهم موهوبون جميعا كذلك

161
00:14:13,090 --> 00:14:16,930
!هل سنخسر أمام هؤلاء المبتدئين؟ سحقا

162
00:14:20,270 --> 00:14:23,480
نحن مذهلون حقا، أليس كذلك؟

163
00:14:23,480 --> 00:14:26,940
.أجل، كنا نعلم ذلك منذ البداية

164
00:14:26,940 --> 00:14:31,530
ما رأيكم أن ندعو من يحرز
الهدف التالي إلى داس؟

165
00:14:31,530 --> 00:14:33,360
!هذا ليس عادلا بالنسبة لي

166
00:14:33,360 --> 00:14:34,410
!فلنفعلها--
!أجل--

167
00:14:34,410 --> 00:14:40,790
إن استمرينا على هذا المنوال، فسنفوز على
!فريق تسوكيوكا ونتأهل إلى دور المحافظة ربع النهائي

168
00:14:40,790 --> 00:14:42,830
!قد يتحقق ذلك حقا

169
00:14:47,340 --> 00:14:50,420
ما يزال أمامنا شوط ثان، صحيح؟

170
00:14:51,550 --> 00:14:53,550
!أجل، وجهة نظر سديدة

171
00:14:53,550 --> 00:14:55,640
.لن أسمح لهم بإحراز هدف آخر

172
00:14:55,640 --> 00:15:01,270
فيما يخص الشوط الثاني... ابق
.في مقعد الاحتياط يا ساكاكي

173
00:15:01,270 --> 00:15:03,270
.أظن أنك تعرف السبب وراء ذلك

174
00:15:03,270 --> 00:15:04,440
!--لكن

175
00:15:04,440 --> 00:15:12,110
قد تفيدك المشاهدة من خارج ميدان
.اللعب. أعتقد أن ذلك سيكون تجربة جيدة لك

176
00:15:14,820 --> 00:15:16,200
...هذا يعني أن

177
00:15:16,200 --> 00:15:19,240
هل أنت لها يا تسوباكي؟

178
00:15:19,240 --> 00:15:20,740
.أجل

179
00:15:23,710 --> 00:15:27,630
!انظروا! لقد قامت كويو بتبديل في اللاعبين

180
00:15:27,630 --> 00:15:34,550
تم إرسال لاعب الجناح ساكاكي إلى
!الاحتياط! يحل نائب القائد يوكيناغا محله

181
00:15:34,550 --> 00:15:36,550
من ذلك الفتى الوسيم؟

182
00:15:36,550 --> 00:15:37,970
!يا له من أمير

183
00:15:37,970 --> 00:15:41,060
قد ينسجم جيدا معنا. هل تريد الاستطلاع حوله؟

184
00:15:41,060 --> 00:15:43,810
!ما الذي قد نحققه بذلك؟

185
00:15:43,810 --> 00:15:45,770
.تسوباكي

186
00:15:53,150 --> 00:15:58,160
يتصدر فريق مومومي النتيجة بفارق هدفين
!بعد أن تحملت شباك كويو أربعة أهداف متتالية

187
00:15:58,160 --> 00:16:03,200
!لنر إن كان التبديل كفيلا بتغيير حظهم

188
00:16:03,200 --> 00:16:07,420
!حسنا إذن، فلتستكمل المباراة

189
00:16:15,840 --> 00:16:19,430
!يقوم يوكيناغا بتمريرة جميلة

190
00:16:19,430 --> 00:16:22,760
هل احتفظوا بأفضل ما لديهم
!للشوط الأخير يا ترى؟

191
00:16:22,760 --> 00:16:24,140
!ناغومو

192
00:16:25,480 --> 00:16:28,440
!أنا آسف، لكنني الأفضل هنا

193
00:16:28,440 --> 00:16:31,820
!هل لا أمكنك الاكتفاء بالصمت واللعب؟

194
00:16:33,690 --> 00:16:38,360
يتجه ياماتو نحو الكرة! هل
!سيسددها نحو الشباك؟

195
00:16:39,700 --> 00:16:41,240
!ياماتو

196
00:16:43,580 --> 00:16:47,540
...التمريرة الأمثل في هذا الوضع

197
00:16:50,080 --> 00:16:51,840
!تسوكيوكا-سينباي

198
00:16:56,130 --> 00:17:00,550
!هدف! تنتزع كويو هدف الشوط الثاني الأول

199
00:17:00,550 --> 00:17:04,970
ويا له من هدف مدهش للبدأ
!في تجاوز شح نتيجتهم

200
00:17:07,980 --> 00:17:12,150
.عجبا! أنت لست بأمير عادي

201
00:17:17,860 --> 00:17:21,160
!لست سيئا أيها الأمير

202
00:17:21,160 --> 00:17:24,280
!إلى هنا يا كوموري-سينباي

203
00:17:24,280 --> 00:17:27,830
...في أوقات كهذه يا يوكيمارو

204
00:17:32,880 --> 00:17:37,380
!ما رأيك في حركات قدمي؟
إنها رائعة، أليست كذلك؟

205
00:17:39,010 --> 00:17:40,380
!ما--؟

206
00:17:41,300 --> 00:17:42,930
!سحقا

207
00:17:42,930 --> 00:17:44,140
!أجل

208
00:17:44,140 --> 00:17:48,390
.إنه يراقب تحركات الجميع باستمرار

209
00:17:48,390 --> 00:17:54,020
،هكذا، لا يستطيع الخصم خداعه
.كما يمكنه أن يعرف لمن يجب عليه أن يمرر

210
00:17:55,520 --> 00:18:00,990
!يشق تسوكيوكا طريقه بين لاعبين
!هل سيسددها نحو الشباك يا ترى؟

211
00:18:00,990 --> 00:18:02,160
!ناغومو

212
00:18:04,660 --> 00:18:11,830
!هدف! يحرز كويو هدفه الثاني ويعادل النتيجة

213
00:18:11,830 --> 00:18:14,540
!ننتقل الآن إلى وقت مستقطع

214
00:18:14,540 --> 00:18:16,540
!أحسنتم عملا

215
00:18:16,540 --> 00:18:18,880
كيف تشعر يا ساكاكي؟

216
00:18:18,880 --> 00:18:21,880
.أنا... على ما يرام

217
00:18:21,880 --> 00:18:24,050
.تبدو بحال أفضل الآن

218
00:18:24,050 --> 00:18:27,310
هل تعلمت أي شيء من
مشاهدتك لتسوباكي؟

219
00:18:27,310 --> 00:18:29,970
،إن كنت على ما يرام الآن
.فيمكنك العودة إلى المباراة

220
00:18:31,640 --> 00:18:35,650
.استغل ما تعلمته أثناء اللعب

221
00:18:36,560 --> 00:18:37,980
!علم

222
00:18:41,950 --> 00:18:47,370
!تبديل آخر لكويو
!يعود ساكاكي إلى أرض الملعب

223
00:18:51,500 --> 00:18:55,170
!سأسجل هدفا آخر لإكمال هاتريك

224
00:18:58,290 --> 00:19:03,630
.أزل ذلك الوجه المخيف عنك أيها الوسيم
!فلنستمتع قليلا

225
00:19:04,630 --> 00:19:08,850
.سأتخطاك ثانية، لذا أيا يكن

226
00:19:12,640 --> 00:19:13,440
!أجل

227
00:19:13,440 --> 00:19:15,650
.يبدو أكثر هدوءا

228
00:19:15,650 --> 00:19:21,650
تتكلل حركات ساكاكي بالنجاح ويتجه
!صوب المرمى! لكن هل سيحرز هدفا يا ترى؟

229
00:19:29,530 --> 00:19:32,120
.سنحرز هدفا إن مررت إلى هناك

230
00:19:41,000 --> 00:19:44,590
.سحقا. كان علي التمرير في وقت أبكر

231
00:19:45,970 --> 00:19:48,470
!يستقبل هانامورا الكرة

232
00:19:48,470 --> 00:19:52,270
!لكن ساكاكي يضغط عليه

233
00:19:52,270 --> 00:19:55,350
!يقفز ياماتو لقطع التمريرة

234
00:19:55,350 --> 00:19:57,480
!قطع ممتاز يا هارو

235
00:19:57,480 --> 00:20:01,150
!--يهرع ناغومو لنيل الكرة، لكن

236
00:20:03,530 --> 00:20:05,070
!ساكاكي

237
00:20:14,700 --> 00:20:17,170
.سحقا. سأضطر إلى تجاوزه

238
00:20:17,170 --> 00:20:18,670
!ساكاكي

239
00:20:23,510 --> 00:20:25,340
أيحدث هذا ثانية؟

240
00:20:25,340 --> 00:20:29,640
...يمكنني تصور التمرير إلى باقي الفريق

241
00:20:29,640 --> 00:20:32,640
!الكل إلا هو

242
00:20:37,890 --> 00:20:39,270
!ناغومو

243
00:20:41,310 --> 00:20:44,110
!هارو--
!أجل--

244
00:20:44,110 --> 00:20:46,530
...التنين

245
00:20:51,910 --> 00:20:56,660
!كلا! لقد كانت بعيدة بقليل فقط عن الهدف

246
00:20:58,500 --> 00:21:00,630
...الشامخ...

247
00:21:01,960 --> 00:21:04,880
!الخارق...

248
00:21:10,800 --> 00:21:12,050
!ما كان ذلك بالضبط؟

249
00:21:12,050 --> 00:21:13,470
!لم أر ذلك من قبل في حياتي

250
00:21:13,470 --> 00:21:16,770
!هذا اللعب المسترسل مذهل وغير معقول

251
00:21:16,770 --> 00:21:22,690
هذا الهدف الثنائي الجديد بقيادة
!ياماتو هارو وناغومو ريو

252
00:21:22,690 --> 00:21:26,990
!يفقد الجمهور صوابه كليا

253
00:21:26,990 --> 00:21:29,860
أهذا ما تقدر ثانوية كويو على فعله إذن؟

254
00:21:29,860 --> 00:21:34,490
بعد مشاهدة ذلك، أنا واثق أن
!كوموري-سينباي والآخرين... ماذا؟

255
00:21:34,490 --> 00:21:38,000
.أنا مرهق--
!انقطع نفسي--

256
00:21:38,000 --> 00:21:40,460
!ما الذي تفعلونه يا رفاق؟

257
00:21:40,460 --> 00:21:42,040
ما الذي نفعله برأيك؟

258
00:21:42,040 --> 00:21:43,290
.نحن نأخذ استراحة

259
00:21:43,290 --> 00:21:46,090
!لا يمكنكم أخذ استراحة متى ما شئتم

260
00:21:47,210 --> 00:21:51,840
!أنا آسف! أنا حقا آسف
!سأجعلهم يقفون على الفور

261
00:21:51,840 --> 00:21:53,050
!مرحى

262
00:21:53,050 --> 00:21:53,930
!كانت تلك فرصة رائعة

263
00:21:53,930 --> 00:21:55,560
!أجل

264
00:21:55,560 --> 00:22:00,020
هل قام ناغومو وياماتو بتسديد هدف مرتد للتو؟

265
00:22:00,020 --> 00:22:04,020
ومع ذلك، ما أزال غير
...قادر على التمرير له حتى

266
00:23:35,030 --> 00:23:40,040
"الحلقة 10: ما لا أريد أن أخسره"

267
00:23:40,040 --> 00:23:50,000
الفائز بالمباراة الصباحية"
"لفعالية التدريب المشتركة
"ثانوية مومومي"