1
00:00:03,280 --> 00:00:04,170
خُذ

2
00:00:04,850 --> 00:00:06,720
قلتَ بأنّك أردت إلقاء نظرة إلى هذه، صحيح؟

3
00:00:12,610 --> 00:00:14,610
...إنّها ظريفة

4
00:00:14,930 --> 00:00:17,470
...لا أمانع السّماح لها

5
00:00:18,130 --> 00:00:20,620
بالعبث بحياتي

6
00:01:56,130 --> 00:01:58,010
!جدّي

7
00:01:59,130 --> 00:02:00,640
ما هذا بالتّحديد؟

8
00:02:01,430 --> 00:02:02,050
ماذا؟

9
00:02:02,390 --> 00:02:05,170
إعادة تنظيم ضخمة في عالم الياكوزا"؟"

10
00:02:05,560 --> 00:02:09,560
أبدو وسيماً حقّاً هنا

11
00:02:09,560 --> 00:02:10,420
!أيّها الأحمق

12
00:02:10,420 --> 00:02:12,120
!لا أحد يُبالي لهذا

13
00:02:12,120 --> 00:02:13,990
!أتحدّث عن الجزئيّة الأخيرة

14
00:02:13,990 --> 00:02:16,250
يبدو أنّ حفيديهما مُقرّبان جدّاً"

15
00:02:16,250 --> 00:02:19,070
،وطبقاً لمصادر مُقرّبة من العائلتين

16
00:02:19,070 --> 00:02:23,080
"قد يُخطبان في المستقبل القريب

17
00:02:23,310 --> 00:02:25,950
!حريّ ألّا أكون المقصودة هنا

18
00:02:25,950 --> 00:02:28,080
من غيركِ إذاً؟

19
00:02:28,080 --> 00:02:29,750
!اللّعنة

20
00:02:29,750 --> 00:02:34,780
أوّلاً، لم ألتقِ بمياما هذا أو أيّاً كان اسمه
!من طوكيو أو حفيدهم

21
00:02:34,780 --> 00:02:37,090
!ما هي هذه "المصادر" بالضّبط؟

22
00:02:37,500 --> 00:02:38,470
!أنا بالطّبع

23
00:02:38,470 --> 00:02:39,400
ماذا؟

24
00:02:39,400 --> 00:02:43,100
يوشينو، ستبلغين السّابعة عشر
في هذا العام، أليس كذلك؟

25
00:02:43,100 --> 00:02:46,220
لكن لم تُرافقي فتى بعد

26
00:02:46,600 --> 00:02:49,480
...وبما أنّكِ وحيدة تماماً

27
00:02:49,910 --> 00:02:53,360
!وجدتُ شابّاً لكِ

28
00:02:53,360 --> 00:02:57,720
!أقصد بأنَّ حفيد مياما أنيق حقّاً

29
00:02:57,720 --> 00:03:00,240
!يُشبه غاكو تماماً عندما كان صغيراً

30
00:03:00,240 --> 00:03:02,000
بصراحة، أنا مصدوم

31
00:03:02,000 --> 00:03:05,350
جدّي، أتعرف مياما هذا منذ مدّة؟

32
00:03:05,350 --> 00:03:09,070
لو لم أكن أعرفه، لما اقترحتُكِ

33
00:03:09,660 --> 00:03:12,520
!لمعلوماتك فقط، لن أتزوّج

34
00:03:12,520 --> 00:03:15,390
!كفى ثرثرة والتقِ بالشّاب أوّلاً على الأقلّ

35
00:03:15,390 --> 00:03:20,260
وإلّا ستنتهي حياتكِ بعدم التكلّم
!مع شابّ ليس من العائلة

36
00:03:20,260 --> 00:03:23,110
!ا-اهتمّ بشؤونك الخاصّة ودعني وشأني

37
00:03:23,110 --> 00:03:25,610
ناهيكِ عن أنّكِ مُبارَكة بمُورّثاتي

38
00:03:25,610 --> 00:03:28,640
وأمسيتِ مُثيرة، ومع ذلك لستِ حريصة إطلاقاً

39
00:03:29,630 --> 00:03:31,800
،لا تنفكّ تقول بأنّني مُثيرة

40
00:03:31,800 --> 00:03:34,260
لكن بسبب هذا الوجه يظلّ النّاس
يقولون بأنّني مُضيفة أوميدا

41
00:03:34,260 --> 00:03:36,270
!أو بأنّني مُطلّقة ولديّ طفل

42
00:03:36,270 --> 00:03:38,490
من يُبالي؟

43
00:03:38,490 --> 00:03:41,040
لِمَ لا تحاولين الاستقرار في طوكيو؟

44
00:03:41,040 --> 00:03:42,670
يمكنكِ الانتقال إلى هناك

45
00:03:42,670 --> 00:03:46,280
أنتِ ثنائيّة اللّغة بما أنّكِ تتكلّمين بلهجة
!طوكيو وبلهجة كانساي

46
00:03:46,280 --> 00:03:47,770
!كلتاهما من اللّغة اليابانيّة

47
00:03:47,770 --> 00:03:50,540
لا أعرف اسم هذا الشّخص حتّى
!أو كيف هو شكله

48
00:03:50,540 --> 00:03:53,070
!حسناً، اسمه هو مياما كيريشيما

49
00:03:53,070 --> 00:03:55,500
ماذا؟ أهذا اسمه كفرد من العصابة؟

50
00:03:55,500 --> 00:03:58,650
حمقاء. هذا اسمه الحقيقيّ. إنّه
ليس من الياكوزا

51
00:03:58,650 --> 00:04:00,550
أقول لكِ بأنّه في المدرسة الثّانويّة

52
00:04:00,550 --> 00:04:03,260
على أيّ حال، اذهبي إلى طوكيو
فحسب وتأكّدي بنفسكِ

53
00:04:03,260 --> 00:04:05,000
حينئذ يمكننا التكلُّم

54
00:04:11,600 --> 00:04:14,020
في النّهاية، أتيتُ فعلاً

55
00:04:14,450 --> 00:04:15,650
هذا ضخم

56
00:04:19,210 --> 00:04:21,530
شكراً على السّفر كلّ هذه المسافة

57
00:04:21,760 --> 00:04:23,940
!إ-إنّه وسيم جدّاً

58
00:04:24,240 --> 00:04:27,760
تُشبهين رينجي حقّاً. هل أخبركِ
أحدٌ بذلك فعلاً؟

59
00:04:27,760 --> 00:04:29,180
طوال الوقت في الواقع

60
00:04:29,180 --> 00:04:32,670
بأنّني أُشبه رينجي عندما كان
صغيراً لكن إذا كان فتاة

61
00:04:33,620 --> 00:04:34,850
صحيح تماماً

62
00:04:34,850 --> 00:04:40,500
ا-المعذرة، بالمناسبة، أين مياما
كيريشيما-سان هذا...؟

63
00:04:40,500 --> 00:04:43,170
ماذا؟ عمّاذا تتكلّمين؟

64
00:04:43,170 --> 00:04:45,260
إنّه يقف خلفكِ مباشرة

65
00:04:47,540 --> 00:04:49,710
نجح ذلك أكثر ممّا توقّعتُ

66
00:04:49,710 --> 00:04:53,140
.مرحباً، سُرِرتُ بلقائكِ
اسمي مياما كيريشيما

67
00:04:53,140 --> 00:04:54,570
...ماذا؟

68
00:04:54,570 --> 00:04:57,370
بئساً، آسف. هل أخفتُكِ؟

69
00:04:57,370 --> 00:04:58,990
لم أستطع انتهاز اللّحظة المُناسبة فحسب

70
00:04:58,990 --> 00:05:00,510
...أ-أجل

71
00:05:00,510 --> 00:05:03,020
سآخذكِ في جولة تعريفيّة حول
ما تبقّى من المكان

72
00:05:03,020 --> 00:05:04,650
!ا-انتظر

73
00:05:05,570 --> 00:05:06,590
ما رأيكِ؟

74
00:05:06,590 --> 00:05:08,240
بماذا؟

75
00:05:08,240 --> 00:05:10,260
،سمعنا بأنّكِ ستُقيمين معنا في طوكيو

76
00:05:10,260 --> 00:05:12,830
لذلك أعدنا ترميم غرفة الشّاي لهذا المُلحَق

77
00:05:12,830 --> 00:05:13,660
!ماذا؟

78
00:05:14,190 --> 00:05:17,570
إنّه مُنفصِل عن المنزل الرّئيسيّ، لذا
ارتأينا بأنّكِ ستكونين أكثر استرخاء

79
00:05:17,570 --> 00:05:19,540
آسفة، هل يمكنني قول شيء؟

80
00:05:20,250 --> 00:05:24,340
...أقدّر حقّاً قيامكم بكلّ هذا لأجلي

81
00:05:24,340 --> 00:05:26,760
لكن لم أقرّر فيما إذا كنتُ
سآتي إلى هنا فعلاً

82
00:05:26,760 --> 00:05:29,720
...إذا انتهى المطاف برفضي لهذا العرض

83
00:05:30,050 --> 00:05:33,210
آسف. نسيتُ ذِكر ذلك

84
00:05:33,210 --> 00:05:34,600
أعتذر إن تسرّعت

85
00:05:35,200 --> 00:05:40,440
بالطّبع، لا نُمانع إذا رفضتِ هذا العرض

86
00:05:41,710 --> 00:05:44,190
أقصد أنّه فُرِض عليكِ فرضاً

87
00:05:44,480 --> 00:05:47,960
شابّ وفتاة سيتزوّجان وهما
لم يلتقيا أبداً من قبل؟

88
00:05:47,960 --> 00:05:49,650
!يا له من أسلوب قديم

89
00:05:49,650 --> 00:05:51,200
...صـ-صحيح

90
00:05:51,200 --> 00:05:54,350
وظننتُ للأمانة بأنّكِ لن تأتي إلى هنا حتّى

91
00:05:54,350 --> 00:05:55,080
ماذا؟

92
00:05:55,460 --> 00:06:00,080
كنتُ سعيداً حقّاً عندما أخبروني بأنّكِ
ستأتين لِلقائي على الأقلّ

93
00:06:00,080 --> 00:06:02,900
هذا يكفي فعلاً. شكراً

94
00:06:09,840 --> 00:06:14,350
،كنتُ أقول لنفسي للتو بأنّه لا بأس به
وانتهى المطاف بانتقالي إلى هنا بشكلٍ ما

95
00:06:14,350 --> 00:06:17,840
...إن أردتُ الصّدق، أنا اللّيّنة في ظرفٍ كهذا

96
00:06:17,840 --> 00:06:21,470
لا يسعني سوى الشُّعور بأنّني انخدعت

97
00:06:22,640 --> 00:06:24,360
آسف لو تأخّرتُ عليكِ يا يوشينو

98
00:06:24,980 --> 00:06:28,810
استغرقتُ وقتاً حتّى عرفتُ ما هو صفّنا

99
00:06:28,810 --> 00:06:30,010
هل من مُشكلة؟

100
00:06:30,010 --> 00:06:32,860
لـ-لا، أنا بخير

101
00:06:33,220 --> 00:06:35,340
لديك دروس فنون جميلة، أليس كذلك؟

102
00:06:35,340 --> 00:06:38,110
أجل. وأنت تُركّز على الجبر
والعلوم، صحيح؟

103
00:06:38,110 --> 00:06:39,530
هذا مُذهل

104
00:06:39,530 --> 00:06:41,680
،لستُ ذكيّة

105
00:06:41,680 --> 00:06:45,630
لذا قلقتُ ما إن كنتُ سأستطيع حتّى
الانتقال إلى ثانويّة مرموقة كهذه

106
00:06:45,630 --> 00:06:47,650
...لذا يا كيريشيما-كن

107
00:06:47,650 --> 00:06:50,570
...كيريشيما-كن" تسمية مُحرِجة بعض الشّيء"

108
00:06:50,570 --> 00:06:53,120
إن لم تُمانعي، هلّا ناديتِني كيريشيما فقط؟

109
00:06:53,120 --> 00:06:55,640
...ماذا؟ إذاً... المعذرة

110
00:06:55,640 --> 00:06:59,770
هل تستقلّ سيّارة من وإلى المدرسة
دوماً يا كيريشيما؟

111
00:06:59,770 --> 00:07:04,670
،مُحال. فعلتُ ذلك اليوم، لكن في العادة
أستقلُّ القِطار فحسب

112
00:07:04,670 --> 00:07:07,220
هل يجدر بنا أن نمنحكِ توصيلة
من وإلى المدرسة يا يوشينو؟

113
00:07:07,220 --> 00:07:09,280
...ماذا؟ لا، أنا بخير

114
00:07:09,280 --> 00:07:10,280
هكذا إذاً

115
00:07:10,280 --> 00:07:12,770
صفّكِ هناك يا يوشينو

116
00:07:12,770 --> 00:07:14,440
حسناً، أراكِ بعد دوام المدرسة

117
00:07:15,980 --> 00:07:18,660
من الصّعب التخيُّل بأنّه وُلِد
...في كنف عائلة ياكوزا

118
00:07:19,260 --> 00:07:22,170
يسرّني أنّه مجرّد شخص لطيف عاديّ

119
00:07:25,670 --> 00:07:28,030
المعذرة، هل لي بلحظة؟

120
00:07:28,030 --> 00:07:30,200
ماذا؟ أ-أنا؟

121
00:07:30,200 --> 00:07:31,180
أجل

122
00:07:31,690 --> 00:07:35,570
آسفة. لم يتكلّم أحدٌ معي
في المدرسة من قبل

123
00:07:35,570 --> 00:07:36,550
ماذا؟

124
00:07:36,550 --> 00:07:38,690
حـ-حسناً، بما يمكنني خدمتكن؟

125
00:07:39,070 --> 00:07:42,170
أتيتِ إلى المدرسة صباح اليوم
رفقة مياما-كن، أليس كذلك؟

126
00:07:42,170 --> 00:07:43,800
...ماذا؟ في الواقع

127
00:07:43,800 --> 00:07:47,940
.سمعتُ بأنّكِ أتيتِ من أوساكا
هل أنتِ قريبة مياما-كن أو ما شابه؟

128
00:07:47,940 --> 00:07:50,980
...ماذا؟ لا، لستُ قريبته

129
00:07:50,980 --> 00:07:53,450
...عائلتانا مُقرّبتان

130
00:07:53,800 --> 00:07:55,450
لستِ خليلته، أليس كذلك؟

131
00:07:55,850 --> 00:07:57,420
!خـ-خليلة؟

132
00:07:57,420 --> 00:08:02,830
لا، لستُ خليلته... لكن انتهى المطاف
...بإقامتنا معاً

133
00:08:02,830 --> 00:08:04,330
!مهلاً لحظة

134
00:08:04,640 --> 00:08:08,340
كفّي عن الالتفاف وأجيبينا

135
00:08:10,930 --> 00:08:12,840
هذا يكفي. لنذهب

136
00:08:13,110 --> 00:08:15,430
ماذا؟

137
00:08:19,850 --> 00:08:22,880
...تُحملِق بي الفتيات من كلّ صوب

138
00:08:22,880 --> 00:08:23,810
يوشينو

139
00:08:26,950 --> 00:08:27,990
هل رأيتِ ذلك؟

140
00:08:27,990 --> 00:08:29,980
!مياما-كن وسيم جدّاً

141
00:08:30,420 --> 00:08:32,220
ما الخطب يا يوشينو؟

142
00:08:32,220 --> 00:08:36,340
أعتقد بأنّك... ذو شعبيّة

143
00:08:36,340 --> 00:08:37,990
أوتظنّين ذلك؟

144
00:08:37,990 --> 00:08:40,740
،لا يتكلّم معي أحد سوى إلقاء التّحيّة عليّ

145
00:08:41,030 --> 00:08:44,250
والجميع يعلمون بأنّني حفيد ياكوزا

146
00:08:44,700 --> 00:08:48,110
...حقّاً؟ خلتُهم لا يعلمون

147
00:08:48,570 --> 00:08:50,000
أليسوا خائفين؟

148
00:08:50,000 --> 00:08:53,610
في عصرنا هذا، إذا أبلغتِ عن أنَّ
،عضو ياكوزا قد أذاكِ

149
00:08:53,610 --> 00:08:54,760
فسرعان ما ستأتي الشّرطة

150
00:08:55,100 --> 00:08:58,410
،حتّى لو تواجد أحدٌ من الياكوزا
فهو ليس مُخيفاً ما دام لا يستطيع فعل شيء

151
00:08:58,410 --> 00:08:59,850
...هكذا إذاً

152
00:09:00,850 --> 00:09:02,850
ألا تكره ذلك يا كيريشيما؟

153
00:09:02,850 --> 00:09:03,540
ماذا؟

154
00:09:03,540 --> 00:09:08,110
مثلاً... ألا تنزعج من نظرات
النّاس باستغراب إليك؟

155
00:09:08,550 --> 00:09:10,130
أنزعج؟

156
00:09:10,640 --> 00:09:15,700
.لا، لم أفكّر في ذلك سابقاً
لا أُبالي بصراحة

157
00:09:21,230 --> 00:09:22,410
هل من مُشكلة؟

158
00:09:23,520 --> 00:09:25,610
لا، لا شيء

159
00:09:32,170 --> 00:09:34,920
!تبّاً! لا أستطيع النّوم

160
00:09:35,240 --> 00:09:38,400
!سيكون غداً سيّئاً إذا لم أستطع النّوم

161
00:09:40,930 --> 00:09:43,160
لا أُبالي بصراحة

162
00:09:45,320 --> 00:09:47,460
بدا شخصاً مُختلفاً تماماً

163
00:09:47,460 --> 00:09:48,710
سأشرب بعض الماء

164
00:10:03,010 --> 00:10:03,700
دماء؟

165
00:10:10,400 --> 00:10:12,110
يبدو كياكوزا

166
00:10:14,030 --> 00:10:18,980
آسفة. ارتأيتُ أن أشتري بعض الحاجيّات
اليوميّة عندما أتيتُ إلى هنا

167
00:10:18,980 --> 00:10:21,880
أكره السّؤال، لكن هلّا رافقتني؟

168
00:10:21,880 --> 00:10:24,010
أكيد. هل اللّيلة مُناسبة؟

169
00:10:24,370 --> 00:10:25,490
أ-أجل

170
00:10:25,900 --> 00:10:27,640
حسناً. ألقاكِ إذاً

171
00:10:30,040 --> 00:10:31,670
كان مُتحفِّظاً

172
00:10:32,830 --> 00:10:34,340
ربّما كنتُ أتخيّل ذلك

173
00:10:34,340 --> 00:10:36,280
...لا، لكن أقصد

174
00:10:39,280 --> 00:10:41,030
ماذا كان يفعل يا تُرى؟

175
00:10:41,380 --> 00:10:44,040
لا، لا. ما الّذي أتحدّث عنه أصلاً؟

176
00:10:44,040 --> 00:10:46,040
هل أنا مُرهَقة إلى هذا الحدّ من قلّة النّوم؟

177
00:10:46,040 --> 00:10:48,460
رأيتُ تلك التّلميذة المُنتقِلة أخيراً

178
00:10:48,460 --> 00:10:50,340
إنّها مُبهرَجة جدّاً

179
00:10:50,340 --> 00:10:53,040
ستُصيبني صدمة إذا كانت نوعه المُفضّل

180
00:10:53,040 --> 00:10:55,550
تعرفان منزل مياما-كن، أليس كذلك؟

181
00:10:55,550 --> 00:10:59,800
سمعتُ بأنّها كانت تعمل كمُومس
كي تُسدّد بعض الدَّين لهم

182
00:10:59,800 --> 00:11:01,240
!مستحيل

183
00:11:01,240 --> 00:11:03,790
.في الواقع، لا أستبعد ذلك
انظرا إلى وجهها فحسب

184
00:11:03,790 --> 00:11:06,870
!هذا مُزعج

185
00:11:07,840 --> 00:11:11,500
أعتقد لا يختلف هذا عن طوكيو أو أوساكا

186
00:11:12,970 --> 00:11:14,690
!كم هذا مُزعِج

187
00:11:14,690 --> 00:11:16,940
!آ-آسفة، لحظة

188
00:11:16,940 --> 00:11:19,190
هل تُمانع أن أسحب بعض
المال في المتجر؟

189
00:11:19,190 --> 00:11:20,570
!سأعود في الحال

190
00:11:20,570 --> 00:11:22,240
!انتظر هنا

191
00:11:27,330 --> 00:11:29,960
يا آنسة! تنّورتكِ مرفوعة

192
00:11:29,250 --> 00:11:30,900
!ماذا؟

193
00:11:30,900 --> 00:11:31,660
ماذا؟

194
00:11:32,090 --> 00:11:34,710
آسف. أعتقد كنتُ أتخيّل

195
00:11:34,710 --> 00:11:36,110
آسف

196
00:11:37,090 --> 00:11:39,850
هل أنتِ خارجة إلى مكان ما؟

197
00:11:39,850 --> 00:11:41,310
تفوح رائحتك بالكحول

198
00:11:41,310 --> 00:11:44,720
هل أنتِ مُتوجِّهة إلى العمل الآن؟
أتعملين في هذه الأرجاء؟

199
00:11:44,720 --> 00:11:47,640
...ماذا؟ لا، لستُ كذلك

200
00:11:47,640 --> 00:11:49,750
أتريديننا أن نوصلكِ؟

201
00:11:51,040 --> 00:11:53,310
...لـ-لحظة، هل هُم

202
00:11:55,520 --> 00:11:58,960
لم يتحدّث معي شخص في البلدة سوى

203
00:11:58,960 --> 00:12:02,790
!العمّ إيماي من حيّ التسوُّق

204
00:11:59,460 --> 00:12:02,790
أنتِ جميلة للغاية

205
00:12:04,700 --> 00:12:07,590
لا تقلقي. سنحرص على إيصالكِ
إلى حيث تُريدين

206
00:12:07,590 --> 00:12:11,500
!ماذا؟ لا، لحظة! ثمّة شخص ينتظرني

207
00:12:11,500 --> 00:12:12,340
!ماذا؟

208
00:12:12,340 --> 00:12:15,020
!أغلقي فمكِ وتعالي معنا فحسب

209
00:12:15,020 --> 00:12:17,210
...لـ-لا، بصراحة

210
00:12:17,210 --> 00:12:20,350
لا تُحاولي المُقاومة. فهذا مُزعج

211
00:12:21,970 --> 00:12:23,490
من أنت بالتّحديد؟

212
00:12:23,490 --> 00:12:25,900
أجل، لذا تلك الفتاة رفقتي

213
00:12:25,900 --> 00:12:27,350
هيّا بنا

214
00:12:29,930 --> 00:12:32,350
!انقلع قبل أن تتأذّى

215
00:12:35,650 --> 00:12:37,150
!مؤلم، مؤلم، مؤلم

216
00:12:37,390 --> 00:12:38,020
!ماذا؟

217
00:12:49,160 --> 00:12:50,180
ماذا؟

218
00:12:50,180 --> 00:12:52,330
!أ-أيّها الوغد

219
00:13:00,430 --> 00:13:04,510
...كـ-كيريشيما! أعتقد هذا يكفي

220
00:13:05,300 --> 00:13:08,680
آسف. سيستغرق الأمر مزيداً من الوقت

221
00:13:09,730 --> 00:13:14,220
هل تسمعني؟ تذكّر وجهي

222
00:13:14,220 --> 00:13:16,080
،تلك الفتاة مُلكي

223
00:13:16,080 --> 00:13:19,100
لذا احرص على عدم التكلُّم معها ثانية

224
00:13:20,670 --> 00:13:25,400
أيضاً، ابذل قصارى جهدك في إخبار
بقيّة أصدقائك عنّي

225
00:13:26,030 --> 00:13:27,940
،يمكنك مُحاولة الانتقام

226
00:13:27,940 --> 00:13:33,060
لكن إن فعلت، فلتعلم بأنّني سأقتلك
وأقتل أيّ شخص مُقرّب لك

227
00:13:33,060 --> 00:13:34,290
مفهوم؟

228
00:13:34,290 --> 00:13:35,330
...أجل

229
00:13:36,310 --> 00:13:38,220
حسناً، هيّا بنا يا يوشينو

230
00:13:38,220 --> 00:13:40,520
ماذا؟ ألا يجدر بنا استدعاء الإسعاف؟

231
00:13:40,520 --> 00:13:43,090
لا تقلقي، لن يموت

232
00:13:43,090 --> 00:13:46,900
لم يُغازلكِ شباب بهذه الطّريقة
من قبل، أليس كذلك؟

233
00:13:46,900 --> 00:13:47,590
ماذا؟

234
00:13:47,590 --> 00:13:53,120
هذا لأنّ النّاس المُحيطين بكِ كانوا
يعلمون بأنّكِ حفيدة الزّعيم سومي

235
00:13:53,580 --> 00:13:56,120
وأنا متأكّد بأنّه كان يرافقكِ شخص دوماً

236
00:13:56,120 --> 00:13:58,780
شخص لم يبدُ مُواطناً مُهذّباً حتماً

237
00:13:59,230 --> 00:14:03,360
.يجدر بكِ أن تتوخّي حذراً أكبر
فهذه ليست أوساكا

238
00:14:05,080 --> 00:14:06,570
...آسفة، أنا

239
00:14:06,570 --> 00:14:08,740
لا عليكِ. لنذهب

240
00:14:09,240 --> 00:14:13,240
انتظر لحظة. على هذا المُعدّل، قد يتّصل
!أحدهم بالشّرطة

241
00:14:13,950 --> 00:14:16,080
لا مُشكلة

242
00:14:16,750 --> 00:14:18,080
...أين منديلي

243
00:14:22,460 --> 00:14:24,380
...هذا

244
00:14:24,380 --> 00:14:25,210
ماذا؟

245
00:14:25,670 --> 00:14:27,950
ألم أخبركِ؟

246
00:14:27,950 --> 00:14:31,220
آسف لإخافتكِ. سأتوخّى حذراً
أكبر في المرّة المُقبلة

247
00:14:31,220 --> 00:14:33,220
المرّة المُقبلة؟

248
00:14:33,980 --> 00:14:35,210
هل من مُشكلة؟

249
00:14:43,780 --> 00:14:46,990
...آ-آسفة! أ-أنا

250
00:14:48,940 --> 00:14:52,240
أجل، لم أعُد أستطيع. هذا مُزعج

251
00:14:52,240 --> 00:14:53,240
!ماذا؟

252
00:14:53,780 --> 00:14:57,120
كنتُ قد عقدتُ عليكِ آمالاً
كبيرة يا يوشينو

253
00:14:57,550 --> 00:15:00,130
لستِ حفيدة زعيم عائلة سومي المُرتبِطة

254
00:15:00,130 --> 00:15:03,000
بعائلة كيريغايا فحسب، بل أنتِ جميلة أيضاً

255
00:15:03,000 --> 00:15:07,130
توقّعتُ أن تكوني مُدلّلة جدّاً
وأنانيّة للغاية

256
00:15:07,130 --> 00:15:11,510
ومُجرّد فتاة تظنُّ نفسها  مِحور الكون

257
00:15:12,510 --> 00:15:16,080
أحبُّ الفتيات المكروهات بواسطة الأُخريات

258
00:15:16,080 --> 00:15:19,980
أحبّ حقّاً أن أمتلك فتاة ليس
لديها ولو صديقة واحدة

259
00:15:19,980 --> 00:15:24,650
تتحكّم بي بلا رحمة أو إنسانيّة

260
00:15:24,900 --> 00:15:26,820
...ما الّذي

261
00:15:29,450 --> 00:15:31,570
ألا تفهمين ما أقوله؟

262
00:15:32,180 --> 00:15:37,080
،جوهريّاً، أنتِ طبيعيّة أكثر بكثير ممّا تخيّلت

263
00:15:37,080 --> 00:15:39,650
ظننتُ بأنّكِ ستستمرّين في ترفيهي
،لمدّة عام على الاقلّ

264
00:15:39,650 --> 00:15:42,580
لكن من العسير التّعامل معكِ الآن

265
00:15:42,890 --> 00:15:45,510
لكن هذه غلطتي لعقدي آمالاً كبيرة عليكِ

266
00:15:47,080 --> 00:15:49,760
ماذا تريدين أن تفعلي؟
هل ستعودين إلى أوساكا؟

267
00:15:50,610 --> 00:15:52,230
،يمكنكِ البقاء هنا إن أردتِ

268
00:15:52,230 --> 00:15:56,100
لكن الآن، أنتِ مجرّد لعوب لا قيمة
لها بالنّسبة لي

269
00:15:56,860 --> 00:16:00,620
إن كنتِ ستبقين، هلّا أصبحتِ
مُفيدة لي على الأقلّ؟

270
00:16:00,830 --> 00:16:01,850
ماذا؟

271
00:16:02,230 --> 00:16:05,020
أنتِ حسناء الوجه ورشيقة الجسد، صحيح؟

272
00:16:05,020 --> 00:16:07,110
ما رأيكِ ببيع جسدكِ ودرّ بعض المال؟

273
00:16:07,890 --> 00:16:10,610
نتعامل في الواقع مع خدمة مُرافقة

274
00:16:10,850 --> 00:16:12,690
،إذا عملتِ بجدّ

275
00:16:12,690 --> 00:16:15,620
فيجدر بكِ أن تتمكّني من كسب
مليون في غضون شهرين

276
00:16:16,060 --> 00:16:18,240
شِعارهم هو الجودة والنّظافة الشّخصيّة أيضاً

277
00:16:18,490 --> 00:16:22,000
ولديكِ خيارات ألطف أيضاً مثل
الأدوات الهزّازة وما شابه

278
00:16:22,260 --> 00:16:25,250
إن كنتِ ترين بأنّكِ لا تستطيعين التّعامل
مع ذلك، فيمكنكِ العودة إلى المنزل

279
00:16:25,490 --> 00:16:29,880
إذا عدتِ إلى أوساكا، فأخبريهم
بما قلتُه لكِ بالضّبط

280
00:16:30,270 --> 00:16:34,550
سيكون من الرّائع أن تنتهي
الأمور بفوضويّة من جديد

281
00:16:34,550 --> 00:16:38,390
.قد تتحوّل حياتي رأساً على عقِب
لا أطيق الانتظار

282
00:16:41,320 --> 00:16:46,160
لم أتخيّل وجود شخص مثله في هذا العالم

283
00:16:46,550 --> 00:16:48,390
ربّما سأعود إلى أوساكا

284
00:16:49,850 --> 00:16:52,030
لكن لم تمضِ تلك الفترة الطويلة

285
00:16:56,560 --> 00:16:58,380
وحل؟

286
00:16:58,380 --> 00:17:00,540
ما الّذي جاء بوحل إلى هنا؟

287
00:17:00,540 --> 00:17:03,040
...لحظة... هل يُعقَل أنَّ هذا

288
00:17:04,660 --> 00:17:05,790
تنمُّر؟

289
00:17:06,740 --> 00:17:08,090
هذا غير مُمكن

290
00:17:08,090 --> 00:17:10,890
لم أرَ مثالاً نمطيّاً كهذا في حياتي من قبل

291
00:17:11,630 --> 00:17:13,470
أظنّني سألتقط صورة

292
00:17:15,690 --> 00:17:17,860
!هذا مُبالغ به

293
00:17:17,860 --> 00:17:19,820
!أنتِ من قال بأن نفعل ذلك

294
00:17:25,690 --> 00:17:29,150
بجدّية، ما الّذي أفعله؟

295
00:17:34,230 --> 00:17:35,950
أريد العودة إلى أوساكا

296
00:17:36,240 --> 00:17:39,640
لا، لحظة. ما الّذي أقوله؟

297
00:17:47,180 --> 00:17:49,950
!يوشينو! أنا جدُّكِ

298
00:17:49,950 --> 00:17:51,290
ما أخباركِ؟

299
00:17:51,550 --> 00:17:54,550
جيّدة، لكن... ماذا؟ هل من مُشكلة؟

300
00:17:54,550 --> 00:17:59,550
لا، كنّا نتكلّم عن احتماليّة
أن تكوني قد حننتِ للدّيار

301
00:18:03,430 --> 00:18:05,100
ماذا؟ ما الخطب؟

302
00:18:05,580 --> 00:18:06,930
...لا، كلّ ما في الأمر

303
00:18:07,520 --> 00:18:08,560
هل تبكين؟

304
00:18:08,820 --> 00:18:11,030
أتدخل صُلبَ الموضوع مُباشرة؟

305
00:18:11,440 --> 00:18:14,220
لا تجري الأمور على ما يُرام مع حفيد مياما؟

306
00:18:17,400 --> 00:18:18,660
عام واحد

307
00:18:19,700 --> 00:18:22,700
،مهما اضطهدوكِ، مهما نبذوكِ

308
00:18:22,700 --> 00:18:26,200
،مهما اتّخذت الأمور منحى سيّئاً
لا تعودي إلى هنا قبل عام

309
00:18:27,220 --> 00:18:29,830
احفري ذلك في ذهنكِ مهما كلّف الأمر

310
00:18:30,080 --> 00:18:31,620
مفهوم يا يوشينو؟

311
00:18:32,020 --> 00:18:34,490
اقضي العام المُقبل تستدرجين
حفيد مياما ذاك

312
00:18:34,490 --> 00:18:36,590
نحو الوقوع في حبّكِ بجنون

313
00:18:36,590 --> 00:18:40,170
ثمّ بعد عام، تخلّي عنه وعودي إلى الدِّيار

314
00:18:40,170 --> 00:18:42,600
هذا أفضل انتقام يمكنكِ تنفيذه بحقّ شابّ

315
00:18:44,620 --> 00:18:47,780
ما أقصده هو أنّ كثيراً من النّساء
!تخلّينَ عنّي أيضاً

316
00:18:47,780 --> 00:18:50,010
عندما كنتُ أصغر، سقطتُ
،في علاقة ثلاث مرّات

317
00:18:50,010 --> 00:18:54,360
،وعندما رمَتْني أولئك الثّلاثة في بُحيرة
!ظننتُ نفسي هالكاً

318
00:18:55,600 --> 00:18:58,920
.أتكلّم معكِ بعد عام يا يوشينو
!سأعاود الاتِّصال بكِ. وداعاً

319
00:19:00,200 --> 00:19:04,370
كلّ الرِّجال في حياتي ليسوا سوى قُمامة

320
00:19:07,290 --> 00:19:11,370
حسناً، أظنّني سأضطرُّ للارتقاء لتوقُّعاتك

321
00:19:14,340 --> 00:19:17,040
...مرحباً؟ يوشينو تتكلّم

322
00:19:19,130 --> 00:19:22,420
لم أعُد أرى تلك الفتاة مُؤخّراً

323
00:19:22,420 --> 00:19:27,310
أجل. اختفت قبل حوالي أسبوعين

324
00:19:27,940 --> 00:19:30,430
لم تفعل شيئاً، أليس كذلك؟

325
00:19:30,430 --> 00:19:32,100
الزّعيم سيقتلك

326
00:19:32,560 --> 00:19:35,660
وإثارة هذا الخطر هو ما يُحفّزني
على فعل ذلك

327
00:19:36,790 --> 00:19:39,830
أنت مُريب جدّاً أيّها المازوخيّ اللّعين

328
00:19:43,950 --> 00:19:45,200
صباح الخير

329
00:19:46,200 --> 00:19:48,950
مضى وقت طويل. كيف حالك؟

330
00:19:49,360 --> 00:19:50,460
بخير

331
00:19:50,730 --> 00:19:53,020
ماذا عنكِ يا يوشينو؟

332
00:19:53,020 --> 00:19:54,950
أنا على أحسن ما يُرام

333
00:19:54,950 --> 00:19:56,920
هل ظننتَ بأنّني عدتُ إلى أوساكا؟

334
00:19:56,920 --> 00:19:59,090
بصراحة، أجل

335
00:19:59,090 --> 00:20:04,010
هل تتذكّر عندما قلتَ بأنّ الجانب الجيّد
الوحيد لديّ هو وجهي وجسدي؟

336
00:20:04,010 --> 00:20:06,350
وبأنّني ينبغي أن أبيع جسدي
مُقابل بعض المال

337
00:20:06,350 --> 00:20:08,100
أجل، أتذكّر

338
00:20:08,460 --> 00:20:10,850
بصراحة، أخافني ذلك

339
00:20:12,450 --> 00:20:15,200
وأجل. بعتُ جسدي

340
00:20:15,640 --> 00:20:17,860
بعتُ كِلْيتي بأربعة مليون

341
00:20:20,640 --> 00:20:22,860
كِلْيتكِ؟ أين؟

342
00:20:22,860 --> 00:20:25,950
في شيكوكو. وقّعتُ عقداً من خِلال عدّة أشخاص

343
00:20:25,950 --> 00:20:28,170
جعلتُهم يستأصلونها بمنظار داخليّ

344
00:20:28,170 --> 00:20:32,870
سأقضي بقيّة حياتي أضبط تناوُلي للأملاح

345
00:20:33,120 --> 00:20:36,280
على أيّ حال، سأعود إلى صفّي

346
00:20:36,280 --> 00:20:38,980
وأيضاً، لن أعود إلى أوساكا

347
00:20:38,980 --> 00:20:43,380
لا أبالي إطلاقاً إذا كنتَ مجرّد
!مازوخيّ لعين

348
00:20:45,270 --> 00:20:49,140
لكن تعلم ما سيحدث إذا تجاوزت
حدودك، أليس كذلك؟

349
00:20:49,140 --> 00:20:50,040
!أنتن

350
00:20:50,400 --> 00:20:52,140
أتكلّم معكن أنتن الثّلاثة أيضاً

351
00:20:52,140 --> 00:20:57,840
،مهما حاولتُ أن أعيش حياة نزيهة
سأموت ميتة بشِعة

352
00:20:58,150 --> 00:20:59,400
...في هذه الحالة

353
00:20:59,400 --> 00:21:02,120
حتّى لو قضيتُ أيّامي أحبو
،ويخرج الدّم من فمي

354
00:21:02,120 --> 00:21:06,930
سآخذكم معي جميعاً إلى الجحيم
!وأفسد حياتكم

355
00:21:08,490 --> 00:21:10,810
على أيّ حال، أحببتُ إبلاغك فحسب

356
00:21:17,820 --> 00:21:19,410
ماذا؟

357
00:21:20,390 --> 00:21:22,090
!أحبّكِ

358
00:21:23,920 --> 00:21:27,130
!لم أشعر بإثارة كهذه في حياتي

359
00:21:27,130 --> 00:21:28,180
!ما زلتُ مُتحمِّساً

360
00:21:28,700 --> 00:21:32,180
،لا بدّ أنّ هذا يعني بأنّني أحبّكِ
أليس كذلك يا يوشينو؟

361
00:21:32,180 --> 00:21:34,250
لحظة، ماذا؟

362
00:21:34,250 --> 00:21:36,500
!أحبّكِ! لنتزوّج

363
00:21:36,500 --> 00:21:38,770
!أريدكِ أن تعبثي بحياتي

364
00:21:38,770 --> 00:21:40,270
!ماذا؟

365
00:21:40,270 --> 00:21:42,880
!لا بدّ أنّ العبث موجود في عقلك

366
00:21:42,880 --> 00:21:45,130
!هل نسيتَ فوراً ما أخبرتني به قبل أيّام؟

367
00:21:45,130 --> 00:21:47,070
!أجل، آسف حقّاً بشأن ذلك

368
00:21:47,070 --> 00:21:50,030
!لكنّني أيقنتُ الآن! كنتُ على خطأ

369
00:21:50,030 --> 00:21:52,300
!لا، بجدّية! أنا واقع في حبّكِ
!استُثِرتُ الآن

370
00:21:52,300 --> 00:21:54,430
!أنت مُقرف للغاية

371
00:21:55,750 --> 00:21:57,920
حسناً، فهمت

372
00:21:57,920 --> 00:22:00,670
سأخبر ابني أيضاً

373
00:22:00,670 --> 00:22:01,900
أتكلّم معك لاحقاً

374
00:22:02,960 --> 00:22:04,310
هل من مُشكلة؟

375
00:22:05,390 --> 00:22:08,690
...حدث أمر مُزعج للتو