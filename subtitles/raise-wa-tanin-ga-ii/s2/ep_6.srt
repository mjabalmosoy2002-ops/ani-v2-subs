1
00:00:02,730 --> 00:00:05,120
كيريشيما قال ذلك؟

2
00:00:05,120 --> 00:00:09,240
بأنّه ذهب إلى أوساكا لرؤيتك
عندما كان عمره 12 سنة

3
00:00:09,240 --> 00:00:11,620
لكن قال بأنّه لم يتمكّن من إيجادكِ

4
00:00:11,880 --> 00:00:13,870
ولماذا يفعل ذلك؟

5
00:00:13,870 --> 00:00:15,190
سؤال سديد

6
00:00:15,190 --> 00:00:18,110
ربّما كان يحبّكِ بالفعل آنذاك؟

7
00:00:18,410 --> 00:00:22,830
حسناً، كان في الأصل يعتقد بأنّني
ساقطة مُدلّلة حمقاء لسبب ما

8
00:00:23,240 --> 00:00:26,380
لستُ أدري ما إن كان يحبّني فعليّاً

9
00:00:26,380 --> 00:00:27,880
ماذا تقصدين؟

10
00:00:28,210 --> 00:00:34,380
،يراودني شعور بأنّني إذا أحببتُه فعلاً
فسيفقد كلَّ الاهتمام بي

11
00:00:34,380 --> 00:00:38,390
،ليست مسألة أنّه يحبّني
إنّما هو مهووس بي

12
00:00:38,390 --> 00:00:41,640
لكن إذا أخبرتُه بذلك، فسوف يسعى
،للكذب من أجل التستّر على نواياه

13
00:00:41,640 --> 00:00:44,510
ممّا سيُصعّب أكثر حتّى عمليّة
اكتشاف ما يفكّر فيه

14
00:00:44,510 --> 00:00:50,390
من الأسهل لي أن يستمرّ في التصرّف
كمريض نفسيّاً... على ما أعتقد

15
00:00:50,390 --> 00:00:52,890
يا إلهي، يبدو هذا شاقّاً للغاية

16
00:00:52,890 --> 00:00:57,260
وأن يكون كريشيما-كن هو أوّل
...شخص يعترف لكِ

17
00:00:57,260 --> 00:00:58,410
لَهو مأزق حقيقيّ

18
00:00:58,710 --> 00:01:00,910
!إنّها ليست غلطتي أنا

19
00:01:00,910 --> 00:01:05,650
هل تكلّمتِ يوماً مع كيريشيما-كن
حول خليلته القديمة؟

20
00:01:06,750 --> 00:01:09,120
...أعلم بأنّه لعوب، لكن

21
00:01:09,560 --> 00:01:15,180
نحن عادةً لا نتكلّم سوى عن الطّعام
أو الأحداث الحاليّة، لذا كلّا

22
00:01:15,180 --> 00:01:19,420
مذهل! قفزتُما فوق مرحلة المُواعدة ورحتُما
مباشرة للتصرّف كزوجين متقاعدين عجوزين؟

23
00:01:20,930 --> 00:01:24,680
لا تعلمين فيما إذا كنتِ ستعودين
،إلى أوساكا أو تبقين في طوكيو

24
00:01:24,680 --> 00:01:28,430
...ولا تعلمين فيما إذا كان يحبّكِ أم لا

25
00:01:28,430 --> 00:01:31,170
أنصحكِ بالبدء في تصحيح الأمور

26
00:01:31,560 --> 00:01:35,700
إذا كان الاحتمال الأوّل صحيحاً، فحتّى العودة
إلى المنزل لن تعني نهاية مشكلة

27
00:01:36,590 --> 00:01:39,310
،الفصل الأوّل قد انتهى

28
00:01:39,310 --> 00:01:41,540
...وستبدأ الإجازة الصّيفيّة غداً

29
00:01:41,900 --> 00:01:47,040
هل هو هوسٌ أم حُبّ؟ وكيف يُفترض
!بي أن أكتشف ذلك؟

30
00:01:48,920 --> 00:01:50,700
هل تريد الانضمام لنا؟

31
00:01:52,280 --> 00:01:54,330
!ا-المعذرة

32
00:01:54,690 --> 00:01:57,090
...تلميذات أكبر سنّاً يُظهِرن لي هذا الاحترام

33
00:01:57,620 --> 00:02:00,090
.آسف لو تركتُكِ تنتظرين يا يوشينو
لنعُد إلى المنزل

34
00:02:00,430 --> 00:02:02,090
عمّاذا كنتم تتكلّمون؟

35
00:02:02,090 --> 00:02:04,770
،سيُفتَتح الحرم في الصّيف

36
00:02:04,770 --> 00:02:07,090
لذا كنّا نناقش من سينتهي المطاف
باستلامه واجب الدّليل

37
00:02:07,480 --> 00:02:10,710
إنّ العناية بالزّائرين تندرج تحت
مسؤوليّة لجنة الانضباط

38
00:02:10,710 --> 00:02:12,210
وهذا يعني أنا

39
00:02:12,780 --> 00:02:14,370
!أنت؟! انضباط؟

40
00:02:14,370 --> 00:02:15,000
أجل

41
00:02:15,000 --> 00:02:18,410
!هل هذه مزحة؟! لا تملك ذرّة انضباط

42
00:02:18,410 --> 00:02:22,520
،قد أنتهك القانون، لكن بصورة عامّة
أنا أطيع القواعد المدرسيّة

43
00:02:22,520 --> 00:02:26,490
مُعظم التّلاميذ يميلون لانتهاك القواعد
!المدرسيّة، لا القانون

44
00:02:29,670 --> 00:02:33,710
بصراحة، ظننتُ أنّ تلكما الفتاتين
كانتا تطلبان مواعدتك

45
00:02:33,710 --> 00:02:36,950
بالطّبع لا. تقرّبتْ منّي بضع فتيات
،عندما كنتُ في السّنة الأولى

46
00:02:36,950 --> 00:02:40,090
لكن بما أنّني رفضتُهن جميعاً، يفترضنَ
،بأنّني سأرفض مجدّداً

47
00:02:40,090 --> 00:02:42,090
لهذا توقّفنَ عن المُحاولة

48
00:02:42,260 --> 00:02:44,780
ليس لديك أي أصدقاء شباب، صحيح؟

49
00:02:44,780 --> 00:02:46,060
ما الّذي يجعلكِ تقولين ذلك؟

50
00:02:46,060 --> 00:02:48,590
،لأنّني إذا كنتُ شابّاً وسمعتُ ذلك
فسوف أغضب

51
00:02:48,890 --> 00:02:51,360
أنتِ كلّ ما أحتاجه على أيّ حال يا يوشينو

52
00:02:52,860 --> 00:02:55,820
تقصد أن تقول لي بأنّني أحلّ
مكان الأصدقاء الشّباب في نظرك؟

53
00:02:55,820 --> 00:02:57,440
هذا ما أعتقده، أجل

54
00:02:57,440 --> 00:03:00,380
فأنتِ صديقتي الأولى

55
00:03:01,420 --> 00:03:04,360
لكن كلّ ما نتحدّث عنه هو الطّعام
!والأحداث الرّاهنة

56
00:03:04,620 --> 00:03:07,570
لكنّكِ الوحيدة الّتي أتكلّم معها حول تلك الأمور

57
00:03:08,870 --> 00:03:11,990
الفتيات يتكلّمنَ معي حتّى لو لم أفعل شيئاً

58
00:03:11,990 --> 00:03:14,100
أنتِ الوحيدة الّتي أجري محادثات معها

59
00:03:14,100 --> 00:03:15,880
حول أشياء كالطّعام والأخبار

60
00:03:15,880 --> 00:03:17,760
...هذا يعني

61
00:03:17,760 --> 00:03:21,880
أنّك تبدو وكأنّك تنوي الزّواج
...من أوّل صديق تتعرّف عيه

62
00:03:22,090 --> 00:03:24,640
معكِ حقّ. هذا صحيح

63
00:03:24,890 --> 00:03:30,160
...أ-أعتقد هذا يتجاوز الحبّ أو الهوس

64
00:03:30,160 --> 00:03:33,830
أيفهم أصلاً ما الّذي يعنيه الاهتمام
عاطفيّاً بشخص ما؟

65
00:03:34,890 --> 00:03:36,860
...بغضّ النّظر عن تصرّفه مع خليلاته القديمات

66
00:03:36,860 --> 00:03:39,470
،إن لم يكن يعتبرني مشروع حبيبة مثلهن

67
00:03:39,470 --> 00:03:43,550
فما الّذي كنتُ أخاطر بحياتي
لأجله طوال هذا الوقت بالضّبط؟

68
00:03:43,550 --> 00:03:45,240
هذا مُحزِن

69
00:05:20,300 --> 00:05:21,960
...هناك

70
00:05:22,220 --> 00:05:24,130
هل هي شيوتا ناو؟

71
00:05:24,130 --> 00:05:26,180
ألم تكن مُمثّلة طفلة؟

72
00:05:26,180 --> 00:05:28,960
ثمّ اعتزلتْ لأنّ والديها انتقلا
إلى أمريكا بداعي العمل؟

73
00:05:28,960 --> 00:05:31,640
في العام الماضي، ربحتْ بمُنافسة جمال
في سيتوكو يو

74
00:05:31,640 --> 00:05:34,290
!وظهرَتْ كمُقدِّمة أخبار تلميذة في قنوات الأخبار

75
00:05:34,290 --> 00:05:37,480
إنّها ظريفة للغاية! أظنّها عادت إلى اليابان

76
00:05:37,480 --> 00:05:39,820
ناو! آسفة لو تأخّرنا

77
00:05:39,820 --> 00:05:42,310
لم أقصد ذلك، لكن كنتُ أتكلّم مع المخرج

78
00:05:42,310 --> 00:05:45,250
الخاصّ بذلك الإعلان التّجاريّ الّذي صوّرتُه
مؤخّراً وانتهى المطاف بتأخّرنا

79
00:05:45,250 --> 00:05:46,460
شكراً

80
00:05:48,240 --> 00:05:51,760
عندما ذكرتُكِ يا ناو، كان مهتمّاً بلقائكِ

81
00:05:51,760 --> 00:05:54,600
حقّاً؟ ربّما ينبغي أن ألقي عليه التّحية

82
00:05:54,600 --> 00:05:59,230
بالتّأكيد! ستعملين في برامج فنّية
!ثانية في العام المقبل

83
00:05:59,230 --> 00:06:02,240
!برامج؟ سأعمل كموظّفة مكتبيّة

84
00:06:02,240 --> 00:06:05,980
!ستعملين مُذيعة أخبار في شبكة كبرى
وليس مُوظّفة مكتبيّة

85
00:06:05,980 --> 00:06:08,020
أنتِ مشهورة من الأساس

86
00:06:08,590 --> 00:06:09,760
ماذا؟

87
00:06:09,760 --> 00:06:11,370
هل هذا أوزو-كن؟

88
00:06:11,370 --> 00:06:13,100
كنتِ تخرجين معه، أليس كذلك يا ناو؟

89
00:06:13,100 --> 00:06:14,380
...في الواقع، أجل

90
00:06:14,380 --> 00:06:17,000
!لماذا انفصلتُما؟ إنّه وسيم

91
00:06:17,310 --> 00:06:20,740
عندما اكتشفَ بأنّني سأشارك
،في مسابقة جمال

92
00:06:20,740 --> 00:06:23,780
"قال "لم أكن أعلم بأنّكِ مهووسة بلفت الانتباه

93
00:06:23,780 --> 00:06:26,780
!ماذا؟ حقّاً؟ يسرّني أنّكِ هجرتِه إذاً

94
00:06:27,710 --> 00:06:32,200
هذا مزعج نظراً إلى أنّكِ لستِ كذلك يا ناو

95
00:06:32,200 --> 00:06:36,300
لم أشارك إلّا لأنّ أحد المُنظّمين توسّلني كي أفعل

96
00:06:36,300 --> 00:06:37,930
يا له من كلام فارغ

97
00:06:38,530 --> 00:06:43,160
أعلم بأنّهن يعتقدنني سرّاً مُخطِّطة ماكرة

98
00:06:43,160 --> 00:06:45,340
لكن أين العيب في ذلك؟

99
00:06:45,340 --> 00:06:48,590
كلّ ما أفعله هو بذل مجهود أكبر من المألوف
لجذب محبّة النّاس لي

100
00:06:48,590 --> 00:06:52,670
وفي نهاية المطاف، أنا الأنجح في مجموعتنا

101
00:06:52,670 --> 00:06:56,300
أقلق على مدى سذاجتكِ أحياناً يا ناو-تشان

102
00:06:56,300 --> 00:06:58,940
لا تتورّطي مع أيّ شخص خطير، اتّفقنا؟

103
00:06:58,940 --> 00:07:01,440
...لا أتخيّلها أبداً مع شخص مُخيف

104
00:07:01,440 --> 00:07:03,890
كالشّاب الّذي هناك

105
00:07:03,890 --> 00:07:05,410
أليس هذا كيريشيما-كن؟

106
00:07:05,410 --> 00:07:06,940
لم أره منذ مدّة

107
00:07:07,200 --> 00:07:08,380
كيريشيما...؟

108
00:07:08,950 --> 00:07:11,460
هناك إشاعات غريبة تحوم حوله

109
00:07:11,460 --> 00:07:12,700
صحيح

110
00:07:13,340 --> 00:07:17,200
أتتذكّرن تلك الفتاة الّتي كانت تخطّط لتصبح
مُمثّلة وبدأتْ بجلسات تصوير؟

111
00:07:17,200 --> 00:07:20,790
انتهى المطاف بها في أداء بطولة
عمل إباحيّ ما قبل أن تُفقَد

112
00:07:20,790 --> 00:07:25,710
وقبل فقدانها، رأتها إحدى صديقاتها
رفقة كيريشيما-كن

113
00:07:25,980 --> 00:07:28,690
...نسمع هذه القصص كثيراً

114
00:07:28,690 --> 00:07:32,410
.لم أتكلّم مع كيريشيما-كن إلّا بضع مرّات
لا أعرفه كثيراً

115
00:07:32,970 --> 00:07:34,540
تسرّني رؤيتكن من جديد

116
00:07:36,840 --> 00:07:38,760
!تسرّني رؤيتك

117
00:07:38,760 --> 00:07:42,390
كنّا نقول كيف أنّنا لم نعُد نراك مؤخّراً

118
00:07:42,390 --> 00:07:45,120
حقّاً؟ لكن رأيتُكِ كثيراً

119
00:07:45,120 --> 00:07:48,130
ظهرتِ في ذلك الإعلان التّجاري لصالة
زفاف، أليس كذلك يا سارا-تشان؟

120
00:07:48,130 --> 00:07:50,610
!مذهل، أنا مندهشة من ملاحظتك ذلك

121
00:07:52,110 --> 00:07:55,380
بالمناسبة، أعتقد بأنّ هذه أوّل
مرّة تلتقي فيها بها

122
00:07:55,380 --> 00:07:57,360
فازت بمُسابقة جمال في كلّيتها

123
00:07:57,360 --> 00:07:59,130
أجل، أعلم

124
00:08:00,860 --> 00:08:03,070
تظلّ مشغولة

125
00:08:03,070 --> 00:08:05,500
رأيتُها في وسائل التّواصل الاجتماعيّ قبل أيّام

126
00:08:05,500 --> 00:08:07,370
!تعرف كلّ شيء عنها إذاً

127
00:08:07,370 --> 00:08:08,550
،على ذكر الأمر

128
00:08:08,550 --> 00:08:11,380
سوف تشاركين في حدث ضخم
في أوساكا قريباً، صحيح يا ناو؟

129
00:08:11,380 --> 00:08:12,900
...أ-أجل

130
00:08:12,900 --> 00:08:15,190
هذا مُبهر

131
00:08:15,190 --> 00:08:17,360
ربّما ينبغي أن أحضر إذا كان
جدول أعمالي شاغراً

132
00:08:20,910 --> 00:08:22,680
لا أحد يعلم

133
00:08:22,680 --> 00:08:26,020
ناو، ذهبتِ إلى مدرسة ميناتوياما
الابتدائيّة، أليس كذلك؟

134
00:08:26,020 --> 00:08:29,150
سمعتُ بأنّه وقع حادث عنيف ضخم هناك

135
00:08:29,150 --> 00:08:32,400
.وحتّى أنّه تمّ التستّر عليه
أليس هذا ضرباً من الجنون؟

136
00:08:32,750 --> 00:08:36,160
ناو، هل تعرفين كيريشيما-كن؟
هل أعرّفكِ عليه؟

137
00:08:36,160 --> 00:08:39,880
في الواقع... أعرف عنك منذ فترة طويلة

138
00:08:39,880 --> 00:08:42,160
أنت حفيد ياكوزا، أليس كذلك؟

139
00:08:44,160 --> 00:08:48,820
حدث ذلك خلال الفترة القصيرة الّتي عدتُ
...فيها إلى اليابان أثناء عطلة الصّيف، لكن

140
00:08:49,660 --> 00:08:52,630
كنتُ في سريره كلّ يوم تقريباً

141
00:08:53,440 --> 00:08:56,470
رغم علمي بمدى خطورته

142
00:08:59,670 --> 00:09:00,870
لم أركِ منذ وقت طويل

143
00:09:02,550 --> 00:09:03,940
بالفعل

144
00:09:03,940 --> 00:09:06,840
المعذرة... آسفة بشأن ما سبق

145
00:09:06,840 --> 00:09:10,320
لا عليكِ. كنتُ أتظاهر بعدم معرفتكِ أيضاً

146
00:09:10,320 --> 00:09:12,450
فقد كان ذلك قبل ثلاث سنوات

147
00:09:12,650 --> 00:09:14,940
لا تقلقي. لن أخبر أحداً

148
00:09:14,940 --> 00:09:17,960
آسفة لأنّني سبّبتُ لك المتاعب هكذا

149
00:09:18,240 --> 00:09:20,530
ناو-تشان، تغيّرتِ حقّاً

150
00:09:21,000 --> 00:09:24,450
أتذكّر بأنّكِ كنتِ من النّوع الّذي
يعبّر عن رأيه بصراحة أكبر

151
00:09:24,450 --> 00:09:26,490
قد تكون على حقّ

152
00:09:26,490 --> 00:09:29,720
عند العيش خارج البلاد، يجب عليك
،أن تكون أكثر صراحة بالتّعبير

153
00:09:29,720 --> 00:09:31,950
لكن في اليابان سيجذب هذا الأنظار نحوي

154
00:09:31,950 --> 00:09:35,200
لا تحاولي جاهدةً أن تندمجي، اتّفقنا؟

155
00:09:35,200 --> 00:09:37,710
أجل، أعلم. شكراً

156
00:09:37,990 --> 00:09:40,900
مهلاً، أردتُ إعطاءك شيئاً

157
00:09:41,510 --> 00:09:44,750
...ولو أنّها بطاقة عمل شخص آخر

158
00:09:45,160 --> 00:09:47,690
لكن دوّنتُ معلومات الاتّصال بي خلفها

159
00:09:47,690 --> 00:09:50,690
أبلغيني إذا احتجتِ شيئاً. إلى اللّقاء

160
00:09:54,300 --> 00:09:56,150
أليست هذه...؟

161
00:09:56,150 --> 00:09:57,790
لديه علاقات عجيبة

162
00:10:05,050 --> 00:10:07,280
هل عاد كيريشيما؟

163
00:10:09,000 --> 00:10:10,910
لا أرى شيئاً

164
00:10:11,680 --> 00:10:15,590
في الواقع يا يوشينو-تشان، بغضّ
،النّظر عن خليلاته السّابقات

165
00:10:15,590 --> 00:10:18,790
هل تعرفين حتّى كيف يقضي
كيريشيما-كن وقته؟

166
00:10:26,480 --> 00:10:27,650
مرحباً؟

167
00:10:27,650 --> 00:10:28,840
كيريشيما؟

168
00:10:28,840 --> 00:10:30,560
كنتُ أتساءل ما إن عدت

169
00:10:30,560 --> 00:10:33,070
عدتُ بالفعل. ما الأمر؟

170
00:10:34,040 --> 00:10:37,760
أتتذكّر كيف قلتُ بأنّني سأعود
إلى الدّيار من أجل مهرجان بون؟

171
00:10:37,760 --> 00:10:39,740
،لكن عندما فكّرتُ في زحمة العطل الرّسميّة

172
00:10:39,740 --> 00:10:43,070
ارتأيتُ أنّ 7 أو 8 أغسطس سيكون
وقتاً أفضل ربّما للحصول على تذاكر

173
00:10:43,320 --> 00:10:46,800
عندما تكون مشغولاً حينها، فيمكنك
المجيء في وقت لاحق دوماً

174
00:10:46,800 --> 00:10:48,080
هل هذا يفي بالغرض؟

175
00:10:48,080 --> 00:10:50,130
هذه... ليست مشكلة تماماً

176
00:10:50,130 --> 00:10:53,590
لكن هل من الممكن أن نذهب
إلى هناك في يوليو؟

177
00:10:53,590 --> 00:10:55,010
...لا أمانع، لكن

178
00:10:55,010 --> 00:10:59,510
إن كنتَ مشغولاً جدّاً، فيمكنني دوماً المرور
بصورة سريعة ثمّ العودة، حسناً؟

179
00:10:59,510 --> 00:11:01,580
ما هذا الّذي تقولينه؟
هذا حلم في نظري

180
00:11:01,580 --> 00:11:03,600
أنا متحمّس له في الواقع

181
00:11:03,600 --> 00:11:05,590
لا أطيق انتظار السّفر إلى أوساكا

182
00:11:06,510 --> 00:11:08,230
...الحرّ شديد

183
00:11:08,650 --> 00:11:13,240
لم يمضِ إلّا ثلاثة أشهر فقط، لكن
تبدو لي وكأنّها فترة طويلة جدّاً

184
00:11:13,490 --> 00:11:17,130
أعلم بأنّني سألتُ من قبل، لكن نظراً
،إلى أنّني يجب أن أزور القبور

185
00:11:17,130 --> 00:11:18,590
ماذا ستفعل في تلك الأثناء؟

186
00:11:18,590 --> 00:11:21,180
لن يكون جدّي في المنزل قبل أغسطس أيضاً

187
00:11:21,180 --> 00:11:24,250
لا تقلقي. سأتجوّل فحسب

188
00:11:24,250 --> 00:11:26,400
لم آتِ إلى أوساكا كثيراً من قبل

189
00:11:26,400 --> 00:11:27,740
ماذا؟ حقّاً؟

190
00:11:29,690 --> 00:11:35,350
حسناً، من حيث المظهر واللّغة، تبدو وكأنّك
فتى لطيف حسن التّربية من طوكيو

191
00:11:35,350 --> 00:11:38,370
لذا أتوسّل إليك، حتّى لو بدأ شخصٌ ما
بالتفوّه بكلام فارغ معك، اضبط نفسك

192
00:11:39,500 --> 00:11:43,880
لا أحد يعلم ما طبيعة المشكلة الّتي
قد تُقحِم نفسك بها هنا

193
00:11:43,880 --> 00:11:47,510
فقط ابقَ حيث أستطيع مراقبتك. مفهوم؟

194
00:11:48,400 --> 00:11:50,520
يبدو هذا وكأنّكِ تهتمّين لأمري

195
00:11:50,520 --> 00:11:51,770
هلّا كرّرتِ كلامكِ؟

196
00:11:51,770 --> 00:11:53,380
!كُن أكثر جدّية

197
00:11:53,670 --> 00:11:54,740
حسناً، أيّاً يكن

198
00:11:54,740 --> 00:11:58,280
حاليّاً، سنتوقّف عند أوميدا، وأعتقد بأنّنا
نستطيع تناول الغداء بينما نحن هناك

199
00:11:58,510 --> 00:11:59,710
ما الّذي يخطر على ذهنك؟

200
00:11:59,710 --> 00:12:03,110
أنا نيّقة بشأن رائحة فطائر اللّحم، لذا
أميل لشرائها قرب المنزل

201
00:12:03,110 --> 00:12:06,110
وأفضل مطعم أوكونومياكي أعرفه
موجود بالقرب من المنزل أيضاً

202
00:12:06,110 --> 00:12:08,870
حسناً... لا بأس في أيّ شيء تفضّلينه يا يوشينو

203
00:12:08,870 --> 00:12:10,660
!فليكن أوكونومياكي إذاً

204
00:12:10,660 --> 00:12:12,040
أشتهي الصّلصة خاصّتها

205
00:12:12,040 --> 00:12:14,730
يمكننا شراء حبّار مشويّ مع الأرزّ
في متجر هانشين

206
00:12:14,730 --> 00:12:16,330
!قد أمرّ بهانكيو أيضاً

207
00:12:21,420 --> 00:12:26,060
ها قد وصلنا! يا لها من رحلة طويلة من طوكيو

208
00:12:26,060 --> 00:12:29,640
لنستقلّ سيّارة أجرة. ثمّ يمكننا
شراء الأوكونومياكي في الطّريق

209
00:12:29,640 --> 00:12:31,680
ما زلتِ لم تنتهِ من التسوُّق؟

210
00:12:32,030 --> 00:12:34,860
!أخيراً أشعر بأنّني في الدّيار

211
00:12:35,260 --> 00:12:37,930
آسفة لأنّني أخذتُك معي
إلى كلّ مكان هكذا

212
00:12:38,220 --> 00:12:40,050
لا، لا مانع لديّ إطلاقاً

213
00:12:40,050 --> 00:12:42,790
بما أنّكِ تستمتعين، فأنا أستمتع
أيضاً يا يوشينو

214
00:12:42,790 --> 00:12:45,950
وقد مضى وقت طويل منذ رأيتُكِ
تبتسمين آخر مرّة

215
00:12:47,670 --> 00:12:49,720
،تكونين ظريفة وأنتِ غاضبة

216
00:12:49,720 --> 00:12:52,450
لكن في نهاية المطاف، تبدين
الأجمل عندما تبتسمين

217
00:12:54,040 --> 00:12:57,680
ها أنت من جديد تتفوّه بهراء
...كهذا دون خجل

218
00:12:58,370 --> 00:12:59,960
!المعذرة يا حضرة السّائق

219
00:13:03,310 --> 00:13:06,610
!أنت! ماذا تفعل هنا؟

220
00:13:08,900 --> 00:13:11,600
أنا... آكل تاكوياكي؟

221
00:13:11,600 --> 00:13:14,800
...في وسط الشّمس الحارقة

222
00:13:14,800 --> 00:13:18,000
لكن ليس هذا مقصدي! ماذا عن دروسك؟

223
00:13:18,000 --> 00:13:19,800
انتهيتُ من دروسي اليوم

224
00:13:19,800 --> 00:13:20,610
!كاذب

225
00:13:20,610 --> 00:13:23,500
حسناً، أتيتُ إلى هنا لأقلكِ يا يوشينو-سان

226
00:13:23,500 --> 00:13:27,110
توقّعتُ أن يكون هذا أوّل مكان تأتين
إليه للغداء بعد عودتكِ

227
00:13:27,110 --> 00:13:30,370
كيف عرفت؟ لم أُخبرك بشيء

228
00:13:30,370 --> 00:13:32,610
يوشينو، ماذا عن سيّارة الأجرة؟

229
00:13:33,870 --> 00:13:35,090
مرحباً

230
00:13:38,040 --> 00:13:41,650
تبّاً، قلتُ له ألّا يفتعل شِجاراً حتّى
،لو استفزّه شخص

231
00:13:41,650 --> 00:13:46,000
لكن لم أتوقّع أن يكون الجاني الأكبر
!موجوداً في الدّيار

232
00:13:46,000 --> 00:13:48,930
!كيريشيما، أنزل الأمتعة

233
00:13:48,930 --> 00:13:51,010
سأدفع أجرة السّيارة

234
00:13:53,640 --> 00:13:56,050
لا ترمِ رماد سيجارتك أمام مطعمي

235
00:13:56,050 --> 00:13:58,650
كنتِ تدخّنين باستمرار

236
00:13:58,650 --> 00:14:02,020
،هذا لأنّه مطعمي أيّها الأبله
لذا يحقّ لي ذلك

237
00:14:02,020 --> 00:14:04,260
!عمّتي! مضى وقت طويل

238
00:14:04,490 --> 00:14:08,160
هذه أنتِ يا يوشينو-تشان؟ كيف حالكِ؟

239
00:14:08,160 --> 00:14:09,990
!مهلاً، تمهّلي لحظة

240
00:14:09,990 --> 00:14:12,550
من هذا الشّاب الوسيم؟ حبيبكِ؟

241
00:14:13,430 --> 00:14:15,040
!لا، لا، لا

242
00:14:15,040 --> 00:14:17,860
!اللّعنة! كم هو جميل

243
00:14:17,860 --> 00:14:19,660
"لديه شكل "ممثّل يافع

244
00:14:20,740 --> 00:14:22,170
شكراً جزيلاً لكُن

245
00:14:22,420 --> 00:14:25,420
من أين هو؟ هل هو أحد أبناء الزّعيم الصّغار؟

246
00:14:25,800 --> 00:14:28,310
أنا زميل يوشينو-سان في الصفّ

247
00:14:28,310 --> 00:14:29,670
أتيتُ من طوكيو

248
00:14:29,670 --> 00:14:31,170
!من طوكيو؟

249
00:14:31,170 --> 00:14:34,190
!لهذا تتمتّع بمظهر شخص لامع الذّكاء

250
00:14:34,410 --> 00:14:38,060
!وأنا الّذي ظننتُ بأنّه محبوبكن الصّغير الجديد

251
00:14:38,060 --> 00:14:40,540
!لا نملك مالاً لجعله كذلك

252
00:14:40,540 --> 00:14:44,180
بالفعل. إنّ شابّاً يافعاً كهذا
سيرفضنا على الأغلب

253
00:14:44,180 --> 00:14:45,890
!مهما كان السّعر الّذي نُقدّمه

254
00:14:48,400 --> 00:14:53,340
لا أتّفق. سيكون من دواعي سروري أن أدع
سيّدات حسناوات مثلكن يعتنين بي

255
00:14:53,340 --> 00:14:54,410
...ها هو ذا

256
00:14:54,920 --> 00:14:56,610
!هل سمعتما ذلك؟

257
00:14:56,610 --> 00:14:58,830
!من الواضح أّنّه ليس من أوساكا

258
00:14:59,120 --> 00:15:01,700
،شوما! أنت وسيم أيضاً

259
00:15:01,700 --> 00:15:04,170
لذا ربّما عليك أن تتعلّم بعض
!الدّروس في الكلام

260
00:15:04,820 --> 00:15:06,410
اصمتي يا حمقاء

261
00:15:06,410 --> 00:15:09,000
لم أرَ شخصاً وسيماً كهذا منذ مدّة طويلة

262
00:15:09,000 --> 00:15:11,270
عزيزي، تفضّل مصروف جيب منّي إليك

263
00:15:11,270 --> 00:15:12,550
اذهب واشترِ لنفسك شراباً

264
00:15:12,550 --> 00:15:14,290
!مهلاً! ليس عليكما فعل ذلك

265
00:15:14,290 --> 00:15:16,320
!لا مشكلة، لا مشكلة

266
00:15:16,780 --> 00:15:19,820
تلقّيت نقوداً للتو مقابل وسامتك

267
00:15:20,610 --> 00:15:22,060
هل ينبغي أن أحتفظ به؟

268
00:15:22,320 --> 00:15:24,640
لقد غادرتا، لذا افعل ذلك فحسب

269
00:15:24,640 --> 00:15:27,210
يمكننا شراء ملفوف مشويّ به
ونحن في الطّريق إلى المنزل

270
00:15:28,300 --> 00:15:30,330
...أنا مُرهقة

271
00:15:30,330 --> 00:15:33,340
رحلة السّفر ليست مُمتعة عندما
تكون بداعي العمل

272
00:15:33,340 --> 00:15:35,990
ناو، ستظهرين في نزهة الشلّة خاصّتك، أليس كذلك؟

273
00:15:35,990 --> 00:15:37,200
أعمال تطوّعية وما شابه، صحيح؟

274
00:15:37,200 --> 00:15:40,200
أجل، لكن أريد أن ألقي التّحية فحسب

275
00:15:40,530 --> 00:15:42,950
على ذكر الأمر، هل رأيتِ أوزو-كن مؤخّراً؟

276
00:15:43,610 --> 00:15:45,640
ألم تكوني في نفس الشلّة معه؟

277
00:15:45,640 --> 00:15:47,300
وهل تتذكّرين ما قلتُه لكِ؟

278
00:15:47,300 --> 00:15:50,230
منذ تلك الحفلة، كان يتواصل معي

279
00:15:50,230 --> 00:15:54,970
أجل، أعتقد بأنّه سيحضر العمل
التطوّعيّ في كانساي

280
00:15:54,970 --> 00:15:57,220
...حسناً. أعتقد هذا مناسب

281
00:15:57,890 --> 00:15:59,210
هل حدث شيء؟

282
00:16:04,600 --> 00:16:08,700
ليس ذلك فقط، لكن أمّه هي تلك المُذيعة
التّلفزيونيّة المستقلّة، كوندو ساكيكو

283
00:16:08,700 --> 00:16:11,230
إنّها شهيرة! هل كنتِ تعلمين؟

284
00:16:11,920 --> 00:16:14,990
خرجنا معاً لحوالي ثلاثة أشهر فقط، لذا لا

285
00:16:15,500 --> 00:16:17,700
كنتُ أعلم ذلك بالطّبع

286
00:16:17,700 --> 00:16:20,240
لعلّ ذلك كان أهمّ سبب جعلني
أبدأ في مواعدته

287
00:16:20,240 --> 00:16:22,530
،حسناً، إنّها مجرّد إشاعة

288
00:16:22,530 --> 00:16:28,500
لكن سمعتُ بأنّ بعض التّلاميذ من الجامعة
حاولوا جرّ إحدى عارضي الأزياء إلى فندق

289
00:16:28,500 --> 00:16:30,250
انتهى المطاف بتدخّل الشّرطة

290
00:16:30,600 --> 00:16:33,270
بما أنّ للأمر علاقة بإمبريس، تساءلتُ
ما إن كان صديقاً لأوزو-كن

291
00:16:33,270 --> 00:16:34,970
هل حدث ذلك فعلاً؟

292
00:16:34,970 --> 00:16:39,770
،بما أنّه ثريّ، وربّما يعرف الكثير من الفتيات
فأنا واثقة بأنّ الشّباب يحاولون استغلاله

293
00:16:40,020 --> 00:16:43,680
،لذا كنتُ أقول لنفسي، إن كنتِ قد سمعتِ به

294
00:16:43,680 --> 00:16:47,520
فلعلّه كان يحاول أن يعرّفكِ على شخص

295
00:16:48,090 --> 00:16:50,290
...أتساءل عن مدى احتماليّة ذلك

296
00:16:50,290 --> 00:16:53,660
يمكنك تجاهل الأمر فحسب إذاً

297
00:16:53,660 --> 00:16:55,430
أو ربّما الحصول على حبيب جديد؟

298
00:16:55,430 --> 00:16:58,750
،لديّ صديقة كلّما بدأ غريب أطوار بمُلاحقتها

299
00:16:58,750 --> 00:17:02,920
فإنّها تستعين بشخص قويّ المظهر
ثمّ تُحلّ المشكلة تلقائيّاً

300
00:17:03,920 --> 00:17:05,920
أبلغيني إذا احتجتِ شيئاً

301
00:17:07,960 --> 00:17:09,290
!أهلاً بعودتكِ

302
00:17:09,620 --> 00:17:11,790
مرحباً. تسرّني عودتي

303
00:17:13,790 --> 00:17:16,300
ما الأمر؟ ادخل بسرعة

304
00:17:18,120 --> 00:17:19,380
أستميحكم عذراً

305
00:17:20,120 --> 00:17:22,760
.من دواعي سروري أن ألتقي بكم جميعاً
اسمي مياما كيريشيما

306
00:17:22,760 --> 00:17:24,320
سأقيم معكم لبعض الوقت

307
00:17:24,320 --> 00:17:26,390
سمعنا عنك

308
00:17:26,390 --> 00:17:28,560
كذلك نحن، يسرّنا وجودك معنا

309
00:17:28,920 --> 00:17:31,760
شوما، ضع هذه البقالة في الثلّاجة

310
00:17:31,760 --> 00:17:32,570
حسناً

311
00:17:35,260 --> 00:17:37,930
لنتوجّه إلى غرفتي حاليّاً

312
00:17:40,260 --> 00:17:42,900
...إذاً هذا حفيد الزّعيم مياما

313
00:17:42,900 --> 00:17:44,990
وسندعه يقيم في المنزل؟

314
00:17:44,990 --> 00:17:49,500
،أقصد... إذا قال الزّعيم بأنّه لا مانع
فلا مانع، صحيح؟

315
00:17:50,320 --> 00:17:52,310
الحرّ شديد

316
00:17:53,720 --> 00:17:56,720
ضع الأغراض جانباً فحسب ثمّ
استلقِ على السّرير

317
00:17:59,910 --> 00:18:03,270
أعتقد سنتناول الغداء هنا أو ربّما
في غرفة الضّيوف

318
00:18:03,270 --> 00:18:05,720
عندما يكون جدّي حاضراً، فإنّنا
،نتناول وجبات طعام كبيرة يوميّاً

319
00:18:05,720 --> 00:18:09,540
لذا سنأكل مع مجموعة من الأشخاص
الآخرين شئنا أم أبينا ذلك

320
00:18:09,540 --> 00:18:11,550
ماذا يجدر بنا أن نفعل على العشاء؟

321
00:18:12,970 --> 00:18:14,610
هل ستجلس؟

322
00:18:18,720 --> 00:18:20,880
هل هناك ما هو غريب في الغرفة؟

323
00:18:20,880 --> 00:18:23,360
لا. إنّها جميلة حقّاً

324
00:18:23,360 --> 00:18:26,380
أوتظنّ ذلك؟ تبدو عاديّة جدّاً في نظري

325
00:18:26,740 --> 00:18:28,150
هل هذه مصنوعة يدويّاً؟

326
00:18:28,150 --> 00:18:29,120
هذه؟

327
00:18:29,420 --> 00:18:32,460
التحقتُ بنادي حِرفيّات في المدرسة
الابتدائيّة وصنعتُ بعض الأشياء

328
00:18:32,460 --> 00:18:33,640
ليست كلّها ناجحة

329
00:18:34,250 --> 00:18:37,180
إنّها ظريفة. ومتقنة الصّنع

330
00:18:37,180 --> 00:18:39,120
يمكنك الاحتفاظ بها إن أردت

331
00:18:39,380 --> 00:18:41,890
!ربّما لا تحتاج هذا الشّيء العتيق

332
00:18:43,250 --> 00:18:44,650
هل يمكنني الاحتفاظ بها؟

333
00:18:45,460 --> 00:18:46,780
أكيد، لا مانع

334
00:18:47,860 --> 00:18:48,910
شكراً لكِ

335
00:18:50,750 --> 00:18:52,580
—في هذه الحالة، ربّما واحدة جديدة

336
00:18:52,580 --> 00:18:53,530
!يوشينو-سان

337
00:18:54,420 --> 00:18:55,410
ما الأمر؟

338
00:18:55,410 --> 00:18:59,030
وجدتُ بعض كعك الأرز المُتجمّد بين
البقالة. ماذا أفعل به؟

339
00:18:59,890 --> 00:19:02,450
آسفة، عليّ النّزول إلى الطّابق السّفليّ

340
00:19:14,400 --> 00:19:17,420
يا إلهي! لم نتناول كوشيكاتسو منذ فترة

341
00:19:17,840 --> 00:19:21,070
كان لذيذاً، لكن ألم تلحظ بأنّ المكان
كان مُبهرجاً زيادة عن اللّزوم؟

342
00:19:21,070 --> 00:19:23,380
لا أبالي ما دام الطّعام لذيذاً

343
00:19:23,380 --> 00:19:26,450
كلّ ما يهمّك هو أن تملأ معدتك

344
00:19:26,450 --> 00:19:27,950
كان بوسعي أكل المزيد

345
00:19:27,950 --> 00:19:29,920
ما مشكلة معدتك بالضّبط؟

346
00:19:31,310 --> 00:19:33,950
كيريشيما، ماذا عنك؟ هل أعجبك؟

347
00:19:33,950 --> 00:19:35,180
أجل، بالطّبع

348
00:19:35,180 --> 00:19:38,060
حقّاً؟ هذا مُطمئن

349
00:19:42,260 --> 00:19:44,200
هذا مُرهِق

350
00:19:44,430 --> 00:19:46,620
حسناً، ينبغي أن أذهب

351
00:19:46,620 --> 00:19:48,420
لحظة، لماذا؟

352
00:19:48,420 --> 00:19:51,100
حجزتُ في غرفة في فندق قريب

353
00:19:51,100 --> 00:19:53,060
سآتي إلى المنزل في صباح الغد

354
00:19:53,060 --> 00:19:56,640
حجزتَ في غرفة فندق؟ بوسعك
!المكوث في منزلنا فحسب

355
00:19:56,960 --> 00:20:00,190
لا، هذه ليست فكرة سديدة

356
00:20:00,190 --> 00:20:02,590
...لكن تركتَ حقائبك هناك

357
00:20:02,590 --> 00:20:06,080
طلبتُ إرسال حاجيّاتي الأساسيّة
من طوكيو إلى الفندق بالفعل

358
00:20:06,080 --> 00:20:09,830
حسناً، سأذهب. اعتنِ بيوشينو من فضلك

359
00:20:09,830 --> 00:20:11,450
ويا يوشينو، سأراكِ غداً

360
00:20:11,450 --> 00:20:13,640
حسناً، أراك غداً

361
00:20:14,670 --> 00:20:18,120
هل هو هكذا دوماً؟

362
00:20:18,120 --> 00:20:21,180
أجل، معظم الوقت

363
00:20:21,610 --> 00:20:22,710
لماذا؟

364
00:20:22,710 --> 00:20:24,150
عليكِ أن تتكلّمي معه أكثر

365
00:20:24,370 --> 00:20:25,620
أتكلّم معه؟

366
00:20:25,620 --> 00:20:28,640
إنّ شُبّاناً مثله يجب أن تتكلّمي معهم
أكثر كيف تكتشفي نواياه

367
00:20:29,120 --> 00:20:31,950
فلا أحد يعلم ما قد يفعله

368
00:20:31,950 --> 00:20:33,660
عمّاذا تتكلّم؟

369
00:20:34,010 --> 00:20:36,530
يوشينو-سان، أنتِ تتركينه طليقاً

370
00:20:36,530 --> 00:20:39,670
...وتبدين بأنّكِ تتصرّفين باسترخاء زائد
أو ربّما بعدم اكتراث

371
00:20:39,670 --> 00:20:43,780
،أنا لا أسأله لأنّه لا يريد الحديث عن نفسه

372
00:20:43,780 --> 00:20:46,170
ولا أفهم كيف تفسّر هذا
على أنّه عدم اكتراث

373
00:20:46,430 --> 00:20:48,250
أظنّكِ على حقّ

374
00:20:48,250 --> 00:20:50,760
بالتّفكير في الأمر الآن، ربّما هذا غير مهمّ

375
00:20:50,760 --> 00:20:54,050
!أنت! لا تحاول شراء هذا في غفلة عنّي

376
00:20:54,050 --> 00:20:56,800
!إذا أردت هذا، فأرجع هذا

377
00:20:59,880 --> 00:21:02,830
قالت تسوباكي كلاماً مشابهاً

378
00:21:03,110 --> 00:21:04,950
أعتقد يستحقّ الأمر التّجربة

379
00:21:13,340 --> 00:21:16,330
لا تقلقي. لستُ ياكوزا

380
00:21:16,880 --> 00:21:19,600
كيريشيما-كن، لماذا أنت هنا في أوساكا؟

381
00:21:20,050 --> 00:21:21,990
أردتُ رؤيتكِ يا ناو

382
00:21:21,990 --> 00:21:24,100
مهلاً! أتكلّم معك بجدّية

383
00:21:24,320 --> 00:21:26,010
وأنا كذلك

384
00:21:26,010 --> 00:21:28,580
لماذا تواصلتِ معي يا ناو؟

385
00:21:29,300 --> 00:21:30,600
هل حدث شيء؟

386
00:21:30,970 --> 00:21:33,650
...ليس تماماً

387
00:21:33,650 --> 00:21:35,510
رغبتُ في ذلك فحسب

388
00:21:35,510 --> 00:21:37,620
هل ستكون في أوساكا غداً أيضاً؟

389
00:21:37,620 --> 00:21:38,810
سأبقى هنا لبعض الوقت

390
00:21:38,810 --> 00:21:41,360
رغم أنّني كنتُ أفكّر بالتوجّه
إلى كيوتو يوم غد

391
00:21:41,360 --> 00:21:42,860
في موعد غراميّ مع حبيبتك؟

392
00:21:43,420 --> 00:21:45,330
لا أملك حبيبة

393
00:21:45,760 --> 00:21:47,880
لكن هناك شخص أعتقد بأنّني أحبّه

394
00:21:48,660 --> 00:21:51,120
أنت مُريب حقّاً يا كيريشيما-كن

395
00:21:52,090 --> 00:21:54,040
غلبتِني في ذلك

396
00:21:54,040 --> 00:21:55,580
سوف أستحمّ