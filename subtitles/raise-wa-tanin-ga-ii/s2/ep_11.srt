1
00:00:06,650 --> 00:00:09,620
لحظة، هل كان أبي يحبّ السّاكي فعلاً؟

2
00:00:09,620 --> 00:00:11,100
لا، إطلاقاً

3
00:00:11,510 --> 00:00:14,280
كان حتّى أجبن منكِ

4
00:00:14,280 --> 00:00:17,600
أظنّه لم يكن يريد الشّرب لأنّه
كان يخشى صُداع الخمر

5
00:00:19,720 --> 00:00:22,630
...سأكون أكبر سنّاً ممّا كان عمّا قريب

6
00:00:22,890 --> 00:00:26,420
أجل. بالإضافة إلى ذلك، كان كيوسكي
في التّاسعة عشر عندما تزوّج

7
00:00:27,190 --> 00:00:29,970
...أي على بُعد سنة عنّي

8
00:00:29,970 --> 00:00:31,620
لا أستطيع حتّى تخيُّل ذلك

9
00:00:36,100 --> 00:00:37,000
...مهلاً لحظة

10
00:00:37,360 --> 00:00:38,560
هل تضعين المكياج؟

11
00:00:38,560 --> 00:00:40,010
ما-ماذا لو كنتُ كذلك؟

12
00:00:40,330 --> 00:00:43,300
لا تبدين مختلفة إلى هذا الحدّ حتّى

13
00:00:43,300 --> 00:00:45,700
!إذا فعلتِها، فستصبحين مصطنعة حقّاً

14
00:00:45,700 --> 00:00:48,400
!مُحال! عمّاذا تتكلّم حتّى؟

15
00:02:19,410 --> 00:02:22,050
كان ذلك وشيكاً حقّاً

16
00:02:22,050 --> 00:02:25,130
يسرّني أنّ المكياج تمكّن من خِداعه
وجعله يرى كم كنتُ مُحطَّمة

17
00:02:25,130 --> 00:02:29,740
سيُشفى وجهكِ قريباً، لكن
ماذا حدث للسنّ الّذي فقدتِه؟

18
00:02:29,740 --> 00:02:33,570
،في الواقع، زرتُ طبيبَ أسنان صباح اليوم
وقال بأنّه ينبغي أن يتمكّن من علاجه

19
00:02:33,570 --> 00:02:34,750
هذا مُطمئن

20
00:02:35,120 --> 00:02:37,270
سأبحث عن طبيب أسنان في طوكيو أيضاً

21
00:02:37,270 --> 00:02:39,020
اسمحي لي أن أحمل هذه عنكِ

22
00:02:39,020 --> 00:02:40,760
!لا! لا داعي

23
00:02:40,760 --> 00:02:43,600
تبدوان سعيدين جدّاً بشأن
،التكتّم على هذا الأمر

24
00:02:43,600 --> 00:02:47,530
لكن إذا انفعلتِ كثيراً، فسوف
يكشف رينجي-سان أمرك

25
00:02:47,530 --> 00:02:49,230
يجب أن تضعي هذا بالحسبان

26
00:02:49,230 --> 00:02:51,010
أجل. آسفة

27
00:02:51,710 --> 00:02:55,520
مع أنّ هناك شخصاً يبدو أكثر غضباً منّي

28
00:02:55,520 --> 00:02:59,210
شوما؟ اعتذرتُ منه بالفعل أيضاً

29
00:02:59,210 --> 00:03:00,770
تفترضين بأنّه ما زال غاضباً؟

30
00:03:01,810 --> 00:03:06,030
لستُ غاضباً، ويجب أن تكفّي عن الثّرثرة

31
00:03:06,030 --> 00:03:08,840
بالكاد فتحت فمك فتشاجرتما؟

32
00:03:08,840 --> 00:03:11,050
أنتم الجانحون مُزعِجون جدّاً

33
00:03:11,290 --> 00:03:14,650
انظروا من يتكلّم هنا

34
00:03:14,650 --> 00:03:18,570
إنّ القرد أكثر أدباً منكِ

35
00:03:18,570 --> 00:03:19,940
!يا إلهي

36
00:03:19,940 --> 00:03:23,380
يراودني فضول كيف لفتى **** أن
يكون مُنافِقاً هكذا

37
00:03:23,380 --> 00:03:26,340
رجال أوساكان فظيعون حقّاً

38
00:03:26,340 --> 00:03:28,770
**** ضعي حذاء في فمكِ الـ*** و

39
00:03:28,770 --> 00:03:30,610
حرّكي مؤخّرتكِ وعودي إلى كيوتو

40
00:03:30,610 --> 00:03:33,460
لا تمانعهما. يفعلان هذا دوماً

41
00:03:33,460 --> 00:03:34,570
حقّاً؟

42
00:03:34,870 --> 00:03:39,430
منذ أتى تسوباكي أوّل مرّة والتقى بشوما

43
00:03:39,430 --> 00:03:42,190
ما أنتِ؟ استعراضيّة؟

44
00:03:42,950 --> 00:03:45,570
إن كنت تنظر، فأرِني كيف تُستثار

45
00:03:47,190 --> 00:03:48,900
يوشينو

46
00:03:52,190 --> 00:03:53,830
لديكِ رمش مُنفلت

47
00:04:00,080 --> 00:04:01,910
...مهلاً، مهلاً

48
00:04:01,910 --> 00:04:04,340
يفتقران للنّضج

49
00:04:04,910 --> 00:04:06,410
أتّفق

50
00:04:06,410 --> 00:04:09,590
وشوما-كن أيضاً. في معظم الأحيان

51
00:04:15,600 --> 00:04:17,160
اسمي مياما كيريشيما

52
00:04:17,160 --> 00:04:18,840
سررتُ بلقائكم جميعاً

53
00:04:18,840 --> 00:04:20,360
!سُررنا بلقائك

54
00:04:20,990 --> 00:04:25,270
دعني أخبرك يا فتى... تُشبه غاكو تماماً

55
00:04:25,270 --> 00:04:27,030
هذا يُخيفني بعض الشّيء

56
00:04:27,980 --> 00:04:30,380
لا تقل ذلك. هذه وقاحة

57
00:04:30,380 --> 00:04:32,230
،فكّري في الأمر. بالنّسبة لي

58
00:04:32,230 --> 00:04:36,270
أشعر وكأنّ أحد زملائي القدامى
يحاول إغواء حفيدتي

59
00:04:36,270 --> 00:04:37,360
أليس كذلك يا تسوباكي؟

60
00:04:37,360 --> 00:04:38,970
بالتّأكيد

61
00:04:38,970 --> 00:04:41,370
لا تتّفقي معه في كلّ شيء

62
00:04:41,720 --> 00:04:43,660
تحبّ يوشينو إذاً؟

63
00:04:44,380 --> 00:04:45,680
أجل، صحيح

64
00:04:45,680 --> 00:04:46,760
!توقّف

65
00:04:46,760 --> 00:04:51,940
أنا واثق بأنّني أحبّ يوشينو أكثر
من أيّ شخص في العالم بأسره

66
00:04:52,980 --> 00:04:56,020
لديه جرأة أكبر من قطيع حيتان

67
00:04:57,290 --> 00:05:00,980
هذا يُشعرني بالعطش؟ ماذا عنك؟
أتريد بيرة؟

68
00:05:00,980 --> 00:05:03,910
لا، لا. غالباً لا يشرب على أيّ حال

69
00:05:03,910 --> 00:05:06,100
!لحظة، من الّذي لا يشرب؟

70
00:05:06,100 --> 00:05:07,190
أنا؟

71
00:05:07,190 --> 00:05:08,400
ما أدراك بذلك؟

72
00:05:08,640 --> 00:05:11,670
جدّ هذا الفتى لا يشرب الخمر

73
00:05:11,670 --> 00:05:13,420
سُمّه هو السكّر

74
00:05:13,420 --> 00:05:14,890
...جدّه

75
00:05:15,500 --> 00:05:17,430
لحظة، هل تقصد مياما؟

76
00:05:17,430 --> 00:05:19,840
تبدوان مُقرّبين

77
00:05:19,840 --> 00:05:22,830
يذكّرني هذا باستعارتي لأوّل
،سيّارة اشتراها

78
00:05:22,830 --> 00:05:25,680
دون أن أخبره فهويتُ بها في نهر

79
00:05:25,680 --> 00:05:27,670
!تبّاً

80
00:05:28,370 --> 00:05:29,570
!ما خطبك بالضّبط؟

81
00:05:29,570 --> 00:05:31,460
!أقول لكِ كانت حادِثة سير حقيقيّة

82
00:05:31,910 --> 00:05:35,390
لذا ما فعلتُه كان انتزاع المرآة الجانبيّة
ثمّ تعليقها على درّاجة

83
00:05:35,390 --> 00:05:37,650
كانت قد رُكِنَتْ عند مفترق طُرُق
باتشينكو وأعدتها إليه

84
00:05:37,650 --> 00:05:38,940
!فقدت عقلك تماماً

85
00:05:39,240 --> 00:05:41,040
ثمّ ماذا حدث؟

86
00:05:41,040 --> 00:05:42,810
نفس ردّة الفعل

87
00:05:43,380 --> 00:05:48,540
ثمّ بعد أن انفجر ضاحكاً، أوسعني ضرباً

88
00:05:49,160 --> 00:05:54,030
لا أعرف السّبب، لكن كان الرّجل رائعاً
في القتال والمُقامرة

89
00:05:54,030 --> 00:05:56,440
ولا أستطيع هزيمته حتّى
في ورق حجرة مقصّ

90
00:05:56,440 --> 00:05:58,160
!ورق، حجرة، مقصّ؟

91
00:05:58,160 --> 00:05:59,780
يا رجُل، هل أنت...؟

92
00:06:00,890 --> 00:06:02,400
!مرحباً سيّدي

93
00:06:04,880 --> 00:06:06,020
ها أنت ذا

94
00:06:06,020 --> 00:06:08,170
آسف لتأخُّري

95
00:06:08,170 --> 00:06:09,980
لا عليك

96
00:06:09,980 --> 00:06:13,010
يوشينو، لديّ بعض الأعمال للاهتمام بها

97
00:06:13,010 --> 00:06:15,850
أخبري الفتيان أن ينصرفوا حالما يتأخّر الوقت

98
00:06:15,850 --> 00:06:17,290
لا نريد إزعاج الجيران

99
00:06:17,290 --> 00:06:17,970
حسناً

100
00:06:26,410 --> 00:06:28,030
تعال إلى القبو لاحقاً

101
00:06:30,900 --> 00:06:31,870
استعداد

102
00:06:35,890 --> 00:06:37,330
المعذرة

103
00:06:37,330 --> 00:06:40,670
آسف لنزولك إلى هنا

104
00:06:40,940 --> 00:06:42,410
لا مُشكلة إطلاقاً

105
00:06:42,660 --> 00:06:46,160
كلّ شيء مُجهَّز بإتقان، صحيح؟
!مُكيّف هواء وعازل للصّوت

106
00:06:46,740 --> 00:06:49,160
لكن لا أعلم ما إن كان هذا
ينفعني في اللّعبة

107
00:06:49,160 --> 00:06:53,670
لا تلق بالاً للدّماء. كان شوما هنا قبل قليل

108
00:06:54,930 --> 00:06:57,930
هلّا فسّرت وجود هذه النّدبة في عينك؟

109
00:06:58,240 --> 00:07:00,930
تشاجرتُ قليلاً مع شوما-سان

110
00:07:00,930 --> 00:07:02,660
حقّاً؟ لماذا؟

111
00:07:02,660 --> 00:07:05,240
لا سبب مهمّ، لكن دخلنا في جِدال

112
00:07:06,120 --> 00:07:08,090
قال شوما نفس الكلام

113
00:07:08,090 --> 00:07:09,450
لم يقل شيئاً آخر أيضاً

114
00:07:10,360 --> 00:07:13,190
ماذا كنتَ تفعل في المدينة قبل أيّام؟

115
00:07:13,460 --> 00:07:16,270
ثمّة شخص كان يواجه مُشكلة
ثأر شخصيّة معي

116
00:07:16,270 --> 00:07:18,560
لكن تمكنّا من مُعالجة الأمر

117
00:07:18,560 --> 00:07:20,620
وكان لا بدّ من حدوث ذلك في أوساكا؟

118
00:07:20,620 --> 00:07:21,570
أنا آسف يا سيّدي

119
00:07:23,760 --> 00:07:26,090
حدّثني عن هذا الثّأر الشّخصيّ

120
00:07:26,350 --> 00:07:30,340
بعض المُرتبطين بتلك الفتاة من شركة
آكازا كانوا لا يزالون مُتواجدين

121
00:07:30,340 --> 00:07:34,360
ذلك الفتى الأحمق من وكالة المواهب
البارزة كان مُتورّطاً أيضاً، صحيح؟

122
00:07:34,360 --> 00:07:37,590
كانت مُشكلته مُنفصلة... تخصّ
فتاة أعرفها قديماً

123
00:07:38,800 --> 00:07:40,960
مشاكلك كثيرة، أليس كذلك يا فتى؟

124
00:07:41,360 --> 00:07:45,100
ويوشينو تتقصّى عن الأمر. هل كان السّبب
هو هذه الأشياء الّتي تفعلها؟

125
00:07:45,580 --> 00:07:47,100
أنا آسف حقّاً يا سيّدي

126
00:07:53,980 --> 00:07:56,830
أتظنّ نفسك ذكيّاً حقّاً؟

127
00:07:56,830 --> 00:07:59,550
أزلتَ كافّة الأدلّة في الحديقة

128
00:07:59,550 --> 00:08:02,210
لم يتمكّن أحدٌ من رجالي من إيجاد
،شيء مهمّ

129
00:08:02,210 --> 00:08:04,250
حتّى في مقطع كاميرات المُراقبة

130
00:08:05,390 --> 00:08:09,420
أنت مُخضرم في هذا، صحيح؟
...لم تتناول سوى الشّاي قبل قليل أيضاً

131
00:08:09,950 --> 00:08:13,260
لأنّك علمتَ بأنّك سوف تتقيّأ

132
00:08:13,690 --> 00:08:16,230
...هذا يجعلني أتساءل كيف ربّاك غاكو

133
00:08:16,710 --> 00:08:20,010
إذاً تُصرّ على أنّ هذه كانت مسألة شخصيّة؟

134
00:08:20,010 --> 00:08:21,700
إنّها الحقيقة

135
00:08:21,700 --> 00:08:23,780
ويوشينو لم تكن مُتورّطة؟

136
00:08:23,780 --> 00:08:24,940
لا يا سيّدي

137
00:08:25,810 --> 00:08:30,020
تبّاً يا فتى. أنت مثل غاكو فعلاً

138
00:08:30,020 --> 00:08:32,520
يا لكما من ثنائي غريب

139
00:08:32,860 --> 00:08:36,830
...أوقف موتُ كيوسكي الأمور لبعض الوقت

140
00:08:36,830 --> 00:08:39,070
لكن صبري ينفد هنا

141
00:08:41,130 --> 00:08:46,110
.لكن سأضطرّ للحِفاظ عليك
اعتنِ بيوشينو

142
00:08:47,700 --> 00:08:49,120
بالطّبع

143
00:08:49,400 --> 00:08:53,130
هل أخبرتِ شوما-كن أنّكِ تُواعدين
كيريشيما-كن الآن؟

144
00:08:53,740 --> 00:08:55,280
،نظراً إلى أنّني رأيتُكِ مؤخّراً

145
00:08:55,280 --> 00:08:57,530
لم أتوقّع أن تخرجا معاً بهذه السّرعة

146
00:08:57,530 --> 00:09:01,140
أقصد بأنّنا نخرج معاً فقط لأنّني
...خسرتُ في حجر ورقة مقصّ

147
00:09:01,480 --> 00:09:06,180
!بالإضافة إلى أنّه كان يعلم بأنّه سوف يربح

148
00:09:06,180 --> 00:09:07,210
!أيّ غشّ هو هذا؟

149
00:09:07,210 --> 00:09:09,950
رغم ذلك، هكذا كان الاتّفاق، صحيح؟

150
00:09:11,150 --> 00:09:13,440
ما الّذي يعنيه الخروج معاً
حتّى على أيّ حال؟

151
00:09:13,440 --> 00:09:16,910
حسناً، في حالتي، يعني المُواعدة
والتّقبيل والجنس

152
00:09:18,400 --> 00:09:21,680
،استرخي. أعرف كيريشيما-كن جيّداً

153
00:09:21,680 --> 00:09:24,430
لن يفعل شيئاً يؤرقكِ

154
00:09:24,430 --> 00:09:27,720
أ-أجل، معكِ حقّ. مُحال أن يفعل أشياء كهذه

155
00:09:27,720 --> 00:09:30,560
لكن لا تجعليه خاتماً في إصبعكِ الصّغير

156
00:09:30,920 --> 00:09:33,140
،بمصطلحات البيسبول، كيريشيما-كن مُحترف

157
00:09:33,140 --> 00:09:35,840
وأنتِ لا تعلمين حتّى كيف تلتقطين كُرة

158
00:09:35,840 --> 00:09:37,320
عمّاذا تتكلّمين؟

159
00:09:37,320 --> 00:09:42,230
يبدو من النّوع الّذي يشدّ الخِناق عليكِ
تدريجيّاً مع الوقت باعتقادي

160
00:09:42,230 --> 00:09:45,470
يُشبه بائعاً مُتجوِّلاً يدخل منزلكِ
بالكلام المعسول

161
00:09:45,880 --> 00:09:46,920
بائع؟

162
00:09:46,920 --> 00:09:51,240
حالما يدخل، ينتهي الأمر، وينتهي المطاف بكِ
بتوقيع عقد من مجرّد الإصغاء إلى كلامه

163
00:09:51,240 --> 00:09:52,310
عقد...؟

164
00:09:52,580 --> 00:09:54,850
فـ-في الواقع، ستكون الأمور بخير

165
00:09:54,850 --> 00:09:56,910
...لديه فتيات أُخريات، لذا

166
00:09:56,910 --> 00:09:58,110
ألديه حقّاً الآن؟

167
00:09:58,420 --> 00:09:59,970
ماذا؟

168
00:09:59,970 --> 00:10:03,890
يوشينو-تشان... هل يمكنكِ تقبيل
أو مُمارسة الجنس مع شخص مثله؟

169
00:10:03,890 --> 00:10:05,830
!ما-ما هذا السّؤال؟

170
00:10:05,830 --> 00:10:09,880
يبدو من الرّجال الصّادقين في التّعبير عن رغباتهم

171
00:10:09,880 --> 00:10:12,990
.ومع ذلك، إنّه جذّاب فوق ذلك
هذا مزيج رهيب حقّاً

172
00:10:13,340 --> 00:10:15,490
،تتبنّينه لأنّه يبدو أليفاً

173
00:10:15,490 --> 00:10:18,020
لكن حالما ينضج، يلتهمكِ بالكامل

174
00:10:18,290 --> 00:10:21,730
إذاً اخترتُ الخيار الصّائب بالخروج معه

175
00:10:21,730 --> 00:10:25,260
ليس وكأنّني فعلتُ ذلك بداعي الحُبّ

176
00:10:25,620 --> 00:10:27,110
ما مقصدكِ؟

177
00:10:27,110 --> 00:10:29,220
فكّري في الأمس

178
00:10:29,220 --> 00:10:33,230
عندما أكون موجودة، شوما
،لا يغدو عنيفاً أبداً

179
00:10:33,230 --> 00:10:35,850
مهما كان غاضباً

180
00:10:36,500 --> 00:10:38,480
المُشكلة هي كيريشيما

181
00:10:41,290 --> 00:10:44,080
ماذا؟ أين هو على أيّ حال؟

182
00:10:56,600 --> 00:11:00,300
مرحباً. هل يمكنني الحصول على واحدة؟

183
00:11:20,480 --> 00:11:21,440
أعدها

184
00:11:23,690 --> 00:11:27,850
تطلب منك الصّمت، لكن تعطيك
قدّاحة كهديّة

185
00:11:27,850 --> 00:11:29,410
عجباً لكِ يا يوشينو

186
00:11:35,830 --> 00:11:37,700
مذاقه سيّئ للغاية

187
00:11:50,970 --> 00:11:53,680
سوف أخرج مع يوشينو الآن

188
00:11:55,270 --> 00:11:57,690
نحن نتواعد

189
00:11:57,690 --> 00:12:00,200
هل فقدت عقلك أخيراً؟

190
00:12:00,470 --> 00:12:04,520
أنا أستولي على عملك القديم رسميّاً

191
00:12:04,520 --> 00:12:06,700
لا يسعني سوى أن أتخيّل
كم أنّ هذا مُطمئن

192
00:12:06,700 --> 00:12:08,070
أيّ عمل؟

193
00:12:08,450 --> 00:12:13,010
لا بدّ أنّك لاحظت. هناك شخص
دوماً بالقرب من يوشينو

194
00:12:13,010 --> 00:12:17,570
،كان المُفضّل لدى الزّعيم سومي
هوتي تاكيتو

195
00:12:17,980 --> 00:12:20,930
حالما تمّ تكليفه بعمل آخر، دخلت أنت

196
00:12:21,630 --> 00:12:25,600
،ونظراً لعدم تواجدك في أوساكا
صار دوري الآن

197
00:12:25,600 --> 00:12:27,500
ما مقصدك؟

198
00:12:27,500 --> 00:12:32,160
هل سألتَ نفسك يوماً لماذا الزّعيم
سومي مستميت على حماية يوشينو؟

199
00:12:32,160 --> 00:12:32,840
لا

200
00:12:33,070 --> 00:12:35,730
قاموا بتربيتك على الولاء حقّاً، أليس كذلك؟

201
00:12:36,070 --> 00:12:40,600
لا ضير من التّشكيك قليلاً. قد تُدرك
بأنّهم يستغلّونك

202
00:12:42,310 --> 00:12:43,620
أحمق

203
00:12:44,130 --> 00:12:45,860
ما رأيك بذلك؟

204
00:12:46,320 --> 00:12:50,070
لا أنا ولا أفراد العائلة يتمّ استغلالنا

205
00:12:50,070 --> 00:12:52,630
نحن نفعل ذلك بمحض رغبتنا

206
00:12:52,630 --> 00:12:56,120
أنت الوحيد الّذي يعتقد ذلك أيّها الوغد

207
00:12:56,600 --> 00:13:00,270
لكن هذا فقط لأنّك قد تمّ تلقينك

208
00:13:00,270 --> 00:13:03,990
فكّر في عدم رغبتك حتّى بلكم
وغد مثلي أمام يوشينو

209
00:13:04,660 --> 00:13:07,310
ككلب مُدرَّب جيّداً

210
00:13:07,310 --> 00:13:10,130
لا يفعل شيئاً من دون إذن سيّده

211
00:13:10,130 --> 00:13:12,760
لا، هذا هو أنت

212
00:13:12,760 --> 00:13:14,910
،تثرثر مُعتقداً نفسك ذكيّاً

213
00:13:14,910 --> 00:13:18,140
لكن كلّ هذا يبدو كأزيز ذُبابة تحوم حول أُذني

214
00:13:18,530 --> 00:13:20,900
ومن ذا الّذي يُحاول ضرب ذُبابة؟

215
00:13:20,900 --> 00:13:24,150
نظراً إلى أنّها حشرة، فهذه
مضيعة للوقت والجهد

216
00:13:24,150 --> 00:13:26,280
لو كنتُ حشرة، لاستطعتَ قتلي في أيّ وقت

217
00:13:26,670 --> 00:13:29,650
ما رأيك أن تجرّب ذلك؟ هنا والآن

218
00:13:31,210 --> 00:13:34,650
اختارَتْني لي. ليس أنت

219
00:13:35,310 --> 00:13:37,070
هذا يعني بأنّني ربحت

220
00:13:43,930 --> 00:13:47,180
حديثك عن الفوز والخسارة يُثبت
كم أنت مُخطئ

221
00:13:47,180 --> 00:13:50,940
إنّها لا تنتمي لي أو لك أيّها الأحمق

222
00:13:51,300 --> 00:13:54,300
تعي بأنّ هذا كلامَ فاشل، صحيح؟

223
00:13:54,880 --> 00:13:56,260
ماذا تفعلين؟

224
00:14:00,650 --> 00:14:02,660
لذا طلبتُ من شوما إزالتها

225
00:14:02,660 --> 00:14:04,320
...إذا كانت لا تزال بحوزته

226
00:14:07,690 --> 00:14:11,810
بئساً! إنّها حديقة محلّية. يراودني
شعور سيّئ حيال هذا

227
00:14:12,210 --> 00:14:14,260
هل تُمانعين مُرافقتي؟

228
00:14:14,260 --> 00:14:15,330
لماذا؟

229
00:14:16,720 --> 00:14:17,990
للإغارة

230
00:14:38,940 --> 00:14:41,480
لنُنهِ هذا

231
00:14:43,310 --> 00:14:46,140
استعرتُ هذه من المطبخ

232
00:14:46,140 --> 00:14:49,070
ماذا الآن؟ يمكنك الهرب

233
00:14:49,070 --> 00:14:54,720
تسرق من منزل شخص وتتكلّم
بتبجّح مع ذلك؟ سافل

234
00:15:01,500 --> 00:15:07,020
عليك أن تُدرك بأنّه لا أحد في العالم
سيحبّ حقيراً مثلك

235
00:15:07,020 --> 00:15:11,510
لا أبالي ما دام لديّ ي وشينو

236
00:15:14,100 --> 00:15:15,680
...ما الّذي

237
00:15:17,350 --> 00:15:20,350
!تفعلانه بالضّبط؟...

238
00:15:22,030 --> 00:15:23,440
!مؤلم

239
00:15:23,440 --> 00:15:24,350
!يوشينو

240
00:15:26,450 --> 00:15:29,060
...أ-أنا... أموت

241
00:15:31,960 --> 00:15:34,830
هل أنتِ بخير يا يوشينو؟
دعيني أرى كاحلكِ

242
00:15:38,750 --> 00:15:41,960
ابحث عن الأزرار

243
00:15:41,960 --> 00:15:42,900
أزرار؟

244
00:15:42,900 --> 00:15:45,160
أزرار قميصك قد تفكّكت

245
00:15:45,160 --> 00:15:46,750
!ابحث عنها حالاً

246
00:15:48,250 --> 00:15:50,840
هذا ما أردتِه يا يوشينو-تشان؟

247
00:15:50,840 --> 00:15:51,990
شكراً

248
00:15:53,830 --> 00:15:57,840
وجدتِ الأزرار؟ جيّد. والآن اخلعا قميصكما

249
00:15:57,840 --> 00:16:00,350
قميصنا؟ لماذا؟

250
00:16:00,350 --> 00:16:04,100
ماذا تقصد بـ"لماذا"؟ مزّقت الأزرار اللّعينة

251
00:16:06,860 --> 00:16:10,370
جيّد. والآن تبادلا القميصين وأعيدا
حياكة الأزرار وتثبيتها

252
00:16:12,220 --> 00:16:14,650
هل فعلت هذا قبلاً؟

253
00:16:14,650 --> 00:16:15,860
أجل

254
00:16:16,130 --> 00:16:19,720
...لأنّ شوما كان دائماً ما يدخل في عِراك

255
00:16:19,720 --> 00:16:23,240
إذا تضرّر أيّ لِباس، كنتُ أطلب منه الذّهاب
،إلى منزل الشّخص الآخر

256
00:16:23,240 --> 00:16:25,310
وجعلهما يُصلحان قميص بعضهما الآخر

257
00:16:25,310 --> 00:16:27,740
جعلَه ذلك يتوقّف عن القتال
وذلك كي لا يضطرّ لفعلها

258
00:16:27,740 --> 00:16:30,340
...يبدو هذا شاقّاً

259
00:16:30,900 --> 00:16:33,080
...لذا ابدآ بالحياكة. حالاً

260
00:16:34,130 --> 00:16:38,340
!أتتجاهلانني؟ يا لجرأتكما

261
00:16:38,650 --> 00:16:40,970
غالباً أنت من بدأ هذا الشّجار، أليس كذلك؟

262
00:16:40,970 --> 00:16:44,340
هل فعل شوما لك شيئاً؟ لم يفعل، صحيح؟

263
00:16:47,570 --> 00:16:50,570
حسناً إذاً يا شوما، انقر على جبيني

264
00:16:51,190 --> 00:16:54,060
افعلها فحسب. بأقسى ما عندك

265
00:16:55,500 --> 00:16:58,330
!يا رجُل، ليس إلى هذه الدّرجة

266
00:16:58,330 --> 00:17:00,610
أنتِ من طلب منّي فعل ذلك يا يوشينو-سان

267
00:17:02,140 --> 00:17:05,980
،كيريشيما، كلّما تجاهلتَ سؤالاً

268
00:17:05,980 --> 00:17:08,120
سأدع شوم يضربني هكذا

269
00:17:08,120 --> 00:17:09,140
مفهوم؟

270
00:17:11,180 --> 00:17:12,760
هذا ما أتحدّث عنه

271
00:17:12,760 --> 00:17:13,630
ما هو؟

272
00:17:13,900 --> 00:17:16,900
ما كنتُ لأضربكِ يا يوشينو

273
00:17:16,900 --> 00:17:19,100
أنا من طلب منه فعل ذلك

274
00:17:19,100 --> 00:17:20,880
ومع ذلك ما كنتُ لأفعل

275
00:17:20,880 --> 00:17:22,380
لستُ أفهمه حقّاً

276
00:17:22,380 --> 00:17:26,030
كيف يجرؤ على القول بأنّ زيّكِ
قبل يومين كان "أيّاً يكُن"؟

277
00:17:26,870 --> 00:17:28,680
!انظرا إلى هذا اللّباس

278
00:17:28,680 --> 00:17:30,830
!الكنزة مع الفستان معاً بسعر 3000 ين فقط

279
00:17:30,830 --> 00:17:32,980
يا له من اكتشاف، صحيح؟ أليس ظريفاً؟

280
00:17:32,980 --> 00:17:34,570
أجل، إنّه ظريف

281
00:17:33,890 --> 00:17:35,030
أيّاً يكن

282
00:17:35,560 --> 00:17:38,890
!بالطّبع ليس "أيّاً يكن". من الواضح بأنّه ظريف

283
00:17:38,890 --> 00:17:40,570
هل جُننت أم ماذا؟

284
00:17:40,570 --> 00:17:42,430
لا داعي لتقول ذلك عن الآخرين

285
00:17:42,430 --> 00:17:44,130
!أتعلمان؟ انسيا الأمر

286
00:17:44,430 --> 00:17:47,200
مقصدي هو أنّك أنت من بدأ هذا، صحيح؟

287
00:17:47,200 --> 00:17:48,390
هذا ما أعتقده

288
00:17:48,390 --> 00:17:49,880
ماذا قلتَ لشوما؟

289
00:17:49,880 --> 00:17:53,370
أردتُه أن يعلم بأنّنا نخرج الآن

290
00:17:53,370 --> 00:17:56,060
اعتقدتُ بأنّ هذا سيجعل الأمور واضحة

291
00:17:56,060 --> 00:17:58,130
أنا من اخترتِه

292
00:17:58,370 --> 00:18:02,390
لا تُدرجني بنفس مستوى قمامة مثلك

293
00:18:02,390 --> 00:18:04,180
هذا يكفي! اصمتا

294
00:18:06,050 --> 00:18:11,140
كيريشيما، هل تعلم سبب مُوافقتي
على الخروج معك؟

295
00:18:11,140 --> 00:18:12,710
لأنّني ربحتُ رهاننا

296
00:18:12,710 --> 00:18:15,060
كانت تلك الوسيلة فقط

297
00:18:15,060 --> 00:18:19,770
،كان لأنّني اكتشفتُ أنّه عاجلاً أم آجلاً
سوف ينتهي المطاف بخروجنا معاً

298
00:18:19,770 --> 00:18:20,920
ماذا تقصدين؟

299
00:18:20,920 --> 00:18:23,970
لا تنفكّ تُزعج شوما

300
00:18:23,970 --> 00:18:29,680
،لا أعلم ما إن كانت الغيرة أو ما شابه
،لكن من الواضح أنّ شوما يعرفني لفترة أطول

301
00:18:29,680 --> 00:18:34,070
وعشنا معاً، ولا يسع أيّ شخص
فعل شيء حيال ذلك

302
00:18:35,050 --> 00:18:40,670
"لذا ارتأيتُ بأنّ منحك تسمية "حبيب
،ستنفع في مُعالجة الأمور

303
00:18:40,670 --> 00:18:43,920
لكنّني أراك تفتعل شِجاراً هنا بالرُّغم من ذلك

304
00:18:43,920 --> 00:18:48,070
أنت حبيبي بسبب شوما

305
00:18:48,070 --> 00:18:49,930
فلتفهم ذلك جيّداً

306
00:18:51,360 --> 00:18:53,600
ماذا؟ هل لديك اعتراض؟

307
00:18:53,600 --> 00:18:54,760
بالطّبع لا

308
00:18:54,760 --> 00:18:55,970
أيّاً يكن

309
00:18:58,660 --> 00:19:02,550
تسوباكي، آسفة، لكن هلّا عدتُما
أنتِ وكيريشيما أوّلاً؟

310
00:19:02,550 --> 00:19:04,570
أريد أن أتكلّم مع شوما قليلاً

311
00:19:04,800 --> 00:19:05,820
...يوشينو

312
00:19:05,820 --> 00:19:10,070
اصمت واذهب. سنتكلّم عن هذا
عندما نعود إلى طوكيو

313
00:19:12,850 --> 00:19:16,250
يوشينو-تشان تفهم أكثر ممّا تعتقد

314
00:19:16,530 --> 00:19:21,620
كنتَ تحاول إيجاد طريقة للتّغطية
على ضرب رينجي-سان لك، صحيح؟

315
00:19:21,620 --> 00:19:25,770
،أتفهّم سبب رغبتك في فعل شيء حيال ذلك

316
00:19:25,770 --> 00:19:27,520
نظراً إلى أنّه جدّها

317
00:19:27,520 --> 00:19:29,390
هل كنتُ مكشوفاً؟

318
00:19:29,390 --> 00:19:34,070
لا. لكن ليس عليك القيام بذلك لأجل يوشينو-تشان

319
00:19:34,070 --> 00:19:36,530
على العكس، أنت كتوم زيادة عن اللّزوم

320
00:19:36,830 --> 00:19:39,110
ماذا تقصدين؟

321
00:19:39,110 --> 00:19:42,140
،تريدها أن تهتمّ بك

322
00:19:42,140 --> 00:19:45,290
ومع ذلك تُخفي الكثير عنها

323
00:19:45,650 --> 00:19:48,800
لكن لن يفلح هذا. أنت تتأمّل كثيراً

324
00:19:48,800 --> 00:19:51,370
أنا لا أحاول إخفاء شيء عنها

325
00:19:51,370 --> 00:19:55,110
لم تُدرك ذلك حتّى؟ هذه مُصيبة أكبر حتّى

326
00:19:55,930 --> 00:19:59,790
حسناً، في هذه الحالة، حاول
استدعاءها إلى غرفتك

327
00:20:00,100 --> 00:20:01,080
غرفتي؟

328
00:20:01,800 --> 00:20:03,730
،أكيد. بعد المدرسة يوماً ما

329
00:20:03,730 --> 00:20:07,880
دع حبيبتك تزور غرفتك وادرسا
...للامتحانات معاً

330
00:20:07,880 --> 00:20:10,000
وراجعا الكُتُب السّنويّة أيضاً

331
00:20:10,000 --> 00:20:12,560
ما رأيك بذلك؟ مُواعدة مدرسة
ثانويّة نموذجيّة، صحيح؟

332
00:20:13,500 --> 00:20:15,830
!حياة حُبّ الآخرين مُمتعة للغاية

333
00:20:16,750 --> 00:20:19,440
...حتّى قميصك الدّاخليّ مُمزَّق

334
00:20:20,950 --> 00:20:24,870
لِمَ أنت غاضب؟ ليس وكأنّني سأتزوّجه

335
00:20:24,870 --> 00:20:28,610
سئمتُ من كلّ هذه السّخافات

336
00:20:29,210 --> 00:20:31,360
طريقتكِ بأكملها معتوهة

337
00:20:31,360 --> 00:20:33,460
أنتِ تمنحينه سبباً ليغترّ بنفسه فحسب

338
00:20:33,460 --> 00:20:34,960
...أ-أحمق

339
00:20:36,230 --> 00:20:37,950
كدتُ أقتله

340
00:20:40,580 --> 00:20:42,760
!ثمّ اتّخذتُ القرار الصّحيح بإيقافك

341
00:20:44,230 --> 00:20:47,120
كانت لديك حبيبة، صحيح؟

342
00:20:47,800 --> 00:20:49,780
يراودني فضول فحسب

343
00:20:49,780 --> 00:20:53,020
أعتقد انفصلنا منذ مدّة قصيرة

344
00:20:53,020 --> 00:20:54,190
ماذا؟ من جديد؟

345
00:20:54,190 --> 00:20:56,240
وهل لهذا أهمّية؟

346
00:20:56,800 --> 00:21:00,720
أفكّر فحسب، مُواعدة شخص... كيف تكون بالضّبط؟

347
00:21:00,720 --> 00:21:03,220
هذا ما أقصده بشأن السّخافة

348
00:21:03,220 --> 00:21:07,780
إذاً، إن أحببتُ كيريشيما، سيختلف الأمر؟

349
00:21:09,550 --> 00:21:11,000
مهلاً، اهدأ

350
00:21:11,480 --> 00:21:15,740
فكّر في الأمر. أيّ شخص هذا
يستطيع إرضاء جماعتنا؟

351
00:21:15,740 --> 00:21:19,000
مَن يُفترَض بي أن أتزوّج بالضّبط؟

352
00:21:19,610 --> 00:21:21,770
شخص يستطيع قتلي

353
00:21:23,520 --> 00:21:26,900
ماذا؟ هل تحبّني أو ما شابه؟

354
00:21:27,350 --> 00:21:30,730
...أقصد أنّك تظلّ تطلب طلبات مستحيلة

355
00:21:30,730 --> 00:21:31,850
مُقرف

356
00:21:31,850 --> 00:21:34,010
!اصمت! كنتُ أمزح

357
00:21:34,730 --> 00:21:36,590
خُذ، أصلحتُه

358
00:21:37,830 --> 00:21:39,020
...لكن لا بدّ أن أقرّ

359
00:21:39,420 --> 00:21:43,780
الحياة معك ليست سيّئة

360
00:21:43,780 --> 00:21:48,740
،احصل على عملٍ بأجر جيّد
،وإذا ادّخرنا معاً

361
00:21:48,740 --> 00:21:50,790
فسنكون بخير عندما نشيخ غالباً

362
00:21:51,740 --> 00:21:53,600
فكرة سديدة بالنّسبة لي

363
00:21:54,500 --> 00:21:58,550
ستكون الحياة معكِ مُمتعة جدّاً غالباً

364
00:22:00,390 --> 00:22:01,570
ماذا؟

365
00:22:01,570 --> 00:22:04,430
إن كنّا سنفعل عليك، فيجب
عليك أن تُقلع عن التّدخين

366
00:22:05,290 --> 00:22:06,940
!هيّا، أجبني