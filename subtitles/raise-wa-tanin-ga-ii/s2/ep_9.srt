1
00:00:04,240 --> 00:00:07,140
!ما هذا بالضّبط؟

2
00:00:07,140 --> 00:00:10,650
!ذلك الحقير. لماذا أرسلنا إلى هنا؟

3
00:00:10,650 --> 00:00:14,270
أُطلِقَتْ مُفرقعات على ما يبدو قبل لحظات

4
00:00:14,900 --> 00:00:18,160
بالإضافة إلى ذلك، هذه الحديقة
موجودة بجانب محطّة قطار

5
00:00:18,640 --> 00:00:22,280
لننفصل إلى مجموعتين! ابحثوا
!أنتم في الطّرف الآخر

6
00:00:25,380 --> 00:00:27,000
لا بدّ أنّ هذا هو المكان

7
00:00:27,000 --> 00:00:29,030
من فضلكم ادخلوا ضمن طابور مستقيم

8
00:00:29,590 --> 00:00:31,800
!اللّعنة! هناك الكثير من النّاس

9
00:00:32,290 --> 00:00:35,800
سيكون هناك ازدحام حيث النّاس عائدون
إلى المنزل بعد حضور عرض ألعاب ناريّة

10
00:00:35,800 --> 00:00:37,420
وهو أمر ممتاز لكسب الوقت

11
00:00:37,780 --> 00:00:41,680
سيترتّب عليهم التفرُّق للبحث عنّي

12
00:00:42,620 --> 00:00:44,760
!هل كنت تسمعني أصلاً؟

13
00:00:44,760 --> 00:00:47,150
قلتُ لك أنّه يجب عليك القيام
!بهذا من دون أن يُقبَض عليك

14
00:00:47,150 --> 00:00:48,680
وهذا ما سأفعله

15
00:00:48,680 --> 00:00:53,340
غالباً سيظهرون في غضون عشر دقائق

16
00:00:53,760 --> 00:00:54,940
—ثمّ

17
00:01:04,560 --> 00:01:08,820
هناك كثير من النّاس. هل سيفلح هذا حقّاً؟

18
00:01:09,590 --> 00:01:15,500
،يمكنكِ المجيء إذا أردتِ، لكن أتوسّل إليكِ
حاولي أن تبقي مختبئة

19
00:01:16,030 --> 00:01:18,470
أعرف ذلك جيّداً دون أن يخبرني

20
00:01:21,740 --> 00:01:23,220
!ابتعد

21
00:01:23,560 --> 00:01:25,240
...ها هو ذا

22
00:01:28,520 --> 00:01:31,480
!تبّاً، كانت هذه التنّورة غالية

23
00:01:32,000 --> 00:01:33,210
!اللّعنة

24
00:03:06,650 --> 00:03:08,450
!أنت، ابتعد عن طريقي

25
00:03:08,450 --> 00:03:10,340
!تبّاً، هذا مزعج

26
00:03:10,720 --> 00:03:13,960
إذا ظللنا نتحرّك بهذا الشّكل، فسوف
نلتقي بالمجموعة الأخرى فحسب

27
00:03:13,960 --> 00:03:18,480
أنتم! احرصوا على تفقّد كافّة
!الطّرُق الجانبيّة أيضاً

28
00:03:18,480 --> 00:03:19,620
!حـ-حسناً

29
00:03:20,170 --> 00:03:23,900
كيف يُفترض بنا أن نجد شخصاً بالكاد نعرفه؟

30
00:03:24,380 --> 00:03:27,470
كُفّ عن الشّكوى وإلّا قتلوك أيضاً

31
00:03:27,470 --> 00:03:30,770
!أتحدّاهم أن يفعلوا

32
00:03:32,910 --> 00:03:33,870
!من هناك؟

33
00:03:34,900 --> 00:03:36,090
...أنت

34
00:03:43,490 --> 00:03:45,920
أريد فقط سماع إجابات على أسئلتي

35
00:03:46,550 --> 00:03:51,060
أي كلمة أخرى وسأحرص على أن أدعك
عاجزاً عن الأكل ثانية

36
00:03:51,060 --> 00:03:52,010
مفهوم؟

37
00:03:53,270 --> 00:03:56,500
كم بقي غيركما؟

38
00:03:58,930 --> 00:04:00,020
!أنت

39
00:04:00,020 --> 00:04:01,760
!ماذا تعتقدون أنّكم تفعلون بالضّبط؟

40
00:04:02,140 --> 00:04:05,270
اصمت وانقلع، وإلّا قتلتُك

41
00:04:05,270 --> 00:04:09,020
!هـ-هل أنت غبيّ أم ماذا؟

42
00:04:12,980 --> 00:04:16,520
!لهذا أكره العمل مع أغبياء أمثالك

43
00:04:21,880 --> 00:04:23,960
أنتم، اسبقوني

44
00:04:23,960 --> 00:04:26,520
سوف أتولّى أمره أوّلاً

45
00:04:26,520 --> 00:04:29,530
!دعني! اللّعنة... أيّها الوغد

46
00:04:31,030 --> 00:04:34,240
!هل تعلم ما الّذي سيحدث إذا آذيتني؟

47
00:04:34,240 --> 00:04:36,420
!أزامي-سان لن يغفر لك

48
00:04:36,420 --> 00:04:42,050
أزامي؟ هذا الرّجل هو مجرّد ياكوزا عديم الجدوى

49
00:04:43,170 --> 00:04:45,790
هل تُصدّق ذلك حقّاً؟

50
00:04:50,700 --> 00:04:53,460
عمّاذا تثرثر الآن؟

51
00:04:54,310 --> 00:04:57,560
لو كان ياكوزا نمطيّاً، ما كان ليعتني
بكم أنتم السّفهاء

52
00:04:57,560 --> 00:04:59,810
مهما دررتُم من مال

53
00:05:00,660 --> 00:05:07,330
قبل عام، أتى بعض من جماعة كاتابامي-كاي
لابتزاز عملي

54
00:05:07,330 --> 00:05:11,050
ولحلّ مشاكل الياكوزا تحتاج ياكوزا

55
00:05:11,050 --> 00:05:13,340
المُشكلة هي أنّ هذا مُكلف للغاية

56
00:05:13,830 --> 00:05:18,920
ما إن قلقتُ بشأن توبيخ أبي لي
،بشأن خِلافي مع الياكوزا

57
00:05:18,920 --> 00:05:21,080
تواصل معي

58
00:05:21,690 --> 00:05:23,000
مَن؟

59
00:05:23,710 --> 00:05:26,950
،لم أقُل لأحد ما الّذي كان يجري وقتها
لكنّه كان يعلم

60
00:05:27,450 --> 00:05:31,020
تقرّب منّي وبدا كتلميذ عاديّ

61
00:05:33,400 --> 00:05:34,940
هل أنت أوزو كينتو؟

62
00:05:38,070 --> 00:05:39,650
أتريدني أن أتولّى الأمر؟

63
00:05:41,160 --> 00:05:43,360
...لا أملك فكرة كيف سمع بذلك

64
00:05:43,730 --> 00:05:47,840
الأمر الّذي أخافني، لذا طلبتُ
منه المضيّ قُدماً إذا كان يستطيع

65
00:05:47,840 --> 00:05:50,610
...وفي أقلّ من أسبوع

66
00:05:51,420 --> 00:05:53,020
...ليس فقط الأشخاص الّذين استهدفوني

67
00:05:53,020 --> 00:05:56,460
بل بقيّة الأفراد وحتّى زعيمهم قد فُقِدوا

68
00:05:57,190 --> 00:06:00,230
لم يتمّ تأكيد موتهم. اختفوا فحسب

69
00:06:02,590 --> 00:06:05,630
لم أعد أعلم ما إن كانوا أحياء أو أموات

70
00:06:05,630 --> 00:06:07,610
عمّن يتكلّم؟

71
00:06:10,810 --> 00:06:14,900
!اللّعنة، ما الّذي يفعله كيريشيما؟

72
00:06:14,900 --> 00:06:18,420
عقب ذلك، مضى عام من دون
سماع كلمة عنه

73
00:06:18,890 --> 00:06:23,200
.لا عروض لتقديم أي معروف آخر
ولم يتواصل معي بشأن أيّ مال

74
00:06:23,200 --> 00:06:26,570
،فعلتُ ما بوسعي لأكتشف هويّته
لكن لم أتوصّل إلى شيء

75
00:06:26,570 --> 00:06:31,910
.ثمّ بعد كلّ هذا الوقت، ظهر من جديد
ويقول بأنّه يريد معروفاً

76
00:06:33,400 --> 00:06:36,140
أمثاله مُخيفون حقّاً

77
00:06:36,540 --> 00:06:41,080
الأشخاص الّذين يطمعون بالمال
والفتيات أكثر موثوقيّة بكثير

78
00:06:41,080 --> 00:06:43,430
إنّه مختلف عن ذلك تماماً

79
00:06:43,700 --> 00:06:48,190
إنّه لا يُسدّد فاتورتكم من طيبة قلبه

80
00:06:48,190 --> 00:06:51,420
!إنّه يستغلّكم كبيادق فحسب

81
00:06:57,170 --> 00:06:59,430
وما أهمّية ذلك أيّها الغبيّ؟

82
00:07:01,960 --> 00:07:05,440
أنت. انقلع من هنا حالاً

83
00:07:10,450 --> 00:07:12,400
!أين أنتما بالضّبط أيّها الوغدان؟

84
00:07:13,230 --> 00:07:15,550
في الواقع... وجدناه

85
00:07:16,110 --> 00:07:18,010
مياما كيريشيما

86
00:07:19,020 --> 00:07:24,550
إنّه في دورة المياه العامّة الكائنة
في جهة مدخل المحطّة

87
00:07:24,550 --> 00:07:26,090
أين الشّخص الّذي كان معك؟

88
00:07:26,780 --> 00:07:30,510
كريشيما نال منه...

89
00:07:30,510 --> 00:07:32,580
أنا مختبئ حاليّاً

90
00:07:33,470 --> 00:07:35,600
لست وحدك، صحيح؟

91
00:07:38,650 --> 00:07:40,640
أعتقد بأنّك لست بذلك الغباء

92
00:07:40,640 --> 00:07:41,610
!أيّها الحقير

93
00:07:41,610 --> 00:07:43,710
لكنّه لا يكذب

94
00:07:52,140 --> 00:07:54,110
!ماذا تعتقد نفسك أنّك تفعل؟

95
00:07:54,110 --> 00:07:57,610
من المُجهِد جدّاً اصطيادكم كلّ واحد على حِدة

96
00:07:57,610 --> 00:08:00,660
وهناك طريق واحد فقط عبر هذه الحديقة

97
00:08:00,660 --> 00:08:02,630
لذا سأنتظر هنا

98
00:08:02,980 --> 00:08:05,780
أعتقد هما أوزو كينتو وناويا-سان، صحيح؟

99
00:08:05,780 --> 00:08:09,090
هل تُمانع إرسالهما إليّ؟

100
00:08:09,460 --> 00:08:12,900
أعتقد بأنّهما المسؤولان بشكل ما

101
00:08:14,400 --> 00:08:16,300
إذ أنّ هذا مُرهِق

102
00:08:16,300 --> 00:08:20,070
تطهير مجموعة من الحثالة تجمّعتْ فجأة

103
00:08:20,070 --> 00:08:25,130
ألا تُدركون حقّاً بأنّ مُحاربتي هي فكرة سيّئة؟

104
00:08:26,620 --> 00:08:29,940
كنتم تجنون بعض الأموال المشبوهة
،مع أكازا شيوري

105
00:08:29,940 --> 00:08:32,830
ثمّ أُجبِرتْ على السّفر إلى خارج البلاد

106
00:08:32,830 --> 00:08:38,150
.ومع ذلك بقيتم في اليابان
ألم تتساءلوا عن السّبب؟

107
00:08:38,150 --> 00:08:40,800
لأنّني سمحتُ لكم

108
00:08:40,800 --> 00:08:44,920
يُفترض بكم أن تشكروني بدلاً من انتقام تافه

109
00:08:45,530 --> 00:08:48,230
!من تعتقد نفسك بالضّبط أيّها اللّعين؟

110
00:08:48,230 --> 00:08:52,170
لا تملك أدنى فكرة عمّا يجري، أليس كذلك؟

111
00:08:53,320 --> 00:08:56,170
لا، أنت الّذي لا يملك فكرة

112
00:08:56,170 --> 00:08:58,950
والآن كفى ثرثرة وتعالوا إلى هنا

113
00:08:58,950 --> 00:09:01,680
لا أملك مزيداً من الوقت أهدره
على حثالة أمثالكم

114
00:09:05,320 --> 00:09:07,290
هل تواصلت مع ناويا؟

115
00:09:07,290 --> 00:09:09,860
لا. وليس أوزو أيضاً

116
00:09:09,860 --> 00:09:12,940
ماذا نفعل؟ لعلّ شيئاً قد حدث لهما

117
00:09:12,940 --> 00:09:14,820
لا يهمّ

118
00:09:14,820 --> 00:09:16,930
الوغد بمفرده

119
00:09:17,390 --> 00:09:20,300
!اتّصلوا بكلّ شخص خرج للبحث

120
00:09:20,300 --> 00:09:22,960
وحالما نقبض عليه، سأقتله بنفسي

121
00:09:24,040 --> 00:09:27,090
—ما-ما الّذي سوف تفعـ

122
00:09:33,120 --> 00:09:35,200
!أنت! أعلم بأنّك سمعتني

123
00:09:35,200 --> 00:09:37,630
!كفى اختباء

124
00:09:38,720 --> 00:09:40,730
!يعلم بأنّني هنا

125
00:09:41,080 --> 00:09:45,970
تريد قتلي أيضاً، أليس كذلك
!يا مياما كيريشيما؟

126
00:09:46,470 --> 00:09:50,560
!ولا يدرك حتّى بأنّ هذه أنا

127
00:09:51,060 --> 00:09:52,470
هل أنا بعيدة جدّاً؟

128
00:09:53,120 --> 00:09:55,720
!اخرج إلى هنا حالاً

129
00:10:03,310 --> 00:10:05,510
لم أرك منذ وقت

130
00:10:07,440 --> 00:10:11,630
كنتُ أتساءل ما الّذي كنتم
...تفعلونه هنا في أوساكا

131
00:10:12,090 --> 00:10:14,260
لكن كيريشيما ليس هنا

132
00:10:14,750 --> 00:10:17,380
أيّتها السّاقطة اللّعينة

133
00:10:17,380 --> 00:10:19,300
لديّ شأن معك أيضاً

134
00:10:19,300 --> 00:10:21,430
،لا أبالي لمدى أهمّية جدّك

135
00:10:21,430 --> 00:10:23,260
!عبثتِ مع الشّخص الخطأ

136
00:10:24,370 --> 00:10:26,500
لن أجعل الأمر يسيراً أيضاً

137
00:10:26,500 --> 00:10:28,890
،بعد سحق مياما كيريشيما

138
00:10:28,890 --> 00:10:32,260
سوف نتناوب عليكِ قبل قتلكِ أمامه

139
00:10:33,180 --> 00:10:36,770
ماذا؟ أنت فعلاً لا تملك فكرة

140
00:10:37,550 --> 00:10:40,780
سوف يُسعده ذلك

141
00:10:41,710 --> 00:10:43,270
هذا الرّجل ساديّ بامتياز

142
00:10:54,190 --> 00:10:58,930
بصراحة، حقيقة أنّني استطعتُ حتّى
إيجادك تعني بأنّك اقترفتَ خطأ فادحاً

143
00:10:59,310 --> 00:11:02,930
طاقمك بأكمله لا يملك فكرة عمّا يفعله

144
00:11:02,930 --> 00:11:07,810
أم أنّكم أتيتم إلى أوساكا لتُجرّبوا مستشفياتنا؟

145
00:11:07,810 --> 00:11:09,940
لأنّه يبدو أنّكم لا تتعلّمون فحسب

146
00:11:11,450 --> 00:11:13,200
!ساقطة

147
00:11:13,470 --> 00:11:16,070
!من تعتقدين نفسكِ؟

148
00:11:20,690 --> 00:11:21,820
ماذا حدث؟

149
00:11:21,820 --> 00:11:22,850
هل انقطع التيّار الكهربائيّ؟

150
00:11:43,790 --> 00:11:45,230
موتي

151
00:11:49,830 --> 00:11:51,090
موتي

152
00:11:52,670 --> 00:11:54,110
كيريشيما؟

153
00:11:57,730 --> 00:11:59,740
!عودي إلى هنا

154
00:11:59,740 --> 00:12:01,450
ما الّذي يجري؟

155
00:12:01,450 --> 00:12:03,440
كم هذا مُزعج

156
00:12:04,730 --> 00:12:06,600
اللّعنة، انقطع التيّار الكهربائيّ

157
00:12:07,440 --> 00:12:08,580
مهلاً لحظة

158
00:12:10,860 --> 00:12:12,720
ما الّذي يجري بالضّبط؟

159
00:12:12,720 --> 00:12:15,170
!أقول لكم لا تتحرّكوا

160
00:12:15,170 --> 00:12:17,730
مياما كيريشيما يخطّط لشيء

161
00:12:17,730 --> 00:12:19,540
!تفقّدوا وتحقّقوا من وجودكم جميعاً

162
00:12:24,410 --> 00:12:26,010
ماذا كان ذلك للتو؟

163
00:12:32,420 --> 00:12:33,470
!اللّعنة

164
00:12:39,470 --> 00:12:40,910
!أنتم! أنتم

165
00:12:41,260 --> 00:12:43,850
!تبّاً! جميعكم، حاصروه

166
00:12:43,850 --> 00:12:45,550
ما الّذي يجري؟

167
00:12:45,550 --> 00:12:47,810
!الجميع في المُقدّمة قد سقطوا

168
00:12:49,310 --> 00:12:50,380
!إنّه قادم

169
00:12:51,830 --> 00:12:55,240
!تبّاً! لا أستطيع رؤية شيء

170
00:13:02,230 --> 00:13:04,100
هل سقط أحدٌ للتو؟

171
00:13:04,100 --> 00:13:06,020
كُفّ عن دفعي

172
00:13:14,600 --> 00:13:15,720
!أين هو بالضّبط؟

173
00:13:18,790 --> 00:13:20,360
!أيّها الحقير

174
00:13:22,450 --> 00:13:24,760
...أيّها السّافل! أنت

175
00:13:36,650 --> 00:13:38,160
...أ-أنت

176
00:13:38,830 --> 00:13:42,500
!أيّها... القمامة

177
00:13:53,480 --> 00:13:57,810
أعتقد بأنّه كان آخرهم. أشكرك
على تولي أمره

178
00:14:04,990 --> 00:14:06,860
...مؤلم

179
00:14:06,860 --> 00:14:08,900
!سقط سنّي

180
00:14:09,430 --> 00:14:12,830
ذلك اللّعين... حريّ به أن يُعيده

181
00:14:14,620 --> 00:14:16,070
!أفسح الطّريق

182
00:14:16,560 --> 00:14:18,580
تبّاً

183
00:14:19,430 --> 00:14:21,610
ماذا فعل؟ هل أذهب إلى كشك الشّرطة؟

184
00:14:21,610 --> 00:14:24,580
.لا، ليس بعد أن تشاجرتُ معه
هذا سخيف جدّاً

185
00:14:25,160 --> 00:14:29,840
ما الّذي يوجد هنا على أيّ حال؟
هل من شيء يمكنني استخدامه؟

186
00:14:37,120 --> 00:14:39,110
سُرِرتُ بلقائك

187
00:14:39,110 --> 00:14:44,120
لا بدّ أنّك الشّخص الّذي يقف وراء حملة
المُضايقة هذه الّتي كنتُ أتعامل معها

188
00:14:44,700 --> 00:14:48,610
من المُزعج بعض الشّيء وجود شخص يُلاحقني
طول الطّريق إلى أوساكا

189
00:14:50,020 --> 00:14:54,120
أشعر بتأنيب الضّمير بقول هذا، نظراً
،إلى المُعاناة الّتي تكبّدتَها

190
00:14:54,120 --> 00:14:58,720
لكن كنتُ بصراحة مشغولاً لدرجة
لم أعرف ما الّذي تريده منّي

191
00:14:58,720 --> 00:15:00,120
هل يمكنك إطلاعي؟

192
00:15:05,370 --> 00:15:07,370
أين سومي يوشينو؟

193
00:15:11,130 --> 00:15:14,370
تكبّدتَ كلّ هذا العناء فتقول لي
بأنّ هدفك هو فتاة؟

194
00:15:18,390 --> 00:15:21,440
سمعتُ بأنّها كانت معك دوماً

195
00:15:21,970 --> 00:15:23,890
لكن لا أرى ذلك

196
00:15:24,660 --> 00:15:26,410
سأتركك إذاً

197
00:15:34,820 --> 00:15:37,650
يمكنك إيجاد فتيات مثلها في أيّ مكان

198
00:15:37,650 --> 00:15:40,530
إنّها لا تستحقّ هذا العناء، بغضّ
النّظر عن وجهها وجسدها

199
00:15:41,140 --> 00:15:43,660
ما رأيك أن أعرّفك على شخص آخر؟

200
00:15:45,020 --> 00:15:47,780
لديّ شأنٌ مع سومي يوشينو

201
00:15:47,780 --> 00:15:49,970
حسناً، هذه مُشكلة

202
00:15:49,970 --> 00:15:51,550
...لا أعلم ما إن كانت

203
00:15:52,670 --> 00:15:56,550
من الفتيات اللّواتي يمكن إيجادها
في أيّ مكان كما قلتَ للتو

204
00:16:26,310 --> 00:16:29,710
!من الواضح أنّه لا يُشبهها أحد

205
00:16:52,020 --> 00:16:53,490
...أنت

206
00:16:54,140 --> 00:16:56,020
!سو أزامي؟

207
00:16:59,260 --> 00:17:01,800
إلى أيّ درجة تورّطت في هذا؟

208
00:17:02,750 --> 00:17:04,750
—بل الأهمّ

209
00:17:05,180 --> 00:17:07,010
متى حصلت على هذا الوجه؟

210
00:17:22,230 --> 00:17:23,880
!أخيراً، بعض الضّوء

211
00:17:23,880 --> 00:17:25,650
هل هناك أشخاص ملقيّون على الأرض؟

212
00:17:25,650 --> 00:17:26,740
هل اندلعت معركة؟

213
00:17:27,790 --> 00:17:29,410
ماذا الآن؟

214
00:17:29,750 --> 00:17:33,260
أصدقاؤك مُبعثرون في أرجاء الحديقة

215
00:17:33,260 --> 00:17:37,480
يجدر بك أن تجمعهم وتغادر قبل
وصول الشّرطة

216
00:17:38,370 --> 00:17:42,890
أم أنّك تُفضّل الاستمرار حتّى يموت أحدنا

217
00:17:47,650 --> 00:17:48,910
مللتُ الآن

218
00:17:49,880 --> 00:17:52,540
أنت عديم الجدوى

219
00:17:54,190 --> 00:17:56,930
لم يكن هناك جدوى من مجيئي
إذا لم أستطع رؤيتها

220
00:17:57,970 --> 00:18:00,080
بلّغ سلامي لسومي يوشينو

221
00:18:00,080 --> 00:18:01,190
هل أنت متأكّد من هذا؟

222
00:18:01,460 --> 00:18:04,200
ألن يكون من الأفضل بالنّسبة لك أن أموت؟

223
00:18:07,610 --> 00:18:09,640
تعتقد بأنّك ذو شأن عظيم، أليس كذلك؟

224
00:18:09,640 --> 00:18:13,550
هؤلاء الأوغاد عديمو القيمة هم
الوحيدون الّذين يأبهون لأمرك

225
00:18:14,470 --> 00:18:17,430
لا أملك وقتاً لأهدره عليك. ليس الآن

226
00:18:24,700 --> 00:18:26,050
!ابتعدوا

227
00:18:26,050 --> 00:18:27,700
!أفسحوا الطّريق، اللّعنة

228
00:18:29,740 --> 00:18:31,170
!حسناً، كلّ شيء جاهز

229
00:18:34,240 --> 00:18:35,450
!ابتعدوا

230
00:18:44,480 --> 00:18:45,750
!تبّاً

231
00:18:53,280 --> 00:18:57,480
أنتِ! تتبجّحين كلّ هذا التبجّح
!والآن تختبئين؟

232
00:19:05,480 --> 00:19:09,040
حسناً يا ساقطة. سأمنحكِ فُرصة

233
00:19:09,670 --> 00:19:11,750
...أحضري مياما كيريشيما إلى هنا

234
00:19:12,360 --> 00:19:14,750
وسأدعكِ تفلتين

235
00:19:15,040 --> 00:19:17,780
—فهمتِ؟ هذه آخر

236
00:19:17,780 --> 00:19:18,820
!على يمينك

237
00:19:20,020 --> 00:19:22,270
!هيّا، هنا، هنا، هنا

238
00:19:22,270 --> 00:19:25,640
!انظر إليّ! هنا

239
00:19:32,650 --> 00:19:35,150
...تبّاً، ظهري

240
00:19:37,910 --> 00:19:40,980
...أيّتها... السّاقطة

241
00:19:40,980 --> 00:19:42,400
!آسفة

242
00:19:42,770 --> 00:19:45,290
يبدو أنّك ستذهب إلى المشفى ثانية

243
00:19:57,980 --> 00:19:59,660
أنت حقير قويّ

244
00:20:09,240 --> 00:20:13,890
إنّك من طوكيو، صحيح؟ ماذا تفعل في أوساكا؟

245
00:20:13,890 --> 00:20:16,820
لستُ من طوكيو تماماً

246
00:20:16,820 --> 00:20:21,390
أنتم الياكوزا مهووسون دائماً بمناطق النّفوذ

247
00:20:28,350 --> 00:20:30,610
...يا ابن الـ

248
00:20:33,400 --> 00:20:34,650
!أيُعقَل هذا؟

249
00:20:35,250 --> 00:20:36,450
توقُّف مُؤقّت

250
00:20:38,220 --> 00:20:41,060
!تبّاً! وهو لا يردّ

251
00:20:41,060 --> 00:20:43,280
!كلّ هذا والآن سنعود إلى المنزل؟

252
00:20:43,780 --> 00:20:46,460
!إنّه لا يفقه شيئاً عن التّعاون الجماعيّ

253
00:20:47,730 --> 00:20:49,060
نكتفي بهذا القدر أيّها النّحيل

254
00:20:49,480 --> 00:20:52,540
،لكن إن نعتّني بذي الشّعر الأجعد ثانية
فاعتبِر نفسك ميّتاً فعلاً

255
00:20:52,990 --> 00:20:56,950
بجدّية، من أنت على أيّ حال؟

256
00:20:56,950 --> 00:20:58,910
أريد تعويضي مُقابل هذه البدلة

257
00:20:58,910 --> 00:21:02,500
مهلاً. ما شأنك مع مياما كيريشيما؟

258
00:21:03,890 --> 00:21:05,990
ليس لي شأن معه

259
00:21:07,380 --> 00:21:10,830
أوتظنّني سأقطع كلّ الطّريق إلى أوساكا
لمساعدة مجموعة مجرمين

260
00:21:10,830 --> 00:21:13,370
لا أعرفهم حتّى في ثأرهم؟

261
00:21:13,370 --> 00:21:15,080
هذا عملٌ بالنّسبة لي

262
00:21:16,280 --> 00:21:18,430
أنت من عائلة كيريغايا، صحيح؟

263
00:21:18,930 --> 00:21:23,010
ومُتدنّي الرّتبة لدرجة أنّك لا تعرف ما يجري

264
00:21:23,770 --> 00:21:25,250
ما الّذي تخطِّط له؟

265
00:21:26,490 --> 00:21:29,920
ستندلع الكثير من النّزاعات
المُملّة في المستقبل

266
00:21:29,920 --> 00:21:33,270
لو كنتُ مكانك، لاعتزلتُ الياكوزا

267
00:21:34,470 --> 00:21:38,530
مياما كيريشيما جزء من الأمر

268
00:21:55,270 --> 00:21:56,720
سحقاً

269
00:21:57,580 --> 00:21:59,590
هل أنت بخير يا أوزو-كن؟

270
00:22:01,980 --> 00:22:06,770
لنكمل من حيث توقّفنا. هناك كثير
من الأمور لمُناقشتها أثناء الشّرب