15
00:01:07,360 --> 00:01:09,910
لم نبذل مجهوداً حتّى

16
00:01:09,910 --> 00:01:11,460
لا نملك وقتاً لهدره

17
00:01:11,460 --> 00:01:13,350
إنّه في الطّابق العلويّ، صحيح؟

18
00:01:14,340 --> 00:01:17,130
لا عجب من وصولكما إلى هذه المرحلة

19
00:01:17,130 --> 00:01:17,850
...لكن

20
00:01:18,280 --> 00:01:20,890
،إذا أردتُما اللّقاء به حقّاً

21
00:01:21,250 --> 00:01:24,980
فسيترتّب عليكما هزيمتي، شاين
!جيرارد، أوّلاً

22
00:01:25,210 --> 00:01:27,760
حسناً، من منكما سيبدأ أوّلاً؟

23
00:01:33,380 --> 00:01:35,070
!إنّه أنا

24
00:01:36,160 --> 00:01:38,150
!عضلات جيّدة

25
00:01:42,040 --> 00:01:45,960
المعذرة... هذا هو المكان، صحيح؟

26
00:01:51,830 --> 00:01:53,750
هل هذا يعني بأنّني ينبغي
أن أدخل فحسب؟

27
00:01:55,170 --> 00:01:56,830
المعذرة

28
00:02:14,800 --> 00:02:17,940
لقد وصلتِ يا أميليا روز

29
00:02:17,940 --> 00:02:21,530
...سررتُ بلقائك، في الواقع

30
00:02:21,930 --> 00:02:23,910
أنا ليزيلوتّي إيدين

31
00:02:23,910 --> 00:02:27,530
ربّما ستفهمين إذا قلتُ "ساحرة التّلفيق"؟

32
00:02:27,530 --> 00:02:28,880
...المعذرة

33
00:02:28,880 --> 00:02:30,410
التّـ... لفيق؟

34
00:02:31,390 --> 00:02:32,540
!ماذا؟

35
00:03:00,320 --> 00:03:02,660
صباح الخير يا يوليوس-ساما

36
00:03:02,660 --> 00:03:04,810
صباح الخير يا إيما

37
00:03:04,810 --> 00:03:05,950
من فضلك

38
00:03:08,960 --> 00:03:12,340
لماذا يبدو وكأنّه يمضغها؟

39
00:03:15,460 --> 00:03:19,420
ساحر نصل الجليد
سيحكم العالم

40
00:03:19,850 --> 00:03:23,980
الحلقة 2
الفتى الّذي يُعدّ السّاحر الأقوى
في العالم يرتدي قِناعاً

41
00:03:25,570 --> 00:03:27,710
شرف لي أن ألتقي بكما

42
00:03:27,980 --> 00:03:30,370
اسمي آرياني ألغرين

43
00:03:30,370 --> 00:03:32,230
سررتُ بمعرفتكما

44
00:03:32,230 --> 00:03:34,060
أنا ساشا وايت

45
00:03:34,060 --> 00:03:35,510
وأنا لوثر

46
00:03:35,510 --> 00:03:36,840
إنّهما والدايّ

47
00:03:36,840 --> 00:03:39,110
!إنّهما أمّي وأبي

48
00:03:40,450 --> 00:03:42,830
المكان ضيّق جدّاً، لكن نأمل أن
تستمتعي بإقامتكِ

49
00:03:42,830 --> 00:03:43,720
!لا أبداً

50
00:03:43,720 --> 00:03:47,370
أنا من ينبغي أن يعتذر لمجيئي
دون موعد مُسبَق

51
00:03:47,370 --> 00:03:48,360
آرياني

52
00:03:48,360 --> 00:03:49,110
نعم؟

53
00:03:49,410 --> 00:03:52,370
سيبدأ تدريبنا في صباح الغد

54
00:03:52,370 --> 00:03:54,850
يمكنكِ أن تنامي في سرير ستيلّا
بينما نبقى نحن هنا

55
00:03:55,380 --> 00:03:57,000
لكن حينها أين ستنام هي؟

56
00:03:57,000 --> 00:04:00,010
أنام مع أخي، لذا لا تقلقي

57
00:04:00,010 --> 00:04:00,820
ماذا؟

58
00:04:00,820 --> 00:04:02,580
تفعل ذلك دوماً

59
00:04:02,580 --> 00:04:05,390
هي ماذا؟

60
00:04:05,390 --> 00:04:07,230
!يا لستيلّا تلك

61
00:04:07,230 --> 00:04:09,140
تحبّ أخاها الكبير حقّاً

62
00:04:09,140 --> 00:04:11,060
!ونحن نستحمّ معاً أيضاً

63
00:04:11,060 --> 00:04:12,060
أجل

64
00:04:12,060 --> 00:04:13,660
أنتما مُنسجمان كثيراً

65
00:04:14,390 --> 00:04:16,390
!مهلاً، لحظة فقط

66
00:04:17,250 --> 00:04:18,770
ما الخطب يا آرياني؟

67
00:04:19,270 --> 00:04:23,120
!فليصطفّ الجميع هناك

68
00:04:23,120 --> 00:04:25,810
...هناك... هناك... هناك

69
00:04:26,850 --> 00:04:28,200
...بئس الأمر

70
00:04:28,200 --> 00:04:29,530
...المعذرة

71
00:04:29,860 --> 00:04:33,270
كنّا نقول لأنفسنا بأنّ هذا قد يتحوّل
إلى مُشكلة قريباً

72
00:04:33,270 --> 00:04:34,140
أليس كذلك؟

73
00:04:34,140 --> 00:04:35,330
...صحيح

74
00:04:35,330 --> 00:04:36,850
!هذا سيّئ

75
00:04:39,050 --> 00:04:41,620
،لا ضير من التّقارب كأخوين

76
00:04:41,620 --> 00:04:44,800
لكن ماذا ستفعلان إذا لم تستطع هي
!الزّواج بسبب ذلك؟

77
00:04:45,740 --> 00:04:47,660
!إذاً سأتزوّج أخي الكبير

78
00:04:47,660 --> 00:04:49,780
!ليس هذا ما أقصده

79
00:04:51,670 --> 00:04:52,640
أخي الكبير

80
00:04:52,640 --> 00:04:53,680
نـ-نعم؟

81
00:04:53,680 --> 00:04:55,480
،حتّى لو اضطررنا للفُراق

82
00:04:55,480 --> 00:04:57,680
!علاقتنا لن تتغيّر

83
00:04:57,680 --> 00:05:00,100
!أجل! هذا صحيح

84
00:05:00,440 --> 00:05:01,820
أنتما

85
00:05:01,820 --> 00:05:03,700
...إنّهما سريعا النّموّ

86
00:05:03,700 --> 00:05:04,790
أخي الكبير

87
00:05:04,790 --> 00:05:05,470
ستيلّا

88
00:05:05,470 --> 00:05:06,260
أخي الكبير

89
00:05:06,260 --> 00:05:06,950
ستيلّا

90
00:05:06,950 --> 00:05:07,780
أخي الكبير

91
00:05:07,780 --> 00:05:08,610
ستيلّا

92
00:05:08,610 --> 00:05:10,130
لا أدري كيف أصِف الأمر

93
00:05:10,950 --> 00:05:13,100
من نظرة واحدة تعرف بأنّهما شقيقان

94
00:05:13,100 --> 00:05:13,960
!أجل-
!صحيح-

95
00:05:15,760 --> 00:05:19,680
...المعذرة، إذاً طلب منّي راي

96
00:05:19,680 --> 00:05:22,970
أجل، طلب منّي الاعتناء بكِ

97
00:05:23,180 --> 00:05:24,970
أنا مَدينة له

98
00:05:24,970 --> 00:05:25,870
مَدينة؟

99
00:05:25,870 --> 00:05:29,650
لكن في ذات الوقت، لديّ
اهتمام بكِ كذلك

100
00:05:29,650 --> 00:05:31,210
أميليا روز

101
00:05:31,210 --> 00:05:32,170
ماذا؟

102
00:05:32,170 --> 00:05:33,830
تأثير الفراشة

103
00:05:35,020 --> 00:05:36,740
تعويذتكِ الأصليّة

104
00:05:37,090 --> 00:05:40,100
السّحر الّذي يتدخّل في كافّة السّببيّات

105
00:05:40,990 --> 00:05:42,860
!لقد ارتجفت

106
00:05:42,860 --> 00:05:44,910
حقّاً؟

107
00:05:44,910 --> 00:05:50,240
غير أنّ السّحر القويّ زيادة عن اللّزوم
ينتهي أحياناً بقتل مُستخدمه

108
00:05:50,510 --> 00:05:51,740
...لهذا السّبب بالضّبط

109
00:05:55,820 --> 00:05:59,880
ارتأيتُ بأنّني يجب أن أوفّر لكِ
التّوجيه المُناسب

110
00:05:59,880 --> 00:06:00,890
...حسناً

111
00:06:03,870 --> 00:06:05,790
!نلتُ منك

112
00:06:08,820 --> 00:06:10,140
...أحسنت صنعاً

113
00:06:10,140 --> 00:06:11,500
تابع إذاً

114
00:06:11,810 --> 00:06:14,610
...إنّه في الطّابق فوقنا

115
00:06:16,830 --> 00:06:18,330
!عمل ممتاز

116
00:06:19,200 --> 00:06:20,520
!حسناً

117
00:06:20,520 --> 00:06:21,710
هيّا بنا

118
00:06:21,710 --> 00:06:24,510
أجل، أخيراً

119
00:06:33,090 --> 00:06:34,280
!المعذرة

120
00:06:34,900 --> 00:06:38,530
نودّ أن نتكلّم يا لوكاس فورست

121
00:06:40,450 --> 00:06:41,780
أنتما؟

122
00:06:41,780 --> 00:06:43,080
راي وايت

123
00:06:44,040 --> 00:06:47,190
!نريد مُواجهته في معركة صريحة

124
00:06:47,190 --> 00:06:48,790
وأنت أيضاً، صحيح؟

125
00:06:49,290 --> 00:06:51,510
...بصفة ساحر النّصل الّذي لا نظير له

126
00:06:51,510 --> 00:06:53,750
أريد مُقاتلة نصل الجليد

127
00:06:54,220 --> 00:06:59,950
أردتُك أن ترى بأنّ السّاحر الأقوى
هو النّصل الّذي لا نظير له

128
00:06:59,950 --> 00:07:01,460
!النّصل الّذي لا نظير له؟

129
00:07:02,070 --> 00:07:04,150
ألهذا أنتما هنا؟

130
00:07:04,150 --> 00:07:05,020
أجل

131
00:07:05,020 --> 00:07:07,560
!أنت الوحيد الّذي نريد أن نُشكّل فريقاً معه

132
00:07:07,560 --> 00:07:09,000
هكذا إذاً

133
00:07:09,000 --> 00:07:11,590
لن أستخدم سيفي

134
00:07:11,590 --> 00:07:13,080
يمكنكما مُهاجمتي معاً

135
00:07:13,520 --> 00:07:17,450
أريد رؤية قوّتكما... وعزيمتكما

136
00:07:17,770 --> 00:07:20,750
وأيضاً، لا ترتديا حذاء على حصيرة التّاتامي

137
00:07:22,150 --> 00:07:24,570
أنا جاهز متى أردتُما

138
00:07:35,540 --> 00:07:39,660
لا بُدّ أنّها كانت سعيدة جدّاً
بعودة أخيها الأكبر للمنزل

139
00:07:39,660 --> 00:07:43,560
راي وستيلّا مُنسجمان كثيراً حقّاً

140
00:07:43,560 --> 00:07:44,540
أليسا كذلك؟

141
00:07:44,540 --> 00:07:46,560
كما لو أنّهما شقيقان حقيقيّان

142
00:07:46,970 --> 00:07:51,150
لكن في البداية، كلاهما كانا
يبتعدان عن بعضهما الآخر

143
00:07:51,150 --> 00:07:52,920
ماذا؟ حقّاً؟

144
00:07:52,920 --> 00:07:53,750
أجل

145
00:07:54,230 --> 00:07:58,990
ليديا، أختي الصّغرى، طلبتْ منّي تبنّي راي

146
00:07:58,990 --> 00:08:01,350
بالتّفكير في الأمر، حدثتْ أمور كثيرة

147
00:08:02,940 --> 00:08:04,220
هل أنتِ مهتمّة؟

148
00:08:05,460 --> 00:08:07,760
بطبع راي عندما أتى أوّل مرّة إلى هنا؟

149
00:08:07,760 --> 00:08:09,330
أ-أجل، من فضلكِ

150
00:08:10,510 --> 00:08:13,790
...آرياني، إذاً بخصوص تدريب الغد

151
00:08:15,250 --> 00:08:16,320
ما المُشكلة؟

152
00:08:16,320 --> 00:08:19,260
!لا شيء

153
00:08:19,260 --> 00:08:20,420
حقّاً؟

154
00:08:21,020 --> 00:08:22,230
!ستيلّا

155
00:08:22,810 --> 00:08:26,430
أنتِ ظريفة أثناء نومكِ، لكن
لا ينبغي أن تنامي هنا

156
00:08:26,430 --> 00:08:28,170
!يجب أن تنامي في سريركِ

157
00:08:29,780 --> 00:08:32,020
سنتابع غداً، اتّفقنا؟

158
00:08:32,020 --> 00:08:33,570
!أجل

159
00:08:33,570 --> 00:08:34,820
حسناً يا آرياني

160
00:08:34,820 --> 00:08:36,280
!أجل

161
00:08:36,720 --> 00:08:38,870
سنبدأ باكراً غداً، على السّادسة

162
00:08:39,270 --> 00:08:41,040
ينبغي أن تخلدي إلى النّوم قريباً أيضاً

163
00:08:41,580 --> 00:08:43,240
معك حقّ

164
00:08:45,070 --> 00:08:48,080
تصبحين على خير يا عمّتي

165
00:08:48,080 --> 00:08:50,180
تصبحين على خير

166
00:08:55,300 --> 00:08:57,930
!ما زال بمقدوره الجري

167
00:09:01,800 --> 00:09:02,820
حسناً

168
00:09:06,040 --> 00:09:09,300
...تبّاً! لم نستطع حتّى إصابته بضربة

169
00:09:09,300 --> 00:09:12,070
...إذاً هذا هو أحد السّحرة العُظماء السّبعة

170
00:09:12,070 --> 00:09:15,690
من المُدهش أن تصمدا كلّ هذه الفترة الطّويلة

171
00:09:15,690 --> 00:09:18,650
شرف لي أن أتلقّى مديحاً كهذا

172
00:09:18,650 --> 00:09:22,540
في المرّة المُقبلة، سندعك على الأقلّ
...تتحرّك خطوة واحدة

173
00:09:28,040 --> 00:09:30,440
أنتما مُسلّيان

174
00:09:32,450 --> 00:09:36,490
آلبيرت آليوم وإيفي آرمسترونغ

175
00:09:37,320 --> 00:09:40,090
أتطلّع بلهفة لهذا يا راي وايت

176
00:09:44,510 --> 00:09:46,250
يبدو أنّه سيُشارك

177
00:09:46,250 --> 00:09:47,070
تعرف من أقصد

178
00:09:47,070 --> 00:09:48,870
نصل الجليد

179
00:09:48,870 --> 00:09:51,020
ويبدو أنّ النّصل الّذي لا نظير له
سوف يدخل كذلك

180
00:09:51,020 --> 00:09:53,550
هذا مُثير للاهتمام

181
00:09:53,550 --> 00:09:57,700
حتّى النّصل الّذي لا نظير له السّابق
كان مهووساً بنصل الجليد

182
00:09:57,970 --> 00:10:02,270
هيلينا غرادي، وحصّاد الموتى، وباراتروغو

183
00:10:02,640 --> 00:10:05,200
نصل الجليد هزمَ كُلّ واحد منهم

184
00:10:05,390 --> 00:10:08,130
لا شكّ في ذلك، إنّه يستعيد قِواه باستمرار

185
00:10:08,130 --> 00:10:13,350
يبدو أنّ حماوته الزّائدة لم تكن
مُجرّد حماوة آنذاك

186
00:10:13,970 --> 00:10:14,950
أجل

187
00:10:14,950 --> 00:10:18,460
جعلْنا عدداً كبيراً من رعايا
،التّجارب تحمأ حماوةً زائدة

188
00:10:18,750 --> 00:10:22,350
لكن كُلّ ما يمكننا معرفته حتّى الآن هو أنّ
قضيّة نصل الجليد مُميّزة

189
00:10:22,350 --> 00:10:25,840
إن كان كذلك، فلا بُدّ أنّه أكاشا

190
00:10:27,210 --> 00:10:29,380
ماذا يفعل راي؟

191
00:10:29,380 --> 00:10:32,720
قال بأنّه سيبدأ بالإعداد أوّلاً

192
00:10:32,720 --> 00:10:34,780
ماذا؟ أحقّاً ذلك؟

193
00:10:34,780 --> 00:10:35,730
هذا صحيح

194
00:10:35,730 --> 00:10:38,210
!إذاً، لنذهب إلى غابة دوغما معاً

195
00:10:38,740 --> 00:10:40,630
!انطلاق

196
00:10:42,450 --> 00:10:43,830
!انتظري من فضلكِ

197
00:10:44,080 --> 00:10:46,180
!انطلاق

198
00:10:44,660 --> 00:10:46,740
!ستيلّا؟

199
00:10:47,630 --> 00:10:51,030
!آرياني، من هنا

200
00:10:52,510 --> 00:10:53,830
!هنا

201
00:10:53,830 --> 00:10:56,560
كانت مسافة طويلة

202
00:10:58,000 --> 00:11:00,490
هذه هي غابة دوغما إذاً؟

203
00:11:00,490 --> 00:11:01,220
أجل

204
00:11:01,220 --> 00:11:03,510
ستتدرّبين هنا كُلّ يوم الآن

205
00:11:03,510 --> 00:11:04,870
...هكذا إذاً

206
00:11:04,870 --> 00:11:06,280
!صباح الخير يا آرياني

207
00:11:07,350 --> 00:11:08,360
...راي

208
00:11:08,360 --> 00:11:10,160
...هذا

209
00:11:11,680 --> 00:11:13,110
...هذا

210
00:11:13,110 --> 00:11:14,150
ما هذا؟

211
00:11:15,300 --> 00:11:16,560
!هذا

212
00:11:25,970 --> 00:11:28,510
راي... أهذه أنت؟

213
00:11:28,950 --> 00:11:31,800
!اسمي هو السّيّد وايت

214
00:11:32,490 --> 00:11:34,220
!بلاك

215
00:11:34,220 --> 00:11:37,190
...بلاك... بلاك... بلاك

216
00:11:37,190 --> 00:11:39,670
اعتباراً من هذا اليوم، سأكون مُدرّبك

217
00:11:39,670 --> 00:11:40,430
عفواً؟

218
00:11:40,430 --> 00:11:44,560
المُعلّم وايت... بلاك؟

219
00:11:44,560 --> 00:11:47,600
هل أنت وايت أم بلاك؟

220
00:11:48,070 --> 00:11:49,690
المُتدرِّبة آرياني

221
00:11:49,690 --> 00:11:50,910
حاضرة؟

222
00:11:50,910 --> 00:11:52,630
،يبدو أنّكِ نسيتِ تماماً

223
00:11:52,630 --> 00:11:53,970
"لكن عليكِ الردّ بـ"حارِسة

224
00:11:53,970 --> 00:11:54,940
ماذا؟

225
00:11:54,940 --> 00:11:57,590
!"قلتُ ردّي بـ"حارِسة

226
00:11:57,590 --> 00:12:00,560
!حارِسة، هو قولي

227
00:12:00,560 --> 00:12:03,670
اليوم يبدأ مُعسكر التّدريب الخاصّ
بأسلوب آينزورث

228
00:12:03,670 --> 00:12:05,560
سنبدأ بالتّدريب في

229
00:12:05,560 --> 00:12:07,820
!فصل في تدريب البقاء" ومعارك حقيقيّة"

230
00:12:08,100 --> 00:12:09,680
!حضّري نفسكِ

231
00:12:12,010 --> 00:12:13,400
فوراً

232
00:12:13,400 --> 00:12:15,840
!حـ-حارِسة! هو قولي

233
00:12:16,330 --> 00:12:18,200
لسنا بحاجة لـ"ح" ولسنا بحاجة
!"لـ"هو قولي

234
00:12:18,470 --> 00:12:20,750
!ارسة

235
00:12:20,750 --> 00:12:22,010
احتفظي بـ"ح" واحدة

236
00:12:22,560 --> 00:12:24,970
!حـ-حارِسة

237
00:12:24,970 --> 00:12:28,020
...رس... رس

238
00:12:28,020 --> 00:12:28,730
!جيّد

239
00:12:28,730 --> 00:12:31,230
بهذا، سنبدأ بتدريبكِ على القتال فوراً

240
00:12:31,230 --> 00:12:32,340
!حارِسة

241
00:12:32,340 --> 00:12:34,350
ما رأيكِ أن أعرّفكِ على مُساعدتي؟

242
00:12:34,350 --> 00:12:35,400
مُساعِدة؟

243
00:12:35,610 --> 00:12:38,210
صباح الخير أيّتها المُتدرِّبة آرياني

244
00:12:38,210 --> 00:12:39,740
ستيلّا؟

245
00:12:46,270 --> 00:12:50,090
!اسمي هو الأخت وايت غراي

246
00:12:50,090 --> 00:12:51,830
!سأُهاجمكِ بكُل ما أوتيت من قوّة

247
00:12:53,100 --> 00:12:54,280
غراي؟

248
00:12:54,280 --> 00:12:56,430
إذاً ليس وايت وليس بلاك؟

249
00:12:56,430 --> 00:12:58,360
...مهلاً لحظة

250
00:12:58,360 --> 00:13:00,090
ما الأمر أيّتها المُتدرِّبة آرياني؟

251
00:13:00,090 --> 00:13:02,930
!غابة دوغما هي بمُستوى صعوبة س

252
00:13:03,120 --> 00:13:04,220
ماذا يعني؟

253
00:13:04,220 --> 00:13:06,370
ماذا يعني... ماذا؟

254
00:13:06,970 --> 00:13:08,260
لا تقلقي

255
00:13:08,260 --> 00:13:10,940
،عندما يتعلّق الأمر بقتال المسافات القريبة

256
00:13:10,940 --> 00:13:13,490
قدراتها مُكافئة لقدراتي

257
00:13:13,930 --> 00:13:16,690
الوحوش في هذه الغابة لا يدعون للقلق

258
00:13:18,350 --> 00:13:20,780
لا تقلقي أيّتها المُتدرِّبة آرياني

259
00:13:23,350 --> 00:13:24,910
حسناً إذاً

260
00:13:25,270 --> 00:13:27,520
،هناك أمور كثيرة أريد قولها

261
00:13:27,520 --> 00:13:29,490
!لكن سأثق بكما

262
00:13:43,830 --> 00:13:46,450
!إنّه عقرب ضخم

263
00:13:46,940 --> 00:13:48,500
هل ستتولّين هذا يا غراي؟

264
00:13:48,500 --> 00:13:49,870
—بالطّبع يا أخي الكبـ

265
00:13:49,870 --> 00:13:50,860
!بلاك

266
00:13:52,310 --> 00:13:54,160
...ماذا؟ مُجرّد

267
00:14:05,590 --> 00:14:07,410
حسناً! تمّ

268
00:14:07,410 --> 00:14:08,860
المعذرة، راي؟

269
00:14:08,860 --> 00:14:10,830
أنا المُعلّم وايت بلاك

270
00:14:10,830 --> 00:14:12,550
حسناً إذاً يا سيّد بلاك

271
00:14:12,550 --> 00:14:13,780
ما الأمر؟

272
00:14:14,100 --> 00:14:16,740
ما الّذي فعلَتْه ستيلـ... أقصد غراي للتو؟

273
00:14:16,740 --> 00:14:17,970
ركلَتْه فقط

274
00:14:17,970 --> 00:14:18,910
ماذا عن السّحر؟

275
00:14:18,910 --> 00:14:20,200
تعزيز جسدي فقط

276
00:14:20,540 --> 00:14:23,150
ضربة واحدة؟ بتعزيز جسديّ فقط؟

277
00:14:23,150 --> 00:14:27,980
ستيل... أقصد، اختصاص غراي هو
إيجاد نقاط ضعف أي وحش

278
00:14:27,980 --> 00:14:31,480
وإذا كنّا نتكلّم عن القوّة الجسديّة
،دون تعزيزات سحريّة

279
00:14:31,480 --> 00:14:33,640
فلا أبالغ إذا قلتُ بأنّها أفضل منّي

280
00:14:34,060 --> 00:14:37,280
إنّها مختصّة في الفنون القتاليّة

281
00:14:38,860 --> 00:14:40,450
!آرياني

282
00:14:40,810 --> 00:14:42,290
أنا قويّة، صحيح؟

283
00:14:42,290 --> 00:14:43,490
أ-أجل

284
00:14:43,490 --> 00:14:47,060
...من الواضح أنّكِ تدرّبتِ بواسطة را
أقصد، المُعلّم بلاك

285
00:14:47,270 --> 00:14:49,820
!السّيّد بلاك وليديا

286
00:14:49,820 --> 00:14:53,720
نصل الجليد السّابق والحاليّ

287
00:14:53,720 --> 00:14:56,080
يا له من تعليم رفيع

288
00:14:57,630 --> 00:14:59,110
حسناً، حسناً

289
00:14:59,110 --> 00:15:02,090
!سنبدأ الآن بتدريب المعارك بجدّية

290
00:15:02,090 --> 00:15:03,090
ما رأيكما؟

291
00:15:03,090 --> 00:15:04,510
!حارِسة

292
00:15:05,410 --> 00:15:08,600
هل سنتدرّب هنا؟

293
00:15:08,600 --> 00:15:09,450
أجل

294
00:15:09,450 --> 00:15:12,070
،لكن إذا كنّا سنستخدم السّحر
...فالأثاثات قد

295
00:15:12,070 --> 00:15:13,830
لا داعي للقلق بشأن ذلك

296
00:15:19,970 --> 00:15:20,860
...هذا

297
00:15:21,900 --> 00:15:25,110
فضاء مُغطّى بالتّلفيق... على ما أعتقد

298
00:15:25,380 --> 00:15:27,960
،معزول عن سببيّات العالم الخارجيّ

299
00:15:27,960 --> 00:15:29,870
لذا لا داعي للقلق بشأن أيّ شيء

300
00:15:30,180 --> 00:15:33,070
إذاً هذا شيء يستطيع فعله
أحد السّحَرة العُظماء السّبعة؟

301
00:15:33,070 --> 00:15:36,080
لنتحدّث عن خطّة تدريبك

302
00:15:37,200 --> 00:15:39,310
يمكنكِ القول بأنّ

303
00:15:39,310 --> 00:15:42,240
سحر تأثير الفراشة الخاص بك
يحلّ محلّ سحري

304
00:15:42,240 --> 00:15:44,360
—في الواقع، لا أقول إلى هذا الحدّ

305
00:15:43,490 --> 00:15:47,380
لا أنكر بأنّني ما زلتُ أمتلك خبرة
أكبر كساحِرة

306
00:15:47,790 --> 00:15:52,160
،لكن إذا نظرتِ إلى طبيعة تأثير الفراشة
فهذا واضح وضوح الشّمس

307
00:15:52,160 --> 00:15:53,130
ماذا تقصدين؟

308
00:15:53,130 --> 00:15:55,760
،من بين كافّة السّببيّات في العالم

309
00:15:55,760 --> 00:15:58,030
أستطيع فقط التدخُّل في جزئيّة صغيرة

310
00:15:58,030 --> 00:16:01,140
بينما تستطيعين أنتِ التدخُّل فيها جميعها

311
00:16:01,370 --> 00:16:04,140
تمتلكين حتماً ما يتطلّبه الأمر لتصبحي
أحد السّحَرة العُظماء السّبعة

312
00:16:04,140 --> 00:16:05,390
أنا؟

313
00:16:05,630 --> 00:16:09,280
لعلّكِ تُواجهين صعوبة في تصديق ذلك
الآن، لكنّها الحقيقة

314
00:16:09,280 --> 00:16:10,160
...فضلاً عن ذلك

315
00:16:10,650 --> 00:16:12,920
السّحرة العُظماء السّبعة يتناوبون

316
00:16:13,910 --> 00:16:16,650
والآن، هل نبدأ يا أميليا روز؟

317
00:16:16,650 --> 00:16:18,160
!أجل

318
00:16:18,660 --> 00:16:21,660
ستيلّا مُدهشة حقّاً

319
00:16:21,660 --> 00:16:23,900
لم أكن ندّة لها

320
00:16:23,900 --> 00:16:27,250
هذه أوّل مرّة تُقاتلين فيها في الغابة، صحيح؟

321
00:16:27,660 --> 00:16:31,330
ستيلّا مُعتادة كثيراً على القتال
،في هذه البيئة

322
00:16:31,330 --> 00:16:32,680
لذا هذا عائق كبير

323
00:16:32,680 --> 00:16:36,150
كنتُ لا أزال مصدومة جدّاً من عيوبي

324
00:16:36,150 --> 00:16:37,900
لهذا السّبب نتدرّب

325
00:16:37,900 --> 00:16:40,120
أجل. سأبذل قصارى جهدي

326
00:16:40,950 --> 00:16:44,550
أنا مُقتنع تماماً بأنّكِ تستطيعين
فعلها يا آرياني

327
00:16:46,920 --> 00:16:48,550
ما الأمر؟

328
00:16:50,070 --> 00:16:52,170
لا شيء. شعرتُ بأنّ شخصاً ينظر إلينا

329
00:16:52,170 --> 00:16:53,270
ينظر؟

330
00:16:53,270 --> 00:16:55,930
!زئير

331
00:16:57,020 --> 00:16:59,190
إنّها مُجرّد نمر

332
00:16:59,190 --> 00:17:00,630
!ماذا؟

333
00:17:00,630 --> 00:17:02,980
إذا كان نمراً برّياً، فلا شيء يدعو للخوف

334
00:17:02,980 --> 00:17:05,000
...لكن كان ذلك

335
00:17:07,400 --> 00:17:10,460
!لا أُصدِّق بأنّكِ اخترتِ حيواناً سنّوريّاً كبيراً

336
00:17:10,460 --> 00:17:12,710
!لحسن حظّنا أنّه لم يُكشَف أمرنا

337
00:17:12,710 --> 00:17:15,970
أقصد بأنّ ليس لديهم قطط منزليّة
في هذه الأرجاء هنا

338
00:17:16,160 --> 00:17:20,110
على أيّ حال، ما رأيك؟

339
00:17:20,110 --> 00:17:21,220
ماذا تقصدين؟

340
00:17:21,220 --> 00:17:23,470
المسافة. ألم يكونا مُقرَّبين كثيراً؟

341
00:17:23,470 --> 00:17:27,850
—حسناً، راي هكذا دوماً مع الجميع

342
00:17:27,190 --> 00:17:29,420
!لا أقصد راي! أتحدّث عن آرياني

343
00:17:30,520 --> 00:17:33,540
أعتقد بأنّها لا تكرهه

344
00:17:33,540 --> 00:17:36,530
يبدو وكأنّ علاقتهما تتطوّر أكثر فأكثر

345
00:17:36,530 --> 00:17:42,510
إذاً... لماذا نحن هنا، نرتدي هذا
ونفعل ما نفعله؟

346
00:17:42,870 --> 00:17:45,960
كيف عرفتِ حتّى عنوان منزل راي؟

347
00:17:45,960 --> 00:17:48,490
استطعتُ الحصول عليه من خلال
صلاحيّات مجلس الطّلبة

348
00:17:49,210 --> 00:17:51,010
هذا لأجل ريبيكا

349
00:17:51,010 --> 00:17:52,710
!هل أنتِ متأكّدة من هذا حقّاً؟

350
00:17:52,710 --> 00:17:54,350
!إنّه لأجل ريبيكا

351
00:17:55,840 --> 00:17:57,260
هل يمكنني العودة إلى المنزل الآن؟

352
00:17:57,260 --> 00:17:58,760
!لا

353
00:17:58,760 --> 00:18:01,560
!لستُ مرتاحة هنا بمُفردي

354
00:18:01,560 --> 00:18:03,050
إذاً لنذهب إلى المنزل

355
00:18:03,050 --> 00:18:04,260
!لا نستطيع

356
00:18:04,710 --> 00:18:09,200
نحن الوحيدتان اللّتان نُراعي مشاعر ريبيكا

357
00:18:24,680 --> 00:18:28,040
اعتباراً من اليوم، سوف نتمرّن
!على الحروب الفدائيّة الحقيقيّة

358
00:18:28,440 --> 00:18:30,540
،سنُحلِّل البيئات والأوضاع المُختلفة بشكل صحيح

359
00:18:30,540 --> 00:18:33,790
ونتعلّم طُرُقاً في القتال بينما نمتلك
!الأفضليّة بشكل دائم

360
00:18:34,090 --> 00:18:35,290
!درّبي جسدكِ على ذلك

361
00:18:40,480 --> 00:18:42,030
!هو قولي

362
00:18:42,030 --> 00:18:42,970
!حارِسة

363
00:18:43,310 --> 00:18:45,310
لنذهب إذاً

364
00:18:45,310 --> 00:18:48,140
!أجل! يبدأ تدريبنا الآن

365
00:18:52,650 --> 00:18:53,840
هذا صحيح

366
00:18:53,840 --> 00:18:58,570
اشعري بتدفُّق كافّة البريما ماتيريا
الّتي تُحيط بجسدك

367
00:19:17,810 --> 00:19:19,590
مؤلم

368
00:19:21,290 --> 00:19:22,850
ليزيلوتّي

369
00:19:23,390 --> 00:19:25,220
شكراً جزيلاً لك

370
00:19:25,590 --> 00:19:26,840
لا شيء

371
00:19:26,840 --> 00:19:29,360
ربّما هكذا ينبغي أن أفعلها

372
00:19:30,450 --> 00:19:32,100
ليزيلوتّي؟

373
00:19:32,840 --> 00:19:34,030
أنا بخير

374
00:19:34,370 --> 00:19:36,100
هل نستمرّ؟

375
00:19:36,450 --> 00:19:37,520
...بكلّ تأكيد

376
00:19:40,360 --> 00:19:42,550
هذا مُفاجئ جدّاً

377
00:19:42,550 --> 00:19:44,440
ها أنتِ ذي

378
00:19:45,200 --> 00:19:46,620
ما الخطب؟

379
00:19:46,620 --> 00:19:48,180
!كلاريس

380
00:19:48,180 --> 00:19:49,870
هل أنتِ قلقة من شيء؟

381
00:19:49,870 --> 00:19:51,540
لا

382
00:19:51,540 --> 00:19:53,370
كُلّ شيء بخير

383
00:19:55,960 --> 00:19:58,620
الأجواء مُوحشة جدّاً برحيل الجميع

384
00:19:58,620 --> 00:20:00,630
بالفعل

385
00:20:00,630 --> 00:20:03,270
آمل أن يعودوا قريباً

386
00:20:03,270 --> 00:20:05,990
أشتاق إليهم

387
00:20:08,770 --> 00:20:13,070
...كان ذلك صعباً... لكن أنا متأكّدة بأنّني سوف

388
00:20:13,430 --> 00:20:14,260
تفضّلي

389
00:20:15,780 --> 00:20:17,000
هذا أنتِ

390
00:20:17,000 --> 00:20:19,210
وعدتُكِ، صحيح؟

391
00:20:20,430 --> 00:20:23,580
مضى أكثر من ثلاث سنوات منذ
مجيء راي إلينا

392
00:20:24,100 --> 00:20:28,900
كان انطباعي الأوّل عنه بأنّه
طفل هادئ جدّاً

393
00:20:28,900 --> 00:20:32,570
كان يتمتّع بهدوء غير مُتوقَّع من فتى
عمره 12 سنة

394
00:20:33,000 --> 00:20:36,110
آنذاك، كانت ستيلّا طفلة خجولة جدّاً

395
00:20:36,110 --> 00:20:38,260
لذا كانت دائماً ما تتوخّى الحذر منه

396
00:20:39,930 --> 00:20:41,470
لم تتوقّعي ذلك، صحيح؟

397
00:20:41,470 --> 00:20:46,020
لكن أعتقد لا بُدّ أنّها كانت هالة
راي آنذاك

398
00:20:46,020 --> 00:20:48,560
رُبّما هذا ما أخافها

399
00:20:49,820 --> 00:20:52,690
هل تعرفين سبب مجيء راي للعيش معنا؟

400
00:20:52,690 --> 00:20:57,440
أجل. كان قد تركَ الجيش
وكانت أُمنية مُعلّمته

401
00:20:57,440 --> 00:20:58,600
هذا صحيح

402
00:20:58,600 --> 00:21:00,560
ائتمنتنا ليديا عليه

403
00:21:01,170 --> 00:21:06,080
الفتى ذو الـ 12 سنة الّذي
رأى الجحيم في الأرض

404
00:21:06,080 --> 00:21:08,450
هل لي أن أطرح سؤالاً؟

405
00:21:08,450 --> 00:21:09,330
تفضّلي

406
00:21:09,540 --> 00:21:11,160
...مُعلّمة راي

407
00:21:11,160 --> 00:21:13,580
لماذا طلبتْ ليديا منكِ؟

408
00:21:13,580 --> 00:21:16,660
قالت ذلك أمام شخص لم يعرف
،سِوى الحرب مثلها

409
00:21:16,660 --> 00:21:19,370
أنّ راي لن يجد السّعادة أبداً

410
00:21:19,370 --> 00:21:22,600
قالت بأنّها أرادت أن تدعه يعيش حياة

411
00:21:22,600 --> 00:21:25,240
مُلائمة لسنّه بعيداً عن كلّ الحروب

412
00:21:25,740 --> 00:21:27,540
هل يمكنني أن أطلب منكما فعل هذا؟

413
00:21:27,840 --> 00:21:32,540
أنتما الوحيدان اللّذان أستطيع
ائتمانهما على راي

414
00:21:32,840 --> 00:21:34,010
فهمت

415
00:21:34,010 --> 00:21:35,470
يمكنكِ ترك الأمر لي

416
00:21:35,470 --> 00:21:36,400
أجل

417
00:21:36,400 --> 00:21:38,610
لا ضير من امتلاك ابن

418
00:21:39,840 --> 00:21:41,040
شكراً لكما

419
00:21:42,910 --> 00:21:45,990
راي محبوب حقّاً

420
00:21:45,990 --> 00:21:47,450
إنّه ابن صالح، صحيح؟

421
00:21:47,450 --> 00:21:48,950
أجل، صالح جدّاً

422
00:21:48,950 --> 00:21:50,230
أنتِ هنا

423
00:21:50,860 --> 00:21:52,330
أجل

424
00:21:52,330 --> 00:21:54,360
سيكون غداً أصعب من اليوم

425
00:21:54,790 --> 00:21:56,760
ينبغي أن تذهبي وتنالي قسطاً من الرّاحة

426
00:21:56,760 --> 00:21:58,250
حسناً

427
00:21:58,250 --> 00:22:00,620
السّهر ليس جيّداً لبشرتكِ يا أمّي

428
00:22:00,620 --> 00:22:02,480
أجل، شكراً لك

429
00:22:05,130 --> 00:22:06,310
!كيوبيد

430
00:22:08,590 --> 00:22:11,430
لديّ المزيد لأخبركِ به

431
00:22:11,760 --> 00:22:14,640
ماذا؟ ماذا؟

432
00:22:14,640 --> 00:22:16,660
سوف تنفصلين عن مُنافساتكِ

433
00:22:16,660 --> 00:22:17,640
!ماذا؟

434
00:22:18,690 --> 00:22:21,670
أنا أشجّعكِ

435
00:22:28,260 --> 00:22:31,620
آرياني! أراكِ غداً

436
00:22:35,630 --> 00:22:38,420
هل قالَتْ مُنافِسات؟

437
00:22:38,660 --> 00:22:42,410
لكن لماذا قلبي ينبض بسرعة؟

438
00:22:42,800 --> 00:22:46,560
!ما الّذي يجري هنا؟

439
00:22:46,560 --> 00:22:47,840
آرياني؟

440
00:23:48,780 --> 00:23:50,470
!أنا المُعلّم وايت بلاك

441
00:23:48,790 --> 00:23:55,370
~ الحلقة القادمة ~

442
00:23:48,790 --> 00:23:55,370
~ الحلقة القادمة ~

443
00:23:50,470 --> 00:23:52,100
!أنا الأخت وايت غراي

444
00:23:52,100 --> 00:23:53,670
أنا آرياني

445
00:23:53,670 --> 00:23:55,360
هذه مُقتطفات من الحلقة القادمة

446
00:23:55,370 --> 00:23:57,120
!هذه هي الخطوة الأولى تجاه يوم جديد

447
00:23:56,560 --> 00:23:57,600
!حارِسة

448
00:23:57,120 --> 00:23:58,920
!تألّقي واستحوذي على ذلك النّصر

449
00:23:58,300 --> 00:23:59,390
!حارِسة

450
00:23:58,920 --> 00:24:00,540
!المُنافسات لا يملكنَ فُرصة

451
00:24:00,150 --> 00:24:00,850
!حارِسة

452
00:24:00,540 --> 00:24:01,070
!أتسمعان؟

453
00:24:01,070 --> 00:24:01,960
!هذا هو وقت النّهوض

454
00:24:01,960 --> 00:24:02,620
!حارِسة

455
00:24:02,620 --> 00:24:03,090
في الحلقة القادمة من

456
00:24:03,090 --> 00:24:05,340
!ساحر نصل الجليد سيحكم العالم

457
00:24:05,330 --> 00:24:09,210
ساحر نصل الجليد
سيحكم العالم

458
00:24:05,340 --> 00:24:06,530
!الثّانية

459
00:24:07,190 --> 00:24:09,220
!التّرابُط معاً للمرّة الثّالثة

460
00:24:09,210 --> 00:24:14,930
الحلقة 3
الفتى الّذي يُعدّ السّاحر الأقوى في العالم
يستمرّ في الفوز مع فريقه

461
00:24:09,220 --> 00:24:11,520
...الفتى الّذي يُعدّ السّاحر الأقوى في العالم"

