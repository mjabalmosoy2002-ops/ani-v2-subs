1
00:01:33,280 --> 00:01:35,700
!بالدر

2
00:01:36,000 --> 00:01:38,810
!أجبني يا بالدر

3
00:02:05,900 --> 00:02:07,820
هل بال-بال بخير؟

4
00:02:08,140 --> 00:02:10,970
...قال لوكي لوكي بأنَّهُ ليسَ خطيرًا، ولكن

5
00:02:11,870 --> 00:02:14,290
.ربَّما كانَ مُنهكًا بسبب المسرحيّة

6
00:02:14,290 --> 00:02:15,690
.ربَّما

7
00:02:16,090 --> 00:02:19,660
لقد انهارَ أثناء سوق عيد الميلاد، أليسَ كذلك؟

8
00:02:20,700 --> 00:02:23,230
.أتمنّى أن يتعافى بسرعة

9
00:02:26,160 --> 00:02:30,000
...عندما تصبح مشاعر بالدر غير مستقرّة

10
00:02:30,410 --> 00:02:31,990
.فإنَّهُ يصبح خارجَ السيطرة

11
00:02:31,990 --> 00:02:33,620
.يصبحُ شخصًا آخر

12
00:02:34,110 --> 00:02:37,850
...هيجانُ بالدر لا يؤذي الذينَ حوله فقط

13
00:02:38,920 --> 00:02:41,180
.وإنما يؤذي نفسَهُ أيضًا

14
00:02:45,490 --> 00:02:47,380
هل أنتِ بخير يا جنيّة-سان؟

15
00:02:48,400 --> 00:02:49,380
كوساناغي؟

16
00:02:49,890 --> 00:02:52,260
!سأذهبُ لرؤيته

17
00:02:53,320 --> 00:02:54,270
...مـ...مهلًا

18
00:02:59,540 --> 00:03:01,800
!ملًا يا جنيّة-سان

19
00:03:02,890 --> 00:03:04,270
...أبولون-سان

20
00:03:05,070 --> 00:03:06,510
.سأذهبُ معكِ

21
00:03:06,820 --> 00:03:08,180
حقًّا يا أبولون-سان؟

22
00:03:08,180 --> 00:03:08,890
.أجل

23
00:03:09,600 --> 00:03:11,030
.وجلبتُ هذه

24
00:03:11,400 --> 00:03:14,080
...إنَّها له، فهو لم يتناول العشاء بعد

25
00:03:14,440 --> 00:03:16,610
.لذا، لابدَّ وأنَّهُ جائع

26
00:03:16,910 --> 00:03:19,120
!أتمنى أن تعجبه

27
00:03:19,830 --> 00:03:21,040
.هذا صحيح

28
00:03:25,560 --> 00:03:27,250
هل هذا ما تريده حقًّا؟

29
00:03:29,390 --> 00:03:31,000
...لإبقاء الأمور كما هي

30
00:03:31,450 --> 00:03:32,970
...ربَّما علينا إخبار الجميع

31
00:03:32,970 --> 00:03:33,680
وبعدها؟

32
00:03:34,410 --> 00:03:36,470
ما الذي سيتغيَّر بإخبارهم؟

33
00:03:38,040 --> 00:03:39,220
.لا أعرف

34
00:03:39,640 --> 00:03:41,690
تريد إخبارهم، حتّى لو كنتَ لا تعرف؟

35
00:03:42,010 --> 00:03:45,320
...ولكن، هذا أفضل من أن لا يتغيّر شيء

36
00:03:45,760 --> 00:03:46,710
.هذا يكفي

37
00:03:48,340 --> 00:03:49,570
.لقد اكتفيتُ

38
00:03:51,350 --> 00:03:52,320
...سأقومُ

39
00:03:54,010 --> 00:03:55,330
.بقتل بالدر بنفسي

40
00:03:59,080 --> 00:04:00,500
...هيّا

41
00:04:00,500 --> 00:04:03,850
.نكاتكَ الغريبة، جعلتني أسقطُ التفاح

42
00:04:04,550 --> 00:04:05,670
هل سمعتُما؟

43
00:04:06,920 --> 00:04:08,770
ماذا؟ ما هو؟

44
00:04:09,880 --> 00:04:11,930
.عندما قلتُ بأنَّني سأقتلُ بالدر

45
00:04:13,310 --> 00:04:15,430
كـ...كنتَ تمزح، أليسَ كذلك؟

46
00:04:18,690 --> 00:04:21,860
لستَ جادًّا بشأنِ قتله، اليسَ كذلك؟

47
00:04:22,750 --> 00:04:23,520
.كنتُ أكذب

48
00:04:23,780 --> 00:04:24,460
ماذا؟

49
00:04:25,200 --> 00:04:27,780
...عندما قلتُ بأنَّ مشاعر بالدر الغير مستقرّة

50
00:04:28,180 --> 00:04:31,260
...تجعلهُ هائجًا، كما لو أنَّهُ شخصٌ آخر

51
00:04:31,260 --> 00:04:32,030
.كنتُ أكذب

52
00:04:32,890 --> 00:04:33,860
...إذن

53
00:04:35,830 --> 00:04:38,230
.حيثما يوجد الضوء، يوجد الظلام

54
00:04:38,680 --> 00:04:39,660
الظلام؟

55
00:04:39,940 --> 00:04:42,710
...الضوء هو الأقوى والأكثر إشراقًا

56
00:04:43,140 --> 00:04:45,790
.الظلامُ هو الأعمق والأكثر سوادًا

57
00:04:46,140 --> 00:04:47,450
...مهلًا يا لوكي-لوكي

58
00:04:47,450 --> 00:04:50,050
ما الذي تتحدث عنه؟

59
00:04:50,550 --> 00:04:51,740
...بالدر

60
00:04:53,640 --> 00:04:56,100
...بالدر هو إله الضوء

61
00:04:56,420 --> 00:04:57,810
.وإله الدمار أيضًا

62
00:04:59,310 --> 00:05:01,910
إله الدمار؟

63
00:05:02,700 --> 00:05:04,300
.الضوء والظلام

64
00:05:04,840 --> 00:05:08,010
.الاثنانِ لا يمكنُ فصلُهما أبدًا

65
00:05:08,540 --> 00:05:11,740
.تعليمه في هذه الأكاديمية سيغيّره

66
00:05:12,400 --> 00:05:14,910
أليسَ هذا ما كنتَ تأملهُ يا زيوس؟

67
00:05:16,950 --> 00:05:21,730
.إله الضوء يحتضنُ كلَّ شيءٍ بحنان بفضل قوّته

68
00:05:22,460 --> 00:05:26,360
...ولكنَّهُ عندما يصبح إله الدمار

69
00:05:26,790 --> 00:05:29,890
...قوَّته تحرقُ كلَّ شيءٍ في العالم

70
00:05:29,890 --> 00:05:31,250
.تُدمِّر كلَّ شيء

71
00:05:31,590 --> 00:05:35,590
تُدمّر...هل تعني أنَّ هذه الحديقة ستختفي؟

72
00:05:35,970 --> 00:05:37,380
.كلا، بل كلّ شيء

73
00:05:37,680 --> 00:05:42,260
...عالمنا وعالمكِ وهذه الحديقة

74
00:05:42,260 --> 00:05:43,850
.كلَّ شيءٍ سيختفي

75
00:05:44,860 --> 00:05:45,980
كلّ شيء؟

76
00:05:51,980 --> 00:05:53,160
...لا يمكن

77
00:05:53,160 --> 00:05:56,220
!لن يفعل بالدر-سان هذا

78
00:05:56,930 --> 00:05:59,490
!لأنَّ بالدر-سان شخصٌ لطيف

79
00:05:59,730 --> 00:06:00,690
.هذا صحيح

80
00:06:01,070 --> 00:06:02,550
.لن يفعل بالدر هذا

81
00:06:02,970 --> 00:06:03,740
ماذا؟

82
00:06:05,440 --> 00:06:08,290
...فعندما تنتشر قوّة إله الدمار

83
00:06:08,630 --> 00:06:11,510
.شخصيّة بالدر كـ إلهٍ للضوء تُكبَت

84
00:06:11,810 --> 00:06:13,750
.إنَّها تنام، في أعماق جسده

85
00:06:15,690 --> 00:06:17,600
...عندما يخسر بالدر شخصيَّتَه

86
00:06:17,900 --> 00:06:21,190
.فإنَّهُ يصبحُ سلاحًا، غرضهُ الوحيد هو الدمار

87
00:06:22,310 --> 00:06:23,610
لقد رأيتِهِ، أليسَ كذلك؟

88
00:06:23,970 --> 00:06:27,110
!عندما خسر بالدر شخصيَّتَه وتعاظمت قوَّته وخرجت عن السيطرة

89
00:06:31,100 --> 00:06:33,250
...أعراض بالدر الأخيرة

90
00:06:33,550 --> 00:06:36,130
.ستصبح أقوى

91
00:06:36,770 --> 00:06:38,380
.أنَّها مسألةُ وقتٍ فقط حاليًا

92
00:06:38,940 --> 00:06:42,360
بغض النظر عن إرادة بالدر؟

93
00:06:42,360 --> 00:06:43,200
.أجل

94
00:06:43,530 --> 00:06:45,830
...إذن بال-بال لا

95
00:06:46,880 --> 00:06:47,960
.إنَّهُ لا يعلم بالطبع

96
00:06:48,580 --> 00:06:51,400
ألا توجد...ألا توجد طريقةٌ ما؟

97
00:06:52,190 --> 00:06:54,630
!لمنع تحوّل بالدر-سان إلى إله الدمار؟

98
00:06:55,170 --> 00:06:58,730
...إذا تمكَّنَ بالدر من فهم قلوب البشر

99
00:06:58,730 --> 00:07:01,380
.يُفترضُ أنَّهُ سيقدِر على كبتِ إله الدمار

100
00:07:01,960 --> 00:07:06,200
.ذلك سبب جلبي له لهذا العالم

101
00:07:07,110 --> 00:07:09,650
.لكنَّ هذا لم يتحقق

102
00:07:12,140 --> 00:07:14,650
...إذن، فالطريقة المتبقية

103
00:07:15,110 --> 00:07:17,400
.الوحيدة...هي قتله

104
00:07:19,030 --> 00:07:20,630
...لكنَّ هذا مستحيل

105
00:07:20,980 --> 00:07:23,700
لأنَّ بال-بال خالد، أليسَ كذلك؟

106
00:07:24,280 --> 00:07:27,410
.ولا يمكنُ لأحدٍ إيذاؤه

107
00:07:27,860 --> 00:07:28,740
...كلا

108
00:07:30,020 --> 00:07:33,090
.خلودُ بالدر كان أمرًا طارئًا

109
00:07:34,310 --> 00:07:38,060
...جعلَت أم بالدر كلّ الأشياء في الخليقة تتعهّد

110
00:07:38,060 --> 00:07:40,040
.بأن لا تؤذي ولدها الحبيب

111
00:07:40,450 --> 00:07:41,440
...ولكن

112
00:07:42,010 --> 00:07:44,220
...الهدال، عندما كانَ صغيراَ

113
00:07:44,220 --> 00:07:46,390
.هربَ من هذا العهد

114
00:07:50,140 --> 00:07:51,190
...هل هذا

115
00:07:51,490 --> 00:07:53,370
...خنجر الهدال هذا

116
00:07:53,780 --> 00:07:56,880
.هو النَّصل الوحيد الذي يمكنُهُ اختراق قلب بالدر

117
00:07:57,940 --> 00:08:01,250
...قبلَ أن يخسر بالدر شخصيّته ويدمّر العالم

118
00:08:01,710 --> 00:08:04,200
.سأُنهي حياة بالدر بيديّ

119
00:08:04,450 --> 00:08:05,450
...كلا

120
00:08:05,450 --> 00:08:07,190
!لا يمكنُكَ فعل ذلك

121
00:08:07,680 --> 00:08:10,710
...بالدر-سان هو أعز أصدقا

122
00:08:10,710 --> 00:08:11,720
!إنَّهُ أعزّ شيءٍ لي

123
00:08:13,560 --> 00:08:15,000
...ولأنَّهُ أعزّ ما لديّ

124
00:08:16,110 --> 00:08:19,220
.لا يمكنُني أن أدعه أن يقومَ بشيءٍ لا يريده

125
00:08:20,060 --> 00:08:21,630
لماذا بالدر؟

126
00:08:22,030 --> 00:08:24,070
لماذا؟ لماذا؟

127
00:08:24,370 --> 00:08:25,400
...لوكي-لوكي

128
00:08:26,410 --> 00:08:28,850
...أحبَّ بالدر هذا العالم

129
00:08:29,420 --> 00:08:32,710
!إنَّهُ الإله اللطيف الذي لا يمكنُهُ إيذاء أحد

130
00:08:35,320 --> 00:08:37,670
.لقد أنقذَني بالدر

131
00:08:38,220 --> 00:08:40,490
.والآن، حانَ دوري لإنقاذه

132
00:08:40,490 --> 00:08:41,990
...ولكن...ولكن

133
00:08:43,480 --> 00:08:47,120
!ولأجل إنقاذ بالدر، سأقتل بالدر

134
00:09:06,070 --> 00:09:09,970
ألا يمكنُكَ القيام بشيءٍ لمساعدتهم يا زيوس؟

135
00:09:23,290 --> 00:09:24,520
!ماذا؟

136
00:09:24,820 --> 00:09:27,130
ما يزالُ عليَّ البقاء هنا؟

137
00:09:27,410 --> 00:09:29,760
!لقد تعبتُ من المشفى

138
00:09:29,760 --> 00:09:31,510
.ما باليد حيلة

139
00:09:31,510 --> 00:09:33,920
.الرجّة التي في رأسِكَ لم تُشفى بعد

140
00:09:34,360 --> 00:09:36,380
.خذ...أرنب

141
00:09:37,510 --> 00:09:39,200
.إنَّكَ ماهرٌ جدًا يا لوكي

142
00:09:39,200 --> 00:09:40,100
.حسنًا، أجل

143
00:09:41,030 --> 00:09:42,890
.لطالما كنتَ كذلك

144
00:09:43,450 --> 00:09:47,980
.دائمًا تسلّيني بالقيامِ بأشياء تفاجئني

145
00:09:50,020 --> 00:09:51,370
.لقد أتينا

146
00:09:52,230 --> 00:09:53,890
ما الذي تفعلونه هنا جميعًا؟

147
00:09:54,190 --> 00:09:57,280
.أتينا لرؤيتِك يا بالدر هورينغ هورني

148
00:09:57,280 --> 00:09:59,260
لرؤيَتي أنا؟

149
00:09:59,740 --> 00:10:02,370
ومن يكونُ غيرك؟

150
00:10:02,370 --> 00:10:04,620
.خذ، هذا مني ومن أخي

151
00:10:04,840 --> 00:10:06,020
ماذا؟ ماذا؟

152
00:10:06,020 --> 00:10:07,000
.يوجدُ فيه لحم

153
00:10:07,000 --> 00:10:09,380
.خذ هذا! جلبتُ لكَ عنبًا طازجًا

154
00:10:09,380 --> 00:10:10,500
.ستمنحك طاقةً

155
00:10:11,370 --> 00:10:12,680
!شكرًا لك

156
00:10:13,760 --> 00:10:15,270
.وهذا مني

157
00:10:16,550 --> 00:10:18,520
.لا بدَّ وأنَّك مللتَ من الحبس هنا

158
00:10:18,520 --> 00:10:20,760
.يمكنُكَ قضاء الوقت بقراءته

159
00:10:21,200 --> 00:10:23,080
.شكرًا لك...أنا سعيدٌ جدًّا

160
00:10:23,080 --> 00:10:25,190
هل أخبرتماهم؟

161
00:10:25,190 --> 00:10:26,720
.كـ...كلا

162
00:10:27,250 --> 00:10:30,170
.الجميعُ قلقونَ بشأن بال-بال فقط

163
00:10:32,250 --> 00:10:34,040
ما الأمر، أنتم الثلاثة؟

164
00:10:34,870 --> 00:10:37,800
.أنتَ هادئٌ بشكلٍ مخيفٍ اليوم يا أغنا بيليا

165
00:10:38,920 --> 00:10:42,410
أيمكنُ بسبب شعوركَ بالوحدة بدوني؟

166
00:10:42,640 --> 00:10:44,470
!اجل، هذا صحيح

167
00:10:44,470 --> 00:10:47,440
.أنا وحيدٌ بدونِكَ يا بال-بال...وحيدٌ حقًّا

168
00:10:47,920 --> 00:10:50,030
...أشعرُ أنَّني بخير

169
00:10:50,030 --> 00:10:53,080
.لكنَّهم قالوا بأنَّهُ لا يمكنُني حضور الدرس بعد

170
00:10:53,380 --> 00:10:55,040
.عليكَ أن لا تُجهِد نفسك

171
00:10:55,340 --> 00:10:58,010
.هذا صحيح، عليكَ نيل الراحة الآن

172
00:10:59,400 --> 00:11:01,760
...لم يتبقَّ وقتٌ لموعد التخرُّج

173
00:11:02,080 --> 00:11:03,560
.لا حاجةَ للاندفاع

174
00:11:03,860 --> 00:11:06,760
.عليكَ التركيزُ على صحَّتِكَ حاليًا

175
00:11:06,760 --> 00:11:08,570
...بالناسبة! يوي-سان

176
00:11:08,570 --> 00:11:11,580
.لنفكِّر بفعّاليّةٍ يمكنُنا أداؤها قبلَ التخرّج

177
00:11:11,900 --> 00:11:15,470
.سنكتبُ طلبًا وسينظر كاديوسيوس-سينسي فيه

178
00:11:15,800 --> 00:11:17,910
ما رأيُكَ يا آغنا بيليا؟

179
00:11:18,850 --> 00:11:21,450
!هـ...هذا ممتع! هذا ممتعٌ حقًّا

180
00:11:21,450 --> 00:11:22,520
أليسَ كذلك؟

181
00:11:23,360 --> 00:11:25,080
أيَّ نوعٍ من الفعاليّات؟

182
00:11:27,320 --> 00:11:29,780
ما رأيكم بسباق أكل اللحم؟

183
00:11:29,780 --> 00:11:33,670
.أو سباق اللحم أو حفل منافسة أكل اللحم

184
00:11:34,050 --> 00:11:35,840
.هذه كلُّها فعاليّات اللحم

185
00:11:36,160 --> 00:11:39,890
.أنتَ تحبّ اللحم حقًّا يا بالدر هورينغ هورني

186
00:11:39,890 --> 00:11:41,880
.بالمناسبة، إخلاصهُ رائع

187
00:11:41,880 --> 00:11:42,930
.بكل تأكيد

188
00:11:47,010 --> 00:11:49,690
...أريد الالتحاقُ بكم جميعًا بسرعة

189
00:12:14,060 --> 00:12:16,710
...كمثال، إنَّهم استخدموها

190
00:12:17,390 --> 00:12:20,100
.لجمع الأوساخ أو اقتلاع جذور الأعشاب

191
00:12:20,450 --> 00:12:23,260
.إنَّها ذراعٌ خشبيّة ورأسٌ معدنيّ

192
00:12:23,480 --> 00:12:26,270
...يُستَعملُ الخيزرانِ أحيانًا في صُنعها

193
00:12:26,520 --> 00:12:28,620
.إلى هنا ينتهي درس اليوم

194
00:12:36,770 --> 00:12:38,960
!مرحبًا يا جنيّة-سان

195
00:12:39,520 --> 00:12:40,760
...أبولون-سان

196
00:12:41,060 --> 00:12:43,780
.أنا ذاهبةٌ لرؤية بالدر-سان

197
00:12:45,190 --> 00:12:47,790
هل أنتَ ذاهبٌ لرؤية بالدر-سان يا أبولون-سان؟

198
00:12:48,560 --> 00:12:51,860
...في هذه الحالة، لندعُ الجميع

199
00:12:59,540 --> 00:13:02,930
...أبولون-سان، أنا...أنا

200
00:13:03,280 --> 00:13:07,060
.لا أفهم أيَّ شيءٍ بخصوص لوكي-سان وبالدر-سان

201
00:13:07,550 --> 00:13:11,910
...عليكَ قتل الشخص الذي تحبّهُ لحمايته

202
00:13:12,440 --> 00:13:14,260
...لو بذلتُ جهدًا أكبر

203
00:13:14,570 --> 00:13:18,570
...لو أنَّني علَّمتُ بالدر-سان فهم قلوب البشر بسرعة

204
00:13:20,260 --> 00:13:22,570
.لا تقلقي يا جنيّة-سان

205
00:13:23,590 --> 00:13:26,230
.لن ندعَ بال-بال يدمّر العالم

206
00:13:26,860 --> 00:13:29,570
.ولن ندع لوكي-لوكي يقتل صديقه

207
00:13:31,410 --> 00:13:34,040
...كلاهما صديقَينا العزيزَينِ

208
00:13:34,340 --> 00:13:36,520
وسنُنقذهما بلا شكّ، أليسَ كذلك؟

209
00:13:37,050 --> 00:13:40,640
هل يمكنُنا فعلها في الوقت المناسب يا أبولون-سان؟

210
00:13:41,340 --> 00:13:45,340
هل يمكنُنا تعليم بالدر-سان كيف يفهَمَ قلوب البشر؟

211
00:13:49,650 --> 00:13:50,600
.تحلَّي بالإيمان

212
00:13:51,900 --> 00:13:53,500
.تحلَّي بالإيمانِ يا جنيّة-سان

213
00:13:54,160 --> 00:13:58,040
...منذ القِدم، والآلهة والبشر

214
00:13:58,040 --> 00:14:00,910
.ارتبطوا خلال إيمانِكم بنا

215
00:14:01,980 --> 00:14:05,610
.إيمانَكُم هو قوَّتنا

216
00:14:06,720 --> 00:14:07,810
...الجميع

217
00:14:08,860 --> 00:14:11,700
.أخبرَنا أبولون بكلّ شيء

218
00:14:11,700 --> 00:14:15,370
لِمَ لم تخبرانا بذلكَ مُبكرًا؟

219
00:14:15,980 --> 00:14:18,160
.تبًّا، لا تُعاملانا كغرباء

220
00:14:18,160 --> 00:14:19,380
.هذا صحيح

221
00:14:23,170 --> 00:14:26,210
!لن نتخلّى عن رفاقنا أبدًا

222
00:14:26,570 --> 00:14:27,730
...لا بأس

223
00:14:27,730 --> 00:14:30,950
!ففي النّهاية، أنا رئيس مجلس الطلاب

224
00:14:35,000 --> 00:14:37,200
...هذا هو الغبي-لون

225
00:14:37,420 --> 00:14:37,960
ماذا؟

226
00:14:37,960 --> 00:14:39,220
الغبي-لون إذن؟

227
00:14:39,220 --> 00:14:40,740
.إنَّهُ الغبي-لون

228
00:14:41,310 --> 00:14:43,150
.إنَّهُ الغبي-لون آغنا بيليا

229
00:14:43,450 --> 00:14:46,580
مـ...مهلًا، لماذا يناديني الجميع هكذا؟

230
00:14:46,580 --> 00:14:48,440
!هذا فظيع! فظيعٌ بالفعل

231
00:14:48,440 --> 00:14:50,280
.كفاكَ صراخًا يا غبيّ-لون

232
00:14:50,580 --> 00:14:52,180
!لقد قلتَها ثانيةً

233
00:14:52,180 --> 00:14:54,660
...اهدأ يا غبيّ-لون

234
00:14:54,950 --> 00:14:56,750
أنتَ أيضًا يا دي-دي؟

235
00:14:56,750 --> 00:14:58,580
!ساعدني يا عمّاه

236
00:14:58,580 --> 00:15:00,230
.حسنًا، سأصيبُكَ بالتعاسة

237
00:15:00,230 --> 00:15:01,450
...لماذا يا ترى

238
00:15:02,110 --> 00:15:04,050
.قلبي مليءٌ بالدفء

239
00:15:05,020 --> 00:15:06,030
...انا متأكدة من أنَّهُ يمكنُنا

240
00:15:06,620 --> 00:15:07,610
!كوساناغي

241
00:15:10,690 --> 00:15:12,390
...في الحقيقة إنَّنا

242
00:15:12,940 --> 00:15:15,140
!لقد اختفى بالدر! ولا أجدُ لوكي أيضًا

243
00:15:15,140 --> 00:15:15,970
ماذا؟

244
00:15:24,030 --> 00:15:25,780
!بالدر-سان

245
00:15:26,120 --> 00:15:27,610
!بالدر

246
00:15:27,610 --> 00:15:28,780
!لوكي-سان

247
00:15:29,050 --> 00:15:30,380
!لوكي

248
00:15:30,680 --> 00:15:32,450
!بالدر هورينغ هورني

249
00:15:32,450 --> 00:15:33,690
!لوكي

250
00:15:33,690 --> 00:15:36,040
تبًّا...أينَ ذهبا؟

251
00:15:36,410 --> 00:15:38,790
بالدر! لوكي! هل أنتما هنا؟

252
00:15:39,140 --> 00:15:42,070
.أتمنَّى أنهما ذهبا للتنزّه فقط

253
00:15:42,070 --> 00:15:42,790
.أجل

254
00:15:43,140 --> 00:15:45,800
!بالدر! لوكي

255
00:15:46,090 --> 00:15:47,010
...تبًّا

256
00:15:48,020 --> 00:15:50,630
!بسرعة...علينا إيجادهما بسرعة

257
00:15:56,420 --> 00:15:59,210
أخبرني يا لوكي، أينَ سنذهب؟

258
00:15:59,860 --> 00:16:02,170
ألا يمكنُكَ إخباري بعد؟

259
00:16:02,170 --> 00:16:05,440
.كلا، فأنا أحتفظُ بالمفاجئة حتى النهاية

260
00:16:05,660 --> 00:16:08,700
.كان علينا جلب ثور معنا

261
00:16:09,150 --> 00:16:10,230
...لقد قال ثور

262
00:16:10,750 --> 00:16:12,700
.بأنَّ عليه مساعدة المعلّم

263
00:16:12,940 --> 00:16:15,790
.هكذا إذن، علينا في المرة القادمة أن نأتي جميعنا سويّةً

264
00:16:16,200 --> 00:16:18,710
...لا تقف هكذا فجأةً يا لوكي

265
00:16:32,470 --> 00:16:35,270
!مذهل...هذا رائعٌ يا لوكي

266
00:16:35,570 --> 00:16:37,300
.يالجماله

267
00:16:37,650 --> 00:16:40,880
.أردتُ أن أريَكَ هذا المنظر يا بالدر

268
00:16:41,180 --> 00:16:43,450
.شكرًا يا لوكي، إنَّهُ الأفضل

269
00:16:43,740 --> 00:16:44,980
.إنَّهُ جميلٌ جدًا

270
00:16:45,650 --> 00:16:46,570
بالدر؟

271
00:16:47,110 --> 00:16:49,600
!لا تُخِفني

272
00:16:49,920 --> 00:16:50,830
.هيّا

273
00:16:57,780 --> 00:16:59,180
ما المُضحِك؟

274
00:17:00,470 --> 00:17:02,940
.لقد تذكَّرتُ الماضي فقط

275
00:17:02,940 --> 00:17:03,500
ماذا؟

276
00:17:06,500 --> 00:17:08,600
!سنكونُ معًا إلى الأبد

277
00:17:09,100 --> 00:17:10,270
.إنَّهُ وعد

278
00:17:12,030 --> 00:17:15,890
لماذا أنتَ مُثخَنٌ بالجراح يا لوكي؟

279
00:17:16,380 --> 00:17:17,470
...قلتُ لك

280
00:17:17,750 --> 00:17:19,450
.سنكونُ معًا إلى الأبد

281
00:17:22,070 --> 00:17:24,170
...ما أفكّرُ فيه الآن

282
00:17:24,590 --> 00:17:27,150
.منذ ذلك الحين وأنتَ تقومُ بإنقاذي

283
00:17:29,040 --> 00:17:30,570
.الأمر نفسه الآن

284
00:17:32,180 --> 00:17:35,520
.أعرفُ بأنَّكَ تحاولُ حمايتي

285
00:17:35,910 --> 00:17:37,880
أليسَ كذلك يا لوكي؟

286
00:18:08,960 --> 00:18:09,780
!لوكي

287
00:18:11,930 --> 00:18:12,930
!انتظر يا لوكي

288
00:18:12,930 --> 00:18:14,220
!لا توقفهُ يا ثور

289
00:18:17,250 --> 00:18:20,200
.لا بأس يا ثور

290
00:18:21,550 --> 00:18:23,830
...لا يمكن يا بالدر، أنت

291
00:18:37,970 --> 00:18:39,070
.أدركتُ الأمر

292
00:18:40,370 --> 00:18:43,210
...ما يحاول الجميع حمايَتي منه

293
00:18:43,790 --> 00:18:46,480
...الذي أفقدُ بسببه ذكرياتي

294
00:18:47,290 --> 00:18:50,670
.والسبب الذي ينتهي بـ لوكي مثخنًا بالجراح في كلّ مرةٍ فعلتُها

295
00:18:51,920 --> 00:18:53,470
.أنا آسف يا لوكي

296
00:18:54,680 --> 00:18:56,740
!لماذا تعتذر؟

297
00:18:57,410 --> 00:18:58,910
...أنا آسفٌ يا لوكي

298
00:18:58,910 --> 00:19:00,240
!ولكن لماذا؟

299
00:19:02,960 --> 00:19:04,000
.شكرًا لك

300
00:19:05,220 --> 00:19:07,100
لماذا؟ لماذا؟

301
00:19:07,100 --> 00:19:08,820
!عليكَ أن تلعنَني يا بالدر

302
00:19:09,450 --> 00:19:11,420
.لم استطِع إنقاذكَ حتّى

303
00:19:12,610 --> 00:19:15,630
...حاولتُ إنهاء معاناتكَ بأسهلِ طريقةٍ ممكنة

304
00:19:15,960 --> 00:19:19,210
!انعتني بأنَّني ظالم! وجبان

305
00:19:20,740 --> 00:19:23,140
...إذا لم تفعل، فإنَّني...فإنَّني

306
00:19:23,550 --> 00:19:26,180
هل هذا سيُنهي معاناتكَ يا لوكي؟

307
00:19:27,440 --> 00:19:29,040
.أنتَ جبانٌ يا لوكي

308
00:19:29,390 --> 00:19:31,410
...أنتَ ظالم

309
00:19:31,940 --> 00:19:33,160
.أنتَ كذلك دائمًا

310
00:19:33,980 --> 00:19:36,270
...تحمِلُ كلَّ شيءٍ على عاتقك

311
00:19:36,270 --> 00:19:39,160
.ولم تدعْني أحملُ أيَّ عبء

312
00:19:39,160 --> 00:19:41,930
...أردتُ تشارك

313
00:19:42,230 --> 00:19:44,020
.المعاناة معك

314
00:19:45,170 --> 00:19:46,160
لماذا؟

315
00:19:47,080 --> 00:19:49,850
.لأنَّنا أصدقاء

316
00:19:51,920 --> 00:19:55,200
...دائمًا، أنا الشخص الذي يتم إنقاذهُ من قبلك

317
00:19:55,800 --> 00:19:59,680
!لكنَّني لا أستطيعُ إنقاذ حياتك

318
00:20:00,000 --> 00:20:00,830
...لوكي

319
00:20:02,460 --> 00:20:04,680
!كلا، هذا خطأ! ليس هذا هو الأمر

320
00:20:05,910 --> 00:20:07,980
...اعتقدتُ يأنَّني لن أتردد

321
00:20:08,280 --> 00:20:12,190
.اعتقدتُ بأنَّهُ يمكنُني فعل أيَّ شيءٍ لحمايتك

322
00:20:12,450 --> 00:20:16,250
...منذ قدومنا لهذه الأكاديمية، لماذا عليَّ أن

323
00:20:17,480 --> 00:20:19,450
...لم يعُد هنالك وقت

324
00:20:20,330 --> 00:20:21,790
!ولكن لديَّ أمل

325
00:20:22,900 --> 00:20:23,840
...أرجو

326
00:20:24,400 --> 00:20:27,200
...أن تتمكنَ كوساناغي والآخرينَ من القيامِ بشيءٍ ما

327
00:20:27,970 --> 00:20:30,560
!قد يكونُ هنالك طريقةٌ أخرى

328
00:20:31,170 --> 00:20:32,020
...لوكي

329
00:20:33,660 --> 00:20:34,710
...لا أستطيع

330
00:20:38,710 --> 00:20:40,680
.لا أستطيعُ ذلك حقًّا

331
00:20:45,320 --> 00:20:47,980
.لستَ مُخطئًا يا لوكي

332
00:20:57,810 --> 00:20:58,790
...أغلالُنا

333
00:21:00,380 --> 00:21:01,420
.هذا جيّد

334
00:21:01,740 --> 00:21:02,480
ماذا؟

335
00:21:06,300 --> 00:21:09,930
بهذا، لا يوجَدُ لديكما شيءٌ للندم عليه؟

336
00:21:10,930 --> 00:21:12,000
...بالدر

337
00:21:12,840 --> 00:21:16,430
.أنا آسفٌ لجعلك تتحمل كلَّ الأعباءِ على عاتقكَ يا لوكي

338
00:21:17,730 --> 00:21:19,280
...شكرًا لكَ يا ثور

339
00:21:19,840 --> 00:21:22,510
.لمراقبتِكَ لنا دائمًا

340
00:21:23,060 --> 00:21:25,380
ما الذي تفعلهُ يا بالدر؟

341
00:21:25,700 --> 00:21:29,020
.هل نسيت؟ ليسَ الهدال فقط

342
00:21:29,390 --> 00:21:32,050
...هنالكَ شيءٌ آخر

343
00:21:32,450 --> 00:21:34,770
.يمكنُهُ إيذائي

344
00:21:35,950 --> 00:21:36,840
...لا يمكنُ أنَّكَ

345
00:21:37,260 --> 00:21:38,780
!لا تفعل ذلك يا بالدر

346
00:21:39,580 --> 00:21:40,780
.شكرًا لكما

347
00:21:44,370 --> 00:21:45,510
.أحبكما

348
00:21:51,980 --> 00:21:53,340
!بالدر

349
00:23:24,970 --> 00:23:39,360
ملعب الآلهة

350
00:23:27,530 --> 00:23:28,520
ماذا؟

351
00:23:31,140 --> 00:23:31,970
.أنتِ

352
00:23:34,590 --> 00:23:36,540
.هيّا، سألعبُ معكِ