1
00:01:31,200 --> 00:01:33,490
ما هو شعوركِ نحوي؟

2
00:01:34,740 --> 00:01:35,740
...في هذه الحالة

3
00:01:37,240 --> 00:01:39,740
.سأجعل الأمر حتى تنظرينَ لي فقط

4
00:01:44,940 --> 00:01:45,980
لماذا؟

5
00:01:47,000 --> 00:01:48,600
لماذا يا بالدر؟

6
00:01:49,540 --> 00:01:51,420
!انظر إليَّ فقط يا بالدر

7
00:01:52,170 --> 00:01:53,170
...إنَّكَ

8
00:01:54,030 --> 00:01:55,630
!أنتَ مُلكي أنا

9
00:02:09,420 --> 00:02:11,380
!يكفي هذا يا لوكي

10
00:02:11,880 --> 00:02:13,820
لماذا تستمر بالوقوف في طريقي؟

11
00:02:17,390 --> 00:02:19,200
...توقَّف عن ذلك يا بالدر

12
00:02:19,560 --> 00:02:21,660
...اتركني وشأني فقط

13
00:02:21,660 --> 00:02:23,490
!توقَّف عن جعلي أعاني

14
00:02:28,130 --> 00:02:29,070
.اذهبي

15
00:02:29,070 --> 00:02:29,850
...ولكن

16
00:02:29,850 --> 00:02:31,480
!قُلتُ لكِ أن تذهبي

17
00:02:40,510 --> 00:02:42,640
لماذا أنتِ سارحةٌ هكذا؟

18
00:02:42,640 --> 00:02:45,580
.تعبير الكئابة هذا سيطردُ زبائننا

19
00:02:45,880 --> 00:02:47,340
.كوني أكثرَ نشاطًا

20
00:02:47,340 --> 00:02:48,630
...حـ...حاضر

21
00:02:48,630 --> 00:02:49,840
!مرحبًا بكم! مرحبًا بكم

22
00:02:49,840 --> 00:02:51,860
!لدينا حساء الفاصولياء الحمراء اللذيذ

23
00:02:52,530 --> 00:02:54,080
.هيّا أنتِ أيضًا

24
00:02:54,680 --> 00:02:55,390
.حاضر

25
00:02:55,710 --> 00:02:58,150
.توتسوكا تاكيرو، لديكَ زبون

26
00:02:59,940 --> 00:03:01,240
...أنت، يا هذا

27
00:03:01,540 --> 00:03:03,490
.سآخذُ كلَّ ما لديكَ من حساء

28
00:03:04,110 --> 00:03:05,760
...الكثير من القطع النقديّة

29
00:03:06,220 --> 00:03:09,540
كلّ طالبٍ استلَمَ عشرة قطع نقديّة فقط، لماذا لديكَ الكثير منها؟

30
00:03:10,780 --> 00:03:12,400
أتسألينَ لماذا؟

31
00:03:16,610 --> 00:03:21,720
.لقد ربحتُها بالعمل جاهدًا في كشكي

32
00:03:22,580 --> 00:03:25,530
.ليسَ لديكِ الحقّ في التشكّي

33
00:03:25,530 --> 00:03:27,220
...حـ...حاضر

34
00:03:28,170 --> 00:03:29,830
.عليَّ العودة إلى كشكي

35
00:03:30,130 --> 00:03:31,540
!أسرعوا بتجهيز الحساء

36
00:03:31,540 --> 00:03:32,770
.حـ...حاضر

37
00:03:34,240 --> 00:03:35,270
.سأعودُ ثانيةً

38
00:03:35,590 --> 00:03:37,330
.جهِّزوا كمّية أخرى

39
00:03:38,130 --> 00:03:39,710
سيأكل أكثر؟

40
00:03:40,010 --> 00:03:41,330
.ياللكارثة

41
00:03:43,780 --> 00:03:45,080
هل هنالك شيءٌ ترغبُ به؟

42
00:03:43,780 --> 00:03:45,950
.حسنًا لقد فهمت

43
00:03:46,550 --> 00:03:49,470
هلّا تركتموني أتسوَّقُ أيضًا؟

44
00:03:49,890 --> 00:03:52,200
.أخبرني بما تُريد من فضلك، وسأشتريهُ لك

45
00:03:52,200 --> 00:03:53,170
!كلا، أنا سأفعلُ ذلك

46
00:03:53,650 --> 00:03:55,050
.ليس ذلكَ ما قصدتُه

47
00:03:55,530 --> 00:03:58,060
...هنالكَ كشكٌ أريدُ زيارته بنفسي

48
00:03:58,420 --> 00:04:01,180
لذا، هلّا تركتموني أذهب؟

49
00:04:02,910 --> 00:04:03,680
ماذا؟

50
00:04:04,180 --> 00:04:06,580
هذا هو كشك اليابان، أليسَ كذلك؟

51
00:04:06,900 --> 00:04:08,230
.بلا شك

52
00:04:08,610 --> 00:04:09,520
أينَ يوي-سان؟

53
00:04:09,820 --> 00:04:11,560
...يُفترَضُ أنَّها هنا

54
00:04:12,410 --> 00:04:13,370
.ولكنَّها ليست هنا

55
00:04:13,370 --> 00:04:14,210
ماذا؟

56
00:04:14,210 --> 00:04:16,090
أينَ ذهبَت؟

57
00:04:16,090 --> 00:04:18,170
...لا وقتَ للكسل

58
00:04:18,170 --> 00:04:20,700
من سيطبخ الـ موتشي؟

59
00:04:21,700 --> 00:04:24,470
...لا يمكنُني مواجهتهُ الآن

60
00:04:27,670 --> 00:04:28,830
!يالجمالها

61
00:04:29,950 --> 00:04:31,960
أنتَ تبيع الزهور هنا؟

62
00:04:32,850 --> 00:04:34,560
فكرةُ مَن هذه؟

63
00:04:34,560 --> 00:04:37,710
.د...ديونيسوس زرعها في نادي الزراعة

64
00:04:37,940 --> 00:04:41,220
.ماذا؟ أنت من قُمتَ بهذا يا هاديس-سان

65
00:04:41,520 --> 00:04:43,050
.هذا مذهل

66
00:04:43,350 --> 00:04:46,550
.قمتَ بزراعة هذه الأنواع من الأزهار

67
00:04:46,550 --> 00:04:47,710
.أ...أجل

68
00:04:48,320 --> 00:04:52,270
...أردتُ بيعَ نبيذٍ من العنب الذي قمتُ بزراعته

69
00:04:52,270 --> 00:04:54,900
.لكنَّ المُعلّم لم يسمح بذلك

70
00:04:55,350 --> 00:04:56,060
!هيّا! هيّا

71
00:04:56,400 --> 00:04:58,230
.انظري لبضاعتي أيضًا

72
00:04:58,530 --> 00:05:01,320
!إنَّها مذهلة...مذهلةٌ جدًا

73
00:05:01,980 --> 00:05:04,320
ما الذي تبيعهُ يا أبولون-سان؟

74
00:05:07,960 --> 00:05:09,440
.أنَّها أعظمُ أعمالي

75
00:05:09,890 --> 00:05:11,860
!سانتا كلوز بحجمٍ كبير

76
00:05:12,160 --> 00:05:13,620
...ياللغباء

77
00:05:13,620 --> 00:05:15,420
.من المُحال أن تُباعَ هذه

78
00:05:15,710 --> 00:05:17,880
.إنَّها واقعيّةُ جدًا ومخيفة

79
00:05:18,180 --> 00:05:20,800
.تبدو وكأنَّها لطرد الأرواح الشريرة

80
00:05:21,060 --> 00:05:23,800
.إنَّها ليست مجرّد تحفة فنيّة فقط

81
00:05:23,800 --> 00:05:26,300
!إنَّها شموعٌ أيضًا، لذا فهي مفيدةٌ جدًا عمليًّا

82
00:05:26,560 --> 00:05:29,010
هـ...هذه شموع؟

83
00:05:29,260 --> 00:05:32,520
!عندما تشعلينَ الفتيلة التي على رؤوسَهم، سيضيئون

84
00:05:33,540 --> 00:05:34,270
انظري؟

85
00:05:35,490 --> 00:05:36,980
.لديَّ غزالٌ أيضًا

86
00:05:41,360 --> 00:05:43,740
!هذا ليسَ فنًّا بل رعبًا

87
00:05:44,530 --> 00:05:46,530
.أحسنتَ بالمجيء هنا

88
00:05:46,850 --> 00:05:47,780
.أعطِني نقودك

89
00:05:48,310 --> 00:05:50,810
.يمكنُكَ أخذ هذه، إنَّها دمية خاصّة

90
00:05:50,810 --> 00:05:52,580
.حملُها معك سيجلبُ لك الثروة

91
00:05:52,870 --> 00:05:54,970
.إذا فهمتَ فأعطِني نقودك

92
00:05:55,320 --> 00:05:57,420
.سأعطيها لكَ مقابلَ خمس قطعٍ نقديّة

93
00:05:57,690 --> 00:05:59,630
...ولكن، هنالكَ شيءٌ آخر أريدُ

94
00:06:00,120 --> 00:06:03,080
هل تنوي معارضتي؟

95
00:06:03,730 --> 00:06:06,170
.هذا ليسَ بالقرار الصائب

96
00:06:06,170 --> 00:06:09,100
.بـ...بالتأكيد ليس كذلك، سأدفع

97
00:06:09,100 --> 00:06:10,600
.يالكَ من ولدٍ طيّب

98
00:06:11,040 --> 00:06:12,640
.يالها من طريقةُ بيعٍ مرعبة

99
00:06:13,980 --> 00:06:15,760
.وكأنَّكِ تريدينَ قولَ شيءٍ ما

100
00:06:16,110 --> 00:06:17,340
.انظري جيّدًا

101
00:06:17,340 --> 00:06:20,150
.كما قلتُ لكِ، إنَّني أعملُ جاهدًا لكسب المال

102
00:06:20,150 --> 00:06:23,130
...عليكَ أن لا تجعل زبائنكَ يتصببونَ عرقًا

103
00:06:23,750 --> 00:06:25,610
ما هذه الدمى؟

104
00:06:26,130 --> 00:06:27,100
.إنَّها مومياء

105
00:06:27,100 --> 00:06:29,870
...مومياء؟ هذا يعني أنَّ بداخلها

106
00:06:30,170 --> 00:06:31,240
.لا أعرف

107
00:06:31,240 --> 00:06:32,120
ماذا؟

108
00:06:32,480 --> 00:06:34,940
.المومياءات المصريّة مصنوعةٌ بإتقان

109
00:06:34,940 --> 00:06:37,580
.حتّى المُقلَّدة تستحق امتلاكها

110
00:06:38,120 --> 00:06:39,740
...إذن فهي ليست حقيقيّة

111
00:06:40,040 --> 00:06:41,710
!إن لم تكوني ستشترين فغادري

112
00:06:41,710 --> 00:06:43,040
.إنَّكِ تُقاطعين عملي

113
00:06:43,340 --> 00:06:47,340
.أريدُ كسبَ الكثير من النقود، لأتمكَّنَ من شراء حساء الفاصولياء الحمراء

114
00:06:53,770 --> 00:06:54,710
...يوي-سان

115
00:06:55,250 --> 00:06:57,450
أينَ ذهبتِ يا يوي-سان؟

116
00:06:58,210 --> 00:07:01,150
!تعالَوا هنا، تعالَوا جميعًا

117
00:07:01,150 --> 00:07:02,690
!إنَّها رخيصة...رخيصة

118
00:07:05,530 --> 00:07:08,680
.إنَّها رخيصة، تجمَّعوا

119
00:07:08,680 --> 00:07:11,960
ألا يمكنُكَ النداء بصوتٍ مفرح؟

120
00:07:11,960 --> 00:07:14,160
.أنتَ تطرد الزبائن هكذا

121
00:07:16,310 --> 00:07:17,200
.لا يمكنُني ذلك

122
00:07:17,200 --> 00:07:19,540
...الخبرةُ هي كلّ شيء

123
00:07:19,810 --> 00:07:21,420
!هيّا، قاتل، قاتل

124
00:07:21,720 --> 00:07:23,340
.هذا لا يناسبني

125
00:07:23,640 --> 00:07:25,090
!قم بذلك فقط

126
00:07:25,340 --> 00:07:27,970
.استجمع شجاعتك ونادِ على بعض الزبائن

127
00:07:29,790 --> 00:07:32,080
!هل أنتَ مستعد! ثلاثة، إثنان، واحد

128
00:07:32,530 --> 00:07:33,330
.أنتِ

129
00:07:38,630 --> 00:07:40,600
ما الذي تفعلينَهُ هنا؟

130
00:07:40,600 --> 00:07:43,300
.ما الذي أفعلُهُ؟ أنتَ من ناداني

131
00:07:43,300 --> 00:07:44,990
لِمَ ناديتَها هنا؟

132
00:07:45,350 --> 00:07:46,860
.أخبرتَني بمناداة بعض الزبائن

133
00:07:47,380 --> 00:07:49,060
...أجل، ولكن

134
00:07:49,570 --> 00:07:52,040
!حتى أنَّ مناداة الزبائن لا تكون هكذا

135
00:07:52,680 --> 00:07:54,130
.هذا لا يناسبُني بالفعل

136
00:07:55,370 --> 00:07:56,430
...كوساناغي

137
00:07:57,010 --> 00:07:57,950
.قومي بذلك بدلًا عنّي

138
00:07:57,950 --> 00:07:58,720
ماذا؟

139
00:07:59,110 --> 00:08:00,510
.سأتركُ باقي الأمر عليكِ

140
00:08:01,460 --> 00:08:03,190
إلى أينَ ستذهب يا ثور؟

141
00:08:03,190 --> 00:08:04,840
!عُد إلى هنا

142
00:08:06,780 --> 00:08:08,210
.هذا خطؤكِ

143
00:08:12,210 --> 00:08:13,640
لِمَ أنتِ هنا؟

144
00:08:13,940 --> 00:08:16,160
.طلبَ منّي ثور-سان البقاء هنا

145
00:08:16,560 --> 00:08:19,040
.ليسَ من الواجبِ عليكِ الاصغاء له

146
00:08:19,390 --> 00:08:21,890
ولكن، أليسَ هذا خطأي؟

147
00:08:22,360 --> 00:08:24,140
...أعلمُ أنَّني قلتُ هذا

148
00:08:25,050 --> 00:08:27,230
ولكن ماذا عن الكشك الخاص بكِ؟

149
00:08:27,530 --> 00:08:29,900
...إنَّهُ فقط

150
00:08:30,720 --> 00:08:31,730
هل أتى هناك؟

151
00:08:33,350 --> 00:08:34,380
.هكذا إذن

152
00:08:35,680 --> 00:08:37,910
هنالكَ سببٌ لكل هذا، صحيح؟

153
00:08:40,370 --> 00:08:42,110
.أخبرني ثور-سان عنه

154
00:08:42,410 --> 00:08:45,200
.أنكم أصدقاء منذ الطفولة

155
00:08:45,600 --> 00:08:49,170
...لا أعلمُ ما عليَّ فعله

156
00:08:49,660 --> 00:08:51,180
...وأنتَ قلت

157
00:08:51,180 --> 00:08:54,360
.سنقومُ بتكوينِ ذكرياتٍ سويةً أيضًا

158
00:08:54,360 --> 00:08:55,300
.لم أقل ذلك

159
00:08:55,710 --> 00:08:56,900
.بل قُلتَ

160
00:08:56,900 --> 00:08:58,580
.لم أقُل ذلك

161
00:08:58,580 --> 00:09:00,090
.سمعتُكَ تقولها

162
00:09:00,090 --> 00:09:01,790
.ربّما سمعتِ شيئًا

163
00:09:03,280 --> 00:09:05,090
.يكفي هذا، اذهبي فقط

164
00:09:05,090 --> 00:09:05,810
...ولكن

165
00:09:06,060 --> 00:09:08,570
.وابقَي بعيدة عن بالدر

166
00:09:08,830 --> 00:09:09,980
...مُحال

167
00:09:11,460 --> 00:09:13,820
...لوكي-سان، لقد قلتَ لـ بالدر-سان

168
00:09:13,820 --> 00:09:16,320
.بأنَّهُ مُلكٌ لك

169
00:09:16,630 --> 00:09:17,910
.لم أقُل ذلك

170
00:09:17,910 --> 00:09:19,360
!سمعتُكَ تقولُها

171
00:09:19,360 --> 00:09:21,230
.أنتِ لا تستسلمين

172
00:09:21,910 --> 00:09:23,550
ماذا تقصد؟

173
00:09:23,900 --> 00:09:26,330
هل يمكنُكَ إخباري عن ذلك؟

174
00:09:26,330 --> 00:09:28,430
.هذا ليسَ من شأنِكِ

175
00:09:28,430 --> 00:09:29,960
!بل هو كذلك

176
00:09:30,430 --> 00:09:34,340
.كلاكما أنتَ وبالدر-سان، زملاء دراستي الغالين

177
00:09:36,630 --> 00:09:37,680
...انتِ

178
00:09:38,870 --> 00:09:40,870
!على أيةِ حال، ابقَي بعيدةً عن بالدر

179
00:09:41,730 --> 00:09:43,650
.هذا كلّ ما يمكنُني قوله

180
00:09:44,180 --> 00:09:45,850
.وإلا ستكونُ هنالك متاعب

181
00:09:46,390 --> 00:09:47,870
متاعب؟

182
00:09:47,870 --> 00:09:50,610
!استمعي...بالدر مهمٌّ بالنسبة لي

183
00:09:51,360 --> 00:09:54,990
.لذلك لن أسمَحَ لكِ بالبقاء بجانب بالدر

184
00:09:55,660 --> 00:09:57,870
.إذا بقيتِ بقربهِ، فسيُصابُ كلاكما بأذى

185
00:09:58,760 --> 00:09:59,870
كلانا؟

186
00:10:00,600 --> 00:10:01,920
.سأقولُها ثانيةً

187
00:10:02,550 --> 00:10:04,020
.ابقَي بعيدةً عن بالدر

188
00:10:04,320 --> 00:10:07,040
...هذا لمصلحتكِ، أرجوكِ صدّقيني

189
00:10:07,340 --> 00:10:09,280
.لا يُغتَفَر

190
00:10:11,000 --> 00:10:11,960
...لوكي

191
00:10:12,460 --> 00:10:15,220
أنتَ تحب يوي-سان يا لوكي، أليسَ كذلك؟

192
00:10:22,770 --> 00:10:25,060
تُحب يوي-سان يا لوكي؟

193
00:10:25,060 --> 00:10:26,160
.هذا غير صحيح

194
00:10:27,270 --> 00:10:29,910
...إنَّكَ تحب يوي-سان يا لوكي

195
00:10:29,910 --> 00:10:31,830
!قلتُ لكَ أنَّ هذا غير صحيح

196
00:10:32,120 --> 00:10:33,310
...لقد رأيتُ

197
00:10:33,640 --> 00:10:34,790
.لقد رأيتُ ذلك

198
00:10:35,080 --> 00:10:36,330
!اصغِ إليّ يا بالدر

199
00:10:36,620 --> 00:10:39,710
.لكن، لن أسمحَ لكَ بالحصول على يوي-سان

200
00:10:43,690 --> 00:10:44,870
!توقَّف يا بالدر

201
00:10:44,870 --> 00:10:45,940
!دعها تذهب

202
00:10:45,940 --> 00:10:48,260
!كلا! لن أدعها تذهب

203
00:10:48,260 --> 00:10:49,690
...تبًّا! هذا

204
00:10:51,600 --> 00:10:54,690
...اللعنة...الفخ الذي نصبتُهُ بين بضائعنا

205
00:10:57,160 --> 00:10:58,150
!مـ...مهلًا

206
00:11:00,870 --> 00:11:02,660
.انتظر من فضلك يا بالدر-سان

207
00:11:03,540 --> 00:11:05,570
لماذا تفعل هذا؟

208
00:11:05,940 --> 00:11:07,200
لماذا؟

209
00:11:07,740 --> 00:11:08,850
وماذا عنكِ؟

210
00:11:09,510 --> 00:11:11,950
!لماذا لا تفهمينَ مشاعري؟

211
00:11:15,250 --> 00:11:18,210
.أعتذِرُ لصراخي

212
00:11:18,910 --> 00:11:19,900
...بالدر-سان

213
00:11:20,200 --> 00:11:22,190
.ولكنَّني أريدكِ أن تفهمي

214
00:11:22,490 --> 00:11:25,220
.أنتِ مُميَّزةٌ بالنسبةِ لي

215
00:11:25,860 --> 00:11:27,050
مُميَّزة؟

216
00:11:27,630 --> 00:11:30,320
.أنا ممتنٌّ للمعجزة التي سمحت بلقائِنا

217
00:11:30,740 --> 00:11:34,160
...كوني إله الضوء، قوَّتي الفطريّة

218
00:11:34,710 --> 00:11:38,510
.تجذب الناس والحيوانات إليّ

219
00:11:39,530 --> 00:11:43,080
.كلّ الأشياء تخافُ من الظلام، وتبحث عن الضوء

220
00:11:44,080 --> 00:11:48,520
.لذلك فهم يتقرَّبونَ منّي ويعظمونَني، كإله الضوء

221
00:11:48,890 --> 00:11:50,740
.ولكنَّكِ كنتِ مختلفة

222
00:11:51,260 --> 00:11:54,750
أنتَ تعني، لأنَّ قوَّتَكَ لم تؤثّر عليّ؟

223
00:11:55,170 --> 00:11:58,040
.أنتِ تحادثينَني بكلّ صدق

224
00:11:58,390 --> 00:12:01,840
...تمدحينَني عندما أكونُ جيّدًا، وتوبخينَني عندما أكونُ سيئًا

225
00:12:01,840 --> 00:12:04,310
...تدعمينَني عندما تتفقينَ معي

226
00:12:04,610 --> 00:12:06,720
.وتعارضينَني عندما يحدث العكس

227
00:12:07,790 --> 00:12:09,760
.لم أُقابل شخصًا مثلكِ أبدًا

228
00:12:10,790 --> 00:12:13,530
.كلا، هنالك شخصٌ آخر

229
00:12:14,010 --> 00:12:16,140
إنَّهُ لوكي-سان؟

230
00:12:16,510 --> 00:12:17,320
...أجل

231
00:12:17,950 --> 00:12:21,520
.ولكن لن أسمحَ حتى لـ لوكي أن يحضى بكِ

232
00:12:22,250 --> 00:12:23,820
!بالدر-سان توقَّف

233
00:12:25,290 --> 00:12:27,650
...أنتِ مُميَّزةٌ بالنسبة لي

234
00:12:28,300 --> 00:12:29,800
ألا تشعرينَ بذلك؟

235
00:12:30,710 --> 00:12:31,490
بالدر-سان؟

236
00:12:32,050 --> 00:12:33,840
...أستطيع أن أقول

237
00:12:34,140 --> 00:12:35,130
!بالدر

238
00:12:35,740 --> 00:12:38,000
!توقَّف...واهدأ يا بالدر

239
00:12:38,000 --> 00:12:39,120
!لوكي-سان

240
00:12:40,700 --> 00:12:42,380
.لن أدعكَ تحضى بها أبدًا

241
00:12:43,020 --> 00:12:44,910
...إذا كانَ عليَّ جعلُها تستسلم

242
00:12:45,470 --> 00:12:46,510
...سأقوم

243
00:12:46,750 --> 00:12:47,710
!توقَّف يا بالدر

244
00:12:48,140 --> 00:12:48,840
بالدر-سان؟

245
00:12:52,250 --> 00:12:52,970
!بالدر-سان

246
00:12:57,530 --> 00:12:59,090
ما الذي يحدث؟

247
00:12:59,390 --> 00:13:00,690
!استيقظ يا بالدر

248
00:13:08,080 --> 00:13:09,560
.سأعالج هذا الأمر

249
00:13:09,890 --> 00:13:10,610
...لوكي-سان

250
00:13:11,850 --> 00:13:14,370
بالدر! هل أنتَ متأكدٌ من هذا؟

251
00:13:14,750 --> 00:13:17,740
!هذا ليس ما تريده

252
00:13:19,510 --> 00:13:20,600
!بالدر

253
00:13:21,270 --> 00:13:21,870
!لوكي-سان

254
00:13:22,320 --> 00:13:23,460
...أليست

255
00:13:24,480 --> 00:13:27,000
أليستْ يوي مميَّزةً بالنسبةِ لك؟

256
00:13:27,600 --> 00:13:29,010
أليستْ مهمّةً لك؟

257
00:13:32,380 --> 00:13:33,010
.توقَّف

258
00:13:36,240 --> 00:13:37,760
.يكفي هذا

259
00:13:38,890 --> 00:13:40,060
...عاهدنا بعضنا

260
00:13:40,820 --> 00:13:41,740
...بأنَّنا

261
00:13:45,410 --> 00:13:47,320
.بأنَّنا سنكونُ سويّةً إلى الأبد

262
00:13:54,870 --> 00:13:56,070
...أنا

263
00:13:57,010 --> 00:13:58,160
.لا تقلق

264
00:13:58,770 --> 00:14:00,370
.كلّ شيءٍ بخير الآن

265
00:14:03,480 --> 00:14:04,470
!لوكي-سان

266
00:14:05,090 --> 00:14:06,790
.إنَّهُ نائمٌ فقط، فهو مُتعَب

267
00:14:08,570 --> 00:14:11,920
.سأثقُ بكِ، وأشرحُ لكِ الأمر

268
00:14:13,430 --> 00:14:14,560
...ولكن بالمقابل

269
00:14:15,140 --> 00:14:18,470
.عليكِ أن لا تُخبري بالدر بما حدثَ هنا أبدًا

270
00:14:19,040 --> 00:14:19,850
هل فهمتِ؟

271
00:14:21,290 --> 00:14:21,970
.أجل

272
00:14:24,480 --> 00:14:26,940
...الجميعُ يحبّون بالدر

273
00:14:27,570 --> 00:14:30,980
.ولكنَّ ذلكَ بسبب انجذابهم لقوّة إله الضوء

274
00:14:31,730 --> 00:14:34,250
.بمعنى آخر، أنَّهم لا يحبّونه حقيقةً

275
00:14:34,750 --> 00:14:36,090
.بل هو حبٌّ مزيَّف

276
00:14:36,520 --> 00:14:40,170
...لذا، فعلى الرغم من أنَّ بالدر محاطٌ بالكثيرين، لكنَّهُ كانَ وحيدًا

277
00:14:41,930 --> 00:14:43,820
...وبقي بالدر هكذا

278
00:14:44,170 --> 00:14:46,800
.إلى أن قابلكِ يا يوي

279
00:14:47,660 --> 00:14:50,250
...البشريّة التي لم تتأثر بقوّة الضوء

280
00:14:50,760 --> 00:14:52,880
...الشخص الذي ملأ وحدته

281
00:14:54,080 --> 00:14:57,870
...عندما تصبح مشاعر بالدر مضطربة

282
00:14:58,400 --> 00:14:59,960
.تكون خارجةٌ عن السيطرة

283
00:14:59,960 --> 00:15:01,770
.يُصبحُ شخصًا آخر

284
00:15:02,420 --> 00:15:04,020
.إذن ذلك ما حدث

285
00:15:06,380 --> 00:15:10,100
...هيجان بالدر لا يؤذي من حوله فقط

286
00:15:11,220 --> 00:15:13,530
.ولكن نفسهُ أيضًا

287
00:15:14,310 --> 00:15:17,460
.إيذاء الآخرين يُحزنُ بالدر كثيرًا

288
00:15:18,750 --> 00:15:22,750
.لذلك السبب حاولتُ فصلكِ عن بالدر

289
00:15:23,540 --> 00:15:25,040
.هذه مسؤوليَّتي

290
00:15:25,340 --> 00:15:27,020
...هكذا إذن

291
00:15:27,320 --> 00:15:31,120
.لحد الآن، بالدر لا يملكُ سواي أنا وثور

292
00:15:32,270 --> 00:15:34,620
...حسنًا، وأنا أيضًا لا أملكُ سوى بالدر وثور

293
00:15:34,920 --> 00:15:36,550
.لذا فنحنُ في نفس المركب

294
00:15:37,880 --> 00:15:41,430
.كنتَ دائمًا تراقب بالدر-سان

295
00:15:43,230 --> 00:15:46,540
.حتى عندما يكونُ مُحاطًا بالآخرين، كانَ وحيدًا

296
00:15:47,200 --> 00:15:49,480
...وكنتَ تراقبهُ دائمًا

297
00:15:49,840 --> 00:15:51,530
.لا بدّ وأنَّ الأمر كانَ صعبًا

298
00:15:51,930 --> 00:15:53,600
.لا بدّ وأنَّهُ أمرٌ مؤلم

299
00:15:54,810 --> 00:15:56,990
...لو يمكنُني فقط تقديم المساعدة أكثر

300
00:15:57,690 --> 00:15:58,770
...لقد فهمت

301
00:16:00,580 --> 00:16:04,080
...ليسَ فقط لأنَّكِ لم تتأثَّري بقوة الضوء

302
00:16:05,310 --> 00:16:09,260
.أعتقدُ بأنَّني عرفتُ سبب انجذاب بالدر نحوكِ

303
00:16:10,250 --> 00:16:11,840
انظروا؟ أليستْ مذهلة؟

304
00:16:12,320 --> 00:16:15,010
!والآن، هذا ما يمكنُكم دعوتُهُ بـ فن الانفجار

305
00:16:15,310 --> 00:16:16,840
ما اسم هذه؟

306
00:16:17,330 --> 00:16:18,940
...إنَّها

307
00:16:19,240 --> 00:16:21,930
.إنَّها تُدعى بـ غراتن البطيخ

308
00:16:21,930 --> 00:16:25,200
.هذا الكتاب يقول بأنَّها تُدعى بـ فوانيس السماء

309
00:16:25,200 --> 00:16:27,310
!أجل، إنَّها تُدعى بذلك أيضًا

310
00:16:27,760 --> 00:16:30,430
...كذلك هي ليست بفوانيس عائمة

311
00:16:31,030 --> 00:16:32,590
.بل هي فوانيس طائرة

312
00:16:33,030 --> 00:16:35,570
لماذا يتم إطلاقها في الهواء؟

313
00:16:35,860 --> 00:16:39,130
...حسنًا، لستُ متأكدًا من ذلك

314
00:16:39,450 --> 00:16:40,610
!لقد فهمت

315
00:16:41,060 --> 00:16:42,770
.لنقم بذلك

316
00:16:43,070 --> 00:16:45,620
.سنوجه امتناننا من خلال اللهب إلى سانتا كلوز

317
00:16:46,360 --> 00:16:48,640
."!قائلين "عيد ميلاد مجيد!" "عيد ميلاد مجيد

318
00:16:48,940 --> 00:16:52,460
.يُقال بأنَّ سانتا كلوز هو الشخص الذي يوزع الهدايا

319
00:16:52,460 --> 00:16:55,130
!أجل، يمكنكَ قول هذا

320
00:16:56,070 --> 00:16:59,400
.لطالما كان بالدر شخصٌ مُميَّزٌ بالنسبة لي أيضًا

321
00:17:00,240 --> 00:17:02,260
.بالدر هو منقذي

322
00:17:02,890 --> 00:17:03,890
منقذك؟

323
00:17:05,540 --> 00:17:08,460
...وبسبب دماء اليوتين، الذين هم نوعٌ من أنواع العمالقة

324
00:17:08,810 --> 00:17:11,610
.المنبوذينَ من قبل الآلهة، تجري في عروقي

325
00:17:13,440 --> 00:17:15,830
.لم يهتمّ أحدٌ بي

326
00:17:16,510 --> 00:17:19,240
.عشتُ في عزلةٍ تامّة

327
00:17:19,950 --> 00:17:23,410
.لم يكن لديَّ أصدقاء ولا أحدَ أتكلَّمُ معه

328
00:17:24,040 --> 00:17:27,630
.كُرِهتُ من قِبل الآلهة الذينَ عاملوني كـ عدوّ، وتمَّ نبذي

329
00:17:28,010 --> 00:17:32,670
.وعندما فكَّرتُ أنَّ ذلك قد يستمرّ إلى الأبد، تجمَّدت دمائي

330
00:17:33,410 --> 00:17:36,590
.وقسى قلبي وكرهتُ كلَّ شيء

331
00:17:37,660 --> 00:17:39,860
.كانَ ذلكَ عندما قابلْتُ بالدر

332
00:17:40,620 --> 00:17:43,000
...بالرغم من مقدار الأذى الذي سببتُهُ له

333
00:17:43,430 --> 00:17:45,580
.لم يتركني أبدًا

334
00:17:46,030 --> 00:17:48,020
...قلبه الصادق

335
00:17:48,350 --> 00:17:52,350
.وحبُّهُ للطيبينَ والسيئين غيَّرَني

336
00:17:53,800 --> 00:17:55,970
...حياتيَ التي مُلأت باليأس

337
00:17:56,250 --> 00:17:58,230
...بدونِ أيّ متعة

338
00:17:58,530 --> 00:18:00,400
.ملأها بالدر بالضوء

339
00:18:00,750 --> 00:18:02,690
!سنكونُ سويّةً للأبد

340
00:18:02,990 --> 00:18:04,050
.هذا وعد

341
00:18:06,560 --> 00:18:10,560
...في يومٍ ما، الآلهة الذين لا يحبّوني

342
00:18:11,040 --> 00:18:13,450
.حاولوا قتلي

343
00:18:14,280 --> 00:18:15,230
...وعندها

344
00:18:20,770 --> 00:18:21,770
.لقد انتهى الأمر

345
00:18:22,190 --> 00:18:23,680
.انتهى كلّ شيء

346
00:18:24,190 --> 00:18:27,100
ما الذي فعلتُه؟

347
00:18:27,100 --> 00:18:28,330
.لا تقلق

348
00:18:28,630 --> 00:18:30,180
.كلّ شيءٍ بخير الآن

349
00:18:30,760 --> 00:18:34,560
لماذا أنتَ مصابٌ بالجراح يا لوكي؟

350
00:18:35,060 --> 00:18:36,130
...لقد قلْتُ لك

351
00:18:36,430 --> 00:18:37,820
.سنكونُ سويّةً للأبد

352
00:18:40,820 --> 00:18:41,550
.أجل

353
00:18:47,130 --> 00:18:49,250
.سمعتُ صوتَكَ يا لوكي

354
00:18:49,930 --> 00:18:51,450
.سنكونُ سويّةً دائمًا

355
00:18:52,170 --> 00:18:53,170
.هذا صحيح

356
00:18:53,540 --> 00:18:56,440
.أعتقدُ أنَّني كنتُ أحلم

357
00:18:57,530 --> 00:18:58,460
.هكذا إذن

358
00:18:59,670 --> 00:19:02,510
كيفَ أصِبْتَ بهذه الجراح؟

359
00:19:03,060 --> 00:19:03,970
...هل يمكنُ

360
00:19:04,790 --> 00:19:07,010
.لقد فشلتُ في أحد مقالبي فقط

361
00:19:07,800 --> 00:19:09,260
.كما تعلَم، إنَّها كالمعتاد

362
00:19:12,280 --> 00:19:15,270
.إذن...فهيَ كالمعتاد

363
00:19:15,850 --> 00:19:16,490
.أجل

364
00:19:17,550 --> 00:19:18,540
أينَ يوي-سان؟

365
00:19:18,840 --> 00:19:22,100
...كنتُ أبحثُ عنها في سوق عيد الميلاد، ثمَّ

366
00:19:23,090 --> 00:19:24,340
ما الذي حدث؟

367
00:19:24,940 --> 00:19:26,550
.ذهبَتْ لتُحضِرَ الماء

368
00:19:27,360 --> 00:19:29,120
.يُفتَرضُ أنَّها على وشك العودة

369
00:19:29,860 --> 00:19:30,780
.حسنًا

370
00:19:32,330 --> 00:19:35,790
لوكي، هل تُحبّ يوي-سان؟

371
00:19:36,490 --> 00:19:38,050
مـ...ما الذي تقوله؟

372
00:19:38,050 --> 00:19:39,150
.أخبرني

373
00:19:41,120 --> 00:19:42,250
.كلا بكلّ تأكيد

374
00:19:44,500 --> 00:19:45,310
.هكذا إذن

375
00:19:50,570 --> 00:19:52,470
.إنَّكما صديقَين مقرَّبَينِ حقًّا

376
00:19:52,940 --> 00:19:53,810
.يوي-سان

377
00:19:55,160 --> 00:19:57,980
.قلتُ لكِ...بالدر مُلكي أنا

378
00:20:01,250 --> 00:20:04,590
.قامَ أبولون-سان بتحضيرِ فقرةٍ خاصّة

379
00:20:04,960 --> 00:20:06,510
هل تودّانِ الذهاب؟

380
00:20:06,970 --> 00:20:07,910
.بالطبع

381
00:20:08,300 --> 00:20:09,490
.سأذهب

382
00:20:10,160 --> 00:20:13,740
!الفقرةُ الكبرى لختام سوقنا تبدأ

383
00:20:14,000 --> 00:20:15,750
هل الجميعُ مستعدون؟

384
00:20:16,520 --> 00:20:17,620
هل أنتم مستعدّون؟

385
00:20:18,080 --> 00:20:19,630
...استعدّوا لـ

386
00:20:40,660 --> 00:20:42,540
!إنَّها رائعة

387
00:20:42,540 --> 00:20:44,770
.أجل، إنَّها جميلةٌ جدًا

388
00:20:45,580 --> 00:20:46,460
...يوي-سان

389
00:20:47,500 --> 00:20:51,450
.أنا ممتنٌّ للمعجزة التي جعلتنا نلتقي

390
00:20:51,990 --> 00:20:54,490
...لكنَّني اندفعتُ قليلًا بالأمور

391
00:20:55,350 --> 00:20:57,550
.ويبدو أنَّني قد تسببتُ بالمتاعب لكِ ولـ لوكي أيضًا

392
00:20:58,340 --> 00:20:59,540
.أنا أعتذرُ حقًّا

393
00:20:59,780 --> 00:21:03,110
...يالكَ من مُتعِب يا بالدر

394
00:21:03,410 --> 00:21:05,930
.ضع نفسَكَ مكاني

395
00:21:05,930 --> 00:21:09,930
.أنا سعيدة، يمكنُنا الآن التخرّج جميعًا كأصدقاء

396
00:21:13,030 --> 00:21:14,930
.أنا غنيٌّ جدًا

397
00:21:17,670 --> 00:21:20,460
.لأنَّ لديَّ شخصَينِ مُميَّزَين

398
00:21:21,150 --> 00:21:23,980
...ربّما عليَّ أن أمسكَ يدكِ أيضًا

399
00:21:23,980 --> 00:21:25,730
لـ...لوكي-سان، أنتَ أيضًا؟

400
00:21:26,140 --> 00:21:27,280
ولِمَ لا؟

401
00:21:31,380 --> 00:21:32,640
...قد تكونينَ

402
00:21:33,190 --> 00:21:35,880
.مُميَّزةٌ بالنسبةِ لي أيضًا

403
00:21:43,050 --> 00:21:43,880
...لوكي

404
00:21:46,860 --> 00:21:48,130
.أعرف ما تريد قوله

405
00:21:49,170 --> 00:21:50,380
.لا تقلق

406
00:21:52,030 --> 00:21:55,570
.سأقتُلُ بالدر بيدَيَّ هاتَين

407
00:21:57,050 --> 00:21:57,760
.أجل

408
00:23:29,970 --> 00:23:39,310
ملعب الآلهة

409
00:23:30,830 --> 00:23:33,950
لماذا تُحدِّقُ بي؟

410
00:23:34,250 --> 00:23:36,380
.إذا كُنتَ آسفٌ حقًّا، أثبِتْ ذلكَ لي

411
00:23:36,380 --> 00:23:39,060
.ربّما أُسامحكَ مقابلَ عشرة صحونٍ من حساء الفاصولياء الحمراء