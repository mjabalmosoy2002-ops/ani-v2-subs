1
00:00:09,770 --> 00:00:11,440
!الجوّ قارص

2
00:00:29,560 --> 00:00:30,830
ثلج؟

3
00:00:32,310 --> 00:00:33,790
.يبدو أنّها قد هطلت بغزارة

4
00:00:35,550 --> 00:00:37,800
.لاعجبَ أنَّ الجوّ بارد جدًا

5
00:00:54,520 --> 00:00:57,950
،حتّى تسخن غرفتي

6
00:00:58,870 --> 00:01:00,750
.سأبقى بوضع الاستعداد

7
00:02:56,140 --> 00:02:59,200
.صباحُ الخير يا ساغيري. الفطور جاهز

8
00:03:04,960 --> 00:03:06,790
ما الّذي أخرك؟

9
00:03:09,820 --> 00:03:11,000
.صباح الخير

10
00:03:12,070 --> 00:03:13,020
هل أُصبتَ بنزلة برد؟

11
00:03:13,020 --> 00:03:14,250
.أجل

12
00:03:14,250 --> 00:03:18,540
قبل أيّام، قالت إلف أنّها كانت عالقة في
.السرير لأنّها متوعكة، لذا ذهبت لزيارتها

13
00:03:29,910 --> 00:03:32,440
.يبدو أنّني قد إلتقطت أيًّا ما كانت مُصابه به

14
00:03:38,550 --> 00:03:39,670
هل أنتَ بخير؟

15
00:03:39,670 --> 00:03:42,020
.ذهبت لرؤية الطبيب أمس وأخذت بعض الدواء

16
00:03:45,300 --> 00:03:46,160
!أخي الكبير

17
00:03:47,750 --> 00:03:50,610
.أنتَ ساخنٌ للغاية يا أخي الكبير

18
00:03:50,610 --> 00:03:52,790
.الآن وقد ذكرتِ الأمر، لقد كنتُ أرتجف

19
00:03:52,790 --> 00:03:55,250
.ظننتُ أنَّ ذلكَ فقط بسبب البرد

20
00:04:01,080 --> 00:04:03,290
.إنّها ليست مُجرّد حُمّى خفيفة. إنّكَ تشتعل

21
00:04:03,290 --> 00:04:05,020
.لا تقلقي. أنا بخير

22
00:04:05,020 --> 00:04:06,630
!كلّا، أنتَ لستَ كذلك

23
00:04:06,630 --> 00:04:08,890
.لا أريدكِ أن تلتقطي العدوى

24
00:04:08,890 --> 00:04:11,050
.كلّا! ستبقى هنا

25
00:04:11,850 --> 00:04:14,900
.حـ-حتّى أستطيع الإهتمام بك لتعود إلى صحتك

26
00:04:18,140 --> 00:04:22,310
.إذا غادرتَ غرفتي، فلن أستطيع الإعتناء بك

27
00:04:22,310 --> 00:04:25,610
ماذا عليَّ أن أفعل؟

28
00:04:25,610 --> 00:04:26,810
!فلتنم هنا

29
00:04:26,810 --> 00:04:27,870
ماذا؟ هنا؟

30
00:04:27,870 --> 00:04:30,460
!لا أريد سماع شكاوي! المرضى يحتاجون للراحة

31
00:04:33,880 --> 00:04:35,480
...وسادة ساغيري

32
00:04:35,480 --> 00:04:36,960
...وبطانيتها

33
00:04:36,960 --> 00:04:39,210
.تفوح منها رائحتها

34
00:04:39,210 --> 00:04:40,120
.أخي الكبير

35
00:04:40,120 --> 00:04:41,210
!أ-أجل؟

36
00:04:41,480 --> 00:04:45,530
.حُمّاكَ تزداد سوءًا، لذا يجب عليك أخذ دوائك

37
00:04:45,530 --> 00:04:46,680
أينَ وضعته؟

38
00:04:47,900 --> 00:04:49,600
.على الرف في غرفة المعيشة

39
00:04:49,600 --> 00:04:50,470
.سأذهب لأجلبه

40
00:04:50,470 --> 00:04:51,520
ماذا قلتِ؟

41
00:04:51,520 --> 00:04:53,250
هل ستكونين بخير؟

42
00:04:53,250 --> 00:04:55,420
...مغادرتي لغرفتي تحمل مُخاطرة كبيرة

43
00:04:55,420 --> 00:04:57,770
!ولكن هذه حالة طارئة

44
00:04:57,770 --> 00:05:01,280
!أنا هي الوحيدة الّتي يُمكنها انقاذك

45
00:05:02,040 --> 00:05:03,740
...ساغيري

46
00:05:04,090 --> 00:05:06,640
.أعدك أنّني سأعود، لذا انتظرني فقط يا أخي الكبير

47
00:05:06,640 --> 00:05:07,910
.توخي الحذر

48
00:05:08,220 --> 00:05:09,450
!سأفعل

49
00:05:23,130 --> 00:05:38,100
!تشجّعي، تشجّعي، تشجّعي

50
00:05:38,390 --> 00:05:39,860
!ها أنا ذا

51
00:05:41,090 --> 00:05:43,190
!تشجّعي

52
00:05:47,750 --> 00:05:49,230
.كانَ ذلكَ سهلًا

53
00:05:53,950 --> 00:05:57,460
،واحدة مِن الحبوب الكبيرة
.وأُخرى مِن الحبوب الصغيرة

54
00:05:57,460 --> 00:06:01,030
...إذا كانت الحُمّى أعلى مِن 38 درجة، عندها

55
00:06:01,660 --> 00:06:03,670
!حسنًا، فهمت

56
00:06:03,670 --> 00:06:05,550
!لقد عُدت

57
00:06:10,300 --> 00:06:12,470
.الحُمّى 38.5 درجة

58
00:06:12,470 --> 00:06:14,400
.هذا أسوأ ممّا ظننت

59
00:06:14,900 --> 00:06:17,310
.أظن أنّهُ لا يُمكنني الذهاب للمدرسة في النهاية

60
00:06:17,310 --> 00:06:18,320
ماذا؟

61
00:06:18,320 --> 00:06:21,580
أكنتَ تنوي الذهاب للمدرسة
اليوم وأنتَ بهذه الحالة؟

62
00:06:21,580 --> 00:06:24,230
.امتحانات منتصف العام على الأبواب

63
00:06:24,230 --> 00:06:26,360
.عليَّ معرفة ما الّذي ستحتويه

64
00:06:26,360 --> 00:06:28,960
.أيًّا يكن، يُمكنني فقط سؤال توموي لاحقًا

65
00:06:30,260 --> 00:06:31,920
توموي-تشان؟

66
00:06:34,720 --> 00:06:37,290
أهي الفتاة الّتي تأتي لتوصيل تلكَ الدوجينشي المُنحرفة؟

67
00:06:34,720 --> 00:06:37,290
،دوجينشي: هو مصطلح ياباني للإشارة إلى الأعمال ذاتية النشر، عادة
.مانجا، مجلات أو روايات وفي الغالب يتم العمل عليها مِن قبل الهواة

68
00:06:37,290 --> 00:06:39,620
ألا يُمكنكِ تذكرها بطريقة أُخرى؟

69
00:06:40,280 --> 00:06:42,460
.في الحقيقة، الإمتحانات ليست همّي الأكبر حتّى

70
00:06:42,820 --> 00:06:43,960
ما الأمر؟

71
00:06:43,960 --> 00:06:46,850
.من المفترض أن أُقدِّم نصّي الأحدث اليوم

72
00:06:46,850 --> 00:06:48,670
.عليَّ توصيله بالوقت المحدّد

73
00:06:50,930 --> 00:06:52,430
!لا تقلق بشأن ذلك

74
00:06:52,430 --> 00:06:55,080
!ستبقى في هذه الغرفة طوال اليوم

75
00:06:55,080 --> 00:06:56,350
.حـ-حسنًا

76
00:07:10,150 --> 00:07:11,340
.أخي الكبير

77
00:07:13,930 --> 00:07:15,340
.لقد غطَّ في النوم

78
00:07:16,830 --> 00:07:18,340
.اعذرني يا أخي الكبير

79
00:07:18,950 --> 00:07:20,580
.ها نحنُ ذا

80
00:07:34,300 --> 00:07:36,860
.العناية بأحدهم مُرهقة للغاية

81
00:07:42,560 --> 00:07:43,870
.سأتفقّد حُمّاه مُجددًا

82
00:07:44,810 --> 00:07:45,930
!إنّهُ ساخن

83
00:07:51,670 --> 00:07:52,860
.هذا سيفي بالغرض

84
00:08:01,870 --> 00:08:04,750
ما الّذي سأفعله بخصوص طعامه؟

85
00:08:10,770 --> 00:08:11,860
!يا إلهي

86
00:08:11,860 --> 00:08:15,410
لماذا لا يُبقي أيّ طعام سريع التحضير في المنزل؟

87
00:08:15,410 --> 00:08:18,460
.إنّهُ ليسَ مُتحضّرًا لحالات الطوارئ على الإطلاق

88
00:08:21,640 --> 00:08:23,100
!سأقوم بالطلب

89
00:08:27,850 --> 00:08:30,190
!أعلم. سأسأل إلف-تشان

90
00:08:32,640 --> 00:08:34,100
.لا فائدة

91
00:08:34,100 --> 00:08:35,530
.لم يتبقّى لديَّ خيار

92
00:08:35,530 --> 00:08:36,600
.لقد انتهى أمري

93
00:08:37,720 --> 00:08:41,370
!ولكن ما يزال هناكَ شيءٌ يُمكنني فعله

94
00:08:50,710 --> 00:08:51,670
!أجل

95
00:08:52,720 --> 00:08:55,380
.إذا أحدثتُ الكثير مِن الضوضاء، فسوفَ أوقظه

96
00:08:55,380 --> 00:08:57,850
.تشجّعوا، تشجّعوا

97
00:09:02,430 --> 00:09:04,810
.هذه صاخبة أيضًا

98
00:09:12,980 --> 00:09:16,950
حتّى أنا يُمكنني التعامل مع بعض
.الأعمال المنزليّة إذا صمّمتُ على ذلك

99
00:09:19,410 --> 00:09:21,370
...تشجّعوا

100
00:09:23,450 --> 00:09:25,100
.لقد انتهيتُ أخيرًا

101
00:09:26,670 --> 00:09:32,460
لا أُصدق أنّهُ يفعل كلّ هذه الأشياء
.كلّ يوم بينما لديه عمل ومدرسة

102
00:09:32,980 --> 00:09:34,760
...بالمناسبة

103
00:09:38,010 --> 00:09:39,840
موراماسا-سينسي؟

104
00:09:39,840 --> 00:09:43,810
جئتِ إلى هنا لطلب نصيحة بالمواعدة، ولكن ألا
تعتقدين أنّهُ مِن المُبكر للغاية التخطيط للزفاف؟

105
00:09:43,810 --> 00:09:45,810
!عـ-على الإطلاق

106
00:09:46,210 --> 00:09:48,620
...الجميع يعرف أنَّ الخطوة التالية بعد المواعدة

107
00:09:48,620 --> 00:09:52,020
.هي الز-ز-زواج

108
00:09:52,020 --> 00:09:53,280
.اعذريني

109
00:09:54,390 --> 00:09:56,030
.هذا أمرٌ غير مألوف

110
00:09:56,610 --> 00:09:58,160
.إيرومانجا-سينسي تتصل

111
00:09:59,400 --> 00:10:01,280
.مرحبًا، بوركت جهودكِ

112
00:10:03,910 --> 00:10:05,650
ما الّذي يُمكنني مُساعدتكِ به؟

113
00:10:05,650 --> 00:10:07,050
...أخي الكبير

114
00:10:07,050 --> 00:10:09,830
...إيزومي ماساموني-سينسي قد أُصيبَ بنزلة برد، و

115
00:10:09,830 --> 00:10:11,160
.لديه حُمّى

116
00:10:11,640 --> 00:10:13,250
أُصيبَ بنزلة برد؟

117
00:10:13,250 --> 00:10:15,020
!ماساموني-كن أُصيب بنزلة برد؟

118
00:10:15,020 --> 00:10:17,080
أهذا صحيح يا إيرومانجا-سينسي؟

119
00:10:17,080 --> 00:10:18,710
!موراماسا-تشان؟

120
00:10:18,710 --> 00:10:21,820
إذن؟ ما هي حالته الحاليّة؟

121
00:10:21,820 --> 00:10:23,120
هل طلبتِ طبيبًا بعد؟

122
00:10:23,120 --> 00:10:24,330
هل اتصلتِ بسيارة الاسعاف؟

123
00:10:24,330 --> 00:10:25,350
هل أعطيتيه الدواء؟

124
00:10:25,350 --> 00:10:26,930
إذن، ما الّذي احتجتِ إليه؟

125
00:10:27,350 --> 00:10:31,020
أردتُ سؤالكِ عن مواد العمل
.الّتي كانَ يُفترض به تسليمها اليوم

126
00:10:31,330 --> 00:10:33,980
.لا تقلقي بشأن ذلك
.اجعليه يُرسلها عندما يتحسّن

127
00:10:34,880 --> 00:10:38,490
.أخبريه أنّني أتمنى له الشفاء العاجل يا إيرومانجا-سينسي

128
00:10:39,260 --> 00:10:42,400
.لـ-لا أعرف أحدًا بهذا الاسم

129
00:10:42,400 --> 00:10:44,390
تعلمين أنّني مُحرّرتكِ، صحيح؟

130
00:10:48,660 --> 00:10:50,120
.كاغورازاكا-سان

131
00:10:50,600 --> 00:10:51,710
كيفَ لي أن أخدمكِ؟

132
00:10:52,710 --> 00:10:55,610
.تقول أنّكَ لستَ بحاجة للقلق بشأن تسليم النصّ

133
00:10:55,610 --> 00:10:57,170
لذا حاول الحصول على قسطٍ مِن ــــ

134
00:11:00,630 --> 00:11:02,460
.إنّهُ يتعرّق كثيرًا

135
00:11:02,460 --> 00:11:04,110
ماذا عليَّ أن أفعل؟

136
00:11:09,750 --> 00:11:11,440
...الجوّ ساخنٌ للغاية

137
00:11:12,720 --> 00:11:15,180
.قميصكَ مُبلّل يا أخي الكبير

138
00:11:16,680 --> 00:11:20,250
.حسنًا، بما أنّكَ مُستيقظ بالفعل، فلنغيّر ملابسك

139
00:11:36,120 --> 00:11:38,320
.التغيير هنا مُحرجٌ بعض الشيء

140
00:11:39,650 --> 00:11:42,220
.هـ-هذا ليسَ وقتًا مُناسبًا للقلق بشأن هذا

141
00:11:42,220 --> 00:11:44,760
.لا شيءَ يدعو للإحراج

142
00:11:48,010 --> 00:11:49,340
.أريد مسح نفسي

143
00:11:50,780 --> 00:11:52,050
أيمكنكِ أن تجلبي منشفة لي؟

144
00:11:52,050 --> 00:11:54,330
.سـ-سأمسحك أنا

145
00:11:54,330 --> 00:11:56,730
لا يُمكنكَ مسح ظهرك، صحيح؟

146
00:12:02,350 --> 00:12:04,220
.أظنني على وشك الاصابة بحُمّى جديدة

147
00:12:04,220 --> 00:12:06,250
.إ-إني أعتني بك فقط

148
00:12:10,030 --> 00:12:12,980
.لـ-لا تتخيّل أيّ شيء غريب

149
00:12:12,980 --> 00:12:14,420
!حسنًا. انتهيت

150
00:12:23,320 --> 00:12:25,050
هل أنتَ نائمٌ بالفعل يا أخي الكبير؟

151
00:12:33,480 --> 00:12:37,980
.أظن أنّها المرّة الأُولى الّتي أراه فيها ينام هكذا

152
00:12:41,150 --> 00:12:43,110
!إيزومي-تشان

153
00:12:43,110 --> 00:12:45,360
!دعينا نلعب

154
00:12:47,020 --> 00:12:49,540
ألديكِ شأنٌ مع أخي الكبير يا تومو-تشان؟

155
00:12:49,540 --> 00:12:53,220
موني-كن لم يحضر للمدرسة حتّى
.رغم أنَّ امتحاناتنا على الأبواب

156
00:12:53,220 --> 00:12:55,290
.لهذا جئتُ لتفقده

157
00:12:55,540 --> 00:12:57,340
مـ-موني-كن"؟"

158
00:12:57,340 --> 00:12:58,880
.إنّها ودودة للغاية

159
00:12:58,880 --> 00:13:00,510
!إيزمي-تشان

160
00:13:00,510 --> 00:13:02,860
!مرحبًا؟! إيزومي-تشان؟

161
00:13:04,300 --> 00:13:05,180
لا أحد بالمنزل.

162
00:13:06,700 --> 00:13:07,720
أنتِ موجودة، أليسَ كذلك؟

163
00:13:09,050 --> 00:13:10,110
.لستُ كذلك

164
00:13:17,480 --> 00:13:18,860
.يُمكنني رؤيتكِ كما تعلمين

165
00:13:20,820 --> 00:13:21,980
لماذا أنتما هنا؟

166
00:13:22,310 --> 00:13:23,710
.افتحي الباب

167
00:13:23,710 --> 00:13:24,470
.كلّا

168
00:13:24,470 --> 00:13:25,530
لما لا؟

169
00:13:25,530 --> 00:13:28,230
.جئت لإعادة الرواية الخفيفة الّتي أعرتيني إياها

170
00:13:28,230 --> 00:13:30,300
.أردت التحدث حول القصّة معكِ

171
00:13:30,300 --> 00:13:31,560
.لا يُمكنني اليوم

172
00:13:31,560 --> 00:13:32,620
هل هناكَ خطبٌ ما؟

173
00:13:33,230 --> 00:13:35,450
.إنّي أرعى مريضًا متوعكًا للغاية

174
00:13:35,450 --> 00:13:37,520
ماذا؟ أتتحدّثين عن أخيكِ؟

175
00:13:37,520 --> 00:13:38,430
.أجل

176
00:13:38,970 --> 00:13:40,750
أهناكَ ما يُمكنني المُساعدة به؟

177
00:13:40,750 --> 00:13:41,690
.لا بأس

178
00:13:41,690 --> 00:13:43,290
موني-كن مريض؟

179
00:13:44,590 --> 00:13:46,080
.آسفة إذا أخفتكِ

180
00:13:46,080 --> 00:13:47,970
أنتِ أُخت موني-كن الصغيرة، صحيح؟

181
00:13:47,970 --> 00:13:50,690
.سُررتُ بلقائكِ. أنا تاكاساغو توموي

182
00:13:55,290 --> 00:13:57,250
.أنتِ فتاة الدوجينشي المنحرفة

183
00:14:00,030 --> 00:14:02,370
إذن، أقلتِ أنَّ موني-كن مريض؟

184
00:14:02,370 --> 00:14:04,610
.لـ-لديه حُمّى، ولكنها نزلة برد عاديّة

185
00:14:05,110 --> 00:14:07,070
.تناولَ بعض الأدوية، وهو نائمٌ الآن

186
00:14:09,680 --> 00:14:12,670
.أفترض أنّهُ لا يجب علينا التدخل بعملك إذن

187
00:14:13,570 --> 00:14:15,870
هلّا تفضّلتي بإعطائه هذه؟

188
00:14:15,870 --> 00:14:17,750
،هذه ملاحظات حول ما سيأتي في الإمتحان

189
00:14:18,820 --> 00:14:22,710
وهذه الرواية الّتي حجزها والّتي كانَ
.يُفترض أن يأتي ليأخذها اليوم مِن متجرنا

190
00:14:23,630 --> 00:14:26,490
."إنّهُ المجلّد الخامس مِن رواية "86

191
00:14:29,130 --> 00:14:31,140
!أريد قراءته أيضًا

192
00:14:31,400 --> 00:14:34,370
أخبري موني-كن أنّني أتمنى
له الشفاء العاجل، حسنًا؟

193
00:14:34,370 --> 00:14:35,290
.أراكِ لاحقًا

194
00:14:36,600 --> 00:14:37,990
.فلنذهب يا ميغومي

195
00:14:37,990 --> 00:14:39,200
.حسنًا

196
00:14:41,540 --> 00:14:43,360
!توموي-تشان شخصٌ جيّد

197
00:14:43,360 --> 00:14:45,680
!تمَ الحصول على مُجلّد جديد

198
00:14:46,660 --> 00:14:48,240
مُجددًا؟

199
00:14:50,230 --> 00:14:52,740
ألم تُغادرا بالفعل؟

200
00:14:54,450 --> 00:14:56,070
أثمّة شيءٌ آخر تحتاجانه؟

201
00:14:56,070 --> 00:14:58,530
ذلكَ الصوت... أهذه أنتِ يا إيرومانجا-سينسي؟

202
00:14:59,250 --> 00:15:01,210
.مـ-موراماسا-تشان

203
00:15:01,330 --> 00:15:03,960
سمعتُ أنَّ ماساموني-كن
.قد سقطَ مريضًا بنزلة برد

204
00:15:04,090 --> 00:15:05,590
.أنا هنا لأتفقده

205
00:15:05,710 --> 00:15:09,550
قلتُ أنّني كنتُ متأكدة أنَّ كلّ شيء سيكون
.على ما يُرام، لكن كاغورازاكا-سان أصرّت

206
00:15:10,860 --> 00:15:12,680
.حسنًا، على أيّة حال، أدخليني

207
00:15:12,800 --> 00:15:13,680
.كلّا

208
00:15:14,240 --> 00:15:15,060
لما لا؟

209
00:15:15,180 --> 00:15:17,430
.لـ-لا يُمكنني فتح الباب لكِ

210
00:15:17,430 --> 00:15:20,060
!سمعتُ أنَّ إلف تدخل إلى منزلكم طوال الوقت

211
00:15:25,280 --> 00:15:27,470
.إنّها تفعل ذلك مِن تلقاء نفسها

212
00:15:27,470 --> 00:15:29,440
.لم أدعها تدخل ولو مرّة

213
00:15:29,570 --> 00:15:31,810
!سأفعل المثل إذن

214
00:15:37,220 --> 00:15:39,110
.حرصت على اقفال كلّ الأبواب اليوم

215
00:15:50,840 --> 00:15:54,640
موراماسا-تشان، يجب عليكِ التوقف قبل أن
!يراكِ أحدهم ويفهم الأمر بصورة خاطئة

216
00:15:55,980 --> 00:15:58,830
!لماذا مسموحٌ بدخول إلف بينما أنا لا؟

217
00:15:58,830 --> 00:16:01,100
!أخبرتكِ بالفعل. إلف-تشان غير مسموحٌ لها بالدخول أيضًا

218
00:16:06,050 --> 00:16:10,030
ما الّذي يُفترض بي فعله إذن بهذه الأشياء الّتي اشتريتها له؟

219
00:16:10,810 --> 00:16:11,950
.أيًّا كانَ ما يستطيع العبور مِن هنا

220
00:16:14,740 --> 00:16:15,910
!أدخليني

221
00:16:15,910 --> 00:16:18,000
!إنّي قلقة على ماساموني-كن

222
00:16:18,000 --> 00:16:19,720
.إنّهُ بخير

223
00:16:19,720 --> 00:16:22,070
ما الّذي سيتطلبه الأمر حتّى تفتحي هذا الباب؟

224
00:16:22,070 --> 00:16:25,120
.يُسعدني قدومكِ لرؤيته

225
00:16:25,570 --> 00:16:27,420
.ولكن أنا آسفة. لا يُمكنني فتحه

226
00:16:31,070 --> 00:16:32,610
.حسنًا، لقد فهمت

227
00:16:32,610 --> 00:16:34,640
.سيتوجّب عليَّ التعامل مع عدم الدخول

228
00:16:35,280 --> 00:16:38,470
.على الأقل أعطيه الأشياء الّتي اشتريتها له

229
00:16:39,670 --> 00:16:41,180
مشروب فيتامين؟

230
00:16:41,180 --> 00:16:43,850
.و-وهذا

231
00:16:45,350 --> 00:16:47,240
ماذا؟ ما هذا؟

232
00:16:48,220 --> 00:16:49,720
...هذا

233
00:16:49,720 --> 00:16:50,820
!...إياكِ والنظر

234
00:16:52,390 --> 00:16:54,210
.إياكِ والنظر لداخله

235
00:16:54,210 --> 00:16:57,160
.عديني أنّكِ ستسلمينه إياه كما هو

236
00:16:59,240 --> 00:17:00,680
.مفهوم

237
00:17:02,440 --> 00:17:03,530
...حسنًا

238
00:17:07,340 --> 00:17:10,760
.لمعلوماتك، جلب "ذلك" لم تكن فكرتي

239
00:17:10,760 --> 00:17:14,290
كاغورازاكا-سان قالت أنّه سيكون
.أفضل شيء لجعله يشعر بالتحسن

240
00:17:14,290 --> 00:17:16,390
!البدء بتفتيش المحتويات

241
00:17:17,070 --> 00:17:19,270
!وعدتيني أنّكِ لن تنظري لداخله

242
00:17:19,270 --> 00:17:21,140
."كلّ ما قلته هو "مفهوم

243
00:17:21,140 --> 00:17:22,470
!تـ-توقّفي

244
00:17:22,470 --> 00:17:24,430
...هـ-هذا

245
00:17:22,890 --> 00:17:24,430
!لا تنظري

246
00:17:24,940 --> 00:17:26,190
!أترجاكِ

247
00:17:26,190 --> 00:17:28,120
!ما-ما هذا؟

248
00:17:28,120 --> 00:17:29,150
!إنّهُ غير لائق

249
00:17:30,650 --> 00:17:34,740
لا أستطيع أبدًا إعطاء أخي الكبير
!مثل هذه الصورة الغير لائقة

250
00:17:36,070 --> 00:17:37,950
.سـ-سيتوجّب عليَّ مُصادرتها

251
00:17:37,950 --> 00:17:40,780
.سأستخدمها كمرجع للرسم

252
00:17:41,080 --> 00:17:47,540
!توقّفي

253
00:17:50,880 --> 00:17:52,710
...باختصار

254
00:17:53,540 --> 00:17:56,210
،حصل على نزلة برد مِن إلف-تشان

255
00:17:56,210 --> 00:17:59,870
،توموي-تشان جلبت له كتابًا وملاحظات

256
00:17:59,870 --> 00:18:02,640
.وموراماسا-تشان جاءت لزيارته

257
00:18:09,840 --> 00:18:12,010
.إنّهُ كشخصيّة رئيسيّة في رواية خفيفة

258
00:18:30,230 --> 00:18:31,580
...أُمّي

259
00:18:33,700 --> 00:18:35,700
.يبدو أنَّ حُمّاكِ انخفضت

260
00:18:36,280 --> 00:18:39,290
.يداكِ تُشعراني بالراحة

261
00:18:39,290 --> 00:18:41,140
.ابقي كما أنتِ

262
00:18:42,030 --> 00:18:42,680
.حسنًا

263
00:18:53,440 --> 00:18:54,610
...أُمّي

264
00:18:57,940 --> 00:18:59,090
أخي الكبير؟

265
00:19:01,390 --> 00:19:05,140
هل يراودكَ نفس حلمي؟

266
00:19:06,880 --> 00:19:08,470
...أتعلم يا أخي الكبير

267
00:19:08,470 --> 00:19:13,040
.عائلتنا أصبحت نحنُ الاثنان فقط

268
00:19:16,810 --> 00:19:21,450
.إذا لم تكن موجودًا، أتساءل ما الّذي كانَ لحدث لي

269
00:19:24,730 --> 00:19:27,800
.شكرًا لكَ على كلّ شيء يا أخي الكبير

270
00:19:32,540 --> 00:19:34,270
.أسرع وتحسّن

271
00:19:55,470 --> 00:19:57,000
.سأستعيرك

272
00:20:33,850 --> 00:20:34,790
ماذا؟

273
00:20:35,360 --> 00:20:37,130
هل أعددتِ هذه؟

274
00:20:37,480 --> 00:20:39,090
.أ-أجل

275
00:20:39,090 --> 00:20:41,040
.لابدَّ مِن أنَّ ذلكَ كانَ صعبًا

276
00:20:41,040 --> 00:20:46,050
.حسنًا، لم أتمكَّن مِن إعدادها بجودة خاصتك

277
00:20:52,070 --> 00:20:53,320
.إنّها جيّدة

278
00:20:53,320 --> 00:20:55,010
!إنّها لذيذة يا ساغيري

279
00:20:57,710 --> 00:20:59,230
.يا للراحة

280
00:21:00,050 --> 00:21:04,170
.يبدو أنَّ حُمّاي قد انخفضت

281
00:21:04,170 --> 00:21:05,960
.هذا كلّه بفضلك

282
00:21:05,960 --> 00:21:08,660
.كـ-كانَ ذلكَ تأثير دوائك فقط

283
00:21:11,860 --> 00:21:15,820
.أتعلمين، أظن أنّهُ راودني حلمٌ بعندما كنتُ صغيرًا

284
00:21:16,650 --> 00:21:19,880
.لا يُمكنني تذكره تمامًا، ولكنهُ كانَ حلمًا جميلًا

285
00:21:27,490 --> 00:21:28,610
نزلة برد؟

286
00:21:31,000 --> 00:21:32,770
.أشعر بالعطش يا أخي الكبير

287
00:21:32,770 --> 00:21:34,730
.أريد عصيرًا

288
00:21:34,730 --> 00:21:36,190
.قادمٌ حالًا

289
00:21:38,650 --> 00:21:40,730
.أريد تفاحًا مبشور

290
00:21:40,730 --> 00:21:42,760
.حسنًا، سأعود فورًا

291
00:21:42,760 --> 00:21:43,760
.انتظر

292
00:21:43,760 --> 00:21:44,570
أجل؟

293
00:21:45,720 --> 00:21:46,810
.لك...

294
00:21:48,340 --> 00:21:50,500
.قلت شكرًا لك

295
00:21:53,660 --> 00:21:57,170
بالمناسبة، حصلت على الموافقة
.على ذلكَ النصّ الّذي قدمته

296
00:21:57,830 --> 00:22:00,340
أسرعي وتحسّني حتّى يُمكنكِ
.البدء بالرسوم التخطيطيّة

297
00:22:00,340 --> 00:22:02,250
.أجل, دع الأمر لي

298
00:22:02,250 --> 00:22:04,460
.أعتمد عليكِ يا إيرومانجا-سينسي

299
00:22:06,160 --> 00:22:08,970
!لا أعرف أحدًا بهذا الاسم