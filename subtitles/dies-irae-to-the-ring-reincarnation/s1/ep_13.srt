1
00:00:04,790 --> 00:00:05,900
...تريجيا

2
00:00:08,090 --> 00:00:11,880
...تريجيا

3
00:00:25,010 --> 00:00:26,790
.لقد استيقظت

4
00:00:29,650 --> 00:00:30,960
كيف تشعرين؟

5
00:00:32,370 --> 00:00:33,970
من أنت؟

6
00:00:34,980 --> 00:00:37,160
.إليونور فون فيتينبورغ

7
00:00:38,360 --> 00:00:40,330
.صديقة قديمة لبرينر

8
00:00:40,330 --> 00:00:41,470
.استرخي

9
00:00:48,920 --> 00:00:49,930
.أخبريني

10
00:00:50,610 --> 00:00:52,690
هل ريزا جدّتي الكبرى؟

11
00:00:53,190 --> 00:00:54,470
.أجل

12
00:00:56,340 --> 00:00:58,820
.وقد قتلتها

13
00:01:01,700 --> 00:01:03,930
،قد يتعذّر عليك فهم هذا

14
00:01:03,930 --> 00:01:05,960
.لكنّها كانت طريقتي في إظهار الصداقة

15
00:01:06,660 --> 00:01:08,670
،إن أردتِ أن تفعلي شيئًا لأجل برينر

16
00:01:08,670 --> 00:01:10,790
.قومي بواجبك

17
00:01:12,100 --> 00:01:15,300
...وا.. جبي

18
00:01:16,370 --> 00:01:17,240
.بالفعل

19
00:01:18,580 --> 00:01:22,010
.لكن لا أظنّ أنّ أيّ ما أقول قد يؤثّر عليك

20
00:01:22,410 --> 00:01:23,890
.على عاتقنا التزام كبير

21
00:01:24,310 --> 00:01:26,740
.اذهبي وودّعي الحياة التي عشتها حتّى الآن

22
00:01:28,070 --> 00:01:31,480
تعلمين بالفعل من يجب أن تسألي، أليس كذلك؟

23
00:01:32,040 --> 00:01:34,260
.من الأفضل ألا تتركي وراءك أيّ ندم

24
00:01:34,810 --> 00:01:37,200
.لن أقف في طريقك، لذا أسرعي

25
00:03:23,990 --> 00:03:29,030
شجرة عيد الميلاد، شجرة عيد الميلاد

26
00:03:29,030 --> 00:03:34,050
!كم وفيّة أوراقك

27
00:03:34,050 --> 00:03:38,680
لستِ خضراء في الصيف فقط

28
00:03:38,690 --> 00:03:43,040
.بل حتى في الشتاء، عندما تُثلج

29
00:03:43,040 --> 00:03:47,740
،شجرة عيد الميلاد، شجرة عيد الميلاد

30
00:03:47,740 --> 00:03:52,520
!كم وفيّة أوراقك

31
00:04:17,310 --> 00:04:22,530
تعلم أنّ كونك هاربًا خلال فترة الحرب
يُعدّ جريمة، أليس كذلك أيها الأب؟

32
00:04:25,000 --> 00:04:26,530
.عشرة منهم

33
00:04:26,930 --> 00:04:30,420
.اخترهم وقدّمهم لنا

34
00:04:32,370 --> 00:04:35,080
.وإن لم تفعل، فسآخذهم جميعًا

35
00:04:35,780 --> 00:04:37,090
ماذا ستفعل؟

36
00:05:21,330 --> 00:05:22,760
.واحد

37
00:05:35,510 --> 00:05:36,500
.اثنان

38
00:05:40,930 --> 00:05:42,070
.ثلاثة

39
00:05:46,290 --> 00:05:47,320
.أربعة

40
00:05:50,390 --> 00:05:51,280
.خمسة

41
00:05:54,360 --> 00:05:55,200
.ستة

42
00:05:56,790 --> 00:05:57,660
.سبعة

43
00:05:59,160 --> 00:06:00,130
.ثمانية

44
00:06:02,010 --> 00:06:03,060
.تسعة

45
00:06:06,130 --> 00:06:07,410
.عشرة

46
00:06:08,500 --> 00:06:10,370
.أحسنت أيها الأب

47
00:06:10,370 --> 00:06:12,350
.والآن، عد

48
00:06:14,260 --> 00:06:17,140
.أحتاجك

49
00:06:32,740 --> 00:06:33,880
لماذا؟

50
00:06:35,700 --> 00:06:40,040
لمَ هي معك أيها الأب؟

51
00:06:44,960 --> 00:06:49,220
ألم تكن ستهاجم الكنيسة مع فوجي-كن والبقية؟

52
00:06:49,700 --> 00:06:52,010
فيمَ تفكر؟

53
00:06:53,220 --> 00:06:56,390
هل خطّطت أن آتي إلى هنا أيضًا؟

54
00:07:02,250 --> 00:07:03,590
.أريد أن أسألك شيئًا

55
00:07:04,170 --> 00:07:08,690
لمَ أخي غاضب جدًّا منك؟

56
00:07:09,080 --> 00:07:10,420
!أجبني رجاءً

57
00:07:12,530 --> 00:07:15,060
لمَ هو غاضب؟

58
00:07:15,620 --> 00:07:18,790
.بسببها على الأغلب

59
00:07:18,790 --> 00:07:21,460
!لا أُصدّق تلك الحماقة بشأن برنامج بابل

60
00:07:21,460 --> 00:07:22,760
!هذا هو

61
00:07:22,760 --> 00:07:24,050
!إنه قلبه

62
00:07:24,050 --> 00:07:25,460
!أعرف ذلك

63
00:07:25,960 --> 00:07:27,920
ماذا فعلت له؟

64
00:07:29,210 --> 00:07:31,680
.طلبتُ منه أن يموت ببساطة

65
00:07:33,930 --> 00:07:39,680
هو والسيّدة كيرهيايزن قرّرا
.أن يتمرّدا على السيّد هايدريخ

66
00:07:40,340 --> 00:07:41,860
.لم أكن لأسمح بذلك

67
00:07:41,860 --> 00:07:44,480
.لربّما شوّش ذلك خططي

68
00:07:45,460 --> 00:07:49,620
لقد كان محاربًا. ليس من الصّائب
.له أن يكرهني بعد خسارة المعركة

69
00:07:50,370 --> 00:07:51,450
...أو

70
00:07:51,450 --> 00:07:54,910
لربّما لا يستطيع أن يسامحني
لأنّي حوّلتُ الفتاة الصغيرة

71
00:07:55,410 --> 00:08:00,870
التي أراد أن يحميها أكثر من
.أيّ شيءٍ إلى محاربة بدورها

72
00:08:02,290 --> 00:08:03,640
!أيها الوغد

73
00:08:04,810 --> 00:08:08,360
هل تكرهينني يا ليونهارت؟

74
00:08:11,770 --> 00:08:13,430
.فهمت

75
00:08:13,980 --> 00:08:16,490
.لقد كنتُ أسيرًا للكراهية منذ وقتٍ طويل أيضًا

76
00:08:17,350 --> 00:08:21,780
.لا أستطيع مسامحة نفسي

77
00:08:23,690 --> 00:08:28,650
.بالتّالي، عقابي هو العذاب الأبديّ

78
00:08:29,160 --> 00:08:33,110
،لا أملك أيّ حاجةٍ للخلاص
.ولا أريد أيّ شيء متعلّق بالنِعم

79
00:08:33,110 --> 00:08:37,780
...سأسير وحيدًا، إلى الأبد

80
00:08:38,240 --> 00:08:40,200
!إلى الأبد

81
00:08:49,450 --> 00:08:51,590
.أردتُ أن أكون قويًّا

82
00:08:52,730 --> 00:08:54,800
لمَ خسرتهم؟

83
00:08:55,400 --> 00:08:57,510
لمَ لم أستطع حمايتهم؟

84
00:08:57,510 --> 00:08:59,220
.الجواب واضح

85
00:09:00,260 --> 00:09:04,270
.لأنّي كنتُ ضعيفًا وطائشًا

86
00:09:04,270 --> 00:09:06,440
".أريد أن أكون قويًّا"

87
00:09:06,440 --> 00:09:09,480
".أريد وعاءً لا يستطيع أيّ أحد كسره"

88
00:09:10,150 --> 00:09:14,360
ما دمت أملك ذلك، يمكنني أن أنقذهم"
"!مرارًا وتكرارًا، مهما تطلّب ذلك

89
00:09:14,360 --> 00:09:17,400
!الكأس المقدّس هو أمنيتي

90
00:09:17,400 --> 00:09:20,990
،أن أُقدّم الخلاص الأبديّ للآخرين

91
00:09:21,440 --> 00:09:24,250
!وأن أُقدّم لنفسي التكفير الأبديّ

92
00:09:29,330 --> 00:09:32,070
.تريدين عودة الأشياء العزيزة عليك

93
00:09:32,070 --> 00:09:34,510
.تريدين أن تعانقيهم بشدّة

94
00:09:35,750 --> 00:09:39,470
.يمكنني أن أفهم مشاعرك وكأنّها مشاعري

95
00:09:44,200 --> 00:09:45,140
...لكن

96
00:09:45,670 --> 00:09:48,870
،ما دمت تركعين للسيّد هايدريخ

97
00:09:48,870 --> 00:09:50,730
.كلّ ما سوف تكسبينه هو الحرب الأبديّة

98
00:09:51,100 --> 00:09:54,230
.سوف تسجنين من تحبّين في الجحيم

99
00:09:55,560 --> 00:09:59,200
.لذا، لن أسمح بتدفّق فالهالا

100
00:09:59,200 --> 00:10:04,090
.سآخذ فقط الذهب الذي هو إحياء الموتى

101
00:10:05,170 --> 00:10:07,650
!آهٍ يا بجعتي الحبيبة والعزيزة

102
00:10:08,370 --> 00:10:14,210
اشهدي هذا البوق وهذا السيف وهذا
!الخاتم وأنعمي عليه بالثلاثة أجمعين

103
00:10:16,340 --> 00:10:17,220
!توقف

104
00:10:18,630 --> 00:10:21,210
!توقف! رجاءً

105
00:10:21,210 --> 00:10:22,850
!لا تفعل ذلك هنا

106
00:10:24,370 --> 00:10:26,300
...وا عجبي

107
00:10:26,300 --> 00:10:28,600
.هذا يسهّل الأمور

108
00:10:29,170 --> 00:10:34,360
لم أرد استخدام هذا أكثر من
.مرّة في اليوم إن استطعت

109
00:10:38,120 --> 00:10:39,530
!انبطحي! بسرعة

110
00:10:39,980 --> 00:10:42,240
.لا داعي للخوف يا تريجيا

111
00:10:42,850 --> 00:10:45,200
.سوف أنقذك، أعدك

112
00:10:45,780 --> 00:10:52,370
لأنّي تقتُ لأكون أقوى وأحصن شخصٍ أعرفه

113
00:10:52,870 --> 00:10:55,840
،راينارد هايدريخ

114
00:10:55,840 --> 00:10:57,880
!حتّى لا تُدمّر الأشياء التي أحبّها مجدّدًا

115
00:10:57,880 --> 00:10:58,840
!لن أسمح لك

116
00:10:58,840 --> 00:10:59,840
!توقف

117
00:10:59,840 --> 00:11:01,840
.برياه

118
00:11:03,260 --> 00:11:08,770
.فاناهيمر― البجعة الذهبية لوهينغرين

119
00:11:13,940 --> 00:11:14,980
.أجل

120
00:11:15,510 --> 00:11:19,440
إن استخدمت هذه لتدمير الطريق
،الذي يوصل بينك وإيزاك

121
00:11:19,950 --> 00:11:23,820
سيختار الصليب المعقوف الجسد
.التّالي في الصف لأجل رحِمه

122
00:11:25,240 --> 00:11:27,200
...وحينها

123
00:11:30,160 --> 00:11:33,130
.لقد كشفت عن نفسك الحقيقية أيها الحثالة

124
00:11:41,490 --> 00:11:43,750
.اعرف مكانك أيها الهجين

125
00:11:44,420 --> 00:11:46,100
،مهما حاولت بجدّ

126
00:11:46,100 --> 00:11:48,890
.لن تصل أبدًا للسيّد هايدريخ

127
00:11:58,260 --> 00:12:02,390
.أيها الحثالة الغدّار، حان الوقت لتموت

128
00:12:07,030 --> 00:12:09,290
.يبدو أنّه قد عُصف بنا

129
00:12:09,290 --> 00:12:11,330
.السينباي ليست هنا

130
00:12:11,770 --> 00:12:13,120
...ما يعني

131
00:12:13,120 --> 00:12:15,580
.المدرسة أو البرج

132
00:12:15,580 --> 00:12:18,090
إنهما الصليبان المتبقيان فقط، صحيح؟

133
00:12:18,400 --> 00:12:21,970
.يبدو أنّ علينا أن ننفصل على ما أظن

134
00:12:23,050 --> 00:12:24,800
.لا يوجد وقت

135
00:12:24,800 --> 00:12:26,790
.فلنقرّر من يستخدمها

136
00:12:41,150 --> 00:12:42,600
.فهمت

137
00:12:43,250 --> 00:12:45,660
شرف محارب، أليس كذلك؟

138
00:12:46,520 --> 00:12:50,620
تريد أن تقاتل فوجي-سان في
.أسرع وقتٍ ممكن حسبما أرى

139
00:12:51,020 --> 00:12:54,370
.توقّعتُ أنّك لا تملك الوقت لتتعامل معي

140
00:12:54,370 --> 00:12:55,670
.صحيح

141
00:12:56,120 --> 00:12:59,880
.بالنّسبة لي، قتالي معه هو حربي الأخيرة

142
00:13:00,320 --> 00:13:03,770
.لذا يجب أن يكون في المرحلة النهائية

143
00:13:05,340 --> 00:13:08,800
.وأنت تُعيق ذلك أيها الكأس المقدّس

144
00:13:09,860 --> 00:13:12,640
!لذا عليّ أن أتخلّص منك

145
00:13:26,820 --> 00:13:28,110
.لا جدوى

146
00:13:32,070 --> 00:13:34,830
،واثق أنّك تستطيع النجاة من هذا

147
00:13:35,160 --> 00:13:36,900
لكن ماذا عن الآخرين؟

148
00:13:38,020 --> 00:13:40,710
.سأتحمّل كامل المسؤولية لحمايتها

149
00:13:41,400 --> 00:13:43,280
.لكن لا أهتم للبقية

150
00:13:43,280 --> 00:13:44,510
.ليست مشكلتي

151
00:13:45,460 --> 00:13:46,970
.تماسك يا ماكينا

152
00:13:46,970 --> 00:13:49,800
.يجدر بك أن تستطيع تجنّب الإبادة على الأقل

153
00:13:50,420 --> 00:13:52,970
.لا بأس. لا مشكلة

154
00:13:54,840 --> 00:13:56,710
.بوسعي أن أرى الخدعة التي تنوي لها

155
00:13:57,130 --> 00:13:58,900
أحد التوائم، صحيح؟

156
00:13:58,900 --> 00:14:00,920
.سلالة يوهان

157
00:14:00,920 --> 00:14:03,220
.زونينكيند غير مكتمل

158
00:14:03,220 --> 00:14:06,330
،لذا إن استخدمتها لتفعيل الصليب المعقوف

159
00:14:06,330 --> 00:14:08,860
.فستتسبّب بعُطل في الكيمياء الذهبيّ

160
00:14:09,540 --> 00:14:15,080
أنت تخطّط لختم السيّد هايدريخ بينما
تحاول إحياء الموتى، صحيح؟

161
00:14:15,650 --> 00:14:18,080
.لا يهمّني

162
00:14:19,030 --> 00:14:21,040
.انتهى الأمر يا كريستوف

163
00:14:21,040 --> 00:14:24,590
.حجّك ينتهي هنا

164
00:14:30,420 --> 00:14:32,900
هل تحتاجين إلى تفسير يا تريجيا؟

165
00:14:34,930 --> 00:14:39,240
.ما يقبع في صميمه كراهية الذّات التي تضاهي الجنون

166
00:14:39,880 --> 00:14:42,310
،لا يستطيع أن يغفر خطاياه وضعفه

167
00:14:42,310 --> 00:14:44,690
.لذا تاقَ ليكون قويًّا

168
00:14:45,560 --> 00:14:48,640
.لقد كان مهووسًا بالتغيير

169
00:14:49,780 --> 00:14:55,240
.أراد أن يصبح أقوى كائنٍ يعرفه، راينهارد هايدريخ

170
00:14:55,240 --> 00:14:56,810
وماذا حدث؟

171
00:14:57,370 --> 00:15:00,530
.أصبح بديلًا لزعيمنا، مكسيًا بالذهب

172
00:15:00,530 --> 00:15:06,070
.الجسد الذي يستخدمه الآن ينتمي للسيّد هايدريخ

173
00:15:06,800 --> 00:15:11,640
.ومنه يستمدّ مقاومته الجنونية للضرر

174
00:15:11,640 --> 00:15:16,890
جيش السيّد هايدريخ بأكمله
.يقبع داخل الكأس المقدّس

175
00:15:17,240 --> 00:15:21,690
.ما كنتُ لأستطيع حتّى إيذاءه عادةً

176
00:15:21,690 --> 00:15:23,460
.لكنّ ماكينا مختلف

177
00:15:23,460 --> 00:15:25,970
.قبضتاه تحطّم كلّ شيء

178
00:15:28,310 --> 00:15:29,860
.تخيّلي ذلك

179
00:15:30,390 --> 00:15:32,210
.كسَدٍّ يتحطّم

180
00:15:32,690 --> 00:15:34,420
،عندما يُخترق السدّ

181
00:15:34,420 --> 00:15:37,950
.جيش فالهالا برمّته سوف يتسرّب إلى هذا العالم

182
00:15:39,730 --> 00:15:42,020
.حينها تبدأ مهمّتك

183
00:15:42,650 --> 00:15:45,790
.اصبغي كلّ شيء بألوان السيّد هايدريخ

184
00:15:45,790 --> 00:15:49,510
،إلى جانب ذلك يا فتاة

185
00:15:49,510 --> 00:15:53,560
لمَ كنتِ تحدّقين بي؟

186
00:15:54,410 --> 00:15:57,470
.أخبرني بشيءٍ واحد

187
00:15:58,280 --> 00:16:02,810
ما هو إحياء الموتى الذي يعرضه السيّد هايدريخ؟

188
00:16:04,050 --> 00:16:05,310
هل أنت غبيّة؟

189
00:16:05,640 --> 00:16:07,570
.يعني أن تكوني مثلي

190
00:16:10,870 --> 00:16:13,560
.عالم السيّد هايدريخ في فالهالا

191
00:16:14,070 --> 00:16:16,780
...والمحاربون الذين يجتمعون هناك

192
00:16:16,780 --> 00:16:22,710
ألا تعرفينهم؟ الأبطال، الذين يُعاد
.إحياءهم ويقاتِلون إلى الأبد

193
00:16:24,070 --> 00:16:25,930
.عالم الحرب

194
00:16:26,360 --> 00:16:28,500
.نعيم حربٍ لا تنتهي

195
00:16:29,010 --> 00:16:31,700
،عندما يكتمل الكيمياء الذهبيّ

196
00:16:31,700 --> 00:16:34,970
.مشيئة السيّد هايدريخ سوف تلتهم العالم

197
00:16:35,430 --> 00:16:40,180
سوف يعيدون صباغة هذا العالم
.بألوانهم ويحكمون كقانون جديد

198
00:16:42,760 --> 00:16:48,150
!إ-إذًا... لن يتغيّر أيّ شيء إطلاقًا

199
00:16:49,910 --> 00:16:52,010
...أردتُ أن أحظى بهما

200
00:16:52,010 --> 00:16:55,160
لكي أغيّر قدرهما المحتّم عليهما
...بالقتال، حتّى بعد الموت

201
00:16:55,810 --> 00:16:56,730
...ذلك

202
00:16:59,220 --> 00:17:03,200
!ذلك ليس ما قاتلتُ لأجله

203
00:17:06,230 --> 00:17:10,420
أنتم أيها الحمقى دائمًا ما تكرّرون
.نفس الخطأ عندما تتكلّمون

204
00:17:11,170 --> 00:17:13,470
.أجل، خذي العبرة من النّار

205
00:17:14,980 --> 00:17:16,720
.هذه الحياة

206
00:17:16,720 --> 00:17:19,700
،يحاول الجميع جاهدين حمايتها
.لحمايتها من الإخماد

207
00:17:20,690 --> 00:17:22,220
فماذا يفعلون؟

208
00:17:23,560 --> 00:17:25,930
.يسرقون من غيرهم ليضيفوا لأنفسهم

209
00:17:27,090 --> 00:17:29,900
.هذا ما يعنيه أن تعيش

210
00:17:30,420 --> 00:17:31,650
...بعبارة أخرى

211
00:17:32,650 --> 00:17:35,760
،إن أردتِ إضرام نارٍ لأجل أولئك الذين اختفوا

212
00:17:35,760 --> 00:17:38,620
.فخيارك الوحيد هو أن توصليهم بنارٍ أكبر

213
00:17:39,080 --> 00:17:41,620
وأن تمنحيهم الشرّف

214
00:17:41,620 --> 00:17:45,750
ليتّحدوا مع السيّد هايدريخ
!ويذوبوا في فالهالا الذهبية

215
00:17:46,180 --> 00:17:47,960
لمَ لا تحتفلين؟

216
00:17:50,420 --> 00:17:51,710
.لا يهم

217
00:17:51,710 --> 00:17:52,300
.اختفي

218
00:17:57,370 --> 00:17:58,890
برق...؟

219
00:18:03,190 --> 00:18:04,410
.فهمت

220
00:18:04,410 --> 00:18:06,690
كنتَ تعرف؟

221
00:18:06,690 --> 00:18:10,730
.لاحظت ذلك قبل أيّامٍ فحسب

222
00:18:13,220 --> 00:18:14,620
.فهمت

223
00:18:14,620 --> 00:18:18,070
.ها أنت يا كيرخيايزن

224
00:18:29,920 --> 00:18:31,370
.جيد

225
00:18:31,370 --> 00:18:34,050
.سوف أنقذك

226
00:18:34,570 --> 00:18:38,180
.فلنتقابل في فالهالا يا فالكيري خاصتي

227
00:18:44,720 --> 00:18:47,180
!لا

228
00:19:00,670 --> 00:19:01,440
...اللّعنة عليك

229
00:19:03,250 --> 00:19:04,620
...اللّعنة عليك

230
00:19:05,220 --> 00:19:06,410
!اللّعنة عليك

231
00:19:06,410 --> 00:19:08,500
!خذي هذه

232
00:19:12,710 --> 00:19:13,920
.مذهل

233
00:19:13,920 --> 00:19:15,500
وماذا إذًا؟

234
00:19:19,030 --> 00:19:21,770
.كلّ هذا لاكتساب الوقت

235
00:19:21,770 --> 00:19:23,760
.في النهاية، سوف يأتي

236
00:19:24,450 --> 00:19:29,520
وعندما يحدث ذلك، هل ستستطيع
التحكّم بنبضات قلبك؟

237
00:19:29,910 --> 00:19:31,240
.فهمت

238
00:19:32,600 --> 00:19:34,970
.لقد اقترفتَ خطأين

239
00:19:35,430 --> 00:19:39,690
.أوّلًا، من تنتظره لن يصل في الوقت المناسب

240
00:19:41,030 --> 00:19:42,530
!رين

241
00:19:53,460 --> 00:19:55,290
.لستِ سيّئة يا فتاة

242
00:19:55,290 --> 00:19:56,790
.لقد أهملتُ دفاعي

243
00:20:00,220 --> 00:20:02,880
.تفضّلي هذه المكافأة

244
00:20:04,610 --> 00:20:07,180
.ستكونين مالكته القادمة

245
00:20:07,180 --> 00:20:09,180
.قاتلي به بكلّ جهدك

246
00:20:09,970 --> 00:20:11,590
.سأتركك تعيشين في الوقت الرّاهن

247
00:20:12,010 --> 00:20:15,060
.سوف تُقدّمين إلى الصليب المعقوف الأخير

248
00:20:17,750 --> 00:20:20,900
،والآن، أهدرتُ بعضًا من وقتي

249
00:20:21,690 --> 00:20:24,070
.لكنّ مهمّتي قد أُنجزت

250
00:20:24,770 --> 00:20:26,530
.هذا خطأك الثاني

251
00:20:26,920 --> 00:20:32,550
،في وجه رغبتي العظيمة
.لا جدوى من محاولتك كسب الوقت

252
00:20:33,450 --> 00:20:34,610
.الموت

253
00:20:37,670 --> 00:20:42,450
،هذا السمّ سوف يلوّثك ويلتهم قلبك حتّى يتوقّف

254
00:20:42,450 --> 00:20:45,090
،وهذا السمّ اللّعين، وجراحك

255
00:20:45,090 --> 00:20:47,600
.سوف تختفي دون ترك أيّ أثر

256
00:20:49,650 --> 00:20:51,220
والآن، ماذا ستفعل؟

257
00:20:51,780 --> 00:20:54,980
أما زلت فالحًا في قتل الأطفال فحسب؟

258
00:20:58,020 --> 00:20:59,070
!اخرس

259
00:20:59,540 --> 00:21:01,300
!لن أخسر

260
00:21:01,810 --> 00:21:03,570
!لا يمكنني أن أموت

261
00:21:04,090 --> 00:21:07,040
...سوف أستمرّ في السّير إلى الأبد

262
00:21:07,040 --> 00:21:08,950
!لن أتوقّف أبدًا

263
00:21:09,270 --> 00:21:11,840
...سوف أُكفّر إلى الأبد

264
00:21:11,840 --> 00:21:17,380
!لا أحتاج إلى نهاية مريحة مثل هذه التي تقدّمها لي

265
00:21:17,380 --> 00:21:23,420
!فاناهيمر― البجعة الذهبية لوهينغرين

266
00:21:25,160 --> 00:21:27,970
!ملحمة ميدغارد فولسونغا

267
00:21:36,740 --> 00:21:38,810
.أحسنت صنعًا أيها الكأس المقدّس

268
00:21:39,570 --> 00:21:42,320
.عش إلى الأبد داخلي

269
00:21:42,770 --> 00:21:46,130
.لقد حانت السّاعة الموعودة يا كارل

270
00:24:10,470 --> 00:24:15,470
رسم: تاكايا توفو