1
00:00:10,320 --> 00:00:15,660
لا أستطيع الانخراط في أغنية حبّ

2
00:00:15,660 --> 00:00:21,150
غُنِّيَتْ لمليون إنسان

3
00:00:21,150 --> 00:00:27,740
يطلبُ مني أهل هذه البلدة أن أحبّ شخصاً ، ولكن كلّ ما في الأمر

4
00:00:28,920 --> 00:00:31,410
!الحبّ السهل! يأتي بسرعة! ويذهب بسُرعة

5
00:00:32,040 --> 00:00:37,200
المستقبل أكثر واقعيّة مما تصوّرت

6
00:00:37,510 --> 00:00:42,910
تبدو السيّارات وكأنها لن تطير لفترة من الزمن

7
00:00:42,910 --> 00:00:48,060
وها أنا اليوم ، في النفق من جديد

8
00:00:48,060 --> 00:00:53,500
غادرَتني البلدة وصمت الغُرباء

9
00:00:53,500 --> 00:00:59,460
لهذا أنا وحيد وحيد حتّى في اللّيالي
وحيد جداً لدرجةِ أننا أوشكنا على الانفصال

10
00:00:59,460 --> 00:01:04,850
وحيد وحيد  وحدُك من يبقى
صادقاً بحبِّه الأصيل

11
00:01:04,850 --> 00:01:10,320
وحيد وحيد  كلّ يوم عندما
أتجمّد وأشتاق إليك

12
00:01:10,320 --> 00:01:16,060
لقد قررتُ ألا أجبر نفسي على أن أقول ما لا أستطيع قوله

13
00:01:16,060 --> 00:01:21,250
ذلك الشخص هو الوحيد القادر على أن يُلهِب قلبي

14
00:01:21,550 --> 00:01:24,020
... ليتني أستطيع النسيان

15
00:01:24,020 --> 00:01:26,560
اعشقني اعشقني
فهذا القلب قويّ لكنه ضعيف

16
00:01:26,560 --> 00:01:30,530
قبّلني قبّلني
في ليالٍ أعيشها وحيداً ويائساً

17
00:01:32,520 --> 00:01:35,430
لا أحد يعلم ما الذي يعنيه الحبّ

18
00:01:37,970 --> 00:01:40,770
هل تعلم كيف تستمرّ أغنية الحبّ؟

19
00:01:42,330 --> 00:01:44,710
المشهد 56 , التصوير 2

20
00:01:43,180 --> 00:01:45,810
خطير
متحرِّي الديناميت

21
00:01:44,710 --> 00:01:46,120
ابدأ

22
00:01:53,550 --> 00:01:54,520
اقطع

23
00:01:55,000 --> 00:01:55,990
غبيّ

24
00:01:56,430 --> 00:01:58,640
تأخرتَ كثيراً ، ينبغي أن تكون ميّتاً الآن

25
00:01:58,640 --> 00:02:00,930
لقد بلغَ فتيل الديناميت حدَّه الأقصى

26
00:02:01,670 --> 00:02:03,520
أنا آسف

27
00:02:03,520 --> 00:02:04,870
دعني أُحاول مرّة أُخرى

28
00:02:05,320 --> 00:02:06,800
بالطبع

29
00:02:07,300 --> 00:02:11,840
حسناً ، ريثما نجهِّز أنفسنا ، استريحوا

30
00:02:13,240 --> 00:02:16,160
لا بدّ وأنها كانَتْ صدمة بالنسبةِ لهيتومي

31
00:02:16,640 --> 00:02:18,710
... ليس هيتومي فحسب

32
00:02:18,710 --> 00:02:22,240
بل كلّ الأولاد قد أحبّوا المعلِّمة ساغارا

33
00:02:22,240 --> 00:02:28,010
الوالِدان قد حجّموا المسألة وباتَ الأمر حديث الناس

34
00:02:29,110 --> 00:02:31,040
... حدثَ ذلك في هذا الرّبيع

35
00:02:31,490 --> 00:02:34,760
منذُ ذلك الحين وهيتومي بهذا الشّكل

36
00:02:35,440 --> 00:02:38,840
لا تستطيعُ أن تتأقلم مع مدرستها أيضاً

37
00:02:38,840 --> 00:02:40,170
حقّاً ؟

38
00:02:40,830 --> 00:02:41,920
انتهيت

39
00:02:41,920 --> 00:02:44,520
آزوسا ، هل بمقدوركِ أن تأخذيه إلى هناك ؟

40
00:02:45,400 --> 00:02:47,070
ماذا ؟ بالتأكيد

41
00:02:47,410 --> 00:02:51,520
بصراحة ، لا أعرف ماذا أقولُ لهيتومي

42
00:02:52,210 --> 00:02:55,280
ربّما لأنّ زوجتي ماتَتْ عندما كانَتْ هيتومي صغيرة

43
00:02:55,880 --> 00:03:00,530
ربّما اعتبرَتِ المعلِّمة ساغارا أمّها

44
00:03:00,530 --> 00:03:02,380
... أمّها

45
00:03:02,380 --> 00:03:06,170
العلاقاتُ بين المعلّم والتلميذ صعبة

46
00:03:07,690 --> 00:03:10,660
جيّد ، هذا جيّدٌ جداً

47
00:03:11,100 --> 00:03:12,710
لقد عشتُ فقيراً في هذه الأيّام

48
00:03:12,710 --> 00:03:15,960
لقد كنتُ آكُل معكرونة فوريّة على الفطور

49
00:03:16,780 --> 00:03:19,670
لقد حضّرتُ كميةً كبيرة ، كُلوا ما تشاؤون

50
00:03:20,180 --> 00:03:24,780
يجبُ أن أذهب للتسوّق في البلدة اليوم ، يجبُ عليّ المغادرة حالاً

51
00:03:24,780 --> 00:03:25,600
شكراً لك

52
00:03:25,600 --> 00:03:30,280
حقّاً ؟ سآكلُ حتّى الشبع بما أنّك عرضتَ ذلك إذاً

53
00:03:30,280 --> 00:03:33,690
إن كنتَ لا تُريد قطعَ اللّحم والبيض فسآكلُها أنا

54
00:03:33,690 --> 00:03:35,820
مُستحيل ، إنني أتركُ الطّعامَ المفضَّل حتى النّهاية

55
00:03:36,160 --> 00:03:40,360
وماذا ستفعلُ إذا حدثَ زلزال ؟

56
00:03:40,630 --> 00:03:43,490
ينبغي أن تأكلَ طعامك المفضَّل أولاً

57
00:03:44,120 --> 00:03:45,370
توقّف

58
00:03:45,970 --> 00:03:48,600
أعطني إيِّاها يا سيّد موراي

59
00:03:48,600 --> 00:03:52,080
لا تنادِني "سيّد" ، يثيرُ هذا اشمئزازي

60
00:03:52,080 --> 00:03:53,220
أعطني إيِّاها أرجوك

61
00:03:53,220 --> 00:03:54,420
قلتُ كلّا

62
00:03:54,420 --> 00:03:57,560
حقاً ؟ لا أملك خياراً آخر إذاً

63
00:04:04,150 --> 00:04:06,700
شكراً جزيلاً لك على كلّ شيء

64
00:04:06,700 --> 00:04:08,620
أنا مدينٌ لك

65
00:04:08,620 --> 00:04:10,620
ذلك المعلّم جيّد

66
00:04:12,020 --> 00:04:13,320
أتقصدُ أونيزكا ؟

67
00:04:13,960 --> 00:04:15,760
إنه جيّد لأنّه يضعُ نفسه بنفس مُستوى الصِّغار

68
00:04:17,960 --> 00:04:22,370
ربّما كانَ من الأفضل بالنسبةِ لهيتومي لو كانَ لديها معلّم مثله

69
00:04:22,370 --> 00:04:26,440
أنا رجلٌ ريفيّ ولا أعرف شيئاً عن المدارس في طوكيو

70
00:04:26,910 --> 00:04:32,060
الشيء الوحيد الّذي أعرفُه هو أن كلّ عمل وله سلبياته

71
00:04:32,060 --> 00:04:32,910
... حضرة المالك

72
00:04:34,040 --> 00:04:36,600
... إذا قطعتِ هذه المسافة إلى هنا كلّما واجهتِ مشكلة

73
00:04:36,600 --> 00:04:37,850
ستصبحُ تكاليف النّقل باهظة

74
00:04:38,240 --> 00:04:40,690
قالَ أونيزكا نفس الكلام

75
00:04:40,690 --> 00:04:43,060
حقّاً ؟ يا إلهي

76
00:04:43,060 --> 00:04:47,820
إنّني أقدمُ الكثير من المواعِظ عندما تكونُ لديّ مشاكل مع ابنتي

77
00:04:48,100 --> 00:04:49,200
إلى اللقاء

78
00:04:49,200 --> 00:04:51,120
شكراً جزيلاً لك

79
00:04:58,240 --> 00:05:00,000
مقزِّز

80
00:05:00,000 --> 00:05:03,940
... معلّم ، إن لم أعد إلى طوكيو الآن

81
00:05:03,940 --> 00:05:06,580
سينزعج مديري منّي

82
00:05:06,580 --> 00:05:09,950
هذا صحيح ، نسيتُ الدرس

83
00:05:10,500 --> 00:05:14,680
ولكن قطعنا هذه المسافة ، لِمَ لا نذهب للسياحة ؟

84
00:05:15,100 --> 00:05:16,520
هذا ليسَ سبب وجودنا هنا

85
00:05:16,790 --> 00:05:19,880
أكلتَ لحمتي وبيوضي

86
00:05:20,460 --> 00:05:23,040
لندعه وشأنه ونعود إلى المنزل

87
00:05:24,550 --> 00:05:26,710
أنا آسفة جداً يا جماعة

88
00:05:26,710 --> 00:05:28,840
أنا بخير الآن

89
00:05:28,840 --> 00:05:32,070
أونيزكا ، هلّا أخذتهم إلى طوكيو ؟

90
00:05:33,220 --> 00:05:35,540
ماذا ستفعلين ؟

91
00:05:35,870 --> 00:05:37,500
... يخطرُ أمرٌ ما في ذهني

92
00:05:39,270 --> 00:05:41,480
حسناً ، أراكم في المدرسة غداً

93
00:05:53,000 --> 00:05:56,090
هل تعني بأنه لا يحقّ للمعلّمة أن تحبّ ؟

94
00:05:56,510 --> 00:05:59,260
هل ستبرّرين ما فعلتيه ؟

95
00:05:59,260 --> 00:06:01,880
ماذا ستقولين للأولاد ؟

96
00:06:02,560 --> 00:06:04,700
لا أنوي اختلاق أيّ أعذار

97
00:06:05,290 --> 00:06:07,270
سأخبرُهم بالحقائق كما هي فقط

98
00:06:12,680 --> 00:06:13,740
نسيم عليل

99
00:06:19,080 --> 00:06:19,780
ما زلتِ هنا

100
00:06:20,390 --> 00:06:21,250
نعم

101
00:06:21,650 --> 00:06:22,980
هل يمكنني الجلوس هنا ؟

102
00:06:25,740 --> 00:06:27,190
لماذا أتيتِ إلى هنا ؟

103
00:06:27,190 --> 00:06:28,940
لقد سئمتُ من المواعظ

104
00:06:29,420 --> 00:06:31,980
... لم آتِ لأجلِ ذلك ، قبلَ أن أعود إلى طوكيو

105
00:06:31,980 --> 00:06:34,330
أردتُ أن أتكلّم معكِ مرّة أخرى

106
00:06:34,750 --> 00:06:36,760
أتيتِ إلى هنا لإعطاءِ المواعظ

107
00:06:36,760 --> 00:06:38,020
لا

108
00:06:38,720 --> 00:06:39,730
... أنا فقط

109
00:06:40,160 --> 00:06:41,930
بل فعلتِ

110
00:06:41,930 --> 00:06:45,440
مهما تكلّمتِ ، لن تعودَ المعلّمة ساغارا أبداً

111
00:06:49,070 --> 00:06:51,940
هل تريدينها أن تعود ؟

112
00:06:54,940 --> 00:06:56,650
بلى ، أريد

113
00:06:57,140 --> 00:07:00,010
لقد تركَتْنا وغادرَتْ مع رجل

114
00:07:00,010 --> 00:07:01,490
أريدُها أن تعتذر منّا على ذلك

115
00:07:02,000 --> 00:07:05,980
لكنّكِ لم تسمعي روايتها

116
00:07:05,980 --> 00:07:07,190
روايتها ؟

117
00:07:07,190 --> 00:07:09,090
هل ستتمكّن من تبريرِ ممارسة علاقة ؟

118
00:07:09,380 --> 00:07:11,040
لا توجدُ أيّ رواية هنا

119
00:07:12,760 --> 00:07:13,840
... هيتومي

120
00:07:13,840 --> 00:07:15,070
... نا ، معلّمة

121
00:07:15,570 --> 00:07:17,320
لا ، بل أنا بحدِّ ذاتي

122
00:07:17,320 --> 00:07:21,120
رمت التّلميذات الماءَ عليّ

123
00:07:21,120 --> 00:07:22,010
ماذا ؟

124
00:07:22,010 --> 00:07:24,080
... قلنَ لي

125
00:07:24,080 --> 00:07:26,860
"دائماً ما تعطين انطباعَ امرأة"

126
00:07:26,860 --> 00:07:29,040
"لا تدّعِ بأنكِ معلّمتنا"

127
00:07:30,360 --> 00:07:33,250
لم تكُن لديّ نيّة للقيامِ بذلك

128
00:07:35,490 --> 00:07:37,890
... قال أبوكِ

129
00:07:37,890 --> 00:07:41,260
"العلاقة بين المعلّم والتلميذ صعبة"

130
00:07:41,720 --> 00:07:45,280
مع ذلك ، أنا والمعلِّمة ساغارا معلِّمتان

131
00:07:45,280 --> 00:07:47,400
لا أستطيعُ تغيير هذه الحقيقة

132
00:07:47,400 --> 00:07:49,270
هذا واضح

133
00:07:49,270 --> 00:07:52,740
أنا فقط لا أستطيعُ مُسامحتها بعدَ أن تخلَّتْ عن الجميع

134
00:07:52,740 --> 00:07:56,670
لم تمارس علاقةً كي تتركَكم جميعاً

135
00:07:56,670 --> 00:07:58,050
هذا كثير جداً

136
00:07:58,050 --> 00:08:00,510
تبقى النّتيجة ذاتها وهي أنّها تخلَّتْ عنّا

137
00:08:01,000 --> 00:08:03,430
ولكن أريدكِ أن تفهمي هذا

138
00:08:04,000 --> 00:08:07,980
إنها تهتمُّ بكم جميعاً صدّقيني

139
00:08:08,750 --> 00:08:10,780
لا شكّ في ذلك

140
00:08:10,780 --> 00:08:13,300
لهذا أردتُ أن أصبحَ معلِّمة

141
00:08:13,300 --> 00:08:16,830
بعدَ أن رأيتُ الرابط القويّ بينكم وبينها

142
00:08:16,830 --> 00:08:20,760
ارتكبَتْ خطأ صغيراً واحداً فقط

143
00:08:20,760 --> 00:08:22,460
ألا تتذكّرين كم كانَتْ أيّاماً ممتعة ؟

144
00:08:22,460 --> 00:08:25,930
هي وأنتِ وكلّهم كانوا مشرقين

145
00:08:26,560 --> 00:08:31,670
كرهُها يعني كره كلّ تلك الذكريات

146
00:08:31,670 --> 00:08:33,910
هل أنتِ راضية عن ذلك ؟

147
00:08:34,520 --> 00:08:35,920
هيتومي

148
00:08:41,700 --> 00:08:42,750
آنسة آزوسا

149
00:08:43,080 --> 00:08:44,640
أنا آسفة

150
00:08:44,640 --> 00:08:47,720
حاولتُ التفكير بهذه الطريقة كثيراً

151
00:08:48,500 --> 00:08:49,720
... لكنّني

152
00:08:50,200 --> 00:08:52,080
لا أستطيع مسامحة المعلِّمة ساغارا

153
00:08:52,080 --> 00:08:53,470
... هيتومي

154
00:08:56,250 --> 00:08:59,420
ستُهدَمُ تلك المدرسة قريباً

155
00:09:00,470 --> 00:09:01,830
هذا جيّد

156
00:09:01,830 --> 00:09:02,900
... أفضِّل أن

157
00:09:02,900 --> 00:09:05,340
إسمنت

158
00:09:03,610 --> 00:09:05,340
يُمسَح كل شيء

159
00:09:06,490 --> 00:09:09,130
قد يكون كذلك

160
00:09:09,130 --> 00:09:12,250
فهذا أسهل بكثير

161
00:09:12,820 --> 00:09:13,710
... أونيزكا

162
00:09:14,160 --> 00:09:17,180
رائع ، يبدو المعلّم أونيزكا حادّاً

163
00:09:17,510 --> 00:09:20,740
يمكنُ القول بأنه أكثر شخصٍ أناني في اليابان

164
00:09:20,740 --> 00:09:22,590
مجرّد غبيّ بسيط

165
00:09:22,590 --> 00:09:23,590
وربّما أسوأ غبيّ

166
00:09:24,200 --> 00:09:28,090
وماذا يعني إذا مارسَ معلّمٌ علاقة ؟

167
00:09:28,500 --> 00:09:30,270
ما خطبك يا أونيزكا ؟

168
00:09:30,270 --> 00:09:33,570
حتّى لو أردتُ ممارسة علاقة ،  لستُ متزوّجاً

169
00:09:34,210 --> 00:09:37,000
وليسَتْ لديّ صديقة حتى

170
00:09:37,810 --> 00:09:41,470
ودائماً لا أملك إلّا 50 ين في جيبي قبلَ يوم من تقاضي الرّاتب

171
00:09:41,940 --> 00:09:46,410
وحتّى اليوم أنا مضطرٌّ لاستدانةِ المال من موراي كي أعودَ إلى طوكيو

172
00:09:46,810 --> 00:09:48,640
ماذا ؟ ماذا يقول ؟

173
00:09:48,640 --> 00:09:50,650
كفاكَ مزاحاً ، لماذا أنا ؟

174
00:09:51,530 --> 00:09:52,680
خمسون ين ؟

175
00:09:52,680 --> 00:09:54,590
... نعم ! و

176
00:09:54,890 --> 00:09:56,030
أوه

177
00:09:56,830 --> 00:09:58,560
عن ماذا كنتُ أتكلّم ؟

178
00:10:00,460 --> 00:10:02,490
أوه هذا صحيح ، عن ممارسة العلاقة ، الممارسة

179
00:10:03,570 --> 00:10:04,600
اسمعي

180
00:10:04,600 --> 00:10:07,170
... أهمّ شيء يجبُ أن تتذكّريه هو

181
00:10:07,170 --> 00:10:10,330
حتّى لو مارس معلّم علاقة ، أو هُدِمَتِ المدرسة

182
00:10:10,330 --> 00:10:12,230
.. أو ثارَ جبلُ فوجي

183
00:10:12,230 --> 00:10:16,210
لا تزولُ الذكريات بسببِ أمور صغيرةٍ كهذه

184
00:10:16,740 --> 00:10:20,160
لا أعتقد بأنّ ثوران جبل فوجي يُعَدُّ شيئاً صغيراً

185
00:10:20,160 --> 00:10:21,680
إنه حقاً غبيّ

186
