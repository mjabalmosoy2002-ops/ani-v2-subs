1
00:00:10,320 --> 00:00:15,660
لا أستطيع الانخراط في أغنية حبّ

2
00:00:15,660 --> 00:00:21,150
غُنِّيَتْ لمليون إنسان

3
00:00:21,150 --> 00:00:27,740
يطلبُ مني أهل هذه البلدة أن أحبّ شخصاً ، ولكن كلّ ما في الأمر

4
00:00:28,920 --> 00:00:31,410
!الحبّ السهل! يأتي بسرعة! ويذهب بسُرعة

5
00:00:32,040 --> 00:00:37,200
المستقبل أكثر واقعيّة مما تصوّرت

6
00:00:37,510 --> 00:00:42,910
تبدو السيّارات وكأنها لن تطير لفترة من الزمن

7
00:00:42,910 --> 00:00:48,060
وها أنا اليوم ، في النفق من جديد

8
00:00:48,060 --> 00:00:53,500
غادرَتني البلدة وصمت الغُرباء

9
00:00:53,500 --> 00:00:59,460
لهذا أنا وحيد وحيد حتّى في اللّيالي
وحيد جداً لدرجةِ أننا أوشكنا على الانفصال

10
00:00:59,460 --> 00:01:04,850
وحيد وحيد  وحدُك من يبقى
صادقاً بحبِّه الأصيل

11
00:01:04,850 --> 00:01:10,320
وحيد وحيد  كلّ يوم عندما
أتجمّد وأشتاق إليك

12
00:01:10,320 --> 00:01:16,060
لقد قررتُ ألا أجبر نفسي على أن أقول ما لا أستطيع قوله

13
00:01:16,060 --> 00:01:21,250
ذلك الشخص هو الوحيد القادر على أن يُلهِب قلبي

14
00:01:21,550 --> 00:01:24,020
... ليتني أستطيع النسيان

15
00:01:24,020 --> 00:01:26,560
اعشقني اعشقني
فهذا القلب قويّ لكنه ضعيف

16
00:01:26,560 --> 00:01:30,530
قبّلني قبّلني
في ليالٍ أعيشها وحيداً ويائساً

17
00:01:32,520 --> 00:01:35,430
لا أحد يعلم ما الذي يعنيه الحبّ

18
00:01:37,970 --> 00:01:40,770
هل تعلم كيف تستمرّ أغنية الحبّ؟

19
00:01:42,670 --> 00:01:45,360
شكراً لعملك في حانة الزيّ الرسميّ

20
00:01:46,810 --> 00:01:50,400
هذا صحيح ، أظنّنا سحقنا أونيزكا تماماً

21
00:01:52,990 --> 00:01:54,220
ماذا؟ حفلة؟

22
00:01:54,840 --> 00:01:57,790
نعم ، حفلة للاحتفالِ بطرد أونيزكا

23
00:01:58,600 --> 00:02:00,850
... أفكِّرُ بحجز جناح في فندق

24
00:02:00,850 --> 00:02:03,180
ونحتفِل بعرض يستأثر الانتباه

25
00:02:03,180 --> 00:02:05,410
حقاً!؟ هل أنتِ جادّة؟ سأشارك

26
00:02:06,110 --> 00:02:07,480
أين سنحتفل؟

27
00:02:09,890 --> 00:02:11,260
... نعم ، أعرفه

28
00:02:11,860 --> 00:02:12,860
السّابعة من هذا المساء؟

29
00:02:14,480 --> 00:02:16,990
حسناً حسناً ، سأكون هناك

30
00:02:18,790 --> 00:02:19,770
أنتُما

31
00:02:20,110 --> 00:02:21,500
... اسمعا ، قالَتْ يوكو

32
00:02:23,720 --> 00:02:24,940
هذا ما أرتديه ، صحيح؟

33
00:02:27,120 --> 00:02:29,860
جيّد جيّد ، شكراً لكِ يا يوكو

34
00:02:30,410 --> 00:02:31,790
ماذا ستفعلين بميابي؟

35
00:02:32,220 --> 00:02:36,320
مهلاً ، حريّ بكِ ألّا تطرحي أسئلة

36
00:02:37,760 --> 00:02:40,400
هل تُريدينني أن أخبِر والديكِ عن حانة الزيّ الرسمي؟

37
00:02:55,840 --> 00:02:56,850
لا تقلقي

38
00:02:57,540 --> 00:02:59,790
الموعدُ النّهائي بعدَ يومين

39
00:03:00,410 --> 00:03:02,710
ستعودُ سيّارة المرسيدس بنز إليّ قبل ذلك الحين

40
00:03:02,710 --> 00:03:04,860
... ولكن إن لم تعد

41
00:03:06,460 --> 00:03:07,870
أوه عليّ الذهاب للعمل

42
00:03:13,990 --> 00:03:16,300
سأجعلُ درسي بعد الظهر حصّة دراسة

43
00:03:16,700 --> 00:03:18,770
هلّا تفقدتيهم بين الفيّنة والأخرى؟

44
00:03:19,390 --> 00:03:22,710
لا أحد يدري ما الذي قد يفعلوه في غيابِنا

45
00:03:23,790 --> 00:03:24,390
إلى اللقاء

46
00:03:25,060 --> 00:03:26,340
أونيزكا

47
00:03:28,560 --> 00:03:30,750
أظنُّه يثِقُ بالآخرين كثيراً

48
00:03:30,750 --> 00:03:31,780
معك حقّ

49
00:03:32,210 --> 00:03:35,490
احتمالُ استرجاع المرسيدس ضئيل جداً

50
00:03:36,020 --> 00:03:37,920
هل ستنتظرين على أيّ حال؟

51
00:03:38,300 --> 00:03:40,780
نعم ، يبقى الموعِد موعداً

52
00:03:46,670 --> 00:03:49,070
ما الامر حتّى استدعيتينا إلى هنا؟

53
00:03:51,780 --> 00:03:54,510
أردتُ أن أخبركما بشيء مثير

54
00:03:55,320 --> 00:03:57,830
... الأمرُ مشينٌ جداً

55
00:03:57,830 --> 00:04:00,110
ممّا جعلَني لا أستدعي سِواكما أيّها الجريئان

56
00:04:01,820 --> 00:04:02,280
انظرا

57
00:04:05,130 --> 00:04:05,880
ميابي

58
00:04:06,990 --> 00:04:09,520
إنها خطّةٌ لمعاقبتِكِ

59
00:04:10,440 --> 00:04:12,520
يجبُ أن تدفعي ثمنَ ما فعلتيه

60
00:04:13,000 --> 00:04:16,260
هذا ما تستحقُّه الأميرة الصغيرة الجاهلة

61
00:04:16,480 --> 00:04:18,560
كانزاكي ، ماذا فعلتِ؟

62
00:04:19,770 --> 00:04:20,700
كانزاكي

63
00:04:21,300 --> 00:04:22,280
... سنرى

64
00:04:23,460 --> 00:04:25,080
هنا ، هذا هو

65
00:04:25,080 --> 00:04:26,600
الجناح رقم 2801

66
00:04:26,890 --> 00:04:30,700
رائع ! هذه هي شقّة الطابق العلوي

67
00:04:30,700 --> 00:04:32,540
حسناً ، لنستعدّ

68
00:04:37,990 --> 00:04:40,720
مبروك تقاعد أونيزكا

69
00:04:42,230 --> 00:04:45,420
المكانُ مظلم ، ربّما لم يصل أحدٌ بعد

70
00:04:45,840 --> 00:04:47,680
ولكن السّاعة السابعة الآن

71
00:04:49,920 --> 00:04:51,220
ما هذا!؟

72
00:04:51,220 --> 00:04:52,530
لا تعبثوا معنا

73
00:04:52,530 --> 00:04:53,760
شغّلوا الإنارة بسرعة

74
00:05:03,100 --> 00:05:06,840
أعطيتَه المرسيدس بنز إذاً

75
00:05:06,840 --> 00:05:10,040
في الواقع ، يُدعى هذا بسلوك الرّحمة

76
00:05:10,040 --> 00:05:12,000
أنتَ غبيّ

77
00:05:12,000 --> 00:05:16,010
إنّها لعبةٌ نموذجيّة أدّاها محترف محتال تافه

78
00:05:16,390 --> 00:05:18,240
هذا ما يقوله لي الجميع

79
00:05:18,840 --> 00:05:21,470
... حتّى لو كانَتْ روايته صحيحة

80
00:05:21,470 --> 00:05:24,600
... إذا لم يُرجِع التلميذُ الذي كفلَه المالَ

81
00:05:24,600 --> 00:05:26,200
قُضي عليه

82
00:05:26,780 --> 00:05:27,930
قد يكون كلامك صحيحاً

83
00:05:28,780 --> 00:05:33,080
... ولكن أردتُ أن أثِقَ به

84
00:05:33,530 --> 00:05:37,570
... لأنّ حقيقة قِيام التّلميذ بطلبِ المساعدة تعني

85
00:05:37,570 --> 00:05:40,870
أنّه آمنَ بقدرةِ معلّمه على مساعدتِه

86
00:05:41,500 --> 00:05:44,200
... يعجبُني هذا النوع من المعلّمين

87
00:05:45,320 --> 00:05:47,830
معلّمين يثِقُ بهم تلاميذهم

88
00:05:48,890 --> 00:05:51,850
لا أعرفُ فيما إذا كانَ ينبغي أن أعتبرَ هذا تفاؤلاً أم غباء

89
00:05:53,520 --> 00:05:55,850
إلامَ تنظر؟

90
00:05:55,850 --> 00:05:58,010
لا داعي لرؤية هذا ، استمرّ في تنظيف النوافذ

91
00:05:58,010 --> 00:05:59,460
هذا ليسَ عدلاً

92
00:05:59,460 --> 00:06:03,390
أعطني إيّاه -
لا ، دعني -

93
00:06:03,390 --> 00:06:05,430
انتبه ، سنسقط

94
00:06:06,030 --> 00:06:08,520
كانزاكي ، ماذا خطّطتِ!؟

95
00:06:08,860 --> 00:06:13,140
أريدُ من ميابي وصديقاتها أن يسدّدنَ الـ 8 مليون ين

96
00:06:14,360 --> 00:06:15,870
عشرون مليون ين من كلّ فتاة

97
00:06:16,820 --> 00:06:20,780
أعتقدُ أنّ والديها يستطيعان دفع فدية

98
00:06:20,780 --> 00:06:22,010
تقصدين ... !؟

99
00:06:22,010 --> 00:06:23,180
لقد بالغتِ كثيراً

100
00:06:23,520 --> 00:06:25,150
حقّاً؟

101
00:06:30,010 --> 00:06:31,060
هل أنتِ جادّة؟

102
00:06:34,690 --> 00:06:36,780
لا جدوى من مُحاولة الاختباء

103
00:06:37,150 --> 00:06:38,440
افتحن

104
00:06:38,440 --> 00:06:40,700
ما الّذي يجري؟

105
00:06:40,700 --> 00:06:42,170
لا أدري

106
00:07:05,060 --> 00:07:05,820
ميابي

107
00:07:15,580 --> 00:07:17,480
مرحباً

108
00:07:17,970 --> 00:07:18,860
يورومي

109
00:07:18,860 --> 00:07:20,870
كيفَ هي حفلتكِ؟ أتستمتعين؟

110
00:07:21,170 --> 00:07:24,210
نصبتِ لنا كميناً! ماذا ستفعلين!؟

111
00:07:24,720 --> 00:07:28,960
عشرون مليون من كلّ منكن ، أي 60 مليون ين

112
00:07:29,310 --> 00:07:35,040
سنأخذُ منها 8 مليون ين لتسديدِ ديون أونيزكا

113
00:07:35,470 --> 00:07:38,100
يُدعى هذا بفدية

114
00:07:39,110 --> 00:07:42,430
هذه هي النتيجةُ الطبيعيّةُ لما بدأتيه

115
00:07:43,000 --> 00:07:45,260
هل تعين ما تتكلّمين عنه!؟

116
00:07:45,260 --> 00:07:46,360
سأتّصِل بالشرطة

117
00:07:47,080 --> 00:07:49,530
... إذا فعلتِ فسأُخبرهم بكلّ شيء

118
00:07:49,530 --> 00:07:52,310
بما في ذلك المال الّذي اختلستيه

119
00:07:52,620 --> 00:07:56,430
هذا إذا استطعتِ الخروج حيّة

120
00:07:58,190 --> 00:08:01,660
قلتُ لكِ أنّكِ إذا أثرتِ غضبي فستندمين

121
00:08:02,760 --> 00:08:03,540
ميابي

122
00:08:04,290 --> 00:08:05,510
اذهبي إلى الجحيم

123
00:08:08,200 --> 00:08:10,430
أين؟ أيّ غرفة!؟

124
00:08:10,730 --> 00:08:12,620
قلتُ لك لم أرَ شيئاً

125
00:08:12,620 --> 00:08:16,610
"أنت تكذب! قلتَ "أوه

126
00:08:24,630 --> 00:08:26,180
لا

127
00:08:27,550 --> 00:08:28,200
هل تريدُ أن تسمع؟

128
00:08:28,460 --> 00:08:31,170
ولو كنَّ سيّئات ، يبقين زميلاتنا في المدرسة

129
00:08:31,820 --> 00:08:33,510
عن ماذا تتكلّم؟

130
00:08:33,510 --> 00:08:37,790
يمكنُنا الحصول على 8 مليون ومُعاقبة ميابي وصديقتيها

131
00:08:38,130 --> 00:08:40,030
هذا أشبه بقتلِ عصفورين بحجرٍ واحد

132
00:08:40,030 --> 00:08:40,610
كفاكِ

133
00:08:40,890 --> 00:08:42,120
سأخرجُ من هنا

134
00:08:43,130 --> 00:08:43,930
كيكوتشي

135
00:08:44,350 --> 00:08:47,250
أبعد يديك عنّي

136
00:08:49,940 --> 00:08:50,960
قلتُ أبعد يديك عنّي

137
00:08:50,960 --> 00:08:53,890
قلتُ لك ، اتركني تباً لك

138
00:08:53,890 --> 00:08:57,740
توقّفوا! ماذا ستفعلون!؟ اتكروني

139
00:08:57,740 --> 00:09:00,640
ماذا ستفعلون!؟ ابتعدوا عنّا

140
00:09:00,640 --> 00:09:02,720
لا ، لا تقترب أكثر من ذلك

141
00:09:02,720 --> 00:09:03,610
اصمتي

142
00:09:14,040 --> 00:09:16,420
مرحباً ، إيكيتشي  أونيزكا ، 22 عاماً

143
00:09:17,840 --> 00:09:19,090
.. أوه كيكوتشي

144
00:09:19,780 --> 00:09:24,790
ميابي آيزاوا ، تشيكاكو شيراي ، سايكو إيجيما ، صحيح؟

145
00:09:32,650 --> 00:09:33,580
أجيبيني

146
00:09:37,160 --> 00:09:38,240
هذا ما حدث

147
00:09:44,490 --> 00:09:45,770
الوقتُ يُداهمنا على أيّ حال

148
00:09:45,770 --> 00:09:47,140
سأدعُك تتكفّلُ الأمر يا معلّم أونيزكا

149
00:09:47,600 --> 00:09:48,540
حسناً

150
00:09:59,960 --> 00:10:02,960
سأحلّق ، سأحلّق

151
00:10:03,770 --> 00:10:05,050
... معلّم

152
00:10:06,190 --> 00:10:06,750
ماذا!؟

153
00:10:08,990 --> 00:10:11,610
هل العنوان ورقم الهاتف صحيحان؟

154
00:10:12,820 --> 00:10:13,340
نعم

155
00:10:13,850 --> 00:10:15,110
حسناً ، أجرِ الاتّصال

156
00:10:15,110 --> 00:10:15,750
نعم

157
00:10:18,510 --> 00:10:20,460
النجدة، ساعدوني

158
00:10:20,890 --> 00:10:22,410
أبي .. أمّي

159
00:10:23,480 --> 00:10:24,730
.. ضابط شرطة

160
00:10:25,150 --> 00:10:25,890
معلّم أونيزكا

161
00:10:27,120 --> 00:10:28,240
... أرجوك

162
00:10:28,240 --> 00:10:30,190
لقد أخطأت

163
00:10:30,760 --> 00:10:32,490
ساعدني  أرجوك

164
00:10:35,180 --> 00:10:36,720
مرحباً، هنا منزل آيزاوا

165
00:10:39,170 --> 00:10:39,900
مرحباً؟

166
00:10:41,100 --> 00:10:42,370
ما هذا!؟

167
00:10:48,150 --> 00:10:49,240
أونيزكا

168
00:11:15,970 --> 00:11:18,170
انهض

169
00:11:18,640 --> 00:11:20,380
أتيتَ لمساعدتنا ، أليس كذلك!؟

170
00:11:20,380 --> 00:11:22,930
ساعدنا بسرعة إذاً

171
00:11:22,930 --> 00:11:24,240
بسرعة

172
00:11:29,220 --> 00:11:30,870
من هو!؟

173
00:11:34,750 --> 00:11:37,150
بسرعة ، اضربهم

174
00:11:43,770 --> 00:11:45,530
ما الذي تقولينه؟

175
00:11:53,160 --> 00:11:55,680
.. أتيتُ فقط لأشاهد

176
00:11:55,980 --> 00:11:58,570
بصِفتي معلّم علوم اجتماعيّة

177
00:11:58,980 --> 00:12:00,670
ماذا تعني!؟

178
00:12:01,100 --> 00:12:03,040
لا تدَّعِ البراءة

179
00:12:06,470 --> 00:12:10,280
لقد نصبتِ لي فخّاً

180
00:12:10,780 --> 00:12:15,120
حانةُ الزيّ الرسميّ خدعَتْني تماماً

181
00:12:21,490 --> 00:12:27,080
لِمَ أساعد كاذِبة كهذه؟

182
00:12:27,620 --> 00:12:30,510
أنتَ معلّمُ غرفتنا الصفّية ، ألست كذلك!؟

183
00:12:30,510 --> 00:12:32,610
مساعدةُ التلاميذ من واجبِ المعلّم

184
00:12:32,810 --> 00:12:34,830
هل أنتِ غبيّة؟

185
00:12:34,830 --> 00:12:39,040
إذا كانَ الامر متعلِّق بالعمل فينتهي عملُنا إذاً
عندما يقرعُ الجرسُ في الساعة 5:30 يا غبيّة

186
00:12:39,600 --> 00:12:41,580
... عادةً ما تقلّلين من احترامِ معلّمينكِ

187
00:12:41,580 --> 00:12:43,130
ويبدو ذلك واضحاً في موقفكِ ...

188
00:12:43,130 --> 00:12:46,360
ولكن عندما تقعين في ورطة ، تطلبين من معلّم أن ينقذكِ؟

189
00:12:46,830 --> 00:12:49,380
أنتِ تستهينين بالمعلّمين

190
00:12:58,280 --> 00:13:00,200
ماذا تفعل!؟

191
00:13:00,610 --> 00:13:02,810
لم أنهِ كلامي بعد

192
00:13:02,810 --> 00:13:04,090
أبعد يديك عنّي

193
00:13:09,230 --> 00:13:10,000
معلّم أونيزكا

194
00:13:10,740 --> 00:13:13,440
أريدُك أن تهدأ

195
00:13:13,690 --> 00:13:17,920
ميابي .. تُنادينني معلّم عندما تكونين بحاجةٍ لشيء فقط

196
00:13:18,480 --> 00:13:22,750
هذا المعلّم لا يفعل أشياءً غير مُدرَجة في كتاب دليل التربية

197
00:13:22,750 --> 00:13:24,460
أيّتها الغبية

198
00:13:24,460 --> 00:13:26,860
إذا أردتيني أن أساعدكِ فاعتذري

199
00:13:29,930 --> 00:13:31,410
كفاك هُراء

200
00:13:31,410 --> 00:13:34,390
لِمَ عليّ الانحناء لمعلّم غبيّ!؟

201
00:13:35,070 --> 00:13:36,770
تدبّري أمركِ بنفسكِ إذاً

202
00:13:36,970 --> 00:13:39,060
اصمت

203
00:13:39,060 --> 00:13:41,020
ماذا ستفعلين الآن يا ميابي؟

204
00:13:41,490 --> 00:13:43,450
هل ستعتذرين أم لا!؟

205
00:13:43,450 --> 00:13:46,170
قلتُ لك اصمت ، هل أنتَ أصمّ!؟

206
00:13:47,360 --> 00:13:51,060
ألن تعتذري إذاً يا ميابي؟

207
00:13:51,060 --> 00:13:52,750
تباً لك

208
00:13:54,280 --> 00:13:58,120
ماذا ستفعلين الآن؟ قرِّري

209
00:14:01,570 --> 00:14:03,460
آيزاوا

210
00:14:10,030 --> 00:14:11,570
.. أنا ... آسفة

211
00:14:12,650 --> 00:14:13,800
أنتِ مَدينةٌ لي بواحدة إذاً

212
00:14:27,840 --> 00:14:29,130
تبّاً ، اهربوا

213
00:14:29,600 --> 00:14:31,660
خُذ ذلك الرّجل الملقي أرضاً معك

214
00:14:43,560 --> 00:14:45,690
كنت أنت من اتّصلَ بأونيزكا ، صحيح؟

215
00:14:46,120 --> 00:14:49,030
كانزاكي ، تشعرين بتحسُّنٍ أكبر الآن ، ألستِ كذلك؟

216
00:14:49,500 --> 00:14:51,330
أونيزكا غبيّ

217
00:14:51,930 --> 00:14:53,790
راحَت الثّمانية مليون ين الآن

218
00:14:54,860 --> 00:14:56,300
أمامه يومان فقط

219
00:15:00,060 --> 00:15:01,020
تفضّلي عصيدة الأرزّ

220
00:15:01,540 --> 00:15:03,470
قلتِ وكأنّكِ مُتعبة وتحتاجين لطاقة

221
00:15:03,470 --> 00:15:04,870
احرصي على زيارةِ الطبيب لاحقاً

222
00:15:05,560 --> 00:15:07,960
سأبلِغ المدرسة بذلك

223
00:15:09,190 --> 00:15:12,620
اتّصلَ أبوكِ صباحاً أثناء سفره

224
00:15:12,620 --> 00:15:14,640
اتّصل للاطمئنانِ عليكِ

225
00:15:15,410 --> 00:15:19,600
أنتِ حقاً بؤبؤ عينه

226
00:15:20,390 --> 00:15:22,630
... أتتذكّرين؟ عندما كنتِ في المدرسة الابتدائيّة

227
00:15:22,630 --> 00:15:23,620
.. رحنا إلى جبل ياتسوغاتاكي

228
00:15:23,620 --> 00:15:25,000
هذه مجرّد حجة، أليست كذلك؟

229
00:15:26,420 --> 00:15:27,660
لا مزيد من المُزاح

230
00:15:28,060 --> 00:15:30,230
أنتِ تعلمين الحقيقة أيضاً

231
00:15:30,230 --> 00:15:31,810
ليسَتْ سفرة بداعي العمل

232
00:15:32,480 --> 00:15:34,890
إنّه يسافرُ مع تلك المرأة ، صحيح؟

233
00:15:35,310 --> 00:15:38,830
لا تُعامليني كحمقاء ، أتظنّينني عمياء!؟

234
00:15:39,820 --> 00:15:40,790
... ميابي

235
00:15:41,080 --> 00:15:43,960
لقد سئمتُ من الادِّعاءِ وكأننا عائلة سعيدة

236
00:15:46,720 --> 00:15:49,380
كلّ الكِبار كاذبون مغرورون

237
00:15:49,680 --> 00:15:51,560
لستُ مدينة لك بشيء

238
00:15:51,560 --> 00:15:53,650
من يُريد أن يكون مديناً لشخص بالغ؟

239
00:15:56,570 --> 00:15:58,250
بقي يوم واحد فقط

240
00:15:58,720 --> 00:16:01,670
... أعادَتْ ميابي 1,070,000 ين

241
00:16:01,670 --> 00:16:04,240
مائتان وثمانين ألفاً من الباتشينكو

242
00:16:04,430 --> 00:16:06,910
... والمبلغ الّذي حصلَ عليه من عملِه الجزئي هو

243
00:16:06,910 --> 00:16:09,360
لا تبدأ بالحساب ، أشعرُ بالاستفزاز

244
00:16:09,360 --> 00:16:11,230
كيفما نظرتَ إليه ، إنه قليلٌ جداً

245
00:16:13,240 --> 00:16:14,060
... هل

246
00:16:14,640 --> 00:16:15,790
سيرحلُ إذاً؟

247
00:16:21,210 --> 00:16:22,590
مرحباً ، اشتقتُ إليكم

248
00:16:22,960 --> 00:16:23,750
فوجيوشي

249
00:16:23,750 --> 00:16:25,950
بالفعل ، اشتقنا كثيراً

250
00:16:25,950 --> 00:16:27,550
لقد أثرتَ قلقنا

251
