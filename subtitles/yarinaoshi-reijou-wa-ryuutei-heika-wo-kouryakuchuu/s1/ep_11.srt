1
00:00:02,550 --> 00:00:05,430
،تساءلت ما الّذي كان يجري
.وأخبرتني بالأخبار السّيّئة

2
00:00:05,430 --> 00:00:08,890
،صحيح، ولكن يا عمّي
.لم يُعثر على جثّتها بعد

3
00:00:09,080 --> 00:00:10,640
.ماتت تلك الفتاة

4
00:00:11,410 --> 00:00:14,100
.لقد احترقت بنيران تنّين

5
00:00:16,070 --> 00:00:18,650
.كلّ من بقي الآن هو ذلك الإمبراطور المزيّف

6
00:02:01,510 --> 00:02:06,810
الحلقة 11: يتصرّف عمّ خطيبي بشكل فظيع
لدرجة أنّي لم أعد قادرة على البقاء صامتة

7
00:02:15,870 --> 00:02:17,070
!يا صاحب الجلالة

8
00:02:19,120 --> 00:02:22,820
ما الّذي يحدث؟ وما هذا المكان؟

9
00:02:28,880 --> 00:02:30,540
الماء يطفو؟

10
00:02:30,540 --> 00:02:32,630
هل أنت زوجة التّنّين؟

11
00:02:39,380 --> 00:02:40,730
تنّينة سوداء؟

12
00:02:40,990 --> 00:02:43,370
.إنّك لا تزالين طفلة

13
00:02:43,370 --> 00:02:50,880
لكنّي أعترف لك بشجاعتك
.بما أنّك تنظرين إليّ بلا أيّ تدّد

14
00:02:51,290 --> 00:02:53,650
.لكنّ ذلك لن يؤثّر إطلاقًا على حُكمي

15
00:02:53,650 --> 00:02:55,760
هل أنت من قامت بإنقاذي؟

16
00:02:55,760 --> 00:02:58,690
تطرحين عليّ أسئلة دون أخذ الإذن؟

17
00:02:59,690 --> 00:03:01,290
.لا يهمّ

18
00:03:01,290 --> 00:03:04,400
.قمتُ بنقلك نزولاً لطلب التّنّينة القرمزيّة

19
00:03:05,870 --> 00:03:10,120
.فهمت. لا عجب أنّ التّنّينة القرمزيّة كانت متوتّرة

20
00:03:10,740 --> 00:03:15,010
.لا أرى أيّ خاتم ذهبيّ
.لا أشعر بأيّ قوّة سحريّة ذات سلطة

21
00:03:15,010 --> 00:03:17,530
.لا... بل خُتمت

22
00:03:17,530 --> 00:03:19,210
.يا له من أمر فظيع

23
00:03:21,350 --> 00:03:24,330
أنا أعتذر منك لأنّي لم أعرّف
.بنفسي بعد. اسمي جيل

24
00:03:24,850 --> 00:03:25,760
—إنّ جلالته

25
00:03:25,220 --> 00:03:27,960
.لم ينتهِ الحكم عليك بعد

26
00:03:28,810 --> 00:03:33,450
،بما أنّك لستُ زوجة التّنّين
!فلن تعودي على قيد الحياة

27
00:03:42,200 --> 00:03:44,830
!ما الّذي تفعلينه؟ ساعديني

28
00:03:45,180 --> 00:03:46,990
.هذا عشّ تنانين

29
00:03:47,450 --> 00:03:51,030
.إنّه ليس مكانًا ليدخل إليه بشر عاديّون

30
00:03:51,030 --> 00:03:54,210
!إنّ جلالته الآن... الإمبراطور التّنّين في ورطة

31
00:03:54,210 --> 00:03:55,450
—إن لم أحمه

32
00:03:55,450 --> 00:03:58,370
اختار طفلة صغيرة لتكون
...زوجة التّنّين

33
00:03:58,370 --> 00:04:01,590
!لا عجب أنّ البيضة لا تفقص

34
00:04:01,590 --> 00:04:03,060
أيّ بيضة؟

35
00:04:12,950 --> 00:04:14,430
ماذا أفعل؟

36
00:04:18,090 --> 00:04:20,230
...قشر البيض هذا

37
00:04:20,800 --> 00:04:22,600
.ثمّة سحر يتدفّق منه

38
00:04:29,570 --> 00:04:31,920
.يبدو أنّنا أضعنا مطاردينا

39
00:04:32,240 --> 00:04:36,920
لكنّ القول أنّهم هربوا
.من دبّ محشوّ سيكون أكثر دقّة

40
00:04:38,080 --> 00:04:41,490
.على الأرجح أنّ نصف قوّات العدوّ قد أُبيدوا

41
00:04:41,490 --> 00:04:43,390
.طبعًا، فالغابة بأكملها احترقت

42
00:04:43,390 --> 00:04:44,910
.وجب عليهم الانسحاب

43
00:04:44,910 --> 00:04:48,400
ما كان ذلك الشّيء؟
لم يكن مجرّد دمية، صحيح؟

44
00:04:48,400 --> 00:04:49,360
.لا فكرة لديّ

45
00:04:49,360 --> 00:04:52,570
وحده هاديس قادر على صنع
.شيء بتلك السّخافة

46
00:04:52,570 --> 00:04:55,270
.مع أنّنا ندين له بحياتنا

47
00:04:55,270 --> 00:04:57,360
.قبل كلّ شيء، الأولويّة لرجالنا

48
00:04:57,360 --> 00:05:01,460
وذلك الكائن الشّبيه بالصّوص
.لا يزال على قيد الحياة بالتّأكيد

49
00:05:01,460 --> 00:05:03,620
.كان يلوّح بتلك الدّمية

50
00:05:03,850 --> 00:05:08,130
إن ارتحنا هنا اللّيلة، فماذا سنفعل لاحقًا؟

51
00:05:08,130 --> 00:05:12,440
،إن كانت أختي الكبرى قد خانتنا
.فعلينا أن نفترض أنّ لا حلفاء لنا

52
00:05:12,440 --> 00:05:15,870
ولا يمكننا العودة إلى نويترال
.للحصول على تنانيننا

53
00:05:15,870 --> 00:05:19,830
.ولكنّنا بحاجة للتّنانين لقلب الموازين

54
00:05:20,070 --> 00:05:21,800
لا يمكنك استدعاؤها إلى هنا؟

55
00:05:21,800 --> 00:05:25,330
لا أعتقد أنّ حتّى أولئك الأشخاص
.قد يقتلون تنّينة قرمزيّة

56
00:05:26,760 --> 00:05:29,520
أستنتج من تعابيرك أنّك كنت
.لتفعلها سلفًا لو كنت تستطيع

57
00:05:29,520 --> 00:05:32,880
،إن كانت في مزاج سيّئ
.فلن تأتي حتّى إن استُدعيت

58
00:05:32,880 --> 00:05:35,150
العلاقة بين البشر والتّنانين

59
00:05:35,150 --> 00:05:36,420
.ليست من جانب واحد كما توقّعت

60
00:05:36,420 --> 00:05:37,620
ألم يعلّموكم ذلك؟

61
00:05:37,620 --> 00:05:40,970
.لا تنس أنّها تسمح لنا بركوبها فحسب

62
00:05:40,970 --> 00:05:44,410
،بدون حماية التّنانين
فإنّ أيّ بشريّ على ظهر تنّين

63
00:05:44,410 --> 00:05:46,480
.سيموت بسبب قلّة كثافة الهواء

64
00:05:47,130 --> 00:05:48,120
...وأيضًا

65
00:05:48,890 --> 00:05:52,070
على الأرجح أنّهم تخلّصوا
.من برينهيلدي مسبقًا

66
00:05:52,510 --> 00:05:54,480
.إنّه ليس شيئًا أودّ التّفكير به

67
00:05:54,890 --> 00:05:57,030
.إنّ وضعنا يسوء أكثر

68
00:06:01,500 --> 00:06:03,050
هذا من أجلي؟

69
00:06:03,050 --> 00:06:06,320
عمل الجميع بكلّ جهدهم
!لإعدادها من أجل جلالتك

70
00:06:06,320 --> 00:06:10,190
،إنّك تعتني بنا دائمًا
.لذلك فكّرنا في ردّ الجميل

71
00:06:10,570 --> 00:06:13,790
إذًا فحلوى مون بلان هذه
...الّتي على شكل أفعى هائجة

72
00:06:13,790 --> 00:06:15,390
ألديك مشكلة في ذلك؟

73
00:06:15,390 --> 00:06:17,660
.توقّف يا ريستيارد

74
00:06:17,660 --> 00:06:20,900
هاديس، إنّ هذا يُظهر مشاعر
.الامتنان خاصّتنا

75
00:06:20,900 --> 00:06:22,280
.اقبلها رجاءً

76
00:06:22,280 --> 00:06:23,650
هذا جيّد، صحيح؟

77
00:06:23,650 --> 00:06:27,060
حلمك بأن يعيش الجميع معًا
!بسعادة قد تحقّق

78
00:06:34,180 --> 00:06:36,730
هاديس، هل استيقظت؟

79
00:06:38,800 --> 00:06:43,520
لم تأكل بعد؟ ماذا ستفعل
إن خانك جسدك ثانية؟

80
00:06:44,050 --> 00:06:46,960
تطلبين من شخص في طريقه
ليُعدم بأن يأكل؟

81
00:06:47,550 --> 00:06:53,850
أنا آسفة. لكنّني وفيسيل
...نخطّط لإقناع عمّنا

82
00:06:54,220 --> 00:06:56,680
—بالسّماح لك بالعيش كشخص عاد

83
00:06:56,680 --> 00:06:58,670
...لا. أنا

84
00:07:00,120 --> 00:07:01,650
.الإمبراطور التّنّين

85
00:07:04,200 --> 00:07:06,930
لماذا أوقفتِ الإمبراطور التّنّين؟

86
00:07:07,370 --> 00:07:09,690
هل تشعرين بالشّفقة على من خانوه؟

87
00:07:09,690 --> 00:07:13,190
وتقولين أنّك ستحمين الإمبراطور
التّنّين رغم سذاجتك تلك؟

88
00:07:13,570 --> 00:07:16,710
.خُتم سحرك بسبب قوّة الإلهة

89
00:07:16,710 --> 00:07:18,530
.لستِ مناسبة لتكوني زوجة التّنّين

90
00:07:18,940 --> 00:07:23,510
بصراحة، ما مدى سذاجة سيّدي رافي؟
—إنّ حاله هذا هو ما

91
00:07:22,690 --> 00:07:23,510
!مهلاً

92
00:07:23,830 --> 00:07:25,330
ماذا قلتِ للتّوّ؟

93
00:07:25,740 --> 00:07:28,330
.قلتُ أنّ سيّدي رافي ساذج

94
00:07:28,330 --> 00:07:31,770
!بل قبل ذلك
قلتِ أنّ الإلهة ختمت سحري؟

95
00:07:31,770 --> 00:07:32,210
.نعم

96
00:07:33,190 --> 00:07:35,930
.فهمت. هذا ما يحدث إذًا

97
00:07:36,350 --> 00:07:40,660
صُنع سيف غيورغ السّماويّ
من رمح كريتوس المقدّس، صحيح؟

98
00:07:40,660 --> 00:07:43,780
إنّه الشّيء الوحيد الّذي بإمكانه
.ختم سحر الإمبراطور التّنّين

99
00:07:47,480 --> 00:07:49,320
ما الممتع في هذا؟

100
00:07:49,690 --> 00:07:53,330
إنّ التّضحية بالنّفس اللاّزمة
...لتدمير الذّات بهذه الطّريقة

101
00:07:53,330 --> 00:07:55,030
.حتّى في مواجهة العدوّ، أمر مثير للإعجاب

102
00:07:55,520 --> 00:07:57,930
.لا أصدّق أنّك تقدّرين حبّ الإلهة

103
00:07:58,330 --> 00:08:00,500
!لستِ مناسبة لتكوني زوجة التّنّين

104
00:08:00,500 --> 00:08:03,480
!سأنقذ جلالته، فابتعدي عن طريقي

105
00:08:03,480 --> 00:08:04,470
.أخبرتك من قبل

106
00:08:04,810 --> 00:08:07,710
لا يستطيع أيّ بشريّ
.دخل إلى هنا الخروج حيًّا

107
00:08:08,070 --> 00:08:10,940
.على الضّعفاء الانصياع للأقوياء

108
00:08:10,940 --> 00:08:12,780
!تلك هي الطّبيعة

109
00:08:14,850 --> 00:08:17,060
!المنطق! المنطق
!لا أسمع إلاّ الاعتراضات

110
00:08:17,060 --> 00:08:18,970
ألا تريدين إنقاذ جلالته؟

111
00:08:18,970 --> 00:08:21,100
أتحاولين استغلال عواطفي
وتتحدّثين عن الحبّ؟

112
00:08:21,100 --> 00:08:22,310
!يا مشعوذة كريتوس

113
00:08:22,310 --> 00:08:25,300
لذلك السّبب لا يمكنك هزيمة
!الإلهة! لا أحد منكم يستطيع

114
00:08:26,230 --> 00:08:29,640
،امرأة تخاطر بحياتها
...وتنانين لا تُحرّك ساكنًا

115
00:08:29,640 --> 00:08:32,160
تعرفين سلفًا من الفائز بينهما، صحيح؟

116
00:08:32,480 --> 00:08:34,620
!كفاك ثرثرة وأطيعيني

117
00:08:34,620 --> 00:08:35,660
!أيّتها التّنّينة السّوداء

118
00:08:44,370 --> 00:08:47,000
.لا يجب أن أدع جلالته يرى هذا

119
00:08:54,360 --> 00:08:56,410
.إنّها بيضة تنّين

120
00:08:57,170 --> 00:08:59,010
،عندما يولد الإمبراطور التّنّين

121
00:08:59,010 --> 00:09:02,320
.تظهر دائمًا بيضة لتنّين أسود ذهبيّ العينين

122
00:09:02,700 --> 00:09:05,940
يوفّر قلب الإمبراطور العناصر
،الغذائيّة أثناء نموّها

123
00:09:05,940 --> 00:09:09,010
.ثمّ تفقص بعد عشر سنوات

124
00:09:09,010 --> 00:09:10,850
...ولكن كما ترين

125
00:09:10,850 --> 00:09:12,230
ماذا عن سيّدي رافي؟

126
00:09:12,230 --> 00:09:14,200
.إنّه على علم بهذا بالطّبع

127
00:09:14,740 --> 00:09:17,930
،إنّ عشر سنوات، أو حتّى عشرين
،لا تزال في المدى المقبول

128
00:09:17,930 --> 00:09:20,230
،ولكن إن مات قبل أن تفقص

129
00:09:20,230 --> 00:09:24,070
.فسيغذّيها قلبه وستفقص وحشًا

130
00:09:24,070 --> 00:09:25,250
وحش؟

131
00:09:25,250 --> 00:09:29,050
.ربّما ذلك ما يأمل الإمبراطور التّنّين أن يحدث

132
00:09:29,330 --> 00:09:33,350
.لكي يُلعن العالم بأكمله بعد أن يموت

133
00:09:34,400 --> 00:09:36,630
...إذًا في ذلك المستقبل

134
00:09:37,380 --> 00:09:38,510
...صاحب الجلالة

135
00:09:44,540 --> 00:09:45,850
.لا بأس

136
00:09:46,330 --> 00:09:47,810
.أنا هنا

137
00:09:48,210 --> 00:09:50,790
لذلك افقص بسرعة، مفهوم؟

138
00:09:54,070 --> 00:09:56,310
لقد تحرّكت! تحرّكت البيضة، صحيح؟

139
00:09:56,740 --> 00:09:58,310
.أنا زوجته

140
00:09:58,310 --> 00:10:02,440
على التّنّين الأسود ذهبيّ العينين
.أن ينضمّ دائمًا لتنّين أسود آخر

141
00:10:02,440 --> 00:10:05,400
.انتظرتُ ثلاثمائة سنة

142
00:10:07,630 --> 00:10:09,870
.لا بدّ أنّك كنت وحيدة

143
00:10:10,270 --> 00:10:14,470
.أنا آسفة. أنت أنثى، وضربتُك على وجهك

144
00:10:14,990 --> 00:10:18,390
.لا. كنتُ محبطة لأنّ البيضة لم تفقص

145
00:10:18,390 --> 00:10:21,970
.كنتُ أنا من تحدّثت وتصرّفت بفظاظة

146
00:10:22,470 --> 00:10:23,430
.أنا أعتذر

147
00:10:24,170 --> 00:10:26,880
.فتحت كلماتك عينيّ

148
00:10:26,880 --> 00:10:29,140
.وصحيح أنّي لم أحرّك ساكنًا

149
00:10:29,460 --> 00:10:34,480
ظللتُ هنا فقط، أراقب بيضة
.لم تفقص بعد وأستسلم ليأسي

150
00:10:34,480 --> 00:10:36,690
.لننقذ جلالته معًا

151
00:10:36,960 --> 00:10:38,520
!سنخرج من هنا

152
00:10:38,520 --> 00:10:40,980
...لكن إن فعلتُ ذلك، فإنّ البيضة

153
00:10:40,980 --> 00:10:42,770
ستكون في أمان هنا، صحيح؟

154
00:10:42,770 --> 00:10:45,240
.سيكون كافيًا أن تطمئنّي عليها من وقت لآخر

155
00:10:45,240 --> 00:10:46,210
...لكن

156
00:10:48,270 --> 00:10:50,470
سمعت ذلك، صحيح؟

157
00:10:50,470 --> 00:10:53,260
إن كنت لا تريد أن تظلّ
.في الخلف، فافقص بسرعة

158
00:10:54,880 --> 00:10:57,130
—يبدو أنّه يحتجّ على

159
00:10:57,130 --> 00:10:58,100
.إنّه مليء بالحياة

160
00:10:58,450 --> 00:11:00,840
!حسنًا، لننطلق

161
00:11:00,840 --> 00:11:03,960
.حسنًا. بإمكانك أن تركبي على ظهري

162
00:11:04,170 --> 00:11:07,480
فـ-فعلاً؟ مع أنّه سأكون أنا فقط؟

163
00:11:07,810 --> 00:11:12,440
الوحيدون الّذين بإمكانهم أن يركبوني
.هما الإمبراطور التّنّين وزوجة التّنّين

164
00:11:16,340 --> 00:11:18,570
ولكن كيف سنغادر هذا المكان؟

165
00:11:18,570 --> 00:11:21,730
.هذا لا شيء. تمسّكي جيّدًا
!لن يطول الأمر أكثر من رمشة عين

166
00:11:44,390 --> 00:11:48,140
والآن، إلى أين نذهب يا زوجة التّنّين؟

167
00:11:48,140 --> 00:11:49,260
.إلى أصدقائي

168
00:11:49,780 --> 00:11:51,720
.لن يكونوا بعيدين كثيرًا

169
00:11:51,720 --> 00:11:53,480
.مفهوم

170
00:11:53,830 --> 00:11:56,700
.نادني جيل لو سمحت

171
00:11:56,700 --> 00:11:59,020
.وسأناديك باسمك أيضًا

172
00:11:59,020 --> 00:12:00,710
.لا أملك أيّ اسم

173
00:12:01,050 --> 00:12:03,230
!سأمنحك اسمًا إذًا

174
00:12:03,990 --> 00:12:05,540
ما رأيك باسم "شريحة لحم"؟

175
00:12:09,040 --> 00:12:10,590
.أرفض ذلك

176
00:12:14,500 --> 00:12:19,120
لماذا طلبت جيل ألاّ أقتلك في رأيك؟

177
00:12:19,720 --> 00:12:21,530
.لأنّها شعرت بالشّفقة

178
00:12:21,530 --> 00:12:24,810
شعرت بالشّفقة عليك، فقد خانتك
.أختك وكنت مضطرًّا لقتلها

179
00:12:24,810 --> 00:12:27,330
.لستُ شخصًا مثيرًا للشّفقة بشكل خاصّ

180
00:12:27,330 --> 00:12:30,640
.لم أعتبرك كأخت كبرى لي بحقّ إطلاقًا

181
00:12:30,990 --> 00:12:35,350
لا أعتقد أنّ ما فعلتُه قابل
...للمغفرة، ولكن على الأقلّ

182
00:12:36,100 --> 00:12:38,310
.أعتقد أنّ جيل من عليها أن تقتلني

183
00:12:38,310 --> 00:12:39,580
أتتوسّلين لحياتك؟

184
00:12:40,240 --> 00:12:41,220
.لا

185
00:12:42,460 --> 00:12:45,710
إنّه تكفير على فشلي في البقاء
.كأخت لك حتّى النّهاية

186
00:12:48,840 --> 00:12:50,830
.لم تقترف أيّ خطأ

187
00:12:50,830 --> 00:12:53,610
.المخطئون هنا... هم بقيّتنا

188
00:12:53,610 --> 00:12:55,360
ماذا تقصدين؟

189
00:12:55,360 --> 00:13:00,560
أنا آسفة لأنّي لم أكن مؤهّلة
.كأخت كبرى. أنا جدّ آسفة

190
00:13:02,500 --> 00:13:05,470
!مهلاً أيّها الرّجل الدّبّ! لا تشعل نارًا الآن

191
00:13:05,470 --> 00:13:07,560
بإمكاننا إشعالها في وقت الطّعام، صحيح؟

192
00:13:07,560 --> 00:13:13,740
إضافة لذلك، قد تساعد القائدةَ
.على إيجادنا بسبب الرّائحة

193
00:13:13,740 --> 00:13:14,830
.ذلك صحيح

194
00:13:15,380 --> 00:13:17,900
.ما زلنا نملك حصص الطّعام الّتي أعدّها هاديس

195
00:13:17,900 --> 00:13:20,750
.إنّ جلالته شخص مراعٍ للغاية

196
00:13:22,000 --> 00:13:23,180
.يا إلهي

197
00:13:35,540 --> 00:13:36,740
...أيُعقل

198
00:13:38,470 --> 00:13:41,330
لورنس! هل البقيّة بأمان أيضًا؟

199
00:13:41,700 --> 00:13:42,910
!جيل

200
00:13:42,910 --> 00:13:43,560
!كاميلا

201
00:13:43,560 --> 00:13:46,390
.لم نفتح حصص طعامنا بعد حتّى

202
00:13:46,390 --> 00:13:47,750
!وزيك أيضًا

203
00:13:47,750 --> 00:13:49,710
ما-ما الّذي تتحدّث عنه؟

204
00:13:53,420 --> 00:13:55,380
لـ-لماذا تركبين تنّينة سوداء؟

205
00:13:57,270 --> 00:13:59,140
.ليس التّنّينة السّوداء فقط

206
00:14:00,330 --> 00:14:01,320
...تلك

207
00:14:03,760 --> 00:14:05,230
!برينهيلدي

208
00:14:07,730 --> 00:14:12,170
ذكرتُ الأمير ريستيارد، فقامت
.التّنّينة السّوداء باستدعائها لأجلنا

209
00:14:12,170 --> 00:14:14,610
!لك كلّ امتناني أيّتها التّنّينة السّوداء النّبيلة

210
00:14:15,430 --> 00:14:18,070
.يبدو أنّك تعرف بعض آداب المعاملة

211
00:14:18,280 --> 00:14:22,540
.لقد تكلّمت؟! لا-لا عجب في ذلك
.إنّها تنّينة سوداء قبل كلّ شيء

212
00:14:22,850 --> 00:14:25,260
زيك، ما هو وضعكم الحاليّ؟

213
00:14:25,260 --> 00:14:26,950
.بخصوص ذلك أيّتها القائدة

214
00:14:26,950 --> 00:14:30,170
—بينما كنّا نهرب، سوتي والإمبراطور الدّبّ

215
00:14:31,710 --> 00:14:32,710
!سوتي

216
00:14:33,060 --> 00:14:36,720
!أنقذت الإمبراطور الدّبّ؟ أحسنت

217
00:14:38,210 --> 00:14:42,430
لا بدّ أنّ الإمبراطور الدّبّ قد قاتل
.يجدّ ليصير في هذه الحالة

218
00:14:43,240 --> 00:14:45,450
.سأطلب من جلالته أن يصلحه

219
00:14:46,140 --> 00:14:47,760
!لورنس، ضع خطّة في الحال

220
00:14:49,340 --> 00:14:50,910
.دعي الأمر لي

221
00:14:51,300 --> 00:14:53,670
.سننقذ الإمبراطور رغم أعدادنا الصّغيرة

222
00:14:54,010 --> 00:14:57,110
!والآن... ليبدأ هجومنا المضادّ

223
00:14:59,070 --> 00:15:01,290
!هجوم! إنّنا نتعرّض لهجوم

224
00:15:01,960 --> 00:15:07,000
أيّتها الأميرة إلنزيا، إنّ الأمير ريستيارد
!وتنّينة سوداء يهاجموننا

225
00:15:07,000 --> 00:15:08,090
تنّينة سوداء؟

226
00:15:08,300 --> 00:15:09,840
!أين؟ أرني

227
00:15:09,840 --> 00:15:10,890
!من هنا

228
00:15:12,080 --> 00:15:14,680
.يبدو أنّ الآنسة قد قُبلت

229
00:15:14,680 --> 00:15:17,640
.بالطّبع. إنّها زوجة التّنّين

230
00:15:17,640 --> 00:15:20,860
...لقد حصلت على بركتك، كما أنّها

231
00:15:21,470 --> 00:15:23,270
.عروسي الجميلة

232
00:15:24,240 --> 00:15:26,100
!الأمر تمامًا كما توقّعتَ يا لورنس

233
00:15:26,530 --> 00:15:28,910
الأفضليّة الوحيدة الّتي لدينا
!على القدرة على التّنقّل

234
00:15:28,910 --> 00:15:31,230
!إن وصلت التّعزيزات، سنُسحق

235
00:15:31,230 --> 00:15:34,830
أيّها الأمير ريستيارد، استدرج
!أكبر قدر من الجنود لو سمحت

236
00:15:34,830 --> 00:15:37,200
!سنتدبّر نحن هروب الإمبراطور

237
00:15:37,600 --> 00:15:39,990
!أتمنّى الحظّ الوفير للجميع

238
00:15:40,610 --> 00:15:42,150
!أسقطوهم أرضًا

239
00:15:44,630 --> 00:15:47,100
!أعتمد عليك يا برينهيلدي

240
00:15:54,660 --> 00:15:55,760
!وجدته

241
00:16:02,580 --> 00:16:03,860
.الأميرة إلنزيا

242
00:16:04,090 --> 00:16:09,140
.قال عمّي أنّك متّ، لكنّي كنت واثقة أنّك حيّة

243
00:16:09,140 --> 00:16:10,000
!جيل

244
00:16:12,320 --> 00:16:13,240
!أنا بخير

245
00:16:13,240 --> 00:16:15,550
!خذوا العربة الّتي فيها جلالته واهربوا

246
00:16:19,230 --> 00:16:21,160
سحرٌ قاتلٌ للتّنانين؟

247
00:16:22,230 --> 00:16:23,820
!آنسة كاميلا، سيّد زيك

248
00:16:25,590 --> 00:16:27,080
!احرسا التّنّينة السّوداء

249
00:16:27,080 --> 00:16:28,290
!عُلم

250
00:16:32,790 --> 00:16:36,280
لا أصدّق أنّ بإمكانك صدّي
...رغم أنّ سحرك مختوم

251
00:16:40,190 --> 00:16:42,910
.انسحبي يا جيل! لن أطاردك

252
00:16:42,910 --> 00:16:45,060
!سأريك أنّ بإمكاني إنقاذ هاديس

253
00:16:45,060 --> 00:16:47,190
لماذا خنته إذًا؟

254
00:16:47,190 --> 00:16:49,970
،إن كنت تريدين إنقاذه
فلماذا لم تظلّي حليفته؟

255
00:16:53,910 --> 00:16:55,240
!سنحميها وإن أدّى ذلك لموتنا

256
00:16:55,240 --> 00:16:56,950
مع من تتحدّث في رأيك؟

257
00:17:05,190 --> 00:17:08,350
كم أودّ أن أسمع ما لديك
.لتقوليه أيضًا يا أختي

258
00:17:08,350 --> 00:17:09,880
!ريستيارد

259
00:17:10,310 --> 00:17:12,440
لماذا خنت هاديس؟

260
00:17:12,440 --> 00:17:15,970
،عرفتُ ذلك من البداية
.لم تكوني إلى جانبه

261
00:17:16,400 --> 00:17:18,280
.عواطفك عميقة

262
00:17:18,280 --> 00:17:22,590
إنّك لستِ شخصًا بإمكانه التّخلّي
.إخوتك غير الأشقّاء، عائلتك

263
00:17:22,900 --> 00:17:27,320
،ولذلك السّبب وثقت بك
.ولماذا فكّرتُ في جعلك حليفة

264
00:17:27,930 --> 00:17:30,420
.لا أريد تصديق أنّي كنتُ مخطئًا حيال ذلك

265
00:17:30,930 --> 00:17:32,990
!وحتّى الآن، لا أعتقد أنّي مخطئ

266
00:17:32,990 --> 00:17:35,880
.انضمّ إليّ إذًا يا ريستيارد

267
00:17:35,880 --> 00:17:38,160
!اعترفتُ بهاديس كإمبراطور لي

268
00:17:38,160 --> 00:17:40,820
وتجاهلُ ذلك سيكون بمثابة إلحاق
!العار على الطّريق الّذي اخترتُ لحياتي

269
00:17:40,820 --> 00:17:43,490
حتّى إن كانت حياة أختك الصّغرى
تعتمد على ذلك؟

270
00:17:44,650 --> 00:17:46,140
تهدّدينني؟

271
00:17:46,510 --> 00:17:48,220
!أسأت الحكم عليك يا أختي

272
00:17:48,220 --> 00:17:50,950
أهكذا تتصرّف عائلة رافي الإمبراطوريّة الفخورة؟

273
00:17:50,950 --> 00:17:52,320
!أنت مخطئ

274
00:17:58,980 --> 00:18:01,600
ما سبب التّأخير يا إلنزيا؟

275
00:18:02,080 --> 00:18:03,490
!عمّي

276
00:18:10,240 --> 00:18:13,440
الفتاة الصّغيرة. من كان يظنّ
أنّك لا تزالين حيّة؟

277
00:18:14,420 --> 00:18:15,140
...والآن

278
00:18:17,400 --> 00:18:18,120
!مهلاً

279
00:18:18,120 --> 00:18:21,960
.هاديس هو الإمبراطور التّنّين
لماذا تقفين إلى جانب عمّي؟

280
00:18:21,960 --> 00:18:23,190
...لأنّ

281
00:18:23,190 --> 00:18:26,080
،لا أدري ما الهراء الّذي ملأت به رأس أختي

282
00:18:26,080 --> 00:18:28,660
!لكنّي أتمنّى نهاية لهذا القتال العقيم

283
00:18:28,660 --> 00:18:32,500
فعلاً؟ تعتقد أنّ هاديس مناسب
ليكون إمبراطورًا؟

284
00:18:32,730 --> 00:18:36,490
بعد أن قمت بإضرام النّار في قرية
!بريئة، فهو خيار أفضل منك أنت

285
00:18:36,870 --> 00:18:40,210
.ريستيارد، لم يكن لديّ أيّ خيار

286
00:18:40,510 --> 00:18:42,230
لم يكن لديك أيّ خيار؟

287
00:18:42,230 --> 00:18:45,670
بالحديث عن ذلك، ما كان أيّ أحد
.ليصدّق أنّك من العائلة الإمبراطوريّة

288
00:18:45,670 --> 00:18:48,230
...عمّي، سأكون شاهدًا على هذا

289
00:18:48,230 --> 00:18:51,170
!أنت هو الّذي غير مناسب للحكم

290
00:18:51,170 --> 00:18:52,340
!ريستيارد

291
00:18:52,720 --> 00:18:53,900
!أحمق

292
00:18:55,960 --> 00:18:57,580
!أيّها الأمير ريستيارد

293
00:18:57,580 --> 00:19:01,710
سُحقًا! أذلك السّيف السّماويّ مزيّف بالفعل؟

294
00:19:01,710 --> 00:19:05,670
!عمّي، دع هذا الأمر لي رجاءً
!بإمكاني تولّي أمر ريستيارد

295
00:19:05,670 --> 00:19:06,960
!كفى من هذه المهزلة

296
00:19:07,710 --> 00:19:11,280
إنّ معلوماتك الخاطئة أخّرت
مرافقة هاديس، صحيح؟

297
00:19:11,700 --> 00:19:13,510
هل اعتقدت أنّ بإمكانه الهرب؟

298
00:19:14,170 --> 00:19:17,380
.كان يجب أن يصل إلى العاصمة منذ مدّة

299
00:19:17,380 --> 00:19:20,260
لكنّك سمحتِ الآن بوقوعنا
!في كمين، وانظري لحالنا

300
00:19:20,260 --> 00:19:21,360
...ذلك

301
00:19:22,020 --> 00:19:23,450
.ريستيارد

302
00:19:23,850 --> 00:19:28,020
قلتَ أنّي لستُ مناسبًا لأكون عضوًا من
عائلة رافي الإمبراطوريّة، أليس كذلك؟

303
00:19:29,030 --> 00:19:31,350
ماذا عنك أنت؟

304
00:19:32,080 --> 00:19:35,540
هل تعتقد فعلاً أنّك جزء من هذه العائلة؟

305
00:19:35,540 --> 00:19:37,440
.لا أفهم ما الّذي تسأل عنه

306
00:19:37,840 --> 00:19:42,160
حتّى إلنزيا لم تعلم. ليس من غير
.المفاجئ ألاّ تعلم أيضًا

307
00:19:42,160 --> 00:19:43,710
!تمهّل لحظة يا عمّي

308
00:19:43,710 --> 00:19:45,430
!لا حاجة لإخبار ريستيارد

309
00:19:45,430 --> 00:19:47,620
!بل عليه أن يعرف

310
00:19:47,620 --> 00:19:50,340
فقبل كلّ شيء، هذا يهدّد العائلة
!الإمبراطوريّة بأكملها

311
00:19:51,030 --> 00:19:53,540
.وجدتُ هذه في غرف أخي الأكبر

312
00:19:57,860 --> 00:20:04,490
بعد إنجاب فيسيل، صارت والدته
.على علاقة مع أحد الحرس

313
00:20:04,890 --> 00:20:07,170
!ذلك الفتى ليس ابن أخي

314
00:20:07,170 --> 00:20:09,770
لا تجمعنا أيّ صلة دم بهاديس؟

315
00:20:10,050 --> 00:20:11,320
ما معنى هذا؟

316
00:20:11,320 --> 00:20:14,270
كيف يمكن لهاديس أن يكون الإمبراطور التّنّين؟

317
00:20:16,180 --> 00:20:18,200
.بالضّبط

318
00:20:20,550 --> 00:20:21,810
.ذلك غير ممكن

319
00:20:22,510 --> 00:20:26,170
،إذًا... طوال هذه السّنين الطّويلة

320
00:20:26,170 --> 00:20:29,840
خدعنا النّاس ليعتقدوا
أنّنا العائلة الإمبراطوريّة لرافي؟

321
00:20:31,950 --> 00:20:34,470
.علينا أن نعلن عن هذا للعموم

322
00:20:34,470 --> 00:20:37,430
!علينا تقبّل حكم الإمبراطور التّنّين

323
00:20:37,430 --> 00:20:40,610
،إن كان وجودنا خطأ
—فذلك سبب إضافي لكي

324
00:20:40,610 --> 00:20:41,830
!لذلك السّبب سنمحوه

325
00:20:42,770 --> 00:20:46,770
!وجودنا خطأ؟ لا، هاديس هو الخطأ

326
00:20:46,770 --> 00:20:48,270
!عمّي

327
00:20:48,270 --> 00:20:50,400
ما الّذي فعله حتّى الآن؟

328
00:20:50,400 --> 00:20:53,620
!نحن من حافظ على نظام هذه الأرض

329
00:20:53,620 --> 00:20:55,110
هل أنا مخطئ يا ريستيارد؟

330
00:20:55,110 --> 00:20:55,720
—لكن

331
00:20:55,960 --> 00:21:00,190
!سأواصل حماية شعبنا وإمبراطوريّتنا

332
00:21:00,190 --> 00:21:03,570
!وللقيام بذلك، عليّ أن أصير إمبراطورَ رافي

333
00:21:07,650 --> 00:21:08,780
.أختي

334
00:21:09,260 --> 00:21:11,000
.ما زال هاديس لا يعلم

335
00:21:11,320 --> 00:21:15,850
ما زال بإمكاننا إنهاء هذا بدون إشعال
.فتيل حرب شاملة أو انهيار مجتمعيّ

336
00:21:15,850 --> 00:21:18,620
أي أنّك تقولين أنّ عليّ مواصلة
التزام الصّمت وقبول هذا؟

337
00:21:20,340 --> 00:21:22,030
.هذا مضيعة للوقت

338
00:21:25,430 --> 00:21:26,850
.سأقتله

339
00:21:26,850 --> 00:21:27,670
!مهلاً

340
00:21:29,430 --> 00:21:31,970
.زوجة التّنّين الّتي هربت من الموت

341
00:21:32,260 --> 00:21:34,800
.سأنهيك أنت أوّلاً

342
00:21:34,800 --> 00:21:38,430
،إن كان جلالته هو سبب هذا القتال
فلماذا لا تتحدّث معه؟

343
00:21:38,870 --> 00:21:41,060
إنّ الشّخص الّذي يلعن العائلة
الملكيّة حتّى الموت

344
00:21:41,060 --> 00:21:43,080
!ليس بشخص يمكن التّفاهم معه بالمنطق

345
00:21:43,080 --> 00:21:47,040
وجود هاديس لا يجلب سوى
!الفوضى لإمبراطوريّة رافي

346
00:21:47,360 --> 00:21:50,070
!ما كان يجب أن يولد من الأساس

347
00:21:50,770 --> 00:21:56,030
