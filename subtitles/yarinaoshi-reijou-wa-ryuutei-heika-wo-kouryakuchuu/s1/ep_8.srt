1
00:00:03,010 --> 00:00:04,780
.تفضّلي. غداؤك

2
00:00:04,780 --> 00:00:05,900
.شكرًا لك

3
00:00:06,170 --> 00:00:08,940
سوتي، حاول ألاّ تدمّر حقول صاحب
.الجلالة بينما تبحث عن الطّعام

4
00:00:09,630 --> 00:00:11,710
.كاميلا، اعتني بجلالته رجاءً

5
00:00:11,710 --> 00:00:12,610
.بالطّبع

6
00:00:12,610 --> 00:00:14,080
!سأغادر الآن

7
00:00:14,320 --> 00:00:15,370
.رافقتك السّلامة

8
00:00:17,980 --> 00:00:19,670
.سنهرول حتّى نصل الطّريق الرّئيسيّ

9
00:00:19,920 --> 00:00:22,650
.زيك، يمكنك تجاوزي في أيّ وقت

10
00:00:22,650 --> 00:00:25,110
.تعلمين أنّي لا أستطيع ذلك
.أنا فارسك

11
00:00:25,110 --> 00:00:27,470
.سمعتُ أنّه هنالك تحلية مع غداء اليوم

12
00:00:27,470 --> 00:00:30,420
.لا أظنّك نسيتِ سبب انضمامنا لفرسان التّنّين

13
00:00:30,420 --> 00:00:31,830
.أنا أذكر بالطّبع

14
00:00:31,830 --> 00:00:34,380
—اسمعي، لا تجلبي الأنظار
.لقد فات الوقت على ذلك

15
00:00:34,380 --> 00:00:35,660
.لا تجلبي الأنظار إليك أكثر

16
00:00:35,660 --> 00:00:38,160
!زيك، لن أدعك تهزمني في نزالاتنا التّدريبيّة

17
00:00:38,160 --> 00:00:40,030
!أخبرتك ألاّ تجلبي الأنظار

18
00:02:11,480 --> 00:02:14,940
الحلقة 8: أنا زوجة التّنّين، مكروهة من طرف
التّنانين وأريد أن نصير على ودّ ثانية

19
00:02:12,950 --> 00:02:15,580
.مرحبًا يا جيل! خذي هذه كعربون شكر

20
00:02:16,000 --> 00:02:18,770
شكرًا لك! سأعود لمساعدتك
.على تنظيف المزيد

21
00:02:19,030 --> 00:02:21,490
،اليوم هو استهلال التّنانين خاصّتكما
!صحيح؟ حظًّا سعيدًا

22
00:02:21,490 --> 00:02:22,380
ماذا؟

23
00:02:23,140 --> 00:02:25,320
استهلال التّنانين؟

24
00:02:25,730 --> 00:02:27,030
!اصطفّوا جميعًا

25
00:02:27,340 --> 00:02:31,510
سيتعرّف كلّ واحد منكم اليوم
.على تنّينتي. لن تقاتلوها

26
00:02:31,790 --> 00:02:34,880
سنرى إن كانت ستحني رأسها
.لكم لتحيّيكم أم لا فحسب

27
00:02:34,880 --> 00:02:36,470
.سيساعدنا ذلك على تحديد توافقكم

28
00:02:38,170 --> 00:02:40,270
.هذه تنّينتي روزا

29
00:02:40,990 --> 00:02:43,760
.أوّلاً، أريدكم أن تلاحظوا لون حراشفها

30
00:02:44,130 --> 00:02:46,720
تُحدَّد رُتب التّنانين عن طريق
.ألوان حراشفها

31
00:02:46,720 --> 00:02:50,020
الأعلى رتبة هو الفضّيّ، ثمّ الأسود
.والقرمزيّ وما إلى ذلك

32
00:02:50,020 --> 00:02:53,260
عندما يتشابه لون الحراشف، نعتمد
.معايير أخرى عن طريق لون العيون

33
00:02:53,260 --> 00:02:56,350
العيون الذّهبيّة هي الأعلى
.والأرجوانيّة هي الأدنى

34
00:02:56,350 --> 00:03:01,110
ولا يوجد أيّ تنّين فضّيٍّ ذهبيُّ
.العيون غير إله التّنانين رافي

35
00:03:01,110 --> 00:03:04,830
...سيّدي رافي إله التّنانين فعلاً
.مع أنّه لا يتمتّع بأيّ جلالة

36
00:03:05,130 --> 00:03:08,030
وبعده في أعلى المراتب، التّنانين
.السّوداء الأّتي نادرًا ما تظهر نفسها

37
00:03:08,030 --> 00:03:11,620
،إن كانت التّنانين البيضاء آلهة
.فإنّ السّوداء ملوك وملكات

38
00:03:11,620 --> 00:03:16,470
،ما يعني، أنّه خارج هذين الصّنفين
.فإنّ روزا هنا هي الأعلى مرتبة

39
00:03:16,470 --> 00:03:20,310
ورتبة فرسان التّنّين تُحدَّد
.من طرف رتبة تنانينهم

40
00:03:20,740 --> 00:03:23,760
،يرتدي التّلاميذ معاضد زرقاء
.لون لا نجده بين التّنانين

41
00:03:24,010 --> 00:03:26,400
وكلّ من يتمّ قبوله من طرف
تنّين عالي الرّتبة

42
00:03:26,400 --> 00:03:28,900
سيُقبل بشكل طبيعيّ
.من التّنانين الأقلّ رتبة

43
00:03:28,900 --> 00:03:31,620
،ستصل التّنانين الخضراء والبنّيّة الرّماديّة لاحقًا

44
00:03:31,620 --> 00:03:34,190
،لذلك حتّى إن رفضتكم روزا
.فلا حاجة للقلق أبدًا

45
00:03:34,190 --> 00:03:38,410
،لكن إن ردّت عليكم روزا التّحيّة
.فستكونون على الطّريق الصّحيح للتّرقية

46
00:03:38,410 --> 00:03:41,310
،إن كنتم ستقومون بهذا بالطّبع
.فلا تدعوا أيّ شيء يعترض أحلامكم

47
00:03:41,310 --> 00:03:43,270
!أجل

48
00:03:43,540 --> 00:03:45,690
!سيبدأ استهلال التّنانين الآن

49
00:03:45,690 --> 00:03:48,240
!اصطفّوا حسب نتائج آخر نزالاتكم التّدريبيّة

50
00:03:48,240 --> 00:03:49,950
!أجل

51
00:03:48,510 --> 00:03:49,950
!تشجّع يا زيك

52
00:04:02,760 --> 00:04:06,250
،ليس سيّئًا! ذلك يعني
"!ارحل، ولا تجرّب ثانية"

53
00:04:06,250 --> 00:04:07,200
—ماذا؟ كيف لذلك

54
00:04:07,200 --> 00:04:09,200
إنّها لم تتجاهلك بالكامل، صحيح؟

55
00:04:09,200 --> 00:04:11,020
حتّى التّعرّض لمضايقة
.من التّنانين تجربة جيّدة

56
00:04:11,460 --> 00:04:14,180
،كما أنّه إن حيّتك روزا في الحال

57
00:04:14,180 --> 00:04:16,840
.فسيحطّم ذلك كرامة زملائكم الفرسان الأقدم

58
00:04:17,750 --> 00:04:22,020
!التّالي

59
00:04:22,020 --> 00:04:23,150
!حاضرة

60
00:04:23,150 --> 00:04:24,410
.هذه أنت

61
00:04:24,620 --> 00:04:25,710
!سأبذل جهدي

62
00:04:33,920 --> 00:04:37,380
.أريد تنّيني الخاصّ لأستطيع أن أصادقه

63
00:04:37,380 --> 00:04:38,800
...وإن أمكن، أودّ من ذلك التّنّين أن

64
00:04:41,410 --> 00:04:42,880
!روزا! ما الّذي تفعلينه؟

65
00:04:42,880 --> 00:04:44,690
!توقّفي يا روزا! توقّفي

66
00:04:44,690 --> 00:04:46,150
!تراجعي في الحال

67
00:04:46,970 --> 00:04:48,230
!لا تجلسي هناك فحسب

68
00:04:48,230 --> 00:04:49,540
هل أنت بخير يا قائدة؟

69
00:04:49,540 --> 00:04:50,960
.إنّه مجرّد خدش

70
00:04:54,200 --> 00:04:57,950
.لماذا؟ أنا زوجة التّنّين

71
00:05:03,350 --> 00:05:05,830
.مرحبًا بعودتك! عدتِ باكرًا

72
00:05:07,700 --> 00:05:08,740
جيل؟

73
00:05:10,890 --> 00:05:12,570
.سأرتاح في غرفتي

74
00:05:18,490 --> 00:05:20,850
.أنا بلا فائدة تمامًا

75
00:05:21,180 --> 00:05:23,830
،إن كرهتني التّنانين
.لا يمكنني أن أصير فارسة تنّين

76
00:05:23,830 --> 00:05:27,670
.كما أنّه ليس لديّ أيّ سحر أيضًا
.لا أزال عاجزة عن رؤية سيّدي رافي

77
00:05:27,670 --> 00:05:30,370
.لم تكن لي أيّ فائدة لصاحب الجلالة

78
00:05:31,690 --> 00:05:33,340
.سأدخل يا جيل

79
00:05:37,870 --> 00:05:41,620
.اخبرني زيك بكلّ شيء. قال أنّ تنّينًا أذاكي

80
00:05:46,760 --> 00:05:48,950
...تحدّثتُ مع رافي أيضًا

81
00:05:50,010 --> 00:05:52,410
.كفّ عن التّذمّر! تحدّثنا بالفعل

82
00:05:52,410 --> 00:05:54,650
أنا أمنحها خيارًا، ألا ترى؟

83
00:05:54,990 --> 00:05:56,640
.لستُ أنا من عليه أن يقرّر

84
00:05:56,640 --> 00:05:57,880
.يجب أن يكون قرار جيل

85
00:05:59,640 --> 00:06:03,590
.مشويّ أو مطبوخ أو مبخّر أو مقليّ
أيّها تفضّلين؟

86
00:06:03,770 --> 00:06:05,430
ما الّذي أقرّره بالضّبط؟

87
00:06:05,430 --> 00:06:09,000
ماذا تقصدين؟ إنّ من لم يلزم مكانه
—وألحق بك الأذى سوف

88
00:06:09,000 --> 00:06:10,040
!اخرس يا رافي

89
00:06:10,440 --> 00:06:13,820
.سأقتله. سأقتله بكلّ تأكيد
!لن يمنعني شيء من قتله

90
00:06:14,020 --> 00:06:15,750
!اتّخذ الإمبراطور التّنّين قراره

91
00:06:15,750 --> 00:06:17,930
الخيار الوحيد المتبقّي هو التّتبيل
!وطريقة الطّبخ

92
00:06:17,930 --> 00:06:21,080
هل التّنانين قابلة للأكل؟ أيمكن أكلها؟

93
00:06:21,080 --> 00:06:24,410
!بالطّبع— يكفي! لقد ألحق الأذى بجيل

94
00:06:24,410 --> 00:06:26,650
الطّريقة الوحيد الّتي عليه التّكفير بها
!عن خطئه هي بأن يصير طبقًا لذيذًا

95
00:06:26,650 --> 00:06:28,930
!أنا بخير! كانت مجرّد خدوش

96
00:06:28,930 --> 00:06:30,410
!فُزعتُ قليلاً فحسب

97
00:06:30,410 --> 00:06:32,990
ولكن... قال أنّك لم تستطيعي
.حتّى تناول غدائك

98
00:06:32,990 --> 00:06:35,930
اخرس! جيل مهمّة وعزيزة عليّ
!أكثر من أيّ تنّين

99
00:06:35,930 --> 00:06:39,240
.اهدأ يا صاحب الجلالة
.لا تتشاجر مع سيّدي رافي

100
00:06:40,020 --> 00:06:43,650
.اخترتُ جيل كعروسي. لن أقبل أيّ جدال

101
00:06:44,450 --> 00:06:46,670
!ليس حتّى منك يا رافي

102
00:06:47,030 --> 00:06:50,880
.يا إلهي كم يسهل إرضائي
.كم أكره نفسي

103
00:06:50,880 --> 00:06:53,440
تجارب زوجة التّنّين؟
!لا أهتمّ لذلك

104
00:06:53,440 --> 00:06:55,630
،إن ضايقت التّنانين زوجتي
!فستتحوّل إلى مكوّنات طبخ

105
00:06:55,630 --> 00:06:57,980
إن لم يعجبك ذلك، فلماذا
لا تبحث عن وعاء أفضل؟

106
00:06:57,980 --> 00:06:58,920
...يا صاحب الجلالة

107
00:06:58,920 --> 00:07:01,300
نـ-نعم، ماذا؟

108
00:07:02,670 --> 00:07:03,690
.أنا أحبّك

109
00:07:03,690 --> 00:07:06,160
ما-ماذا؟ ما-ما-ما الغاية من ذلك فجأة؟

110
00:07:06,160 --> 00:07:07,540
.لكنّي بخير

111
00:07:07,540 --> 00:07:10,270
،حتّى إن لم نتوافق معًا
!بإمكاننا التّواصل عن طريق القتال

112
00:07:10,620 --> 00:07:13,250
أشعر بتحسّن أكثر الآن بفضلك
!يا صاحب الجلالة

113
00:07:13,250 --> 00:07:16,400
.لقد بدأت أشعر بالجوع
!سآكل صندوق غدائي الآن

114
00:07:17,110 --> 00:07:20,880
،صحيح أنّي أعيش حياتي للمرّة الثانية
.لكنّ ذلك لا يعني أنّ كلّ شيء سينجح

115
00:07:21,410 --> 00:07:25,740
.ما عليّ فعله الآن... هو إسعاد هذا الشّخص

116
00:07:28,650 --> 00:07:29,970
.كان لذيذًا

117
00:07:29,970 --> 00:07:30,890
.جيّد

118
00:07:30,890 --> 00:07:33,390
.بخصوص التّنانين... لديّ هدف الآن

119
00:07:33,640 --> 00:07:35,260
!أريد تنّينًا أسودًا ذهبيّ العينين

120
00:07:35,260 --> 00:07:39,960
تنّين أسود ذهبيّ العينين؟
.لم أرَ واحدًا منها بعد

121
00:07:40,690 --> 00:07:43,060
.يسأل رافي لماذا تريدينه من الأساس

122
00:07:43,060 --> 00:07:45,860
!لأنّه سيكون بمثل ألوانك يا صاحب الجلالة

123
00:07:45,860 --> 00:07:47,550
!أريد ركوب تنّين أسود ذهبيّ العينين

124
00:07:47,970 --> 00:07:51,160
!لذلك سأواصل المحاولة! آمل أن تشجّعني

125
00:07:58,090 --> 00:07:59,770
مثلي أنا؟

126
00:07:59,770 --> 00:08:03,780
.إ-إنّها ظريفة للغاية
.لا أستطيع تحمّل هذا أكثر

127
00:08:04,810 --> 00:08:07,760
...تنّين أسود ذهبيّ العينين

128
00:08:07,760 --> 00:08:09,220
!هيّا

129
00:08:10,830 --> 00:08:12,500
.يا لبسالتا

130
00:08:14,840 --> 00:08:16,680
تمّ تكليفي هنا اليوم؟

131
00:08:16,680 --> 00:08:19,050
.نعم، سنطلب منك القيام بدوريّات في البلدة

132
00:08:19,050 --> 00:08:21,960
هل يعني هذا أنّي لن أستطيع
المشاركة في تدريب اليوم؟

133
00:08:21,960 --> 00:08:22,930
.هذا صحيح

134
00:08:22,930 --> 00:08:26,440
اتّبعي التّعليمات المقدّمة لك
.من الوحدة الّتي تنتظر في ساحة النّافورة

135
00:08:26,440 --> 00:08:28,870
.استعملي معضد ذراعك للتّعريف عن نفسك

136
00:08:28,870 --> 00:08:30,360
!عُلم وسيُنفّذ

137
00:08:31,950 --> 00:08:35,830
.سأتمالك نفسي وأجمع المعلومات في البلدة

138
00:08:36,570 --> 00:08:41,150
،لا يحصل التّلاميذ على أزياء
.لذلك سأبحث عن شخص بمعضد ذراع

139
00:08:50,880 --> 00:08:54,770
حسنًا، هل أنت الفتاة
الّتي انضمّت قبل أيّام؟

140
00:08:54,770 --> 00:08:56,500
.سمعتُ الكثير عنك

141
00:08:57,720 --> 00:09:00,010
.لم أتخيّل أبدًا أنّي سأراه هنا بالتّحديد

142
00:09:00,970 --> 00:09:03,720
.أنا لورنس. سررت بلقائك

143
00:09:07,110 --> 00:09:10,610
!ستُدمّر وحدتنا الآن فرسان تنّين نويترال

144
00:09:10,610 --> 00:09:13,060
.ستُهاجم مجموعتنا بالكامل كما خطّطنا

145
00:09:13,440 --> 00:09:15,130
،عندما تظهر أزمة ما

146
00:09:15,130 --> 00:09:18,530
،فإلى أن نجد استراتيجيّة فعّالة
!يكون الهرب أفضل خيار

147
00:09:20,740 --> 00:09:22,400
.لورنس مارتون

148
00:09:22,400 --> 00:09:25,050
.كان قائدًا عسكريًّا معاونًا مذهلاً في وحدتي

149
00:09:25,050 --> 00:09:28,190
.كانت قراراته صحيحة دائمًا

150
00:09:31,430 --> 00:09:32,550
.سررت بلقائك

151
00:09:36,410 --> 00:09:38,620
.أنا جيل. سررت بلقائك

152
00:09:38,940 --> 00:09:41,120
.اسمك جيل إذًا؟ يا له من اسم جميل

153
00:09:41,550 --> 00:09:45,810
إن لم أكن مخطئًا، فإنّه نفس اسم
.ابنة المارغريف سرفيل في كريتوس

154
00:09:45,810 --> 00:09:46,400
أتعرفين ذلك؟

155
00:09:46,400 --> 00:09:49,900
!فـ-فعلاً؟ لم أكن أعلم

156
00:09:49,900 --> 00:09:51,620
حـ-حسنًا، أين البقيّة؟

157
00:09:51,620 --> 00:09:54,400
،تمّ تكليفنا بواجب الدّوريّات قبل شهر

158
00:09:54,400 --> 00:09:56,530
.لكن يبدو أنّ لا أحد آخر يحضر مؤخّرًا

159
00:09:56,530 --> 00:09:58,070
هل أنت وحدك أيضًا؟

160
00:09:59,190 --> 00:10:01,270
هل تعتقد أنّهم يحاولون إقصاءنا؟

161
00:10:01,270 --> 00:10:04,160
.لديك غرائز جيّدة! لكن ليس تمامًا

162
00:10:04,940 --> 00:10:07,020
.حان الوقت. لننطلق

163
00:10:07,830 --> 00:10:12,040
إنّ التّلاميذ الّذين على وفاق
.مع التّنانين يبدؤون بالعناية بها

164
00:10:12,520 --> 00:10:14,310
،أمّا من لا يتوافقون معها

165
00:10:14,310 --> 00:10:17,630
يتمّ إرسالهم في دوريّات
.ليعتادوا على هذه المنطقة

166
00:10:17,630 --> 00:10:18,870
ليعتادوا على المنطقة؟

167
00:10:19,350 --> 00:10:21,310
،هذه مجرّد نظريّة شخصيّة

168
00:10:21,310 --> 00:10:23,980
لكن أعتقد أنّ حماية إله التّنانين رافي للسّماء

169
00:10:23,980 --> 00:10:25,750
هي الّتي تسمح للتّنانين بأن تولد
.وتكبر تحت هذه السّماء

170
00:10:25,750 --> 00:10:29,890
لذلك السّبب تميل التّنانين للتّوافق أكثر
.مع من يريدون حماية هذه البلدة

171
00:10:30,200 --> 00:10:33,410
...إذًا فهي مسألة حبٍّ لهذه البلاد

172
00:10:35,350 --> 00:10:39,980
بعد ذكرك للأمر... سمعتُ أنّ الأوضاع
.في العاصمة ليست مستقرّة

173
00:10:40,470 --> 00:10:44,150
تقصدين قصّة أنّ هاديس تيوس
رافي إمبراطور مزيّف، صحيح؟

174
00:10:44,640 --> 00:10:48,910
من المفترض أنّ اللّوردات
،يجرون تحقيقات لتحديد صحّة القصّة

175
00:10:48,910 --> 00:10:50,960
لكنّهم في الحقيقة ينتظرون فقط
.ليروا لصالح من ستُرجّح الكفّة

176
00:10:51,300 --> 00:10:52,700
فعلاً؟

177
00:10:53,190 --> 00:10:55,200
.الفضول يراود الجميع

178
00:10:55,200 --> 00:10:57,480
،في عيد مولد الإمبراطور العشرين

179
00:10:57,480 --> 00:11:00,170
هل سيصير الأمير غيورغ جثّة هامدة أم لا؟

180
00:11:00,390 --> 00:11:02,840
ولذلك السّبب، رغم أنّهم
،ينشرون ملصقات مطلوبين

181
00:11:02,840 --> 00:11:05,500
.فلم يقوموا بإرسال أيّ فرق بحث بعد

182
00:11:05,890 --> 00:11:09,720
إنّ دوقيّة نويترال تميل أكثر في العادة
.إلى عدم الانحياز لأيّ جانب

183
00:11:10,020 --> 00:11:14,040
إنّ فرسان التّنّين من النّخبة
،وضروريّون لتأمين السّلام

184
00:11:14,040 --> 00:11:16,540
ويحتاج الفرسان لشخص بارع
.يعمل في الخفاء

185
00:11:16,540 --> 00:11:20,750
لهذا السّبب حتّى أولئك الّذين لا يتوافقون
.مع التّنانين لا يتمّ طردهم على الفور

186
00:11:21,210 --> 00:11:24,840
والسّبب الّذي جعلك تقول أنّها عملية
.إقصاء، ولكن ليس حسب ما اعتقدت أنا

187
00:11:25,470 --> 00:11:29,080
لماذا لا تشرح ذلك للبقيّة؟

188
00:11:29,080 --> 00:11:31,240
.لكنّها مجرّد نظريّة شخصيّة

189
00:11:32,720 --> 00:11:34,540
يا سيّد لورنس؟

190
00:11:34,540 --> 00:11:38,090
.نادني لورنس فحسب
.انضممنا في نفس الوقت تقريبًا

191
00:11:38,760 --> 00:11:40,220
...حسنًا يا جيل

192
00:11:40,640 --> 00:11:42,720
.في الحقيقة، لقد سمعتُ إشاعات

193
00:11:42,990 --> 00:11:46,720
إنّه يعلم! إنّها التّعابير الّتي تعلو وجهه
!عندما يطيح بفريسته في العادة

194
00:11:47,130 --> 00:11:50,830
إنّ الإشاعات ستُفسد دقّة جمع
!المعلومات، لذلك لا أحتاج سماعها

195
00:11:51,560 --> 00:11:53,210
...لا تقولي ذلك

196
00:11:53,210 --> 00:11:54,490
!لن أستمع لك

197
00:11:53,460 --> 00:11:55,570
السّبب المزعوم وراء عدم
قيام دوقيّة نويترال

198
00:11:55,570 --> 00:11:59,050
بإرسال القائدة إلنزيا للقيام
...بالبحث هو

199
00:11:59,050 --> 00:12:01,570
...أنّ شخصًا فُقد في كريتوس و

200
00:12:01,070 --> 00:12:03,000
!لا يمكنني سماعك

201
00:12:04,460 --> 00:12:07,730
اسمعا أنتما! أنتما من تلاميذ
فرسان التّنّين، صحيح؟

202
00:12:08,620 --> 00:12:12,290
أريدكما أن تُبلغا رسالة لصاحبة
.السّموّ إلنزيا في الحال

203
00:12:12,290 --> 00:12:14,580
،اعذرني على فظاظتي
لكن هلّي أن أسأل من أنت؟

204
00:12:15,120 --> 00:12:16,790
.أنا ريستيارد

205
00:12:17,130 --> 00:12:21,550
،ريستيارد تيوس رافي
.الأمير الثّاني لإمبراطوريّة رافي

206
00:12:26,000 --> 00:12:28,550
.سنستأذن الآن بالمغادرة

207
00:12:28,550 --> 00:12:30,190
.لا، انتظري

208
00:12:30,860 --> 00:12:34,650
جيل، هلاّ انتظرت هنا للحظة؟
.لديّ ما أقوله لك بعد هذا

209
00:12:34,980 --> 00:12:38,980
.والأكثر من ذلك... هو أنّ هذا الشّخص مزعج

210
00:12:38,980 --> 00:12:41,560
...إن سمحتِ لي بالكلام يا أختي الكبيرة

211
00:12:41,810 --> 00:12:43,690
لا تعاملينني كآفة أو ما شابه، صحيح؟

212
00:12:43,690 --> 00:12:45,000
...بعثت لك رسائل عديدة

213
00:12:45,000 --> 00:12:47,590
لا يُعقل أنّك رفضت الرّدّ عليها
قصدًا، أليس كذلك؟

214
00:12:47,590 --> 00:12:50,510
ما كانت أختي الكبيرة لتتصرّف
!بمثل هذه الطّريقة القاسية

215
00:12:50,510 --> 00:12:51,660
!لا أريد حتّى تخيّل ذلك

216
00:12:51,910 --> 00:12:54,240
أرأيت؟ هذا مزعج، صحيح؟

217
00:12:55,380 --> 00:12:57,760
.الشّاي هنا مقرف كالعادة

218
00:12:57,970 --> 00:13:02,310
أنا أحرص دائمًا على توفير أفضل
.شاي لفرسان التّنّين خاصّتي

219
00:13:02,310 --> 00:13:04,620
أتقول ذلك فعلاً بعد إعدادك
للشّاي بدون طلب الإذن أوّلاً؟

220
00:13:04,620 --> 00:13:06,720
أليس جيّدًا بما يكفي إن كان بإمكانك
.شربه؟ هذه مجموعة فرسان

221
00:13:07,180 --> 00:13:10,180
إنّهما يتوافقان معًا بشكل كبير لدرجة
.أنّهما يتكلّمان بشكل غير رسميّ معًا

222
00:13:10,440 --> 00:13:13,160
.يا أختي، سأدخل صلب الموضوع مباشرة

223
00:13:13,160 --> 00:13:14,680
مع عليّ أن أتحالف؟

224
00:13:14,680 --> 00:13:18,280
.اسمع... ثمة تلميذة هنا
—بإمكانك أن تكون أكثر

225
00:13:18,280 --> 00:13:21,950
...إن تسرّب هذا الكلام
.فسيكون عليك قطع عنقها فحسب

226
00:13:23,100 --> 00:13:27,780
أعلن عمّنا نفسه الإمبراطور
.الجديد وأطاح بذلك الغبيّ

227
00:13:27,780 --> 00:13:29,360
.يعرف الجميع في تلك الإمبراطوريّة ذلك

228
00:13:29,740 --> 00:13:31,410
كما كانت هناك أيّام عديدة من الاضطرابات

229
00:13:31,410 --> 00:13:33,630
بسبب ما يطلق عليه النّاس
.تمرّد الإمبراطور المزيّف

230
00:13:33,630 --> 00:13:35,080
وأنت؟

231
00:13:35,080 --> 00:13:38,750
بين عمّنا وهاديس، من في رأيك
يملك السّيف السّماويّ الحقيقيّ؟

232
00:13:39,130 --> 00:13:41,140
كان السّيف السّماويّ مفقودًا
،لثلاثمائة سنة

233
00:13:41,140 --> 00:13:44,280
وعثر عمّنا على الحقيقيّ
في هذا الوقت بالتّحديد؟

234
00:13:44,280 --> 00:13:45,220
.هذا سخيف

235
00:13:45,410 --> 00:13:49,080
حسب هذه الكلمات، أرى أنّك
.اتّخذت قرارك حيال هذا سلفًا

236
00:13:49,470 --> 00:13:52,820
،إنّه ريفيّ فظّ لا يُناسب حسّيّ المرهف

237
00:13:52,820 --> 00:13:55,050
لكنّ هاديس وبلا أدنى شكّ
.هو الإمبراطور التّنّين

238
00:13:55,290 --> 00:13:58,270
.أوافقك. ذلك الفتى هو الإمبراطور التّنّين

239
00:13:58,510 --> 00:14:01,770
،إن طريقة قولهما لذلك ليست لطيفة
!لكنّهما قد يكونان شخصين طيّبين

240
00:14:02,330 --> 00:14:05,480
،إن شرحنا لهما كلّ شيء
!فقد يقفان إلى جانبنا

241
00:14:05,710 --> 00:14:09,040
.كما سمعتُ أنّ ذلك الغبيّ قد تزوّج

242
00:14:09,040 --> 00:14:12,860
وقد قيل أنّه اختار فتاة
.من أصول مشكوك فيها

243
00:14:12,860 --> 00:14:17,160
.ذلك الغبيّ. لا أمل يُرجى منه بكلّ صراحة

244
00:14:17,160 --> 00:14:20,470
.نعم. لنأمل أنّه مجرّد سوء فهم

245
00:14:21,700 --> 00:14:25,820
.بغضّ النّظر، لا يمكننا أن نصير حلفاء هاديس

246
00:14:26,200 --> 00:14:28,470
.لا أنا ولا أنت أيضًا

247
00:14:28,470 --> 00:14:30,850
رغم أنّنا نعرف أنّه الإمبراطور التّنّين؟

248
00:14:30,850 --> 00:14:32,440
.لا تجعلني أقولها علنًا يا ريستيارد

249
00:14:32,750 --> 00:14:36,040
.كانت أمّي ابنة العائلة الدّوقيّة لنويترال

250
00:14:36,040 --> 00:14:39,240
.وكانت أمّك ابنة عائلة دوقيّة ليرزاتز

251
00:14:39,240 --> 00:14:44,380
إنّ سبب عدم سعيهم خلف أيّ منّا
.هو لأنّ لدينا عائلات تدعمنا

252
00:14:44,380 --> 00:14:45,540
.هذا صحيح

253
00:14:45,540 --> 00:14:49,490
تسري في عروقنا الدّماء القديمة للعائلات الثّلاثة
.العظيمة كأعضاء من عائلة رافي الإمبراطوريّة

254
00:14:49,490 --> 00:14:52,400
ولذلك السّبب لا يجب أن نسمح
.لأفعال عمّنا المتهوّرة بالاستمرار

255
00:14:52,710 --> 00:14:56,610
لكن لن يقبل أيّ من دوق نويترال
.أو دوق ليرزاتز بهاديس

256
00:14:56,940 --> 00:14:59,870
.فقدَ كلاهما وليّ عهد

257
00:14:59,870 --> 00:15:02,300
.أخوانا الكبيرين

258
00:15:04,330 --> 00:15:07,030
.أفهم تمامًا ما تقوله

259
00:15:07,030 --> 00:15:11,690
.تريدنا أن نساعد هاديس ليتولّى السّيطرة

260
00:15:11,690 --> 00:15:15,510
إنّ عائلتي حياديّة بالفعل
.ولديّ القليل من الأعباء

261
00:15:15,790 --> 00:15:18,560
—إن صرتِ حليفة هاديس، فأنا

262
00:15:18,560 --> 00:15:22,930
.لن أكون عدوّته
.ذلك كلّ ما يمكنني أن أعد به

263
00:15:26,290 --> 00:15:27,130
!جيل

264
00:15:27,130 --> 00:15:27,850
!حاضرة

265
00:15:28,190 --> 00:15:30,840
أردتُ الحديث معك بشأن ما حدث
.مع روزا البارحة

266
00:15:30,840 --> 00:15:32,580
.اسمحي لي أن أعتذر أوّلاً

267
00:15:33,080 --> 00:15:37,570
أنا آسفة. ارتحت فعلاً لأنّك لم تتكبّدي
.أيّ إصابات خطيرة

268
00:15:37,790 --> 00:15:40,550
لا بأس، حدث ذلك
.لأنّي لا أتوافق مع التّنانين فحسب

269
00:15:40,910 --> 00:15:45,000
كنتُ متفاجئة أيضًا. لا أصدّق
.أنّ روزا حاولت إخافتك

270
00:15:45,000 --> 00:15:47,770
إخافتها؟ أذلك صحيح؟

271
00:15:48,180 --> 00:15:50,550
تنّينة قرمزيّة تخيف طفلة مثلها؟

272
00:15:50,550 --> 00:15:52,500
،يبدو أنّ الجميع قد أساؤوا الفهم

273
00:15:52,760 --> 00:15:57,890
لكنّ روزا هدّدتك لأنّها رأتك
.كنظيرة لها، وليس كتهديد

274
00:15:58,140 --> 00:15:59,470
أنا؟

275
00:15:59,470 --> 00:16:01,930
.يريد فريق البحوث التّحقيق في الأمر أكثر

276
00:16:01,930 --> 00:16:04,050
—إن حدث أيّ شيء، فسأكون هنا لـ

277
00:16:04,050 --> 00:16:07,780
!لا حاجة لمثل هذا العمل المملّ
!سأقبل بها تحت رعايتي بكلّ سرور

278
00:16:08,070 --> 00:16:09,740
!جيل واحدة من فرساني

279
00:16:09,740 --> 00:16:12,970
.سأطلب منك إذًا أن تُعيّن كمرافقة لي

280
00:16:12,970 --> 00:16:17,000
.برينهيلدي تنّينة قرمزيّة ذهبيّة العينين
كيف يمكنك معارضة ذلك؟

281
00:16:17,780 --> 00:16:19,150
.افعل ما يحلو لك

282
00:16:19,150 --> 00:16:19,760
ماذا؟

283
00:16:19,760 --> 00:16:22,370
.لك كلّ امتناني يا أختي الطّيّبة

284
00:16:23,040 --> 00:16:25,260
.حسنًا، سأعتمد عليك

285
00:16:25,260 --> 00:16:26,740
!حا-حاضرة

286
00:16:28,160 --> 00:16:31,560
.لا تزالين تلميذة، صحيح؟ اتبعيني

287
00:16:31,560 --> 00:16:34,170
هل تعرف المكان جيّدًا يا صاحب السّموّ؟

288
00:16:34,170 --> 00:16:37,680
.كنتُ عضوًا من هذه الوحدة
.أعتقد أنّ ذلك دام تقريبًا عامًا واحدًا

289
00:16:38,040 --> 00:16:40,880
إنّ فرسان التّنّين التّابعين لنويترال
.هم نخبة النّخبة

290
00:16:40,880 --> 00:16:42,390
.لا يوجد ما لا يمكنه تعلّمه هنا

291
00:16:42,830 --> 00:16:45,010
كما لديّ الكثير من الأصدقاء
.بفضل الوقت الّذي قضيته هنا

292
00:16:45,010 --> 00:16:47,470
كما أنّ قائدي العسكريّ المساعد
.انضمّ إلى هذه الوحدة في نفس الوقت

293
00:16:47,890 --> 00:16:51,100
ألا يعني هذا أنّ عددًا كبيرًا
من الفرسان غادروا دفعة واحدة؟

294
00:16:51,100 --> 00:16:54,380
أعتقد أنّ فرسان التّنّين لنويترال
.قد تعلّموا شيئًا ما وقتها أيضًا

295
00:16:54,990 --> 00:16:58,790
لماذا هي مع الأمير ريستيارد؟
تمّ إرسالها للشّارع، صحيح؟

296
00:16:58,790 --> 00:17:00,280
لا تعتقد أنّه اختارها، صحيح؟

297
00:17:00,280 --> 00:17:01,360
.بالطّبع لا

298
00:17:01,360 --> 00:17:03,640
.أنتم أيّها التّلاميذ! يا لها من فرصة مثاليّة

299
00:17:03,640 --> 00:17:06,680
.سأجيب أسئلتكم بصفتي فارسًا أقدم
.اطرحوا عليّ أيّ سؤال

300
00:17:07,660 --> 00:17:10,130
حسنًا... أيمكنني قول شيء ما؟

301
00:17:10,130 --> 00:17:12,720
ما الّذي سيقوله؟
ولماذا تعلو وجهه تلك الملامح؟

302
00:17:12,720 --> 00:17:15,970
إن جعلتها مساعدتك، فستعدّ لك
!شايًا فظيعًا لم تشرب مثله من قبل

303
00:17:15,970 --> 00:17:17,040
!كن حذرًا رجاءً

304
00:17:17,040 --> 00:17:17,550
ماذا؟

305
00:17:18,770 --> 00:17:19,760
ومن أنت؟

306
00:17:19,760 --> 00:17:21,380
.انضممت في نفس الوقت معها فحسب

307
00:17:21,380 --> 00:17:25,240
إنّها لا تجيد الخياطة أو الأعمال
.المنزليّة أيضًا. تحقّقتُ من ذلك

308
00:17:25,240 --> 00:17:27,570
.إنّها الأقلّ كفاءة لتكون مساعدة أيّ أحد

309
00:17:28,190 --> 00:17:30,720
.لكنّ مهاراتها في المسايفة بلا نظير

310
00:17:32,100 --> 00:17:34,360
.مفهوم. سأتذكّر كلامك هذا

311
00:17:34,360 --> 00:17:37,060
!عرفتُ هذا! إنّه شخص طيّب

312
00:17:39,970 --> 00:17:43,300
تعرفين كيف تحيّين التّنانين، صحيح؟
.جرّبي ذلك

313
00:17:43,710 --> 00:17:45,020
.أعتذر على تطفّلي

314
00:17:45,500 --> 00:17:48,120
ماذا أفعل إن كانت ردّة فعلها سيّئة أيضًا؟

315
00:17:48,120 --> 00:17:51,330
.لا، لا يجب عليّ التّفكير حيال ذلك الآن

316
00:17:57,060 --> 00:17:58,840
ما الخطب يا هيلدي؟

317
00:17:59,150 --> 00:18:00,970
لقد تجاهلتني، صحيح؟

318
00:18:01,930 --> 00:18:04,180
.لا. لقد هربت منك

319
00:18:04,180 --> 00:18:06,270
.نعم، هربت

320
00:18:06,540 --> 00:18:10,730
،برينهيلدي تنّينة قرمزيّة ذهبيّة العينين
.نظرت لطفلة بشريّة وهربت

321
00:18:10,730 --> 00:18:12,950
هذا أسوأ من إخافتي، صحيح؟

322
00:18:13,310 --> 00:18:17,060
.رأيتها تتصرّف كذلك فقط مرّة واحدة

323
00:18:17,060 --> 00:18:19,500
...أنا... لديّ دروس، لذلك

324
00:18:19,500 --> 00:18:20,930
!مع هاديس تيوس رافي

325
00:18:20,930 --> 00:18:23,870
حدث ذلك عندما قابلت أخي
!الصّغير عديم الفائدة لأوّل مرّة

326
00:18:23,150 --> 00:18:24,320
!أنا أستأذن

327
00:18:24,660 --> 00:18:26,600
!لن تهربي منّي

328
00:18:26,600 --> 00:18:30,500
من تكونين يا هذه؟
!ماذا تخفين؟ أخبريني

329
00:18:39,470 --> 00:18:41,550
.لقد عدت

330
00:18:41,550 --> 00:18:42,860
.مرحبًا بك

331
00:18:42,860 --> 00:18:44,720
.يبدو أنّ يومك كان صعبًا

332
00:18:44,720 --> 00:18:46,470
مهلاً، أين زيك؟

333
00:18:46,470 --> 00:18:49,180
،تمّ تعييننا في مكانين مختلفين
.لذلك نتصرّف بشكل مستقلّ

334
00:18:50,750 --> 00:18:51,870
...يا صاحب الجلالة

335
00:18:52,710 --> 00:18:55,260
.أبليتِ حسنًا. لا بدّ أنّك متعبة

336
00:18:55,670 --> 00:18:56,730
.أعلم

337
00:18:56,980 --> 00:18:58,940
!لنعدّ شيئًا لذيذًا على العشاء

338
00:18:59,300 --> 00:19:02,130
ليس عليك إعداد العشاء لزيك
.يا صاحب الجلالة

339
00:19:02,130 --> 00:19:04,560
.سأحصد بعض الملفوف وأقدّمه له

340
00:19:04,560 --> 00:19:06,400
.إن كان هذا رأيك، فلا بأس بذلك

341
00:19:06,400 --> 00:19:07,990
...بالمناسبة

342
00:19:07,990 --> 00:19:09,440
!تفضّلي يا جيل

343
00:19:11,520 --> 00:19:13,230
!أريد أخرى يا صاحب الجلالة

344
00:19:13,230 --> 00:19:15,690
.ماذا؟ يبدو أنّك في مزاج لبعض الدّلال اليوم

345
00:19:16,510 --> 00:19:19,720
أردتُ الإسراع في العودة للمنزل
.لرؤيتك يا صاحب الجلالة

346
00:19:19,720 --> 00:19:22,920
اتّضح أنّ الرّغبة في رؤية الشّخص
.الّذي تحبّه عندما تتعب حقيقيّة

347
00:19:23,720 --> 00:19:25,650
!ها أنت ذي تهاجمين بدون سابق إنذار

348
00:19:25,650 --> 00:19:27,700
.لـ-لكنّ ذلك لن ينال منّي بسهولة

349
00:19:27,700 --> 00:19:29,490
.أنا معتاد على ذلك

350
00:19:29,490 --> 00:19:34,610
.و-وأنا... اشتقت إليك أيضًا

351
00:19:34,610 --> 00:19:36,190
أين هي كاميلا؟

352
00:19:36,190 --> 00:19:37,540
.أنا هنا

353
00:19:37,540 --> 00:19:39,710
أتمنّى لو تلاحظين مثل هذه
.الأشياء قبل أن تبدآ بالمغازلة يا جيل

354
00:19:39,710 --> 00:19:42,580
.أنا آسفة. كنتُ أرى صاحب الجلالة فقط

355
00:19:42,580 --> 00:19:44,570
!وجدتك يا هاديس

356
00:19:44,570 --> 00:19:45,990
!اهرب يا صاحب الجلالة

357
00:19:45,990 --> 00:19:47,080
!مهلاً يا كاميلا

358
00:19:47,080 --> 00:19:49,730
،تساءلت أين يمكن أن تكون مختبئًا

359
00:19:49,730 --> 00:19:51,780
!لكنّي لم أتخيّل أبدًا أن تكون قريبًا هكذا

360
00:19:51,780 --> 00:19:54,780
ما الّذي... تفعله بالضّبط؟

361
00:19:54,780 --> 00:19:56,600
أحصد الخضروات؟

362
00:19:56,820 --> 00:20:01,210
...إمبراطور بلادنا... في وقت طارئ كهذا

363
00:20:01,210 --> 00:20:03,670
عفوًا... أتريد بعضها؟

364
00:20:03,670 --> 00:20:04,980
!ثمّة حدود أيّها الغبيّ

365
00:20:04,980 --> 00:20:07,040
!ظننتُ أنّك ستستعدّ للبدء بمقاومتك

366
00:20:07,040 --> 00:20:08,980
!تعال معي في الحال! سآخذك لأختنا

367
00:20:08,980 --> 00:20:09,530
.لا أريد

368
00:20:09,530 --> 00:20:10,390
!لا تريد؟

369
00:20:10,390 --> 00:20:12,300
...لقد عدت! عفوًا

370
00:20:12,300 --> 00:20:14,620
ماذا يحدث هنا؟

371
00:20:14,620 --> 00:20:18,030
.إنّه هنا لأجل صاحب الجلالة
.يبدو أنّه تبعني

372
00:20:18,030 --> 00:20:19,170
.أرخيتُ دفاعاتي

373
00:20:19,170 --> 00:20:21,810
...لا يُعقل يا جيل
أنّك لم تقومي بإضاعته قصدًا؟

374
00:20:21,810 --> 00:20:24,660
لا، لكن إن كانوا سيعثرون علينا
،في كلّ الأحوال

375
00:20:24,660 --> 00:20:27,150
ظننتُ أنّه قد يكون من الأفضل
.إن كان هو من سيعثر علينا

376
00:20:27,150 --> 00:20:30,460
إنّه أمير، لكنّه أتى للبحث
.عن صاحب الجلالة بنفسه

377
00:20:30,460 --> 00:20:31,800
.لا أعتقد أنّه عدوّنا

378
00:20:31,800 --> 00:20:35,300
.حسنًا... ما كان بإمكاننا البقاء هكذا للأبد

379
00:20:35,300 --> 00:20:37,280
.لكنّ ذلك يُحزنني بعض الشّيء

380
00:20:37,280 --> 00:20:38,960
،عندما كنت أعمل

381
00:20:38,960 --> 00:20:41,420
كنتُ سعيدة لمعرفتي
.أنّ صاحب الجلال هنا بانتظاري

382
00:20:42,170 --> 00:20:43,000
!كلاّ

383
00:20:43,000 --> 00:20:44,000
!لن أذهب

384
00:20:44,000 --> 00:20:46,430
سأبقى هنا وأطبخ كلّ يوم
!منتظرًا عودة عروسي للمنزل

385
00:20:46,430 --> 00:20:47,690
!سأكون رجلاً عاديًّا

386
00:20:47,690 --> 00:20:50,810
لا يمكنك أبدًا أن تصير رجلاً
!عاديًّا أيّها الغبيّ

387
00:20:50,810 --> 00:20:52,020
!مهما قلت، فلن أذهب معك

388
00:20:52,020 --> 00:20:53,660
كما أنّهم هم من طردوني
!من العاصمة على أيّ حال

389
00:20:53,660 --> 00:20:56,970
!كفّ عن التّصرّف كالأطفال
!لا أطيق ذلك الجانب منك بشدّة

390
00:20:56,970 --> 00:20:59,470
غادر إذًا! سأجعل هذا المكان
.عاصمتي الإمبراطوريّة

391
00:20:59,470 --> 00:21:01,240
.لن تكون تلك مشكلة بما أنّي الإمبراطور

392
00:21:01,240 --> 00:21:04,080
!أنا لا أصدّق تصرّفاتك هذه

393
00:21:04,080 --> 00:21:06,810
هل سنكون فعلاً قادرين
على ترك هذه الحياة خلفنا؟

394
00:21:06,810 --> 00:21:09,710
.سيكون علينا إقناع صاحب الجلالة أوّلاً

395
00:21:09,710 --> 00:21:11,630
.سأحرص على ذلك

396
00:21:12,340 --> 00:21:13,890
!وإن استعملتُ القوّة

397
00:22:45,590 --> 00:22:48,420
قصّة من فترة قصيرة

398
00:22:48,720 --> 00:22:52,130
.حبّة، حبّتان، ثلاث حبّات فراولة

399
00:22:52,430 --> 00:22:54,590
.سأترك ذات الشّكل الجيّد

400
00:22:55,130 --> 00:22:57,110
.وربّما سأصنع المربّى بالبقيّة

401
00:22:57,110 --> 00:22:58,640
.يبدو أنّك تستمتع بوقتك

402
00:22:58,640 --> 00:22:59,660
.بالطّبع

403
00:23:00,040 --> 00:23:05,310
عروسي تعمل بجدّ. عليّ بذل جهدي
.أيضًا استعدادًا لعودتها للمنزل

404
00:23:05,840 --> 00:23:07,690
ربّما نأكل الهليون اليوم؟

405
00:23:07,690 --> 00:23:10,500
هل تحبّه من الأساس؟

406
00:23:10,500 --> 00:23:11,750
.تلك ليست مشكلة

407
00:23:11,750 --> 00:23:15,760
إن كنتُ من طبخه، فستحبّه لاحقًا
.حتّى إن كانت لا تحبّه الآن

408
00:23:15,760 --> 00:23:17,040
.حسنًا، حسنًا

409
00:23:17,260 --> 00:23:19,860
.شُجيرات الطّماطم تنمو جيّدًا أيضًا

410
00:23:19,860 --> 00:23:22,220
.أعتقد أنّه سيكون عليّ إبعادها عن بعضها قريبًا

411
00:23:22,220 --> 00:23:24,760
في أيّ موسم يتمّ حصاد الطّماطم؟

412
00:23:24,760 --> 00:23:28,210
.في الصّيف. لا أطيق الانتظار

413
00:23:28,210 --> 00:23:30,100
إلى متى تخطّط البقاء هنا؟

414
00:23:30,100 --> 00:23:36,050
.للأبد. أريد أن تدوم هذه السّعادة... للأبد