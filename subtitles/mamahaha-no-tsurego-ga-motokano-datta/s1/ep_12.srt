1
00:00:01,330 --> 00:00:03,020
!تبدين رائعة

2
00:00:03,520 --> 00:00:05,520
!يا لجمالك يا يومي-تشان

3
00:00:06,000 --> 00:00:08,330
!أنت أشبه بألعاب ناريّة تتفتّح أمام عينيّ

4
00:00:08,330 --> 00:00:10,970
!سوف يفشل عرض هذه السّنة بالكامل

5
00:00:10,970 --> 00:00:13,780
.هذا يكفي يا مادوكا-سان

6
00:00:14,090 --> 00:00:15,390
وما السّبب؟

7
00:00:15,390 --> 00:00:17,280
!لأنّ عيون الجميع هنا ستكون عليك

8
00:00:18,040 --> 00:00:19,790
هل تستخفّين بي؟

9
00:00:20,400 --> 00:00:23,080
.إطلاقًا! أقول هذا من أعماق قلبي

10
00:00:23,080 --> 00:00:25,230
ألا تبدو ظريفة يا تشيكوما؟

11
00:00:25,230 --> 00:00:26,010
...بلى

12
00:00:26,720 --> 00:00:28,540
.ها قد أتى ميزوتو-كُن

13
00:00:36,120 --> 00:00:37,950
ما رأيك يا ميزوتو-كُن؟

14
00:00:37,950 --> 00:00:39,680
أليست جميلة؟

15
00:00:41,660 --> 00:00:42,810
...هـ-هل

16
00:00:43,090 --> 00:00:43,810
ماذا؟

17
00:00:43,810 --> 00:00:46,560
!صورة... هل يمكنني أخذ صورة؟

18
00:00:46,920 --> 00:00:48,060
ماذا؟

19
00:00:48,060 --> 00:00:50,060
!حسنًا! وقت التّصوير

20
00:00:50,060 --> 00:00:50,690
ماذا؟

21
00:00:51,020 --> 00:00:53,150
.احرص على تصويرها من زاوية جيّدة يا ميزوتو-كُن

22
00:00:53,150 --> 00:00:55,200
.كلاّ... لم أكن أقصد صورة لي

23
00:00:57,820 --> 00:00:58,820
ماذا؟

24
00:01:00,330 --> 00:01:03,700
!كـ-كيف تعرف كلمة مروري؟

25
00:02:38,050 --> 00:02:39,960
ما الّذي جعلك تأتي معنا؟

26
00:02:40,520 --> 00:02:43,270
ألا تكره الحشود الكبيرة كهذه؟

27
00:02:43,720 --> 00:02:45,670
.لا يوجد أحد في حياة مادوكا-سان

28
00:02:46,190 --> 00:02:50,190
.إنّها تجعلني آتي معها إلى هنا كلّ سنة

29
00:02:50,820 --> 00:02:54,440
.استسلمت عن محاولة مقاومتها منذ مدّة

30
00:02:55,940 --> 00:02:59,570
.يمكنني طرح نفس السّؤال عليك
ألا تكرهين الحشود الكبيرة أيضًا؟

31
00:03:01,190 --> 00:03:04,200
.ليست لديّ ذكريات جيّدة مع الحشود

32
00:03:04,580 --> 00:03:06,190
!لقد عدنا

33
00:03:06,190 --> 00:03:08,830
.كانت دورات المياه مكتظّة
.أخذ الأمر منّا بعض الوقت

34
00:03:09,260 --> 00:03:11,640
لماذا لا تمسكان بيديْ بعضكما أيضًا؟

35
00:03:11,640 --> 00:03:13,460
.لن تنفصلا عن بعضكما هكذا

36
00:03:13,800 --> 00:03:15,960
.لسنا طفلين

37
00:03:15,960 --> 00:03:18,710
،وحتّى إن انفصلنا عن بعضنا
—فسأعود للمنزل فحسـ

38
00:03:21,720 --> 00:03:23,090
ماذا تفعلين؟

39
00:03:23,420 --> 00:03:26,080
.هذا عاديّ بين الإخوة

40
00:03:26,080 --> 00:03:27,180
ماذا؟

41
00:03:27,180 --> 00:03:30,350
من مسؤوليّاتي كأختك الكبيرة
.أن أبقيك قريبًا منّي

42
00:03:30,670 --> 00:03:32,060
!بالضّبط

43
00:03:32,060 --> 00:03:33,980
!ما كنتُ لأصف الأمر أفضل يا يومي-تشان

44
00:03:33,980 --> 00:03:36,120
أنا أخوك الصّغير؟

45
00:03:36,120 --> 00:03:37,480
أنا هو الأخ الكبير، أنسيت؟

46
00:03:37,800 --> 00:03:41,110
.لا بأس. لا أمانع في كلّ الأحوال

47
00:03:41,520 --> 00:03:45,280
الأمر سيّان، من مسؤوليّتك كأخ كبير
.أن تبقيها قريبة منك

48
00:03:47,280 --> 00:03:48,750
.لا بأس

49
00:03:48,750 --> 00:03:50,600
كلّ ما عليّ فعله هو الإمساك بيدك، صحيح؟

50
00:03:50,600 --> 00:03:53,020
.من النّادر رؤيتك تقوم بما تُؤمر به

51
00:03:53,020 --> 00:03:54,120
.اخرسي

52
00:03:55,120 --> 00:03:59,320
.أشعر براحة أكثر بعد بكائي بشدّة البارحة

53
00:04:00,340 --> 00:04:04,130
كما لو أنّني تخلّصت أخيرًا من كلّ
.الأعباء الّتي كانت تثقلني

54
00:04:06,540 --> 00:04:09,140
أهنالك ما تودّان أكله؟

55
00:04:09,760 --> 00:04:14,650
،أعطتنا جدّتي الكثير من المال
.لذلك اختارا ما يحلو لكما

56
00:04:14,650 --> 00:04:17,530
لكنّ تكون أكشاك الطّعام
.في المهرجانات غالية دائمًا

57
00:04:17,960 --> 00:04:20,820
.أظنّ أنّ علينا الذّهاب لمتجر بقالة فحسب

58
00:04:20,820 --> 00:04:22,730
.لا تتأمّل كثيرًا

59
00:04:22,730 --> 00:04:25,320
.نحن في الأرياف
.لن تجد أيّ متاجر بقالة هنا

60
00:04:27,480 --> 00:04:29,370
!انظروا! ثمّة لعبة رماية

61
00:04:29,710 --> 00:04:30,920
أتريد المحاولة يا تشيكوما؟

62
00:04:30,920 --> 00:04:32,500
.نـ-نعم

63
00:04:33,240 --> 00:04:34,250
!حسنًا

64
00:04:34,590 --> 00:04:36,880
!لنضع الجائزة الكبرى صوب أعيننا أنا وأنت

65
00:04:42,200 --> 00:04:43,630
.ربّما إلى اليمين قليلاً

66
00:04:43,630 --> 00:04:48,260
هـ-هل يقترب الإخوة من بعضهم كثيرًا
إلى ذلك الحدّ في العادة؟

67
00:04:44,660 --> 00:04:46,340
!هذا كثير، كثير

68
00:04:48,260 --> 00:04:51,440
...حسنًا يا تشيكوما، أمسكها بثبات

69
00:04:51,440 --> 00:04:52,390
!أطلق

70
00:04:54,880 --> 00:04:56,780
.هذا مؤسف

71
00:04:56,780 --> 00:04:57,820
...نعم

72
00:04:59,580 --> 00:05:01,610
.لا يجب السّماح للأمر أن ينتهي هنا

73
00:05:01,930 --> 00:05:03,610
!حان دورك يا ميزوتو-كُن

74
00:05:03,920 --> 00:05:05,740
.انتقم لتشيكوما

75
00:05:06,210 --> 00:05:08,120
.حسنًا، سأقوم بطلقة واحدة

76
00:05:10,990 --> 00:05:13,320
.ساعديه يا يومي-تشان

77
00:05:13,320 --> 00:05:14,780
.بصفتك أخته الكبيرة

78
00:05:14,780 --> 00:05:16,320
...ماذا؟ لكن

79
00:05:16,320 --> 00:05:17,280
ماذا؟

80
00:05:17,280 --> 00:05:21,880
.ستمسكين بأخيك الصّغير من الخلف فحسب

81
00:05:21,880 --> 00:05:24,760
ما هو الدّاعي لارتباكك هكذا؟

82
00:05:29,260 --> 00:05:30,160
...مهلاً

83
00:05:30,160 --> 00:05:33,910
!هـ-هيّا! كفّ عن النّظر إليّ وركّز على التّصويب

84
00:05:35,180 --> 00:05:36,920
ألا تصوّب أبعد إلى اليمين قليلاً؟

85
00:05:36,920 --> 00:05:38,640
.لا، لا أقوم بذلك

86
00:05:38,640 --> 00:05:39,950
!بل أنت كذلك

87
00:05:39,950 --> 00:05:42,190
اخرسي فحسب. أهذا أفضل؟

88
00:05:42,190 --> 00:05:44,030
!أنت بعيد لليسار قليلاً

89
00:05:44,030 --> 00:05:47,070
.إلى اليمين بعض الشّيء
...نعم، قليلاً فحسب

90
00:05:47,920 --> 00:05:49,710
...هـ-هذا سيّئ

91
00:05:49,710 --> 00:05:51,580
.لا أعتقد أنّ قدميّ ستتحمّلان أكثر من هذا

92
00:05:51,870 --> 00:05:54,580
...عـ-على هذا المعدّل، صدري سوف

93
00:05:55,190 --> 00:05:56,080
.حسنًا

94
00:06:06,400 --> 00:06:08,000
.لا تليق بك أبدًا

95
00:06:08,000 --> 00:06:11,600
ألا يمكنك أن تحتفظي برأيك لنفسك؟

96
00:06:12,050 --> 00:06:12,820
.تفضّل

97
00:06:17,680 --> 00:06:19,500
.شـ-شكرًا لك

98
00:06:19,500 --> 00:06:21,360
أليس هذا لطفًا منه يا تشيكوما؟

99
00:06:21,820 --> 00:06:24,610
كيف عرفت أنت أرادها؟

100
00:06:24,920 --> 00:06:28,990
.إنّها شخصيّة من لعبة كان يلعبها مؤخّرًا

101
00:06:29,280 --> 00:06:32,410
.فعلاً؟ أنا متفاجئة أنّك لاحظتَ أمرًا كهذا

102
00:06:35,620 --> 00:06:39,080
.لا أصدّق أنّك غريب اجتماعيًّا مع الأطفال أيضًا

103
00:06:39,080 --> 00:06:40,520
ماذا تقصدين بـ"أيضًا"؟

104
00:06:40,520 --> 00:06:43,080
متى كنتُ غريبًا اجتماعيًّا؟

105
00:06:43,080 --> 00:06:47,470
بدأت أشعر أنّ فكرة السّماح لك
.أن تكون الأخر الأكبر لم تكن مناسبة

106
00:06:47,470 --> 00:06:50,380
ذلك أفضل من السّماح لك أنت
.أن تكوني الأخت الكبرى

107
00:06:51,020 --> 00:06:53,390
بالحديث عن هذا، أفعلتِ ذلك عمدًا؟

108
00:06:55,550 --> 00:06:57,600
!مـ-ما كنتُ لأفعل ذلك على الإطلاق

109
00:06:57,980 --> 00:06:59,180
.هكذا إذًا

110
00:06:59,180 --> 00:07:02,230
.أنا سعيد لأنّ أختي ليست منحرفة

111
00:07:02,230 --> 00:07:03,070
!منحـ—؟

112
00:07:03,070 --> 00:07:06,330
ما-ما الّذي أغضبك وأزعجك كثيرًا حيال ذلك؟

113
00:07:06,330 --> 00:07:08,860
ظننتك معتادًا على ذلك بعد قضائك
.للكثير من الوقت مع هيغاشيرا-سان

114
00:07:09,400 --> 00:07:12,990
،إنّها تقوم بأفعال كتلك دون تردّد

115
00:07:12,990 --> 00:07:15,950
.ولكن في حالتك أنت، تكونين متوتّرة

116
00:07:15,950 --> 00:07:17,370
.حاولي أن تسترخي قليلاً

117
00:07:17,370 --> 00:07:18,250
—ما

118
00:07:18,250 --> 00:07:22,760
تـ-تجعل الأمر يبدو وكأنّ هيغاشيرا-سان
!تحسن معاملة الفتيان أكثر منّي

119
00:07:22,760 --> 00:07:24,170
!حسنًا، حسنًا

120
00:07:24,880 --> 00:07:26,870
!حان الوقت للذّهاب

121
00:07:30,520 --> 00:07:33,240
.انظروا هناك! إنّهما عمّي وزوجته

122
00:07:33,240 --> 00:07:35,140
مع من يتحدّثان؟

123
00:07:35,140 --> 00:07:36,730
ما كان اسمها يا ترى؟

124
00:07:36,730 --> 00:07:40,840
.كنّا معروفين جدًّا في البلدة في الماضي

125
00:07:40,840 --> 00:07:43,150
.لذلك يعرف الكثير من كبار السّنّ عائلتنا

126
00:07:43,150 --> 00:07:46,270
!يومي! ميزوتو-كُن

127
00:07:50,030 --> 00:07:52,170
.كيدوين-سان، هذه ابنتي

128
00:07:52,170 --> 00:07:53,910
.أنا إيريدو يومي

129
00:07:53,910 --> 00:07:57,530
.يا إلهي. يا لك من فتاة جميلة

130
00:07:57,840 --> 00:08:01,540
أرى أنّ ميزوتو-كُن لديه شخص آخر
.ليكون فردًا من عائلتك عدى والده الآن

131
00:08:02,160 --> 00:08:05,550
عندما سمعتُ ما حدث
.من ناتسومي، كنتُ قلقة جدًّا

132
00:08:05,550 --> 00:08:08,970
أنا واثقة أنّك مشغولة جدًّا باعتيادك
،على حياتكم الجديدة

133
00:08:08,970 --> 00:08:11,800
.لكن احرصي على الاعتناء بميزوتو-كُن

134
00:08:12,480 --> 00:08:13,300
.طبعًا

135
00:08:14,240 --> 00:08:15,260
...كن هذا غريب

136
00:08:16,040 --> 00:08:21,310
تجعل الأمر يبدو وكأنّه لا يستطيع
.النّجاة بدون وجود من ينتبه له

137
00:08:21,310 --> 00:08:26,720
حجزنا بقعة مثاليّة لمشاهدة
.الألعاب النّاريّة لكم جميعًا

138
00:08:26,720 --> 00:08:28,320
.أستطيع أخذكم إلى هناك إن أردتم

139
00:08:28,320 --> 00:08:30,970
.شكرًا لك كالعادة

140
00:08:30,970 --> 00:08:33,240
سيبدأ عرض الألعاب النّاريّة في الثّامنة، صحيح؟

141
00:08:33,240 --> 00:08:34,280
.نعم

142
00:08:34,280 --> 00:08:36,810
.ما زال أمامنا وقت حتّى العرض

143
00:08:36,810 --> 00:08:38,090
ما الّذي تريدون فعله؟

144
00:08:38,090 --> 00:08:40,200
ماذا؟ أين ذهب ميزوتو-كُن؟

145
00:08:40,540 --> 00:08:41,190
ماذا؟

146
00:08:42,090 --> 00:08:44,830
كلاّ، ذهب للتّجوال وحده ثانية، صحيح؟

147
00:08:45,210 --> 00:08:50,460
يختفي ميزوتو-كُن دائمًا قبل بداية
.عرض الألعاب النّاريّة كلّ سنة

148
00:08:52,340 --> 00:08:54,960
.فهمت... هذا يفسّر كلّ شيء

149
00:08:56,260 --> 00:08:57,720
.فهمت الآن

150
00:08:58,200 --> 00:09:01,880
على الأرجح أنّ ميزوتو كان
.غير مرتاح في ذلك المكان

151
00:09:01,880 --> 00:09:02,810
...لهذا السّبب

152
00:09:03,120 --> 00:09:04,810
.أكيد. شكرًا لك

153
00:09:05,080 --> 00:09:09,070
لا بدّ أنّ والده كان يشكره
.على قدومه معه رغم ذلك

154
00:09:09,070 --> 00:09:13,530
.لكنّ الأمر ليس وكأنّ ميزوتو ليس مهتمًّا بأقاربه

155
00:09:14,460 --> 00:09:16,320
،إن كان غير مبالٍ لهم بالكامل

156
00:09:16,850 --> 00:09:21,200
.ما كان ليفكّر أبدًا في إعطاء تلك اللّعبة لتشيكوما

157
00:09:21,760 --> 00:09:24,830
.أنا آسف، لكن لا أستطيع مواعدتك

158
00:09:25,160 --> 00:09:27,570
.أنا إنسان أنانيّ

159
00:09:27,570 --> 00:09:31,210
.لا أستطيع أن أعتني بأكثر من شخص واحد على حدى

160
00:09:31,550 --> 00:09:33,920
...والمكان الوحيد الّذي أملكه

161
00:09:33,920 --> 00:09:38,220
،يشغله شخص آخر سلفًا
.رغم أنّ ذلك الشّخص لا يستحقّه

162
00:09:40,480 --> 00:09:43,050
.لا بدّ أنّ الرّياح قويّة حيث أنت

163
00:09:43,050 --> 00:09:45,230
.ما... نعم

164
00:09:46,520 --> 00:09:47,530
أياي؟

165
00:09:47,530 --> 00:09:48,550
نعم؟

166
00:09:48,550 --> 00:09:49,480
.لا عليك

167
00:09:51,010 --> 00:09:54,360
.في الحقيقة، ستفند بطّاريّة هاتفي قريبًا

168
00:09:55,520 --> 00:09:59,100
لماذا لم يكن بإمكاننا الكلام بينما هاتفه يُشحن؟

169
00:10:03,350 --> 00:10:04,580
.لم يكن الأمر كذلك

170
00:10:08,340 --> 00:10:10,170
.لم أعرف

171
00:10:10,720 --> 00:10:12,840
...الفتاة الّتي كنتُها قبل سنتين لم تعرف

172
00:10:13,730 --> 00:10:16,490
أنّه يزور أقاربه في مثل ذلك الوقت من السّنة

173
00:10:16,490 --> 00:10:20,840
.وسيتجوّل في المهرجان المحلّيّ هناك

174
00:10:22,040 --> 00:10:23,930
...عندما كنّا زميليْ دراسة فحسب

175
00:10:25,060 --> 00:10:26,430
...عندما كنتُ حبيبته

176
00:10:27,300 --> 00:10:30,440
...وحتّى بعد أن صرت فردًا من عائلته

177
00:10:31,190 --> 00:10:33,070
.رأيتُ العديد من وجوه إيريدو ميزوتو

178
00:10:34,940 --> 00:10:38,320
،إنّها تتناسب معًا كقطع أحجية
،الواحدة تلو الأخرى

179
00:10:40,570 --> 00:10:43,130
.وتشكّل صورة ثلاثيّة الأبعاد له

180
00:10:43,600 --> 00:10:45,500
.صورة لم أعرفها أبدًا

181
00:10:45,500 --> 00:10:49,390
صورة عنه ما كنتُ لأراها أبدًا
.لو بقيت حبيبته فحسب

182
00:10:49,390 --> 00:10:50,170
...ومع ذلك

183
00:10:51,270 --> 00:10:52,830
.سأذهب للبحث عنه

184
00:10:53,640 --> 00:10:55,340
.نعم، اذهبي

185
00:11:05,610 --> 00:11:09,700
".أردتك أن تمنعيني من الذّهاب"

186
00:11:20,780 --> 00:11:24,400
.طوال حياتي، لم أشعر أنّ أيّ شيء حقيقيّ

187
00:11:25,700 --> 00:11:27,780
.كما لو أنّي كنتُ أعيش حياة شخص آخر

188
00:11:28,200 --> 00:11:30,290
.كما لو أنّني أعيش في عالم خياليّ

189
00:11:31,030 --> 00:11:34,540
كلّ شيء عن عجائب الحياة
الّتي يتحدّث عنها الجميع

190
00:11:34,540 --> 00:11:37,550
.بدا لي حلمًا بعيدًا لا يوجد إلىّ في التّلفاز

191
00:11:38,280 --> 00:11:41,550
ولم أكنت أتظاهر أنّني ذرك الرّجل
."من رواية "لم يعد بشرًا

192
00:11:41,550 --> 00:11:44,550
.كنتُ فعلاً عاجزًا عن التّعاطف مع أيّ أحد

193
00:11:44,550 --> 00:11:47,870
.إنّها لمعجزة أنّك وُلدت سالمًا

194
00:11:47,870 --> 00:11:50,560
.لا بدّ أنّه من الصّعب عليك أن تكبر بدون أمّ

195
00:11:50,940 --> 00:11:55,560
لم أفهم أبدًا لماذا أشفق وأثنى عليّ النّاس

196
00:11:56,090 --> 00:12:00,320
،لمجرّد أنّني موجود
.لمجرّد أنّني أتنفّس الهواء الّذي حولي

197
00:12:00,320 --> 00:12:02,570
.لم أفهم. لم أفهم الأمر إطلاقًا

198
00:12:03,380 --> 00:12:07,850
...وبسبب ذلك، بدأت حفرة تكبر بداخلي

199
00:12:08,580 --> 00:12:11,930
.حتّى مرّ كلّ شيء من خلالي دونما أن يترك أيّ صوت

200
00:12:12,330 --> 00:12:15,960
ولكن رغم ذلك، الشّيء الوحيد
الّذي شعرتُ أنّه حقيقيّ

201
00:12:16,440 --> 00:12:18,210
.كان عالم المؤلّفات

202
00:12:18,920 --> 00:12:20,480
لن أنسى أبدًا التّأثير

203
00:12:20,480 --> 00:12:23,960
الّذي تركه فيّ قراءة كتاب جدّي
"الرّاقصة السّيبيريّة"

204
00:12:23,960 --> 00:12:25,720
.لأوّل مرّة

205
00:12:26,450 --> 00:12:30,510
.لمحت روحي العالمَ كما عكسته الصّفحات

206
00:12:30,510 --> 00:12:32,070
.ولمرّة، شعرتُ بالتّواصل معه

207
00:12:33,250 --> 00:12:35,480
"علّمتني قصّة "الفتاة الرّاقصة
.كم أنّ البشر ضعفاء

208
00:12:36,010 --> 00:12:38,480
."وتعلّمت ما الغرور البشريّ من "راشومون

209
00:12:38,840 --> 00:12:41,290
."وما هو الكبرياء من "القبل فوق الجبل

210
00:12:41,740 --> 00:12:44,980
.وعلّمتني "كوكورو" عن التّجربة البشريّة

211
00:12:46,240 --> 00:12:49,990
،في عقلي، كان عالم الخيال هو الواقع

212
00:12:50,440 --> 00:12:53,340
.بينما كان العالم الواقعيّ مجرّد ابتداع

213
00:12:53,340 --> 00:12:54,250
...لهذا

214
00:12:55,090 --> 00:12:59,250
كان لقاء أياي يومي حدثًا ثانويًّا
.في رأيي في البداية

215
00:12:59,770 --> 00:13:01,760
.اقتربت منها كنزوة لا غير

216
00:13:02,360 --> 00:13:05,260
لكن عندما ذهبنا في أوّل موعد
،لنا في المهرجان الصّيفيّ

217
00:13:05,580 --> 00:13:07,510
.تحرّك شيء ما عميقًا في داخلي

218
00:13:08,230 --> 00:13:10,900
كيف يُعقل أن يوجد بشريّ ضعيف هكذا؟

219
00:13:10,900 --> 00:13:13,720
شخص ضعيف لدرجة أنّها قد تنسى كيف تتنفّس

220
00:13:13,720 --> 00:13:15,270
...إن لم يكن قربها أيّ أحد

221
00:13:15,990 --> 00:13:20,620
ظننتُ أنّها ستبكي إلى الأبد
لو تخلّيت عنها هنا

222
00:13:20,620 --> 00:13:22,530
.وحيدة تمامًا

223
00:13:22,920 --> 00:13:25,780
"...يا لك من مسكينة"

224
00:13:26,790 --> 00:13:29,390
تلك الفكرة الّتي نشأت بداخلي

225
00:13:29,390 --> 00:13:32,390
كانت نفس المشاعر الّتي ألقاها
.الآخرون عليّ طوال حياتي

226
00:13:33,340 --> 00:13:34,250
...أياي

227
00:13:34,860 --> 00:13:37,180
.منذ تلك اللّحظة، صار لك مكان في قلبي

228
00:13:37,660 --> 00:13:40,140
.أكثر ثباتًا من أيّ قصّة قرأتها

229
00:13:40,880 --> 00:13:42,400
،بالنّسبة لي

230
00:13:42,400 --> 00:13:45,380
.شعرتُ أنّك حقيقيّة أكثر من أيّ أحد قابلته

231
00:13:47,830 --> 00:13:50,550
.عانى إيريدو ميزوتو طوال الوقت

232
00:13:50,550 --> 00:13:52,680
.قاومت وعارض

233
00:13:52,680 --> 00:13:53,560
...ولكن

234
00:13:54,230 --> 00:13:57,320
.ذات يوم، التقى بخلاصه أياي يومي

235
00:13:57,810 --> 00:14:02,940
بالنّسبة له، كانت المفتاح لعكس عقوبة
.الحياة البائسة الّتي يعيشها

236
00:14:04,140 --> 00:14:06,460
.لكنّه خسر ذلك الفتاح

237
00:14:08,360 --> 00:14:10,920
.ليس عليك أن تشفقي عليه لأنّه يتيم الأمّ

238
00:14:11,760 --> 00:14:15,280
عليك الإشفاق عليه لأنّه فقد الشّيء
.الوحيد الّذي كان له معنى في حياته

239
00:14:15,280 --> 00:14:16,330
...وذلك كان

240
00:14:21,440 --> 00:14:23,710
إنّك تحبّ الأماكن المظلمة والرّثّة بالفعل، صحيح؟

241
00:14:25,140 --> 00:14:27,720
ربّما أنت مجرّد ضعيف يحاول قلب صفحة جديدة؟

242
00:14:28,000 --> 00:14:30,520
هل أتيت إلى هنا للاستهزاء بي فحسب؟

243
00:14:30,520 --> 00:14:33,970
وتخبريني أنّي فاشل لا يستطيع
حتّى التّفاعل مع عائلته؟

244
00:14:33,970 --> 00:14:35,800
.هذا سخيف

245
00:14:35,800 --> 00:14:38,920
.عرفتُ ذلك منذ مدّة بعيدة

246
00:14:38,920 --> 00:14:40,940
.لا فائدة من نبش مواضيع قديمة

247
00:14:42,200 --> 00:14:46,300
أتذكر أوّل موعد غراميّ لنا
في المهرجان الصّيفيّ قبل سنتين؟

248
00:14:46,750 --> 00:14:50,820
.ضعتُ واتّصلت بك وأنا أبكي

249
00:14:51,650 --> 00:14:52,450
ماذا؟

250
00:14:52,830 --> 00:14:55,260
...أتساءل كم يومًا مضى على ذلك

251
00:14:55,260 --> 00:14:58,960
.عندما اتّصلت بي فجأة تلك اللّيلة

252
00:14:59,780 --> 00:15:01,100
.أذكر ذلك

253
00:15:01,100 --> 00:15:04,710
.كان بمقدوري سماع حفيف الأشجار من بعيد

254
00:15:05,200 --> 00:15:06,540
كنتَ هنا، صحيح؟

255
00:15:08,240 --> 00:15:09,740
...اسمع

256
00:15:09,740 --> 00:15:12,340
لا بدّ أنّك كنتَ معجبًا بي بشدّة؟

257
00:15:18,280 --> 00:15:19,660
هل تتذكّر

258
00:15:20,110 --> 00:15:23,370
الوقت الّذي تشاركنا فيه قبلتنا الأولى؟

259
00:15:23,370 --> 00:15:26,230
السّابع والعشرين من أكتوبر، صحيح؟

260
00:15:26,860 --> 00:15:29,990
كان ذلك بعد شهرين بالضّبط
.منذ أن بدأنا نتواعد

261
00:15:30,380 --> 00:15:32,110
.عرفتُ أنّ ستتذكّر

262
00:15:32,110 --> 00:15:33,490
وكيف ذلك؟

263
00:15:33,490 --> 00:15:37,740
استطعتَ معرفة كلمة مرور هاتفي، أليس كذلك؟

264
00:15:38,520 --> 00:15:42,000
.لا يجدر بك استعمال التّواريخ ككلمة مرور

265
00:15:42,000 --> 00:15:44,030
...تقول هذا

266
00:15:44,030 --> 00:15:47,260
لكنّ حقيقة أنّ غريزتك دفعتك لاستعمال 1027

267
00:15:47,260 --> 00:15:50,260
عنت أنّك استعملته ككلمة مرور أيضًا
في وقت ما، صحيح؟

268
00:15:53,250 --> 00:15:55,890
.هذا صحيح... كنّا قد تواعدنا لشهرين بالضّبط

269
00:15:56,410 --> 00:16:00,650
،شعرتُ أنّنا إن لم نقم بذلك
.فسيكون عليّ انتظار شهر كامل لأجرّب ثانية

270
00:16:01,600 --> 00:16:03,140
.كنت متلهّفة قليلاً وقتها

271
00:16:03,440 --> 00:16:08,780
كنتُ واثقًا أنّك ستقعين ضحيّة نصيحة
.مراوغة قرأتها في مجلّة أو على الإنترنيت

272
00:16:09,810 --> 00:16:14,280
،ربّما أكون قد قرأت بعض المقالات
.لكن أن لأسباب تثقيفيّة فحسب

273
00:16:14,280 --> 00:16:16,680
.في كلّ الأحوال، نحن نتحدّث عنك هنا

274
00:16:16,680 --> 00:16:18,840
من المستحيل أن تفعلي شيئًا بتلك الجرأة

275
00:16:18,840 --> 00:16:21,980
.دون أن تقرئي عنه أوّلاً

276
00:16:21,980 --> 00:16:24,890
!آسفة لأنّني أقوم بالأمور كما يجب

277
00:16:24,890 --> 00:16:27,670
!بإمكانك على الأقلّ أن تثني على شجاعة حبيبتك

278
00:16:27,670 --> 00:16:29,340
.كنتِ شجاعة

279
00:16:29,340 --> 00:16:31,800
.لا بدّ أنّك تدرّبتِ كثيرًا على وجه التّقبيل ذاك أيضًا

280
00:16:31,800 --> 00:16:33,550
كيف عرفت؟

281
00:16:33,550 --> 00:16:35,920
.عرفتُ بمجرّد أن رأيته

282
00:16:35,920 --> 00:16:39,310
من المستحيل أن تنجحي بذلك
.من أوّل محاولة

283
00:16:39,310 --> 00:16:40,700
!وغد

284
00:16:40,700 --> 00:16:44,190
.أنا جيّدة في الارتجال من وقت لآخر

285
00:16:44,480 --> 00:16:48,190
ذلك صحيح فقط لأنّني في العادة
.من يقوم بدعمك بعدها

286
00:16:48,190 --> 00:16:50,300
.متعالٍ كما عادتك

287
00:16:50,300 --> 00:16:53,820
ألا تدرك أنّك ستكون محبوبًا أكثر
إن وضعتَ لجامًا للسانك؟

288
00:16:53,820 --> 00:16:57,320
ما السّبب الّذي قد يجعلني أحاول
التّمسّك بصفات ذوقك في الرّجال الآن؟

289
00:16:57,610 --> 00:16:59,150
.معك حقّ

290
00:16:59,150 --> 00:17:01,400
.لن تكون هناك فائدة كبيرة

291
00:17:01,400 --> 00:17:03,580
.سينتهي الأمر بخيبة أمل لكلينا فحسب

292
00:17:03,580 --> 00:17:06,580
.ذلك ما كنتُ سأقوله بالضّبط

293
00:17:11,050 --> 00:17:11,840
...أخبرني

294
00:17:12,550 --> 00:17:13,590
ماذا؟

295
00:17:14,030 --> 00:17:16,260
لماذا قرّرت أن تبدأ بمواعدتي؟

296
00:17:17,160 --> 00:17:19,960
.ربّما ما كنتُ لأمانع لو كنتِ أيّ شخص آخر

297
00:17:20,770 --> 00:17:21,850
!ماذا؟

298
00:17:22,250 --> 00:17:24,760
.كان ذلك من صنع القدر فحسب

299
00:17:24,760 --> 00:17:26,300
مجرّد مصادفة، ألا توافقينني؟

300
00:17:26,760 --> 00:17:30,620
.افترضي أنّني قابلتُ هيغاشيرا قبلك

301
00:17:31,180 --> 00:17:33,860
.ما كنّا لنتواعد أبدًا في تلك الحالة

302
00:17:35,240 --> 00:17:36,790
...لكن في الواقع

303
00:17:37,480 --> 00:17:39,870
.أنت من قابلتُها

304
00:17:40,440 --> 00:17:44,500
،في لعبة كراسي موسيقيّة بسيطة
.الفوز لمن يجلس عليها أوّلاً

305
00:17:44,930 --> 00:17:48,020
،إن كنت تسعين خلف جوابة بسيط
.فذلك هو جوابي

306
00:17:50,230 --> 00:17:51,700
هل أنت راضية؟

307
00:17:52,440 --> 00:17:53,380
.نعم

308
00:17:58,180 --> 00:17:59,740
.حان الوقت

309
00:18:00,900 --> 00:18:02,890
.من أجل الألعاب النّاريّة الّتي لم نرها قبل سنتين

310
00:18:09,650 --> 00:18:12,650
.تسنّى لنا رؤيتها معًا أخيرًا

311
00:18:28,150 --> 00:18:30,710
.لحظة... انظر إليّ

312
00:18:38,880 --> 00:18:42,200
...ليس كأياي يومي، بل كإيريدو يومي

313
00:18:42,640 --> 00:18:47,160
.أقدّم لك قبلة حياتي الأولى الثّانية

314
00:18:47,920 --> 00:18:50,260
...أؤكّد لك أنّني سأهزم

315
00:18:50,850 --> 00:18:54,440
.الفتاة الّتي حصلت على ذلك المكان في قلبك

316
00:18:55,910 --> 00:18:58,950
،لا يهمّ كم قد تحبّ أياي يومي

317
00:19:07,450 --> 00:19:13,430
.فأنا إيريدو يومي، أعهد بأنّني سأفوز بك في النّهاية

318
00:19:21,220 --> 00:19:25,280
أخبريني! ما الّذي حدث البارحة؟

319
00:19:25,280 --> 00:19:28,360
.أعتقد أنّنا خطونا خطوة كبيرة للأمام على الأقلّ

320
00:19:28,730 --> 00:19:30,360
!ممتاز

321
00:19:30,360 --> 00:19:32,940
!اتّصلي بي إن حدث أيّ شيء، موافقة؟

322
00:19:32,940 --> 00:19:34,040
—أنا أدعمك بالكامـ

323
00:19:34,040 --> 00:19:34,760
!هذا مؤلم

324
00:19:34,760 --> 00:19:36,410
!ما-ما كان ذلك يا تشيكوما؟

325
00:19:36,410 --> 00:19:37,820
!أهذا بسبب مرحلة ثورتك؟

326
00:19:40,200 --> 00:19:41,280
تشيكوما-كُن؟

327
00:19:43,450 --> 00:19:46,080
أهذا معقول؟ أهذا ما يحدث؟

328
00:19:47,580 --> 00:19:50,460
حسنًا، كيف أصف الأمر بشكل لائق؟

329
00:19:50,460 --> 00:19:53,050
.أظنّ أنّ عليّ تعزيتك

330
00:19:55,670 --> 00:19:59,210
.كلمات الشّكر لن توفيك حقّك يا يومي-تشان

331
00:19:59,210 --> 00:20:02,330
اعتني بميزوتو من أجلي، موافقة؟

332
00:20:02,330 --> 00:20:04,430
،إنّه شخص كفؤ

333
00:20:04,430 --> 00:20:06,720
.لذلك أنا واثقة أنّه لن يحتاج لمساعدتي

334
00:20:07,040 --> 00:20:09,160
.لكنّ ذلك سيكون من دواعي سروري

335
00:20:09,160 --> 00:20:11,460
.إنّه يشعر بالوحدة أحيانًا على عكس ما يبدو

336
00:20:15,260 --> 00:20:17,400
ما الّذي كنت تتحدّثين عنه مع جدّتي؟

337
00:20:17,710 --> 00:20:19,320
لماذا لا تحزر؟

338
00:20:20,580 --> 00:20:22,320
لماذا تتصرّفين بغرابة؟

339
00:20:22,810 --> 00:20:24,430
.لا داعي للقلق

340
00:20:24,430 --> 00:20:27,580
.نحن أخوين غير شقيقين في النّهاية يا ميزوتو-كُن

341
00:20:29,010 --> 00:20:31,580
.هذا أمر واضح يا يومي-سان

342
00:20:39,460 --> 00:20:41,590
!ما معنى هذا يا ميزوتو-كُن؟

343
00:20:41,590 --> 00:20:43,840
!من هذا الفتى اللّعوب السّطحيّ؟

344
00:20:44,160 --> 00:20:45,840
!ما الّذي يحدث يا إيريدو؟

345
00:20:46,170 --> 00:20:48,100
!من الفتاة ذات الصّدر الضّخم؟

346
00:20:48,950 --> 00:20:50,720
.أيّها المنحرف الغبيّ

347
00:20:51,050 --> 00:20:53,820
!أنا صديقتك الوحيدة، صحيح يا ميزوتو-كُن؟

348
00:20:53,820 --> 00:20:54,730
!صحيح؟

349
00:20:54,730 --> 00:20:58,480
لا أصدّق أنّك قّررت العبث مع هذه
...الفتاة وأنت لديك إيريدو-سان سلفًا

350
00:20:58,920 --> 00:21:00,350
.خاب ظنّي فيك

351
00:21:00,350 --> 00:21:02,990
!ظننتُ أنّك أفضل من هذا

352
00:21:02,990 --> 00:21:06,650
.كاوانامي، هذه هيغاشيرا إيسانا

353
00:21:06,990 --> 00:21:09,990
.إنّها مجرّد صديقة قابلتها أخيرًا وصرنا مقرّبين

354
00:21:10,300 --> 00:21:13,000
صديقة قابلتها مؤخّرًا وصرتما مقرّبين؟

355
00:21:13,340 --> 00:21:16,940
.هيغاشيرا، هذا هو كاوانامي كوغوري

356
00:21:16,940 --> 00:21:21,250
إنّه مجرّد زميل أعلن نفسه صديقًا لي
.ويصرّ على أن يتبعني في كلّ مكان

357
00:21:21,720 --> 00:21:24,010
شخص يصرّ على أن يتبعك في كلّ مكان؟

358
00:21:24,440 --> 00:21:25,510
.فهمت

359
00:21:25,510 --> 00:21:28,010
إنّه مترصّد يلاحقك، صحيح؟

360
00:21:28,460 --> 00:21:29,510
.فهمت

361
00:21:29,510 --> 00:21:31,640
.إنّها محتالة اختارك كفريسة لك

362
00:21:31,640 --> 00:21:33,230
كيف وصلتما لهذه الاستنتاجات؟

363
00:21:33,230 --> 00:21:36,410
هل ظننتِ أنّه سيكون هدفًا سهلاً
فقط لأنّه مهووس؟

364
00:21:36,410 --> 00:21:40,350
.أتأسّف على حالك، لكنّه ليس سطحيًّا لتلك الدّرجة

365
00:21:40,350 --> 00:21:43,400
لماذا لا تتخلّين عن هذه التّمثيليّة
قبل أن يتضرّر كبرياؤك؟

366
00:21:43,400 --> 00:21:46,650
كـ-كيف تتجرّأ على سكب ملح على
جرحي الّذي لم يشفى بعد؟

367
00:21:46,650 --> 00:21:51,410
يا إلهي، إذًا فقد تمّ رفضك سلفًا، صحيح؟

368
00:21:51,760 --> 00:21:53,560
—تستحقيّن هذا لـ

369
00:21:53,560 --> 00:21:56,030
!هذا مؤلم

370
00:21:56,030 --> 00:21:59,200
.لا يوجد أيّ شيء بين هيغاشيرا-سان وإيريدو-كُن

371
00:21:59,200 --> 00:22:01,580
.إنّهما مجرّد صديقين عزيزين

372
00:22:01,580 --> 00:22:06,780
إنّ اشتباهك بوجود شيء ما
.من نسج خيالك المريض فحسب

373
00:22:06,780 --> 00:22:07,800
أتسمعني؟

374
00:22:07,800 --> 00:22:11,260
أفضّل ألاّ أستمع لنصائح من فتاة
!بعقل مريض أكثر منّي

375
00:22:11,260 --> 00:22:12,180
ماذا قلت؟

376
00:22:14,170 --> 00:22:17,660
!أنا وميزوتو-كُن متفاهمان جدًّا فحسب

377
00:22:17,660 --> 00:22:20,360
وبسبب المهووسين بالحبّ من أمثالك

378
00:22:20,360 --> 00:22:22,820
!لا أطيق الأشخاص المنفتحين

379
00:22:23,480 --> 00:22:28,000
إنّك لا تقنعين أيّ أحد بكلامك هذا
.وأنت ملتصقة به هكذا

380
00:22:28,000 --> 00:22:29,570
!ابتعدا عن بعض للحظة

381
00:22:31,950 --> 00:22:36,410
أنا مسرورة لأنّ لديك أصدقاء أخيرًا
،على عكس وضعك في الإعداديّة

382
00:22:36,410 --> 00:22:37,560
.يا أخي الصّغير

383
00:22:37,850 --> 00:22:41,470
وأنا مندهش من خروجك بنتيجة
،بالفعل من محاولة تجديد نفسك

384
00:22:41,470 --> 00:22:42,760
.يا أختي الصّغيرة

385
00:22:46,260 --> 00:22:50,590
بالنّظر إلى الوراء، لا يسعني
.إلاّ وصف ذلك بأنّه طيش الشّباب

386
00:22:50,910 --> 00:22:54,990
لكن ابتداءً من سنتي الثّانية
،إلى الثّالثة من الإعداديّة

387
00:22:54,990 --> 00:22:57,960
.كان لديّ ما يمكن وصفه بالحبيبة

388
00:22:58,730 --> 00:23:03,160
لكن ابتداءً من سنتي الثّانية
،إلى الثّالثة من الإعداديّة

389
00:23:03,160 --> 00:23:06,110
.كان لديّ ما يمكن وصفه بالحبيب

390
00:23:07,070 --> 00:23:09,990
.لا يمكننا الرّجوع للماضي أبدًا

391
00:23:10,560 --> 00:23:13,740
.لا نستطيع إعادة السّعادة الّتي شعرنا بها وقتها

392
00:23:15,270 --> 00:23:16,260
...ومع ذلك

393
00:23:16,740 --> 00:23:21,250
.مشاعري وقتها ما زالت محفورة في روحي

394
00:23:22,610 --> 00:23:25,240
.لا أمانع ذلك الآن

395
00:23:26,030 --> 00:23:28,840
.ما زلنا لم نتجاوز الأمر بالكامل

396
00:23:29,700 --> 00:23:30,760
.لكن لا بأس

397
00:23:31,270 --> 00:23:34,440
...لأنّني... بل لأنّنا

398
00:23:35,000 --> 00:23:38,010
.لدينا فرصة لنسج قصّة جديدة