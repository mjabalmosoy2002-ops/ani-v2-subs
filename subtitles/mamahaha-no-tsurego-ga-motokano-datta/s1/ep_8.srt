1
00:00:09,490 --> 00:00:11,740
.أودّ لو أطّلع على مجموعة كتبك

2
00:00:12,740 --> 00:00:14,200
مجموعة كتبي؟

3
00:00:14,510 --> 00:00:15,450
.تمهّل

4
00:00:15,450 --> 00:00:17,620
.لا داعي للتّشكيك في الأمر

5
00:00:18,290 --> 00:00:20,450
.إنّها مجرّد رغبة غريزيّة

6
00:00:20,840 --> 00:00:23,910
.أودّ وبكلّ بساطة رؤية مجموعتك لا غير

7
00:00:23,910 --> 00:00:30,050
الأرشيف الغامض لدانتاليان
ميكومو غاكوتو

8
00:00:24,270 --> 00:00:25,600
،وإن سمحت لي

9
00:00:25,600 --> 00:00:30,050
أرغب في تمييز ما هي الصّفحات
،ومن أيّ رواية خفيفة الّتي بها تجاعيد

10
00:00:30,050 --> 00:00:35,050
وبذلك أكتشف أيّ البطلات لعبن
.دورًا فعّالاً في يقظتك الجنسيّة

11
00:00:35,370 --> 00:00:36,300
ماذا؟

12
00:00:36,590 --> 00:00:40,400
أقصد تلك الرّوايات الخفيفة
.الّتي يخفيها الجميع من آبائهم

13
00:00:40,400 --> 00:00:44,480
لا بدّ أنّ لديك واحدة تخفيها
في خلفيّة رفوف كتبك، صحيح؟

14
00:00:44,990 --> 00:00:46,160
!هذا مؤلم

15
00:00:46,160 --> 00:00:49,580
هلاّ كنتَ أكثر لطفًا أثناء لمسي؟

16
00:00:49,580 --> 00:00:52,150
.سيكون ذلك شعورًا أفضل لكلينا

17
00:00:52,720 --> 00:00:56,240
.إنّك تتصرّفين بإزعاج أكثير من المعتاد

18
00:00:56,490 --> 00:01:00,200
مهلاً، أرى أنّك قرّرت أن تستشعِرني
بعينيك بدل ذلك، صحيح؟

19
00:01:00,490 --> 00:01:02,110
.سأسمح لك بهذا

20
00:01:02,110 --> 00:01:04,730
.يمكنك تخيّلي عارية أيضًا إن أردت

21
00:01:04,730 --> 00:01:06,480
.أنا جاهز لإنهاء مسألة "الصّداقة" هذه

22
00:01:07,170 --> 00:01:08,590
!كنتُ أمزح فحسب

23
00:01:08,590 --> 00:01:10,520
!سأكفّ عن المزاح البذيئة، مفهوم؟

24
00:01:10,520 --> 00:01:11,960
!أنا آسفة

25
00:01:11,960 --> 00:01:15,720
!أنا آسفة! أنا آسفة! أنا آسفة

26
00:01:15,720 --> 00:01:19,100
أشعر أنّ براءتي ستكون على المحكّ
.إن سمحت لك بزيارتي في منزلي

27
00:01:19,100 --> 00:01:20,780
.لا داعي للخوف

28
00:01:20,780 --> 00:01:22,850
.سأحرّر كلّ توتّري الجنسيّ قبل ذلك

29
00:01:28,040 --> 00:01:29,960
...حسنًا، بلا مزاح الآن

30
00:01:29,960 --> 00:01:33,340
أنت تبدو من النّوع الّذي يتشبّث
،بالرّوايات الخفيفة القديمة

31
00:01:33,340 --> 00:01:35,400
.لذلك كنتُ آمل أن آتي لاستعارة بعضها

32
00:01:35,400 --> 00:01:36,860
.لا أمانع

33
00:01:37,750 --> 00:01:41,400
لكنّ ذلك يعني زيارتك لمنزل
فتى وحدك، أتفهمين؟

34
00:01:41,400 --> 00:01:43,370
ألا يجب أن تكوني حذرة أكثر؟

35
00:01:43,370 --> 00:01:44,300
ماذا؟

36
00:01:44,730 --> 00:01:47,630
،رفضت عرضي في ذلك اليوم
.وأثبتّ أنّك غير مهتمّ بي

37
00:01:47,630 --> 00:01:50,130
فلماذا عليّ أن أكون حذرة؟

38
00:01:50,870 --> 00:01:53,500
...بتلك النّظرة البريئة والنّقيّة

39
00:01:54,450 --> 00:01:57,510
كيف لي أن أرفض طلبها؟

40
00:03:41,700 --> 00:03:42,940
.هيغاشيرا-سان

41
00:03:43,700 --> 00:03:45,080
.آسفتان على التّأخير

42
00:03:45,080 --> 00:03:46,080
انتظرتِ طويلاً؟

43
00:03:46,080 --> 00:03:49,230
.كـ-كلاّ، وصلتُ للتّوّ بدوري

44
00:03:49,230 --> 00:03:50,700
.تمهّلي لحظة

45
00:03:50,990 --> 00:03:53,460
!ممتاز! حسّها في الموضة سيّئ بالفعل

46
00:03:53,460 --> 00:03:56,210
.كنّا على صواب عندما دعوناها للخروج قبل ذلك

47
00:03:56,210 --> 00:03:57,390
ماذا؟

48
00:03:57,390 --> 00:04:00,480
هل تقومان بانتقادي بالفعل؟

49
00:04:00,480 --> 00:04:01,970
.كان ذلك انتقادًا بلا شكّ

50
00:04:01,970 --> 00:04:03,240
!حسنًا

51
00:04:03,240 --> 00:04:06,350
.أقدّم لك جدول اليوم بدون أيّ تأخير

52
00:04:06,810 --> 00:04:10,600
!"أسمّيه... "عمليّة تغيير مظهر هيغاشيرا إيسانا

53
00:04:11,730 --> 00:04:14,590
ستذهبين غدًا إلى منزل إيريدو-كُن، صحيح؟

54
00:04:14,590 --> 00:04:16,110
...نـ-نعم

55
00:04:16,110 --> 00:04:20,320
لذا لمنعك من إحراج نفسك
...بارتداء شيئ رديء كهذا

56
00:04:20,320 --> 00:04:23,110
.فكّرنا أنّك في حاجة لبعض المساعدة

57
00:04:23,450 --> 00:04:26,240
لنذهب للبحث عن ملابس ظريفة معًا، موافقة؟

58
00:04:26,240 --> 00:04:29,120
تريدين أن تبدين ظريفة
في عينيْ إيريدو-كُن، صحيح؟

59
00:04:29,960 --> 00:04:32,280
...حـ-حسنًا، لستما على خطأ

60
00:04:32,280 --> 00:04:35,870
.لكنّني لم أحضر الكثير من المال معي

61
00:04:35,870 --> 00:04:37,420
.لا داعي للقلق

62
00:04:37,420 --> 00:04:40,670
.سندفع أنا وأكاتسكي-سان مقابل كلّ شيء اليوم

63
00:04:40,670 --> 00:04:42,430
!ماذا؟! مـ-مستحيل

64
00:04:42,430 --> 00:04:44,380
.لا يُعقل أن أطلب منكم فعل أمر كهذا

65
00:04:44,380 --> 00:04:46,270
!لا داعي للقلق

66
00:04:46,270 --> 00:04:47,900
...تذكّري فحسب

67
00:04:47,900 --> 00:04:50,600
.أنّ لدينا شرطًا واحدًا

68
00:04:50,910 --> 00:04:53,100
و-وما هو؟

69
00:04:53,470 --> 00:04:55,550
.أن تلبسي كلّ ما نقترحه عليك

70
00:04:55,550 --> 00:04:57,690
!بدون أيّ شكوى عمّا سترتدينه

71
00:04:58,110 --> 00:05:00,110
لوكاس

72
00:04:58,770 --> 00:05:00,110
!ما-ما-ماذا؟

73
00:05:00,110 --> 00:05:02,640
تـ-تريدان منّي ارتداء هذا؟

74
00:05:02,640 --> 00:05:04,540
.نعم! هذا ما اخترتُه

75
00:05:04,540 --> 00:05:05,860
!كفاك من الشّكوى وجرّبيه

76
00:05:05,860 --> 00:05:08,190
...لـ-لكن... أ-أنا

77
00:05:08,190 --> 00:05:10,730
.إنّ مثل هذه الملابس لا تبدو جيّدة عليّ

78
00:05:10,730 --> 00:05:12,860
!بدون أيّ شكوى عمّا سترتدينه

79
00:05:16,560 --> 00:05:17,930
،أكاتسكي-سان

80
00:05:17,930 --> 00:05:21,240
أردتِ أن تُلبسيها ملابس كدمية، صحيح؟

81
00:05:22,180 --> 00:05:23,550
.كشفتِني

82
00:05:23,550 --> 00:05:26,600
...عـ-عفوًا، لقد لبسته

83
00:05:26,600 --> 00:05:27,930
!دعينا نراه

84
00:05:33,910 --> 00:05:37,060
أبدو مثل الفتاة الجذّابة الّتي تظهر
.عادة في كلّ أفلام الرّعب

85
00:05:37,360 --> 00:05:38,810
!جذّابة

86
00:05:38,810 --> 00:05:41,020
!ما مقاس صدرك على أيّ حال؟

87
00:05:41,020 --> 00:05:43,530
...إنّه مقاس جي

88
00:05:43,530 --> 00:05:45,530
!مقاس جي؟

89
00:05:45,530 --> 00:05:48,030
...تحديق

90
00:05:48,030 --> 00:05:49,200
!إمساك

91
00:05:52,980 --> 00:05:55,500
!كفّي عن لمس صدري بلا سابق إنذار

92
00:05:56,960 --> 00:05:59,420
.لم أكن أعرف أنّ الصّدر قد يرتدّ بذلك القدر

93
00:05:59,420 --> 00:06:00,780
...وأنا كذلك

94
00:06:01,500 --> 00:06:05,260
!حسنًا! ما زال هناك المزيد لتجرّبيه يا هيغاشيرا-سان

95
00:06:08,710 --> 00:06:12,760
يبدو هذا مثل الفستان
.الّذي صار رائجًا جدًّا قبل فترة

96
00:06:12,760 --> 00:06:14,520
!جذّابة

97
00:06:18,260 --> 00:06:20,320
،هذا فستان محافظ أكثر من البقيّة

98
00:06:20,320 --> 00:06:22,020
...لكنّه يبدو ضيّقًا قليلاً

99
00:06:22,440 --> 00:06:23,770
!جذّابة

100
00:06:24,500 --> 00:06:26,280
.هذه مشكلة عويصة

101
00:06:26,280 --> 00:06:29,610
.إنّ كلّ ما ترتديه يبدو جذّابًا بشكل خطير

102
00:06:30,560 --> 00:06:33,500
ألا أستطيع ارتداء ما أرتديه عادة؟

103
00:06:33,500 --> 00:06:37,040
إنّ شخصًا متحفّظًا مثلي لا يناسبه
.أن يجلب الأنظار له

104
00:06:43,420 --> 00:06:45,390
...إنّ ذلك الزّيّ

105
00:06:45,390 --> 00:06:47,170
.تجاوز الحدود

106
00:06:47,530 --> 00:06:48,670
،مهما جرّبت

107
00:06:48,670 --> 00:06:53,120
.لن يناسبك أيّ شيء ما لم تقلّل من حجم صدرك

108
00:06:53,120 --> 00:06:55,080
.قد ينفعك شيء واسع  ومريح

109
00:06:55,080 --> 00:06:56,180
واسع ومريح؟

110
00:06:56,180 --> 00:06:58,520
.شيء مثل الّذي ترتدينه يا يومي-تشان

111
00:06:58,520 --> 00:07:01,240
.إنّه يخفّف شكل جسدك

112
00:07:01,240 --> 00:07:05,020
جرّبي ارتداء قميص واسع
.مع تنّورة مريحة وخفيفة

113
00:07:05,020 --> 00:07:08,820
.ربّما قد يستطيع شيء كهذا إخفاء جسدك الجذّاب

114
00:07:08,820 --> 00:07:10,650
.هذا صحيح

115
00:07:10,650 --> 00:07:13,910
لكنّك ستقلّدين أسلوب يومي-تشان
.فحسب إن فعلت هذا

116
00:07:13,910 --> 00:07:16,200
وهل من السّيّئ تقليد أحد آخر؟

117
00:07:16,200 --> 00:07:18,270
!بالطّبع

118
00:07:18,270 --> 00:07:22,990
علينا نحن الفتيات تنسيق ما سنرتديه
.لنحافظ على تناغمنا في نهاية المطاف

119
00:07:22,990 --> 00:07:24,170
.مذهل

120
00:07:24,440 --> 00:07:29,720
،لذلك إن غيّرت يومي-تشان أسلوبها
!فستكون تلك قصّة مختلفة

121
00:07:29,720 --> 00:07:32,030
مـ-ماذا؟ أنا؟

122
00:07:32,030 --> 00:07:36,100
أجل! سيكون شرفًا لي أن أشاهد
.ولادة أسلوب يومي-تشان الجديد

123
00:07:36,100 --> 00:07:37,560
!أليس كذلك؟

124
00:07:37,560 --> 00:07:39,100
!حسنًا، سأذهب لاختيار شيء ما

125
00:07:39,560 --> 00:07:44,860
هل خطّطت أن تجعلني دمية
لتُلبسها ما تشاء من البداية؟

126
00:07:48,840 --> 00:07:53,450
...تجنّبت ارتداء الملابس الخفيفة لفترة طويلة

127
00:07:54,640 --> 00:07:58,520
بالنّظر إلى الوراء، لا يسعني
.إلاّ وصف ذلك بأنّه طيش الشّباب

128
00:07:58,910 --> 00:08:02,250
لكن ابتداءً من سنتي الثّانية
،إلى الثّالثة من الإعداديّة

129
00:08:02,250 --> 00:08:05,170
.كان لديّ ما يمكن وصفه بالحبيب

130
00:08:05,800 --> 00:08:09,390
،نظرًا لكم كنتُ بسيطة بشكل تامّ حينها

131
00:08:09,390 --> 00:08:12,170
،ناهيكم عن عدم أناقتي الّتي لم يكن لها نظير

132
00:08:12,490 --> 00:08:16,150
كانت هنالك مسألة واحدة كان
.عليّ معالجتها بسرعة

133
00:08:16,680 --> 00:08:19,140
.هذا صحيح. إنّه حسّي بالموضة

134
00:08:19,640 --> 00:08:22,510
بعد أن وعدتُ بكلّ حماقة
،أن نلتقي في نهاية الأسبوع

135
00:08:22,510 --> 00:08:24,920
.وجدت نفسي في حيرة من أمري

136
00:08:23,690 --> 00:08:27,690
بحث

137
00:08:23,690 --> 00:08:27,690
أفكار لأفضل ما يمكن ارتداؤه في موعد

138
00:08:25,430 --> 00:08:28,730
قمت بالعديد من البحث المعمّق
.في الموضوع استعدادًا له

139
00:08:27,690 --> 00:08:32,440
.تعتبر سترة بلون غامق فوق تنّورة دانتيل مريحة لباسًا ناضجًا
!أضيفي حقيبة يد خضراء فاتحة لتكتسبي أفضل مظهر في موعد في نهاية الأسبوع
!رابط ذو صلة بالموضوع
!نسّقي الزّيّ مع حقيبة الكتب المثاليّة
. ارتدي فستانًا أبيض مع سروال جينز من أجل موعد مريح!

140
00:08:28,730 --> 00:08:32,440
.تذمّرت على كلّ خيار حتّى آخر لحظة

141
00:08:32,440 --> 00:08:34,090
،وعندما حان يوم الموعد أخيرًا

142
00:08:34,090 --> 00:08:38,200
تمكّنت من العثور على زيّ
.أرضاني وخرجت للقائه

143
00:08:38,640 --> 00:08:42,450
لكن عندما وصلت إلى مكان
...لقائنا، لم يكن لذلك الفتى

144
00:08:42,830 --> 00:08:45,500
.أيّ ردّة فعل أو تعليق

145
00:08:45,500 --> 00:08:46,960
.لم يهتمّ إطلاقًا

146
00:08:47,460 --> 00:08:50,940
لم يكن لديه أيّ تعليق
.على ملابسي أثناء موعدنا أيضًا

147
00:08:51,740 --> 00:08:53,100
...وبهذا استنتجت

148
00:08:53,100 --> 00:08:56,230
لا بدّ أنّ مظهري كان رديئًا للغاية لدرجة
.أنّه تجنّب الحديث في الموضوع لمصلحتي

149
00:08:56,840 --> 00:09:01,280
،ولكن عندما كنّا نوشك على الذّهاب لحال سبيلنا

150
00:09:01,280 --> 00:09:03,730
...قال شيئًا فجأة

151
00:09:03,730 --> 00:09:06,730
.إنّ ملابسك اليوم... تبدو ظريفة

152
00:09:07,270 --> 00:09:11,190
لا بدّ أنّه كان محرَجًا جدًّا ليقدّم لي
.مجاملة في البداية

153
00:09:11,680 --> 00:09:14,740
...ثمّ أضاف وقال

154
00:09:14,740 --> 00:09:20,650
ولكن، سأكون شاكرًا إن لم ترتدي
.تنّورات قصيرة في الخارج

155
00:09:20,650 --> 00:09:23,770
...لكن لن أمانع إن ارتديتِها في أيّ وقد آخر

156
00:09:25,100 --> 00:09:27,370
لن يمانع في أيّ وقت آخر؟

157
00:09:27,370 --> 00:09:30,020
هل يقصد أنّه لا مانع من تواجدنا
معًا في الدّاخل؟

158
00:09:30,440 --> 00:09:32,490
لماذا لا يمكنني ارتداؤها في الخارج؟

159
00:09:32,490 --> 00:09:34,190
هل لأنّنا في العلن؟

160
00:09:34,190 --> 00:09:35,760
لأنّ هنالك أشخاصًا آخرين في الجوار؟

161
00:09:36,230 --> 00:09:40,140
كنتُ سعيدة جدًّا لأنّ شخصًا يبدو مستقلاًّ

162
00:09:40,140 --> 00:09:45,400
.أظهر أخيرًا لمحة من التّملّك تُجاهي

163
00:09:45,960 --> 00:09:49,990
غمرتين الفرحة ولم يسعني سوى
.الابتسام طوال الطّريق للمنزل

164
00:09:49,990 --> 00:09:52,320
،ومنذ تلك اللّحظة

165
00:09:52,320 --> 00:09:55,900
حسّي بالموضة كان مبنيًّا بالكامل
.على تعلّقي بموافقة إيريدو ميزوتو

166
00:09:56,850 --> 00:09:59,680
!ما الّذي كنت أفكّر فيه حينها؟

167
00:09:59,680 --> 00:10:01,850
يومي-تشان؟ هل انتهيتِ؟

168
00:10:08,180 --> 00:10:09,370
كيف أبدو؟

169
00:10:10,770 --> 00:10:12,340
!تبدين أنيقة

170
00:10:12,800 --> 00:10:14,880
.أعتقد أنّ هذا أعجبني

171
00:10:15,300 --> 00:10:17,370
إنّ ساقيك الرّائعتين حصلتا
!على بعض الاهتمام أخيرًا

172
00:10:17,370 --> 00:10:21,400
لا يوجد الكثير من الفتيات اللاّتي
.تناسبهنّ السّراويل البيضاء

173
00:10:22,320 --> 00:10:28,440
ربّما حان الوقت لأتوقّف عن الاعتماد على
.حسّي بالموضة من الإعداديّة على أيّ حال

174
00:10:30,420 --> 00:10:32,810
.سأذهب لأطلب من العاملة نزع بطاقات الأسعار

175
00:10:34,180 --> 00:10:36,540
.تحقّقت أحلامي أخيرًا

176
00:10:36,540 --> 00:10:38,510
!حسنًا! أنت التّالية يا هيغاشيرا-سان

177
00:10:38,510 --> 00:10:40,320
.ماذا؟ حـ-حسنًا

178
00:10:44,920 --> 00:10:48,380
أليس هذا ظريفًا جدًّا بالنّسبة لي؟

179
00:10:48,380 --> 00:10:51,500
.ذلك هو السّبب من ارتدائه من الأساس

180
00:10:55,500 --> 00:10:57,510
!أمهليني لحظة رجاءً

181
00:11:02,760 --> 00:11:07,020
عفوًا... أيمكننا اختيار هذا الزّيّ؟

182
00:11:07,020 --> 00:11:08,980
!كما تشائين

183
00:11:10,390 --> 00:11:12,480
.بدوتِ متردّدة قيل قليل

184
00:11:12,480 --> 00:11:14,060
ما الّذي جعلك تتّخذين قرارك؟

185
00:11:14,060 --> 00:11:15,580
!انظرا

186
00:11:16,820 --> 00:11:19,240
ميزوتو-كُن

187
00:11:16,820 --> 00:11:19,700
يبدو جيّدًا عليك في نظري

188
00:11:16,820 --> 00:11:22,830
قُرأت

189
00:11:17,680 --> 00:11:19,630
!انتقاد جيّد

190
00:11:19,630 --> 00:11:22,820
يبدو أنّ عمليّة تغيير مظهر
!هيغاشيرا إيسانا قد نجحت

191
00:11:21,010 --> 00:11:22,830
ما رأيك؟

192
00:11:22,820 --> 00:11:24,420
صحيح يا يومي-تشان؟

193
00:11:24,420 --> 00:11:26,640
.نـ... نعم

194
00:11:26,640 --> 00:11:28,960
هل تتطلّعين للغد يا هيغاشيرا-سان؟

195
00:11:28,960 --> 00:11:31,180
.نعم، كثيرًا

196
00:11:40,840 --> 00:11:44,470
بالنّظر إلى الوراء، لا يسعني
.إلاّ وصف ذلك بأنّه طيش الشّباب

197
00:11:44,470 --> 00:11:47,550
لكن ابتداءً من سنتي الثّانية
،إلى الثّالثة من الإعداديّة

198
00:11:47,550 --> 00:11:50,540
.كان لديّ ما يمكن وصفه بالحبيبة

199
00:11:51,940 --> 00:11:56,780
كان الرّابط الأساسيّ الّذي يجمع بيننا
،نحن الحبيبين غير المتوقّعين

200
00:11:57,560 --> 00:11:59,480
.هو الكتب بكلّ بساطة

201
00:12:00,530 --> 00:12:02,490
!هذا هو الكتاب الّذي كنت أبحث عنه

202
00:12:02,810 --> 00:12:05,400
.لكنّ ثـ-ثمنه مرتفع جدًّا

203
00:12:05,400 --> 00:12:08,300
.أملك السّلسلة بأكملها بالمناسبة

204
00:12:08,300 --> 00:12:09,740
ماذا؟ فعلاً؟

205
00:12:09,740 --> 00:12:10,590
.نعم

206
00:12:10,590 --> 00:12:12,250
.أستطيع إعارتها لك إن أردت

207
00:12:12,250 --> 00:12:13,960
أتريدين المرور لأخذها لاحقًا؟

208
00:12:13,960 --> 00:12:17,710
ماذا؟! تـ-تقصد إلى منزلك؟

209
00:12:18,290 --> 00:12:21,840
...أنا... عفوًا... أقصد

210
00:12:23,840 --> 00:12:27,520
...نعم... حسنًا

211
00:12:27,520 --> 00:12:29,850
.سـ-سأحضرها لك غدًا في المدرسة

212
00:12:30,880 --> 00:12:32,840
.حسنًا. شكرًا لك

213
00:12:32,840 --> 00:12:35,850
تراجعنا بسهولة. وما السّبب؟

214
00:12:36,600 --> 00:12:38,330
.لأنّنا كنّا نتواعد

215
00:12:38,330 --> 00:12:43,360
والتّواجد وحدنا في غرفة معًا يكون له
.معان ضمنية مختلفة عندما نكون ثنائيًّا

216
00:12:46,870 --> 00:12:48,870
السّبت 15 أغسطس

217
00:12:46,870 --> 00:12:48,870
هيغاشيرا إيسانا
!لقد وصلت

218
00:12:53,160 --> 00:12:54,760
.إنّها في الطّابق الثّاني

219
00:12:55,350 --> 00:12:57,870
...شـ-شكرًا على استقبالي

220
00:12:57,870 --> 00:12:59,530
.إنّها مجرّد صديقة لا غير

221
00:13:04,560 --> 00:13:05,880
...مذهل

222
00:13:06,320 --> 00:13:08,970
هذه هي مجموعة كتبك إذًا؟

223
00:13:08,970 --> 00:13:10,950
هل تمانع إن تفحّصتها بدقّة؟

224
00:13:11,340 --> 00:13:13,140
.أعيدي كلّ شيء إلى مكانه فحسب عندما تنتهين

225
00:13:14,140 --> 00:13:16,140
حسنًا، لماذا أنت هنا؟

226
00:13:16,140 --> 00:13:17,530
.أنا أراقب

227
00:13:18,150 --> 00:13:21,380
لن أسمح لك بلمس ولو شعرة من
هيغاشيرا-سان المسكينة، مفهوم؟

228
00:13:22,430 --> 00:13:26,110
أتعتقدين أنّ باستطاعتي فعل شيء
كهذا بوجود عائلتي كلّها في المنزل؟

229
00:13:26,110 --> 00:13:27,160
!مذهل

230
00:13:27,160 --> 00:13:29,160
!...هـ-هذه

231
00:13:29,160 --> 00:13:31,740
كآبة سوزوميا هاروهي
تانيغاوا ناغارو

232
00:13:29,160 --> 00:13:32,320
!إنّها تلك الرّواية الخفيفة الّتي لطالما أردت قراءتها

233
00:13:32,320 --> 00:13:35,000
ميزوتو-كُن، أتمانع لو استعرتها؟

234
00:13:35,000 --> 00:13:37,210
.طبعًا لا، خذيها

235
00:13:37,210 --> 00:13:39,960
سأقرأها على فراشك إذًا، موافق؟

236
00:13:40,250 --> 00:13:41,710
...هكذا، وهكذا

237
00:13:42,710 --> 00:13:44,300
!مـ-مهلاً

238
00:13:44,300 --> 00:13:46,680
!ما الّذي تفعلينه يا هيغاشيرا-سان؟

239
00:13:47,070 --> 00:13:49,550
.هذا سريره كما تعلمين

240
00:13:49,870 --> 00:13:51,740
.أعلم ذلك

241
00:13:51,740 --> 00:13:54,180
.لهذا السّبب طلبت الإذن

242
00:13:54,180 --> 00:13:57,440
ألا ترين أنّ عليك... التّصرّف بحذر؟

243
00:13:57,870 --> 00:13:59,190
بحذر؟

244
00:13:59,190 --> 00:14:02,940
.سبق ورفضني، لذلك لا بأس

245
00:13:59,190 --> 00:14:02,940
البَشَرُوس: زهرة البراءة

246
00:14:02,940 --> 00:14:04,520
صحيح يا ميزوتو-كُن؟

247
00:14:05,000 --> 00:14:05,940
.أكيد

248
00:14:07,040 --> 00:14:08,910
.لا أستطيع فهم هذا على الإطلاق

249
00:14:09,310 --> 00:14:11,310
.ولا تحاولي

250
00:14:11,310 --> 00:14:15,020
أنا ملتزم بمعاملتها بنفس الطّريقة
.الّتي أعامل بها أصدقائي الذّكور

251
00:14:15,440 --> 00:14:17,960
.حاولي أن تسترخي واقرئي كتابًا أو ما شابه

252
00:14:17,960 --> 00:14:19,080
.ربّما سأفعل

253
00:14:38,610 --> 00:14:40,650
!أنهيت المجلّد الأوّل

254
00:14:40,650 --> 00:14:42,440
انتهيتِ من قراءته سلفًا؟

255
00:14:43,540 --> 00:14:45,340
.كتفاي متصلّبتان بالكامل

256
00:14:45,340 --> 00:14:47,260
أيمكنك تدليكهما لي يا ميزوتو-كُن؟

257
00:14:47,260 --> 00:14:48,060
ولماذا؟

258
00:14:48,060 --> 00:14:51,040
تعاني الفتيات ذوات الصّدر الكبير
.من الأكتاف المتصلّبة غالبًا

259
00:14:51,040 --> 00:14:52,200
ألم تكن تعرف ذلك؟

260
00:14:52,200 --> 00:14:54,450
.لم يكن ذلك سؤالي

261
00:14:54,730 --> 00:14:57,850
.إنّهما مرهقان جدًّا. بالكاد أستطيع تحريكهما

262
00:14:57,850 --> 00:15:02,000
أعتقد أنّ لا خيار لديّ سوى جعل
.سريرك مكان راحتي الأخير

263
00:15:02,380 --> 00:15:05,560
،دحرجة، دحرجة، دحرجة، دحرجة
...دحرجة، دحرجة، دحرجة

264
00:15:05,560 --> 00:15:07,210
.حسنًا، أستسلم

265
00:15:07,580 --> 00:15:11,220
سأدلّك كتفيك، لذلك كفّي عن فرك
رائحتك على سريري، مفهوم؟

266
00:15:14,820 --> 00:15:17,600
.كن لطيفًا... لو سمحت

267
00:15:20,710 --> 00:15:22,220
...هذه هي

268
00:15:22,650 --> 00:15:24,510
...واصل هكذا

269
00:15:23,000 --> 00:15:24,900
تمهّلي، ما الّذي ترمين إليه؟

270
00:15:25,430 --> 00:15:27,400
أنا أقوم بتطبيق تلك الحركة من الرّواية الخفيفة

271
00:15:27,400 --> 00:15:30,880
حيث تبدو فيها الشّخصيّات
،وكأنّها تقوم بشيء بذيء

272
00:15:30,880 --> 00:15:32,170
.بينما لا شيء من ذلك يحدث فعلاً

273
00:15:32,170 --> 00:15:34,870
.لا يحدث ذلك في الحياة الحقيقيّة

274
00:15:34,870 --> 00:15:36,120
!هذا مؤلم، مؤلم

275
00:15:36,120 --> 00:15:40,240
تـ-تمهّل! هذا كثير! أنت تضغط بقوّة
!كبيرة يا ميزوتو-كُن

276
00:15:40,240 --> 00:15:41,210
!هذا مؤلم، مؤلم

277
00:15:41,210 --> 00:15:43,120
ما مدى تقرّبكما من بعضكما؟

278
00:15:43,570 --> 00:15:45,360
أنتما تتلاعبان بي، صحيح؟

279
00:15:45,360 --> 00:15:47,130
كلّ هذا مجرّد تمثيل من البداية، صحيح؟

280
00:15:47,130 --> 00:15:50,660
.ماذا؟ لطالما كنّا هكذا

281
00:15:51,290 --> 00:15:53,200
ألن نتصرّف هذا من البداية؟

282
00:15:53,590 --> 00:15:55,290
!فهمت

283
00:15:55,290 --> 00:15:58,200
،لم يكن لأيّ أحد منكما أيّ أصدقاء من قبل

284
00:15:58,200 --> 00:16:01,000
!لذلك لا تملكان أيّ حسّ بالحدود الشّخصيّة

285
00:16:01,000 --> 00:16:02,600
.حُلّ هذا اللّغز

286
00:16:02,600 --> 00:16:04,160
.هذا فظّ

287
00:16:04,160 --> 00:16:06,920
.كان لديّ على الأقل صديق أو اثنين

288
00:16:06,920 --> 00:16:09,660
.إنّها محقّة. واحد أو اثنين على الأقلّ

289
00:16:12,260 --> 00:16:15,370
حسنًا، لكن لكلّ شخص حدود شخصيّة
.مختلفة على ما أظنّ

290
00:16:15,370 --> 00:16:18,550
.بالضّبط. تبدو الصّداقة مختلفة لدى الجميع

291
00:16:19,080 --> 00:16:21,240
...فـ-في تلك الحالة

292
00:16:21,240 --> 00:16:23,330
.كفّا عن لمس بعضكما على السّرير

293
00:16:23,330 --> 00:16:24,760
.يا إلهي

294
00:16:24,760 --> 00:16:28,960
لا بدّ أنّه من الصّعب التّعامل مع أخت
.صغيرة متملّكة مثلها يا ميزوتو-كُن

295
00:16:28,960 --> 00:16:30,540
.نعم، إنّه أمر مزعج

296
00:16:30,540 --> 00:16:32,700
!لستُ متملّكة، ولستُ أخته الصّغيرة

297
00:16:32,700 --> 00:16:34,340
...على أيّ حال

298
00:16:34,820 --> 00:16:37,930
هل يمكنك أن تُلبسني جواربي يا ميزوتو-كُن؟

299
00:16:37,930 --> 00:16:38,890
.حسنًا، حسنًا

300
00:16:38,890 --> 00:16:39,930
!مهلاً

301
00:16:39,930 --> 00:16:42,100
لماذا لا يمكنك أن تلبسي جواربك بنفسك؟

302
00:16:42,100 --> 00:16:44,490
...حسنًا، ما في الأمر

303
00:16:44,490 --> 00:16:47,310
إنّ الانحناء للأسفل معاناة كبيرة
.بصدر كهذا كما تعلمين

304
00:16:47,750 --> 00:16:49,610
لماذا لكلّ شيء علاقة بصدرك؟

305
00:16:50,110 --> 00:16:51,440
،في حقيقة الأمر

306
00:16:51,440 --> 00:16:55,770
.اعتدت أن يعتني بي ميزوتو-كُن فحسب

307
00:16:56,240 --> 00:16:58,360
.حسنًا، ها قد ألبستك إيّاها

308
00:16:58,360 --> 00:17:00,240
.شكرًا جزيلاً لك

309
00:17:00,240 --> 00:17:02,940
عفوًا، أين الحمّام؟

310
00:17:02,940 --> 00:17:04,710
!سـ-سآخذك إليه

311
00:17:07,650 --> 00:17:11,710
هل ما زلت تكنّين مشاعر تجاهه يا هيغاشيرا-سان؟

312
00:17:11,710 --> 00:17:13,090
.بالطّبع

313
00:17:14,300 --> 00:17:21,930
احتماليّة مواعدته ليست ما جعلني
.أحبّه من الأساس

314
00:17:21,930 --> 00:17:25,500
لا أعتقد أنّني سأكفّ عن حبّه
.أبدًا على ما أظنّ

315
00:17:25,500 --> 00:17:27,560
.كصديق أو كفتى

316
00:17:27,930 --> 00:17:30,570
أليس هذا... صعبًا عليك؟

317
00:17:30,570 --> 00:17:32,190
...لا أدري

318
00:17:32,190 --> 00:17:35,980
أعتقد أنّني سأجد صعوبة في التّكيّف
.مع الأمر إن حصل على حبيبة

319
00:17:35,980 --> 00:17:41,950
لكن بالتّفكير في الأمر، واثقة أنّني سأكون
.غيورة أكثر إن حصل على صديق جديد

320
00:17:41,950 --> 00:17:42,540
ماذا؟

321
00:17:42,540 --> 00:17:46,540
أنا من يستمتع ميزوتو-كُن
.بالحديث معها أكثر من غيري

322
00:17:47,840 --> 00:17:51,520
الأمر أشبه بغريزة تملّكيّة تبدأ
.بالتّصاعد في داخلي

323
00:17:51,520 --> 00:17:53,740
أما كنتِ لتشعري بنفس الشّيء؟

324
00:17:53,740 --> 00:18:00,460
كيف كنتِ لتشعري إن ظهرت أخت
مفقودة من فترة في حياته فجأة؟

325
00:18:00,460 --> 00:18:01,820
...إنّ ذلك

326
00:18:02,370 --> 00:18:03,560
.أنا خائفة

327
00:18:04,120 --> 00:18:07,030
.ميزوتو-كُن هو صديقي الوحيد

328
00:18:07,520 --> 00:18:11,630
إن حصل على أصدقاء أكثر يأخذون
...مكاني فجأة، فسوف

329
00:18:13,430 --> 00:18:17,200
.إنّها لا تريده لها وحدها بالكامل

330
00:18:17,200 --> 00:18:21,990
إنّها لا تستطيع فقط تحمّل فكرة
.خسارة مكانها المميّز في قلبه

331
00:18:23,260 --> 00:18:24,990
.أخبريني يا هيغاشيرا-سان

332
00:18:24,990 --> 00:18:27,500
ألستُ صديقتك أيضًا؟

333
00:18:29,460 --> 00:18:31,420
فـ-فعلاً؟

334
00:18:31,420 --> 00:18:32,490
.بالطّبع

335
00:18:32,490 --> 00:18:35,060
...و-ولكن

336
00:18:36,560 --> 00:18:39,840
ما كنتِ لقومي بنفس الدّور الّذي
.يقوم به ميزوتو-كُن في حياتي

337
00:18:39,840 --> 00:18:41,720
.أعلم ذلك

338
00:18:42,610 --> 00:18:46,020
.ربّما بقدرك أنت، ما لم يكن أكثر

339
00:18:46,720 --> 00:18:50,690
حسنًا... أين هو الحمّام؟

340
00:18:52,690 --> 00:18:55,390
هل كنتما تقومان بهذه الأمور طوال الوقت؟

341
00:18:55,390 --> 00:18:57,820
تدليك كتفيها وإلباسها لجواربها؟

342
00:18:58,400 --> 00:19:01,320
.حسنًا، هذا لأنّها هي فحسب

343
00:19:13,110 --> 00:19:13,990
.اسمع

344
00:19:16,640 --> 00:19:17,960
.ألبسني إيّاها

345
00:19:19,940 --> 00:19:21,820
أستجعلين من الأمر منافسة بالفعل؟

346
00:19:21,820 --> 00:19:22,880
!اخرس

347
00:19:22,880 --> 00:19:26,470
.يبدو من الممتع معاملتك كخادم فحسب

348
00:19:26,800 --> 00:19:28,730
.البسني إيّاها

349
00:19:51,200 --> 00:19:53,450
.ذ-ذلك لا شيء

350
00:19:56,840 --> 00:20:00,340
السّبت 15 أغسطس

351
00:19:56,840 --> 00:20:00,340
هيغاشيرا إيسانا
~~~أحتاج للمساعدة

352
00:20:08,510 --> 00:20:11,080
.شكرًا على مساعدتي

353
00:20:11,080 --> 00:20:13,480
.لم يكفّا عن طرح الأسئلة عليّ

354
00:20:13,480 --> 00:20:16,610
لا فكرة لديّ كيف أتصرّف
.مع كبار لم ألتقي بهم من قبل

355
00:20:17,000 --> 00:20:18,350
.صحيح، تذكّرت

356
00:20:18,350 --> 00:20:22,460
.كان والداك يعتقدان أنّني حبيبتك السّابقة

357
00:20:22,460 --> 00:20:23,610
لماذا في رأيك؟

358
00:20:23,960 --> 00:20:24,680
ماذا؟

359
00:20:24,680 --> 00:20:25,900
ما الغاية من ذلك؟

360
00:20:25,900 --> 00:20:28,380
،حسنًا، سألانني إن كنّا نتواعد

361
00:20:28,380 --> 00:20:31,640
لذلك أخبرتهما أنّك رفضتني منذ
.مدّة وأنّنا مجرّد صديقين الآن

362
00:20:31,640 --> 00:20:33,870
.وبذلك صرت حبيبتك السّابقة فجأة

363
00:20:35,090 --> 00:20:38,150
اسمعي، سيسيئان الفهم
.إن صغتِ الأمر بهذه الّطريقة

364
00:20:39,360 --> 00:20:43,400
.حسنًا، لم أستطع قولها فحسب

365
00:20:43,400 --> 00:20:45,640
لم أستطع تحمّل شرح

366
00:20:45,640 --> 00:20:50,310
،أنّك رفضتني عندما اعترفت لك
.وأنّنا لم نتواعد من الأساس

367
00:20:51,540 --> 00:20:57,050
ميزوتو-كُن... ما زلت لم أتعافى
.بالكامل ممّا حدث

368
00:20:57,050 --> 00:20:58,310
.هكذا إذًا

369
00:20:59,360 --> 00:21:02,940
.لذلك لا تنس أن تواسيني وقتما تستطيع

370
00:21:06,500 --> 00:21:07,880
.معك حقّ

371
00:21:09,000 --> 00:21:14,560
البقاء في المنزل وقراءة الكتب طوال اليوم
طريقة لطيفة لقضاء نهاية الأسبوع، صحيح؟

372
00:21:14,560 --> 00:21:15,400
.نعم

373
00:21:17,100 --> 00:21:23,170
واثق أنّ الوقت الّتي قضيته بصمت
أقرأ الكتب مع أياي يومي

374
00:21:23,170 --> 00:21:27,180
.كان ممتعًا بقدر هذا اليوم

375
00:21:28,930 --> 00:21:30,500
...يا ميزوتو-كُن

376
00:21:31,180 --> 00:21:33,300
.أنت صديق جيّد

377
00:21:34,180 --> 00:21:37,190
...لذلك لو لم نتواعد

378
00:21:39,470 --> 00:21:41,300
.حسنًا، سأستأذن للمغادرة

379
00:21:44,480 --> 00:21:47,200
...لو أنّنا لم نكن معًا

380
00:21:48,040 --> 00:21:51,050
...لو بقينا مقرّبين بشكل معتدل كصديقين

381
00:21:52,520 --> 00:21:56,710
أتساءل إن كنّا سنزال نقضي الوقت
.معًا كما فعلنا في السّابق

382
00:21:57,810 --> 00:22:00,030
.لكن لا فائدة من وضع فرضيّات الآن

383
00:22:00,030 --> 00:22:01,210
...لا هي ولا أنا

384
00:22:02,240 --> 00:22:05,170
.نستطيع أن نكون مثل هيغاشيرا إيسانا