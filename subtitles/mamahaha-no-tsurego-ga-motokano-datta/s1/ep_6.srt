1
00:00:01,670 --> 00:00:02,780
!يومي-تشان

2
00:00:03,140 --> 00:00:04,770
!لنذهب للمنزل

3
00:00:05,100 --> 00:00:06,480
.آسفة

4
00:00:06,480 --> 00:00:09,530
.كنتُ أخطّط للمرور بقاعة الدّراسة اليوم

5
00:00:09,530 --> 00:00:12,030
فعلاً؟

6
00:00:12,030 --> 00:00:14,090
.لا تعبسي يا أكّي

7
00:00:14,090 --> 00:00:16,490
.ستجعلينها تشعر بالسّوء

8
00:00:16,490 --> 00:00:19,400
.امتحانات نصف الدّورة غدًا قبل كلّ شيء

9
00:00:19,400 --> 00:00:22,410
.ربّما علينا نحن من علينا الشّعور بالسّوء

10
00:00:22,410 --> 00:00:24,870
...ما-ما كنتُ لأقول ذلك

11
00:00:25,150 --> 00:00:27,660
حصلتِ على العلامة الأولى
في امتحانات الدّخول، صحيح؟

12
00:00:27,660 --> 00:00:31,420
أعتقد أنّ عليك القيام بكلّ ما بوسعك
...للدّفاع عن لقبك

13
00:00:31,420 --> 00:00:33,260
أليس كذلك يا إيريدو-سان؟

14
00:00:33,260 --> 00:00:35,260
...نـ-نعم

15
00:02:08,480 --> 00:02:11,730
ماي

16
00:02:08,480 --> 00:02:13,570
امتحانات نصف الدّورة

17
00:02:09,050 --> 00:02:10,620
تلميذة متفوّقة سابقًا

18
00:02:11,080 --> 00:02:13,130
،وتلميذة موهوبة بعلامات عالية

19
00:02:13,570 --> 00:02:16,380
.هذا هو مكاني

20
00:02:18,460 --> 00:02:21,960
كنّا قد خضنا امتحانات نصف الدّورة
.الأولى في سنتي الثّانية من الإعداديّة للتّوّ

21
00:02:22,860 --> 00:02:24,440
،ولأوّل مرّة على الإطلاق

22
00:02:24,440 --> 00:02:27,790
،ثمّة من تفوّق عليّ في امتحان الرّياضيّات
...رغم أنّها كانت من نقاط قوّتي

23
00:02:28,660 --> 00:02:31,690
.وكان ذلك على يد زميلي في الفصل إيريدو ميزوتو

24
00:02:33,040 --> 00:02:34,390
.حطّمني ذلك

25
00:02:35,160 --> 00:02:37,790
،لذلك عندما حان موعد الامتحانات النّهائيّة

26
00:02:37,790 --> 00:02:42,120
.ضحّيت بأوقات نومي للدّراسة أكثر من قبل

27
00:02:42,660 --> 00:02:45,180
.كلّ ذلك لهزيمة إيريدو ميزوتو

28
00:02:46,490 --> 00:02:50,500
ولحسن الحظّ، تمكّنت من استعادة
.مكاني على قمّة الفصل

29
00:02:51,290 --> 00:02:52,800
،ولكن، عندما نظرت إليه

30
00:02:52,800 --> 00:02:56,440
لم يُبدِ أيّ اهتمام للاستماع
.للمعلّم الّذي أثنى عليّ

31
00:02:57,090 --> 00:03:00,540
.جلس هناك فحسب يحدّق بشرود عبر النّافذة

32
00:03:01,810 --> 00:03:03,210
.شعرت بالفراغ

33
00:03:03,970 --> 00:03:06,680
.وكأنّني كنت الوحيدة الّتي اهتمّت لذلك

34
00:03:08,450 --> 00:03:09,580
...ومع ذلك

35
00:03:10,080 --> 00:03:12,210
أتحبّين روايات الغموض؟

36
00:03:12,700 --> 00:03:14,470
...نـ-نعم

37
00:03:15,470 --> 00:03:19,220
فهمت. لا عجب أنّ علاماتك
.عالية في الرّياضيّات

38
00:03:20,230 --> 00:03:22,300
.لم أكن الوحيدة الّتي اهتمّت في النّهاية

39
00:03:23,080 --> 00:03:26,010
،كان يتظاهر أنّه ينظر بعيدًا فحسب

40
00:03:26,010 --> 00:03:28,410
.بينما كان يراقبني طوال الوقت في الحقيقة

41
00:03:30,130 --> 00:03:35,400
،وبذلك، لأوّل مرّة في حياتي
.وقعت في الحبّ

42
00:03:51,330 --> 00:03:54,580
هل أنت واثق أنّك درست بما يكفي؟

43
00:03:54,840 --> 00:03:57,590
.نعم، أعتقد أنّني مستعدّ

44
00:03:58,640 --> 00:03:59,590
.ليكن

45
00:04:00,170 --> 00:04:04,180
.تتصرّف وكأنّنا لن نخوض نفس الامتحان

46
00:04:05,090 --> 00:04:07,100
.لا تلم إلاّ نفسك عندما أهزمك

47
00:04:07,100 --> 00:04:07,430
حملتنا الأولى أو نهضة العالم الجديد
سازاني كي
نيكونابي أوو

48
00:04:08,130 --> 00:04:12,700
.أتساءل كم من الرّائع أن تكوني الأولى في فصلك

49
00:04:12,700 --> 00:04:16,110
.للأسف، أخشى أنّ ذلك المكان يحمل اسمي

50
00:04:17,320 --> 00:04:20,610
في تلك الحالة، من الأفضل أن أضع
.اسمي عليه مسبقًا في المرّة القادمة

51
00:04:21,280 --> 00:04:22,460
.فهمت

52
00:04:22,460 --> 00:04:25,410
أنت تنوي الوقوف في وجهي ثانية، صحيح؟

53
00:04:26,100 --> 00:04:27,450
.أرني أفضل ما لديك

54
00:04:28,090 --> 00:04:29,740
.فرصك ضعيفة أمامي على كلّ حال

55
00:04:40,770 --> 00:04:42,980
.تبدين متعبة جدًّا

56
00:04:43,690 --> 00:04:45,640
.ذلك ليس من شأنك

57
00:04:46,110 --> 00:04:49,820
هل الحصول على العلامة الأولى
بتلك الأهمّيّة لك؟

58
00:04:49,820 --> 00:04:50,890
.بالطّبع

59
00:04:51,350 --> 00:04:53,050
أن أكون المرشّحة لأعلى العلامات

60
00:04:53,660 --> 00:04:55,450
والتّلميذة الأولى في سنتي

61
00:04:55,930 --> 00:04:58,120
.هما السّببان الوحيدان في أنّ حياتي كما هي الآن

62
00:04:59,080 --> 00:05:00,380
.ما كنتَ لتفهم

63
00:05:00,860 --> 00:05:02,330
.أنت مشغول جدًّا بالتّظاهر

64
00:05:02,750 --> 00:05:05,750
تعيش حياة وكأنّك لا تهتمّ حيال
.أيّ شيء أو أيّ شخص حوله

65
00:05:06,170 --> 00:05:08,280
.فتى يتظاهر أنّه وحيد

66
00:05:17,040 --> 00:05:19,170
.العمل بجدّ. التّفكير النّقديّ
.السّعي للتّميّز. أخذ المبادرة

67
00:05:17,040 --> 00:05:19,170
امتحانات نصف الدّورة

68
00:05:18,230 --> 00:05:19,170
.ابدؤوا

69
00:05:29,920 --> 00:05:31,370
...حسنًا

70
00:05:30,550 --> 00:05:34,060
امتحانات نصف الدّورة

71
00:05:31,370 --> 00:05:33,630
.انتهينا من اليوم الأوّل

72
00:05:34,330 --> 00:05:37,340
.حسب تصحيحي الخاصّ، لم أقوم بعمل سيّئ

73
00:05:37,920 --> 00:05:39,080
...ومع ذلك

74
00:05:39,080 --> 00:05:41,570
.اليابانيّة من الموادّ الّتي يتفوّق فيها

75
00:05:42,690 --> 00:05:47,350
،إن حصل على علامة كاملة
.فإنّ نسبة 6% تعتبر نسبة كبيرة

76
00:05:48,340 --> 00:05:51,110
.هذا إذا افترضنا أنّه حصل على علامة كاملة

77
00:05:51,760 --> 00:05:55,020
...والآن، لا طريقة لديّ للتّأكّد من ذلك

78
00:06:17,740 --> 00:06:20,730
لماذا تركتَ الجزء الأخير فارغًا؟

79
00:06:23,690 --> 00:06:27,900
من المستحيل أنّك لم تعرف الإجابة
على تلك الأسئلة، صحيح؟

80
00:06:28,740 --> 00:06:30,200
.لم يكن لديّ وقت كافٍ

81
00:06:32,610 --> 00:06:36,760
رأيتك تتوقّف عن الكتابة قبل عشر
!دقائق من نهاية الوقت

82
00:06:37,790 --> 00:06:39,520
!أتظنّني غبيّة؟

83
00:06:39,520 --> 00:06:42,090
إنّك تتهاون لكي أحصل
أنا على المركز الأوّل، صحيح؟

84
00:06:42,090 --> 00:06:45,900
أتعتقد أنّ ذلك سيسعدني؟
!لا تكن سخيفًا

85
00:06:45,900 --> 00:06:47,820
ما كانت الغاية من ذلك الكلام سابقًا؟

86
00:06:47,820 --> 00:06:50,760
!هل تشير إلى أنّني سأخسر أمامك إن لم تتهاون؟

87
00:06:51,080 --> 00:06:52,300
!هل تظنّني غبيّة؟

88
00:06:52,300 --> 00:06:54,510
مـ-مهلاً... ما الخطب يا يومي؟

89
00:06:54,780 --> 00:06:57,950
هل اعتقدتَ فعلاً أنّك ستكون
!بطلاً بالسّماح لي بالفوز؟

90
00:06:57,950 --> 00:07:00,000
!إنّك تستخفّ بذكائي لا غير

91
00:07:00,000 --> 00:07:01,580
!وكأنّني لا أستطيع الفوز من تلقاء نفسي

92
00:07:01,580 --> 00:07:04,460
!لا أريد فوزًا سُلّم لي هكذا

93
00:07:04,460 --> 00:07:05,790
!توقّفي

94
00:07:05,790 --> 00:07:08,150
اهدئي يا يومي! ماذا يحدث؟

95
00:07:08,870 --> 00:07:09,900
ومن يهتمّ؟

96
00:07:10,380 --> 00:07:11,280
ماذا؟

97
00:07:11,600 --> 00:07:14,120
الحصول على المركز الأوّل مهمّ عندك، صحيح؟

98
00:07:14,120 --> 00:07:16,220
.قلتِ ذلك بنفسك

99
00:07:16,220 --> 00:07:17,790
.لذلك لم أجب على بعض الأسئلة

100
00:07:17,790 --> 00:07:19,410
ما الخطب في ذلك؟

101
00:07:19,770 --> 00:07:22,120
...لا. أنت أيضًا يا ميزوتو-كُن

102
00:07:22,410 --> 00:07:23,750
!ميني-كُن

103
00:07:24,060 --> 00:07:27,070
.لا أهتمّ إن حصلت على المركز الأوّل أم لا

104
00:07:27,070 --> 00:07:31,260
كما سبق وقلتِ، لا أهتمّ إطلاقًا
.لما يظنّه الآخرون بي

105
00:07:31,260 --> 00:07:33,640
!لذلك سلّمتك ذلك الفوز! ما الخطأ في هذا؟

106
00:07:37,510 --> 00:07:39,080
.لا خطأ في ذلك

107
00:07:39,610 --> 00:07:41,380
.لكنّه ليس صوابًا أيضًا

108
00:07:42,820 --> 00:07:46,500
.هذا ليس... من شيمك إطلاقًا

109
00:07:50,900 --> 00:07:53,910
امتحانات نصف الدّورة

110
00:07:54,580 --> 00:07:56,030
.انسي الأمر

111
00:07:56,030 --> 00:07:59,370
.يبدو أنّني الوحيد الغبيّة بما يكفي لتهتمّ

112
00:07:59,370 --> 00:08:00,860
.لا فائدة من التّفكير في الأمر

113
00:08:00,860 --> 00:08:03,790
لماذا أشتكي عندما يقلّ من عليّ
التّنافس معهم واحدًا على أيّ حال؟

114
00:08:04,270 --> 00:08:07,070
إن كنتُ أريد الحفاظ على حياتي
،الجديدة كإيريدو يومي

115
00:08:07,070 --> 00:08:08,870
.فالمركز الأوّل هو شغلي الشّاغل الوحيد

116
00:08:11,360 --> 00:08:15,430
لا يحقّ لك أن تقرّري ما يعتبر
.من شيمي وما هو ليس كذلك

117
00:08:15,740 --> 00:08:21,110
علاوة على ذلك، لا يحقّ لأحد
.تقرير ذلك نيابةً عنك أيضًا

118
00:08:21,720 --> 00:08:23,340
...قولي وداعًا يا أختي الصّغيرة

119
00:08:24,060 --> 00:08:26,190
.لحياتك الغالية كتلميذة نجيبة

120
00:08:30,980 --> 00:08:33,840
"أعتقد أنّك قصدت "أختي الكبيرة
.يا أخي الصّغير

121
00:08:34,200 --> 00:08:37,200
.العمل بجدّ. التّفكير النّقديّ
.السّعي للتّميّز. أخذ المبادرة

122
00:08:34,200 --> 00:08:37,200
امتحانات نصف الدّورة

123
00:08:40,200 --> 00:08:42,700
امتحانات نصف الدّورة

124
00:08:45,710 --> 00:08:48,210
امتحانات نصف الدّورة

125
00:08:51,090 --> 00:08:55,090
نتائج امتحانات
نصف الدّورة

126
00:09:03,480 --> 00:09:05,120
.سأكون بخير

127
00:09:05,120 --> 00:09:07,780
.أنا واثقة أنّني أحرزت أكثر من 90 في كلّ مادّة

128
00:09:08,450 --> 00:09:11,480
.من المستحيل ألاّ أكون في المركز الأوّل

129
00:09:11,480 --> 00:09:14,490
تانيهارا
كوابارا
ياماشيرو
تونياما

130
00:09:16,110 --> 00:09:17,610
أسوهاين
تانيهارا

131
00:09:16,610 --> 00:09:20,530
إيريدو

132
00:09:22,410 --> 00:09:25,290
ميزوتو                                                             إيريدو

133
00:09:22,410 --> 00:09:25,290
يومي                                                             إيريدو

134
00:09:25,290 --> 00:09:28,480
مطفئة حريق

135
00:09:26,280 --> 00:09:28,830
.مرحبًا يا صاحبة المركز الثّاني

136
00:09:28,830 --> 00:09:30,730
.أفترض أنّك بخير

137
00:09:31,300 --> 00:09:35,510
تلك الأسئلة الّتي لم تجب عنها امتحان
.اليابانيّة كانت تساوي علامات كثيرة

138
00:09:35,960 --> 00:09:40,580
.وجب عليك أن تدرس كثيرًا لتتجاوز تلك العقبة

139
00:09:41,250 --> 00:09:43,810
...إنّ بذل كلّ هذا الجهد ليس من

140
00:09:43,810 --> 00:09:45,930
ليس من شيمي؟

141
00:09:47,160 --> 00:09:48,440
ألم أخبرك؟

142
00:09:48,440 --> 00:09:51,880
أردت معرفة كيف هو الأمر
.إن كنتُ التّلميذ الأوّل

143
00:09:52,400 --> 00:09:54,560
.لكنّني أحسدك

144
00:09:54,560 --> 00:09:57,700
الحصول على المركز الثّاني يبدو
.عبئًا أخفّ بكثير

145
00:09:58,110 --> 00:10:04,200
إن كنتِ تريدين التّفوّق عليّ، فافعلي ذلك
.في الامتحانات النّهائيّة أيّتها التّلميذة النّجيبة

146
00:10:04,740 --> 00:10:06,310
التّلميذة النّجيبة"؟"

147
00:10:07,330 --> 00:10:10,330
ميزوتو                                             إيريدو
يومي                                             إيريدو
ران                                                    أسوهاين

148
00:10:11,560 --> 00:10:13,340
...هذا صحيح

149
00:10:18,360 --> 00:10:22,540
.ما عدت الأولى في فصلي

150
00:10:22,540 --> 00:10:23,830
!يومي-تشان

151
00:10:25,200 --> 00:10:27,980
من المذهل أنّ الأخوين إيريدو
!حازا على المركزين الأوّل والثّاني

152
00:10:27,980 --> 00:10:30,040
!كنتِ وشيكة يا إيريدو-سان

153
00:10:30,040 --> 00:10:32,400
.أعتقد أنّ الجميع يلقون ندّهم في مرحلة ما

154
00:10:32,400 --> 00:10:36,080
أراهن أنّ هذين الاثنين سيكونان قريبين
.من بعض في الامتحانات النّهائيّة أيضًا

155
00:10:33,910 --> 00:10:38,170
.لم تكن هذه هي ردّة الفعل الّتي توقّعتها إطلاقًا

156
00:10:36,080 --> 00:10:39,690
.لا شكّ في ذلك. إنّهما أشبه بمنافسين الآن

157
00:10:38,170 --> 00:10:40,540
...عدم الحصول على المركز الأوّل

158
00:10:39,690 --> 00:10:41,790
...مستحيل، أعتقد

159
00:10:40,960 --> 00:10:42,410
...الفشل

160
00:10:43,110 --> 00:10:44,410
لماذا كنت خائفة جدًّا من الأساس؟

161
00:10:44,920 --> 00:10:46,370
ما الخطب يا يومي-تشان؟

162
00:10:47,360 --> 00:10:48,710
.فهمت

163
00:10:49,150 --> 00:10:50,890
.لم يتغيّر أيّ شيء

164
00:10:51,360 --> 00:10:55,720
طريقة تعاملهنّ معي
.ونظرتهنّ إليّ... ما زالت كما هي

165
00:10:56,510 --> 00:11:01,050
طوال هذا الوقت، ظننتُ أنّ كوني
.الأولى في فصلنا هو ما يحدّد هويّتي

166
00:11:01,050 --> 00:11:02,100
.الأمر ليس كذلك إطلاقًا

167
00:11:03,720 --> 00:11:05,350
ما الخطب يا يومي-تشان؟

168
00:11:05,720 --> 00:11:07,370
!لا بأس، لا بأس

169
00:11:07,370 --> 00:11:09,260
.ما زال المركز الثّاني مذهلاً أيضًا

170
00:11:09,260 --> 00:11:12,400
.معها حقّ! ابتهجي يا إيريدو-تشان

171
00:11:12,400 --> 00:11:14,730
...لا، الأمر ليس هكذا

172
00:11:15,310 --> 00:11:16,800
.إنّها دموع فرح

173
00:11:16,800 --> 00:11:18,570
.شكرًا لكنّ يا رفيقات

174
00:11:21,250 --> 00:11:24,490
من قد يكون إلى جانبي سواك؟

175
00:11:24,490 --> 00:11:26,830
.أنا خرقاء وغير فصيحة

176
00:11:26,830 --> 00:11:30,200
انطوائيّة متنكّرة يائسة لخداع العالم
.ليظنّوا غير ذلك

177
00:11:30,830 --> 00:11:35,640
!المغفّل الوحيد الغبيّ بما يكفي لفهم ذلك هو أنت

178
00:11:36,590 --> 00:11:39,970
...عندما تقوم بأمور كهذه

179
00:11:39,970 --> 00:11:44,470
كيف تتوقّع منّي أن أعيش بدونك؟

180
00:11:45,970 --> 00:11:47,470
الأربعاء 1 يونيو

181
00:11:48,710 --> 00:11:51,730
...إنّه يكون هنا في العادة

182
00:11:53,720 --> 00:11:54,860
!ها هو

183
00:11:57,590 --> 00:11:58,510
ماذا؟

184
00:11:58,510 --> 00:12:01,360
تحبّين هذه السّلسلة أيضًا؟

185
00:12:02,990 --> 00:12:04,780
:كونوسوبا
!نعمة الإله على هذا العالم الرّائع

186
00:12:08,850 --> 00:12:09,700
ماذا؟

187
00:12:13,000 --> 00:12:15,000
الأربعاء 1 يونيو

188
00:12:20,010 --> 00:12:20,510
هاغاناي: ليس لديّ الكثير من الأصدقاء

189
00:12:21,980 --> 00:12:23,500
...أخبريني يا هيغاشيرا

190
00:12:24,230 --> 00:12:25,260
نـ-نعم؟

191
00:12:25,720 --> 00:12:27,760
ما هو تعريفك لصديق؟

192
00:12:27,760 --> 00:12:29,260
:هاغاناي
ليس لديّ الكثير من
الأصدقاء

193
00:12:29,610 --> 00:12:30,560
.حسنًا

194
00:12:30,560 --> 00:12:34,900
هذا واحد من المواضيع
.الّتي أتميّز فيها أنا هيغاشيرا إيسانا

195
00:12:35,290 --> 00:12:38,960
لم أرَ شخصًا متشوّقًا جدًّا هكذا
.لتعريف كلمة من قبل

196
00:12:38,960 --> 00:12:40,900
.هذه أوّل مرّة بالفعل

197
00:12:42,160 --> 00:12:44,610
.لكن فكّر في الأمر فحسب

198
00:12:44,980 --> 00:12:47,710
يتوقّف الأمر بالكامل
.على أين ترسم خطّ الصّداقة

199
00:12:47,710 --> 00:12:52,220
خذ بعين الاعتبار زميل الدّراسة الّذي حرص
.أن أسلّم واجباتي المدرسيّة هذا الصّباح

200
00:12:52,220 --> 00:12:55,120
.يمكنني أن أصفه بالصّديق أيضًا إن أردت

201
00:12:55,470 --> 00:12:58,420
واضح أنّك تخفّضين معاييرك
.ليخدم ذلك مصلحتك

202
00:12:58,420 --> 00:13:01,880
.في المقابل، لنعتبر أنّ هنالك من يتعرّض للتّنمّر

203
00:13:01,880 --> 00:13:07,100
،"قد تقول، "لسنا مقرّبين كثيرًا
.وتشيح نظرك بعد ذلك

204
00:13:07,100 --> 00:13:09,430
!أظنّ أنّ إلهامًا راودني للتّوّ

205
00:13:09,820 --> 00:13:12,810
لا أعتقد أنّ شخصًا مثلك
.سيحصل على الأصدقاء قريبًا

206
00:13:12,810 --> 00:13:16,850
.لكنّني أعتبرك صديقًا يا إيريدو-كُن

207
00:13:16,850 --> 00:13:21,940
.إن تعرّضتَ للتّنمّر، أعدك أنّني سأتعرّض للتّنمّر معك

208
00:13:21,940 --> 00:13:25,400
!لن تساعديني؟ لا يعتمد عليك إطلاقًا

209
00:13:25,660 --> 00:13:27,420
.ما كنتُ لأتمادى لذلك الحدّ

210
00:13:27,420 --> 00:13:28,910
.لم تكن تلك مجاملة

211
00:13:31,910 --> 00:13:34,010
.أعتقد أنّ وقت الذّهاب قد حان

212
00:13:34,010 --> 00:13:34,910
.صحيح

213
00:13:35,210 --> 00:13:36,810
...حسنًا يا ميزوتو-كُن

214
00:13:37,760 --> 00:13:39,920
هلاّ ألبستني جوربيّ؟

215
00:13:39,920 --> 00:13:41,290
هذا ثانية؟

216
00:13:41,290 --> 00:13:43,000
.لا تكن سخيفًا

217
00:13:43,420 --> 00:13:45,800
.هذه صديقتي هيغاشيرا إيسانا

218
00:13:46,420 --> 00:13:47,300
،ولكن

219
00:13:47,710 --> 00:13:52,910
إنّها أوّل شخص توافقت معه
.بهذا القدر طوال حياتي

220
00:13:52,910 --> 00:13:58,300
أكان أكون واثقًا أنّني لن أقابل
.شخصًا مثلها أبدًا ثانية

221
00:14:01,310 --> 00:14:02,400
!مرحبًا

222
00:14:03,210 --> 00:14:05,240
ذاهب للمنزل أيضًا يا إيريدو-كُن؟

223
00:14:05,530 --> 00:14:07,070
.نعم، أظنّ ذلك

224
00:14:07,070 --> 00:14:09,490
!إ-إنّها شخص منفتح حقيقيّ يا ميزوتو-كُن

225
00:14:09,490 --> 00:14:11,870
!هل نادته "ميزوتو-كُن" للتّوّ؟

226
00:14:12,200 --> 00:14:14,080
من تلك الفتاة برفقتك؟

227
00:14:14,510 --> 00:14:15,830
.هيغاشيرا إيسانا

228
00:14:16,350 --> 00:14:18,580
.التقينا مؤخّرًا وصرنا مقرّبين

229
00:14:20,040 --> 00:14:21,720
!أنا مينامي أكاتسكي

230
00:14:21,720 --> 00:14:23,840
.أنا في نفس الفصل مع ميزوتو-كُن

231
00:14:23,840 --> 00:14:24,840
!سررت بلقائك

232
00:14:27,840 --> 00:14:31,850
إنّها خجولة نوعًا ما، لذلك حاولي
.ألاّ تتقرّبي كثيرًا منها

233
00:14:31,850 --> 00:14:35,360
.من النّادر رؤيتك تتصرّف بحمائيّة تجاه أحد

234
00:14:35,360 --> 00:14:37,430
هل سبق وعرّفتها بيومي-تشان؟

235
00:14:37,430 --> 00:14:39,260
.لا، ليس بعد

236
00:14:39,260 --> 00:14:40,760
ماذا؟

237
00:14:45,220 --> 00:14:47,530
!تمهّلي يا يومي-تشان

238
00:14:48,930 --> 00:14:51,720
من "يومي-سان" تلك؟

239
00:14:52,160 --> 00:14:53,960
.إنّها أختي الصّغيرة

240
00:14:53,960 --> 00:14:55,040
أختك؟

241
00:14:55,360 --> 00:14:56,540
.غير شقيقة

242
00:14:56,890 --> 00:14:57,910
أخت غير شقيقة؟

243
00:14:58,640 --> 00:15:01,580
لماذا ردّة فعلك لغير شقيقة أكبر؟

244
00:15:05,800 --> 00:15:08,010
لماذا أشعر بعدم الارتياح هكذا؟

245
00:15:08,490 --> 00:15:10,500
هل أشعر بالغيرة؟

246
00:15:11,080 --> 00:15:13,430
.لم أعد حبيبته حتّى

247
00:15:13,900 --> 00:15:15,110
...ومع ذلك

248
00:15:17,090 --> 00:15:19,450
!لا يشعر الإخوة بالغيرة

249
00:15:27,490 --> 00:15:28,190
.تفضّل

250
00:15:28,700 --> 00:15:30,700
أتريد صلصة الصّويا؟

251
00:15:30,700 --> 00:15:32,460
...نـ-نعم

252
00:15:37,200 --> 00:15:39,250
...تلك ممحاتي

253
00:15:40,180 --> 00:15:41,210
.آسف

254
00:15:41,210 --> 00:15:44,580
.لا بأس. أنا المخطئة لأني أسقطتها

255
00:15:46,840 --> 00:15:48,840
شعار المدرسة

256
00:15:46,840 --> 00:15:48,840
.العمل بجدّ. التّفكير النّقديّ
.السّعي للتّميّز. أخذ المبادرة

257
00:15:49,990 --> 00:15:51,340
.تبًّا

258
00:15:51,900 --> 00:15:53,010
.تفضّل

259
00:15:53,010 --> 00:15:53,940
ماذا؟

260
00:15:54,780 --> 00:15:59,020
.نسيتَ غداءك في المنزل، لذلك أحضرته معي

261
00:16:04,520 --> 00:16:06,770
.تتصرّف أختي بشكل غريب

262
00:16:07,320 --> 00:16:09,900
غريب؟ ماذا تعني؟

263
00:16:10,200 --> 00:16:12,200
.تبدو بعيدة

264
00:16:12,200 --> 00:16:13,390
...كلاّ

265
00:16:13,390 --> 00:16:15,910
.بل ما دعتُ أشعر بالانزعاج عند التّكلّم معها

266
00:16:16,250 --> 00:16:17,910
أليس هذا أمرًا جيّدًا؟

267
00:16:18,310 --> 00:16:20,120
.إنّه جيّد، وليس جيّدًا أيضًا

268
00:16:21,520 --> 00:16:24,870
لماذا لا تذهب وتسألها مباشرة بنفسك؟

269
00:16:26,900 --> 00:16:28,130
...هذه فكرة

270
00:16:28,130 --> 00:16:31,090
.إنّك غبيّ بالفعل يا ميزوتو-كُن

271
00:16:31,640 --> 00:16:34,000
.إن أردت رأيي، ثق بحدسك

272
00:16:34,000 --> 00:16:36,090
.واثقة أنّك ستفعل الصّواب

273
00:16:37,010 --> 00:16:39,260
أثق بحدسي؟

274
00:16:39,260 --> 00:16:40,540
!عـ-عفوًا، انس ذلك

275
00:16:40,540 --> 00:16:44,230
أنا آخر شخص يمكن الحصول على
...النّصيحة منه على الأرجح

276
00:16:44,230 --> 00:16:46,040
.لا، واصلي رجاءً

277
00:16:46,040 --> 00:16:49,730
سأستمع لك وسأقرّر بنفسي
.إن كنت سأفعل ذلك

278
00:16:54,560 --> 00:16:59,240
إنّ كلّ وأيّ شخص له معاييره الخاصّة، صحيح؟

279
00:16:59,240 --> 00:17:00,650
معايير؟

280
00:17:02,570 --> 00:17:08,240
.نموذج مثاليّ للحياة الّتي يريدونها

281
00:17:08,240 --> 00:17:14,220
،إن كانت طريقة حياتي في خطر
فسأكون... شديدة الغضب، أتفهم؟

282
00:17:14,220 --> 00:17:18,010
لهذا السّبب يخبرني النّاس
...أنّني لا أجيد قراءة الآخرين

283
00:17:19,240 --> 00:17:21,140
!صحيح! كنتُ أقرأها

284
00:17:21,860 --> 00:17:24,890
لا بدّ أنّني كنتُ ألاحظ خطبًا
.ما دون أن أدرك ذلك

285
00:17:25,180 --> 00:17:26,120
ماذا؟

286
00:17:26,120 --> 00:17:27,450
.شكرًا يا هيغاشيرا

287
00:17:27,850 --> 00:17:30,020
.ساعدني الحديث معك

288
00:17:30,020 --> 00:17:31,730
...أ-أكيد

289
00:17:32,010 --> 00:17:34,990
،كما أنّ قراءة الآخرين مهارة جيّدة

290
00:17:34,990 --> 00:17:37,270
.لكن ليس عليك القلق بشأني

291
00:17:37,790 --> 00:17:40,630
.على الأرجح أنّني سأقرؤك أسرع على أيّ حال

292
00:17:41,760 --> 00:17:44,910
.شـ-شكرًا لك

293
00:17:48,760 --> 00:17:50,440
.يا له من شعور

294
00:17:50,440 --> 00:17:54,520
من كان يظنّ أنّ نسيانه سيجعل
الحياة أسهل بكثير؟

295
00:18:03,890 --> 00:18:04,650
ماذا؟

296
00:18:05,390 --> 00:18:06,220
...ما

297
00:18:06,810 --> 00:18:09,050
!ماذا؟

298
00:18:12,200 --> 00:18:14,070
ما-ما الّذي تريده؟

299
00:18:16,350 --> 00:18:18,780
ماذا؟ ما هذا؟ ما هذا؟

300
00:18:24,200 --> 00:18:26,260
—ما-ما الّذي

301
00:18:28,480 --> 00:18:31,790
.معدّل نبضات قلب الإنسان هو نبضة في الثّانية

302
00:18:32,090 --> 00:18:35,920
،لكنّ قلبك من جهة أخرى
.ينبض أكثر من المعتاد بكثير

303
00:18:37,300 --> 00:18:39,850
هل مجرّد النّظر إلى أخيك غير الشّقيق

304
00:18:39,850 --> 00:18:42,880
وهو يرتدي ملابس مختلفة عن المعتاد

305
00:18:42,880 --> 00:18:46,560
يجعل نبضاتك تتسارع لهذا الحدّ
يا أختي الصّغيرة؟

306
00:18:46,560 --> 00:18:50,020
!هـ-هذا ليس عدلاً

307
00:18:52,680 --> 00:18:54,820
حسنًا، لماذا أنت هنا؟

308
00:18:55,180 --> 00:18:57,820
.لا أحبّ الطّريقة الّتي تتصرّفين بها

309
00:18:57,820 --> 00:18:58,890
ماذا؟

310
00:18:59,660 --> 00:19:03,320
.سلوكك الهادئ والصّادق والمتفهّم بشكل غير معقول

311
00:19:03,320 --> 00:19:06,500
تتصرّفين وكأنّك قدّيسة مقارنة
.بالشّخص الّذي أتحدّث إليه الآن

312
00:19:07,160 --> 00:19:08,960
.بالكاد لك ملاحظات ساخرة ودنيئة

313
00:19:09,320 --> 00:19:11,830
.كما لو أنّ الدّخول في قتالات ليس من مستواك

314
00:19:12,240 --> 00:19:14,380
.يثير هذا غضبي بكلّ المقاييس

315
00:19:15,350 --> 00:19:18,900
.إن كان هنالك ما يزعجك، فأخبريني

316
00:19:19,930 --> 00:19:21,130
نحن إخوة، صحيح؟

317
00:19:26,800 --> 00:19:30,020
...اسمع يا أوني-تشان

318
00:19:30,020 --> 00:19:31,980
ما الأمر يا أختي الصّغيرة؟

319
00:19:31,980 --> 00:19:37,110
.أعتقد أنّني أشعر بالغير من تلك الفتاة

320
00:19:37,670 --> 00:19:39,470
تلك الفتاة؟

321
00:19:39,470 --> 00:19:41,490
تقصدين هيغاشيرا إيسانا؟

322
00:19:43,240 --> 00:19:47,080
.أناديك دائمًا باسمك العائليّ

323
00:19:47,530 --> 00:19:50,020
.لكنّها تناديك "ميزوتو" سلفًا

324
00:19:50,820 --> 00:19:54,360
.كلّما فكّرت في الأمر، صار غير منطقيّ أكثر لي

325
00:19:55,000 --> 00:19:59,860
.لكنّنا إخوة، لذلك لا سبب يدفعني للشّعور بالغيرة

326
00:20:00,590 --> 00:20:01,590
...ومع ذلك

327
00:20:03,680 --> 00:20:05,010
.فهمت

328
00:20:07,840 --> 00:20:10,140
أخبرني، أيمكنني أن أسألك عن شيء؟

329
00:20:10,480 --> 00:20:11,640
ما هو؟

330
00:20:11,960 --> 00:20:17,750
ما الجانب الّذي ليس ساخرًا ودنيئًا لم يعجبك فيّ؟

331
00:20:21,250 --> 00:20:22,400
...لا أدري

332
00:20:22,810 --> 00:20:27,130
لم يعجبني تصرّفك وكأنّ ما مررنا به
.لم يحدث أبدًا على ما أظنّ

333
00:20:29,080 --> 00:20:31,980
...العلاقة الّتي أردت نسيانها بشدّة

334
00:20:32,500 --> 00:20:36,570
كانت العلاقة الوحيدة
.الّتي سأندم فعلاً على هجرها

335
00:20:37,960 --> 00:20:45,130
كنت دائمًا قادرًا على التّعبير عمّا
.لا يمكنني وصفه بالكلمات

336
00:20:45,960 --> 00:20:51,640
أخبرني يا أوني-تشان... هل تعتقد
أنّه لا بأس بالشّعور بالغير بين الإخوة؟

337
00:20:51,980 --> 00:20:52,840
.لا

338
00:20:52,840 --> 00:20:56,020
الشّعور بالغير من أصدقاء أخيك
.أمر مقرف بالكامل

339
00:20:56,020 --> 00:20:57,230
!على مهلك

340
00:20:57,230 --> 00:20:59,180
.لكن لا تقلقي

341
00:20:59,180 --> 00:21:02,990
.علمتُ أنّك شخص مقرف لأزيد من سنتين

342
00:21:04,440 --> 00:21:06,450
.أنت المقرف يا أوني-تشان

343
00:21:06,750 --> 00:21:10,410
.انظري، تبدين مثل أخت صغيرة حقيقيّة الآن

344
00:21:15,670 --> 00:21:19,080
.شكرًا لقضاء الوقت هنا دائمًا مع ميزوتو

345
00:21:19,580 --> 00:21:21,740
.أنا أخته الكبيرة إيريدو يومي

346
00:21:22,360 --> 00:21:23,670
.سررت بلقائك

347
00:21:23,670 --> 00:21:25,530
أقالت "ميزوتو"؟

348
00:21:25,530 --> 00:21:27,390
لا تستعمل العبارات التّشريفيّة للتّفوّق عليها؟

349
00:21:27,660 --> 00:21:29,550
...دون أن ننسى تلك الابتسامة

350
00:21:29,550 --> 00:21:32,410
.ستخيفين هيغاشيرا بالكامل بتصرّفك هذا

351
00:21:33,260 --> 00:21:36,860
.نعم، سررت بلقائك أيضًا

352
00:21:39,060 --> 00:21:40,080
...مهلاً

353
00:21:40,080 --> 00:21:43,240
هـ-هل قلتُ شيئًا غريبًا؟

354
00:21:43,240 --> 00:21:44,680
...عفوًا

355
00:21:45,400 --> 00:21:48,960
ما نوع علاقتك بإيريدو-كُن؟

356
00:21:48,960 --> 00:21:49,530
ماذا؟

357
00:21:49,530 --> 00:21:51,910
.نـ-نحن صديقان نتشارك نفس الاهتمامات فحسب

358
00:21:52,500 --> 00:21:55,540
.هكذا إذًا

359
00:21:55,540 --> 00:22:00,290
عـ-عفوًا، هل فاتني شيء ما؟

360
00:22:00,290 --> 00:22:03,290
...لا، حسنًا

361
00:22:03,290 --> 00:22:04,500
...كانت أختي

362
00:22:05,450 --> 00:22:08,930
.تعتقد أنّك تكنّين مشاعر نحوي

363
00:22:09,200 --> 00:22:10,930
!ما-ماذا؟

364
00:22:10,930 --> 00:22:13,140
!مهلاً! لماذا أخبرتها؟

365
00:22:13,140 --> 00:22:15,020
.أقول الحقيقة فحسب

366
00:22:15,840 --> 00:22:17,140
.لا رحمة له

367
00:22:17,140 --> 00:22:18,700
.ميزوتو-كُن

368
00:22:19,650 --> 00:22:25,660
هذه ثاني مرّة في حياتي
.تمنّيتُ فيها لو وُلدتُ صبيًّا

369
00:22:25,660 --> 00:22:28,440
.كانت المرّة الأولى عندما بدأت دورتي الشّهريّة

370
00:22:28,440 --> 00:22:31,660
.أتوق لجسد لا ينزف من أعضائي السّفليّة

371
00:22:34,040 --> 00:22:36,280
سمعتِ، صحيح؟

372
00:22:36,280 --> 00:22:39,960
هل تعتقدين فعلاً أنّ فتاة ستتكلّم
بهذه الطّريقة مع فتى هي معجبة به؟

373
00:22:48,220 --> 00:22:51,680
.حسنًا، يبدوان متقرّبين من بعض بالفعل

374
00:22:51,680 --> 00:22:55,850
وكنتُ جاهزة لمساعدتها
...إن كانت مهتمّة به

375
00:22:55,850 --> 00:22:56,970
أنت أيضًا، صحيح؟

376
00:22:56,970 --> 00:23:00,590
.بالطّبع. إن افترضنا أنّها مهتمّة بها بالفعل

377
00:23:01,840 --> 00:23:04,480
...حسنًا يا ميزوتو-كُن، سأذهب من هنا

378
00:23:04,760 --> 00:23:07,710
.حسنًا. أراك غدًا إذًا

379
00:23:07,710 --> 00:23:09,050
!أكيد

380
00:23:09,050 --> 00:23:11,740
...و-و-وأيضًا

381
00:23:13,530 --> 00:23:16,440
!مـ-مع السّلامة لكما أيضًا

382
00:23:18,880 --> 00:23:20,290
.أبليتِ حسنًا

383
00:23:27,140 --> 00:23:28,520
...أخبريني يا يومي-تشان

384
00:23:29,670 --> 00:23:31,710
...بشأن ما قلتِه للتّوّ

385
00:23:31,710 --> 00:23:35,140
ما زلتِ جاهزة لمساعدة هيغاشيرا-سان، صحيح؟

386
00:23:35,140 --> 00:23:36,010
ماذا؟