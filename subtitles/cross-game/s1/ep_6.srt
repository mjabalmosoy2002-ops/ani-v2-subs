1
00:00:00,110 --> 00:00:06,690
m -12 -13 b -15 -11 -15 -8 -12 -6 b -7 -6 3 -6 12 -6 b 15 -8 15 -11 12 -13

2
00:00:00,110 --> 00:00:06,690
مدرسة سيشو الثانوية

3
00:00:08,650 --> 00:00:12,520
مرحبًا

4
00:00:13,460 --> 00:00:15,130
هل أحضرت نموذج التقديم للنادي؟

5
00:00:15,560 --> 00:00:16,430
نعم

6
00:00:16,430 --> 00:00:18,230
من الأفضل أن تنضم هذه المرة

7
00:00:19,000 --> 00:00:23,000
طالما لن يكون هناك من يضرب من هم أكبر منه، فلا بأس

8
00:00:29,140 --> 00:00:31,210
سنبدأ الآن مراسم الدخول

9
00:00:31,210 --> 00:00:34,580
...بما أن المدير في المشفى، سيقوم المرشد

10
00:00:37,180 --> 00:00:43,120
آسف على هذا. المدير التنفيذي، المعلم شيدو سيلقي كلمة الآن

11
00:00:46,920 --> 00:00:49,930
إلى جميع الطلاب الجدد، تهاني الحارة بانضمامكم

12
00:00:50,590 --> 00:00:54,930
بعضكم تخرج للتو من المرحلة المتوسطة، والبعض الآخر انتقل إلى هنا

13
00:00:55,230 --> 00:00:59,100
جميعكم هنا لأجل بداية جديدة

14
00:00:59,100 --> 00:01:01,710
ابتداءً من اليوم، ستكونون طلابًا في المرحلة الثانوية

15
00:01:02,270 --> 00:01:05,610
أرجو أن تجدوا في اجتهادكم، سواء في الدراسة أو في الرياضة

16
00:02:41,670 --> 00:02:43,140
طلاب منتقلون لنادي كرة القاعدة؟

17
00:02:43,410 --> 00:02:48,050
صحيح. حتى أن مبنىً سكنيًا بُني لهم بالقرب من هنا

18
00:02:48,050 --> 00:02:51,980
كما عينوا مدربًا قاد فريقًا للفوز في كوشيّن قبل بضع سنوات

19
00:02:53,680 --> 00:02:56,390
أوبا، هل علمتِ بهذا الشأن؟

20
00:02:56,390 --> 00:02:58,690
الشائعات، صحيح؟

21
00:02:58,690 --> 00:03:01,360
أظن أنهم يهدفون للوصول لكوشين حقًا

22
00:03:01,360 --> 00:03:03,160
هل أُقيل المدرب السابق؟

23
00:03:03,200 --> 00:03:07,110
الفريق الثاني

24
00:03:03,630 --> 00:03:07,100
لم يُقال، وإنما أُبعد من الفريق

25
00:03:06,430 --> 00:03:07,100
أُبعد؟

26
00:03:07,100 --> 00:03:12,040
قمامة قابلة للحرق

27
00:03:07,100 --> 00:03:12,040
قمامة غير قابلة للحرق

28
00:03:07,530 --> 00:03:12,040
لقد استضافوا تجارب أداءٍ للطلاب غير المنتقلين، وقسموا الفريق إلى اثنين

29
00:03:12,600 --> 00:03:18,440
من النادي الأصلي، وبضم الطلاب الجدد، لم يلتحق بالفريق سوى خمسة أشخاص

30
00:03:18,440 --> 00:03:19,980
هناك قادم جديد واحد فقط

31
00:03:20,240 --> 00:03:21,280
واحد فقط؟

32
00:03:21,280 --> 00:03:21,910
من هو؟

33
00:03:22,180 --> 00:03:25,850
ماكي-سينباي. أرجوك اعتنِ بهذه الكرات

34
00:03:25,850 --> 00:03:27,080
!ماذا؟

35
00:03:27,080 --> 00:03:28,820
ألديك مشكلة؟

36
00:03:29,190 --> 00:03:34,060
تنظيف الملابس والكرات من مهام الفريق الثاني. لا يهم في أي سنة أنت

37
00:03:34,790 --> 00:03:41,030
وإن لم تفعل ما أقوله لك، فلن أدع قدمك تطأ أرض الملعب، فهمت؟

38
00:03:41,500 --> 00:03:45,770
هل فشل مستقبل الكرات ذاك، القائد السابق من فريق المرحلة المتوسطة في تجارب الأداء؟

39
00:03:46,100 --> 00:03:52,080
كلا. يبدو أنه لم يكن يرغب بالانضمام في المقام الأول. إنه أكايشي-سينباي

40
00:03:55,450 --> 00:03:56,980
تبًا، هذه سخافة

41
00:03:57,650 --> 00:04:00,820
!أيها الوافد الجديد! اذهب لغسل الكرات

42
00:04:02,150 --> 00:04:03,850
هذا أمر من قائد الفريق الرئيسي

43
00:04:04,520 --> 00:04:08,560
لقد أمركم أنتم، أليس كذلك؟

44
00:04:08,560 --> 00:04:10,690
ألديك مشكلة؟

45
00:04:12,430 --> 00:04:14,730
أنا وافد جديد أيضًا كما تعلم

46
00:04:19,070 --> 00:04:21,110
اسمحوا لي

47
00:04:21,110 --> 00:04:22,240
من أنتِ؟

48
00:04:22,910 --> 00:04:27,850
أنا طالبة المرحلة الأولى، أوكوبو. أنا مديرة الفريق الثاني

49
00:04:27,850 --> 00:04:29,710
أرجو أن تبدؤوا التدريبات

50
00:04:29,710 --> 00:04:34,280
غبية! كيف لنا أن نلعب في مكان ضيق كهذا؟

51
00:04:35,320 --> 00:04:39,390
يبدو بأننا سننال فرصة أخرى قبل بدء المباريات المهمة في الصيف

52
00:04:39,890 --> 00:04:47,360
إن أدينا جيدًا ونافسنا الفريق الرئيسي، فلن يكون الوصول لكوشين مستحيلاً

53
00:04:47,770 --> 00:04:49,730
توقف عن الترهات أيها العجوز الخرف

54
00:04:49,730 --> 00:04:53,170
كيف لنا أن نصدق بهذا بعد ما حدث لنا سابقًا؟

55
00:04:53,170 --> 00:04:58,880
مهما نظرت إلى الأمر، ألسنا أفضل مهارة من هؤلاء الخمسة؟

56
00:04:58,880 --> 00:05:05,050
هذا صحيح. لقد اختبروا شخصياتكم عوضًا عن مهاراتكم. ربما

57
00:05:05,050 --> 00:05:07,150
ماذا قلت؟

58
00:05:07,150 --> 00:05:08,720
من الأفضل أن تتوقف

59
00:05:09,290 --> 00:05:12,890
هذا الفتى أعنف مني ما إن يصبح جادًا

60
00:05:16,890 --> 00:05:19,100
ربما سنترك اللعب

61
00:05:19,400 --> 00:05:23,730
هذا لن يفيد. أقدر مؤهلاتكم كلاعبين

62
00:05:24,230 --> 00:05:27,440
وسنحتاج لتلك المؤهلات في مباراتنا القادمة

63
00:05:28,110 --> 00:05:29,510
أنا لا أهتم

64
00:05:29,510 --> 00:05:32,380
لا أمانع باستخدام العنف إن اضطررت لذلك

65
00:05:32,380 --> 00:05:33,980
أيها العجوز، افعل شيئًا

66
00:05:34,210 --> 00:05:36,650
أصبح الأمر مشوقًا، لذا سأغض النظر عما يحدث

67
00:05:56,430 --> 00:05:58,570
وبهذا ننهي تدريبنا اليوم

68
00:05:58,570 --> 00:06:01,040
طلاب السنة الأولى، نظفوا المكان قبل أن تغادروا

69
00:06:01,570 --> 00:06:03,540
بورك عملنا

70
00:06:05,110 --> 00:06:06,640
بورك عملكِ يا أوبا

71
00:06:06,640 --> 00:06:09,510
بما أنكِ انتهيتِ، أتودين القدوم معنا؟

72
00:06:10,350 --> 00:06:13,320
فحص لاعبي النخبة في فريق المرحلة الثانوية

73
00:06:19,890 --> 00:06:22,890
أيتها المديرة. أيمكنكِ معالجة جرحي؟

74
00:06:29,130 --> 00:06:31,840
ما الذي تفعلينه؟

75
00:06:31,840 --> 00:06:33,370
أبي

76
00:06:33,370 --> 00:06:34,000
أبي؟

77
00:06:37,440 --> 00:06:38,740
المدير

78
00:06:38,740 --> 00:06:41,280
"التنفيذي". إنه الـ"مدير التنفيذي"

79
00:06:42,780 --> 00:06:43,750
إلى متى؟

80
00:06:44,310 --> 00:06:51,660
لا أعلم. يخطط المدير للعودة

81
00:06:53,020 --> 00:06:56,360
بالرغم من عدم وجود أي إشارة لخروجه؟

82
00:06:57,630 --> 00:06:58,930
أبي

83
00:06:58,930 --> 00:07:02,270
أنتِ. لا تناديني بأبي في المدرسة

84
00:07:02,530 --> 00:07:04,800
ما رأيكِ بمنصب المديرة يا ليسا؟

85
00:07:04,800 --> 00:07:06,440
إنه عمل ممل

86
00:07:06,900 --> 00:07:09,870
ولكن إن استطعت الوصول لكوشين، سأتحمل الأمر

87
00:07:11,040 --> 00:07:14,280
من الواضح أن الجمال يجذب اهتمام الكل

88
00:07:14,880 --> 00:07:20,280
دعي الأمر لي، آنستي. سأصل بكِ إلى هناك خلال ثلاث سنوات

89
00:07:20,920 --> 00:07:22,750
أنا أعتمد عليك أيها المدرب

90
00:07:22,750 --> 00:07:26,560
لم يعد بإمكاننا الجلوس وعدم فعل أي شيء

91
00:07:26,560 --> 00:07:30,760
علينا أن نجعل من هذه المدرسة معروفة للأمة بأكملها

92
00:07:30,760 --> 00:07:34,700
هدفي هو أن أصبح مديرًا لهذه المدرسة

93
00:07:35,230 --> 00:07:37,000
مفهوم

94
00:07:37,000 --> 00:07:40,770
لذا إن احتجت لأي شيء، اطلب مني فقط

95
00:07:40,770 --> 00:07:43,740
في الوقت الحالي، نحتاج لآلتي رمي كرات

96
00:07:43,740 --> 00:07:47,640
وبعض معدات التدريب للنادي

97
00:07:47,640 --> 00:07:49,550
حسنٌ، لك ما تريد

98
00:07:51,980 --> 00:07:53,680
يبدو راميًا جيدًا

99
00:07:53,980 --> 00:07:55,890
الأبرز، كاميكاوا

100
00:07:55,890 --> 00:07:59,120
الكرات السريعة والمنحنية من اختصاصه

101
00:07:59,120 --> 00:08:02,560
خلال المباريات، يستطيع يستطيع الحفاظ على فارق النتيجة لـ2-3 نقاط

102
00:08:02,860 --> 00:08:08,430
لاعب الوسط ميكي، ولاعب الاعتراض القصير كيشيبي كانا ضاربان رابعان مميزان في المرحلة المتوسطة

103
00:08:08,800 --> 00:08:12,870
...يمكنهما أخذ مكان الضارب الثاني والثالث. و

104
00:08:14,910 --> 00:08:20,210
الضارب الرابع أزوما يوهي. من دون أي شك، إنه لاعب من النخبة

105
00:08:29,150 --> 00:08:31,020
ما رأيكِ يا أوبا؟

106
00:08:31,020 --> 00:08:32,990
إنه رامٍ بارز بالفعل

107
00:08:34,960 --> 00:08:36,630
...ولكن

108
00:08:37,360 --> 00:08:38,700
لا أشعر بأي شيء في قلبي

109
00:08:40,130 --> 00:08:41,900
...أخبروني، أليس ذلك

110
00:08:47,040 --> 00:08:49,310
هيا، لا تضرب الكرة بقوة

111
00:08:49,310 --> 00:08:50,170
هذا المكان صغير

112
00:08:51,710 --> 00:08:53,710
أيتها السمينة. أحضري الكرات

113
00:08:54,010 --> 00:08:55,010
!حاضر

114
00:08:55,450 --> 00:08:57,080
مكان صغير للغاية

115
00:08:57,080 --> 00:08:58,920
لقد أبعدوا فعلاً

116
00:09:06,790 --> 00:09:09,690
أصبح فريق المرحلة المتوسطة مسؤوليتكِ، أيتها القائدة الجديدة

117
00:09:12,560 --> 00:09:15,200
هل أنت ذاهب لتجارب الأداء؟

118
00:09:15,800 --> 00:09:20,570
كلا. للأسف، سأصاب بألم بمعدتي يومها

119
00:09:21,340 --> 00:09:24,040
لا أخطط للبقاء ضمن الفريق الثاني مدة طويلة

120
00:09:24,040 --> 00:09:26,510
لدينا سلاح سري في فريقنا

121
00:09:27,010 --> 00:09:28,380
سلاح سري؟

122
00:09:46,500 --> 00:09:49,300
المحطة التالية هي ميفوجيداي، ميفوجيداي

123
00:09:59,840 --> 00:10:02,950
سيغلق الباب. أرجو الانتباه

124
00:10:09,850 --> 00:10:12,160
هل ضربتني على وجهي بحقيبتك؟

125
00:10:13,120 --> 00:10:16,830
لقد أيقظتك بلطف فقط. ما خطبك؟

126
00:10:16,830 --> 00:10:19,300
ألا يمكنك شكري فقط؟

127
00:10:19,600 --> 00:10:25,140
غبية! أنتِ في السنة الثالثة ولا تعرفين معنى "بلطف"؟

128
00:10:25,140 --> 00:10:27,240
!انظري! أنفي ينزف

129
00:10:27,500 --> 00:10:29,170
ستعيش

130
00:10:29,170 --> 00:10:31,140
وتجاوز المحطة لن يقتلني أيضًا، صحيح؟

131
00:10:31,810 --> 00:10:34,080
هل لك ألا تقترب مني هكذا؟

132
00:10:34,080 --> 00:10:37,680
سيكون من المحرج أن تراني صديقاتي معك

133
00:10:45,490 --> 00:10:47,390
لم انضممت لفريق كرة القاعدة؟

134
00:10:47,760 --> 00:10:50,630
ماذا؟ أقلتِ شيئًا؟

135
00:10:50,630 --> 00:10:54,300
قلت، لم انضممت لفريق كرة القاعدة؟

136
00:10:54,300 --> 00:10:57,130
لأنني أرغب بلعب كرة القاعدة طبعًا

137
00:10:59,140 --> 00:11:02,540
بالرغم من أنك كنت تكرهها في ذلك الوقت

138
00:11:03,110 --> 00:11:06,910
هذا صحيح. لعبت في البداية لأن ناكانيشي أجبرني

139
00:11:07,510 --> 00:11:12,580
ولكن يومًا ما، كانت هناك تلك الرامية في الفريق المقابل بتلك الرميات المجنونة

140
00:11:16,050 --> 00:11:18,890
كانت اللاعبة بارعة حقًا

141
00:11:22,660 --> 00:11:29,330
"وتفتقد للشخصية الجيدة. حتى إنها لا تعرف معنى "بلطف

142
00:11:31,600 --> 00:11:37,840
فكرت حينها، سيكون الأمر ممتعًا بتلك الرميات

143
00:11:37,840 --> 00:11:39,980
بالرغم من قدرتي

144
00:11:49,520 --> 00:11:51,990
إن لم يعجبك مركز الضرب هذا

145
00:11:52,560 --> 00:11:57,790
فهناك واحد آخر يبعد مسافة ساعة بالباص، سينباي

146
00:12:14,580 --> 00:12:18,120
إلى متى ستظل نائمًا يا كو؟ أليس لديك مدرسة؟

147
00:12:30,470 --> 00:12:32,400
لم توقفت كلتاهما؟

148
00:12:34,540 --> 00:12:36,740
أنت، أسرع وإن لن تصل في الوقت المناسب

149
00:12:42,340 --> 00:12:45,580
مدرستنا صارمة فيما يخص التأخر

150
00:12:52,920 --> 00:12:54,890
!انزلاق! بالكاد ولكن بسلام

151
00:12:58,130 --> 00:13:01,200
...في حصة هذا اليوم

152
00:13:02,500 --> 00:13:05,100
غبي. ستُطرد من الفصل

153
00:13:05,430 --> 00:13:07,040
أنت! ما هو اسمك؟

154
00:13:08,500 --> 00:13:11,470
رقم 2. أزوما يوهي

155
00:13:11,770 --> 00:13:12,940
أزوما؟

156
00:13:12,970 --> 00:13:14,880
خاص

157
00:13:18,780 --> 00:13:21,250
لنبدأ درسنا

158
00:13:24,450 --> 00:13:28,020
...لهذا المقطع من الحديث

159
00:13:33,630 --> 00:13:36,330
...هذا المقطع من الحديث

160
00:13:44,870 --> 00:13:46,910
إذن انضم كو لنادي فريق كرة القاعدة؟

161
00:13:47,180 --> 00:13:48,810
هذا ما أخبرتني به أوبا

162
00:13:49,240 --> 00:13:51,210
لا أطيق صبرًا لأرى النتائج

163
00:13:51,210 --> 00:13:56,480
فهو حامل الرقم القياسي في مركز الضرب الخاص بنا

164
00:13:57,790 --> 00:14:03,190
ولكن الأمر ليس سهلاً. سمعت بأنه انضم لفريق غريب

165
00:14:03,190 --> 00:14:03,960
فريق غريب؟

166
00:14:04,360 --> 00:14:09,300
..."أعلم أنه ليس بـ"فريق رجعي

167
00:14:09,560 --> 00:14:11,670
يا لاعب الفريق الثاني

168
00:14:11,670 --> 00:14:12,930
إلى من تتحدث؟

169
00:14:12,930 --> 00:14:19,910
أنت بالطبع. أنت، يريد المدرب منك أن تنظف الملعب خلال الغداء

170
00:14:19,910 --> 00:14:20,980
كل يوم من اليوم

171
00:14:21,440 --> 00:14:24,950
أنتم من يستخدمون الملعب. نظفوه بأنفسكم

172
00:14:25,250 --> 00:14:31,520
من الأفضل ألا ترفض. هذا إن أردت البقاء مع الفريق الثاني

173
00:14:31,520 --> 00:14:35,490
مدربنا يكره اللاعبين عديمي الموهبة

174
00:14:36,120 --> 00:14:37,930
أليس كذلك، أزوما؟

175
00:14:39,460 --> 00:14:40,960
من أنت؟

176
00:14:41,830 --> 00:14:45,430
أنا في فريقك، طالب السنة الأولى سيندا

177
00:14:45,430 --> 00:14:46,870
لا أتذكر وجهك أبدًا

178
00:14:49,070 --> 00:14:54,780
حسنٌ يا لاعب الفريق الثاني. لقد أعطيتك أمرًا

179
00:14:55,610 --> 00:14:57,210
تذكر وجوههم على الأقل

180
00:14:57,580 --> 00:14:59,610
هل أنت في فريق كرة القاعدة؟

181
00:15:00,450 --> 00:15:03,650
أنت لا تتذكر، صحيح؟ ألا لست في الرئيسي حتى

182
00:15:03,650 --> 00:15:06,050
أنت من كان يركض هذا الصباح، صحيح؟

183
00:15:07,190 --> 00:15:10,330
لقد تذكرتني. أشعر بالفخر

184
00:15:10,630 --> 00:15:14,300
وفي السنة الماضية قابلتك في مركز الضرب أيضًا

185
00:15:16,660 --> 00:15:22,770
إن انتهيت من الطعام، ابدأ التنظيف حالاً يا لاعب الفريق الثاني

186
00:15:30,310 --> 00:15:33,080
لا تتقاعس. المرشد يتابعنا

187
00:15:36,720 --> 00:15:39,990
سيثور غاضبًا ما لم تناديه بالمدير التنفيذي

188
00:15:40,290 --> 00:15:43,730
كل الشائعات عنه مريبة

189
00:15:43,730 --> 00:15:47,730
غالبًا ما تكون شائعات هذه المدرسة صحيحة

190
00:16:00,280 --> 00:16:01,710
حان الوقت. تبادل معي

191
00:16:02,510 --> 00:16:06,010
لحظة فقط. لقد أتيت لتوي

192
00:16:06,310 --> 00:16:08,880
لا تضيع وقتي

193
00:16:13,620 --> 00:16:17,390
أنت. قم بتسوية الأرض قبل أن تذهب

194
00:16:17,390 --> 00:16:18,630
ألست أعسرًا؟

195
00:16:19,790 --> 00:16:21,960
وإن يكن؟

196
00:16:30,410 --> 00:16:35,180
أزوما. كوبو لاعب أساسي على الأقل

197
00:16:35,180 --> 00:16:36,580
لا تتصرف معه هكذا

198
00:16:37,280 --> 00:16:38,480
كوبو؟

199
00:16:38,480 --> 00:16:40,950
ذلك الضارب الذي كان قبلك

200
00:16:41,420 --> 00:16:42,750
أي واحد منهم؟

201
00:16:42,750 --> 00:16:43,720
بالله عليك

202
00:16:43,990 --> 00:16:47,120
لا تعلق آمالك على ذلك الشخص

203
00:16:47,460 --> 00:16:51,430
لديه وجه لا يمكنني تذكره

204
00:16:51,430 --> 00:16:53,090
وجه غير مهم

205
00:16:54,730 --> 00:16:57,730
كم عدد الأشخاص الذين تتذكرهم في هذا الفريق؟

206
00:16:58,130 --> 00:16:59,870
...ثلاثـ.. لا

207
00:17:02,040 --> 00:17:04,210
أربعة على ما أعتقد

208
00:17:04,810 --> 00:17:09,140
هذا لا يكفي. أريدك أن تتذكر ثمانية منهم على الأقل قبل الصيف

209
00:17:21,790 --> 00:17:23,660
إنها جميلة فعلاً

210
00:17:23,660 --> 00:17:25,360
إنها جميلة للغاية، تبًا

211
00:17:25,360 --> 00:17:29,300
إنها ابنة المدير، قد جاءت قريبًا من دولة أجنبية

212
00:17:29,300 --> 00:17:33,330
تبدو كمخلوق مختلف تمامًا عن مديرتنا

213
00:17:33,330 --> 00:17:34,170
كليًا

214
00:17:35,270 --> 00:17:36,640
تلاقت أعيننا

215
00:17:36,940 --> 00:17:39,210
تلك النظرة رائعة

216
00:17:40,070 --> 00:17:43,980
!إنها تشبه نظرة أمي عندما تحدق بالصراصير

217
00:17:43,980 --> 00:17:45,480
من تدعوهم بالصراصير؟

218
00:17:50,180 --> 00:17:53,760
ما رأيكم؟ لم تروا ذراعًا قويةً كهذه من قبل، صحيح؟

219
00:17:54,690 --> 00:17:55,520
...ولكن

220
00:17:56,090 --> 00:17:58,390
ألا يشبه أكايشي؟

221
00:17:58,390 --> 00:17:58,990
صحيح

222
00:17:59,590 --> 00:18:00,800
أكايشي؟

223
00:18:00,800 --> 00:18:03,630
نعم. إنه رامٍ بالفريق الثاني. طالب من السنة الأولى

224
00:18:04,100 --> 00:18:05,600
الفريق الثاني؟

225
00:18:05,600 --> 00:18:09,670
هل حضر شخص مثله للتجارب؟

226
00:18:09,670 --> 00:18:12,040
كلا، هو لم يأتِ للتجارب

227
00:18:12,040 --> 00:18:13,680
هو واثنان آخران، صحيح؟

228
00:18:13,680 --> 00:18:16,510
ثلاث طلاب من السنة الأولى لم يأتوا للتجارب

229
00:18:16,510 --> 00:18:20,520
...صحيح. ثلاثتهم قالوا إنهم مصابون بألم في المعدة

230
00:18:28,190 --> 00:18:29,720
ماذا؟ لا أحد هنا

231
00:18:33,390 --> 00:18:35,760
!سينباي! مساء الخير

232
00:18:35,760 --> 00:18:38,470
أيتها السمينة، أين الجميع؟

233
00:18:38,470 --> 00:18:40,470
إنهم في ملعب المرحلة المتوسطة

234
00:18:40,470 --> 00:18:41,270
المرحلة المتوسطة؟

235
00:18:41,500 --> 00:18:47,280
نعم. لدى طلاب السنتين الأولى والثانية أنشطة مدرسية ولا يمكنهم التدرب اليوم

236
00:18:47,580 --> 00:18:53,180
من الخسارة ألا نستفيد من المكان، لذا دعتهم قائدة الفريق

237
00:18:55,750 --> 00:18:57,720
مكان واسع، هذا رائع

238
00:19:00,050 --> 00:19:01,660
كما هو متوقع منها

239
00:19:01,660 --> 00:19:04,860
لقد تعلمت عادات كل واحد منهم وها هي ترمي بطريقة يمكنهم بها صدها

240
00:19:06,290 --> 00:19:07,830
انظر جيدًا يا كو

241
00:19:07,830 --> 00:19:12,230
الطريقة التي تحرك فيها تسوكيشيما ذراعها ومرفقها مثالية

242
00:19:13,430 --> 00:19:15,670
نعم. أعرف

243
00:19:15,670 --> 00:19:16,600
!تحرك

244
00:19:17,340 --> 00:19:20,240
ماذا؟ الرامية فتاة؟

245
00:19:20,240 --> 00:19:23,080
لا عجب أن حمقى مثلكم يمكنهم ضرب الكرات

246
00:19:23,850 --> 00:19:26,550
من الأفضل ألا تتهاوني

247
00:19:26,550 --> 00:19:29,780
وإلا لن تعلمي إلى أين ستطير الكرة

248
00:19:32,350 --> 00:19:36,120
تلك الرامية جميلة حقًا

249
00:19:36,120 --> 00:19:37,460
...تلك

250
00:19:41,930 --> 00:19:46,330
!تشبه نظرة أمي عندما تُوشك على سحق الصراصير

251
00:19:47,040 --> 00:19:50,940
لنذهب يا كو. ابدأ بالإحماء. ومن ثم قم ببعض الرميات الخفيفة

252
00:19:50,940 --> 00:19:51,810
حاضر

253
00:20:01,920 --> 00:20:04,450
يبدو الأمر مختلفًا

254
00:20:04,750 --> 00:20:09,920
عن المرة التي كنتم تتدربون فيها خلسة خلف المدرسة

255
00:20:11,460 --> 00:20:16,030
بسبب كبري في السن، لم أعد أحلم كثيرًا

256
00:20:17,200 --> 00:20:20,400
رمية واحدة جيدة تكفي. لن يلاحظ أحد

257
00:20:20,400 --> 00:20:25,110
يركز الجميع على ما يخصهم، بعدما لم يعد بإمكانهم التدرب لوقت طويل

258
00:20:30,950 --> 00:20:31,380
!كو

259
00:20:42,690 --> 00:20:43,460
!أزوما

260
00:20:49,160 --> 00:20:50,500
...لقد رآها

261
00:20:56,640 --> 00:20:59,940
من ترك الطباشير هنا؟

262
00:21:03,680 --> 00:21:05,180
رائع يا ناكانيشي

263
00:21:10,520 --> 00:21:13,820
لدينا سلاح سري في فريقنا

264
00:21:24,170 --> 00:21:27,100
الأحلام السعيدة قادمة الليلة

265
00:23:06,200 --> 00:23:09,800
أوبا. لم تتدربين مع الفريق الرئيسي؟

266
00:23:09,800 --> 00:23:12,240
إنها مثالية كرامية يمكن التخلص منها

267
00:23:12,640 --> 00:23:15,080
يمكن التخلص منها؟ كيف يمكنك قول هذا؟

268
00:23:15,080 --> 00:23:17,450
المعذرة. أرجوك غيّر مستقبل الكرات

269
00:23:17,450 --> 00:23:18,080
!أوبا

270
00:23:18,350 --> 00:23:22,720
ماذا؟ هل ستُظهر المهارات التي لا يمكنك عرضها في المباريات الحقيقية؟

271
00:23:22,720 --> 00:23:24,720
!لا تستمع لهذا الفتى

272
00:23:25,320 --> 00:23:28,060
في الحلقة السابعة من كروس غيم

273
00:23:28,060 --> 00:23:30,120
إنه المظهر

274
00:23:30,360 --> 00:23:32,760
أريد أن ألقنهم درسًا، من أجلك