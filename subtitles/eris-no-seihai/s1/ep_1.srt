1
00:00:09,870 --> 00:00:12,240
انظري إلى كلّ هؤلاء النّاس يا كيت

2
00:00:12,730 --> 00:00:14,750
هل تعتقدين بأنّه يوجد مهرجان؟

3
00:00:15,140 --> 00:00:17,610
هيّا يا كونّي. لنذهب إلى المنزل

4
00:00:17,900 --> 00:00:18,740
—لكن

5
00:00:22,820 --> 00:00:23,870
كيت؟

6
00:00:26,640 --> 00:00:28,750
!كيت! أين أنت؟

7
00:01:12,280 --> 00:01:13,730
...مُذهل

8
00:01:14,610 --> 00:01:16,250
إنّها جميلة جدّاً

9
00:01:22,280 --> 00:01:23,800
اللّعنة عليكم

10
00:01:24,510 --> 00:01:28,130
!اللّعنة عليكم جميعاً

11
00:01:34,070 --> 00:01:36,490
!أ-أيّتها الشّرّيرة

12
00:01:37,320 --> 00:01:38,480
!شرّيرة

13
00:01:38,480 --> 00:01:39,690
!قاتلة

14
00:01:39,690 --> 00:01:40,760
!اسمعي، اسمعي

15
00:01:40,760 --> 00:01:42,830
!أنتِ الملعونة

16
00:02:33,050 --> 00:02:35,250
!انتهى الأمر! ماتت

17
00:02:35,250 --> 00:02:36,430
!ماتت ورحلت

18
00:02:36,430 --> 00:02:37,750
!تستحقّ ذلك

19
00:03:00,450 --> 00:03:03,860
مضى عشر سنوات منذ تلك اللّيلة
،في ساحة القدّيس مارك

20
00:03:04,380 --> 00:03:08,140
وأنا، كونستانس غريل، في سنّ السّادسة عشر

21
00:03:11,030 --> 00:03:14,540
اسمحي لي أن أهنّئكِ يا آنسة غريل

22
00:03:14,540 --> 00:03:18,550
شكراً جزيلاً لك أيّها الفيكونت هامسورث

23
00:03:18,550 --> 00:03:22,910
،سيُبارك القدر بزواجكما بالتّأكيد

24
00:03:22,910 --> 00:03:27,870
"بشعار عائلة غريل "كُن صادقاً

25
00:03:29,320 --> 00:03:32,550
كُن صادقاً" إذاً؟"

26
00:03:33,310 --> 00:03:35,650
بدأ كلّ هذا قبل أشهر قليلة

27
00:03:35,650 --> 00:03:39,060
،أبي، التجسيد الحيّ لصدق عائلة غريل

28
00:03:39,390 --> 00:03:42,070
وجد نفسه غارقاً في بحر من الدّيون

29
00:03:43,160 --> 00:03:45,530
أنا آسف يا كونّي

30
00:03:46,440 --> 00:03:48,980
،شريطة أن تُسدّد شركة برونسون الدَّين

31
00:03:48,980 --> 00:03:54,050
خُطِبتُ لابن السّيّد برونسون والوريث، نيل

32
00:03:55,620 --> 00:03:57,950
نيل برونسون، في خدمتكِ

33
00:03:59,660 --> 00:04:03,150
لا أنكر بأنّني حلمتُ بالزّواج عن حُبّ

34
00:04:06,000 --> 00:04:09,490
لكن فتاة بليدة وبسيطة مثلي ينبغي
أن تعتبر نفسها مُبارَكة

35
00:04:09,490 --> 00:04:13,940
لأنّ رجلاً نبيلاً حسن السّلوك
وسيماً وافق على أن يصبح زوجها

36
00:04:14,380 --> 00:04:15,990
أو هذا ما ظننتُه

37
00:04:17,020 --> 00:04:18,990
!سمعتُ الأنباء يا كونّي

38
00:04:19,260 --> 00:04:22,030
،خُطِبتِ لنيل برونسون

39
00:04:22,030 --> 00:04:25,740
!لكن الجميع يتحدّثون عنه وعن باميلا فرانشيز

40
00:04:26,020 --> 00:04:27,870
باميلا فرانشيز؟

41
00:04:27,870 --> 00:04:32,880
أجل! رآهم أحدهم يمسكان بأيدي بعضهما الآخر
!عندما ظنّا بأنّه لم يكن يراهما أحد

42
00:04:33,880 --> 00:04:38,370
يبدو أنّ نيل يُقدّسها. ألا تعتقدين ذلك يا كيت؟

43
00:04:38,370 --> 00:04:42,750
مهلاً يا ميلين. ينبغي أن تتوقّفي
عن نشر إشاعات لا أساس لها

44
00:04:43,200 --> 00:04:47,390
لا يمكن لأحد أن يتصرّف هكذا بعد
خطوبته مُباشرة، وأنتِ تعلمين ذلك

45
00:04:47,390 --> 00:04:49,380
لستُ أدري

46
00:04:49,380 --> 00:04:54,660
سمعتُ بأنّ باميلا تتعامل مع الرّجال مثلما
نتعامل نحن مع شركاء الرّقص

47
00:04:54,660 --> 00:04:58,400
عجباً! ألم يعُد هناك حشمة؟

48
00:05:01,920 --> 00:05:04,150
أثق بنيل

49
00:05:04,620 --> 00:05:07,390
كان يُعاملني على طبيعته في هذا اليوم تحديداً

50
00:05:13,310 --> 00:05:16,030
!نيل و... باميلا؟

51
00:05:38,070 --> 00:05:39,960
ليتني أستطيع التّظاهر بأنّني لم أرهما

52
00:05:40,750 --> 00:05:46,690
نظراً لظروف خطوبتنا، عرفتُ
بأنّني لن أتلقّى حُبّاً

53
00:05:49,880 --> 00:05:53,500
لكن رغم ذلك، يجب أن أواجهه بصدق

54
00:05:54,200 --> 00:05:57,090
علينا تسوية الأمور بالنّقاش

55
00:06:06,900 --> 00:06:08,990
يا لها من فتاة حسناء

56
00:06:10,010 --> 00:06:14,070
المعذرة... اسمي كونستانس غريل

57
00:06:14,550 --> 00:06:16,600
أكره التطفُّل، لكن هل أنتِ بخير؟

58
00:06:16,600 --> 00:06:18,350
كم يبدو هذا مُسلّياً

59
00:06:19,780 --> 00:06:21,850
ألن تدخلي؟

60
00:06:23,220 --> 00:06:24,600
هل يمكنني؟

61
00:06:24,900 --> 00:06:27,680
ماذا؟ بالتّأكيد

62
00:06:33,120 --> 00:06:34,870
!دخلت

63
00:06:36,230 --> 00:06:38,880
أنا مُمتنّة لكِ يا فتاة

64
00:06:38,880 --> 00:06:41,010
فـ-فتاة"؟"

65
00:06:48,200 --> 00:06:50,330
ماذا ينبغي أن أقول لنيل؟

66
00:06:52,460 --> 00:06:53,670
...المعذرة

67
00:06:54,650 --> 00:06:58,650
تـ-تهانينا خطوبتكِ

68
00:06:59,560 --> 00:07:01,440
شكراً جزيلاً لكِ

69
00:07:02,710 --> 00:07:04,520
،حسبما أذكر

70
00:07:05,070 --> 00:07:07,340
أراها كثيراً مع باميلا

71
00:07:12,760 --> 00:07:16,220
بريندا، دبّوس شعركِ يسقط

72
00:07:17,310 --> 00:07:20,040
ربّما ينبغي أن تخلعيه فحسب

73
00:07:20,040 --> 00:07:23,200
أ-أجل، سأفعل على ما أعتقد

74
00:07:24,410 --> 00:07:26,760
حسناً. هكذا أفضل

75
00:07:29,700 --> 00:07:33,400
نسيتُ محفظتي في الطّابق الثّاني

76
00:07:33,400 --> 00:07:38,680
هلّا احتفظتِ بدبُّوس شعري لأجلي
ريثما أذهب لإحضارها؟

77
00:07:38,680 --> 00:07:42,100
أجل، بالطّبع. لا تلقي بالاً للأمر

78
00:07:54,950 --> 00:07:57,340
...غابت بريندا لفترة طويلة

79
00:07:57,340 --> 00:07:59,830
!كونستانس غريل

80
00:08:03,070 --> 00:08:06,340
تصرّفتِ بصورة شنيعة

81
00:08:06,340 --> 00:08:08,990
باميلا؟ نيل؟

82
00:08:09,340 --> 00:08:12,340
أعلم بأنّ عائلتكِ في ضائقة

83
00:08:12,760 --> 00:08:16,230
لكن ألا تعتقدين بأنّكِ تماديتِ كثيراً؟

84
00:08:16,520 --> 00:08:19,670
بصراحة، أشكّ بشخصيّتكِ

85
00:08:19,670 --> 00:08:21,970
مـ-ماذا تقصدين؟

86
00:08:21,970 --> 00:08:24,580
ماذا؟ أتتوقّعين منّا أن نُصدّق جهلكِ؟

87
00:08:24,580 --> 00:08:26,030
لن يفلح هذا

88
00:08:26,030 --> 00:08:30,480
أعلم بأنّكِ سرقتِ دبُّوس شعر بريندا

89
00:08:32,280 --> 00:08:37,760
سمعتُ الرّواية بأكملها. ما إن رتّبتِ شعرها

90
00:08:37,760 --> 00:08:41,130
حتّى أدركتْ بأنّ دبُّوسها الثّمين قد ضاع

91
00:08:41,380 --> 00:08:47,370
،أخبريني يا كونستانس غريل
لماذا فعلتِ ذلك؟

92
00:08:47,790 --> 00:08:49,740
ماذا تقصدين؟

93
00:08:50,330 --> 00:08:55,770
أنا متأكّدة بأنّ شخصاً محتاجاً للمال
كان ليفعل المستحيل لأجله

94
00:08:56,000 --> 00:08:59,010
أجل، أتفهّم ألمكِ وشعوركِ

95
00:08:59,010 --> 00:09:02,760
أعرف كلّ شيء عن وضع عائلتكِ
الّذي يُرثى له

96
00:09:03,670 --> 00:09:06,760
...لـ-لكن بريندا طلبتْ منّي

97
00:09:06,760 --> 00:09:09,640
أرينا مِحفظتكِ إذاً

98
00:09:11,910 --> 00:09:15,400
إن لم تكوني لصّة، فلا ينبغي أن تكون مُشكلة

99
00:09:17,700 --> 00:09:21,160
...كونستانس، هل يُعقَل أنّكِ

100
00:09:22,110 --> 00:09:23,170
!لا

101
00:09:29,390 --> 00:09:30,910
ويحي

102
00:09:31,220 --> 00:09:35,050
وماذا لدينا هنا؟

103
00:09:35,050 --> 00:09:37,420
أنتِ مُلزمة بشرح

104
00:09:37,420 --> 00:09:38,840
سرقَتْه فعلاً إذاً؟

105
00:09:38,840 --> 00:09:40,310
من عائلة غريل تحديداً؟

106
00:09:41,460 --> 00:09:43,600
بريندا من طلبت منّي ذلك

107
00:09:44,350 --> 00:09:47,330
طلبت منكِ الاحتفاظ بهذه؟

108
00:09:47,330 --> 00:09:50,140
رغم أنّكما بالكاد تعرفان بضعكما الآخر

109
00:09:50,140 --> 00:09:52,940
أجد صعوبة في تصديق ذلك

110
00:09:54,440 --> 00:09:55,630
!بريندا

111
00:09:56,570 --> 00:09:58,070
!أخبريهم أرجوكِ

112
00:09:58,070 --> 00:10:00,200
!أنتِ من طلب منّي، أتتذكّرين؟

113
00:10:00,200 --> 00:10:03,200
طلبتِ منّي الاحتفاظ به ريثما
!تحضرين مِحفظتكِ

114
00:10:03,200 --> 00:10:04,660
!ألا تتذكّرين؟

115
00:10:06,610 --> 00:10:08,950
لِمَ لا تخبريهم يا بريندا؟

116
00:10:09,220 --> 00:10:11,320
!بريندا، أرجوكِ

117
00:10:12,620 --> 00:10:14,710
أعذاركِ مُخزية

118
00:10:16,600 --> 00:10:20,620
انظري، بريندا المسكينة خائفة

119
00:10:20,620 --> 00:10:22,340
لا عليكِ يا بريندا

120
00:10:22,880 --> 00:10:25,250
ليس عليكِ قول شيء

121
00:10:26,000 --> 00:10:28,490
كما رأيت يا نيل

122
00:10:28,490 --> 00:10:30,980
رأيت طبيعة كونستانس

123
00:10:30,980 --> 00:10:35,340
عليك الاعتراض على خطوبتك حالاً

124
00:10:35,750 --> 00:10:38,440
ارتكبتْ جريمة

125
00:10:38,440 --> 00:10:42,850
سيفقد النّاسُ الثّقة بشركة برونسون إذا تزوّجتها

126
00:10:42,850 --> 00:10:46,230
لكن لا دليل على أنّها سرقته

127
00:10:46,610 --> 00:10:47,960
دليل؟

128
00:10:49,240 --> 00:10:53,760
!حسناً، الجميع هنا شاهدون

129
00:10:54,090 --> 00:10:59,320
لديّ فكرة. الفيكونت هامسورث رجل دِين

130
00:10:59,320 --> 00:11:02,760
يمكنكِ تقديم اعتراضكِ له الآن

131
00:11:02,760 --> 00:11:05,340
!أنتِ مُخطئة! مُحال أن أسرق

132
00:11:05,340 --> 00:11:07,250
كُن صادقاً"؟"

133
00:11:08,110 --> 00:11:10,640
هذا ينتهك صدق عائلة غريل بشكل صارخ

134
00:11:10,640 --> 00:11:13,270
لستِ سوى مُجرّد لصّة شائعة

135
00:11:13,270 --> 00:11:14,780
...أنتِ مُخطئة

136
00:11:29,990 --> 00:11:31,530
...لا

137
00:11:34,550 --> 00:11:38,590
!فلينقذني أحدٌ ما

138
00:11:39,340 --> 00:11:40,770
!النّجدة

139
00:11:41,530 --> 00:11:42,950
حسناً

140
00:11:46,580 --> 00:11:48,390
سأساعدكِ

141
00:11:50,280 --> 00:11:51,700
من أنتِ؟

142
00:11:52,840 --> 00:11:55,160
...لكن بالمقابل

143
00:12:03,630 --> 00:12:06,070
أتقولين لصّة؟

144
00:12:09,450 --> 00:12:11,080
...أتساءل حول ذلك

145
00:12:11,080 --> 00:12:14,550
مَن بيننا هو اللّصّ الحقيقيّ؟

146
00:12:19,420 --> 00:12:21,510
...كونستانس غريل

147
00:12:22,180 --> 00:12:26,280
إنّها تتظاهر بـ"صدقها" السّخيف هذا

148
00:12:26,280 --> 00:12:28,820
لم أتمكّن يوماً من تحمّلها

149
00:12:29,580 --> 00:12:33,270
ومع ذلك خُطِبت لنيل برونسون؟

150
00:12:34,020 --> 00:12:39,720
لماذا تتلقّى مُعاملة خاصّة بينما
مظهرها وثروة عائلتها

151
00:12:39,720 --> 00:12:42,280
!لا يُقارنان بمظهري وثروتي؟

152
00:12:42,640 --> 00:12:47,810
...لهذا قرّرتُ استخدام بريندا لسحقها! لذا كيف

153
00:12:48,520 --> 00:12:51,920
أنا، لصّة؟ ماذا تقصدين؟

154
00:12:51,920 --> 00:12:53,840
—لن أقبل بافتراء كهذ

155
00:12:53,080 --> 00:12:55,040
...حسناً، هل كنتِ تدركين

156
00:12:55,440 --> 00:13:02,290
بأنّني خُطبتُ للرّجل الّذي كنتِ
تُمارسين العلاقة معه بين الشُّجيرات

157
00:13:05,430 --> 00:13:07,790
!لـ... لم أفعل شيئاً كهذا

158
00:13:07,790 --> 00:13:09,920
!نيل وأنا قبّلنا بعضنا، لا أكثر

159
00:13:09,920 --> 00:13:11,170
!باميلا

160
00:13:12,690 --> 00:13:14,190
قبّلا بعضهما؟

161
00:13:14,190 --> 00:13:16,680
الإشاعات صحيحة إذاً

162
00:13:16,680 --> 00:13:19,610
ويحي، يبدو أنّه زلّ لساني

163
00:13:19,610 --> 00:13:23,070
...كنتُما تُقبّلان بعضكما فقط

164
00:13:23,950 --> 00:13:26,330
أنتِ وخطيب امرأة أُخرى

165
00:13:26,700 --> 00:13:30,200
لا أعلم من هو السّارق هنا

166
00:13:31,520 --> 00:13:36,200
هذا لا يُغيّر من حقيقة أنّكِ
!سرقتِ دبُّوس شعر بريندا

167
00:13:36,620 --> 00:13:37,880
حسناً

168
00:13:39,460 --> 00:13:41,330
أنت، هناك

169
00:13:41,580 --> 00:13:45,020
أمهلوني لحظة. اسمحوا لي
بالنّبش في ذاكرتي

170
00:13:45,550 --> 00:13:47,590
أجل. واين

171
00:13:48,040 --> 00:13:49,830
واين هاستينغز

172
00:13:50,160 --> 00:13:52,470
رأيتنا، أليس كذلك؟

173
00:13:52,810 --> 00:13:54,840
...أنا... أنا لا

174
00:13:54,840 --> 00:13:58,340
إن كنت لا تُفضّل التكلُّم، فليكن

175
00:13:58,340 --> 00:14:00,320
لكن ابقَ يقظاً

176
00:14:00,320 --> 00:14:03,840
آخرون كُثُر يعرفون الحقيقة مثلما تعرفها

177
00:14:03,840 --> 00:14:07,990
وأتّفق بأنّني أملك ذاكرة ممتازة

178
00:14:08,360 --> 00:14:10,360
،الفيكونتيسة ستان

179
00:14:10,360 --> 00:14:12,360
،والآنسة بلوي

180
00:14:12,360 --> 00:14:15,300
والفارس بيلهام جميعهم كانوا هناك

181
00:14:15,680 --> 00:14:16,870
...بالإضافة إلى ذلك

182
00:14:17,680 --> 00:14:23,120
أنتِ يا ذات الفستان اللّيمونيّ، رغم أنّه يبدو
أنّ هذه الفتاة لا تعرف اسمك

183
00:14:24,100 --> 00:14:28,260
جميعكم أنتم الأربعة كنتم تنظرون
إلينا في نفس الوقت، أليس كذلك؟

184
00:14:29,970 --> 00:14:31,750
لا يهمّ، سيّداتي سادتي

185
00:14:32,120 --> 00:14:35,290
ليس عليكم قول كلمة

186
00:14:35,290 --> 00:14:39,140
،لكن في حين أنّني أكره الالتباس المُحرِج

187
00:14:39,480 --> 00:14:42,020
سأسألك من جديد

188
00:14:42,450 --> 00:14:46,520
واين هاستينغز! كُفّ عن التّحديق
بحذائك وانظر إليّ

189
00:14:48,880 --> 00:14:50,770
هكذا أفضل

190
00:14:50,770 --> 00:14:53,980
والآن يا واين، أعطِني رأيك

191
00:14:54,280 --> 00:15:00,540
على سبيل المثال، هل من الصّواب إلباس شخص
بريء  تهمة جريمة لم يرتكبها؟

192
00:15:00,930 --> 00:15:05,660
ماذا عن أولئك الّذين يعرفون الحقيقة لكن
اختاروا البقاء صامتين حفاظاً على أنفسهم؟

193
00:15:06,470 --> 00:15:09,170
سأخبرك بما أعتقده

194
00:15:09,420 --> 00:15:12,420
،أيّ شخص يفعل شيئاً كهذا سيقود إلى الجحيم

195
00:15:12,420 --> 00:15:15,680
وأولئك الّذين يتجاهلون الأمر
مُذنِبون بنفس القدر

196
00:15:17,250 --> 00:15:20,650
والآن يا واين، أريدك أن تتخيّل شيئاً

197
00:15:20,650 --> 00:15:23,840
،إذا ما سُلِّط الضّوء على الحقيقة

198
00:15:23,840 --> 00:15:29,010
فإلى أين سيؤدّي بك ذلك، وماذا
سيقول النّاس عنك؟

199
00:15:31,450 --> 00:15:32,940
انظر إليّ

200
00:15:33,920 --> 00:15:37,630
لن أسمح لك بإشاحة نظرك عنّي

201
00:15:39,010 --> 00:15:40,930
لقد... رأيت

202
00:15:41,900 --> 00:15:45,700
رأيتُ ذلك. الآنسة غريل لم تسرق شيئاً

203
00:15:45,700 --> 00:15:49,110
كلّ ما فعلته كان ترتيب شعر بريندا

204
00:15:50,490 --> 00:15:55,210
وطلبتْ منها بريندا الإمساك
!بزينة الشّعر تلك

205
00:15:55,210 --> 00:15:57,710
!سـ... سمعتُ ذلك أيضاً

206
00:15:58,730 --> 00:16:00,550
رأيتهما أيضاً

207
00:16:00,550 --> 00:16:01,370
وكذلك أنا

208
00:16:01,370 --> 00:16:02,970
!حدثَ ما قالته فحسب

209
00:16:04,370 --> 00:16:06,430
هل هذا صحيح يا باميلا؟

210
00:16:07,230 --> 00:16:10,290
!نيل! لـ-لا

211
00:16:10,290 --> 00:16:11,850
—أقصد، بريندا

212
00:16:12,140 --> 00:16:13,340
!بالطّبع

213
00:16:14,310 --> 00:16:16,360
!بريندا كذبت عليّ

214
00:16:16,640 --> 00:16:21,120
انظري، بريندا المسكينة خائفة

215
00:16:22,840 --> 00:16:25,160
لا عليكِ يا بريندا

216
00:16:25,160 --> 00:16:27,050
ليس عليكِ قول كلمة

217
00:16:33,940 --> 00:16:34,890
!عجباً

218
00:16:35,340 --> 00:16:38,130
ما كلّ هذه الضجّة؟

219
00:16:39,710 --> 00:16:42,650
بئساً! إنّه الجشع حديث النّعمة

220
00:16:42,890 --> 00:16:44,890
...مولايّ، في الواقع

221
00:16:45,150 --> 00:16:47,640
أجل، فهمت

222
00:16:47,920 --> 00:16:50,790
مررتِ بأُمسية مُؤسفة يا آنسة غريل

223
00:16:50,790 --> 00:16:52,520
أجل، مُخيفة

224
00:16:52,920 --> 00:16:56,970
أتمنّى اللّجوء للإلَهات أمام
سوء مُعاملة كهذا

225
00:16:56,970 --> 00:16:59,030
هل أكون مُزعجة إذا طلبتُ مُساعدتك؟

226
00:16:59,030 --> 00:17:03,290
تقصدين في الاعتراض على خطوبتكِ؟

227
00:17:03,560 --> 00:17:05,760
هل سيُقبَل؟

228
00:17:05,760 --> 00:17:10,470
إطلاقاً مع الأسف، بما أنّ خطوبتكِ
قد أُعلِنَتْ أمام النّاس رسميّاً

229
00:17:10,470 --> 00:17:13,880
،يحقُّ للطّرف الآخر التكلُّم
—...لذا المكان المُناسب سيكون

230
00:17:13,880 --> 00:17:16,550
هذا ليس من شأنك

231
00:17:20,150 --> 00:17:24,310
،اعفني من مُجادلتك وافسخ خطوبتي

232
00:17:24,310 --> 00:17:26,060
أيّها الأحمق المُرتبك

233
00:17:27,810 --> 00:17:29,810
...وإلّا

234
00:17:29,810 --> 00:17:36,360
سأفعل ما يلزم لضمان سماع جلالة الملك

235
00:17:36,360 --> 00:17:42,330
،بأنّ اللّيلة في ميريليان العظيم
أقام دومينيك هامسورث حفلة

236
00:17:42,330 --> 00:17:47,830
حيث يتصرّف زوجان بشكل فاضح
في الحدائق الملكيّة السّامية

237
00:17:48,600 --> 00:17:51,430
مـ-من هذه المرأة؟

238
00:17:51,430 --> 00:17:55,080
إنّها مُختلفة عن الكونستانس غريل الّتي أعرفها

239
00:18:00,140 --> 00:18:02,610
،سيّداتي وسادتي

240
00:18:03,200 --> 00:18:08,600
أعتذر بصدق لأنّني أفسدتُ
هذه المُناسبة المُبهرة

241
00:18:09,220 --> 00:18:13,780
آمل أن تُباركوا لهذا الثّنائي الّذي
يشتعل بحُبّ مُحرّم

242
00:18:15,000 --> 00:18:18,080
...والآن، إن عذرتموني جميعاً

243
00:18:22,370 --> 00:18:24,620
!انتظري لحظة رجاء

244
00:18:31,170 --> 00:18:35,200
قدّمتُ أفضل تمنّياتي للآنسة غريل

245
00:18:35,200 --> 00:18:39,890
لذا وجدتُ أنّ تصرّفاتكِ الغريبة مُستفزّة

246
00:18:42,300 --> 00:18:43,880
هل كنتِ تعلمين؟

247
00:18:44,190 --> 00:18:48,890
في المكان الّذي أتيتُ منه، يجعلون
...اللّصوص يرتدون أحذية ساخنة جدّاً

248
00:18:50,200 --> 00:18:52,660
ويرقصون حتّى الموت

249
00:18:57,300 --> 00:18:59,650
لقد بدأت

250
00:18:59,650 --> 00:19:01,160
الحالة الأولى منذ عشر سنين

251
00:19:01,160 --> 00:19:04,740
أتساءل إلى متى سيصمد أولئك الأطفال

252
00:19:04,740 --> 00:19:07,920
ناهيك عن أنّ كونستانس صدمَتْني

253
00:19:08,170 --> 00:19:09,910
...أكاد لا أُصدّق

254
00:19:09,910 --> 00:19:15,420
بأنّ سكارليت كاستيل عادت من الجحيم

255
00:19:22,880 --> 00:19:24,210
حلم؟

256
00:19:24,920 --> 00:19:26,380
!كان مُجرّد حلم

257
00:19:29,390 --> 00:19:32,890
استيقظتِ أخيراً يا كونستانس غريل

258
00:19:37,390 --> 00:19:40,360
ما-ما-ما الّذي يجري؟

259
00:19:40,360 --> 00:19:44,400
ماذا تقصدين؟ هل ما زلتِ نصف نائمة؟

260
00:19:45,000 --> 00:19:49,530
المعذرة... بِما يمكنني أن أنادي حضرتكِ؟

261
00:19:51,770 --> 00:19:55,030
اسمي سكارليت كاستيل

262
00:20:00,500 --> 00:20:02,910
لحظة، لحظة، لحظة. لا بُدّ أنّكِ تمزحين

263
00:20:02,910 --> 00:20:06,050
سكارليت كاستيل قد أُعدِمت قبل عشر سنوات

264
00:20:06,050 --> 00:20:07,310
تمهّلي

265
00:20:08,190 --> 00:20:09,550
...هل يُعقَل

266
00:20:10,030 --> 00:20:13,000
أنّني أبدو حيّة في نظركِ؟

267
00:20:14,400 --> 00:20:16,940
...لـ-لكن

268
00:20:17,990 --> 00:20:21,580
كانت سكارليت كاستيل أكثر امرأة
شروراً في عصرها

269
00:20:22,160 --> 00:20:26,330
وحتّى أنّها خطّطت لتسميم الآنسة
سيسيليا، مُنافستها في الحُبّ

270
00:20:27,030 --> 00:20:31,560
ووليّ العهد إنريكي خلع قناعها
في ميريليان العظيم

271
00:20:31,560 --> 00:20:33,820
وفسخ خطوبتهما

272
00:20:34,090 --> 00:20:38,430
لكنّها تصرّفتْ بصورة فظيعة لدرجة
أنّه حُكِم عليها بالإعدام كذلك

273
00:20:40,030 --> 00:20:42,460
يا لها من طريقة لتلخيص الأمر

274
00:20:43,040 --> 00:20:47,460
،لا أتذكّر شيئاً عن يوم إعدامي

275
00:20:48,330 --> 00:20:50,850
،لكن ميريليان العظيم، حيث التقينا في الأمس

276
00:20:51,320 --> 00:20:56,610
هو حيث أذلّني بليد العقل إنريكي
والماكرة سيسيليا

277
00:20:57,740 --> 00:21:00,210
حتّى الآن، مُجرّد التّفكير في الأمر مُثير للغيظ

278
00:21:00,990 --> 00:21:04,740
كـ-كيف أمكنكِ الحديث عن الأمير هكذا؟

279
00:21:04,740 --> 00:21:07,240
أو نعت الأميرة بـ"الماكرة"؟

280
00:21:07,680 --> 00:21:11,110
على أيّ حال، سرعان ما وجدتُ نفسي هنا

281
00:21:11,110 --> 00:21:14,120
لكن كنتُ مهما حاولت، لم أستطع دخول القاعة

282
00:21:15,040 --> 00:21:19,370
لا بُدّ أنّني تمكّنتُ من ذلك أخيراً بفضلكِ

283
00:21:19,690 --> 00:21:24,390
كنتِ أوّل شخص يُلاحظني

284
00:21:27,710 --> 00:21:32,390
تبدين بسيطة وبليدة وغير مُلفتة عموماً

285
00:21:32,390 --> 00:21:37,370
لكن يمكنكِ أن تعتزّي بحقيقة أنّكِ
!تستطيعين رؤيتي على الأقلّ

286
00:21:37,370 --> 00:21:39,950
هذا قاسٍ قليلاً

287
00:21:40,230 --> 00:21:42,980
رغم ذلك، ماذا تفعلين في منزلي؟

288
00:21:42,980 --> 00:21:46,150
لأنّني لم أتلقّ مُستحقّاتي بعد

289
00:21:46,780 --> 00:21:48,040
مُستحقّاتكِ؟

290
00:21:48,750 --> 00:21:50,780
هل نسيتِ؟

291
00:21:50,780 --> 00:21:54,400
من المُؤكّد أنّكِ لم تعتقدي بأنّني سأُساعد
شخصاً غريباً تماماً بلا مُقابل

292
00:21:56,460 --> 00:21:57,690
حسناً

293
00:21:57,690 --> 00:21:59,040
سأُساعدكِ

294
00:21:59,350 --> 00:22:01,250
...لكن في المُقابل

295
00:22:02,160 --> 00:22:04,800
أصغي جيّداً يا كونستانس غريل

296
00:22:06,840 --> 00:22:12,770
ستقضين بقيّة حياتكِ تحرصين على أن أنتقم

297
00:22:14,310 --> 00:22:16,980
تـ... تنتقمين؟