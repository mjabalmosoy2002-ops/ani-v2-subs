1
00:00:01,130 --> 00:00:03,160
اختفت سكارليت

2
00:00:04,090 --> 00:00:07,390
مضى يومان منذ رأيتُ فخامته

3
00:00:08,790 --> 00:00:13,020
،ظننتُها رحلتْ لأنّها أُرهِقَتْ آنذاك

4
00:00:14,190 --> 00:00:15,810
لكن أنا متأكّدة بأنّني كنتُ مُخطئة

5
00:00:17,070 --> 00:00:22,020
هل "سئمتْ" منّي كما يقولون؟

6
00:00:23,150 --> 00:00:25,650
كونستانس غريل. لديكِ زائر

7
00:00:27,970 --> 00:00:30,210
أيّتها الفتاة الجاحدة

8
00:00:31,670 --> 00:00:33,720
فكّري فيما عرّضتِني له

9
00:00:34,040 --> 00:00:38,110
ذات يوم، وبشكل مُفاجئ، سمعتُ
بأنّ ابنتي قد تمّ اعتقالها

10
00:00:38,110 --> 00:00:42,550
لذا عدتُ مُسرعاً إلى العاصمة
لأجد بأنّه حُكِم عليها بالإعدام

11
00:00:42,550 --> 00:00:44,600
أنا... آسفة

12
00:00:46,470 --> 00:00:48,780
ما الّذي يجري بالضّبط؟

13
00:00:50,010 --> 00:00:51,240
...أبي

14
00:00:53,650 --> 00:00:56,610
تبرّأ منّي أرجوك

15
00:00:58,970 --> 00:01:02,690
فكّر في اللّوم الّذي سيقع على عائلتنا بسببي

16
00:01:02,690 --> 00:01:05,410
لا أعرف الكثير بشأن خديعة القصر

17
00:01:06,260 --> 00:01:10,510
ولا أعرف ما الّذي يجري في هذا البلد أيضاً

18
00:01:10,510 --> 00:01:11,630
...لكن

19
00:01:12,050 --> 00:01:16,430
أظنّني أستطيع على الأقلّ اتّخاذ
موقف لحماية ابنتي

20
00:01:16,880 --> 00:01:19,380
!لكن فكّر في المخاطر

21
00:01:19,380 --> 00:01:21,500
اسمعي يا كونستانس

22
00:01:21,500 --> 00:01:26,440
لا شيء يُلهمنا كما الآخرين، مهما كانت الحقبة

23
00:01:27,980 --> 00:01:31,100
لدينا سُبُلنا الخاصّة في القيام بالأمور

24
00:01:32,360 --> 00:01:35,520
"كوني صادقة"

25
00:01:38,450 --> 00:01:41,020
يسرّني أن أراكِ بحالة جيّدة

26
00:01:48,000 --> 00:01:49,280
تفضّل

27
00:01:49,280 --> 00:01:50,370
!شكراً

28
00:01:55,330 --> 00:01:58,260
ماذا تريدين منّي يا شوشانا؟

29
00:01:58,840 --> 00:02:00,920
غيّري الشّخص المُراقِب

30
00:02:00,920 --> 00:02:01,880
لماذا؟

31
00:02:02,600 --> 00:02:03,990
أصبح عنيفاً

32
00:02:07,410 --> 00:02:11,310
من يعلم ماذا سيفعل إذا وقف أحدٌ في وجهه؟

33
00:02:14,300 --> 00:02:16,020
فليكُن

34
00:02:31,740 --> 00:02:33,420
كيريكي كيريكوكو

35
00:02:33,420 --> 00:02:35,620
تـ-تواري عن الأنظار وابقي هادئة

36
00:02:36,040 --> 00:02:37,780
انسحب بلطف

37
00:02:42,180 --> 00:02:45,390
ماذا تريدين منّا؟

38
00:02:45,660 --> 00:02:49,350
أتيتُ لأحذّركِ أيّتها الآنسة الصّغيرة الشُّجاعة

39
00:02:50,030 --> 00:02:53,280
ما لم تريدي الموت، تجنّبي المتاعب

40
00:02:54,090 --> 00:02:56,030
أنتِ لطيفة جدّاً

41
00:02:56,030 --> 00:02:57,020
لطيفة؟

42
00:02:57,460 --> 00:03:00,500
أجل. أنتِ وشوشانا

43
00:03:01,490 --> 00:03:04,660
سأقتلكِ إذا أُمِرتُ بفعل ذلك

44
00:03:04,660 --> 00:03:08,250
أعلم. ولهذا السّبب أتيتِ، أليس كذلك؟

45
00:03:08,250 --> 00:03:10,720
للحرص على ألّا تتلقّي ذلك الأمر

46
00:03:11,450 --> 00:03:13,740
للحرص على ألّا أُقتَل

47
00:03:25,020 --> 00:03:27,050
!لا أُصدّق ذلك

48
00:03:27,050 --> 00:03:30,290
!كونّي تختطف أمير فاريس؟

49
00:03:30,800 --> 00:03:33,810
!والآن ستُعدَم علناً؟

50
00:03:34,100 --> 00:03:36,010
أخبريني يا ميليني

51
00:03:36,010 --> 00:03:41,190
ألم يُلغَ الإعدام العلنيّ بعد سكارليت كاستيل؟

52
00:03:41,640 --> 00:03:43,790
هل تعرفين السّبب؟

53
00:03:43,790 --> 00:03:47,790
أجل. أعتقد بأنّ مجموعة من المواطنين قد احتجّتْ

54
00:03:47,790 --> 00:03:49,960
رابطة البنفسج حسبما أعتقد

55
00:03:50,280 --> 00:03:52,020
رابطة البنفسج؟

56
00:03:52,020 --> 00:03:53,460
شكراً لكِ يا ميليني

57
00:03:53,460 --> 00:03:55,530
ماذا؟ إلى أين أنتِ ذاهبة؟

58
00:03:55,530 --> 00:03:58,460
لإنقاذ كونّي بالطّبع

59
00:03:58,810 --> 00:04:02,370
لا يمكنكِ أن تتوقّعي منّي الجلوس
مكتوفة اليدين أبكي

60
00:04:02,710 --> 00:04:05,630
!لذا يجب عليّ التحرُّك

61
00:04:05,970 --> 00:04:09,330
ماذا؟ يا له من سلوك مُثير للإعجاب

62
00:04:22,100 --> 00:04:24,680
اعفِني من تصنّعك

63
00:04:25,600 --> 00:04:28,890
كنتَ قادراً على رؤيتي منذ
البداية، أليس كذلك؟

64
00:04:29,250 --> 00:04:36,090
لا أشكّ في أنّك أدركت بوجودي
منذ التقينا في ميريليان العظيم

65
00:04:37,070 --> 00:04:43,270
وإلّا ما كنتَ لتهمّ نفسك بخطوبة ابنة فيكونت

66
00:04:44,080 --> 00:04:47,750
لديّ ذاكرة ممتازة

67
00:04:48,400 --> 00:04:51,020
!كم هذا مُفطِر للقلب

68
00:04:51,330 --> 00:04:56,380
هل يمكن لخادمكِ المُتواضع أن
يساعدكِ بأيّ وسيلة؟

69
00:04:56,380 --> 00:04:58,540
أنت كريه. اغرب عن وجهي

70
00:04:59,510 --> 00:05:01,660
!يا للخسارة

71
00:05:01,660 --> 00:05:05,380
إذا غيّرتِ رأيكِ، فتواصلي مع خادمكِ
المُتواضع رجاء

72
00:05:05,380 --> 00:05:07,770
أجل. إذا غيّرتُ رأيي

73
00:05:09,110 --> 00:05:13,060
استغرق ذلك عشر سنوات، لكن
غيّرتُ رأيي أخيراً

74
00:05:13,540 --> 00:05:14,580
...لذا

75
00:05:15,390 --> 00:05:17,820
مُدّني بيد العون

76
00:05:18,650 --> 00:05:20,050
،في هذه الحالة

77
00:05:21,570 --> 00:05:25,530
بما يستطيع هذا الخنزير الّذي
لا قيمة له خدمتكِ؟

78
00:05:26,280 --> 00:05:28,000
صيد الجرذان

79
00:05:32,150 --> 00:05:33,740
،سموّك الأمير ثيوفيليس

80
00:05:34,330 --> 00:05:36,890
جاء كيندال ليفاين من السّلك الدّبلوماسيّ

81
00:05:37,780 --> 00:05:43,330
ماذا؟ ظننتُه غادر في مهمّة إلى أديلبايد

82
00:05:43,330 --> 00:05:44,200
،بخصوص ذلك

83
00:05:44,610 --> 00:05:46,720
يزعم بأنّ هناك تطوّر طارئ

84
00:05:47,190 --> 00:05:48,270
حقّاً؟

85
00:05:48,270 --> 00:05:49,220
دعه يدخل

86
00:05:52,140 --> 00:05:53,820
مضى وقتٌ طويل يا كيندال

87
00:05:54,430 --> 00:05:56,470
ما الّذي جرى بالضّبط؟

88
00:05:56,920 --> 00:05:58,650
،مع فائق الاحترام

89
00:05:58,650 --> 00:06:04,660
لم يُختطَف الأمير أوليشيز بواسطة
،أديلبايد، بل بواسطة دايغ غالّوس

90
00:06:04,960 --> 00:06:10,920
والأمير الثّاني روديريك مُتواطئ معهم

91
00:06:10,920 --> 00:06:12,140
ماذا؟

92
00:06:12,140 --> 00:06:15,680
قيل لي بأنّ كلّ عضو من أعضاء دايغ غالّوس

93
00:06:15,680 --> 00:06:18,380
يضع وشماً للشّمس في مكانٍ ما في جسده

94
00:06:18,380 --> 00:06:19,580
وشم؟

95
00:06:25,820 --> 00:06:27,450
!لم أشتبه بروديريك يوماً

96
00:06:27,880 --> 00:06:31,800
ما الّذي فعلته بالضّبط للحصول
على هذه المعلومات؟

97
00:06:31,800 --> 00:06:36,090
من الأميرة الثّالثة أليكساندرا

98
00:06:38,110 --> 00:06:39,540
،في مسار الأحداث العاديّ

99
00:06:39,540 --> 00:06:44,390
كان من المُقرّر أن أتلقّى صدَقة من
الأمير إنريكي في المُستقبل القريب

100
00:06:44,790 --> 00:06:46,060
صدَقة؟

101
00:06:46,540 --> 00:06:50,760
،بالفعل. لتسهيل نشر كلام الرّبّ

102
00:06:50,760 --> 00:06:57,070
نطلب "مُساهمات" من المُؤمنين
الأيسر حالاً من المُصلّين

103
00:06:57,560 --> 00:07:00,920
أشكّ في أن يفعل أخي شيئاً كهذا

104
00:07:00,920 --> 00:07:02,810
لا بُدّ أنّك مُخطئ

105
00:07:03,810 --> 00:07:07,730
فهمت. إذاً عذراً على الإزعاج

106
00:07:09,180 --> 00:07:10,570
...بالمناسبة

107
00:07:10,570 --> 00:07:12,000
ما الأمر؟

108
00:07:12,000 --> 00:07:17,080
هل احتجت مُساعدة إلهيّة بحدّ
ذاتك، سموّك؟

109
00:07:17,630 --> 00:07:18,960
...في الواقع، أنا

110
00:07:25,800 --> 00:07:27,240
أستميحك عذراً

111
00:07:27,860 --> 00:07:29,870
هل أُقاطعكما؟

112
00:07:29,870 --> 00:07:32,710
لا. كان الفيكونت على وشك المُغادرة

113
00:07:32,710 --> 00:07:34,850
وأنت...؟

114
00:07:35,730 --> 00:07:37,230
روفوس ماي

115
00:07:37,230 --> 00:07:41,390
تمّ تعييني مُؤخّراً مُساعد مُدقّق الخزينة

116
00:07:41,390 --> 00:07:44,490
!إذاً أنت الرّجل الّذي سمعتُ عنه

117
00:07:44,490 --> 00:07:48,400
هل سبقَ وزرت كنيستي؟

118
00:07:48,660 --> 00:07:53,010
يؤسفني أنّني لم أفعل، باعتباري ما زلتُ
جديداً في منصبي. لكن يوماً ما

119
00:07:53,010 --> 00:07:55,400
سيكون من دواعي سرورنا حضورك

120
00:08:01,190 --> 00:08:03,660
سامحني. كهرباء ساكنة على ما أعتقد

121
00:08:04,290 --> 00:08:07,780
هذا، أو نزوة الإلَهات

122
00:08:09,740 --> 00:08:12,220
ألا تشعر بألم؟

123
00:08:12,660 --> 00:08:13,860
بكلّ تأكيد

124
00:08:13,860 --> 00:08:19,180
كلّ ما في الأمر هو أنّ أيّ ألم
تُسبّبينه هو أعظم بهجة لي

125
00:08:20,340 --> 00:08:24,350
والآن، هل لفت نظركِ أيّ شيء؟

126
00:08:24,350 --> 00:08:29,440
،ذلك الرّجل الّذي يرتدي القفّازات
وظلّ يرتديها بعد مُصافحتك

127
00:08:32,490 --> 00:08:36,310
يوجد وشم شمس في مِعصمه

128
00:08:37,330 --> 00:08:42,600
روفوس ماي جاسوس. اكشف
عن ماضيه حالاً

129
00:08:43,340 --> 00:08:45,920
أُمنية مولاتي هو أمرٌ لي

130
00:08:46,390 --> 00:08:48,670
...حسناً إذاً، أستطيع فعل كلّ هذا بأمان

131
00:08:49,860 --> 00:08:53,410
دائماً ما أشعر بالنُّعاس بعد استخدام تلك القوّة

132
00:08:53,410 --> 00:08:56,510
أظنّني أشعر بتحسّن الآن بعد
أن أبقيتُها ضعيفة قبل قليل

133
00:08:56,760 --> 00:08:58,120
هكذا إذاً

134
00:08:58,120 --> 00:09:02,510
إنّ التسبُّب بمثل هذه الظّاهرة
يستهلك مقداراً كبيراً من الطّاقة

135
00:09:02,970 --> 00:09:06,020
وما أدراك بذلك؟

136
00:09:06,300 --> 00:09:09,850
بالرّغم من كلّ مساوئي، أتمتّع
بإحسان الإلَهات

137
00:09:10,640 --> 00:09:15,950
بالمناسبة، هل الانتقام هو سبب
بقائك في هذا العالم؟

138
00:09:16,570 --> 00:09:18,220
بالطّبع هو كذلك

139
00:09:18,940 --> 00:09:21,120
حتّى الآن؟

140
00:09:21,120 --> 00:09:22,460
ما الّذي ترمي إليه؟

141
00:09:23,030 --> 00:09:28,790
هنا والآن، ما يدفعكِ هو الانتقام؟

142
00:09:28,790 --> 00:09:30,550
...أم

143
00:09:30,550 --> 00:09:33,770
هل تسعين لإنقاذ كونستانس غريل؟

144
00:09:35,370 --> 00:09:37,800
الانتقام بالطّبع

145
00:09:37,800 --> 00:09:39,580
أحقّاً ذلك؟

146
00:09:39,580 --> 00:09:43,550
،أؤمن بأنّه من أجل البقاء في عالم الأحياء

147
00:09:43,550 --> 00:09:48,570
فيجب للرُّوح الّتي بلا جسد أن تمتلك
عاطفة جيّاشة أو هدفاً كبيراً

148
00:09:48,900 --> 00:09:53,840
لذا لا أشكّ في أنّكِ حالما تشعرين
،بأنّ انتقامكِ قد تمّ

149
00:09:55,050 --> 00:09:58,210
ستعودين إلى صفّ الآلهة

150
00:10:06,060 --> 00:10:09,700
!من فضلكم وقّعوا عريضتنا ضدّ هذا الإعدام

151
00:10:10,240 --> 00:10:12,870
!كونستانس غريل بريئة

152
00:10:14,040 --> 00:10:15,090
من فضلك

153
00:10:15,730 --> 00:10:18,350
أتوسّل إليك. مُدّ لنا يد العون

154
00:10:20,440 --> 00:10:24,590
ساعدونا أرجوكم! لا يمكننا إنقاذ
صديقتي كونستانس غريل

155
00:10:24,940 --> 00:10:29,100
!دون مُساعدة من الصّالحين هنا

156
00:10:30,450 --> 00:10:32,110
ما معنى هذا؟

157
00:10:32,370 --> 00:10:36,120
أصدرتُ أوامرَ صارمة بإبقاء أي عريضة
،خارج القصر

158
00:10:36,120 --> 00:10:40,250
وليسوا عوام النّاس مَن وقّعوا على هذا
فحسب. بل يعمل الأرستقراطيّون على ذلك أيضاً

159
00:10:41,700 --> 00:10:43,510
...ثمّ أرى هذا الكتاب

160
00:10:44,250 --> 00:10:49,580
يزعم بأنّه من تأليف مُؤلّف أجنبيّ
واعد. آدم هيكس؟

161
00:10:51,430 --> 00:10:53,600
!من الواضح أنّها آميليا هوبيس

162
00:10:53,600 --> 00:10:56,530
،ابنة فيكونت، والمعروفة كقدّيسة

163
00:10:56,530 --> 00:10:59,840
تقفز فوق فجوة المكانة للزواج من وليّ عهد

164
00:11:00,470 --> 00:11:04,230
لكن في حقيقة الأمر، إنّها عضوة
في مُنظّمة إجراميّة

165
00:11:05,220 --> 00:11:07,980
والّتي وُلِدت كيتيمة فقيرة

166
00:11:08,300 --> 00:11:11,050
أشعر وكأنّني سمعتُ بهذه الحبكة من قبل

167
00:11:14,290 --> 00:11:18,740
لِمَ يفعلون المستحيل لأجل تلك
الفتاة الصّغيرة البسيطة؟

168
00:11:18,740 --> 00:11:22,230
مهما قال الآخرون، سيتمّ إعدامها

169
00:11:22,550 --> 00:11:26,490
مع تلك الفتاة لوشيا الّتي
تبنّتها عائلة أوبرايان

170
00:11:27,980 --> 00:11:29,320
ما الأمر؟

171
00:11:29,320 --> 00:11:30,500
لا شيء

172
00:11:30,500 --> 00:11:33,180
يا له من وضع غير مُبهج

173
00:11:33,180 --> 00:11:37,020
وانظري إلى تلك الإشاعات السّخيفة
كيف تنتشر في غفلة عنّا

174
00:11:37,440 --> 00:11:38,470
أي إشاعات؟

175
00:11:39,010 --> 00:11:40,510
ألم تسمعي؟

176
00:11:40,910 --> 00:11:43,030
أقصد بشأن كونستانس غريل

177
00:11:44,400 --> 00:11:47,520
يُقال بأنّها تستطيع سماع أصوات الموتى

178
00:11:47,520 --> 00:11:52,000
وبأنّها تعمل على تبرئة اسم سكارليت كاستيل

179
00:11:56,820 --> 00:11:59,020
!وليّة العهد سيسيليا؟

180
00:12:00,000 --> 00:12:03,270
يُقال بأنّكِ تستطيعين التكلُّم مع الموتى

181
00:12:03,640 --> 00:12:05,310
...فـ-في الواقع

182
00:12:05,950 --> 00:12:07,110
كاذبة

183
00:12:07,950 --> 00:12:10,260
الموتى لا يتكلّمون

184
00:12:10,260 --> 00:12:14,160
لا أفكار لديهم. يصبحون رماداً فحسب

185
00:12:15,440 --> 00:12:16,910
هذا أمرٌ طبيعيّ

186
00:12:17,580 --> 00:12:20,360
على الأقلّ، هكذا كان الأمر بالنّسبة لي

187
00:12:21,590 --> 00:12:24,920
لم أكن أسمع أيّ صوت

188
00:12:27,430 --> 00:12:28,740
...صوت مَن

189
00:12:36,290 --> 00:12:37,690
!سيسي

190
00:12:37,690 --> 00:12:39,430
!أعيدي إليّ هذا

191
00:12:39,430 --> 00:12:41,550
ماذا؟ لِمَ ينبغي لي ذلك يا سيس؟

192
00:12:41,550 --> 00:12:43,820
!النّشل جريمة

193
00:12:43,820 --> 00:12:46,830
لن أدعكِ تعيشين حياة

194
00:12:46,830 --> 00:12:51,330
!لا يمكنكِ الاعتزاز بها وأنتِ تحت أنظاري

195
00:12:55,840 --> 00:12:57,570
!يا عمّ

196
00:13:00,080 --> 00:13:02,980
!فعلتها! هذه هي سيسي الّتي أعرفها

197
00:13:02,980 --> 00:13:05,470
!كفّي عن ذلك

198
00:13:06,380 --> 00:13:09,220
!سيسي، سيس! عدتُما

199
00:13:09,580 --> 00:13:12,200
في الواقع، يوجد شخص غريب أطوار هنا

200
00:13:12,200 --> 00:13:13,400
غريب أطوار؟

201
00:13:13,840 --> 00:13:17,220
!يقول بأنّه يبحث عن فتاة تُدعى سيسيليا

202
00:13:17,220 --> 00:13:20,350
من المؤكّد أنّه يهدر وقته، أليس كذلك يا سيس؟

203
00:13:24,870 --> 00:13:27,460
أنتِ. هل اسمكِ هو سيس؟

204
00:13:27,850 --> 00:13:30,940
إذاً اسمكِ الحقيقيّ هو سيسيليا؟

205
00:13:31,610 --> 00:13:33,400
أ-أجل

206
00:13:36,610 --> 00:13:38,090
...عيناكِ

207
00:13:39,220 --> 00:13:41,420
تبدوان ورديّتين تحت درجة كافية
من الضّوء على ما أعتقد

208
00:13:43,080 --> 00:13:46,170
أختاه، أودُّ التحدُّث مع هذه الفتاة

209
00:13:49,350 --> 00:13:56,140
قال بأنّ ابنة الحاكم وُلِدت ضعيفة
ولن تعيش لفترة طويلة

210
00:13:56,140 --> 00:14:00,340
لذا سألعب دور الآنسة سيسيليا

211
00:14:00,340 --> 00:14:02,090
ولماذا أنتِ؟

212
00:14:02,650 --> 00:14:06,940
قال بأنّ الحاكم كان قد أنجب
طفلة سرّيّة من عاهرة

213
00:14:06,940 --> 00:14:10,410
،وصادفَ بأنّ اسمها هو سيسيليا أيضاً

214
00:14:10,780 --> 00:14:14,700
ووضعوها في ميتَم بعد ولادتها مُباشرة

215
00:14:15,440 --> 00:14:18,270
أليس من المُمكن أن يُخطئ الفتاة؟

216
00:14:18,270 --> 00:14:20,350
—أقصد بأنّ هذا الوصف

217
00:14:20,350 --> 00:14:24,410
لا أعتقد بأنّه يكترث فيما إذا
كنتُ الحقيقيّة أم لا

218
00:14:24,780 --> 00:14:27,480
صادفَ بأنّني مُناسبة للمُؤهّلات فحسب

219
00:14:27,480 --> 00:14:29,700
...لكن هذا لا يعني بأنّ عليكِ أن

220
00:14:29,700 --> 00:14:33,770
يقول بأنّ الحاكم سيتبرّع للميتم

221
00:14:35,180 --> 00:14:36,860
لذا ستكونون بخير

222
00:14:55,110 --> 00:14:56,830
!الماما ناتالي

223
00:14:56,830 --> 00:14:59,790
!ليا! بيتي! الجميع

224
00:15:01,850 --> 00:15:03,220
!تبّاً

225
00:15:03,590 --> 00:15:04,800
...سيسي

226
00:15:06,260 --> 00:15:07,460
!سيس؟

227
00:15:08,070 --> 00:15:10,850
!هذا مُطمئن! أنت على قيد الحياة

228
00:15:11,160 --> 00:15:12,850
!ماذا تفعلين هنا؟

229
00:15:13,280 --> 00:15:17,580
هذه غلطتي. يا لي من حمقاء

230
00:15:17,580 --> 00:15:18,950
!ماذا تقصدين؟

231
00:15:19,790 --> 00:15:25,350
لم يكن الحاكم لوزي سيسمح لأحد
يعلم بابنته البديلة بالبقاء حيّاً

232
00:15:25,350 --> 00:15:28,490
!ليتني أدركتُ ذلك قبلاً

233
00:15:28,490 --> 00:15:30,720
!هذه ليست غلطتكِ

234
00:15:32,120 --> 00:15:34,790
!هل يمكنكِ المشي؟ أين الجميع؟

235
00:15:34,790 --> 00:15:39,330
قتلوهم أجمعين. لم يبقَ غيرك على قيد الحياة

236
00:15:39,740 --> 00:15:42,440
!لدينا أحدٌ على قيد الحياة هنا

237
00:15:43,250 --> 00:15:44,980
سوف نهرب من الخلف

238
00:15:52,470 --> 00:15:53,430
!أين هما؟

239
00:15:53,430 --> 00:15:54,390
!سألحق بهما

240
00:16:07,620 --> 00:16:08,920
!سيس؟

241
00:16:10,470 --> 00:16:13,030
!اذهبي! اطلبي المُساعدة

242
00:16:13,030 --> 00:16:15,190
!عمّاذا تتكلّمين؟! تعالي معي

243
00:16:15,190 --> 00:16:19,000
!لن يتوقّفوا عن مُطاردتك الآن بعد أن رأوك

244
00:16:19,790 --> 00:16:22,040
!سأكون بخير

245
00:16:22,040 --> 00:16:22,910
!سيس

246
00:16:23,420 --> 00:16:24,490
!هيّا

247
00:16:38,180 --> 00:16:43,270
،كلّ ما بذلتُه من جهد لإيجاد تلك البيدق
...فتنكسر بتلك السّهولة

248
00:16:44,370 --> 00:16:46,670
كان من المُفترض أن تكون في القصر

249
00:16:46,670 --> 00:16:49,690
ما كانوا ليبحثوا عنها في الميتم أبداً

250
00:16:50,610 --> 00:16:54,020
كلّ هذا لأنّ الفيكونت لوزي حاول
تولّي زمام الأمور من تلقاء نفسه

251
00:16:54,020 --> 00:16:56,680
نُبلاء من شاكلته جميعهم سواسية

252
00:16:58,450 --> 00:17:00,810
ما هذا؟ ناجٍ؟

253
00:17:02,570 --> 00:17:03,570
ما اسمك؟

254
00:17:04,290 --> 00:17:05,590
سيسي

255
00:17:08,690 --> 00:17:09,990
فتاة

256
00:17:11,510 --> 00:17:15,440
هذا يجعل "سيسي" لقب آخر لسيسيليا

257
00:17:16,640 --> 00:17:19,680
ولديك عينان ورديّتان مثاليّتان

258
00:17:20,480 --> 00:17:22,700
علامة عائلة لوزي

259
00:17:22,700 --> 00:17:25,610
فاتَني الأمر لأنّني ظننتُك فتى

260
00:17:26,940 --> 00:17:30,340
راودني شعور بأنّ تلك الفتاة
كانت تُخفي شيئاً

261
00:17:30,340 --> 00:17:33,610
الآن فهمتُ بأنّه كان أنت

262
00:17:34,610 --> 00:17:39,790
!ذهبتْ سيس مع ذلك الحاكم لحمايتي

263
00:17:40,600 --> 00:17:42,770
هل تكرهين الفيكونت لوزي؟

264
00:17:43,250 --> 00:17:44,130
،في هذه الحالة

265
00:17:44,770 --> 00:17:47,210
ما رأيك أن أساعدك في الانتقام؟

266
00:17:47,750 --> 00:17:50,420
انتقام...؟

267
00:17:51,500 --> 00:17:54,760
،إذا فعلتِ ما نُمليه عليكِ

268
00:17:55,100 --> 00:17:58,510
سندعكِ تجعلين ذلك الوضيع يُعاني
بشكل لن تُصدّقيه

269
00:18:00,320 --> 00:18:03,220
فقط افعلي ما يلهمكِ به قلبكِ

270
00:18:03,220 --> 00:18:05,990
ألا تكرهينه؟ ألا تريدين أن يدفع الثّمن؟

271
00:18:06,990 --> 00:18:09,760
مزّقيه إرباً فحسب

272
00:18:10,080 --> 00:18:11,720
وهذا البلد معه

273
00:18:14,970 --> 00:18:18,110
!فعلتِها! هذه هي سيسي الّتي أعرفها

274
00:18:17,480 --> 00:18:19,670
!يكفي

275
00:18:19,670 --> 00:18:22,530
هذه غلطتي. يا لي من حمقاء

276
00:18:21,930 --> 00:18:24,160
!هذه ليست غلطتك

277
00:18:27,910 --> 00:18:31,130
لذا سألعب دور الآنسة سيسيليا

278
00:18:37,960 --> 00:18:38,930
...لا أريد

279
00:18:40,180 --> 00:18:42,730
سماع صوت أحد بعد الآن

280
00:18:43,710 --> 00:18:46,670
بالمُناسبة. لقد قرّرت

281
00:18:48,160 --> 00:18:49,910
قرّرت ماذا؟

282
00:18:50,840 --> 00:18:55,200
أخبرتُكِ. عندما نقتل فتاة أوبرايان

283
00:18:56,050 --> 00:19:01,240
ارتأيتُ بأن نجعله يوم إعدام كونستانس غريل

284
00:19:01,870 --> 00:19:03,130
يوم ما بعد غد

285
00:19:03,930 --> 00:19:04,940
هكذا إذاً

286
00:19:07,210 --> 00:19:09,760
هل اكتشفت شيئاً بشأن روفوس؟

287
00:19:09,760 --> 00:19:15,900
يبدو أنّ روفوس الحقيقيّ تُوفّي
قبل عشر سنوات

288
00:19:16,250 --> 00:19:19,280
كان الابن الأصغر للنُّبلاء الأقلّ ثراء

289
00:19:19,280 --> 00:19:25,340
أتى إلى العاصمة عندما أدّى سلوكه
السيّئ إلى التبرُّؤ منه

290
00:19:25,340 --> 00:19:27,060
...قبل عشر سنوات

291
00:19:27,060 --> 00:19:30,860
فهمت. استبدلوه آنذاك إذاً

292
00:19:34,620 --> 00:19:38,350
ارتح قليلاً. أعلم بأنّك لم تنم

293
00:19:38,990 --> 00:19:40,520
أنا بخير

294
00:19:42,840 --> 00:19:45,630
بئساً. هل قاطعتُكما؟

295
00:19:46,110 --> 00:19:47,940
لا، لا مُشكلة

296
00:19:49,750 --> 00:19:55,500
كما أخبرتُكما، الأميرة أليكساندرا
من فاريس تُعارض الحرب

297
00:19:55,840 --> 00:19:59,830
ألا ترغبان في رؤيتها تتبوّأ العرش؟

298
00:20:00,250 --> 00:20:05,000
أميرتكم الثّالثة لا نسب لها
ولا دعم يستحقّ الذّكر

299
00:20:05,680 --> 00:20:08,650
بالإضافة إلى ذلك، أليست هي
سجينة في فاريس الآن؟

300
00:20:09,510 --> 00:20:12,860
لا أرى فُرصة لها في الفوز

301
00:20:13,270 --> 00:20:16,900
لكن ماذا لو حَظيَتْ بداعم كبير؟

302
00:20:17,460 --> 00:20:21,930
ماذا لو قال الملك إرنست بأنّه
،سوف يتفاوض مع ميلفينا

303
00:20:21,930 --> 00:20:23,950
بينما ذهبَ إلى فاريس فعلاً؟

304
00:20:24,650 --> 00:20:26,010
ماذا؟

305
00:20:26,010 --> 00:20:28,410
لكن لا يملك الملكُ سبباً للذّهاب إلى هناك

306
00:20:28,410 --> 00:20:32,540
يمكنه القول دوماً بأنّه يزور ملِك
فاريس زيارة مريض

307
00:20:33,030 --> 00:20:38,670
وكلّ ما يهمّ هو حقيقة أنّ الأميرة
الثّالثة المأسورة قد دعَتْه

308
00:20:39,200 --> 00:20:43,420
فهمت. الأنباء تنتشر من تلقاء نفسها

309
00:20:43,810 --> 00:20:47,060
أنباء تحالُف أدليبايد مع الأميرة الثّالثة

310
00:20:47,060 --> 00:20:50,640
تماماً. وبهذا الشّكل، ستحظى بدعم

311
00:20:51,300 --> 00:20:54,620
لكن أليست الأميرة الثّالثة محبوسة؟

312
00:20:54,620 --> 00:20:57,320
كيف ستستدعي الملك؟

313
00:20:57,890 --> 00:21:01,440
إلّا إن كانت... الأميرة في البرج شبيهة؟

314
00:21:03,190 --> 00:21:06,960
مهلاً! أتقصدين زعزعة البلد
!بأكمله بواسطة كذبة؟

315
00:21:06,960 --> 00:21:11,100
هذا يُثبت مدى خوف فاريس من بلدكم

316
00:21:14,590 --> 00:21:18,620
لماذا لم تعطِني وليّة العهد سيسيليا
أي إجابة على الإطلاق؟

317
00:21:19,780 --> 00:21:21,140
لديكِ زائر

318
00:21:24,210 --> 00:21:26,670
أهذه أنتِ يا بريندا؟

319
00:21:31,350 --> 00:21:34,540
ا-المعذرة... ما الّذي جاء بكِ إلى هنا؟

320
00:21:35,140 --> 00:21:36,210
انظري

321
00:21:37,130 --> 00:21:40,700
!كيت وميليني تعترضان على إعدامي؟

322
00:21:40,700 --> 00:21:43,370
لـ-ليستا الوحيدتين

323
00:21:43,370 --> 00:21:50,330
،والدكِ، وخطيبكِ السّابق نيل برونسون
والفيكونت هامسورث كلّهم يُساهمون

324
00:21:50,330 --> 00:21:53,050
وإيرل أولستير بالطّبع

325
00:21:53,050 --> 00:21:54,270
!فخامته

326
00:21:55,620 --> 00:21:58,930
أخبريني يا بريندا، متى سيتمّ إعدامي؟

327
00:22:00,380 --> 00:22:01,970
غداً، حسبما قالوا

328
00:22:02,900 --> 00:22:04,440
هكذا إذاً

329
00:22:06,020 --> 00:22:11,850
اسمعي، أنا... أُفكّر في اتّهام باميلا

330
00:22:13,050 --> 00:22:16,110
!سأشهد بكلّ ما فعلَتْه

331
00:22:17,060 --> 00:22:19,370
أعلم بأنّني تأخّرتُ قليلاً

332
00:22:19,860 --> 00:22:23,610
كنتُ... كنتُ أرغب في إخباركِ بشيء
طوال هذا الوقت

333
00:22:24,350 --> 00:22:28,260
شكراً لكِ على إنقاذي آنذاك

334
00:22:29,030 --> 00:22:32,250
—لم أكن أنا يا بريندا. كان

335
00:22:32,250 --> 00:22:34,370
لا، كنتِ أنتِ

336
00:22:34,920 --> 00:22:39,370
صدقكِ هو ما أنقذني

337
00:22:43,140 --> 00:22:44,620
لستُ وحيدة

338
00:22:45,490 --> 00:22:47,740
الجميع يُقاتلون لأجلي

339
00:22:48,880 --> 00:22:50,880
لن أستسلم أبداً

340
00:22:51,420 --> 00:22:52,520
...ففي نهاية المطاف

341
00:22:54,030 --> 00:22:57,780
أنا متأكّدة بأنّ هذا ما كانت سكارليت لتقوله