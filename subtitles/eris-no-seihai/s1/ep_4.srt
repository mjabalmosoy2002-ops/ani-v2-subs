1
00:00:01,220 --> 00:00:03,490
تمّ استدعاؤك بواسطة اللّجنة الاستقصائيّة؟

2
00:00:03,490 --> 00:00:04,900
أجل

3
00:00:04,900 --> 00:00:06,980
ديبورا داركيان، صحيح؟

4
00:00:06,980 --> 00:00:12,540
أستدعيك إلى غرفة ضوء النّجوم
في ميريليان العظيم للتّحقيق

5
00:00:13,770 --> 00:00:18,810
هذا ليس مفروضاً قانونيّاً، لا أفهم
سبب إذعانكِ للأمر

6
00:00:22,420 --> 00:00:23,960
أفهم بأنّكِ ذاهبة؟

7
00:00:24,700 --> 00:00:29,600
أنا متأكّدة بأنّ هناك المزيد
الّذي أحتاج لمعرفته

8
00:00:31,600 --> 00:00:35,980
هل تعرفون ما الّذي يطلقونه على
اللّجنة الاستقصائيّة لديبورا؟

9
00:00:36,860 --> 00:00:40,960
تجمّعاتهم مشهورة، لكن لا أحد
يعلم ما الّذي يجري هناك؟

10
00:00:41,710 --> 00:00:43,730
لا يتفوّه أحدٌ بحرف هناك

11
00:00:44,880 --> 00:00:46,720
...وبالتّالي اكتسب اسم

12
00:00:49,970 --> 00:00:52,520
حفلة شاي الآنسات الصّامتات

13
00:00:53,290 --> 00:00:56,020
أهلاً بكِ يا كونستانس غريل

14
00:00:56,570 --> 00:00:59,610
أرى بأنّ رأسكِ ما زال في مكانه

15
00:02:32,350 --> 00:02:34,710
،رغم أنّني أفترض بأنّكِ تدركين

16
00:02:34,710 --> 00:02:37,430
أنّه لا يُسمَح لكِ بالتكلّم حول ما يجري هنا

17
00:02:38,170 --> 00:02:40,510
هل ما زلتِ ترغبين في المُتابعة؟

18
00:02:41,060 --> 00:02:42,320
لا مُشكلة

19
00:02:43,950 --> 00:02:46,520
هؤلاء الثّلاثة يعشنَ من قوت ديبورا

20
00:02:46,920 --> 00:02:53,520
في الواقع، تلقّيتُ رسالة من صديقتك
باميلا فرانشيز

21
00:02:53,820 --> 00:02:55,040
من باميلا؟

22
00:02:55,370 --> 00:03:00,370
المسكينة. سمعتُ بأنّ شعرها
أضحى أبيض كالثّلج

23
00:03:01,830 --> 00:03:05,860
لكن كتبتْ بأنّكِ لم تفعلي
شيئاً يُخالف القانون

24
00:03:05,860 --> 00:03:10,620
لذا كما ترين، لا بُدّ من شخص آخر
أن يتدخّل لمُراجعة جرائمكِ

25
00:03:10,970 --> 00:03:12,500
جرائمي؟

26
00:03:12,750 --> 00:03:17,000
نقصد بالقول بأنّنا نمنحكِ شرف الحكم عليكِ

27
00:03:17,310 --> 00:03:21,760
فأنتِ لا تتمنّين أن يؤول بكِ الحال
إلى ما آلت إليه سكارليت كاستيل، صحيح؟

28
00:03:22,110 --> 00:03:23,670
سكارليت؟

29
00:03:25,060 --> 00:03:27,270
كان ذلك مُفزعاً ببساطة

30
00:03:27,560 --> 00:03:32,760
ذلك الوجه الّذي كانت فخورة جدّاً به
...يتدحرج في الوحل كدُمية

31
00:03:32,760 --> 00:03:39,780
،الجميع، أجل، حتّى الوضيعين منهم
صفّقوا وضحكوا وسخروا

32
00:03:41,280 --> 00:03:47,290
أعلم بأنّني ما كنتُ لأستطيع تحمُّل
عار نهاية مُذلّة كهذه

33
00:03:59,510 --> 00:04:03,040
ماذا تعتقدين بأنّكِ تفعلين؟
تُمسكين بيدي؟

34
00:04:07,600 --> 00:04:10,300
حتّى الآن، تبادلنا كي تتمكّن هي من إنقاذي

35
00:04:10,970 --> 00:04:13,050
لكن ليس هذه المرّة

36
00:04:13,780 --> 00:04:14,810
...سوف

37
00:04:15,270 --> 00:04:16,710
!نقاتل معاً

38
00:04:17,840 --> 00:04:21,560
هذه مهزلة مُخزية، لكن سأتماشى معها

39
00:04:21,920 --> 00:04:23,450
أستميحكِ عذراً؟

40
00:04:23,450 --> 00:04:25,960
ألم تسمعيني؟ أصغي جيّداً

41
00:04:25,960 --> 00:04:27,070
...قلتُ بأنّني

42
00:04:28,530 --> 00:04:32,330
!بأنّنا نحن من سيحكم عليكِ

43
00:04:35,170 --> 00:04:36,200
ماذا؟

44
00:04:36,610 --> 00:04:41,080
حفلة الإيرل جون دو الرّاقصة كانت
انتكاسة بالنّسبة لكِ يا ديبورا داركيان

45
00:04:41,590 --> 00:04:43,840
تقصدين الأطفال الرّاقصين؟

46
00:04:43,840 --> 00:04:47,750
مع فائق الاحترام، أنا من بلّغتُ
عنهم لقوّات الأمن

47
00:04:47,750 --> 00:04:50,340
!لا أُصدّق بأنّ بيننا أُناساً يتاجرون بالبشر

48
00:04:51,110 --> 00:04:53,840
مُجرّد التّفكير في ذلك يجعل دمي يتجمّد

49
00:04:54,420 --> 00:04:59,280
ولماذا كان لدى الجميع هناك
ارتباط بعائلة داركيان يا ترى؟

50
00:05:00,120 --> 00:05:04,870
خذي مثالاً ماركيز ماكلاين، الّذي
بدا ودوداً جدّاً مع تجّار العبيد

51
00:05:05,220 --> 00:05:06,340
،إيستر

52
00:05:06,340 --> 00:05:07,900
أقصد زوجكِ

53
00:05:09,360 --> 00:05:11,520
أشكّ في أنّه سيتمكّن من تجنُّب السّجن

54
00:05:11,520 --> 00:05:12,360
،رغم ذلك

55
00:05:12,660 --> 00:05:17,560
قد يتلقّى حكماً مُخفّفاً إذا
أدلى باسم العقل المُدبّر

56
00:05:18,410 --> 00:05:21,630
من المُؤكّد أنّكِ تعلمين بمنصب خطيبي

57
00:05:22,050 --> 00:05:25,940
بحسب شهادتكِ، سيكون من دواعي
سروري ترتيب الأمور معه

58
00:05:30,730 --> 00:05:31,890
حسناً

59
00:05:32,540 --> 00:05:34,690
كأنّنا انتصرنا

60
00:05:34,690 --> 00:05:36,140
أدع الباقي لكِ

61
00:05:36,400 --> 00:05:38,540
شكراً لكِ يا سكارليت

62
00:05:43,870 --> 00:05:49,400
لا بُدّ أنّ مركيزة ماكلاين تعلم بأنّ
ديبورا داركيان لها يد بالجريمة

63
00:05:49,960 --> 00:05:51,900
—إذا طلبتُ منها أن تشهد على ذلك

64
00:05:51,900 --> 00:05:53,150
يا آنسات

65
00:05:55,270 --> 00:05:57,870
هل سمعتُن شيئاً للتو؟

66
00:05:59,370 --> 00:06:00,920
بالمناسبة

67
00:06:00,920 --> 00:06:06,690
ألم يكن ماركيز ماكلاين على وشك
مُغادرة البلد؟

68
00:06:06,690 --> 00:06:08,510
هل أنا مُخطئة يا إيستر؟

69
00:06:10,840 --> 00:06:13,680
لن يعود لبعض الوقت، صحيح؟

70
00:06:15,500 --> 00:06:16,940
هـ-هذا صحيح

71
00:06:19,730 --> 00:06:22,100
ما الّذي يجري؟

72
00:06:22,100 --> 00:06:24,180
ألم تفهمي بعد؟

73
00:06:24,490 --> 00:06:29,950
هل خلتِ أنّ ابنة فيكونت تستطيع
سحق فرد من عائلة داركيان؟

74
00:06:32,760 --> 00:06:36,470
أعتقد بأنّ الوقت حان لنُصوّت الآن

75
00:06:36,470 --> 00:06:40,210
من ينبغي أن يُحكم عليه هنا، أنتِ أم أنا؟

76
00:06:40,670 --> 00:06:43,460
...هذا سيّئ. في ظلّ الظّروف

77
00:06:43,710 --> 00:06:48,990
بالطّبع، إذا ركعتِ أمامي
،كفتاة صغيرة مُطيعة

78
00:06:48,990 --> 00:06:52,460
فقد أقرّر بأنّ باميلا كانت تتوهّم فقط

79
00:06:52,460 --> 00:06:54,230
!كيف تجرؤ؟

80
00:06:54,820 --> 00:06:58,620
والآن، هل لديكِ ما تقولينه؟

81
00:06:58,620 --> 00:07:00,700
...أنا... أنا

82
00:07:00,700 --> 00:07:01,980
نعم؟

83
00:07:02,430 --> 00:07:03,860
...أنا

84
00:07:04,460 --> 00:07:08,360
لا أتّفق مع أسلوبكِ البتّة

85
00:07:11,400 --> 00:07:13,300
يستطِعن فعل ما يشأنَ معي

86
00:07:13,300 --> 00:07:15,250
!أرفض التّراجع الآن

87
00:07:17,890 --> 00:07:18,990
—أيّتها

88
00:07:20,090 --> 00:07:23,260
مرحباً! عذراً على الإزعاج

89
00:07:25,700 --> 00:07:26,500
بئس الأمر

90
00:07:26,500 --> 00:07:30,510
،ظلّوا يضايقونني بشأن الرّسميّات
!وانظروا كم تأخّر الوقت

91
00:07:33,820 --> 00:07:38,520
من الوقاحة أن تدخلي من دون
دعوة يا أبيغيل أوبرايان

92
00:07:40,550 --> 00:07:44,150
العائلات النّبيلة العظيمة الأربع
،في مملكتنا هي كاستيل

93
00:07:44,150 --> 00:07:47,410
...وريتشيليو، وداركيان، و

94
00:07:48,410 --> 00:07:51,070
كيف حالكِ أيّتها الآنسة الصّغيرة؟

95
00:07:51,070 --> 00:07:52,030
...هذه المرأة

96
00:07:52,520 --> 00:07:53,840
!إنّها من عائلة أوبرايان

97
00:07:54,430 --> 00:07:56,220
...المعذرة، هذا

98
00:07:56,220 --> 00:08:00,280
مقعد سوزانّا نيفيل، أجل. أنا
هنا بالنّيابة عنها

99
00:08:00,280 --> 00:08:01,860
وهذه أوراق اعتمادي

100
00:08:02,400 --> 00:08:04,310
...إ-إذاً، لو تُوقّعين هنا

101
00:08:04,310 --> 00:08:06,600
ليس لديّ إلّا شيء واحد لأقوله

102
00:08:10,440 --> 00:08:12,680
إيستر. جانين

103
00:08:12,680 --> 00:08:14,170
كارولين

104
00:08:14,810 --> 00:08:17,920
ما لم تُرِدنَ أن تُسحقن، ردِّدن ما أقوله

105
00:08:22,620 --> 00:08:24,400
عجباً يا أبيغيل

106
00:08:24,400 --> 00:08:26,800
بدا هذا كتهديد

107
00:08:26,800 --> 00:08:31,910
،إن أصررتِ على ترهيبِ صديقاتي
فسوف ألجأ للقانون

108
00:08:32,220 --> 00:08:35,020
لا يمكننا فعل ذلك يا ديبي

109
00:08:35,710 --> 00:08:38,760
لا يغادر من يُقال هنا الغرفة

110
00:08:39,250 --> 00:08:41,150
أنتِ من نصَّ هذه القاعدة بنفسكِ

111
00:08:46,570 --> 00:08:47,920
سامحنَني

112
00:08:48,370 --> 00:08:52,230
أشعر بوعكة. أنا مُضطرّة للمُغادرة باكراً اليوم

113
00:08:54,670 --> 00:08:59,170
ويحكِ! لا يجوز أن تُقدمي
على مُجازفة طائشة كهذه

114
00:08:59,170 --> 00:09:01,680
لا رحمة في عالمنا

115
00:09:02,140 --> 00:09:05,410
المعذرة... شكراً جزيلاً لكِ

116
00:09:05,410 --> 00:09:08,490
حريّ بكِ أن توفّري شكركِ
لراندولف أولستير

117
00:09:08,490 --> 00:09:10,700
لماذا فخامته؟

118
00:09:11,120 --> 00:09:16,090
في الأمس، أتى إلى منزلي وطلب
منّي مُساعدة خطيبته

119
00:09:16,090 --> 00:09:18,690
لأنّها بدت بأنّها سوف تحشر
أنفسها في ورطة

120
00:09:19,130 --> 00:09:23,700
بحث حول المُشاركات هنا
ووفّر هذه الرّسالة لأجلي

121
00:09:26,540 --> 00:09:29,200
...لماذا أشعر... لا أعلم

122
00:09:30,320 --> 00:09:31,800
بالإحراج؟

123
00:09:39,960 --> 00:09:41,460
كونستانس غريل؟

124
00:09:42,980 --> 00:09:44,230
!توقّعتُ ذلك

125
00:09:44,780 --> 00:09:47,920
هلّا تكلّمتُ معكِ قليلاً؟

126
00:09:47,920 --> 00:09:49,700
—المعذرة، من قد تكونين

127
00:09:49,700 --> 00:09:53,420
لماذا بدأتِ بالتحرّي حول سكارليت كاستيل؟

128
00:09:54,230 --> 00:09:57,140
إذاً، هل تتمرّدين على مُثُل عائلتكِ؟

129
00:09:57,140 --> 00:09:58,860
على صدق غريل الشّهير ذاك؟

130
00:09:58,860 --> 00:10:00,750
هل سئمتِ من كونكِ فتاة صالحة؟

131
00:10:01,040 --> 00:10:05,750
لا بُدّ أنّه كان من المُحبط أن يكون كلّ ما تُركّز
عليه الصُّحُف هو وفاة تيريسا جينينغز

132
00:10:05,750 --> 00:10:08,590
ماذا؟ مـ-من تيريسا؟

133
00:10:08,590 --> 00:10:13,110
ألا تتذكّرين؟ كانت كانت نصف
ذلك المشهد في حفل إيميليا الرّاقص

134
00:10:16,550 --> 00:10:17,970
!تذكّرتُها

135
00:10:18,480 --> 00:10:21,110
ألم تعلمي؟

136
00:10:21,110 --> 00:10:23,410
الرّجل الّذي كانت تُقيم معه
،علاقة قام بإنهاء علاقته معها

137
00:10:23,410 --> 00:10:26,410
وحاولت قتله عندما انتحرت

138
00:10:28,350 --> 00:10:29,690
...تقصدين بأنّها

139
00:10:29,690 --> 00:10:33,630
لكن لنكتفِ بذلك! كيف لكِ
—ولخطيبكِ راندولف أولستر

140
00:10:32,010 --> 00:10:35,020
ألا تعتقدين بأنّ هذا يكفي يا أميليا؟

141
00:10:38,010 --> 00:10:39,360
!ألدوس

142
00:10:39,590 --> 00:10:45,650
قال رئيس التّحرير بأنّه سيُخفّض رتبتكِ إذا
أجريتِ مزيداً من المُقابلات غير المُرخّصة

143
00:10:44,760 --> 00:10:47,200
!إلى اللّقاء يا كونستانس غريل

144
00:10:47,200 --> 00:10:50,440
!أؤمن تماماً بأنّكِ ستُجيبين بصدق بالطّبع

145
00:10:51,900 --> 00:10:53,860
إنّها صحفيّة إذاً؟

146
00:10:53,860 --> 00:10:55,370
بئس الأمر

147
00:10:55,370 --> 00:10:57,280
سامحي زميلتي رجاء

148
00:10:57,280 --> 00:10:58,640
لا حاجة

149
00:10:58,880 --> 00:11:02,140
اسمي ألدوس كلايتون، من شركة مايفلاور

150
00:11:02,140 --> 00:11:06,140
أبلغيني إذا سبّبتْ لكِ أميليا
مزيداً من المتاعب

151
00:11:06,520 --> 00:11:08,060
شـ-شكراً لك

152
00:11:11,720 --> 00:11:13,690
ماذا كان ذلك؟

153
00:11:13,690 --> 00:11:17,010
اعتبريها قطّة حاولتْ خدشكِ فحسب

154
00:11:18,760 --> 00:11:24,000
الآنسة سي... ابنة فيكونت، تُقلّد"
"سيّئة الصّيت سكارليت كاستيل

155
00:11:24,000 --> 00:11:29,500
تستمتع بعقاقير هلوسة المحظورة اليوم"
"وتقضي أيّامها في طقوس عربدة

156
00:11:29,790 --> 00:11:33,260
!هذا كلام فارغ! هُراء فظيع

157
00:11:33,790 --> 00:11:35,500
بالطّبع هو كذلك

158
00:11:35,500 --> 00:11:40,290
مع الأسف. وأنا هنا الّتي طمحتُ
لأميليا هوبيس كمثَل أعلى

159
00:11:40,290 --> 00:11:42,520
مثَل أعلى؟ هي؟

160
00:11:42,520 --> 00:11:44,050
ألم أخبركِ؟

161
00:11:44,050 --> 00:11:47,520
حلمي هو أن أبقى غير مُتزوّجة
وأصبح صحفيّة

162
00:11:47,830 --> 00:11:49,510
حقّاً؟

163
00:11:51,090 --> 00:11:53,030
أنتِ من أخبرني بنفسكِ

164
00:11:53,470 --> 00:11:56,620
،لطالما كنتُ مهووسة بمُطاردة الإشاعات

165
00:11:56,620 --> 00:12:00,000
،كما قلتِ، "إذا كنتِ تستمتعين بذلك
"فلِمَ لا تصبحين صحفيّة؟

166
00:12:00,000 --> 00:12:03,410
لم يكن أحدٌ آخر ليقترح عليّ شيئاً
كهذا آنذاك، ولو كمزحة

167
00:12:03,960 --> 00:12:07,200
بدا وكأنّكِ فهمتِني حقّاً. كنتُ مسرورة للغاية

168
00:12:07,950 --> 00:12:09,260
حقّاً؟

169
00:12:10,020 --> 00:12:14,500
ستحتسين الشّاي مع وليّة العهد
سيسيليا لاحقاً، صحيح؟

170
00:12:14,500 --> 00:12:16,530
!أتوقّع سبَقاً صحفيّاً دسِماً

171
00:12:16,890 --> 00:12:19,300
...صحيح

172
00:12:22,580 --> 00:12:24,800
هلّا أخذتُ قليلاً من وقتكِ؟

173
00:12:25,540 --> 00:12:28,540
أمثّل لجنة السّيّدات من رابطة البنفسج

174
00:12:28,540 --> 00:12:30,810
اسمي هو كيمبيرلي سميث

175
00:12:31,580 --> 00:12:33,320
ماذا الآن؟

176
00:12:33,570 --> 00:12:39,570
نسعى لتخليص البلاد من الثّقافة الهمجيّة

177
00:12:39,570 --> 00:12:45,820
أتيتُ لأعترض على الآنسة الصّغيرة
الحمقاء الّتي تُقدّس سكارليت كاستيل

178
00:12:46,140 --> 00:12:47,700
أريد الذّهاب إلى المنزل

179
00:12:47,950 --> 00:12:50,430
هذه الجزئيّة تخصُّ عقاقير الهلوسة بالتّحديد

180
00:12:50,430 --> 00:12:54,700
لا تقولي لي بأنّها تشير إلى نعيم جاكال

181
00:12:55,200 --> 00:12:56,970
نعيم جاكال؟

182
00:12:57,540 --> 00:12:59,710
...على ذكر نعيم جاكال

183
00:12:59,710 --> 00:13:01,740
أين تنظرين برأيكِ؟

184
00:13:02,250 --> 00:13:04,620
لا تتمنّين ظهوري أمثالي أمامكِ؟

185
00:13:04,620 --> 00:13:06,050
!يا للأرستقراطيّة

186
00:13:06,050 --> 00:13:10,140
أنتم المُتعصّبون لا تعتبروننا
حتّى أُناساً عاديّين

187
00:13:10,140 --> 00:13:11,970
—لـ-لا أعتقد بأنّه من المُنصف

188
00:13:12,720 --> 00:13:15,970
هل والدايّ مُتعصّبان أيضاً إذاً؟

189
00:13:16,580 --> 00:13:17,940
!كيت

190
00:13:17,940 --> 00:13:19,720
ألستِ ابنة لوراين؟

191
00:13:20,310 --> 00:13:24,870
أنحدر من عائلة بارونيّة، لكن وُلِدت
أمّي من عامّة النّاس

192
00:13:24,870 --> 00:13:28,730
هل نبقى مُتعصّبين لأنّنا
من الطّبقة النّبيلة؟

193
00:13:31,480 --> 00:13:35,240
أستأذن بالانصراف لليوم

194
00:13:37,560 --> 00:13:39,130
—كيت، شكراً لـ

195
00:13:39,130 --> 00:13:41,570
هل صحيح أنّكِ خُطبتِ لإيرل أولستر؟

196
00:13:42,260 --> 00:13:43,930
...في الواقع

197
00:13:45,330 --> 00:13:46,690
هذا صحيح إذاً

198
00:13:47,890 --> 00:13:49,900
لن تخبريني بشيء؟

199
00:13:50,360 --> 00:13:53,270
أعلم بأنّني قلتُ بأنّني سانتظركِ
حتّى تُصارحيني

200
00:13:53,590 --> 00:13:57,020
لكن هذا لا يعني بأنّ هذا غير مُؤلم

201
00:13:57,250 --> 00:13:58,350
...كيت

202
00:14:03,050 --> 00:14:07,400
!ماذا أفعل الآن؟

203
00:14:07,630 --> 00:14:11,400
!كيف لي أن أكون فظيعة مع كيت؟

204
00:14:11,870 --> 00:14:16,690
.رغم ذلك، لا يمكنني إقحامها في هذا
تحديداً كيت

205
00:14:19,240 --> 00:14:20,490
الآنسة غريل

206
00:14:20,920 --> 00:14:22,170
فخامتك

207
00:14:22,740 --> 00:14:26,510
ا-المعذرة، شكراً جزيلاً لك
على ذلك اليوم

208
00:14:26,800 --> 00:14:28,260
على ماذا؟

209
00:14:30,170 --> 00:14:32,010
بشأن اللّجنة الاستقصائيّة

210
00:14:32,790 --> 00:14:35,770
هكذا إذاً. لم تحتط فيما تقول

211
00:14:36,060 --> 00:14:37,960
هذا هو طبع أبيغيل

212
00:14:38,260 --> 00:14:41,270
أجل. سأزورها لشكرها لاحقاً

213
00:14:47,840 --> 00:14:49,270
ما الخطب؟

214
00:14:49,780 --> 00:14:52,780
هذا كيندال ليفين، دبلوماسيّ رفيع المرتبة

215
00:14:53,110 --> 00:14:55,600
إنّه مبعوث مُهمّ من فاريس

216
00:14:55,600 --> 00:14:57,430
لِمَ هو مُرتبك هكذا؟

217
00:14:58,170 --> 00:15:02,010
يبدو أنّهم فقدوا عضواً من وفدهم

218
00:15:03,140 --> 00:15:04,320
هل سكارليت هنا؟

219
00:15:04,320 --> 00:15:06,810
...أ-أجل، في الواقع

220
00:15:08,540 --> 00:15:09,830
أوليشيز؟

221
00:15:09,830 --> 00:15:13,540
شخص بهذا الاسم كان مفقوداً منذ الأمس

222
00:15:13,540 --> 00:15:14,930
هل تعرفه؟

223
00:15:14,930 --> 00:15:21,140
إنّه غالباً أوليشيز فاريس، أمير
فاريس السّابع البالغ تسع سنوات

224
00:15:21,140 --> 00:15:22,940
!أ-أمير؟

225
00:15:22,940 --> 00:15:24,540
اختطاف رُبّما؟

226
00:15:24,540 --> 00:15:25,690
كم هذا فظيع

227
00:15:26,000 --> 00:15:29,620
في تلك الحالة، لماذا لم يذكر
الفاريسيّون شيئاً؟

228
00:15:30,180 --> 00:15:32,570
—المعذرة يا آنسة غريل، يجب عليّ

229
00:15:32,570 --> 00:15:35,060
العودة إلى قوّات الأمن، صحيح؟

230
00:15:35,390 --> 00:15:39,450
لا بُدّ أنّ الأمير أوليشيز مُتوتّر جدّاً

231
00:15:39,450 --> 00:15:41,580
جِده في أسرع وقت مُمكن رجاء

232
00:15:41,580 --> 00:15:45,300
سأفعل. بالنّسبة لاجتماعكِ مع
...وليّة العهد سيسيليا

233
00:15:45,300 --> 00:15:46,590
سأتوخّى الحذر

234
00:15:46,920 --> 00:15:49,460
لن تمنعني سموّها إذا أردتُ تقديم المُساعدة

235
00:15:49,460 --> 00:15:51,710
إن فشل كلّ شيء، فسأستخدم اسم فخامتك

236
00:15:51,710 --> 00:15:56,320
،قد لا أكون ندّة لها رغم ذلك
...لكن بغضّ النّظر

237
00:16:02,230 --> 00:16:03,450
قولاً سديداً

238
00:16:05,600 --> 00:16:07,100
،على أيّ حال

239
00:16:07,100 --> 00:16:11,510
أنا مُندهشة من الشّخص الّذي تجرأ على اختطاف
شخص وسط كلّ هذه الحِراسة المُشدّدة

240
00:16:11,510 --> 00:16:13,110
حدسكِ من جديد؟

241
00:16:13,650 --> 00:16:17,120
ما زال لدينا وقت. سأرى ما يمكنني إيجاده

242
00:16:20,120 --> 00:16:22,270
!أهلاً وسهلاً

243
00:16:22,270 --> 00:16:24,120
ماذا؟ أين راندي؟

244
00:16:24,330 --> 00:16:28,640
أنا آسفة حقّاً. اضطرّ للمُغادرة لعمل طارئ

245
00:16:29,620 --> 00:16:31,310
!مع الأسف

246
00:16:31,310 --> 00:16:32,840
!حسناً، تفضّلي بالجلوس! اجلسي

247
00:16:32,840 --> 00:16:35,630
!لم يزرني ضيفٌ في هذه الغرفة منذ زمن طويل

248
00:16:37,220 --> 00:16:38,590
هل عرفتِ شيئاً؟

249
00:16:38,590 --> 00:16:40,780
اكتشفتُ رجلاً مشبوهاً

250
00:16:40,780 --> 00:16:43,510
فادو، تاجر من جمهوريّة سولديتا

251
00:16:44,290 --> 00:16:46,460
أتى لرؤية سيسيليا

252
00:16:49,250 --> 00:16:53,110
غير مألوفة، أليس كذلك؟ مصدرها
كلّ أنحاء القارّة

253
00:16:53,500 --> 00:16:55,490
لديّ تاجر يجمعها لأجلي

254
00:16:55,490 --> 00:16:57,430
إنّه ماهرٌ جدّاً في عمله

255
00:17:00,280 --> 00:17:04,110
هل يزوركِ هذا التّاجر... كثيراً؟

256
00:17:04,110 --> 00:17:06,830
أجل. اسمه فادو بالمناسبة

257
00:17:06,830 --> 00:17:08,280
كان هنا في الأمس

258
00:17:08,280 --> 00:17:12,290
جاء ومعه سلّة كبيرة على ظهره
مليئة بالسجّاد لبيعها لي

259
00:17:12,760 --> 00:17:15,060
لكن لماذا تسألين؟

260
00:17:15,060 --> 00:17:16,430
لـ-لا يوجد سبب

261
00:17:16,430 --> 00:17:17,540
أنا آسفة جدّاً

262
00:17:17,790 --> 00:17:19,040
سيبرد الشّاي

263
00:17:22,330 --> 00:17:24,060
يا لها من رائحة مُميّزة

264
00:17:25,530 --> 00:17:27,950
شايكِ أسود عاديّ

265
00:17:29,380 --> 00:17:33,220
كنتُ مُتوعّكة

266
00:17:33,220 --> 00:17:37,580
يحضر لي فادو هذا الشّاي العشبيّ
الخاصّ كمعروف

267
00:17:38,020 --> 00:17:40,470
لهذا إبريقانا منفصلان؟

268
00:17:40,470 --> 00:17:42,580
بالطّبع. لماذا برأيكِ؟

269
00:17:42,950 --> 00:17:44,690
أنا آسفة حقّاً

270
00:17:44,690 --> 00:17:48,570
،مُحاولة تسميم سموّكِ اشتهرت كثيراً

271
00:17:48,570 --> 00:17:51,080
فافترضتُ أنّكِ محتاطة دوماً

272
00:17:51,080 --> 00:17:54,130
تقصدين سكارليت كاستيل؟

273
00:17:54,510 --> 00:17:56,600
تبدين وكأنّكِ تعرفين كلّ شيء عن الأمر

274
00:17:56,600 --> 00:17:59,080
لا، سمعتُ إشاعات فقط

275
00:17:59,510 --> 00:18:02,100
إذاً سأروي لكِ القصّة

276
00:18:03,110 --> 00:18:03,980
،في ذلك اليوم

277
00:18:04,340 --> 00:18:07,230
خلفَ إنريكي بوعده بخطبة سكارليت

278
00:18:07,230 --> 00:18:09,690
من أجل أن يزورني بسبب مرضي

279
00:18:10,590 --> 00:18:13,380
فاستشاطتْ غضباً

280
00:18:14,420 --> 00:18:21,140
في تلك اللّيلة، اكتشفنا بأنّ إحدى
أوعية مياهنا مُسمّمة

281
00:18:21,900 --> 00:18:26,240
،وكان قرط أذنها بجانب الوعاء المسموم

282
00:18:26,240 --> 00:18:30,300
وقنينة سُمّ نصف فارغة عُثِر
عليها في منزلها

283
00:18:31,730 --> 00:18:34,200
وحدث الباقي كما سمعتِ

284
00:18:34,200 --> 00:18:37,120
أُعدِمَتْ لارتكابها هذه الجريمة

285
00:18:38,590 --> 00:18:44,890
لكن أنا مُذنبة لوقوعي في حُبّ
إنريكي عندما عرفتُ بأنّه كان خاطباً؟

286
00:18:46,670 --> 00:18:52,210
.وأنا السّبب في عدم إنجابه أطفالاً
إنريكي المسكين

287
00:18:52,960 --> 00:18:57,270
أعتقد بأنّه ينوي التخلّي عن عرشه
،جوهان، أخيه الأصغر

288
00:18:57,270 --> 00:18:59,540
والّذي لديه ابن وابنة

289
00:19:00,520 --> 00:19:01,870
...سموّكِ

290
00:19:01,870 --> 00:19:06,210
تقمّصها دور الضّحيّة لا يبدو أنّه
أكسبَها أي استحسان هنا

291
00:19:07,430 --> 00:19:12,160
احتسي هذا الّشّاي العشبيّ. إنّه
سُمّ مُخصّص للإجهاض

292
00:19:13,490 --> 00:19:16,430
إذا كانت تشربه دوماً، فذلك سوف
يُفسد ما بأحشائها

293
00:19:16,920 --> 00:19:20,280
لا بُدّ أ نّ جسدها بارد كالثّلج

294
00:19:25,540 --> 00:19:27,010
نعم؟

295
00:19:27,010 --> 00:19:29,300
...لا شيء! فقط

296
00:19:31,770 --> 00:19:33,160
...في الواقع

297
00:19:34,770 --> 00:19:36,280
كم أنتِ غبيّة

298
00:19:36,280 --> 00:19:40,720
جعلتِ من نفسكِ هدفاً الآن

299
00:19:40,720 --> 00:19:45,280
لكن لم أستطع السّماح لشخص
غير مُحترِز يتجرّع سُمّاً

300
00:19:45,660 --> 00:19:49,410
ماذا؟ ألم تضعي احتمالاً بأنّني
قد لفّقتُ ذلك؟

301
00:19:49,410 --> 00:19:52,000
،قد تكونين كاذبة يا سكارليت

302
00:19:53,010 --> 00:19:56,760
لكن ما زلتُ أعلم عندما تقولين الحقيقة

303
00:19:59,810 --> 00:20:03,420
أصبحتِ فتاة لعوباً مؤخّراً

304
00:20:03,990 --> 00:20:08,300
والآن بخصوص ذلك التّاجر... قالت
بأنّه كان يحمل سلّة

305
00:20:08,300 --> 00:20:09,170
صحيح

306
00:20:09,480 --> 00:20:12,260
يمكن إخفاء طفل فيه

307
00:20:12,260 --> 00:20:14,190
حريّ بنا أن نقوم بمزيد من التحرّي

308
00:20:14,450 --> 00:20:15,600
كيف؟

309
00:20:15,990 --> 00:20:17,940
،كي نعرف أكثر عن مُحترف

310
00:20:18,510 --> 00:20:20,900
فعلينا أن نسأل شخصاً في نفس المجال

311
00:20:36,720 --> 00:20:37,960
،بعد كلّ هذا

312
00:20:38,440 --> 00:20:42,770
،اكتشفنا بأنّ فاريس تحتكر عقّار الإجهاض ذاك

313
00:20:43,210 --> 00:20:46,340
لكن لا أحد يعلم هذا الرّجل المدعو فادو

314
00:20:46,340 --> 00:20:51,230
لا أحد يعرف شخصاً هامّاً بما يكفي
لزيارة القصر؟

315
00:20:51,230 --> 00:20:54,560
،تبدو هذه كمعلومة قيّمة جدّاً
إن أردتِ رأيي

316
00:20:54,880 --> 00:20:56,960
أتعتقدين ذلك حقّاً؟

317
00:20:57,920 --> 00:21:01,640
آسف جدّاً. يبدو أنّ هناك مُشكلة
في العجلات الخلفيّة

318
00:21:01,640 --> 00:21:03,270
سأتفقّدها

319
00:21:03,270 --> 00:21:04,450
حـ-حسناً

320
00:21:07,790 --> 00:21:09,400
عذراً على التّأخير

321
00:21:09,400 --> 00:21:12,120
مثلما خشيت، إحدى العجلات الخلفيّة
على وشك أن تفلت

322
00:21:15,500 --> 00:21:16,750
ما لأمر؟

323
00:21:16,750 --> 00:21:18,520
بدا... مُختلفاً

324
00:21:19,680 --> 00:21:22,970
صوت الحوذيّ مُختلف عن صوته
عندما ركبنا أوّل مرّة

325
00:21:34,260 --> 00:21:36,230
هل من مُشكلة؟

326
00:21:38,210 --> 00:21:40,520
لماذا تمّ استبدال السّائق؟

327
00:21:40,520 --> 00:21:42,350
هل يُعقَل أن يكون هذا الرّجل...؟

328
00:21:44,340 --> 00:21:45,750
تعويذة؟

329
00:21:45,750 --> 00:21:48,640
أجل. لكشف الأشرار

330
00:21:49,150 --> 00:21:53,630
إذا استجاب المُشتبه به لها، فسنعلم
فوراً بأنّه شخص شرّير

331
00:21:55,740 --> 00:21:57,700
كيريكي كيريكوكو

332
00:22:03,560 --> 00:22:04,470
!تنحّي جانباً

333
00:22:15,220 --> 00:22:16,270
!كونّي