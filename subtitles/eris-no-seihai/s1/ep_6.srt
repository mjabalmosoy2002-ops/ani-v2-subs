1
00:00:00,750 --> 00:00:06,090
!هل أنا أتوهّم، أم أنّكِ تُهملين انتقامي مؤخّراً؟

2
00:00:06,470 --> 00:00:08,480
...فـ-في الواقع

3
00:00:09,290 --> 00:00:11,740
مضى شهر منذ الاختطاف

4
00:00:12,440 --> 00:00:19,440
كشفتْ شهادة كيت عن حقائق عديدة
بخصوص دايغ غالّوس الغامضة

5
00:00:20,770 --> 00:00:22,880
كيريكي كيريكوكو

6
00:00:23,190 --> 00:00:28,620
التّعويذة الّتي خلّفتْها ليلي-ساما كانت
إحدى كلمات مرور المُنظّمة

7
00:00:29,290 --> 00:00:32,710
هدفهم هو سرقة مفتاحها

8
00:00:33,440 --> 00:00:37,960
قرّرتُ إعطاءه لفخامته والطّلب
منه التحرّي بنفسه

9
00:00:39,590 --> 00:00:45,400
كان الخاطف يضع وشمَ شمس، لذا
،نعتقد بأنّه كان عضواً في دايغ غالّوس

10
00:00:46,100 --> 00:00:49,760
لكن اغتاله أحدٌ في السّجن قبل
أن يخضع للاستجواب

11
00:00:50,640 --> 00:00:55,030
شهودٌ وضَعوا وليّة العهد سيسيليا في الجوار

12
00:00:56,130 --> 00:01:00,150
والآن أخبريني، لماذا نستدعي أبيغايل؟

13
00:01:00,630 --> 00:01:03,550
للّقاء بالفيكونتيسة آيشا هاكسلي

14
00:01:03,550 --> 00:01:07,510
قلتِ بأنّ لديكِ شأن معها في حفل
البارونة غودوين الرّاقص، أتذكرين؟

15
00:01:07,820 --> 00:01:10,260
تذكّرتُها

16
00:01:10,780 --> 00:01:15,960
،قد تتجاهل طلباً لِلقاء من فتاة مثلي

17
00:01:16,570 --> 00:01:20,130
لذا ارتأيتُ بأن أطلب معروفاً
من منزل عائلة أوبرايان

18
00:01:20,660 --> 00:01:23,020
تسرّني رؤيتكِ يا كونستانس

19
00:01:23,840 --> 00:01:26,750
لم أركِ منذ وقت طويل يا أبيغايل-ساما

20
00:01:29,030 --> 00:01:31,270
!كم أنتِ جميلة

21
00:01:31,550 --> 00:01:34,940
هاتان العينان الجمشتيّان وهذا
...الفستان القرمزيّ

22
00:01:35,280 --> 00:01:37,940
!يمكنكِ أن تكوني أميرة

23
00:01:38,280 --> 00:01:39,490
ماذا؟

24
00:01:39,980 --> 00:01:42,780
تتمتّعين بذوق جيّد يا فتاة

25
00:01:42,780 --> 00:01:45,990
!لـ-لحظة... ماذا؟ ماذا؟

26
00:03:17,600 --> 00:03:19,500
أتفهّم الوضع

27
00:03:19,820 --> 00:03:23,770
سأحرص على أن تتلقّي دعوة
من عائلة هاكسلي قريباً

28
00:03:25,050 --> 00:03:27,510
تقصدين بأنّكِ تُصدّقينني؟

29
00:03:27,510 --> 00:03:30,490
حيّرتِني طوال فترة معرفتي بكِ

30
00:03:30,490 --> 00:03:32,690
،لكن إذا كانت سكارليت بجانبكِ
فهذا يُبرّر الأمر

31
00:03:33,370 --> 00:03:36,450
أخبريني يا سكارليت، هل يمكنكِ سماعي؟

32
00:03:36,450 --> 00:03:38,580
!إنّها هناك يا آبّي

33
00:03:38,580 --> 00:03:40,050
شكراً يا لوشيا

34
00:03:40,290 --> 00:03:46,790
إعدامكِ آلمني كثيراً، لذا
اسمحي لي أن أُساعدكِ

35
00:03:46,790 --> 00:03:51,540
حقّاً؟ آمل أن تحتفظي بنكاتك داخل الضّفدع
المسحوق هذا الّذي تُسمّينه وجهاً

36
00:03:51,970 --> 00:03:56,030
!المعذرة... تقول، أجل، إنّها تتفهّم الأمر

37
00:03:57,040 --> 00:04:00,030
لا أشكّ بأنّها تهينني في هذه اللّحظة

38
00:04:00,310 --> 00:04:05,040
لم أكن أدري بأنّ شخصاً آخر
غيري يستطيع رؤية سكارليت

39
00:04:05,040 --> 00:04:08,650
ابنة أخي هنا وُلِدت بحدس عميق

40
00:04:08,650 --> 00:04:11,730
إذا كان لدى أيّ شخص آخر
...عينان كعينيها، فسيكون

41
00:04:11,730 --> 00:04:16,810
.الفيكونت هاسمورث على ما أعتقد
يُقال بأنّه مُبارَك بواسطة الإلَهات

42
00:04:16,810 --> 00:04:18,710
أهو كذلك حقّاً؟

43
00:04:19,560 --> 00:04:23,560
سمعتُ بأنّ الفيكونت يستطيع
رؤية كائنات غريبة

44
00:04:25,260 --> 00:04:28,240
ألا تعتقدين ذلك يا مولاتي؟

45
00:04:28,710 --> 00:04:31,080
أيُعقَل... ذلك؟

46
00:04:31,330 --> 00:04:34,320
انسي تلك الخنزيرة حديثة النّعمة

47
00:04:34,320 --> 00:04:35,570
سنغادر يا كونّي

48
00:04:36,860 --> 00:04:41,130
آمل أن تتكلّمي مع خطيبك بشأن طلبي

49
00:04:41,130 --> 00:04:42,590
حسناً

50
00:04:43,010 --> 00:04:44,720
!والآن، أستأذن بالانصراف

51
00:04:49,450 --> 00:04:53,160
فقدتْ تيريسا جينينغز حياتها
في مُحاولة قتل وانتحار

52
00:04:53,740 --> 00:04:57,980
زوجها، كيفن جينينغز، قد أصبح مريضاً

53
00:05:00,050 --> 00:05:02,810
،بحسب ما اكتشفَتْه أبيغايل-ساما

54
00:05:03,230 --> 00:05:07,100
دايغ غالّوس يبيعون المادّة المُهلوِسة
"نعيم جاكال"

55
00:05:07,450 --> 00:05:12,940
انسي كلّ ذلك وافهمي ما حدث
قبل عشر سنوات من آيشا

56
00:05:13,320 --> 00:05:17,110
على ذكرِ ذلك، ماذا كان طبع
آيشا هاكسلي؟

57
00:05:17,650 --> 00:05:21,460
كانت فتاة بسيطة وكئيبة

58
00:05:21,460 --> 00:05:25,340
يمكنكِ القول بأنّها كانت جزءاً
من حاشيتي. أو مُعجبة على ما أعتقد

59
00:05:26,050 --> 00:05:30,420
،إذا ارتديتُ فستاناً أحمر
فآيشا تفعل المثل

60
00:05:30,420 --> 00:05:34,670
.إذا ارتديتُ الأزرق، فتفعل كذلك
بطراز مُشابه لا أقلّ من ذلك

61
00:05:34,670 --> 00:05:36,340
وحتّى أنّها تُصفّف شعرها كشعري

62
00:05:36,840 --> 00:05:41,570
وذات مرّة نظرتْ في عينَي وقالت لي

63
00:05:43,220 --> 00:05:44,980
أريد أن أكون أنتِ

64
00:05:45,990 --> 00:05:47,950
وكيف رددتِ؟

65
00:05:48,410 --> 00:05:50,520
الجواب واضح

66
00:05:50,860 --> 00:05:55,490
العالم لا يحتاج اثنتين من سكارليت كاستيل

67
00:05:59,840 --> 00:06:01,450
الدّوق كاستيل

68
00:06:02,340 --> 00:06:04,250
راندولف

69
00:06:05,100 --> 00:06:08,510
ما هذا العمل الطّارئ الّذي ذكرتَه؟

70
00:06:08,510 --> 00:06:10,970
اسمح لي أن أكون صريحاً

71
00:06:11,370 --> 00:06:14,650
أريد أن أعرف عن كأس إيريس المُقدّس

72
00:06:16,740 --> 00:06:19,840
ما قد يكون هذا؟

73
00:06:19,840 --> 00:06:24,740
يؤسفني القول بأنّ المُصطلح غير
مألوف لدي. ما يكون كلّ هذا؟

74
00:06:25,310 --> 00:06:27,770
حسناً، للوقت الرّاهن فقط

75
00:06:28,740 --> 00:06:31,980
كلمة تحذير ودّية

76
00:06:31,980 --> 00:06:36,060
استكمل أوراقك الّتي في يدك
قبل أن تلعب بها

77
00:06:36,060 --> 00:06:38,790
هذا هو سرّ الحياة المديدة

78
00:06:44,450 --> 00:06:46,680
لنُراجع ما نعرفه

79
00:06:47,000 --> 00:06:52,270
سنبدأ بمُحاولة تسميم وليّة العهد
سيسيليا قبل عشر سنوات

80
00:06:52,580 --> 00:06:56,500
عندما عثروا على سُمٍّ في إحدى
أوعية الماء في منزلها

81
00:06:57,330 --> 00:07:01,260
ما الّذي جعل النّاس يشكّون
بكِ من الأساس؟

82
00:07:01,550 --> 00:07:04,270
سار الأمر كما أخبركِ المُخطِّط

83
00:07:04,270 --> 00:07:09,450
عثروا على قرط أذن حجر
قوس القمر كقرطي

84
00:07:09,450 --> 00:07:12,270
بجانب متجر الماء الخاصّ بلوزي

85
00:07:12,610 --> 00:07:17,890
ولسوء الحظّ، كنتُ قد استُدعيتُ
إلى المنزل قُبيل ساعات

86
00:07:24,300 --> 00:07:27,850
هل كان القرط لكِ حقّاً؟

87
00:07:27,850 --> 00:07:33,310
لا، كنتُ أضع القرطين عندما
اشتُبِه بي أوّل مرّة

88
00:07:33,520 --> 00:07:34,930
...وهل أخبرتِ

89
00:07:34,930 --> 00:07:37,310
أخبرتُ المُحقّقين؟ بالطّبع

90
00:07:37,660 --> 00:07:42,550
كلّ ما كنتُ أرتديه هو شيء فريد
من نوعه بصناعة حِرفيّين خبراء

91
00:07:42,820 --> 00:07:46,950
الاستجواب في ورشاتهم كان
ليُؤكّد ويُثبت صحّة ذلك

92
00:07:47,670 --> 00:07:51,270
لماذا لم تتمّ تبرئتكِ من التّهم إذاً؟

93
00:07:51,810 --> 00:07:57,850
قيل لي أنّه بعد المُعاينة، تبيّنَ
بأنّ أحد أقراطي كان مُزيّفاً

94
00:07:57,850 --> 00:08:02,580
ادّعوا بأنّني توقّعتُ إجراء تحقيق
فحضّرتُ قرطاً بديلاً

95
00:08:02,950 --> 00:08:08,600
بصيغة أُخرى، أحدهم استبدلَ قرطي
بآخر عُثِر عليه في منزل لوزي

96
00:08:08,600 --> 00:08:11,580
بينما كان في خزنة قوّات الأمن

97
00:08:12,040 --> 00:08:13,590
من قد يفعل شيئاً كهذا؟

98
00:08:13,590 --> 00:08:16,440
،لا أعلم. لكن في النّهاية

99
00:08:16,930 --> 00:08:22,200
منحَ الملكُ صلاحيّة بتفتيش منزلي

100
00:08:22,200 --> 00:08:26,980
لم يكن أحد يجرؤ على لمس بناء
كاستيل من دون أمر ملكيّ

101
00:08:27,470 --> 00:08:32,720
ثمّ، كما تعلمين، عُثِر على قنينة
سُمّ نصف فارغة في غرفتي

102
00:08:32,720 --> 00:08:35,040
وزجّوا بي بالسّجن

103
00:08:35,740 --> 00:08:39,390
هل شككتِ بوليّة العهد سيسيليا؟

104
00:08:39,390 --> 00:08:44,240
على ما أعتقد. استفادت كثيراً من موتي

105
00:08:44,560 --> 00:08:49,000
لذا قبل الآونة الأخيرة، ظننتُ
بأنّها نسّقت الأمر برمّته

106
00:08:49,270 --> 00:08:51,010
قبل الآونة الأخيرة؟

107
00:08:51,010 --> 00:08:54,390
بصراحة، لم أعُد مُتيقّنة

108
00:08:54,390 --> 00:08:58,770
أقصد بأنّها لا تبدو راضية إطلاقاً

109
00:08:59,440 --> 00:09:03,690
بعد عشر سنوات كاملة، يبدو أنّها
تبغض إنريكي كثيراً

110
00:09:03,690 --> 00:09:06,850
ولا تبدو مُهتمّة بثروة أو سلطة أيضاً

111
00:09:07,610 --> 00:09:11,830
أتساءل ما الّذي تحاول إنجازه

112
00:09:13,270 --> 00:09:16,090
أعتقد ما زلنا بعيدتين عن الحقيقة

113
00:09:16,090 --> 00:09:19,770
صحيح. لكن لدينا أكثر من مُجرّد
أحداث وقعتْ قبل عشر سنوات

114
00:09:19,770 --> 00:09:24,790
ثمّة شيء يجري الآن، ويمكننا أن نؤكّد
بأنّ سيسيليا لها يد في الأمر

115
00:09:25,100 --> 00:09:27,780
هل تتذكّرين ما قالته تلك الصّحفيّة
ذات الشّعر الأحمر؟

116
00:09:28,230 --> 00:09:32,800
كانت سيسيليا لوزي ابنة مومس
تربّتْ في ميتم

117
00:09:33,180 --> 00:09:37,790
وكيفن جينينغز، الّذي اقتربَ
من الحقيقة فأضحى مُدمناً

118
00:09:37,790 --> 00:09:39,330
هذا صحيح

119
00:09:41,010 --> 00:09:47,190
ذلك التّاجر الّذي زارها في نفس يوم
اختطاف أمير فاريس السّابع

120
00:09:47,190 --> 00:09:49,600
يبدو أكثر من مُجرّد صدفة

121
00:09:49,600 --> 00:09:53,610
...كان اسم التّاجر على ما أذكر
فادو، أليس كذلك؟

122
00:09:54,070 --> 00:10:00,070
على ذكر الأمر، ألم يكن لدى الخاطِف
مُتواطئ يُدعى سالفادور؟

123
00:10:00,070 --> 00:10:04,010
.تحمل الأسماء تشابُهاً على الورق
صدفة، أتعتقدين ذلك؟

124
00:10:05,350 --> 00:10:08,160
،إذا كانا نفس الشّخص

125
00:10:08,160 --> 00:10:12,330
فيمكننا أن نفترض بأنّ سيسيليا
مُتواطئة مع دايغ غالّوس كذلك

126
00:10:12,980 --> 00:10:18,710
وبأنّ لديهم يد في توزيع نعيم
جاكال في شارع الصّليب الأحمر

127
00:10:19,440 --> 00:10:24,960
تلك الشّابّة الّتي انهارتْ في حفل
الإيرل جون دو الرّاقص، كيارا غرافتون

128
00:10:25,260 --> 00:10:27,050
استخدمتْ تلك المادّة المُهلوِسة، صحيح؟

129
00:10:28,220 --> 00:10:30,200
وكذلك فعلَ كيفن جينينغز

130
00:10:31,480 --> 00:10:35,990
،ثمّ اختطاف الأمير أوليسيس
،اختطاف كيت

131
00:10:35,990 --> 00:10:42,050
وانتشار نعيم جاكال كلّه
من صنيع دايغ غالّوس؟

132
00:10:42,490 --> 00:10:45,330
تنسين أمراً مُهمّاً

133
00:10:46,570 --> 00:10:49,990
هاجمتْكِ دايغ غالّوس كذلك

134
00:10:51,480 --> 00:10:56,010
خاطِف كيت لوراين، كان يستهدف
مفتاح ليلي، أليس كذلك؟

135
00:10:56,010 --> 00:10:57,190
أجل

136
00:10:57,760 --> 00:11:03,190
،قلتُ للتو بأنّ شيئاً ما يجري الآن
لكن هذا ليس صحيحاً بالمعنى الدّقيق

137
00:11:04,010 --> 00:11:09,280
شيء ما كان يجري في السّنوات
...العشر الماضية

138
00:11:09,820 --> 00:11:12,220
هنا في أديلبايد

139
00:11:13,010 --> 00:11:16,670
سأتفاجأ إذا لم يكن لديه صِلة بإعدامي

140
00:11:18,030 --> 00:11:19,050
صحيح

141
00:11:20,920 --> 00:11:25,400
أيّاً كان ذلك، فقدت ليلي-ساما
حياتها غالباً بسبب ذلك

142
00:11:25,990 --> 00:11:31,000
كانت رسالتها الأخيرة "دمّري
"كأس إيريس المُقدّس

143
00:11:32,010 --> 00:11:33,530
مازلنا لا نعرف ما معنى هذا

144
00:11:38,910 --> 00:11:40,680
...المعذرة، فخامتك

145
00:11:40,680 --> 00:11:41,490
نعم؟

146
00:11:42,000 --> 00:11:45,810
،أدرك بأنّنا سنتشارك معلومات
لكن لماذا في متحف؟

147
00:11:46,200 --> 00:11:49,000
يحتوي على تبرُّعات من عائلة أورلاموندي

148
00:11:49,460 --> 00:11:51,840
ارتأيتُ بأنّهم قد يُوفّرون
دليلاً يؤدّي إلى المفتاح

149
00:11:52,350 --> 00:11:54,620
زرتُ هذا المكان مع ليلي كذلك

150
00:11:55,960 --> 00:11:57,320
...هكذا إذاً

151
00:11:57,690 --> 00:12:00,980
كانت علاقتهما ودّية

152
00:12:02,900 --> 00:12:04,240
هكذا إذاً

153
00:12:04,830 --> 00:12:07,240
!تعلّمي بعض آداب السّلوك

154
00:12:08,330 --> 00:12:14,840
هنا تتواجد إحدى الكُتُب المُقدّسة الّتي
تلقّاها القدّيس أناستاشيا من الإلَهات

155
00:12:16,110 --> 00:12:18,510
ما الخطب؟ هل أنتِ جائعة؟

156
00:12:18,510 --> 00:12:20,360
...لا! أقصد

157
00:12:23,340 --> 00:12:26,970
بالنّسبة لطلب أبيغايل، سيستغرق
ذلك بعض الوقت

158
00:12:27,830 --> 00:12:32,290
تملك وليّة العهد المشفى
حيث يتواجد كيفن جينينغز المريض

159
00:12:32,750 --> 00:12:35,710
سيترتّب عليّ الخضوع لبعض
الرّسميّات المُزعجة

160
00:12:35,710 --> 00:12:37,110
فهمت

161
00:12:37,450 --> 00:12:41,500
راجعتُ أنا وسكارليت ما حدث
،قبل عشر سنوات

162
00:12:41,990 --> 00:12:44,920
وتقول بأنّ قرطها قد استُبدِل

163
00:12:44,920 --> 00:12:47,630
أحتاج الملفّ حول الأقراط

164
00:12:47,630 --> 00:12:51,120
القرط الّذي اعتُبِر تقليداً
لم يُصنَع من حجر قوس القمر

165
00:12:51,120 --> 00:12:54,180
إنّما كنوع من الصّدف يُدعى
بالصّدف الفضّي

166
00:12:56,420 --> 00:12:58,180
وماذا عن التّصميم؟

167
00:12:58,180 --> 00:13:02,620
ا-المعذرة، تودّ سكارليت أن تعرف
كيف تمّتْ مُقارنة التّصميم

168
00:13:02,620 --> 00:13:06,390
كان مُطابقاً تماماً لقرطها الخاصّ

169
00:13:06,950 --> 00:13:09,980
لا يتمّ تداوُل الصّدفة الفضّيّة كثيراً

170
00:13:09,980 --> 00:13:14,310
بحثتُ حول مَن يشتريها آنذاك
:وعثرتُ على اسم مألوف

171
00:13:14,890 --> 00:13:17,150
عائلة سبينسر

172
00:13:17,380 --> 00:13:18,690
...أليس هذا

173
00:13:18,690 --> 00:13:20,340
إنّه اسم آيشا العذريّ

174
00:13:21,140 --> 00:13:26,150
تمتلك عائلةُ سبينسر ورشات عديدة
تعمل على معادن ثمينة

175
00:13:26,620 --> 00:13:31,770
ما كنتُ لأتفاجأ لو أنّ آيشا حصلتْ
على نسخ طبق الأصل من أقراطي

176
00:13:32,150 --> 00:13:36,030
قلتِ بأنّكِ خطّطتِ لزيارة
عائلة عاكسلي لسؤالها؟

177
00:13:36,030 --> 00:13:37,380
أ-أجل

178
00:13:38,390 --> 00:13:43,930
.قد تكون مُتواطئة مع دايغ غالّوس
لا تستعجلي

179
00:13:44,360 --> 00:13:45,440
لن أفعل

180
00:13:49,670 --> 00:13:52,440
ما زلتُ لا أشعر بشيء

181
00:13:52,440 --> 00:13:54,740
لا أتذكّر شيئاً أيضاً

182
00:13:55,970 --> 00:13:59,640
هل أُعدِمتُ هنا حقّاً؟

183
00:14:03,930 --> 00:14:06,010
...كونستانس غريل

184
00:14:06,900 --> 00:14:11,440
لم أتصوّر أبداً أن تستخدم أبيغايل
أوبرايان للوصول إليّ

185
00:14:16,700 --> 00:14:23,390
لماذا يقول النّاس بأنّ فتاة مُملّة كهذه
تُذكّرهم بسكارليت كاستيل؟

186
00:14:27,080 --> 00:14:29,980
لا يمكن لأحد أن يحلّ مكانها

187
00:14:30,580 --> 00:14:33,300
إنّها إلَهتي

188
00:14:34,120 --> 00:14:36,720
أنتِ آيشا سبينسر، أليس كذلك؟

189
00:14:38,910 --> 00:14:42,850
كنتِ تُراقبينني. الآن، وسابقاً كذلك

190
00:14:42,850 --> 00:14:44,600
ماذا تريدين؟

191
00:14:44,600 --> 00:14:48,000
ما أدراكِ بـ-باسمي؟

192
00:14:48,420 --> 00:14:52,370
عرّفتِ عن نفسكِ سابقاً
في حفلة أُخرى ما

193
00:14:52,370 --> 00:14:54,630
تـ-تتذكّرين؟

194
00:14:54,630 --> 00:14:56,290
بالطّبع

195
00:14:57,180 --> 00:15:00,630
مع مَن تعتقدين أنّكِ تتكلّمين؟

196
00:15:18,400 --> 00:15:22,790
أهلاً يا آنسة غريل، آسفة لأنّ
المنزل لا يرتقي لذوقكِ

197
00:15:22,790 --> 00:15:23,890
على العكس

198
00:15:24,440 --> 00:15:28,900
أقدّر دعوتكِ بصدق، يا آنسة هاكسلي

199
00:15:30,130 --> 00:15:33,800
نحن من عائلة نبيلة أقلّ مقاماً

200
00:15:33,800 --> 00:15:37,400
انصدمتُ لدى استقبال مبعوث
من عائلة أوبرايان

201
00:15:37,680 --> 00:15:41,640
رغم أنّه أتى حاملاً طلباً من عائلة غريل

202
00:15:42,010 --> 00:15:46,530
آمل أن تُسامحيني. ترتّب
عليّ مُقابلتكِ ببساطة

203
00:15:46,990 --> 00:15:50,920
إن لم تُمانعي، أودّ طرح سؤال عليكِ

204
00:15:50,920 --> 00:15:54,360
إذا كنتُ أستطيع الإجابة عنه، فتفضّلي

205
00:15:54,360 --> 00:15:57,670
ما هذه الرّائحة؟

206
00:15:59,340 --> 00:16:04,090
أحد معارفي لديها أنف وذاكرة ممتازان

207
00:16:04,090 --> 00:16:06,930
استطاعت أن تعرف حالما ظهرتِ

208
00:16:07,310 --> 00:16:11,200
أخبريني يا آنسة هاكسلي، لماذا
تفوح منكِ

209
00:16:11,640 --> 00:16:13,770
رائحة نعيم جاكال؟

210
00:16:14,940 --> 00:16:16,180
!لاحظتْ؟

211
00:16:17,290 --> 00:16:19,410
ما الّذي تتحدّثين عنه؟

212
00:16:19,410 --> 00:16:23,960
نعيم جاكال؟ تلك المادّة المُهلوِسة
الّتي نالتْ ضجّة قبل عقدٍ من الزّمن؟

213
00:16:25,750 --> 00:16:28,500
لا بُدّ أنّكِ مُخطئة

214
00:16:28,500 --> 00:16:33,720
أضع عطراً نادراً اليوم. ربّما هذا ما شممتِه

215
00:16:33,720 --> 00:16:38,340
مصدره بلد بعيدة. أشكّ في أنّكِ سمعتِ بها

216
00:16:38,750 --> 00:16:43,590
أنتِ كاذبة مسكينة مُثيرة للضّحك

217
00:16:44,850 --> 00:16:47,330
!يـ-يا للوقاحة

218
00:16:47,330 --> 00:16:49,360
!لن أتحمّل هذا! غادري فوراً

219
00:16:49,360 --> 00:16:50,840
يا إلهي

220
00:16:50,840 --> 00:16:53,400
تغضبين حالما يُسلَّط الضّوء على شغبكِ؟

221
00:16:53,400 --> 00:16:55,720
تتصرّفين كطفل غير مُنضبط

222
00:16:57,710 --> 00:16:59,700
ماذا أصابني؟

223
00:17:00,110 --> 00:17:04,900
،ما زالت نفس الفتاة تقف أمامي
...ومع ذلك أكاد

224
00:17:05,630 --> 00:17:08,870
كوني مُتأكّدة يا آيشا سبينسر

225
00:17:09,240 --> 00:17:13,890
مُحاولة خداعي مُهينة أكثر
من أيّ كلام قلتُه

226
00:17:16,190 --> 00:17:20,390
مع مَن تحسبين أنّكِ تتكلّمين؟

227
00:17:20,950 --> 00:17:23,360
سكارليت...؟

228
00:17:24,340 --> 00:17:28,640
لا، مُحال أن أخطئ بينها وبين شخص آخر

229
00:17:28,640 --> 00:17:34,330
قبل عشر سنوات، كانت سكارليت
كاستيل محور عالمي

230
00:17:35,400 --> 00:17:39,520
هي وخطيبها، وليّ العهد إنريكي

231
00:17:39,520 --> 00:17:43,520
،لم يكن يربطهما الحُبّ إطلاقاً

232
00:17:43,520 --> 00:17:48,290
لكن لاحظتُ بأنّهما كانا مرتاحين
معاً، كأنّهما شقيقان

233
00:17:48,780 --> 00:17:51,770
كم أقدّسهما

234
00:17:52,520 --> 00:17:55,660
حتّى أتتْ هي

235
00:17:57,720 --> 00:18:02,110
الحديث عن حُبّهما ضمن إطار اختلاف
المكانة انتشر كالنّار في الهشيم

236
00:18:02,920 --> 00:18:07,180
عرفتُ بأنّ الإشاعات يمكن أن تتحوّل
إلى حقيقة ما لم يتصدّ لها أحد

237
00:18:07,180 --> 00:18:11,190
.توقّعتُ أنّه كان عليّ فعل شيء
...وحينها فقط

238
00:18:12,820 --> 00:18:14,940
ماذا حدث يا شارون؟

239
00:18:14,940 --> 00:18:18,590
تبدين أنحف ممّا كنتِ في آخر
مرّة رأيتُكِ فيها

240
00:18:18,940 --> 00:18:20,270
استخدمتُ هذا

241
00:18:20,930 --> 00:18:24,950
يُفترض أن يكون نوعاً من ملح النّشادر
الغريب. تأثيره إعجازيّ، أليس كذلك؟

242
00:18:25,980 --> 00:18:27,960
رشّة واحدة هي كلّ ما يتطلّبه الأمر

243
00:18:28,470 --> 00:18:30,910
تناول كمّية كبيرة مُضرّ بصحّتك

244
00:18:32,470 --> 00:18:36,210
كنتُ قد سمعتُ بأنّ سيسيليا كانت
تُعاني من بنية جسديّة واهنة طبيعيّاً

245
00:18:37,090 --> 00:18:41,060
لو مَرِضَتْ، لترتّب عليها العودة
إلى منزل عائلتها

246
00:18:43,310 --> 00:18:48,250
وضعتُ نسختي طبق الأصل من قرط
حجر قوس القمر الخاصّ بسكارليت

247
00:18:48,910 --> 00:18:52,960
وهممتُ لزيارة من باب الشّفقة لمنزل لوزي

248
00:18:53,480 --> 00:18:59,490
كيف كان لي أن أعرف بأنّ سكارليت جاءت
وسبّبتْ جلبة قبل بضع ساعات؟

249
00:19:02,490 --> 00:19:04,490
!ها هي

250
00:19:04,490 --> 00:19:08,310
سأضع ملح النّشادر في هذا الماء فحسب

251
00:19:09,250 --> 00:19:14,610
سأفعل هذا لأجل سكارليت. أعلم
بأنّها كانت لتفعل المثل

252
00:19:15,000 --> 00:19:17,010
...لو كنتُ سكارليت، لقمتُ

253
00:19:23,390 --> 00:19:26,950
إذا فعلتُ هذا، فيمكنني أن أصبح سكارليت

254
00:19:30,380 --> 00:19:32,880
سمّمتِ الماء إذاً

255
00:19:33,390 --> 00:19:35,890
لم أكن أعلم بأنّه كان سُمّاً

256
00:19:37,400 --> 00:19:39,110
!صدّقيني

257
00:19:39,110 --> 00:19:41,720
ما زالت الزُجاجة الّتي استعملتُها
!آنذاك بحوزتي

258
00:19:41,720 --> 00:19:45,400
تفقّديها وسترين بأنّه مُجرّد مُخدّر تنحيف

259
00:19:45,400 --> 00:19:47,140
!لم تكن غلطتي

260
00:19:47,140 --> 00:19:49,910
!لذا أرجوكِ! سامحيني يا سكارليت

261
00:19:50,170 --> 00:19:51,680
تريدين غفراني؟

262
00:19:51,680 --> 00:19:55,520
إذاً لماذا لم تعترفي بجريمتكِ؟

263
00:19:56,920 --> 00:20:00,010
سواء كان سُمّاً أو شيئاً آخر
فلا يُشكّل ذلك فرقاً

264
00:20:00,010 --> 00:20:04,420
على أيّ حال، كنتِ تعلمين بأنّني بريئة

265
00:20:06,140 --> 00:20:10,680
ذهبتُ إلى الجلّاد بسبب
الجريمة الّتي ارتكبتِها

266
00:20:11,170 --> 00:20:13,820
!فـ... فعلتُ ذلك لأجلكِ

267
00:20:13,820 --> 00:20:17,530
كنتِ لتفعلي الشّيء ذاته
لو سنحتْ لكِ الفُرصة

268
00:20:17,530 --> 00:20:19,060
—لذا بالنّيابة عنكِ، أنا

269
00:20:18,300 --> 00:20:24,940
كنتُ لأُفضّل الموت على فعل
شيء مشين كهذا

270
00:20:27,030 --> 00:20:32,780
،كلّ ما فعلتِه قبل عشر سنوات
فعلتِه لأجل نفسكِ

271
00:20:33,710 --> 00:20:38,710
من تعتقدين نفسكِ لاستخدامي كعذر لكِ؟

272
00:20:39,750 --> 00:20:41,720
،آيشا سبينسر

273
00:20:42,350 --> 00:20:45,410
...لأجلكِ فقط، سأسأل مرّة أخيرة

274
00:20:45,960 --> 00:20:50,100
مع مَن تحسبين أنّكِ تتكلّمين؟

275
00:20:51,790 --> 00:20:54,240
في أعماقي، كنتُ أعلم

276
00:20:55,320 --> 00:20:59,480
كان الجواب حاضراً أمام عينَي
طوال هذا الوقت

277
00:21:00,080 --> 00:21:02,990
أشيح بنظري عنه لإعفاء نفسي فحسب

278
00:21:03,560 --> 00:21:06,090
أنا من سبّب كلّ ذلك

279
00:21:06,090 --> 00:21:07,380
...أنا

280
00:21:08,070 --> 00:21:10,310
!من قتلتُ سكارليت

281
00:21:11,140 --> 00:21:12,060
!لا

282
00:21:15,730 --> 00:21:17,510
!ما الفائدة من الموت؟

283
00:21:17,510 --> 00:21:21,130
!موتكِ لن يلغي ما فعلتِه لسكارليت

284
00:21:25,710 --> 00:21:28,930
يجب  أن تُواصلي العيش وتتوبي

285
00:21:32,420 --> 00:21:34,120
!آنسة هاكسلي؟

286
00:21:40,210 --> 00:21:44,900
بعد أيّام قليلة، تواصلت آيشا
هاكسلي مع شركة مايفلاور

287
00:21:44,900 --> 00:21:48,280
قائلةً بأنّها أرادت الاعتراف بجريمتها

288
00:21:50,720 --> 00:21:51,960
هل أنتِ بخير؟

289
00:21:55,030 --> 00:21:56,340
فخامتك؟

290
00:21:57,080 --> 00:21:59,400
...أتى لأجلي

291
00:22:03,040 --> 00:22:07,980
كانت آيشا. سمّمتْ وعاء
الماء الخاصّ بلوزي

292
00:22:08,300 --> 00:22:10,170
هل لديكِ ما يُثبت ذلك؟

293
00:22:10,170 --> 00:22:12,520
تقول بأنّها لديها زُجاجة السُّمّ

294
00:22:12,520 --> 00:22:16,710
من عشر سنوات مضت؟ التحقُّق
من ذلك سيستغرق وقتاً

295
00:22:17,080 --> 00:22:21,490
وأيضاً... كانت تستخدم نعيم جاكال

296
00:22:21,490 --> 00:22:24,700
كانت تُمارس نفس الأعمال
مع دايغ غالّوس في نهاية المطاف

297
00:22:24,700 --> 00:22:25,750
أجل

298
00:22:28,510 --> 00:22:31,810
،أخبريني بالتّفاصيل في وقت آخر
عندما تشعرين بأنّكِ على طبيعتكِ

299
00:22:34,040 --> 00:22:35,420
سأُرافقكِ إلى المنزل

300
00:22:35,940 --> 00:22:37,720
أشكرك جزيل الشّكر

301
00:22:40,410 --> 00:22:42,090
!لماذا أوقفتِها؟

302
00:22:42,090 --> 00:22:45,890
!كان ينبغي أن تدعيها تموت فحسب

303
00:22:47,850 --> 00:22:50,440
!كونّي، أيّتها الغبيّة، لماذا أنقذتِها؟

304
00:22:50,440 --> 00:22:51,830
!كانت هي

305
00:22:51,830 --> 00:22:53,620
—كانت هي السّبب فيما حدث لي

306
00:22:53,100 --> 00:22:54,400
!وماذا لو كان كذلك؟

307
00:22:54,400 --> 00:22:57,610
وقاحة منها أن تسعى للموت
!بسبب ما قلتِه

308
00:22:59,190 --> 00:23:03,610
كيف لي أن أسمح لها بجعلكِ
!عذرها حتّى النّهاية؟

309
00:23:07,210 --> 00:23:08,360
...فضلاً عن ذلك

310
00:23:08,910 --> 00:23:13,120
قد نفقد فُرصتنا للحصول على مزيد
من أطراف الخيط إذا ماتت آيشا الآن

311
00:23:13,840 --> 00:23:17,650
انتقامكِ لم يكتمل بعد، أنسيتِ؟

312
00:23:18,610 --> 00:23:24,380
هناك مَن بدّل الأقراط، وليلي-ساما
ودايغ غالّوس

313
00:23:24,380 --> 00:23:26,130
لم نحلّ شيئاً

314
00:23:27,260 --> 00:23:30,640
اسمعي يا سكارليت، التزمتُ

315
00:23:31,760 --> 00:23:37,150
بقضاء بقيّة حياتي وأنا أحرص
!على تحقيق انتقامكِ

316
00:23:39,260 --> 00:23:43,260
أحياناً، لديكِ أسلوب في الكلام يا فتاة

317
00:23:45,730 --> 00:23:48,950
عبارة كهذه أكبر من حجمكِ