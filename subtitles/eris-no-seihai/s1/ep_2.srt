1
00:00:00,530 --> 00:00:02,980
ان.... انتقامك؟

2
00:00:03,450 --> 00:00:09,740
سنُرسل كلّ وغد من الأوغاد الّذين
لهم صِلة بإعدامي إلى الجحيم

3
00:00:09,740 --> 00:00:10,680
ماذا؟

4
00:00:10,680 --> 00:00:14,740
حـ-حسناً... من يكونون بالضّبط؟

5
00:00:14,740 --> 00:00:16,350
لا أعلم

6
00:00:16,900 --> 00:00:19,690
وما أدراني؟ فقد تمّ الإيقاع بي

7
00:00:19,690 --> 00:00:22,860
،تمّ إعدامي لتسميمي سيسيليا

8
00:00:22,860 --> 00:00:27,000
لكن بالطّبع لا يمكن أن ألجأ
لفعل عابر كهذا

9
00:00:27,000 --> 00:00:29,500
!تقصدين أنّكِ... كنتِ بريئة؟

10
00:00:29,500 --> 00:00:31,510
،لهذا السّبب يا كونستانس

11
00:00:32,220 --> 00:00:37,540
ستصبحين عميلتي، وتكشفين
...عن الجاني الحقيقيّ

12
00:00:37,540 --> 00:00:40,010
!وتُذيقينه جحيم الأرض

13
00:00:40,010 --> 00:00:42,830
لـ-لا يمكن أن أفعل

14
00:00:42,830 --> 00:00:45,090
أعلم بأنّ عائلتك غارقة في الدَّين

15
00:00:45,090 --> 00:00:48,240
ماذا ستفعلين الآن بعد أن فسختِ خطوبتكِ؟

16
00:00:48,240 --> 00:00:50,390
!لم أفعل! لم أكن أنا

17
00:00:50,390 --> 00:00:52,520
!أنتِ من فعل ذلك

18
00:00:52,520 --> 00:00:54,020
...بالإضافة إلى ذلك

19
00:00:54,020 --> 00:00:57,860
هل رفض ردّ المعروف لي
بعد أن ساعدتُكِ في الأمس

20
00:00:57,860 --> 00:01:00,790
يُمثّل صدق عائلة غريل بالنّسبة لكِ؟

21
00:01:03,590 --> 00:01:06,790
!ما-ماذا ستطلبين منّي أن أفعل؟

22
00:02:40,970 --> 00:02:44,520
أ-أستميحك عذراً على التّواصل
بهذا الشّكل المُفاجئ

23
00:02:44,870 --> 00:02:48,910
أتيتُ بالنّيابة عن أورليموندي

24
00:02:48,910 --> 00:02:50,710
اسمي ليتّي

25
00:02:50,710 --> 00:02:55,760
تريد العائلة جمع رسائل من دار
موريس للأطفال اليتامى

26
00:02:55,760 --> 00:02:58,070
إحياء لذكرى وفاة ليلي-ساما في هذا اليوم

27
00:02:58,070 --> 00:03:00,940
رائع! سيفرح الأطفال

28
00:03:00,940 --> 00:03:02,480
تفضّلي بالدّخول

29
00:03:05,820 --> 00:03:07,290
...أوّلاً

30
00:03:07,290 --> 00:03:11,350
يمكنكِ البدء بسؤال أولئك
الّذين قد يعلمون ما حدث

31
00:03:11,350 --> 00:03:13,370
مـ-مثل ماذا؟

32
00:03:13,370 --> 00:03:14,800
...دعيني أفكّر

33
00:03:15,060 --> 00:03:18,170
أعتقد بأنّ ليلي أورليموندي ستكون نافعة

34
00:03:18,170 --> 00:03:21,930
...ماذا؟ ليلي-ساما؟ لكنّها

35
00:03:23,260 --> 00:03:25,940
كانت ليلي-ساما صديقة سكارليت-ساما

36
00:03:26,430 --> 00:03:28,280
،عقب وفاة سكارليت-ساما

37
00:03:28,280 --> 00:03:31,930
كرّستْ نفسها لفعل الخير
للتّكفير عن جرائمها

38
00:03:32,470 --> 00:03:36,690
لقّبها النّاس بزنبقة الأعمال الخيريّة
البيضاء نظراً لنزاهتها

39
00:03:36,690 --> 00:03:38,770
أعجبتُ بها

40
00:03:40,490 --> 00:03:44,760
لكن قبل عامين، تجرّعتْ سُمّاً

41
00:03:44,760 --> 00:03:49,960
وأنهتْ حياتها في مُصلّى عائلتها

42
00:03:50,760 --> 00:03:52,750
أجد صعوبة في تصديق هذا

43
00:03:52,750 --> 00:03:55,700
مُحال لتلك المرأة سيّئة الطّبع
أن تختار الانتحار

44
00:03:55,700 --> 00:03:57,770
سـ-سيّئة الطّبع؟

45
00:03:57,770 --> 00:04:00,220
ألم تكونا صديقتين منذ الطّفولة؟

46
00:04:00,220 --> 00:04:02,880
!لا تقولي كلاماً مُفزِعاً كهذا

47
00:04:02,880 --> 00:04:07,210
أُفضّل الوقوف على يدي والرّقص على حافّة
!مُنحدر على مُرافقتها

48
00:04:07,210 --> 00:04:14,730
لـ-لكن كانت ليلي-ساما تزوركِ كثيراً
في السّجن في حين أنّه لم يفعل أحدٌ آخر ذلك

49
00:04:14,730 --> 00:04:16,380
تزروني؟

50
00:04:16,380 --> 00:04:18,250
تقصدين تلك الزّيارات

51
00:04:20,030 --> 00:04:22,790
أصبحتِ مُستهترة يا سكارليت

52
00:04:23,360 --> 00:04:27,250
لم أحاول تسميم سيسيليا أبداً

53
00:04:27,250 --> 00:04:28,860
لا أشكّ في ذلك

54
00:04:28,860 --> 00:04:31,400
لكن هذا يُزيد الأمور سوءاً ليس إلّا

55
00:04:32,930 --> 00:04:37,530
أقصد أنّ شخصاً هناك استطاع إلباس
التّهمة لامرأة بقدرتكِ

56
00:04:37,950 --> 00:04:41,910
وما زلنا لا نملك فكرة من يكون

57
00:04:42,240 --> 00:04:45,920
لذا أتيتُ اليوم لأودّعكِ

58
00:04:46,220 --> 00:04:48,150
،بقدر ما أكره الاعتراف بذلك

59
00:04:48,150 --> 00:04:50,680
أظنّ أنّ هذا العمل يفوق قدرتي

60
00:04:51,790 --> 00:04:53,500
سامحيني

61
00:04:53,500 --> 00:04:56,980
،كنتُ لأتمنّى مُساعدتكِ إن أمكن

62
00:04:58,090 --> 00:05:02,390
لكن أثمّن حياتي أكثر من حياتكِ

63
00:05:03,450 --> 00:05:06,180
،إذا كانت قد انتحرتْ فعلاً

64
00:05:06,180 --> 00:05:11,010
فهذا يعني أنّ الأحداث خرجتْ
عن سيطرتها بطريقة ما

65
00:05:11,410 --> 00:05:16,050
لا بُدّ أنّ لهذا صِلة ما بانتقامي

66
00:05:16,050 --> 00:05:17,480
حدسي يخبرني بذلك

67
00:05:17,480 --> 00:05:19,910
كـ-كيف لكِ أن تكوني واثقة هكذا؟

68
00:05:19,910 --> 00:05:22,040
!انتظر

69
00:05:20,670 --> 00:05:22,040
!أنت سريع جدّاً بالنّسبة لنا

70
00:05:25,450 --> 00:05:26,480
تفضّلي

71
00:05:27,220 --> 00:05:29,910
شكراً لكم جميعاً على هذه الرّسائل

72
00:05:30,350 --> 00:05:32,570
سأحرص على إيصالها إلى ليلي-ساما

73
00:05:32,570 --> 00:05:33,090
ممتاز

74
00:05:33,090 --> 00:05:33,480
أنت

75
00:05:33,850 --> 00:05:35,910
حريّ بنا أن نعود بسرعة يا جورج

76
00:05:35,910 --> 00:05:37,970
أ-أجل. أعلم يا توني

77
00:05:37,970 --> 00:05:39,830
!إلى اللّقاء يا آنسة

78
00:05:44,700 --> 00:05:47,490
أثق بأنّكِ تتذكّرين ما يجب فعله يا فتاة

79
00:05:58,010 --> 00:06:01,790
أنا آسفة جدّاً. هذه عاداتنا

80
00:06:02,020 --> 00:06:04,420
لا، سيَفي هذا بالغرض

81
00:06:04,420 --> 00:06:06,210
شكراً جزيلاً لكِ

82
00:06:17,070 --> 00:06:20,570
المعذرة. أنا من دار موريس للأطفال اليتامى

83
00:06:20,570 --> 00:06:22,570
...تخليداً لذكرى ليلي-ساما

84
00:06:28,800 --> 00:06:31,490
ادخلي. من هنا

85
00:06:31,490 --> 00:06:33,030
شكراً جزيلاً لك

86
00:06:34,070 --> 00:06:37,020
كـ-كدتُ أموت من الرُّعب

87
00:06:37,020 --> 00:06:39,110
بغضّ النّظر، سار كلّ شيء بسلاسة

88
00:06:50,750 --> 00:06:53,600
هنا لقتْ ليلي-ساما حتفها

89
00:06:54,950 --> 00:06:56,800
هنا على ما أعتقد

90
00:06:57,230 --> 00:06:58,270
...لحظة

91
00:06:58,600 --> 00:07:01,060
ماذا تفعلين يا فتاة؟

92
00:07:01,060 --> 00:07:04,610
في الواقع، أنا أصلّي لأجلها

93
00:07:04,610 --> 00:07:09,320
هُراء. الصّلوات لن تُسعدها

94
00:07:09,320 --> 00:07:10,780
...ليلي

95
00:07:11,350 --> 00:07:16,610
كانت لتخبركِ بأن تسرعي وتجدي
الحقيقة بطريقتها السّاخرة تلك

96
00:07:17,950 --> 00:07:21,120
،أنا متأكّدة بأنّها تركت طرف خيط ما

97
00:07:21,600 --> 00:07:25,630
وفي مكان مُغيظ ما لا يمكن
أن يخطر على بال أحد

98
00:07:26,480 --> 00:07:29,640
أيُعقَل... خلف إطار اللّوحة؟

99
00:07:29,970 --> 00:07:31,670
طبعها يسمح لها بفعل ذلك

100
00:07:32,130 --> 00:07:34,640
يـ-يا له من مكان إخباء مُنتهك للقدسيّات

101
00:07:35,560 --> 00:07:36,940
ما هذا؟

102
00:07:38,070 --> 00:07:40,630
!يوجد شيء فعلاً هنا

103
00:07:48,150 --> 00:07:49,510
!أخبئيه

104
00:07:49,510 --> 00:07:50,650
!حـ-حسناً

105
00:08:02,170 --> 00:08:03,160
...ما

106
00:08:03,160 --> 00:08:05,660
،ماذا تفعل هنا

107
00:08:05,660 --> 00:08:07,660
!يا راندولف أولستر؟

108
00:08:11,940 --> 00:08:14,290
كانت ليلي مُتزوّجة؟

109
00:08:14,290 --> 00:08:19,090
أجل. من الإيرل راندولف أولستر
من عائلة ريتشيليو

110
00:08:19,090 --> 00:08:22,630
راندولف؟! ذلك الرّجعيّ العنيد؟

111
00:08:22,630 --> 00:08:24,300
تعرفينه؟

112
00:08:24,750 --> 00:08:26,990
إنّه عدوّي اللّدود

113
00:08:28,290 --> 00:08:31,820
"يُلقّبه النّاس بـ"حصّاد الموتى

114
00:08:32,120 --> 00:08:35,250
أستميحكِ عذراً. أنتِ من دار موريس
للأطفال اليتامى؟

115
00:08:35,820 --> 00:08:39,320
أ-أجل. ا-اسمي ليتّي

116
00:08:39,320 --> 00:08:42,200
لقد... بدأتُ العمل هناك مؤخّراً

117
00:08:42,200 --> 00:08:47,090
فهمت. كنتُ غالباً ما ألعب مع فتى
أحمر الشّعر

118
00:08:47,090 --> 00:08:49,060
أعتقد بأنّ اسمه كان جورج

119
00:08:49,060 --> 00:08:50,210
هل هو بخير؟

120
00:08:50,550 --> 00:08:52,200
—بـ-بالطّ

121
00:08:52,200 --> 00:08:54,710
انتظري. زرنا الميتم مؤخّراً فحسب، أتتذكّرين؟

122
00:08:55,100 --> 00:08:57,560
كان لدى جورج شعر كستنائيّ

123
00:08:57,560 --> 00:09:00,590
الفتى ذو الشّعر الأحمر بهذا السنّ
كان توني على الأغلب

124
00:09:01,150 --> 00:09:05,720
المعذرة... هل تقصد توني ربّما؟

125
00:09:06,960 --> 00:09:11,480
،هناك فتى أصغر سنّاً يُدعى جورج
لكن لديه شعر كستنائيّ

126
00:09:12,600 --> 00:09:15,780
أجل. قصدتُ توني

127
00:09:15,780 --> 00:09:16,990
!يا لوقاحتي

128
00:09:17,220 --> 00:09:20,110
لـ-لا أحد معصوم عن الخطأ

129
00:09:20,110 --> 00:09:22,260
...حسناً إذاً، إن سمحت لي

130
00:09:23,760 --> 00:09:24,990
أختاه

131
00:09:25,750 --> 00:09:28,630
الطّرُق خطيرة بالنّسبة لامرأة
تمشي بمفردها

132
00:09:28,630 --> 00:09:31,140
إذا سمحتِ لي، سأوصلكِ إلى الميتم

133
00:09:31,140 --> 00:09:34,880
لـ-لا مُشكلة! أنا... لديّ عمل لأقوم به

134
00:09:34,880 --> 00:09:36,770
رغم أنّني مُمتنّة لعرضك

135
00:09:37,240 --> 00:09:39,260
لذا، طاب يومك يا مولايّ

136
00:09:47,270 --> 00:09:49,100
!كنتُ خائفة جدّاً

137
00:09:49,100 --> 00:09:51,130
لم ألتقِ بشخص مُخيف هكذا من قبل

138
00:09:51,130 --> 00:09:53,670
هـ-هل تعتقدين بأنّه يشكّ بي؟

139
00:09:53,670 --> 00:09:55,160
لا أدري

140
00:09:56,040 --> 00:10:01,470
لطالما كان ذلك الرّجل يملك حاسّة
شمّ حادّة لدرجة تضرّه أكثر ممّا تنفعه

141
00:10:17,020 --> 00:10:19,540
عليكِ التخلّص من هذا القماش

142
00:10:19,870 --> 00:10:22,000
بعد أن كانت الرّاهبات لطيفات
بما يكفي لإعطائها لي؟

143
00:10:36,720 --> 00:10:38,510
كيريكي كيريكوكو

144
00:10:41,280 --> 00:10:43,790
كـ-كيريكوكي؟

145
00:10:43,790 --> 00:10:45,540
رأيت؟ أخبرتُك بذلك

146
00:10:45,540 --> 00:10:47,850
أنت تقلق كثيراً دوماً يا توني

147
00:10:47,850 --> 00:10:50,570
اصمت. ما شأنك أنت؟

148
00:10:50,570 --> 00:10:52,780
أخبرني، ماذا كان ذلك؟

149
00:10:53,560 --> 00:10:54,680
تعويذة

150
00:10:54,680 --> 00:10:55,790
تعويذة؟

151
00:10:55,790 --> 00:10:59,580
أجل. لكشف الأشرار

152
00:10:59,580 --> 00:11:01,790
ليلي-ساما علّمتنا إيّاها

153
00:11:01,790 --> 00:11:04,810
هي؟ متى؟

154
00:11:05,540 --> 00:11:07,310
قبل موتها

155
00:11:07,800 --> 00:11:09,710
"كيريكي كيريكوكو"

156
00:11:09,710 --> 00:11:13,210
إذا أصابني مكروه

157
00:11:13,210 --> 00:11:17,830
،وجاء النّاس يسألون عنّي
فرتّلوا هذه التّعويذة

158
00:11:18,290 --> 00:11:22,830
إذا استجابوا لها ولو قليلاً، فسوف
تعلمون بأنّهم أناس أشرار

159
00:11:23,500 --> 00:11:28,220
إذا حدث ذلك، فيجب علينا لملمة
الجميع واللّوذ بالفرار

160
00:11:28,810 --> 00:11:30,640
ما معنى هذا؟

161
00:11:30,640 --> 00:11:32,820
...هل يُعقَل أنّ

162
00:11:33,310 --> 00:11:35,200
ليلي-ساما قد قُتِلت؟

163
00:11:41,910 --> 00:11:43,530
أنا مُرهقة

164
00:11:47,140 --> 00:11:48,450
هل نفتحه؟

165
00:11:54,360 --> 00:11:55,600
مفتاح؟

166
00:11:56,120 --> 00:11:57,470
...مكتوب

167
00:12:00,230 --> 00:12:03,150
"دمّر كأس أيريس المُقدّس"

168
00:12:04,610 --> 00:12:06,660
كأس أيريس المُقدّس؟

169
00:12:08,750 --> 00:12:11,500
ما معنى هذا بالضّبط؟

170
00:12:11,500 --> 00:12:13,490
لا تسأليني

171
00:12:13,880 --> 00:12:18,500
الورقة بحدّ ذاتها تبدو كجزء
من كُتيّب خاصّ للسّائحين

172
00:12:18,920 --> 00:12:24,430
أيريس هي إلَهة النّزاع والخِلاف
في أسطورة فارس

173
00:12:24,430 --> 00:12:27,950
إنّها إلَهة شرّيرة. يُقال بأنّها
دفعتْ دولة إلى الدّمار

174
00:12:28,830 --> 00:12:32,630
هذه أسطورة من البلد المُجاور أديلبايد

175
00:12:33,100 --> 00:12:37,870
أيريس" هو أيضاً اسم استخدمتُه"
عندما انغمستُ في حياة اللّيل

176
00:12:37,870 --> 00:12:39,530
هـ-هكذا إذاً

177
00:12:39,940 --> 00:12:42,600
والآن، ماذا عن المفتاح؟

178
00:12:42,600 --> 00:12:43,670
...في الواقع

179
00:12:44,550 --> 00:12:48,960
لديه رقم، لكن لا شيء يُشير
إلى الورشة الّتي صنعته

180
00:12:48,960 --> 00:12:52,590
لا أعتقد بأنّ لدينا أدلّة كافية
لمعرفة الغرض منه

181
00:12:53,030 --> 00:12:54,110
صحيح

182
00:12:54,110 --> 00:12:58,200
رغم ذلك... لم تكن امرأة عاديّة

183
00:13:01,630 --> 00:13:03,980
هل ينبغي أن تستيقظي في هذا
الوقت المُبكّر جدّاً؟

184
00:13:05,160 --> 00:13:07,560
بعد فسخ خطوبتكِ بهذا الشّكل

185
00:13:08,070 --> 00:13:11,800
هذا صحيح. فسختُ خطوبتي

186
00:13:11,800 --> 00:13:14,930
وحتّى أنّ الحفل وصل إلى الصُّحُف

187
00:13:14,930 --> 00:13:16,060
!الصُّحُف؟

188
00:13:16,950 --> 00:13:24,760
المسكينة كونستانس غريل تُثبت أنّه حتّى الحمل"
"يمكن أن يهزم كلبَ صيد عندما يُستفزّ

189
00:13:24,760 --> 00:13:27,260
أو هذا ما ارتأته صحيفة زهرة مايو البارحة

190
00:13:27,570 --> 00:13:30,080
يـ-يا إلهي

191
00:13:30,390 --> 00:13:34,580
وقالوا بأنّ باميلا عادت إلى منطقة
عائلتها في اليوم التّالي

192
00:13:36,030 --> 00:13:40,870
هذا "لأجل صحّتها"، لكن أيّ شخص
يستطيع أن يرى بأنّها لاذت بالفرار

193
00:13:40,870 --> 00:13:42,290
...يا للدّهشة

194
00:13:42,890 --> 00:13:49,720
بالنّسبة لنيل، العُملاء الأرستقراطيّون لشركة
برونسون قد بدؤوا بحملة مُقاطعة

195
00:13:49,720 --> 00:13:51,600
،على ذكر الأمر

196
00:13:52,160 --> 00:13:55,960
أتى نيل للاعتذار وطلب
غفراني في هذا الصّباح

197
00:13:55,960 --> 00:13:59,200
أخبرتُه أن يوقف النّاس ويمنعهم
،من استهدافهم

198
00:13:59,600 --> 00:14:01,570
لذا ينبغي لتلك الأمور أن تهدأ قريباً

199
00:14:01,570 --> 00:14:04,250
أنا متأكّدة بأنّه كان يفكّر في نفسه فقط

200
00:14:05,110 --> 00:14:09,690
ربّما، لكنّه اعتذر، حتّى لو لم يكن يعني ذلك

201
00:14:09,690 --> 00:14:11,860
فضلاً عن ذلك، كان نيل هو المسؤول

202
00:14:11,860 --> 00:14:15,620
الأشخاص الّذين يعملون لشركة
برونسون لم يرتكبوا أيّ خطأ

203
00:14:15,620 --> 00:14:20,130
كونّي، أنتِ صادقة بشكل مُبالغ به

204
00:14:20,410 --> 00:14:23,830
معها حقّ! ما كان ينبغي أن تُسامحيه أبداً

205
00:14:24,310 --> 00:14:25,720
...رغم ذلك يا كونّي

206
00:14:26,380 --> 00:14:30,420
أصبحتِ نجمة شهرة بين ليلة
وضُحاها، لذا توخّي الحذر

207
00:14:30,420 --> 00:14:32,630
أعني أين كنتِ في الأمس؟

208
00:14:33,540 --> 00:14:37,390
...في الواقع، أردتُ أن أكون لوحدي، لذا

209
00:14:41,930 --> 00:14:43,960
لا مُشكلة

210
00:14:43,960 --> 00:14:46,890
لن أتطفّل حتّى تشعري برغبة في إخباري

211
00:14:46,890 --> 00:14:47,930
...لذا

212
00:14:48,400 --> 00:14:52,400
من الأفضل أن تأتي إليّ عندما
تحتاجين مُساعدة

213
00:14:52,730 --> 00:14:54,140
!كيت

214
00:14:55,250 --> 00:14:58,220
!على أيّ حال، الخيانة بغيضة

215
00:14:58,220 --> 00:15:00,780
—أعتقد بأنّكِ لن تتقبّلي الرّجال بعد

216
00:15:01,780 --> 00:15:04,000
...مهلاً. أليس هذا

217
00:15:04,890 --> 00:15:08,170
فهمت. هكذا هو الأمر

218
00:15:08,170 --> 00:15:10,930
!تنظرين للمُستقبل بالفعل

219
00:15:11,910 --> 00:15:13,420
هذه الدّعوة هنا

220
00:15:13,850 --> 00:15:18,980
سمعتُ أنّ كثيراً من الوسيمين حضروا
حفلات إيميليا غودوين الرّاقصة

221
00:15:18,980 --> 00:15:20,180
...لحظة يا كيت

222
00:15:20,180 --> 00:15:22,000
!لا ألومكِ يا كونّي

223
00:15:22,000 --> 00:15:26,950
قرأتُ في رواية أنّ وحده الحُبّ الجديد
!يمكنه أن يشفي قلباً مفطوراً

224
00:15:26,950 --> 00:15:28,440
!آمل أن تجدي شخصاً مُميّزاً

225
00:15:28,440 --> 00:15:29,430
—ليس وكأنّ

226
00:15:29,670 --> 00:15:31,320
!افعليها يا كونّي

227
00:15:33,170 --> 00:15:36,040
أ-أساءت الفهم بفكرة غريبة

228
00:15:38,240 --> 00:15:39,350
ما هذه البطاقة؟

229
00:15:40,800 --> 00:15:44,460
دعواتها عديمة الذّوق كما أتذكّرها

230
00:15:44,850 --> 00:15:50,180
أنا متأكّدة بأنّها تريدكِ أن تُشعلي
شرارة الإشاعات. فقد سبّبتِ فضيحة

231
00:15:50,180 --> 00:15:53,600
هل أنتِ على معرفة بالبارونة غودوين؟

232
00:15:53,600 --> 00:15:56,320
أجل، أعرفها خير معرفة

233
00:15:57,220 --> 00:16:00,730
!سنحضر حفل إيميليا الرّاقص يا كونستانس

234
00:16:01,720 --> 00:16:06,290
إنّها تعشق السّخرية من مصائب الآخرين

235
00:16:07,740 --> 00:16:11,040
مضى عشر سنوات، لكن إذا
،لعبنا بأوراقنا كما ينبغي

236
00:16:11,040 --> 00:16:14,580
فسوف تُغنّي لنا كما الكناري
في موسم تزاوج

237
00:16:20,230 --> 00:16:23,250
هل أنتِ جاهزة يا كونستانس؟

238
00:16:25,690 --> 00:16:28,310
تنتظرنا حفلة مُبهجة

239
00:16:38,500 --> 00:16:40,980
مساء الخير يا إيميليا

240
00:16:41,630 --> 00:16:43,900
مساء الخير يا آيشا

241
00:16:43,900 --> 00:16:45,620
ومن قد يكون هذا؟

242
00:16:46,760 --> 00:16:48,350
شخص مُميّز بالنّسبة لي

243
00:16:48,350 --> 00:16:50,710
...هكذا إذاً

244
00:16:56,740 --> 00:16:58,910
مساء الخير

245
00:16:59,530 --> 00:17:02,660
عجباً! يا لها من خيبة أمل

246
00:17:03,280 --> 00:17:07,840
تبدو أكثر أناقة من قبل، لكن
لا تزال بعيدة جدّاً عن سكارليت

247
00:17:08,870 --> 00:17:13,500
شكراً جزيلاً لكِ على دعوتي في هذا
المساء، يا آنسة غودوين

248
00:17:14,780 --> 00:17:16,920
يا له من فستان جميل ترتدينه

249
00:17:18,600 --> 00:17:23,060
،بشعركِ الّذي يشبه زهرة عبّاد الشّمس
يُلائمكِ بصورة مثاليّة

250
00:17:26,490 --> 00:17:29,430
ماذا؟ هل قلتُ كلاماً خاطئاً؟

251
00:17:29,880 --> 00:17:32,380
...لكن فعلتُ ما أمليتِه عليّ

252
00:17:32,380 --> 00:17:33,640
!يا إلهي

253
00:17:33,640 --> 00:17:36,410
إنّها خجولة مثلما أتذكّرها

254
00:17:39,840 --> 00:17:43,720
ماذا الآن؟ غادرتْ إيميليا

255
00:17:43,720 --> 00:17:44,570
ماذا؟

256
00:17:44,570 --> 00:17:46,630
هناك آيشا سبينسر

257
00:17:46,630 --> 00:17:48,780
كم تغيّرت

258
00:17:49,030 --> 00:17:50,270
!يا له من وقت مثاليّ

259
00:17:50,270 --> 00:17:53,250
لديّ عمل معها. اذهبي
واستمعي إلى ما لديها

260
00:17:54,720 --> 00:17:56,550
!إ-إنّه هو

261
00:18:00,800 --> 00:18:03,040
!سـ-سـ-سكارليت-ساما، هذه هي إشارتكِ

262
00:18:03,040 --> 00:18:06,090
لا أعتقد ذلك! لا أتحمّل هذا الرّجل

263
00:18:07,210 --> 00:18:08,990
!ماذا؟

264
00:18:09,320 --> 00:18:11,760
من اللّطف أن أراكِ ثانية يا أختاه

265
00:18:12,310 --> 00:18:15,260
أ-أعتقد أخطأتَ الشّخص

266
00:18:15,260 --> 00:18:16,520
حقّاً؟

267
00:18:16,810 --> 00:18:20,330
قبل أيّام، التقيتُ براهبة تكلّمت
بلا لكنة أصليّة

268
00:18:20,330 --> 00:18:22,240
،وكان لديها يدين صافيتين

269
00:18:22,670 --> 00:18:25,400
وانحنتْ كآنسة لبِقة

270
00:18:27,170 --> 00:18:28,210
...بالإضافة إلى ذلك

271
00:18:28,210 --> 00:18:34,170
شعرها عسليّ وعيناها خضراوتان
برّاقتان مثلكِ تماماً

272
00:18:34,430 --> 00:18:36,350
ا-المُصادفات قد تحدث

273
00:18:36,350 --> 00:18:39,760
في هذه الحالة، سأكون صريحاً
يا كونستانس غريل

274
00:18:39,760 --> 00:18:41,720
ما هو هدفكِ؟

275
00:18:43,080 --> 00:18:45,060
ماذا أخذتِ من المُصلّى؟

276
00:18:45,060 --> 00:18:48,200
وصيّة زوجتي الرّاحلة؟ أو ما شابه ذلك؟

277
00:18:48,200 --> 00:18:50,560
...لا، في الواقع

278
00:18:50,830 --> 00:18:53,510
!فـ-فلينقذني أحد ما

279
00:18:53,510 --> 00:18:56,440
بئساً! هل يجب أن أفعل كلّ شيء؟

280
00:18:56,440 --> 00:18:57,490
،تنحّي جانباً

281
00:18:57,490 --> 00:18:58,750
!يا كونستانس

282
00:19:03,070 --> 00:19:04,080
ما الأمر؟

283
00:19:04,620 --> 00:19:07,320
تبدو مُتيقّناً بشكل فظيع

284
00:19:07,640 --> 00:19:10,290
أنا واثقة بأنّ لديك دليل إذاً

285
00:19:11,290 --> 00:19:13,290
!سكارليت-ساما

286
00:19:13,650 --> 00:19:18,540
من المُؤكّد أنّك لن تُعامل فتاة حسّاسة
كلصّة من دون سبب وجيه

287
00:19:19,150 --> 00:19:21,790
لا أعتقد بأنّ ما فعلتُه
كان يستحقّ إهانة كهذه

288
00:19:21,790 --> 00:19:25,300
إذاً هل نزور دار موريس للأطفال
اليتامى زيارة أُخرى؟

289
00:19:25,680 --> 00:19:28,430
إذا استطاعوا التّأكيد

290
00:19:28,430 --> 00:19:33,150
بأنّكِ لستِ نفس ليتّي الّتي أتت
،باسم أورليموندي

291
00:19:33,150 --> 00:19:35,320
فسأعترف بأنّني كنتُ مُخطئاً

292
00:19:35,320 --> 00:19:37,720
!يعرف كلّ شيء

293
00:19:37,720 --> 00:19:39,330
أنا مُضطرّة للرّفض

294
00:19:39,640 --> 00:19:43,590
،في حين أنّ اهتمامك هو شرف لي

295
00:19:43,590 --> 00:19:48,820
إلّا أنّ قيمتي أعلى بكثير من أن أُرتّب
مُواعدة مع رجل التقيتُه للتو

296
00:20:00,870 --> 00:20:03,850
!جنَتْ على نفسها، العاهرة

297
00:20:03,850 --> 00:20:05,580
!أخذتْ زوجي

298
00:20:06,410 --> 00:20:08,160
مـ-من هما؟

299
00:20:08,160 --> 00:20:10,700
تيريسا جينينغز ومارغوت تودور

300
00:20:11,100 --> 00:20:15,760
يبدو أنّ تيريسا كانت تُقيم علاقة
مع زوج مارغوت

301
00:20:15,760 --> 00:20:16,610
!ماذا؟

302
00:20:17,600 --> 00:20:19,890
لا يبدو الجرح عميقاً

303
00:20:19,890 --> 00:20:20,860
هل أنتِ بخير؟

304
00:20:20,860 --> 00:20:23,430
ما زال بمقدورنا تعقيمه من باب الحيطة

305
00:20:29,820 --> 00:20:33,600
لن أتحرّى حول المسألة أكثر اليوم

306
00:20:34,940 --> 00:20:36,120
...رغم ذلك

307
00:20:36,120 --> 00:20:39,630
هل يمكنكِ أن تخبريني وبكلّ
صدق بأنّكِ غير معنيّة؟

308
00:20:43,560 --> 00:20:46,130
هذا كثير على تلك الحفلة

309
00:20:46,130 --> 00:20:49,340
وأنا الّتي تمنّيتُ أن أسأل إيميليا وآيشا

310
00:20:57,600 --> 00:21:00,360
تُذكّرينني بشخص

311
00:21:00,890 --> 00:21:04,660
.إلّا أنّكِ لا تشبهينها إطلاقاً
سخيف، أليس كذلك؟

312
00:21:05,180 --> 00:21:07,160
تقصدين سكارليت كاستيل؟

313
00:21:08,300 --> 00:21:12,150
أعتقد بأنّ قول كلام كهذا لفتاة عاديّة مثلكِ

314
00:21:12,560 --> 00:21:15,120
سيدعني أتلقّى توبيخاً شديداً

315
00:21:17,560 --> 00:21:21,670
قبل عشر سنوات، لماذا أُعدِمَتْ سكارليت؟

316
00:21:21,670 --> 00:21:23,090
هل تعلمين؟

317
00:21:23,470 --> 00:21:27,080
لأنّها حاولت تسميم وليّة العهد سيسيليا

318
00:21:27,080 --> 00:21:28,420
...رغم ذلك

319
00:21:29,730 --> 00:21:31,920
تُذكّرينني بها حقّاً

320
00:21:36,010 --> 00:21:40,370
القسم السّابع من أعماق مارس

321
00:21:40,370 --> 00:21:41,940
...الدّعوة

322
00:21:41,940 --> 00:21:44,950
موجودة في قُبّعة الإيرل جون دو

323
00:21:49,760 --> 00:21:52,440
الرّابحون في الحياة هم أولئك النّاجون

324
00:21:53,960 --> 00:22:00,460
لذا احرصي على ألّا تُجبَري على
الخروج المُبكّر يا كونستانس غريل

325
00:22:17,200 --> 00:22:19,090
كيريكي كيريكوكو