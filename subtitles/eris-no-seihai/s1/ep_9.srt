1
00:00:01,530 --> 00:00:05,600
هل كان سموّك من أرسل
سكارليت إلى منصّة الإعدام؟

2
00:00:06,320 --> 00:00:08,370
ما الّذي يجعلكِ تعتقدين ذلك؟

3
00:00:08,820 --> 00:00:12,850
الدّليل الدّامغ في مُحاولة اغتيال سيسيليا

4
00:00:13,200 --> 00:00:16,670
كان زُجاجة السُّمّ الّتي عُثِر
عليها في غرفة سكارليت

5
00:00:17,450 --> 00:00:21,660
تسلّل أحدهم إلى منزل دوق ودسّها
في غرفة ابنته

6
00:00:22,680 --> 00:00:25,680
شخص واحد فقط من يستطيع
،فعل ذلك دون ترك أثر

7
00:00:27,220 --> 00:00:28,650
وذلك الشّخص هو أنت

8
00:00:30,240 --> 00:00:33,890
أنت من رتّبَ لإعدام سكارليت

9
00:02:05,670 --> 00:02:09,470
الغريب أنّني وهو وُلِدنا في نفس اليوم

10
00:02:10,160 --> 00:02:14,670
،أجل، أنا قادر على مُفاجأة نفسي حتّى

11
00:02:15,300 --> 00:02:18,770
لكن ما زلتُ أرغب في خدمتك

12
00:02:18,770 --> 00:02:20,730
لذا اعتزّ بنفسك يا إيرن

13
00:02:21,170 --> 00:02:24,190
دولفي، كفاك مُزاحاً

14
00:02:25,580 --> 00:02:28,250
أتزوّج من جديد؟ أنا؟

15
00:02:28,650 --> 00:02:31,750
جمهوريّة سولديتا تتوسّلني

16
00:02:31,750 --> 00:02:35,530
لآخذ سليلة كورنيليا فاريس عنهم

17
00:02:36,920 --> 00:02:41,890
لا أثق بنسَب يُشكّل خطراً
على أيّ عائلة نبيلة

18
00:02:42,300 --> 00:02:46,510
لذا، أنت خياري الحقيقيّ الوحيد

19
00:02:47,180 --> 00:02:50,450
عجباً... الأشياء الّتي أفعلها لأجلك

20
00:02:56,550 --> 00:02:58,890
اسمي أليينور شيبولا

21
00:02:59,660 --> 00:03:04,570
عروستي من وراء البحار تُجسّد
حرفيّاً الزّوجة الصّالحة

22
00:03:06,900 --> 00:03:12,560
كان عيبها الوحيد صحّتها الواهنة

23
00:03:13,270 --> 00:03:18,330
لكن لم يمضِ وقت طويل حتّى أنجبنا سكارليت

24
00:03:18,990 --> 00:03:21,110
لم يكن بيدي حيلة

25
00:03:22,160 --> 00:03:24,420
!أقول لك بأنّ الأمر خرج عن سيطرتي

26
00:03:26,710 --> 00:03:28,690
!يا لكِ من جميلة

27
00:03:29,170 --> 00:03:31,680
!ولا تبكي أمام أنظاري

28
00:03:31,930 --> 00:03:35,790
ديلان، لا تلمسها كثيراً. ماذا لو
نقلت عدوى غبائك إليها؟

29
00:03:35,790 --> 00:03:37,190
!أنت

30
00:03:37,190 --> 00:03:41,070
!هل سمعت ذلك يا سيّدي؟
!هل كان هناك ضرورة لذلك؟

31
00:03:41,070 --> 00:03:44,710
أجل، سمعت، وأنا أشاركه نفس القلق

32
00:03:44,710 --> 00:03:47,280
حريّ بك أن تُعيد لي عزيزتي سكارليت

33
00:03:47,280 --> 00:03:49,200
!ماذا أفعل؟! أنا مُحاط بالأعداء

34
00:03:53,010 --> 00:03:56,700
بتذكُّر الماضي، لعلّ تلك كانت
الأيّام الأخيرة

35
00:03:56,700 --> 00:03:59,810
الّتي نضحك فيها معاً في نعيم الجهل

36
00:04:01,910 --> 00:04:05,490
انتشرت أنباء عن أنّ مادّة مُلهوِسة
غريبة تمّ تداولها مُؤخّراً

37
00:04:05,490 --> 00:04:06,590
!مُخدِّر؟

38
00:04:07,010 --> 00:04:10,790
،إنّه مشهور تحديداً بين الأرستقراطيّين الشّباب

39
00:04:11,290 --> 00:04:13,860
ما يجعلني أتساءل كيف يحصلون عليه

40
00:04:13,860 --> 00:04:17,070
وحدهم النّبلاء البارزين يملكونه

41
00:04:17,740 --> 00:04:20,610
وماذا تُدعى هذه المادّة المُلهوِسة؟

42
00:04:20,610 --> 00:04:22,740
نعيم جاكال

43
00:04:23,660 --> 00:04:27,320
آنذاك، بدتْ مسألة تافهة

44
00:04:28,720 --> 00:04:31,150
...لكن ذات يوم، بعد أشهر عديدة

45
00:04:31,710 --> 00:04:34,420
!حُبِس ديلان بتهمة الخيانة؟

46
00:04:34,680 --> 00:04:39,430
أجل. نظراً للظّروف، أشكّ في أنّه
يستطيع تجنُّب الجلّاد

47
00:04:40,070 --> 00:04:41,890
!هذا مُحال

48
00:04:41,890 --> 00:04:44,170
بالطّبع، مُحال أن يكون ديلان خائناً

49
00:04:44,710 --> 00:04:47,160
لا بُدّ أنّ شخصاً قد ألبسَه التّهمة

50
00:04:47,160 --> 00:04:49,110
...وهدفه هو

51
00:04:50,150 --> 00:04:52,560
هل تقصد... الحرب؟

52
00:04:52,940 --> 00:04:57,560
إنّها فاريس. كانوا يُدبّرون المكيدة
من وراء الكواليس

53
00:04:58,100 --> 00:05:00,140
كأس إيريس المُقدّس"؟"

54
00:05:01,190 --> 00:05:06,720
.ديلان هو العمود الفقريّ للدّفاع عن حدودنا
سيغزوننا حالما يموت

55
00:05:07,200 --> 00:05:11,220
ثمّ سُرعان ما حُكِم على ديلان
...بالإعدام والسّبب

56
00:05:11,710 --> 00:05:15,330
أجل. هناك جواسيس في صفوفنا

57
00:05:16,270 --> 00:05:21,980
هل يُعقَل أنّ دايغ غالّوس يستخدمون
المُخدِّر لكسب تمويل؟

58
00:05:21,980 --> 00:05:25,440
نظراً لشعبيّة المُخدّر لدى
،طبقة النُّبلاء العليا

59
00:05:25,440 --> 00:05:28,960
ينوون إضعاف دولتنا من الدّاخل حتماً

60
00:05:28,960 --> 00:05:33,510
وفي خضمّ كلّ هذا، تألّق نجم شخص واحد

61
00:05:34,970 --> 00:05:36,970
!سيمون داركيان

62
00:05:38,390 --> 00:05:40,550
!استجوبه حالاً

63
00:05:40,550 --> 00:05:43,590
إنّه يتظاهر بالجهل

64
00:05:44,050 --> 00:05:45,780
لا نملك دليلاً

65
00:05:45,780 --> 00:05:47,740
!يا لها من كارثة

66
00:05:49,630 --> 00:05:56,070
هل تهمة التّسميم بحقّ سكارليت
هي جزء من خطّتهم كذلك؟

67
00:05:56,400 --> 00:05:59,020
لا، لا بُدّ أنّها صدفة

68
00:05:59,020 --> 00:06:02,080
لا يملكون دافعاً لأذيّة سكارليت

69
00:06:02,360 --> 00:06:07,750
هذا صحيح... يريدونها أن تعتلي العرش

70
00:06:08,440 --> 00:06:12,950
،هذا يعني أنّه بدون سكارليت
ستفشل خطّتهم

71
00:06:12,950 --> 00:06:14,310
...في هذه الحالة

72
00:06:21,530 --> 00:06:24,320
!ما الّذي أُفكّر فيه؟

73
00:06:31,120 --> 00:06:34,950
سيّدي، أقترح أن نستغلّ سكارليت

74
00:06:36,180 --> 00:06:42,650
تتطلّب خطّتهم بيدقاً يمتلك دماء
العائلة الإمبراطوريّة القديمة

75
00:06:43,240 --> 00:06:48,270
إعدام سكارليت سيُكسبنا مخرجاً

76
00:06:48,270 --> 00:06:54,220
سيُؤخّرهم ويُخلّف انطباعاً بأنّ
الإعدامات العلنيّة همجيّة

77
00:06:54,810 --> 00:06:58,870
سأكلّف كيمبيرلي سميث من رابطة
البنفسج بقيادة الاحتجاج

78
00:06:59,510 --> 00:07:03,260
هذا سيسمح لنا بتأخير إعدام ديلان

79
00:07:03,260 --> 00:07:04,980
لحظة، لحظة، لحظة

80
00:07:05,370 --> 00:07:08,650
في هذه الأثناء، سأحصل على دليل على براءته

81
00:07:08,650 --> 00:07:10,240
!انتظر يا دولفي

82
00:07:10,240 --> 00:07:11,230
!جلالتك

83
00:07:12,980 --> 00:07:18,160
احفظ وجه كلّ شخص يستنجد
للحفاظ على حياة سكارليت

84
00:07:18,820 --> 00:07:22,990
سيكون عملاؤهم بينهم

85
00:07:27,250 --> 00:07:31,500
سنُريهم جميعاً بأنّنا سنكون نحن

86
00:07:32,370 --> 00:07:35,230
من يضحك أخيراً

87
00:07:41,250 --> 00:07:46,060
،بفرض أنّني هيّأتُ الأمور لإعدام ابنتي

88
00:07:46,520 --> 00:07:49,150
بما يفيدك ذلك؟

89
00:07:50,340 --> 00:07:51,850
أنا أفعل هذا لأجلها

90
00:07:52,490 --> 00:07:53,630
لأجلها"؟"

91
00:07:54,540 --> 00:07:57,780
هلّا منحتني إذناً بالتكلُّم؟

92
00:07:58,370 --> 00:08:00,660
أجل، تفضّلي

93
00:08:16,610 --> 00:08:18,180
كيف حالكِ؟

94
00:08:19,490 --> 00:08:23,430
لو لم أكن أعلم، لظننتُك قلقاً عليّ

95
00:08:23,430 --> 00:08:27,370
أنا كذلك بالطّبع.. فأنتِ زوجتي

96
00:08:29,950 --> 00:08:31,750
...اسمع يا عزيزي

97
00:08:33,180 --> 00:08:36,080
لا تتفوّه بهذا الهراء أمامي

98
00:08:37,320 --> 00:08:42,300
امرأة لا تنام معها ولا تراها إلّا
لتبادل التّحيّة بين الحين والآخر

99
00:08:42,300 --> 00:08:45,430
لا يمكن أن تُناديها بزوجة

100
00:08:45,970 --> 00:08:49,010
العلاقة بيننا مُجرّد معرفة عابرة

101
00:08:50,560 --> 00:08:53,460
هل أنتِ غاضبة؟

102
00:08:53,460 --> 00:08:58,720
أطلب منك فقط أن تعفيني
من حماقتك أيّها المُغفَّل

103
00:08:59,010 --> 00:09:00,410
ماذا تقصدين؟

104
00:09:00,410 --> 00:09:04,860
لا يمكنك أن تتأمّل من شابّة أن تفصح بكلّ شيء

105
00:09:06,240 --> 00:09:08,990
،قد أكون فتاة صغيرة سخيفة

106
00:09:09,450 --> 00:09:13,850
مع ذلك حتّى أنا أعلم بأنّ الدّم
في عروقي قد يشعل شرارة

107
00:09:15,170 --> 00:09:18,830
لكن هل تتوقّع منّي أن أبتسم
وأتحمّل ذلك فحسب؟

108
00:09:19,240 --> 00:09:23,110
أن أقبل بحياة أُعامَل فيها كسجينة؟

109
00:09:23,610 --> 00:09:27,240
ما يكون هذا سوى موتاً في الحياة؟

110
00:09:30,150 --> 00:09:35,990
أعتقد بأنّني أودّ أن أكون أنانيّة جدّاً
وأتلفّظ ببعض الكلام القاسي تجاهك

111
00:09:35,990 --> 00:09:37,180
ماذا؟

112
00:09:44,670 --> 00:09:50,290
أعتقد عندما يقول مُعظم النّاس "كلاماً
قاسياً"، فهُم يقصدون كلاماً فعلاً

113
00:09:50,630 --> 00:09:52,780
سامحيني

114
00:09:52,780 --> 00:09:58,650
في المكان الّذي أنحدر منه، نتكلّم
مع المُغفّلين بقبضتنا

115
00:09:58,650 --> 00:10:01,660
يا له من مكان خالٍ من القانون

116
00:10:01,660 --> 00:10:06,020
فكّرتُ كثيراً منذ مجيئي إلى هذا البلد

117
00:10:07,020 --> 00:10:11,790
وقرّرتُ أن أعيش حياتي كيفما
أشاء في نهاية المطاف

118
00:10:12,160 --> 00:10:16,280
كانت تلك وصيّة عزيزتنا كورنيليا قبل وفاتنا

119
00:10:16,680 --> 00:10:18,510
كانت؟

120
00:10:18,510 --> 00:10:20,680
...أجل. ولذا

121
00:10:21,040 --> 00:10:24,710
إن كان لديك شكوى، فقُلها لكورنيليا فاريس

122
00:10:30,600 --> 00:10:31,680
...أنا

123
00:10:31,680 --> 00:10:33,930
!فعلتُ فعلتي حقّاً

124
00:10:34,750 --> 00:10:37,060
أرجو أن تُسامحيني

125
00:10:37,060 --> 00:10:42,890
لكن علّمتني أمّي أن أتكلّم
مع المُغفّلين بقبضتي

126
00:10:43,900 --> 00:10:49,460
كـ-كان ذلك، المعذرة، عادة من ديار
!أمّ صديقتي

127
00:10:49,910 --> 00:10:51,390
صديقتكِ...؟

128
00:10:51,390 --> 00:10:55,450
أ-أجل، شيء ما حول أفضل
طريقة للتّعامل مع المُغفّلين

129
00:10:57,020 --> 00:11:02,470
لكن لا أقصد نعت سموّك بالمُغفّل

130
00:11:03,890 --> 00:11:06,700
يا لها من صفعة ضعيفة

131
00:11:06,700 --> 00:11:09,390
كانت مُؤلمة أكثر آنذاك

132
00:11:11,040 --> 00:11:15,220
حسناً، ماذا تريد صديقتكِ أيضاً؟

133
00:11:15,680 --> 00:11:19,310
هل أعطيها رأسي كذلك؟

134
00:11:19,600 --> 00:11:22,110
!ا-ا-انسَ الأمر

135
00:11:22,110 --> 00:11:23,470
حقّاً؟

136
00:11:23,470 --> 00:11:26,610
إذا احتجتِه يوماً، فيمكنك أن تطلبي فحسب

137
00:11:29,740 --> 00:11:31,370
...هل تريد سموّك

138
00:11:32,470 --> 00:11:34,190
أن تموت؟

139
00:11:37,440 --> 00:11:39,370
لا بُدّ أنّ الأمر كذلك

140
00:11:39,840 --> 00:11:43,150
كنتُ أتوق للموت، أليس كذلك؟

141
00:11:46,630 --> 00:11:51,350
...أستحقّ العقوبة. خِلاف ذلك

142
00:11:51,900 --> 00:11:57,800
.إنّها مسكينة لدرجة لا يمكن وصفها
جُرِّدت من حياتها بلا ذنب منها

143
00:12:01,550 --> 00:12:02,660
كونّي

144
00:12:09,550 --> 00:12:11,280
...لو سمحت

145
00:12:12,620 --> 00:12:18,040
لم أعتبر نفسي مسكينة يوماً

146
00:12:20,180 --> 00:12:24,050
أجل، اعتراني غضب وحزن كذلك

147
00:12:24,420 --> 00:12:27,400
لكن أعلم كم أنّك أخرق وذو كبرياء يا أبي

148
00:12:27,400 --> 00:12:28,820
لم يكن بيدك حيلة

149
00:12:31,130 --> 00:12:34,110
ولا تملك سبباً للشّفقة عليّ

150
00:12:34,780 --> 00:12:36,700
...فأساساً، أعلم

151
00:12:37,870 --> 00:12:40,810
بأنّني وُلِدتُ محبوبة

152
00:12:43,130 --> 00:12:48,470
حتّى أنا أعلم بأنّك أحببتني يا أبي

153
00:13:00,290 --> 00:13:05,110
،أودّ أن أقول لك أشياء كثيرة
،لكن بالنّسبة لبقيّة شِكاياتي

154
00:13:05,930 --> 00:13:10,220
حسناً، أعتقد بأنّ عليّ أن أقولها
لكورنيليا فاريس فحسب

155
00:13:13,190 --> 00:13:14,620
هكذا إذاً

156
00:13:15,510 --> 00:13:17,760
لا بُدّ أنّك تعلم ما يعنيه ذلك

157
00:13:18,500 --> 00:13:22,340
أعلم. أعلم، حسناً

158
00:13:24,310 --> 00:13:26,800
لطالما كانت أمّي تقول ذلك

159
00:13:30,660 --> 00:13:32,310
...سكارليت

160
00:13:34,180 --> 00:13:37,180
سأجعل تابوتكِ مصنوعاً من الكهرمان الأسود

161
00:13:37,180 --> 00:13:41,160
إنّه خشبٌ مُقدّس وقيل بأنّه يهدي
الأرواح إلى الأرض الموعودة

162
00:13:41,580 --> 00:13:47,410
ولن أنسى بطّانيةً مُحاكة بشرانق دودة القمر

163
00:13:47,410 --> 00:13:49,720
لا أريدكِ أن تبردي

164
00:13:50,280 --> 00:13:53,770
هل تتذكّرين كيف كنتِ تُصابين
بنزلة برد عندما كنتِ صغيرة؟

165
00:13:53,770 --> 00:13:57,290
،كنتِ سرعان ما تُصابين بحُمّى
لدرجة لم أستطع الإشاحة بأنظاري عنكِ

166
00:13:58,100 --> 00:14:02,990
وجدتُها. لِمَ لا أُضيف نقوشاً جميلة
على تابوتكِ؟

167
00:14:03,570 --> 00:14:07,540
لن ترضي بما هو قليل أبداً

168
00:14:08,890 --> 00:14:12,960
...لطالما كنتِ طموحة فعلاً

169
00:14:18,560 --> 00:14:23,500
،ولو كانت هناك أي وسيلة أُخرى
!لبذلتُ الغالي والّنفيس لأجل ذلك

170
00:14:24,070 --> 00:14:28,380
كنتُ مُستعدّاً للتّضحية بحياتي مراراً

171
00:14:29,260 --> 00:14:34,810
!ليتني أخبرتُكِ ولو لمرّة واحدة بأنّني أُحبّكِ

172
00:14:53,590 --> 00:14:57,370
من فضلك، ابذلي قصارى جهدكِ لأجلها

173
00:14:59,610 --> 00:15:02,910
سيمون داركيان مع دايغ غالّوس؟

174
00:15:03,410 --> 00:15:07,120
اشترتْ سيسيليا مؤخّراً مشفى القدّيس نيكولاس

175
00:15:07,750 --> 00:15:13,340
عندما امتلكَه كامبيل، قام مُفتّشو الضّرائب
بمنح تراخيص حتّى لكُتُب فارغة

176
00:15:13,930 --> 00:15:18,430
هل تقصد بأنّ سيمون داركيان كان
مسؤولاً عن عمليّات التّفتيش تلك؟

177
00:15:18,430 --> 00:15:20,200
هذا ما أقصده

178
00:15:20,620 --> 00:15:24,800
رجل يُدعى إدموند بارك، الّذي
،تولّى حساب المشفى

179
00:15:24,800 --> 00:15:26,640
عُثِر عليه ميّتاً

180
00:15:26,640 --> 00:15:28,650
لإسكاته غالباً

181
00:15:29,300 --> 00:15:31,690
ما يعني بأنّهم احتفظوا بالكُتُب السّرّيّة

182
00:15:36,720 --> 00:15:38,550
أأتمنك على هذا الأمر

183
00:15:38,550 --> 00:15:39,330
حاضر

184
00:15:40,320 --> 00:15:44,340
بالمُناسبة... سمعتُ بأنّ سيمون أولستر قد تُوفّي

185
00:15:45,250 --> 00:15:48,640
عزائي لك. متى الجنازة؟

186
00:15:49,470 --> 00:15:52,020
اليوم، للمُقرّبين من العائلة فقط

187
00:15:52,850 --> 00:15:55,090
هل ستذهب لوحدك؟

188
00:15:55,350 --> 00:15:56,490
أجل. لماذا؟

189
00:15:59,600 --> 00:16:03,340
لا أستطيع القول بأنّه تغيّرت أمور
كثيرة من ناحيتنا

190
00:16:03,710 --> 00:16:08,830
ما زال الامير الثّاني روديريك يتجنّب
الظّهور أمام العامّة

191
00:16:08,830 --> 00:16:14,630
ما زالت الأميرة الثّالثة أليكساندرا محبوسة
في البرج وفي طريقها للاحتراق

192
00:16:15,020 --> 00:16:20,210
والأمير الرّابع تيوفيليس يتصرّف
من الآن كما لو أنّه الملك

193
00:16:20,210 --> 00:16:24,370
سمعتُ بأنّ أتباعه حدّدوا تاريخاً
حتّى من أجل تتويجه

194
00:16:24,690 --> 00:16:28,150
إذاً لا بُدّ أنّ من يقف خلف
...كأس إيريس المُقدّس

195
00:16:28,150 --> 00:16:32,380
بالفعل، يبدو أنّ الأمير الرّابع تيوفيليس
هو المُشتبه به الواضح

196
00:16:32,380 --> 00:16:34,760
!مهلاً يا كونّي

197
00:16:35,050 --> 00:16:36,370
ميليني

198
00:16:36,370 --> 00:16:37,510
من هؤلاء الآنسات؟

199
00:16:39,310 --> 00:16:41,510
كنّا سنُغادر للتو

200
00:16:42,740 --> 00:16:45,740
ميليني، كيف حال عملكِ؟

201
00:16:46,480 --> 00:16:51,070
أكتب مقالات لأبيعها للصُّحُف في طريقي
لأصبح صحفيّة حقيقيّة

202
00:16:51,070 --> 00:16:54,660
آخر مقالة لي هي حول الموت
المُريب لإدموند بارك

203
00:16:54,660 --> 00:16:56,620
مَن إدموند بارك؟

204
00:16:56,990 --> 00:17:00,600
رئيس شركة مُحاسبة. عُثِر عليه قتيلاً

205
00:17:00,600 --> 00:17:03,540
يبدو بأنّه كان ثأراً مُتعلّقاً بالعمل

206
00:17:03,540 --> 00:17:08,660
عملاؤه يشملون شركة الغُراب
التّجاريّة ومشفى القدّيس نيكولاس

207
00:17:08,900 --> 00:17:11,660
هل قالت مشفى القدّيس نيكولاس؟

208
00:17:11,660 --> 00:17:18,290
أخبريني يا ميليني، أليس مشفى القدّيس
نيكولاس هو من كان يُديره الإيرل كامبيل؟

209
00:17:18,290 --> 00:17:20,600
!أرى بأنّكِ تعرفين كلّ شيء عن الأمر

210
00:17:20,600 --> 00:17:26,310
بيننا فحسب، سمعتُ بأنّ إدموند بارك
والإيرل كامبيل كانا صديقَين في المُراهنات

211
00:17:26,630 --> 00:17:31,310
ويبدو أنّ هناك وكراً للمُراهنات
كان يُفضّله بشكل خاصّ

212
00:17:31,310 --> 00:17:36,330
إنّه تحت مطعم يُدعى حافر الماعز

213
00:17:39,680 --> 00:17:41,570
ما الّذي تنتظره؟

214
00:17:42,850 --> 00:17:45,050
كيف أقحمتُ نفسي في هذا؟

215
00:17:45,050 --> 00:17:47,480
ماذا تفعلين في مكان كهذا؟

216
00:17:49,110 --> 00:17:52,840
يا إلهي! إنّها كيمبيرلي سميث
من رابطة البنفسج

217
00:17:53,360 --> 00:17:54,970
!إنّها لا ترتدي الورديّ؟

218
00:18:00,720 --> 00:18:02,040
طلباتك

219
00:18:02,040 --> 00:18:03,720
لحم بعظمه

220
00:18:03,720 --> 00:18:07,260
النّوع الّذي يبلغ أعلاه وأسفله سبعة

221
00:18:08,340 --> 00:18:10,310
إذاً هذا ما أتيتِ لأجله

222
00:18:10,310 --> 00:18:12,860
آسف، الطّابق السّفليّ غير مُتاح بعد

223
00:18:12,860 --> 00:18:14,610
!كم هذا مُؤسف

224
00:18:14,610 --> 00:18:18,860
لكن أتيتُ إلى هنا لآخذ شيئاً
لأجل إيد اليوم

225
00:18:19,640 --> 00:18:20,700
من هنا

226
00:18:30,480 --> 00:18:33,310
أعتقد بأنّكِ أتيتِ إلى هنا بخصوص
قضيّة إدموند بارك

227
00:18:33,310 --> 00:18:35,000
من أخبركِ؟

228
00:18:35,000 --> 00:18:37,580
صديقة. تريد أن تكون صحفيّة

229
00:18:37,580 --> 00:18:39,670
لديها مُستقبل واعد

230
00:18:40,090 --> 00:18:43,920
ألستِ مخطوبة لراندولف أولستر؟

231
00:18:44,460 --> 00:18:47,760
هل تعرفين من تكون عائلة أولستر هنا؟

232
00:18:49,050 --> 00:18:51,810
أولستر" ليس مُجرّد كنية"

233
00:18:51,810 --> 00:18:56,290
إنّه أيضاً لقب للعُملاء الّذين يتخلّصون
من أعداء العائلة الملكيّة

234
00:18:57,290 --> 00:18:58,810
عُملاء؟

235
00:18:59,150 --> 00:19:05,750
يخدم راندولف في الجيش الآن، لكن
الرّاحل سيمون أولستر درّبه

236
00:19:05,750 --> 00:19:08,550
رغم أنّ الواجب أصبح منذ زمن بعيد شكليّاً

237
00:19:09,060 --> 00:19:14,580
ا-المعذرة، لكن لماذا تخبرينني بهذا؟

238
00:19:15,040 --> 00:19:17,340
—سؤال وجيه. أنا أيضاً

239
00:19:19,140 --> 00:19:20,100
تفضّلي

240
00:19:20,400 --> 00:19:24,360
هذا هو. دفتر مُحاسبة سرّي حسبما سمعت

241
00:19:24,360 --> 00:19:26,540
أشكرك

242
00:19:34,740 --> 00:19:36,360
...أليس هؤلاء

243
00:19:36,360 --> 00:19:40,360
لا بُدّ أنّهم لا يريدوننا أن نقرأ الدّفتر السّرّي

244
00:19:41,170 --> 00:19:45,120
أبقي عينيكِ عليّ. ضعيه في مِحفظتكِ

245
00:19:46,860 --> 00:19:49,910
هذا كلّ ما أستطيع خدمتكِ به

246
00:19:49,910 --> 00:19:52,390
اخرجي من الباب الخلفيّ. أسرعي

247
00:19:52,390 --> 00:19:54,940
لكن ماذا عنكِ؟

248
00:19:56,100 --> 00:19:58,780
لستُ بحاجة عبء كبير

249
00:19:58,780 --> 00:20:02,380
تعلّمتُ من سيمون أولستر كذلك

250
00:20:08,390 --> 00:20:12,050
ينبغي أن يكون في جنازة سيمون الآن

251
00:20:13,140 --> 00:20:15,120
اعتني بالصّغير

252
00:20:30,130 --> 00:20:32,660
ليس هذا ما ينبغي أن تفعليه

253
00:20:34,150 --> 00:20:35,670
حسناً

254
00:20:55,590 --> 00:20:57,010
آنسة غريل؟

255
00:20:57,800 --> 00:20:59,960
رأيتُ بأنّها تُمطر

256
00:21:03,870 --> 00:21:05,410
ما الّذي جاء بكِ إلى هنا؟

257
00:21:05,410 --> 00:21:10,070
في الواقع، تركتْ كيمبيرلي هذا تحت رعايتي

258
00:21:14,860 --> 00:21:18,230
كم مرّة يجب أن أخبركِ ألّا تتصرّفي
من قرارة نفسكِ؟

259
00:21:18,230 --> 00:21:19,830
أ-أنا آسفة

260
00:21:20,250 --> 00:21:22,480
لكن فخامتك كنت بمفردك أيضاً

261
00:21:22,940 --> 00:21:26,090
لذا ألا نُعتبَر مُتعادلين اليوم؟

262
00:21:29,840 --> 00:21:31,610
ألا أُثير أعصابك؟

263
00:21:32,160 --> 00:21:33,340
عفواً؟

264
00:21:33,650 --> 00:21:37,480
...والدايّ، أخي، ليلي، عمّ أبي

265
00:21:37,480 --> 00:21:40,970
المُقرّبون منّي يموتون باستمرار

266
00:21:41,610 --> 00:21:46,210
ألا تعتقدين بأنّني بمثابة الموت بحدّ ذاته؟

267
00:21:49,500 --> 00:21:51,250
...خطيبتك

268
00:21:51,900 --> 00:21:56,530
،خسرتْ خطيبها لصالح امرأة أخرى
،وفُضِحت في حفل راقص

269
00:21:56,950 --> 00:21:59,800
،وتورّطتْ في حادثة إجراميّة تلو الأُخرى

270
00:22:00,610 --> 00:22:04,630
والأسوأ من كلّ ذلك، تمّت مُلاحقتها
بواسطة أخبث نساء العصر

271
00:22:05,440 --> 00:22:07,560
ألا يُثير هذا أعصابك؟

272
00:22:11,800 --> 00:22:14,530
لنغادر معاً، فخامتك

273
00:22:15,100 --> 00:22:15,950
حسناً