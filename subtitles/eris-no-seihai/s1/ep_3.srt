1
00:00:01,290 --> 00:00:06,740
لا بُدّ أنّ إيميليا كانت تتحدّث عن الحفل
الرّاقص الخاص بالإيرل جون دو

2
00:00:06,740 --> 00:00:08,080
جون دو؟

3
00:00:08,470 --> 00:00:11,250
اسم يشير إلى شخص عشوائيّ
غير ذي أهمّية

4
00:00:11,760 --> 00:00:16,980
وحفل راقص حيث يختبئ النُّبلاء
للاختباء خلف أقنعتهم

5
00:00:16,980 --> 00:00:19,730
لكن لِمَ دعوتي إلى هذا؟

6
00:00:20,180 --> 00:00:24,660
لعلّها ارتأت بأنّه سيكون المكان
الأنسب لجمع معلومات استخباراتيّة

7
00:00:25,170 --> 00:00:28,950
الأوغاد الّذين يغزون مثل هذه الحفلات
الرّاقصة لا يخشون حتّى الآلهة

8
00:00:28,950 --> 00:00:30,940
هكذا إذاً

9
00:00:32,460 --> 00:00:35,460
حسناً، ستحتاجين قناعاً

10
00:00:35,460 --> 00:00:38,390
سوف نتسلّل إلى داخل منزلي القديم يا كونستانس

11
00:00:38,720 --> 00:00:40,020
منزل كاستيل؟

12
00:00:40,020 --> 00:00:43,400
كنتُ زبونة مُنتظمة في تلك الحفلات

13
00:00:43,990 --> 00:00:51,650
قد يتقرّب منكِ شخصٌ يعرف شيئاً
إذا ارتديتِ قناعي القديم

14
00:00:51,650 --> 00:00:53,070
...لكن

15
00:00:53,070 --> 00:00:57,120
فضلاً عن ذلك، هذه فُرصة مؤاتية لكِ أيضاً

16
00:00:57,120 --> 00:00:58,650
ماذا تقصدين؟

17
00:00:58,960 --> 00:01:02,910
استخدمي عقلكِ. أقصد لتسديد ديونكِ بالطّبع

18
00:01:03,320 --> 00:01:08,020
كافّة الضّيوف سيكونون فاشلين
لديهم أسرار فاضحة

19
00:01:08,020 --> 00:01:11,520
اكتشفي ماهيّة تلك الأسرار
واستغلّيهم أكبر استغلال

20
00:01:11,930 --> 00:01:14,130
—مُحال أن أتمكّن

21
00:01:15,700 --> 00:01:17,930
لا، فهمت

22
00:01:19,280 --> 00:01:21,400
لم أفهم حتّى الآن

23
00:01:22,120 --> 00:01:24,010
"كوني صادقة"

24
00:01:24,510 --> 00:01:27,510
لطالما آمنتُ بأنّ ذلك كان
التصرُّف الصّحيح

25
00:01:28,870 --> 00:01:32,190
لكن خُدِع أبي، وباميلا ألبسَتْني تهمة

26
00:01:32,700 --> 00:01:35,920
الصّدق وحده لن يحلّ شيئاً

27
00:01:36,560 --> 00:01:40,010
سأصبح شرّيرة إذا كان ذلك ما يلزم

28
00:01:40,520 --> 00:01:41,700
...لذا

29
00:01:41,700 --> 00:01:44,200
خذيني إلى منزل كاستيل

30
00:01:44,630 --> 00:01:49,990
فرد من عائلة غريل يتخلّى عن صدقه
!الشّهير؟ يا له من أمر مُثير

31
00:03:21,530 --> 00:03:24,860
تمكّنتُ من جديد التسلّل إلى داخل
،مكان ما دون مشاكل على الأقلّ

32
00:03:25,460 --> 00:03:28,000
لكن هذا القصر ضخم! هائل
الحجم بصورة إيجابيّة

33
00:03:28,000 --> 00:03:30,100
ماذا تفعلين هناك يا فتاة؟

34
00:03:34,730 --> 00:03:36,300
سكارليت-ساما؟

35
00:03:36,610 --> 00:03:38,350
هل سمعتِني؟

36
00:03:38,350 --> 00:03:41,920
فـ-في الواقع... أنا في طريقي
إلى غرفة الملابس

37
00:03:41,920 --> 00:03:43,670
!أنا آسفة جدّاً! اعذرني رجاء

38
00:03:43,670 --> 00:03:44,800
انتظري

39
00:03:46,110 --> 00:03:48,240
أين هو عقلكِ؟

40
00:03:49,090 --> 00:03:50,870
غرفة الملابس في الاتّجاه الآخر

41
00:03:52,720 --> 00:03:54,610
شكراً جزيلاً لك

42
00:03:58,640 --> 00:03:59,880
...أخي

43
00:04:03,980 --> 00:04:05,790
لا يوجد شبه كبير، أليس كذلك؟

44
00:04:05,790 --> 00:04:07,390
تبدين تشبهينني كثيراً

45
00:04:07,890 --> 00:04:11,810
هالتكِ أقوى من هالتي. وشعوركِ
"بأنّكِ مُلزمة بمُناداتي "فتاة

46
00:04:11,810 --> 00:04:13,900
...وإهانتي لأتفه سبب

47
00:04:13,900 --> 00:04:16,270
أنتِ أوّل شخص يقول كلّ هذا الكلام

48
00:04:16,710 --> 00:04:18,280
أنا ذلك حقّاً؟

49
00:04:18,280 --> 00:04:21,580
لدينا والدتان مختلفتان في نهاية المطاف

50
00:04:24,430 --> 00:04:28,880
كونستانس، هل سمعتِ بكورنيليا
ذات التّاج المُرصّع بالنّجوم؟

51
00:04:28,880 --> 00:04:33,420
أجل، البلد المُجاور لنا فاريس
،كانت في السّابق إمبراطوريّة واسعة

52
00:04:33,420 --> 00:04:37,540
وكانت هي آخر إمبراطورة حكمتْ
أثناء سقوط الإمبراطوريّة، أليس كذلك؟

53
00:04:37,540 --> 00:04:39,560
أجل، تماماً

54
00:04:41,160 --> 00:04:45,230
انتهجت إمبراطوريّة فاريس استراتيجيّة

55
00:04:45,230 --> 00:04:50,670
الزّواج من العائلة الملكيّة للدّول
الّتي غزَتْها لحكمهم

56
00:04:51,310 --> 00:04:56,290
،ثمّ يهرب أمير إمبراطوريّ مع فتاة ما

57
00:04:56,290 --> 00:04:58,800
،وينجبان ابنة

58
00:04:59,540 --> 00:05:01,690
كورنيليا ذات التّاج المُرصَّع بالنّجوم

59
00:05:02,270 --> 00:05:09,190
نسبُها يمنحها الحقّ بولاية الدّول
،التّابعة البالغ عددها عدد النّجوم

60
00:05:09,190 --> 00:05:11,340
ناهيكِ عن العرش الإمبراطوريّ

61
00:05:11,880 --> 00:05:16,660
وأديلبايد كانت جزءاً من إمبراطوريّتها آنذاك

62
00:05:16,660 --> 00:05:17,820
أجل، كانت كذلك

63
00:05:18,920 --> 00:05:22,910
عندما تمرّدت الدّول التّابعة
،أخيراً وسقطت الإمبراطوريّة

64
00:05:22,910 --> 00:05:27,890
هربتْ إلى دولة سولديتا المُحايدة
لتجنُّب الأذى

65
00:05:28,350 --> 00:05:32,520
مضى الوقت، وانتشرت الأنباء
عن فتاة ريفيّة في سولديتا

66
00:05:32,520 --> 00:05:36,940
يجري في عروقها دم كورنيليا
ذات التّاج المُرصّع بالنّجوم

67
00:05:38,430 --> 00:05:43,360
أليينور غير المُتوّجة، كانت أمّي

68
00:05:43,770 --> 00:05:48,810
تقصدين بأنّكِ انحدرتِ من عائلة
فاريس الإمبراطوريّة؟

69
00:05:49,360 --> 00:05:51,180
انتهى وقت القصّة

70
00:05:51,180 --> 00:05:53,360
قناعي موجود في بدلة الدّرع تلك

71
00:05:53,360 --> 00:05:54,630
...حـ-حسناً

72
00:06:05,760 --> 00:06:07,400
دعوتكِ؟

73
00:06:10,200 --> 00:06:12,880
إنّها في قبّعة الإيرل جون دو

74
00:06:13,460 --> 00:06:16,740
أهلاً بكِ أيّتها الضّيفة غير المدعوّة

75
00:06:19,620 --> 00:06:20,770
...إذاً هذا

76
00:06:21,140 --> 00:06:23,360
الحفل الرّاقص للإيرل جون دو

77
00:06:27,000 --> 00:06:29,270
يا له من ذوق مُحبَّب لديهم

78
00:06:30,170 --> 00:06:31,880
لا تهتمّي

79
00:06:31,880 --> 00:06:34,160
سنذهب مباشرة لمُقابلة مُضيفاتنا

80
00:06:39,460 --> 00:06:43,540
.إذاً إنّه دور ديبورا هذه المرّة
توقّعتُ ذلك

81
00:06:44,520 --> 00:06:45,800
أنتِ

82
00:06:45,800 --> 00:06:47,260
ما اسمكِ؟

83
00:06:48,290 --> 00:06:49,970
من فضلكِ، ناديني إيريس

84
00:06:51,960 --> 00:06:54,570
يُعيدني هذا للذّكريات

85
00:06:54,570 --> 00:06:57,930
جاءتنا ضيفة بنفس الاسم
قبل عشر سنوات

86
00:06:57,930 --> 00:06:58,900
...لكن

87
00:06:59,790 --> 00:07:02,240
كانت فتاة طائشة

88
00:07:02,240 --> 00:07:05,730
سرعان ما انفصل رأسها عن جسدها

89
00:07:06,120 --> 00:07:11,230
آمل أن يكون رأسكِ مُثبتاً بإحكام

90
00:07:17,120 --> 00:07:19,710
أنا مُندهشة من قدرتكِ على الأكل

91
00:07:19,710 --> 00:07:21,950
كنتُ مُتوتّرة طوال هذا الوقت

92
00:07:21,950 --> 00:07:24,490
!يبدو هذا لذيذاً أيضاً

93
00:07:26,960 --> 00:07:29,200
...أشتمّ رائحة زكيّة

94
00:07:29,200 --> 00:07:32,080
هذا يُعيدني للذّكريات. إنّها جين

95
00:07:32,080 --> 00:07:33,230
جين؟

96
00:07:35,390 --> 00:07:36,970
من قد تكون؟

97
00:07:37,550 --> 00:07:41,360
آنسة إيريس على ما أعتقد؟

98
00:07:44,600 --> 00:07:47,850
كأنّه الفيكونت هامسورث

99
00:07:47,850 --> 00:07:49,610
...ا-المعذرة

100
00:07:49,610 --> 00:07:50,600
أستميحك عذراً

101
00:07:50,600 --> 00:07:54,600
نُخفي هويّاتنا الحقيقيّة خلف الأقنعة
في هذا الحفل الرّاقص السّرّي

102
00:07:54,870 --> 00:07:59,140
ناديني رجاء بـ... القمر المُرقَّط هام

103
00:07:59,140 --> 00:08:01,300
!من جديد، أنت لا تخفي شيئاً

104
00:08:06,230 --> 00:08:11,230
تختفي الشّجرة وسط الغابة" كما يقولون"

105
00:08:11,230 --> 00:08:14,680
لكن يا لها من خشبة فاسدة
يحضرها شخصٌ اللّيلة

106
00:08:14,680 --> 00:08:17,630
ألا تعتقدين ذلك يا آنستي؟

107
00:08:23,200 --> 00:08:25,650
!اهربوا! كشفَتنا قوّات الأمن

108
00:08:25,650 --> 00:08:26,940
!كشفوا ماذا؟

109
00:08:26,940 --> 00:08:27,890
!ما الّذي يجري؟

110
00:08:29,480 --> 00:08:30,800
!لقد هرب

111
00:08:31,730 --> 00:08:34,390
يبدو أنّني كنتُ مُحقّة بشأن أولئك الفتيات

112
00:08:35,470 --> 00:08:39,770
سمعتِ ما قاله الخنزير حديث النّعمة
بشأن الشّجرة في الغابة

113
00:08:40,270 --> 00:08:44,060
أحدهم كان يستخدم هذا الحفل بالكامل
كغطاء لعمليّة إتجار بالبشر

114
00:08:44,550 --> 00:08:46,050
...لـ-لا

115
00:08:46,050 --> 00:08:47,530
لا مزيد من الثّرثرة

116
00:08:47,530 --> 00:08:49,160
عليكِ أن تهربي

117
00:08:52,930 --> 00:08:55,350
!ماذا تفعلين؟! بسرعة

118
00:08:55,350 --> 00:08:56,750
...لـ-لكن

119
00:08:59,710 --> 00:09:01,140
!النّجدة

120
00:09:03,340 --> 00:09:05,430
لن يُساعدها أحد

121
00:09:05,430 --> 00:09:06,700
!ولا حتّى أحد

122
00:09:10,190 --> 00:09:11,440
!كونستانس؟

123
00:09:13,650 --> 00:09:15,440
أتذكّر هذه المرأة

124
00:09:15,820 --> 00:09:17,190
وشم؟

125
00:09:17,190 --> 00:09:19,090
!سيتمّ اعتقالك

126
00:09:19,090 --> 00:09:20,820
!اتركيها هناك فحسب

127
00:09:21,510 --> 00:09:22,570
!سكارليت

128
00:09:23,530 --> 00:09:25,080
آسفة. لا أستطيع فعل ذلك

129
00:09:27,710 --> 00:09:29,090
!كونّي، أيّتها الحمقاء

130
00:09:29,580 --> 00:09:31,830
!ستهلكين إذا قبضوا عليكِ

131
00:09:31,830 --> 00:09:34,590
حتّى لو لم ترتكبي أيّ خطأ

132
00:09:34,590 --> 00:09:37,350
!سيعدمونكِ دون تردُّد

133
00:09:37,350 --> 00:09:38,900
!أنا آسفة يا سكارليت

134
00:09:38,900 --> 00:09:39,850
!سامحيني

135
00:09:39,850 --> 00:09:42,730
إن كنتِ تشعرين برغبة في
!الاعتذار، فاهربي

136
00:09:42,730 --> 00:09:43,720
!أنتِ

137
00:09:44,920 --> 00:09:46,540
ماذا تفعلين؟

138
00:09:46,540 --> 00:09:48,350
!لـ-لا

139
00:09:54,190 --> 00:09:56,380
ماذا أفعل؟

140
00:09:56,740 --> 00:09:59,360
!أنا من ينبغي أن يسألك ذلك أيُّها الوقح

141
00:10:04,900 --> 00:10:07,320
!من أنتِ بالضّبط؟

142
00:10:09,780 --> 00:10:12,630
أتُشهر سيفك في وجه شابّة عزلاء؟

143
00:10:13,360 --> 00:10:15,130
إنّه ردّ عبثيّ

144
00:10:16,880 --> 00:10:19,370
!سـ-سيّد أولستر

145
00:10:19,370 --> 00:10:21,880
!لكن استخدمتْ خدعة غريبة ما

146
00:10:21,880 --> 00:10:27,510
هل ينبغي إعطاء هذا أولويّة
على إنقاذ الجرحى يا جيورغ غاينا؟

147
00:10:34,880 --> 00:10:38,310
أنتِ من جديد يا كونستانس غريل؟

148
00:10:39,170 --> 00:10:41,250
أ-أجل

149
00:10:43,170 --> 00:10:47,410
لأكون واضحاً فقط، هل لديكِ يد
في الإتجار بالبشر؟

150
00:10:49,910 --> 00:10:51,470
توقّعتُ ذلك

151
00:10:51,950 --> 00:10:54,420
إذاً لا أملك سبباً لاعتقالكِ

152
00:10:55,340 --> 00:10:58,670
رغم ذلك، لا بُدّ أنّ ثلاث لقاءات
عابرة تُمثّل القدر

153
00:10:59,440 --> 00:11:02,500
ألا تعتقدين بأنّه حان الوقت
لإخباري بالحقيقة؟

154
00:11:03,160 --> 00:11:04,670
...سكارليت

155
00:11:08,190 --> 00:11:10,810
استغلّيهم أحسن استغلال

156
00:11:11,470 --> 00:11:15,120
وُلِد السّيّد أولستر في كنف
عائلة ريتشيليو

157
00:11:15,120 --> 00:11:17,540
إنّهم نُبلاء عظماء، نظيرون لعائلة كاستيل

158
00:11:18,020 --> 00:11:19,220
...في هذه الحالة

159
00:11:19,820 --> 00:11:22,080
!هـ-هل ترغب في المُفاوضة؟

160
00:11:23,170 --> 00:11:27,400
بالطّبع. عائلة غريل مَدينة

161
00:11:27,400 --> 00:11:29,950
إن أردت معلومات، فادفع ثمنها"؟"

162
00:11:29,950 --> 00:11:31,950
!كشفَني فوراً

163
00:11:33,710 --> 00:11:35,330
أهذا هو مُقترحكِ؟

164
00:11:35,330 --> 00:11:37,010
أجل

165
00:11:37,010 --> 00:11:38,960
حسناً، لا أقول بأنّني أُمانع

166
00:11:40,580 --> 00:11:44,680
كونستانس غريل، هل أنتِ مُستعدّة
لتكبُّد عناء فضيحة؟

167
00:11:45,970 --> 00:11:48,270
تخلّيتُ عن صدقي

168
00:11:48,270 --> 00:11:50,500
سأتقبّل أيّ حياة تُفرَض عليّ

169
00:11:50,850 --> 00:11:52,590
فات الأوان قليلاً على القلق بشأن ذلك

170
00:11:52,590 --> 00:11:56,280
...فهمت. في هذه الحالة، الطّريقة الأبسط

171
00:11:57,060 --> 00:11:58,110
هي أن تُخطَبي

172
00:11:58,110 --> 00:11:59,550
!أنا مُوافقة

173
00:12:02,360 --> 00:12:04,310
جيّد. سنعتمد الأمر

174
00:12:05,020 --> 00:12:06,160
الخطوبة

175
00:12:06,610 --> 00:12:08,140
...ما-ما

176
00:12:08,730 --> 00:12:11,990
!ماذا؟

177
00:12:14,330 --> 00:12:17,450
...إ-إذاً، تـ-تريدان أن

178
00:12:18,220 --> 00:12:20,470
أن تعقدا خطوبتكما؟

179
00:12:20,470 --> 00:12:22,720
أجل. امنحنا هذا الشّرف رجاء

180
00:12:23,150 --> 00:12:25,270
...حـ-حسناً إذاً

181
00:12:25,790 --> 00:12:28,040
...عـ-عسى أن تُبارك

182
00:12:28,040 --> 00:12:30,780
الآلهة اتّحادكما

183
00:12:29,270 --> 00:12:31,100
!كيف وقعتُ في هذه الفوضى؟

184
00:12:31,100 --> 00:12:35,090
!بئساً! فهمتِ الآن سبب تجنُّبي له

185
00:12:36,830 --> 00:12:39,490
،والآن يمكنكِ تسوية ديون عائلة غريل

186
00:12:39,990 --> 00:12:42,490
ولديّ ذريعة للاستمرار في مُراقبتكِ

187
00:12:43,080 --> 00:12:47,190
بالطّبع، سيحقّ لكِ فسخ
خطوبتنا قريباً

188
00:12:47,190 --> 00:12:48,950
رغم ذلك، هل أنت متأكّد؟

189
00:12:48,950 --> 00:12:53,110
لا أرى أي منفعة كبيرة لسيادتك من خطوبتنا

190
00:12:53,620 --> 00:12:56,240
،لأصدقك القول، مهما كان الأمر سخيفاً

191
00:12:57,120 --> 00:12:58,490
لا أريد الزّواج

192
00:12:59,990 --> 00:13:03,010
لكن من المُؤكَّد أنّه تزوّج مرّة من قبل

193
00:13:03,440 --> 00:13:07,770
من الآنسة ليلي أورليموندي، الّتي
تُوفّيت قبل عامين

194
00:13:07,770 --> 00:13:12,090
على أيّ حال، ينبفي لامتلاك
خطيبة أن يكون رادعاً

195
00:13:12,670 --> 00:13:16,020
لذا من وجهة نظري، خطوبتنا نافعة جدّاً

196
00:13:17,340 --> 00:13:19,650
الآن، إلى العمل

197
00:13:22,890 --> 00:13:24,490
هكذا إذاً

198
00:13:24,490 --> 00:13:28,530
تريدين تبرئة شبح سكارليت
كاستيل من إدانتها الباطلة

199
00:13:28,910 --> 00:13:32,920
يا فتاة. ينبغي أن تتستّري على شيء فعلاً

200
00:13:32,920 --> 00:13:35,290
بصراحة، روايتكِ مُنافية للمنطق

201
00:13:35,770 --> 00:13:40,160
لكنّها... مُتوافقة بشكل غير مألوف مع الخيال

202
00:13:41,740 --> 00:13:47,750
ومظهركِ يشبه أحياناً مظهر
سكارليت كاستيل

203
00:13:48,150 --> 00:13:50,430
أكاد أعتقدكِ هي

204
00:13:52,690 --> 00:13:56,010
إذا أردتِ تبرئتها، فافعلي ما تشائين

205
00:13:56,420 --> 00:14:00,800
قد تكون ميّتة، لكن رغبتكِ في مُسعدة
الآخرين تبقى جديرة بالثّناء

206
00:14:00,800 --> 00:14:02,940
أشكرك

207
00:14:03,700 --> 00:14:04,950
على ماذا؟

208
00:14:04,950 --> 00:14:06,230
...في الواقع

209
00:14:06,660 --> 00:14:07,700
،بغضّ النّظر عن ذلك

210
00:14:08,040 --> 00:14:10,210
هل أنتِ متأكّدة بأنّكِ ما زلتِ
لا تُخفين شيئاً؟

211
00:14:15,690 --> 00:14:16,780
لا تفعلي

212
00:14:17,500 --> 00:14:19,120
ولا أيّ شيء

213
00:14:19,120 --> 00:14:20,210
هكذا إذاً

214
00:14:23,310 --> 00:14:24,420
سيادتك؟

215
00:14:24,790 --> 00:14:30,800
،كونستانس غريل، أو بالأحرى، الآنسة غريل
أوجّه لكِ تحذيراً لأجل مُستقبلكِ

216
00:14:33,410 --> 00:14:35,020
...أنتِ، في الواقع

217
00:14:36,130 --> 00:14:38,300
كاذبة مسكينة

218
00:14:42,390 --> 00:14:45,570
إذاً، ماذا ستفعلين الآن؟

219
00:14:46,390 --> 00:14:47,820
ماذا تقصدين؟

220
00:14:48,240 --> 00:14:51,830
أنا متأكّدة بأنّكِ سئمتِ مُساعدتي
على أيّ حال

221
00:14:51,830 --> 00:14:53,330
ماذا؟ لماذا؟

222
00:14:53,330 --> 00:14:56,580
أقصد بأنّ مشاكل دَينكِ قد حُلَّتْ

223
00:15:00,090 --> 00:15:02,470
لـ-لمَ تضحكين؟

224
00:15:02,470 --> 00:15:04,250
اسمعي يا سكارليت

225
00:15:04,250 --> 00:15:10,460
لطالما فقدتُ الامل من المُشكلات الّتي
أعجز عن حلّها كفتاة بائسة

226
00:15:10,460 --> 00:15:13,600
لكن في أعماقي، كنتُ أصرخ دوماً

227
00:15:13,600 --> 00:15:15,280
"!فليُنجدني أحدٌ ما"

228
00:15:17,240 --> 00:15:18,730
...ثمّ

229
00:15:19,190 --> 00:15:20,480
عظيم

230
00:15:20,480 --> 00:15:21,860
سأساعدكِ

231
00:15:26,230 --> 00:15:29,890
...على ذكر الأمر، لم أخبركِ من قبل

232
00:15:30,900 --> 00:15:32,720
شكراً لكِ على إنقاذي

233
00:15:37,610 --> 00:15:40,000
لذا، حان دوري لأنقذكِ الآن

234
00:15:42,260 --> 00:15:43,200
أليس كذلك؟

235
00:15:46,610 --> 00:15:48,070
كونّي الغبيّة

236
00:15:52,940 --> 00:15:55,770
ذلك الأحمق غاينا لا يفعل
!شيئاً بشكل صحيح

237
00:15:56,050 --> 00:15:57,260
ما الأمر؟

238
00:15:58,320 --> 00:16:02,260
أتتذكّر الإتجار بالبشر الّذي كشفنا
عنه في بناء مونتروز القديم؟

239
00:16:02,260 --> 00:16:06,350
تجّار العبيد الّذين قبضنا عليهم
آنذاك تجرّعوا السُّمّ وماتوا في السّجن

240
00:16:06,350 --> 00:16:10,900
!تعرف سرعتهم في القيام بذلك
!إنّ تقييدهم يُعدّ إجراء أساسيّاً

241
00:16:10,900 --> 00:16:14,150
كايل، هل كان عقلهم المُدبّر
يضع وشماً للشّمس؟

242
00:16:14,670 --> 00:16:17,520
لا، تفقّدتُ حتّى مؤخّراتهم

243
00:16:18,330 --> 00:16:23,040
يعني أنّهم لم يكن لديهم أي ارتباطات
بمُنظّمة دايغ غالوس

244
00:16:23,370 --> 00:16:25,620
أو تمّ التخلُّص منهم ببساطة

245
00:16:25,620 --> 00:16:27,750
حسناً، أرجّح الاحتمال الثّاني

246
00:16:28,570 --> 00:16:31,290
أعتقد عدنا إلى المُربّع الأوّل
في هذه القضيّة

247
00:16:31,610 --> 00:16:36,200
بالمُناسبة، ألم تكن تلك الفتاة في المشهد
ثانية؟ كونستانس غريل؟

248
00:16:38,840 --> 00:16:41,810
ماذا الآن؟ أنستدعيها للاستجواب؟

249
00:16:41,810 --> 00:16:43,210
لا ضرورة لذلك

250
00:16:43,210 --> 00:16:45,270
ماذا؟ استجوبتها للتو؟

251
00:16:45,270 --> 00:16:47,480
لا، أعلنّا خطوبتنا

252
00:16:49,940 --> 00:16:53,130
سأزور قصر إيلبايت معها غداً

253
00:16:53,130 --> 00:16:55,570
—توقّعتُ العودة بعد الظّهر، لكن

254
00:16:55,570 --> 00:16:58,310
مهلاً، مهلاً، مهلاً! مَن خُطِبَ لِمَن؟

255
00:16:58,910 --> 00:17:00,580
مَن غيري

256
00:17:00,920 --> 00:17:02,430
أنا وكونستانس غريل؟

257
00:17:02,430 --> 00:17:04,120
!ماذا؟

258
00:17:11,090 --> 00:17:12,510
حـ-حاضرة

259
00:17:13,740 --> 00:17:17,120
قال سيادته بأنّه أرادني
،أن ألتقي بصديق له

260
00:17:17,120 --> 00:17:20,490
لكن لم أتوقّع أنّه يقصد وليّ العهد

261
00:17:21,090 --> 00:17:25,560
ومن وجهة نظر سكارليت، هذا هو
الرّجل الّذي فسخ خطوبتنا

262
00:17:27,300 --> 00:17:29,640
!آسفة لتأخُّري

263
00:17:31,350 --> 00:17:33,200
!يا للمفاجأة

264
00:17:33,200 --> 00:17:35,350
!كم هذا أصيل! يا للظّرافة

265
00:17:35,350 --> 00:17:36,600
!أنا ظريفة؟

266
00:17:36,600 --> 00:17:38,100
لم يكن مديحاً

267
00:17:38,100 --> 00:17:39,580
لحظة، لم يكن كذلك؟

268
00:17:40,370 --> 00:17:43,120
اسمكِ كونستانس، أليس كذلك؟

269
00:17:43,120 --> 00:17:45,050
هلّا ناديتكِ كونّي؟

270
00:17:45,050 --> 00:17:46,370
بـ-بالطّبع

271
00:17:46,370 --> 00:17:49,240
ويجب أن تُناديني سيس

272
00:17:49,240 --> 00:17:52,210
،آسفة لتصرّفي غير اللّائق
—أو على الأقلّ

273
00:17:52,210 --> 00:17:55,630
لكن وُلِدتُ كابنة فيكونت مثلكِ

274
00:17:55,630 --> 00:17:57,630
...فهمت، لكن مع ذلك

275
00:17:57,630 --> 00:17:58,900
!وجدتُها

276
00:17:59,390 --> 00:18:02,100
ما رأيكِ أن نحتسي الشّاي معاً
في وقت قريب ما؟

277
00:18:02,100 --> 00:18:04,160
لن تُمانعي، أليس كذلك يا كونّي؟

278
00:18:04,160 --> 00:18:05,150
إ-إطلاقاً

279
00:18:05,500 --> 00:18:09,870
،أعلم بأنّه يبدو مُخيفاً، وهو مُخيف حقّاً

280
00:18:09,870 --> 00:18:11,600
لكنّه ليس شخصاً سيّئاً

281
00:18:11,600 --> 00:18:13,940
لذا افقدي الأمل منه، حسناُ؟

282
00:18:13,940 --> 00:18:15,900
...لا، أقصد

283
00:18:17,420 --> 00:18:19,400
!يُخيفني سيادته كثيراً

284
00:18:19,400 --> 00:18:21,590
انظري إلى هذا الوجه

285
00:18:21,590 --> 00:18:23,660
!ماذا يجدر بي أن أفعل؟
!إنّه يُخيفني أيضاً

286
00:18:28,940 --> 00:18:29,990
ماذا؟

287
00:18:30,720 --> 00:18:36,930
راندي. اختيار يوم لديّ التزامات
رسميّة فيه لم يكن لائقاً

288
00:18:37,610 --> 00:18:38,860
...لكن

289
00:18:39,950 --> 00:18:44,150
،رؤيتك في حالة استياء مُبهِجة ونادرة
لذا سوف أسامحك

290
00:18:47,720 --> 00:18:53,570
سأستقبل ضيفاً مُميّزاً من
الجنوب عقب هذا

291
00:18:53,570 --> 00:18:59,440
سيكون شرفاً لي رؤيتكما، ولو لوقت قصير

292
00:19:04,690 --> 00:19:06,450
إلى اللّقاء يا كونّي

293
00:19:07,410 --> 00:19:08,790
...باردة جدّاً

294
00:19:13,970 --> 00:19:16,950
تلك المرأة وقحة كعادتها

295
00:19:16,950 --> 00:19:20,850
حسناً، تجاهلي الأمر لأجلي

296
00:19:20,850 --> 00:19:24,900
لنغيّر الموضوع، هل سمعت
من مبعوث فاريس؟

297
00:19:25,590 --> 00:19:26,720
أتقول فاريس؟

298
00:19:27,170 --> 00:19:28,970
إنّهم مجموعة معتزّة بنفسها

299
00:19:29,420 --> 00:19:31,480
التّاريخ هو كلّ ما لديهم للتبجُّح به

300
00:19:31,950 --> 00:19:37,300
لن أتفاجأ إذا كانت مشاكلهم الاقتصاديّة
سيّئة كما صوّرتهم الإشاعة

301
00:19:42,210 --> 00:19:46,250
عندما التقت وليّة العهد سيسيليا أوّل مرّة
،بوليّ العهد إنريكي

302
00:19:46,250 --> 00:19:49,410
لا بُدّ أنّه كان لا يزال خطيباً لسكارليت

303
00:19:50,300 --> 00:19:53,690
لطالما افترضتُ بأنّ ذلك كان
...مصدر المأساة، لكن الآن

304
00:19:54,790 --> 00:19:59,500
أخبريني يا سكارليت. ما الّذي
جعلكِ تكرهين الأميرة سيسيليا؟

305
00:19:59,500 --> 00:20:01,500
لا، كان العكس تماماً

306
00:20:01,500 --> 00:20:04,510
كرهَتْني تلك المرأة أوّلاً

307
00:20:04,510 --> 00:20:05,750
ماذا؟ حقّاً؟

308
00:20:06,220 --> 00:20:09,930
وليس وكأنّها كانت تكرهني
على وجه الخصوص

309
00:20:09,930 --> 00:20:12,890
لا، الكره ليس الكلمة المُناسبة

310
00:20:13,210 --> 00:20:18,100
تعتبر كلّ شخص وقف أمامها عدوّاً

311
00:20:19,340 --> 00:20:21,400
...إذا كان عليّ وصف ذلك، فسيكون

312
00:20:21,820 --> 00:20:23,190
كراهيّة

313
00:20:25,600 --> 00:20:26,900
،إن صحّ ذلك

314
00:20:27,200 --> 00:20:31,160
فهل هذا يعني أنّه لا يوجد
حُبّ حقيقيّ بين الأزواج؟

315
00:20:31,160 --> 00:20:32,440
،هل أنتِ تائهة

316
00:20:33,160 --> 00:20:34,330
أيّتها الآنسة الصّغيرة؟

317
00:20:36,110 --> 00:20:37,980
إنّه الملك إرنيست

318
00:20:39,710 --> 00:20:41,430
!جـ-جلالة الملك؟

319
00:20:42,880 --> 00:20:45,690
أنتِ الآنسة غريل الصّغيرة، أليس كذلك؟

320
00:20:45,690 --> 00:20:47,420
!حـ-حاضر

321
00:20:47,690 --> 00:20:51,680
سمعتُ بأنّكِ التجلّي الثّاني
،لسكارليت كاستيل

322
00:20:51,680 --> 00:20:54,720
لكن يبدو أنّك آنسة صغيرة أكثر جاذبيّة

323
00:20:56,750 --> 00:21:02,060
هل تعلمين بأنّ البنفسج في مملكتنا
يميل لونه للأحمر؟

324
00:21:02,550 --> 00:21:05,310
ثمّة أسطورة حول ذلك

325
00:21:07,530 --> 00:21:11,910
كان عفريت طائش يسكن
بنفسج أديلبايد

326
00:21:12,860 --> 00:21:18,030
تقرّب كثيراً من الموتى الّذين يحترقون
في الجحيم وتكبّد حروق فظيعة بنفسه

327
00:21:20,100 --> 00:21:21,840
ماذا تفهمين من ذلك؟

328
00:21:21,840 --> 00:21:23,740
...فـ-في الواقع

329
00:21:26,630 --> 00:21:28,450
تنحّي جانباً يا كونّي

330
00:21:33,400 --> 00:21:35,140
...دعيني أُفكّر

331
00:21:35,140 --> 00:21:40,100
ربّما عفريت الزّهرة تمنّى إنقاذ الموتى

332
00:21:40,100 --> 00:21:42,260
ماذا؟ ما الّذي يجعلكِ تقولين ذلك؟

333
00:21:42,640 --> 00:21:47,610
ما كانت لتجرؤ على التفتُّح إذا
لم يكن لديها ما تخجل بشأنه

334
00:21:48,220 --> 00:21:50,990
فهمت. تذكّرينني بها

335
00:21:50,990 --> 00:21:53,240
ماذا؟ تمزح بالتّأكيد

336
00:21:53,530 --> 00:21:57,490
...أنا متأكّدة بأنّ سكارليت كاستيل كانت لتقول

337
00:21:57,770 --> 00:22:02,500
"شؤون الزّهور البرّية لا تعنيني"

338
00:22:06,970 --> 00:22:10,290
أجل، هذا هو طبعها

339
00:22:12,640 --> 00:22:17,020
أتساءل ما الّذي يعرفه عن سكارليت