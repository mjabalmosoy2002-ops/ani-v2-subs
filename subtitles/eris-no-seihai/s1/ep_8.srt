1
00:00:01,030 --> 00:00:05,990
كتبت ليلي-ساما رسالتها على قصاصة
مُمزّقة من كُتيّب سياحيّ

2
00:00:06,300 --> 00:00:11,250
إنّ "بي 10" المنقوشة على المفتاح
تُشير إلى الصّفحة 10

3
00:00:11,660 --> 00:00:13,230
،ثمّ نجد "إي" على الخريطة

4
00:00:13,230 --> 00:00:14,440
...و "3" هي

5
00:00:14,900 --> 00:00:17,220
!هنا! ساحة القدّيس مارك

6
00:00:17,790 --> 00:00:19,490
أنا مُندهش من اكتشافكِ ذلك

7
00:00:19,490 --> 00:00:22,990
غالباً نبحث عن مكان حيث
تتبرّع فيه عائلة أورليموندي

8
00:00:23,550 --> 00:00:25,400
إذاً، متحف التّاريخ

9
00:00:26,500 --> 00:00:28,340
ما يقودنا إلى هذا الكتاب المُقدّس

10
00:00:28,340 --> 00:00:32,010
لكن من المُؤكَّد أنّه ذو قيمة تاريخيّة عظيمة

11
00:00:32,010 --> 00:00:36,160
هذا هو المقصد. ألم أخبرك بأنّها لم تكن عاديّة؟

12
00:00:38,430 --> 00:00:39,510
وجدتُها

13
00:00:40,950 --> 00:00:42,230
رسالة؟

14
00:02:14,790 --> 00:02:17,950
لطالما كرهتُ الخسارة

15
00:02:18,680 --> 00:02:22,680
لم أشكّكك يوماً بأنّ الإلَهات كُنّ قد اخترنَني

16
00:02:22,680 --> 00:02:25,000
وبأنّني كنتُ مُميّزة

17
00:02:25,760 --> 00:02:27,290
ليس قبل ذلك اليوم

18
00:02:34,170 --> 00:02:35,540
انظري يا ليلي

19
00:02:36,800 --> 00:02:39,800
تلك هي الآنسة الصّغيرة كاستيل

20
00:02:43,580 --> 00:02:47,510
للمرّة الأولى في حياتي، شعرتُ بالهزيمة

21
00:02:49,770 --> 00:02:53,530
سررتُ بلقائكِ. اسمي ليلي أورليموندي

22
00:02:54,010 --> 00:02:56,480
يا له من وجه مُرعب

23
00:02:56,760 --> 00:02:59,700
!مـ-من المؤكّد أنّ وقاحة كهذه لا ضرورة لها

24
00:02:59,700 --> 00:03:03,180
وآداب السّلوك تتطلّب أن تُعرّفيني
!على اسمكِ كذلك

25
00:03:04,650 --> 00:03:06,860
سكارليت كاستيل

26
00:03:08,580 --> 00:03:12,740
لكنّكِ أهنتِني في البداية

27
00:03:13,480 --> 00:03:18,100
تكنّين نيّة سيّئة تجاهي، أليس كذلك؟

28
00:03:19,110 --> 00:03:23,370
مثل هذه المشية هي دلالة
على أنّكِ آنسة درجة رابعة

29
00:03:23,370 --> 00:03:24,300
درجة رابعة...؟

30
00:03:24,800 --> 00:03:26,950
إحدى عبارات أمّي المُفضّلة

31
00:03:28,790 --> 00:03:31,950
هكذا التقيتُ أنا وسكارليت

32
00:03:33,130 --> 00:03:35,000
،بعد العديد من السّنوات

33
00:03:36,540 --> 00:03:40,060
تمّ اختيارنا لنكون رفيقات وليّ العهد
أثناء فترة نقاهته

34
00:03:40,060 --> 00:03:45,110
ذهبنا لقضاء الوقت معاً في مُنتجع
العائلة الملكيّة الصّيفيّ

35
00:03:48,380 --> 00:03:50,520
ألا يمكنك التكلّم؟

36
00:03:51,770 --> 00:03:53,890
يـ-يا للوقاحة

37
00:03:53,890 --> 00:03:56,570
أ-ألا تعرفين من أكون؟

38
00:03:56,820 --> 00:03:58,870
!يا لك من أحمق

39
00:03:58,870 --> 00:04:02,790
كيف لي أن أعرف شخصاً لم يُعرّف
عن نفسه كما ينبغي؟

40
00:04:02,790 --> 00:04:04,330
!سـ-سكارليت

41
00:04:05,220 --> 00:04:06,450
اسمي إنريكي

42
00:04:10,880 --> 00:04:14,110
تعال معي. سأريك منظراً يستحقّ الرّؤية

43
00:04:23,160 --> 00:04:24,560
...إنّه جميل

44
00:04:25,130 --> 00:04:26,640
أليس كذلك؟

45
00:04:26,640 --> 00:04:29,910
من الهدر أن تقضي كلّ وقتك داخل الجدران

46
00:04:30,370 --> 00:04:33,450
فقط انظر كم هو العالم واسع

47
00:04:42,760 --> 00:04:45,480
يا إلهي. تأخّرت حسبما أرى

48
00:04:47,420 --> 00:04:52,320
عليّ تسليم هذا قبل عودة
مُعلّمي إلى مكتبه

49
00:04:52,870 --> 00:04:54,720
إنّه يبكي من جديد

50
00:04:56,440 --> 00:05:00,060
في هذه الحالة، اسمح لي أن أُكسِبك الوقت

51
00:05:01,920 --> 00:05:05,360
لن أُساعدك. هذا مُرهق جدّاً

52
00:05:09,960 --> 00:05:11,300
!ليلي؟

53
00:05:12,090 --> 00:05:13,450
!ليلي-ساما

54
00:05:13,450 --> 00:05:14,860
!ما المُشكلة؟

55
00:05:15,940 --> 00:05:19,500
لا تقف هنا فحسب. سوف نُسلّم واجبك

56
00:05:19,500 --> 00:05:21,580
لـ-لكن ماذا عن ليلي؟

57
00:05:21,580 --> 00:05:24,300
!تقول لك ليلي أن تتحرّك

58
00:05:34,830 --> 00:05:39,740
خلال تلك الفترة، بدأ سموّه يضحك أكثر من السّابق

59
00:05:46,950 --> 00:05:52,110
،سرعان ما خطب بعضهما الآخر
وظننتُ بأنّهما سيتزوّجان

60
00:05:54,470 --> 00:05:59,440
،لكن عند وصول سيسيليا لوزي
بدأ القدر يتّخذ منحى غير طبيعيّ

61
00:06:00,410 --> 00:06:02,880
ماذا تقصد، سموّك؟

62
00:06:03,390 --> 00:06:05,840
سكارليت، مُسمِّمة؟

63
00:06:05,840 --> 00:06:08,260
!مُحال أن تفعل شيئاً خبيثاً كهذا

64
00:06:08,850 --> 00:06:12,750
عُثِر على قرط حجر قوس القمر
في بناء لوزي

65
00:06:12,750 --> 00:06:16,770
أنا متأكّد بأنّه قرط من القرطين اللّذين
أعطيتُهما لسكارليت

66
00:06:17,760 --> 00:06:18,760
،رغم ذلك

67
00:06:19,730 --> 00:06:22,260
لا أتمنّى إعدامها

68
00:06:23,270 --> 00:06:26,280
!كيف لي أن أتمنّى ذلك أصلاً؟

69
00:06:26,540 --> 00:06:28,630
أما من شيء يمكنك فعله؟

70
00:06:29,050 --> 00:06:32,540
الوضع بائس. اتّخذ الملكُ قراراً

71
00:06:33,000 --> 00:06:34,950
جلالة الملك؟

72
00:06:36,210 --> 00:06:37,350
كم هذا غريب

73
00:06:37,950 --> 00:06:42,470
لِمَ يُقحم الملكُ نفسه في مُحاولة
قتل ابنة فيكونت؟

74
00:06:42,920 --> 00:06:49,430
وما الّذي يفعله الدّوق كاستيل؟
فابنته على وشك أن تُعدَم

75
00:06:49,970 --> 00:06:51,440
هل هو عاجز عن منع ذلك؟

76
00:06:51,950 --> 00:06:54,180
أم أنّه فضّل ألّا يتدخّل؟

77
00:06:54,770 --> 00:06:57,340
إعدام علنيّ؟

78
00:06:57,680 --> 00:06:59,230
هذا أفضل ما أتمنّاه

79
00:06:59,230 --> 00:07:05,390
سأُريهم بأنّني سأكون صاحبة الضّحكة الأخيرة

80
00:07:15,350 --> 00:07:17,970
لا أحد يعلم كيف سيؤول المصير

81
00:07:21,650 --> 00:07:26,240
سرعان ما مضت ثمان سنوات
منذ وفاة سكاليت

82
00:07:27,110 --> 00:07:32,760
آنذاك، كرّستُ نفسي لإعانة الفقراء

83
00:07:33,040 --> 00:07:38,760
ذات يوم، وبينما كنتُ أبحث عن مكان
...جيّد لتأسيس مدرسة

84
00:07:42,990 --> 00:07:46,530
سيسيليا؟ ماذا تفعل هنا؟

85
00:07:49,740 --> 00:07:51,520
كيريكي كيريكوكو

86
00:07:58,390 --> 00:07:59,760
!إنّها هي فعلاً

87
00:08:00,290 --> 00:08:04,820
أنباء جيّدة. كأس إيريس المُقدّس
على وشك الاستئناف أخيراً

88
00:08:04,820 --> 00:08:08,300
تأخّرت كثيراً. هل تعلم كم عاماً انتظرت؟

89
00:08:08,670 --> 00:08:12,870
حسناً، لا يمكننا تحمُّل فشل آخر

90
00:08:12,870 --> 00:08:14,800
ولا فاريس أيضاً

91
00:08:16,030 --> 00:08:18,300
إذاً، كيف تسير الأمور؟

92
00:08:18,610 --> 00:08:23,570
جعلتُ الفيكونت لوزي يدمن بالفعل
،على نعيم حاكال

93
00:08:23,990 --> 00:08:27,690
وأعمل على تهريب المُتفجّرات من ميلفينا

94
00:08:28,070 --> 00:08:30,550
يمكنني إشعال ثورة في أيّ وقت

95
00:08:31,730 --> 00:08:33,600
!يا للرّوعة

96
00:08:34,670 --> 00:08:38,230
عمّاذا كانوا يتكلّمون؟ مُتفجّرات؟ ثورة؟

97
00:08:39,530 --> 00:08:42,830
...هل يُعقَل أنّ "كأس إيريس المُقدّس" هو

98
00:08:43,240 --> 00:08:45,480
!مُخطَّط غزو من فاريس؟

99
00:08:48,680 --> 00:08:52,960
منذ ذلك اليوم، بدأتُ أجمع المعلومات سرّاً

100
00:08:56,370 --> 00:09:01,200
زواجي بالعقد من راندولف، بشريطة
،عدم التدخُّل المُتبادَل

101
00:09:02,140 --> 00:09:04,990
سهّلَ مهمّتي في التحرُّك بحرّية

102
00:09:05,760 --> 00:09:09,320
خسرت! أنتِ ماهرة في هذا يا آنسة

103
00:09:09,320 --> 00:09:12,940
إذاً تريدين أن تعرفي أكثر عن "النّعيم"؟

104
00:09:13,560 --> 00:09:16,330
تُوفّره الدِّيَكة

105
00:09:16,330 --> 00:09:17,230
الدّيَكة"؟"

106
00:09:17,230 --> 00:09:21,990
،مجموعة تُدعى دايغ غالّوس
"الدّيك الّذي يصيح عند الفجر"

107
00:09:22,380 --> 00:09:24,230
...دايغ غالّوس

108
00:09:24,230 --> 00:09:26,260
على أيّ حال، انتبهي على نفسكِ

109
00:09:26,260 --> 00:09:29,750
،حالما يضعون نُصب أعينهم عليكِ
ينتهي أمركِ

110
00:09:46,370 --> 00:09:49,010
كنتُ مُحاصَرة من كافّة الاتّجاهات

111
00:09:49,740 --> 00:09:52,950
اخترقوا كلّ مكان خطر على بالي

112
00:09:52,950 --> 00:09:55,410
لم يكن بحيلتي فعل أيّ شيء

113
00:09:58,360 --> 00:10:00,250
!ليلي-ساما

114
00:10:00,860 --> 00:10:04,820
إذا اندلعت حرب، فإنّ أولى الضّحايا

115
00:10:05,270 --> 00:10:07,260
سيكونون هؤلاء الأطفال اليتامى

116
00:10:12,420 --> 00:10:15,090
ليلي-ساما، ما الّذي يؤرقكِ؟

117
00:10:17,910 --> 00:10:20,090
كيريكي كيريكوكو"؟"

118
00:10:20,510 --> 00:10:24,480
إذا أصابني أي مكروه

119
00:10:24,730 --> 00:10:29,610
وجاء النّاس يسألون عنّي، فردّدوا هذه التّعويذة

120
00:10:30,070 --> 00:10:34,600
إن استجابوا لها، فاعلموا تماماً
بأنّهم أشخاص سيّئون جدّاً

121
00:10:35,210 --> 00:10:38,390
إن حدث ذلك، أريدكم أن تجمعوا الجميع وتهربوا

122
00:10:38,870 --> 00:10:40,770
يمكنك فعل ذلك، صحيح يا توني؟

123
00:10:42,660 --> 00:10:43,960
ما الخطب؟

124
00:10:43,960 --> 00:10:48,270
أريدكِ أن تأتي معنا عندما نذهب

125
00:10:48,960 --> 00:10:50,220
!أجل-
!ليلي-ساما-

126
00:10:50,220 --> 00:10:52,120
!ليلي-ساما، لا تذهبي

127
00:10:52,370 --> 00:10:57,070
!سأفعل المستحيل لمنع حدوث أشياء سيّئة لكِ

128
00:10:57,070 --> 00:10:58,120
...لذا أرجوكِ

129
00:10:59,970 --> 00:11:02,500
ماذا أفعل؟

130
00:11:03,650 --> 00:11:07,010
كيف أحمي مستقبل هؤلاء الأطفال؟

131
00:11:11,290 --> 00:11:12,650
لقد قرّرت

132
00:11:13,920 --> 00:11:15,580
...سوف أتّخذ

133
00:11:16,150 --> 00:11:17,660
رهاناً أخيراً

134
00:11:20,660 --> 00:11:23,650
سموّك، مضى وقت طويل

135
00:11:23,650 --> 00:11:28,160
.سمعتُ بأنّكِ أتيتِ لرؤية سيسيليا
هل هناك مُشكلة ما؟

136
00:11:28,460 --> 00:11:30,820
هل أنت قلق عليّ؟

137
00:11:30,820 --> 00:11:33,660
أتيتُ لزيارة عقيلتك فقط

138
00:11:36,990 --> 00:11:40,870
وليّ العهد لم يتزوّج سيسيليا بدافع الحُبّ

139
00:11:41,280 --> 00:11:43,920
لا بُدّ أنّه كان لديه هدف في ذهنه

140
00:11:44,400 --> 00:11:47,560
أنا متأكّدة بأنّه أدرك بعض الأمور بنفسه

141
00:11:47,560 --> 00:11:49,980
لكن لم يتغيّر شيء بعد

142
00:11:52,210 --> 00:11:57,950
عجباً، ما الّذي كنتَ تفعله طوال ثمان
سنوات أيّها الأمير ذو الدّرجة الرّابعة؟

143
00:11:59,190 --> 00:12:02,410
لم تستسلم بعد، أليس كذلك؟

144
00:12:05,430 --> 00:12:08,290
أرى بأنّه ما زال بكّاءً

145
00:12:09,120 --> 00:12:13,040
في هذه الحالة، اسمح لي أن أُكسِبك الوقت

146
00:12:16,200 --> 00:12:17,990
!هذا هو طبعكِ فحسب يا ليلي

147
00:12:17,990 --> 00:12:19,820
!يا لها من فكرة مُبهرة

148
00:12:19,820 --> 00:12:23,460
شكراً جزيلاً لكِ على قول ذلك، سموّكِ

149
00:12:24,030 --> 00:12:29,260
ارتأيتُ أن أبدأ بترميم الكنيسة في شارع ليدا

150
00:12:29,260 --> 00:12:30,100
جيّد

151
00:12:30,780 --> 00:12:34,760
على ذكر الأمر، رأيتُ سموّكِ بالصّدفة قبل أيّام

152
00:12:35,090 --> 00:12:38,480
يا إلهي. هل تعتقدين بأنّني سأذهب إلى هناك؟

153
00:12:38,480 --> 00:12:41,480
لا أعتقد بأنّني ذكرتُ المكان

154
00:12:43,700 --> 00:12:49,490
"بالمناسبة، هل كلمات "كأس إيريس المُقدّس
تعني لكِ شيئاً؟

155
00:12:51,620 --> 00:12:53,490
،إذا تبيّن لكِ بأنّها مألوفة

156
00:12:53,890 --> 00:12:56,760
فأقترح أن تعيدي النّظر في خططكِ

157
00:12:57,240 --> 00:13:00,250
إذ أنّكِ لا تستطيعين تحمُّل فشل آخر، صحيح؟

158
00:13:00,560 --> 00:13:01,490
وداعاً

159
00:13:06,750 --> 00:13:10,540
أنا مُجرّد امرأة نبيلة صغيرة محميّة

160
00:13:10,540 --> 00:13:13,750
لا أستطيع إيقاف مُخطّطاتهم

161
00:13:14,350 --> 00:13:18,310
،لكن إذا حسبوا بأنّني سأقبل بالهزيمة
فهُم مُخطئون تماماً

162
00:13:18,910 --> 00:13:22,580
سيسيليا والمتآمرون معها قالوا
بأنّهم لا يقبلون بالفشل

163
00:13:23,490 --> 00:13:25,850
لذا سأستغلّ تلك الحقيقة

164
00:13:25,850 --> 00:13:30,250
سأوهمهم بأنّ سرّهم مفضوح وأؤخّر مُخطّطاتهم

165
00:13:31,900 --> 00:13:36,290
أعطيتُهم لمحة عن مفتاحي المُزيّف
من أجل تضليلهم

166
00:13:36,560 --> 00:13:40,790
إذا تمكّنتُ من الإفلات، فإنّ مفهومهم
الخاطئ سيتحوّل إلى حقيقة

167
00:13:41,200 --> 00:13:46,220
الحقيقة هي بحسب علمي موجودة في المتحف

168
00:13:49,800 --> 00:13:52,370
"دمّر كأس إيريس المُقدّس"

169
00:13:53,490 --> 00:13:55,550
،لم أتمكّن من ذلك

170
00:13:55,900 --> 00:13:58,380
لكن سأدع شخصاً آخر يتولّى
زمام الأمور من هنا

171
00:13:59,940 --> 00:14:02,040
شخصاً ما في المستقبل

172
00:14:03,850 --> 00:14:08,860
كم سيكونون مغرورين وذوي كبرياء
،كي يتجرّؤوا على الاستخفاف بالآلهة

173
00:14:08,860 --> 00:14:14,230
وكم قلبهم طيّب بشكل لا يُصدّق
كي يُخاطروا لأجل شخص آخر

174
00:14:15,470 --> 00:14:18,360
،يتطلّب ظهور شخص كهذا مُعجزة

175
00:14:20,650 --> 00:14:24,860
لكن أين الخطأ في الإيمان بالمُعجزات؟

176
00:14:27,370 --> 00:14:31,480
لم يظهر. ربحتُ رهاني

177
00:14:32,670 --> 00:14:33,840
،حتّى آخر لحظة

178
00:14:34,330 --> 00:14:40,020
لم أفهم كيف استطاعت سكارليت
أن تبتسم بهذا الشّكل آنذاك

179
00:14:40,890 --> 00:14:44,970
لكن أنا مسرورة الآن لأنّها فعلتْ ذلك

180
00:14:46,060 --> 00:14:47,130
هذا صحيح

181
00:14:47,540 --> 00:14:51,120
،إذا استطاعت سكارليت فعلها
فأستطيع فعلها بالطّبع إذاً

182
00:14:51,770 --> 00:14:52,870
...ففي نهاية المطاف

183
00:14:59,250 --> 00:15:04,560
لطالما كرهتْ ليلي أورلاموندي الخسارة

184
00:15:07,240 --> 00:15:09,960
إذاً هذا يعني بأنّ كأس إيريس المُقدّس

185
00:15:10,910 --> 00:15:16,720
هو عمليّة عسكريّة فاريسيّة... لغزو أديلبايد

186
00:15:19,280 --> 00:15:23,540
،في الختام، إلى من يعثر على هذه الرّسالة"

187
00:15:23,540 --> 00:15:25,230
"أضع المُستقبل بين يديك

188
00:15:29,910 --> 00:15:32,460
وضعَتِ المُستقبلَ بين أيدينا؟

189
00:15:32,980 --> 00:15:35,820
أتساءل ما الّذي يمكننا فعله بهذه

190
00:15:35,820 --> 00:15:37,370
هل لي بدقيقة؟

191
00:15:41,160 --> 00:15:43,280
!أ-أميليا

192
00:15:45,600 --> 00:15:49,890
سأكون في عداد الموتى إذا اكتشفتْ
بأنّني ما زلتُ في البلد

193
00:15:49,890 --> 00:15:51,180
مَن تقصدين؟

194
00:15:51,180 --> 00:15:52,430
خذي

195
00:15:53,210 --> 00:15:57,580
هذا كلّ ما نبشتُ عنه حول وليّة العهد سيسيليا

196
00:15:58,910 --> 00:16:00,690
استفيدي منها

197
00:16:01,430 --> 00:16:03,620
وهذا ما حدث

198
00:16:04,530 --> 00:16:08,690
بنظرة خاطفة، نرى أنّ أمّ سيسيليا كانت مومساً

199
00:16:09,300 --> 00:16:14,060
،أدمنَ كيفن جينينغز على عقّار يُسبّب شللاً

200
00:16:14,510 --> 00:16:21,500
ثمّ نُقِلَ إلى مشفى القدّيس نيكولاس
الّذي تديره جمعيّة سيسيليا الخيريّة

201
00:16:22,080 --> 00:16:25,450
ما الّذي تريده وليّة العهد سيسيليا من مشفى؟

202
00:16:25,980 --> 00:16:31,010
هذا مُجرّد تخمين، لكن ربّما كانت
تختبر نعيم جاكال

203
00:16:31,010 --> 00:16:32,970
"تحت اسم "علاج

204
00:16:34,600 --> 00:16:38,350
،كان الإيرل كامبيل يشرف على ذلك المشفى

205
00:16:38,790 --> 00:16:44,850
وهو مُتّصل بسيسيليا بواسطة
سيمون داركيان، زوج ديبورا

206
00:16:45,400 --> 00:16:46,760
زوجها؟

207
00:16:47,720 --> 00:16:54,230
،إنريكي، سيسيليا، وعائلة داركيان
...كلاب فاريس الماكرون أولئك

208
00:16:54,510 --> 00:16:59,210
تعقّدت الأمور كثيراً لدرجة أنّني لم أعد
!أعرف مَن أنتقم منه بعد الآن

209
00:16:59,210 --> 00:17:02,140
!ألن يفكّر أحدٌ عنّي كنوع من التّغيير؟

210
00:17:03,210 --> 00:17:09,140
إن كان الأمر كذلك، فسأجلد كلّ شخص
!له علاقة بإعدامي

211
00:17:09,840 --> 00:17:12,030
!ا-انتظري لحظة

212
00:17:12,030 --> 00:17:17,010
كيف تتوقّع منّي أن "تجلد" كلّ
تلك الشّخصيّات رفيعة المقام؟

213
00:17:19,320 --> 00:17:22,650
تقارير حول تحقيق عمره 10 سنوات؟

214
00:17:23,430 --> 00:17:27,780
أنت تسعى خلف حقيقة إعدام
سكارليت كاستيل، أليس كذلك؟

215
00:17:29,260 --> 00:17:33,780
سمعتُ أنّ خطيبتك كانت تتحرّى

216
00:17:35,210 --> 00:17:38,400
مهلاً، مهلاً، لا تتجهّم في وجهي

217
00:17:38,400 --> 00:17:43,790
أنا ضابط أعلى منك، أنسيت؟
وقائد عسكريّ فوق ذلك

218
00:17:43,790 --> 00:17:45,410
أنا شخصيّة بارزة جدّاً

219
00:17:46,910 --> 00:17:48,220
قُل شيئاً فحسب

220
00:17:48,980 --> 00:17:52,980
حسناً، أتفهّم سبب فضولك

221
00:17:53,440 --> 00:17:54,670
...ذكّرتني

222
00:17:55,220 --> 00:17:57,990
ألم تكن مُتّهماً بالخيانة

223
00:17:57,990 --> 00:18:02,490
وكدتَ تُعدَم في تلك الفترة؟

224
00:18:04,000 --> 00:18:06,430
إنّها فاريس ما نقلق بشأنه الآن

225
00:18:06,900 --> 00:18:10,540
هل علمت شيئاً حول الأمير السّابع المفقود؟

226
00:18:10,950 --> 00:18:17,510
لا، رغم مُحاولتي التقصّي حول رئيس
وفدهم، كيندال ليفاين

227
00:18:18,360 --> 00:18:21,020
ماذا تقصد؟

228
00:18:21,510 --> 00:18:23,830
يبدو مُتردّداً بشأن تعميم المسألة

229
00:18:23,830 --> 00:18:25,100
هكذا إذاً

230
00:18:25,830 --> 00:18:32,560
ملكهم طريح بمرض، وسمعتُ
إشاعات عن نِزاع خلافة

231
00:18:32,560 --> 00:18:34,160
هذا ليس كلّ شيء

232
00:18:34,160 --> 00:18:36,610
فاريس تُعيد سكّ العملة المعدنيّة

233
00:18:42,760 --> 00:18:45,550
يبدو وكأنّهم يستعدّون لحرب

234
00:18:45,980 --> 00:18:51,310
أجل. وإن كان كذلك، فستندلع حرب
معنا هنا في أديلبايد

235
00:18:51,650 --> 00:18:54,330
هل لديهم مُبرّر للحرب؟

236
00:18:55,140 --> 00:18:58,540
مُبرّر مُلائم؟ يمكنهم بسهولة تلفيق شيء

237
00:18:58,540 --> 00:19:02,570
لطالما كانوا ماهرين في مثل هذه المُناورات

238
00:19:02,950 --> 00:19:06,090
لكن لن نمنحهم الفُرصة

239
00:19:06,540 --> 00:19:11,080
هذا هو واجب أولئك الّذين أُصفِح عن حياتهم

240
00:19:15,700 --> 00:19:19,420
...بحثتُ في كلّ تقارير التّحقيق، لكن

241
00:19:19,420 --> 00:19:20,340
مرحباً

242
00:19:20,340 --> 00:19:23,350
يسرّني لقاؤكِ هنا يا فتاة الكأس المُقدّس

243
00:19:23,710 --> 00:19:25,590
أستميحك عذراً؟

244
00:19:25,590 --> 00:19:28,280
آنسة غريل، أليس كذلك؟

245
00:19:28,750 --> 00:19:34,350
اعذريها "غريل" هي مُرادف لـ"الكأس
المُقدّس" بالفاريسيّة القديمة

246
00:19:34,780 --> 00:19:36,220
تنحدرين من فاريس إذاً؟

247
00:19:36,850 --> 00:19:40,220
ولا بُدّ أنّك الإيرل راندولف أولستير

248
00:19:40,220 --> 00:19:42,740
أتينا إلى هنا اليوم للتكلُّم معك

249
00:19:43,110 --> 00:19:45,000
وما أدراكِ باسمي؟

250
00:19:45,000 --> 00:19:48,400
سمعتُ بأنّك كنت مُتنبّهاً جدّاً لعزيزنا كيندال

251
00:19:49,810 --> 00:19:56,010
،سموّه أوليسيس، أمير فاريس
قد اختُطِف في أديلبايد

252
00:19:56,670 --> 00:20:03,000
ستستخدم فاريس الخلاص لتبرير
إعلان حرب على بلدكم

253
00:20:03,000 --> 00:20:04,990
—لكن هذا

254
00:20:05,260 --> 00:20:07,000
كلّ شيء مُهيَّأ

255
00:20:08,520 --> 00:20:11,620
دايغ غالّوس من نفّذوا عمليّة الاختطاف

256
00:20:11,620 --> 00:20:14,020
يتحكّمون بالخيوط وراء الكواليس

257
00:20:14,340 --> 00:20:17,010
إذاً من تكونان أنتما؟

258
00:20:17,400 --> 00:20:21,850
...أتينا من فاريس بالتّأكيد. إنّما

259
00:20:21,850 --> 00:20:25,780
سموّها الأميرة الثّالثة ألكسندرا أرسلَتْنا

260
00:20:26,270 --> 00:20:27,790
لا نريد حرباً

261
00:20:28,170 --> 00:20:29,760
لا تريدون...؟

262
00:20:31,260 --> 00:20:35,570
من فضلكما، هلّا تعاونتُما معنا
لإيقاف هذه الحرب؟

263
00:20:38,250 --> 00:20:40,920
كما كتبت ليلي في رسالتها

264
00:20:41,920 --> 00:20:45,440
...إذاً، المعذرة، لماذا خطّطتُم قبل عشر سنوات

265
00:20:45,440 --> 00:20:48,440
لماذا فشلت كأس إيريس المُقدّس؟

266
00:20:48,820 --> 00:20:50,430
تقصدين بأنّكِ لا تعلمين؟

267
00:20:51,060 --> 00:20:54,430
فشلتْ لأنّ سكارليت كاستيل قد أُعدِمت

268
00:20:58,410 --> 00:21:00,180
هذا ما في الأمر إذاً

269
00:21:01,820 --> 00:21:04,700
هل انتهيت من إعداد أوراقك؟

270
00:21:08,230 --> 00:21:09,890
،سموّك

271
00:21:10,970 --> 00:21:15,210
كانت أمّ سكارليت ألينور شيبولا، أليس كذلك؟

272
00:21:15,760 --> 00:21:20,800
كانت سليلو خطّيّة لكورنيليا
،التّاج المُرصّع بالنّجوم

273
00:21:20,800 --> 00:21:23,490
آخر حاكمة لإمبراطوريّة فاريس
الّتي كانت واسعة

274
00:21:24,640 --> 00:21:27,880
تمتلك عائلةُ أديلبايد الملكيّة
،عيوناً بنفسجيّة حمراء

275
00:21:27,880 --> 00:21:31,710
بينما عائلة فاريس الملكيّة
تمتلك عيوناً بنفسجيّة زرقاء

276
00:21:32,350 --> 00:21:39,200
والعيون الجمشتيّة، الّتي تجمع بين الأحمر
والأزرق، لديها أهمّيّة خاصّة في فاريس

277
00:21:39,720 --> 00:21:43,720
الهدف الحقيقيّ لكأس إيريس
المُقدّس كان على الأرجح

278
00:21:43,720 --> 00:21:46,860
،تعيين سليلة للعائلة الإمبراطوريّة القديمة

279
00:21:47,390 --> 00:21:50,620
سكارليت كاستيل، في عرش أديلبايد

280
00:21:50,620 --> 00:21:54,400
ما يجعلنا دولة تابعة لفاريس

281
00:21:56,670 --> 00:22:01,490
لكن أُعدِمت سكارليت قبل عقد
مضى، ليفشل المُخطّط

282
00:22:02,250 --> 00:22:07,220
موتها أنقذَ أديلبايد من القتل أثناء سُباتها

283
00:22:08,150 --> 00:22:09,020
...لكن رُبّما

284
00:22:09,890 --> 00:22:13,060
شخصٌ ما ضمنَ مسار الأمر بهذه الطّريقة

285
00:22:22,110 --> 00:22:27,450
بصيغة أُخرى، كان إعدامي من صنيع أبي

286
00:22:29,310 --> 00:22:35,690
تجنّبتْ أديلبايد مصيرها مع فاريس
بفضل موتي الّذي جاء في محلّه

287
00:22:35,690 --> 00:22:40,540
مُحال أن يفكّر أبي بالتّضحية
بابنته لأجل بلده

288
00:22:40,540 --> 00:22:42,520
!الدّوق كاستيل فعلَ ذلك؟

289
00:22:44,790 --> 00:22:48,060
كيف لشخص أن يكون... بهذه القسوة؟

290
00:22:51,820 --> 00:22:53,810
!هيّا بنا يا سكارليت

291
00:22:55,910 --> 00:22:59,300
لنذهب ونُقابل الدّوق كاستيل حالاً

292
00:23:00,120 --> 00:23:03,250
إنّه ليس من الرّجال الّذين
يمكن زيارتهم ببساطة

293
00:23:03,250 --> 00:23:05,810
إن لم يفلح اليوم، فهناك غداً دوماً

294
00:23:06,510 --> 00:23:08,900
سيُقابلنا في نهاية المطاف إذا ألححنا

295
00:23:09,380 --> 00:23:12,880
لذا سأستدعي الدّوق اليوم

296
00:23:15,100 --> 00:23:16,270
ممتاز

297
00:23:16,950 --> 00:23:19,770
سأرتّب اجتماعاً لكِ

298
00:23:23,760 --> 00:23:27,350
نُقدّر سخاءَ سموّك في منحنا هذه المُقابلة

299
00:23:27,660 --> 00:23:31,080
هلّا عرّفتُ عن خطيبتي، كونستانس غريل؟

300
00:23:31,080 --> 00:23:33,600
سـُ-سُررتُ بلقائك

301
00:23:34,160 --> 00:23:40,100
،حسناً إذاً يا آنستي الصّغيرة الصّادقة
ماذا تريدين أن تسأليني؟

302
00:23:43,900 --> 00:23:48,390
هل كان سموّك من أرسل سكارليت
إلى منصّة الإعدام؟